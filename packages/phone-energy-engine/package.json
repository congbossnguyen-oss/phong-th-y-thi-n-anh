{
  "name": "@thien-anh/phone-energy-engine",
  "version": "0.1.0",
  "description": "Luận số điện thoại theo Bát Cực Linh Số (Số Tự Năng Lượng Học): tách cặp Bát tinh 2 lớp, hiệu ứng số 5/0, hoá giải Cơ chế A/B, 10 nhóm từ trường, vận thế CCCD. Hàm thuần, không gọi AI lúc chạy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "bat-cuc-linh-so",
    "so-tu-nang-luong",
    "bat-tinh",
    "luan-so-dien-thoai"
  ],
  "license": "UNLICENSED",
  "private": true
}
