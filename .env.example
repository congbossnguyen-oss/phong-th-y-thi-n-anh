# Sanity (CMS nội dung: sản phẩm, dịch vụ, blog, khóa học, portfolio, testimonial)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Neon Postgres (đơn hàng, tài khoản học viên, tiến độ học)
DATABASE_URL=

# Auth
SESSION_COOKIE_SECRET=

# Bunny Stream (không dùng nữa — video khóa học chuyển sang Cloudflare R2 bên dưới)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Cloudflare R2 (lưu trữ video khóa học)
# R2_* dùng để tạo link MP4 có hạn giờ (fallback khi bài học chưa mã hóa HLS)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Domain public của bucket HLS (bật "Public Access" hoặc gắn custom domain cho bucket chứa
# playlist.m3u8 + các file .ts đã mã hóa AES-128 — xem src/lib/video/README.md)
PUBLIC_R2_HLS_BASE_URL=

# Site
PUBLIC_SITE_URL=http://localhost:4321
