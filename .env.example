# Sanity (CMS nội dung: sản phẩm, dịch vụ, blog, khóa học, portfolio, testimonial)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Neon Postgres (đơn hàng, tài khoản học viên, tiến độ học)
DATABASE_URL=

# Auth
SESSION_COOKIE_SECRET=

# Bunny Stream (không dùng nữa — video khóa học chuyển sang Cloudflare R2 bên dưới)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Cloudflare R2 (lưu trữ video khóa học — file đặt tên theo quy ước "{course-slug}/{lesson-slug}.mp4")
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Site
PUBLIC_SITE_URL=http://localhost:4321
