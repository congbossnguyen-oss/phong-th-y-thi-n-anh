# Sanity (CMS nội dung: sản phẩm, dịch vụ, blog, khóa học, portfolio, testimonial)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Neon Postgres (đơn hàng, tài khoản học viên, tiến độ học)
DATABASE_URL=

# Auth
SESSION_COOKIE_SECRET=

# Bunny Stream (video khóa học — nhúng iframe có token bảo mật + hạn giờ)
# BUNNY_STREAM_LIBRARY_ID: ID thư viện video (Bunny dashboard > Stream > chọn library > Overview)
# BUNNY_STREAM_TOKEN_AUTH_KEY: bật "Token Authentication" trong Library > Security để lấy key này
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_AUTH_KEY=

# Resend (email xác nhận đơn hàng/khóa học sau khi thanh toán, thông báo yêu cầu tư vấn mới)
# RESEND_API_KEY: Resend dashboard > API Keys
# RESEND_FROM_EMAIL: định dạng "Tên hiển thị <email@domain-đã-verify>"
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Hòm mail nhận thông báo mỗi khi có khách gửi form đặt lịch tư vấn (/lien-he).
# Để trống sẽ mặc định gửi tới siteConfig.email (lienhe@phongthuythienanh.com).
CONTACT_NOTIFICATION_EMAIL=

# SePay (thanh toán QR chuyển khoản ngân hàng, webhook xác nhận tự động)
# SEPAY_API_TOKEN: SePay dashboard > Cấu hình > API Token (dùng để tạo/tra cứu QR)
# SEPAY_WEBHOOK_SECRET: chuỗi bí mật tự đặt, cấu hình trùng khớp ở SePay > Webhooks > Authorization
# SEPAY_BANK_ACCOUNT / SEPAY_BANK_NAME: số tài khoản & tên ngân hàng để sinh QR VietQR
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=

# Site
PUBLIC_SITE_URL=http://localhost:4321
