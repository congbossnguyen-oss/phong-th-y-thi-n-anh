# Sanity (CMS nội dung: sản phẩm, dịch vụ, blog, khóa học, portfolio, testimonial)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Neon Postgres (đơn hàng, tài khoản học viên, tiến độ học)
DATABASE_URL=

# Auth
SESSION_COOKIE_SECRET=

# Bunny Stream (video khóa học — nhúng iframe có token bảo mật + hạn giờ)
# BUNNY_STREAM_LIBRARY_ID: ID thư viện video (Bunny dashboard > Stream > chọn library > Overview)
# BUNNY_STREAM_TOKEN_AUTH_KEY: bật "Token Authentication" trong Library > Security để lấy key này
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_AUTH_KEY=

# Resend (email xác nhận đơn hàng/khóa học sau khi thanh toán, thông báo yêu cầu tư vấn mới)
# RESEND_API_KEY: Resend dashboard > API Keys
# RESEND_FROM_EMAIL: định dạng "Tên hiển thị <email@domain-đã-verify>"
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Hòm mail nhận thông báo mỗi khi có khách gửi form đặt lịch tư vấn (/lien-he).
# Để trống sẽ mặc định gửi tới siteConfig.email (lienhe@phongthuythienanh.com).
CONTACT_NOTIFICATION_EMAIL=

# CC thêm 1 hòm mail khác vào thông báo đặt lịch tư vấn (mặc định: congboss.nguyen@gmail.com
# nếu để trống). Đổi ở đây nếu muốn CC hòm mail khác hoặc tắt hẳn bằng cách sửa code.
CONTACT_NOTIFICATION_CC_EMAIL=

# Google Sheet lưu danh sách đăng ký tư vấn (qua Apps Script Web App — xem
# docs/google-apps-script-consultation-sheet.gs để biết code deploy vào Sheet).
# GOOGLE_SHEETS_WEBHOOK_URL: URL "Ứng dụng web" sau khi Deploy trong Apps Script.
# GOOGLE_SHEETS_WEBHOOK_SECRET: phải khớp đúng SECRET_TOKEN đã đặt trong Apps Script.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Google Sheet quản lý mã khuyến mãi — SHEET RIÊNG, TOKEN RIÊNG với sheet đăng ký tư vấn
# (xem docs/google-apps-script-promo-sheet.gs). Sheet có 2 tab: "Danh sách mã" (đồng bộ bằng
# lệnh `node scripts/dong-bo-ma-len-sheet.mjs`) và "Lượt sử dụng" (web tự ghi khi khách dùng mã).
GOOGLE_SHEETS_PROMO_WEBHOOK_URL=
GOOGLE_SHEETS_PROMO_WEBHOOK_SECRET=

# Google Sheet thống kê khách hàng đã trả phí — SHEET RIÊNG, TOKEN RIÊNG với 2 sheet trên
# (xem docs/google-apps-script-don-thu-phi.gs). Web tự ghi 1 dòng mỗi khi có đơn công cụ thu phí
# được thanh toán; tab "Tổng hợp" tự tính doanh thu theo công cụ và theo tháng.
GOOGLE_SHEETS_DON_WEBHOOK_URL=
GOOGLE_SHEETS_DON_WEBHOOK_SECRET=

# SePay (thanh toán QR chuyển khoản ngân hàng, webhook xác nhận tự động)
# SEPAY_API_TOKEN: SePay dashboard > Cấu hình > API Token (dùng để tạo/tra cứu QR)
# SEPAY_WEBHOOK_SECRET: chuỗi bí mật tự đặt, cấu hình trùng khớp ở SePay > Webhooks > Authorization
# SEPAY_BANK_ACCOUNT / SEPAY_BANK_NAME: số tài khoản & tên ngân hàng để sinh QR VietQR
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=

# Site
PUBLIC_SITE_URL=http://localhost:4321
