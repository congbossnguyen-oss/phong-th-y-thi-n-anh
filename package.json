{
  "name": "phong-thuy-thien-anh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build:packages": "npm run build -w packages/calendar-core && npm run build -w packages/engine-contract && npm run build -w packages/rule-engine && npm run build -w packages/trachnhat-engine && npm run build -w packages/phone-energy-engine && npm run build -w packages/tinhdanh-engine",
    "build": "npm run build:packages && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config db/drizzle.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sanity/client": "^7.26.0",
    "@tailwindcss/vite": "^4.3.3",
    "@thien-anh/calendar-core": "*",
    "@thien-anh/trachnhat-engine": "*",
    "astro": "^7.1.6",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "resend": "^6.18.1",
    "tailwindcss": "^4.3.3",
    "@thien-anh/phone-energy-engine": "*",
    "@thien-anh/tinhdanh-engine": "*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10"
  }
}
