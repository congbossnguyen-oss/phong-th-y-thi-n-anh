---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { portfolio } from "../../lib/placeholder-data";

export const prerender = true;

export async function getStaticPaths() {
  return portfolio.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={item.title} description={`Công trình ${item.title} tại ${item.location} do Thiên Anh tư vấn.`}>
  <PageHero
    eyebrow="Công trình"
    title={item.title}
    description={item.location}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Công trình", href: "/cong-trinh" }, { label: item.title }]}
  />

  <Container class="py-16">
    <div class="aspect-video overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
      {item.image ? (
        <img src={item.image} alt={item.title} class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-(--color-ink-500)">Ảnh đang cập nhật</div>
      )}
    </div>
    <div class="mt-8 max-w-2xl">
      <h2 class="font-display text-2xl font-semibold text-(--color-ink-950)">Bài toán phong thủy</h2>
      <p class="mt-3 text-sm leading-relaxed text-(--color-ink-700)">
        Nội dung mô tả chi tiết bài toán, giải pháp và kết quả cho công trình {item.title} sẽ được cập nhật
        cùng bộ ảnh thực tế khi có nội dung chính thức từ khách hàng.
      </p>
    </div>
  </Container>
</BaseLayout>
