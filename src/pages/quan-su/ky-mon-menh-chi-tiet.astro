---
// Bản in-app của "Luận Giải Kỳ Môn Mệnh chi tiết" — thuộc nhóm KỲ MÔN ĐỘN GIÁP trong app Quân Sư
// (không phải nhóm Dịch vụ VIP), vào từ /quan-su/ky-mon.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";
import KyMonMenhChiTiet from "../../components/tools/KyMonMenhChiTiet.astro";
import SapRaMat from "../../components/quan-su/SapRaMat.astro";

export const prerender = false;

// Nhóm Kỳ Môn để dạng SẮP RA MẮT (anh Công 27/8/2026) — còn hoàn thiện thêm về phương pháp.
// Chỉ tài khoản quản trị vào dùng thật để kiểm thử; khách thấy màn thông báo.
const laQuanTri = Astro.locals.user?.isAdmin === true;
---

<BaseLayout title="Luận Giải Kỳ Môn Mệnh chi tiết — Quân Sư Thiên Anh" description="Luận Giải Kỳ Môn Mệnh chi tiết trong app Quân Sư." appShell>
  <PageHero
    eyebrow="Kỳ Môn Độn Giáp"
    title="Luận Giải Kỳ Môn Mệnh chi tiết"
    breadcrumbs={[{ label: "Quân Sư", href: "/quan-su" }, { label: "Kỳ Môn Độn Giáp", href: "/quan-su/ky-mon" }, { label: "Luận Giải Mệnh chi tiết" }]}
  />
  {/* Thiếu ngày giờ sinh thì nhắc quay lại trang Lập Kỳ Môn TRONG APP, không đá ra bản web. */}
  {laQuanTri ? (
    <>
      <VipQuyenBanner />
    <KyMonMenhChiTiet hrefLapKyMon="/quan-su/lap-ky-mon" anGia />
    </>
  ) : (
    <SapRaMat ten="Luận Giải Kỳ Môn Mệnh Chi Tiết" moTa="Người thân xung quanh, 4 giai đoạn cuộc đời và cách cục nổi bật tại Mệnh Cung / Trực Phù / Trực Sử." />
  )}
  <BottomNav />
</BaseLayout>
