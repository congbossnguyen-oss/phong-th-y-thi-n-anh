import NhanChuc from "../../components/quan-su/tools/NhanChuc.astro";

export const prerender = false;
---

<BaseLayout title="Chọn Ngày Giờ Nhận Chức — Quân Sư Thiên Anh" description="Chọn Ngày Giờ Nhận Chức trong app Quân Sư." appShell>
  <PageHero
    eyebrow="Dịch vụ VIP"
    title="Chọn Ngày Giờ Nhận Chức"
    breadcrumbs={[{ label: "Quân Sư", href: "/quan-su" }, { label: "Dịch vụ VIP", href: "/quan-su/dich-vu-vip" }, { label: "Chọn Ngày Giờ Nhận Chức" }]}
  />
  <VipQuyenBanner />
  <NhanChuc />
  <BottomNav />
</BaseLayout>
