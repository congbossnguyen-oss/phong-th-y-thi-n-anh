---
// "Xem Thời Vận" — tính năng khóa theo gói thuê bao (Cơ bản trở lên). Sơ bộ đại vận + lưu niên
// bằng sơ đồ + text — KHÔNG lập lá số đầy đủ. Tái dùng thẳng tinhVanTrinhHienTai() (current-luck.ts,
// đã chạy production trong Quân Sư) — không viết lại engine.
//
// Ngày giờ sinh KHÔNG hỏi ở đây nữa — lấy thẳng từ hồ sơ tài khoản (khai lúc đăng ký hoặc bổ sung ở
// /hoc-vien/ho-so). Thầy, 2026-08-23: "khai báo lúc đăng ký, lúc đó mới chạy". Thiếu giờ sinh thì
// hàm gốc đã tự bỏ qua Tử Vi (gioSinhKnown), không cần thêm gì; thiếu hẳn hồ sơ thì mời sang khai.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import "../../styles/quan-su.css";
import { coQuyenTruyCap } from "../../lib/subscriptions/access";
import { tinhVanTrinhHienTai, type LuckContext, type Band } from "../../lib/quan-su/current-luck";

export const prerender = false;

const user = Astro.locals.user;
const coQuyen = user ? await coQuyenTruyCap(user.id, "co_ban", user.isAdmin) : false;
const hs = user?.hoSoSinh ?? null;

let ketQua: LuckContext | null = null;
let loi: string | null = null;
if (coQuyen && hs) {
  try {
    ketQua = tinhVanTrinhHienTai({ day: hs.day, month: hs.month, year: hs.year, gender: hs.gender, hour: hs.hour ?? undefined });
  } catch (err) {
    loi = err instanceof Error ? err.message : "Không tính được vận trình từ hồ sơ ngày sinh.";
  }
}

const BAND_COLOR: Record<string, string> = {
  rat_thuan: "#5fcf8a",
  thuan: "#8fd9ab",
  trung_binh: "#e6c069",
  thu_thach: "#e8a45c",
  nghich: "#e8735c",
};
const BAND_LABEL: Record<string, string> = {
  rat_thuan: "Rất thuận",
  thuan: "Thuận",
  trung_binh: "Bình",
  thu_thach: "Thử thách",
  nghich: "Nghịch",
};

// "Biểu đồ vận khí" — đường cong nối các đại vận theo dải thuận/nghịch, đúng bố cục ảnh mẫu Thầy
// gửi (2026-08-23). Trục X = tuổi, trục Y = mức thuận quy đổi từ `band` (không bịa số liệu mới,
// chỉ vẽ lại đúng band đã có sẵn trong timeline).
const BAND_Y: Record<Band, number> = { rat_thuan: 92, thuan: 74, trung_binh: 50, thu_thach: 28, nghich: 10 };
function veBieuDoVanKhi(timeline: LuckContext["timeline"]) {
  if (timeline.length === 0) return null;
  const W = 300, H = 90, PAD = 10;
  const tuoiDau = timeline[0].tuoiBatDau;
  const tuoiCuoi = timeline[timeline.length - 1].tuoiKetThuc;
  const soNam = Math.max(1, tuoiCuoi - tuoiDau);
  const diem = timeline.map((gd) => {
    const tuoiGiua = (gd.tuoiBatDau + gd.tuoiKetThuc) / 2;
    const x = PAD + ((tuoiGiua - tuoiDau) / soNam) * (W - PAD * 2);
    const y = PAD + (1 - BAND_Y[gd.band] / 100) * (H - PAD * 2);
    return { x, y, gd };
  });
  const path = diem.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
  return { W, H, path, diem, tuoiDau, tuoiCuoi };
}
const bieuDo = ketQua ? veBieuDoVanKhi(ketQua.timeline) : null;
---

<BaseLayout title="Xem Thời Vận — Phong Thủy Thiên Anh" description="Sơ bộ đại vận và lưu niên bằng sơ đồ và luận giải ngắn gọn — dành cho khách đã đăng ký gói." appShell>
  <section class="qs qs-tv">
    <div class="qs-wrap">
      <a class="qs-back" href="/quan-su">← Quân Sư</a>
      <h1 class="qs-h1" style="margin-top:1rem;">Xem Thời Vận</h1>
      <p class="qs-sub">Nhìn sơ bộ đại vận đang đi và năm nay thuận hay chưa — bằng sơ đồ và vài dòng luận ngắn, không cần lập lá số đầy đủ.</p>

      {!user ? (
        <div class="qs-card" style="text-align:center;padding:1.5rem;">
          <p style="margin-bottom:1rem;">Cần đăng nhập để dùng tính năng này.</p>
          <div class="qs-row" style="max-width:360px;margin:0 auto;">
            <a href="/hoc-vien/dang-nhap" class="qs-btn" style="text-decoration:none;">Đăng nhập</a>
            <a href="/hoc-vien/dang-ky" class="qs-btn qs-btn-ghost" style="text-decoration:none;">Đăng ký tài khoản</a>
          </div>
        </div>
      ) : !coQuyen ? (
        <div class="qs-card" style="text-align:center;padding:1.5rem;">
          <p style="margin-bottom:1rem;">Tính năng này dành cho khách đã đăng ký gói (Cơ bản trở lên).</p>
          <a href="/quan-su/goi-thue-bao" class="qs-btn" style="text-decoration:none;display:inline-flex;">Xem gói thuê bao</a>
        </div>
      ) : !hs ? (
        <div class="qs-card" style="text-align:center;padding:1.5rem;">
          <p style="margin-bottom:1rem;">Cần khai báo ngày sinh trong hồ sơ mới xem được thời vận.</p>
          <a href="/hoc-vien/ho-so" class="qs-btn" style="text-decoration:none;display:inline-flex;">Khai báo hồ sơ</a>
        </div>
      ) : (
        <>
          <p class="qs-sub" style="font-size:0.85rem;">
            Theo hồ sơ: {hs.gender}, sinh {hs.day}/{hs.month}/{hs.year}{hs.hour != null ? ` — ${hs.hour} giờ` : ""}.
            <a href="/hoc-vien/ho-so" style="color:var(--qs-gold);"> Sửa hồ sơ</a>
          </p>

          {loi && <div class="qs-notice">{loi}</div>}

          {ketQua && (
            <div class="qs-result" style="display:block;">
              <div class="qs-verdict">
                <h2>Đại vận hiện tại</h2>
                <p style="font-size:1.05rem;">
                  <strong style="color:var(--qs-gold);">{ketQua.daiVanHienTai.can} {ketQua.daiVanHienTai.chi}</strong>
                  <span style="color:var(--qs-muted);"> ({ketQua.daiVanHienTai.tuoiBatDau}–{ketQua.daiVanHienTai.tuoiKetThuc} tuổi, hiện {ketQua.tuoiHienTai} tuổi)</span>
                  — <span style={`color:${BAND_COLOR[ketQua.daiVanHienTai.band]};font-weight:700;`}>{BAND_LABEL[ketQua.daiVanHienTai.band]}</span>
                </p>
                <p style="margin-top:0.6rem;">
                  Lưu niên {ketQua.luuNienHienTai.nam}: <strong style="color:var(--qs-gold);">{ketQua.luuNienHienTai.can} {ketQua.luuNienHienTai.chi}</strong>
                  — <span style={`color:${BAND_COLOR[ketQua.luuNienHienTai.band]};font-weight:700;`}>{BAND_LABEL[ketQua.luuNienHienTai.band]}</span>
                </p>
                {!ketQua.gioSinhKnown && <p style="margin-top:0.6rem;color:var(--qs-muted);font-size:0.85rem;">⚙ Không có giờ sinh — vận trình mang tính ước lượng, không đối chiếu được Tử Vi.</p>}
                {ketQua.tuVi && (
                  <p style="margin-top:0.6rem;color:var(--qs-muted);font-size:0.85rem;">
                    Đối chiếu Tử Vi: cung <strong style="color:var(--qs-ivory);">{ketQua.tuVi.daiVanCung}</strong> ({ketQua.tuVi.chinhTinh.join(", ") || "không có chính tinh"}) — chỉ để tham khảo, không tính vào điểm.
                  </p>
                )}
              </div>

              <div class="qs-luck">
                <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:0.6rem;">
                  <h3 style="margin:0;">Biểu đồ vận khí</h3>
                  {bieuDo && <span style="font-size:0.72rem;color:var(--qs-muted);">Đại vận {bieuDo.tuoiDau} → {bieuDo.tuoiCuoi} tuổi</span>}
                </div>
                {bieuDo && (
                  <svg viewBox={`0 0 ${bieuDo.W} ${bieuDo.H}`} style="width:100%;height:auto;overflow:visible;">
                    <path d={bieuDo.path} fill="none" stroke="var(--qs-gold)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" opacity="0.9" />
                    {bieuDo.diem.map((p) => (
                      <circle cx={p.x} cy={p.y} r={p.gd.laHienTai ? 4.5 : 3} fill={BAND_COLOR[p.gd.band]} stroke={p.gd.laHienTai ? "#fff" : "none"} stroke-width="1.5" />
                    ))}
                  </svg>
                )}
                <div style="display:flex;gap:1rem;margin-top:0.5rem;font-size:0.7rem;color:var(--qs-muted);">
                  <span><span style={`display:inline-block;width:8px;height:8px;border-radius:999px;background:${BAND_COLOR.rat_thuan};margin-right:0.3rem;`}></span>Thuận</span>
                  <span><span style={`display:inline-block;width:8px;height:8px;border-radius:999px;background:${BAND_COLOR.trung_binh};margin-right:0.3rem;`}></span>Bình</span>
                  <span><span style={`display:inline-block;width:8px;height:8px;border-radius:999px;background:${BAND_COLOR.nghich};margin-right:0.3rem;`}></span>Nghịch</span>
                </div>
              </div>

              <div class="qs-luck" style="margin-top:1rem;">
                <h3>Vận trình hiện tại</h3>
                {ketQua.dimensions.map((dim) => {
                  const pct = Math.round((dim.score / 10) * 100);
                  return (
                    <div class={`qs-dim${dim.higherIsBetter ? "" : " warn"}`}>
                      <div class="lab"><span>{dim.label}{!dim.higherIsBetter && <span style="color:var(--qs-muted);font-size:0.72rem;"> (càng cao càng thận trọng)</span>}</span><span>{dim.score}/10</span></div>
                      <div class="track"><div class="fill" style={`width:${pct}%`}></div></div>
                    </div>
                  );
                })}
              </div>

              <div class="qs-sect">
                <h4>Tóm tắt</h4>
                {ketQua.tomTat.map((dong) => <p>{dong}</p>)}
              </div>

              <div class="qs-demo">⚙ Bản nháp — công thức 4 thanh chỉ số đang chờ Thầy hiệu chỉnh trên dữ liệu thật.</div>
            </div>
          )}
        </>
      )}
    </div>
  </section>

  <BottomNav />
</BaseLayout>

<style>
  /* Riêng trang Xem Thời Vận: đổi ảnh nền `.qs` mặc định (bg-huyen-hoc.webp) sang ảnh "người trong
     vòng khí" Thầy chỉ định, làm mờ đậm hơn mức mặc định để chữ nổi rõ (Thầy: "cho mờ đi chút để
     chữ nổi hơn", 2026-08-24). Ghi đè scoped bằng `.qs-tv` cộng cấp — KHÔNG đụng `.qs` dùng chung
     trong quan-su.css nên các trang khác vẫn giữ nguyên ảnh nền cũ. */
  .qs.qs-tv {
    background:
      linear-gradient(180deg, rgba(7, 6, 5, 0.92) 0%, rgba(7, 6, 5, 0.86) 30%, rgba(7, 6, 5, 0.93) 72%, rgba(7, 6, 5, 0.98) 100%),
      url("/images/quan-su/nguoi-trong-vong-khi.png") center 12% / cover no-repeat;
  }
</style>
