---
// "Xem Thời Vận" — luận vận khí Đại Vận & Lưu Niên bằng engine Bát Tự đầy đủ (vượng suy + dụng thần
// tính lại theo từng mốc thời gian + chấm điểm 4 lĩnh vực + AI diễn giải có hậu kiểm an toàn).
//
// 2026-08-24: thay thế bản sơ bộ dựa trên current-luck.ts (band ước lượng, không có vượng-suy/dụng-
// thần thật) bằng module luan-van-khi/ (SPEC.md tại docs/quan-su-thien-anh/luan-van-khi-spec/) — xem
// module đó để hiểu thuật toán chấm điểm. current-luck.ts KHÔNG bị xóa (nơi khác trong Quân Sư vẫn
// dùng làm context phụ cho Kinh Dịch), chỉ trang này đổi nguồn.
//
// Ngày giờ sinh KHÔNG hỏi ở đây — lấy từ hồ sơ tài khoản (khai lúc đăng ký hoặc bổ sung ở
// /hoc-vien/ho-so). Thiếu giờ sinh thì luan-van-khi tự dùng 12h mặc định + gắn cờ gioSinhKnown=false
// (giữ nguyên trải nghiệm cũ, không chặn khách).
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import "../../styles/quan-su.css";
import { coQuyenTruyCap } from "../../lib/subscriptions/access";
import { tinhVanKhi, type VanKhiOutput, type DiemLinhVuc, type LinhVucKey, type LuuNienKhi } from "../../lib/quan-su/luan-van-khi";

export const prerender = false;

const user = Astro.locals.user;
const coQuyen = user ? await coQuyenTruyCap(user.id, "co_ban", user.isAdmin) : false;
const hs = user?.hoSoSinh ?? null;

// Đại Vận muốn xem chi tiết — truyền qua ?daiVan=<0-9>, mặc định (không truyền) để module tự chọn
// Đại Vận đang chứa tuổi hiện tại. Clamp về khoảng hợp lệ, bỏ qua giá trị rác thay vì lỗi trang.
const daiVanParam = Astro.url.searchParams.get("daiVan");
const daiVanIndexYeuCau = daiVanParam !== null && /^\d+$/.test(daiVanParam) ? Math.max(0, Math.min(9, Number(daiVanParam))) : undefined;

let ketQua: VanKhiOutput | null = null;
let loi: string | null = null;
if (coQuyen && hs) {
  try {
    ketQua = await tinhVanKhi({
      day: hs.day, month: hs.month, year: hs.year, gender: hs.gender, hour: hs.hour ?? undefined,
      chiTietDaiVanIndex: daiVanIndexYeuCau,
    });
  } catch (err) {
    loi = err instanceof Error ? err.message : "Không tính được vận khí từ hồ sơ ngày sinh.";
  }
}

// Nhãn 0-10 → màu hex thật cho SVG (thang_nhan trong config-linh-vuc.json chỉ ghi tên màu tiếng Việt).
const MAU_SAC_HEX: Record<string, string> = {
  "xanh lá": "#7fb8a0",
  "xanh dương": "#8fb3e0",
  "xám": "#a9a184",
  "vàng": "#f1c85a",
  cam: "#e8a45c",
};
const TEN_LINH_VUC: Record<LinhVucKey, string> = { tai_van: "Tài vận", quan_van: "Quan vận", suc_khoe: "Sức khỏe", tinh_duyen: "Tình duyên" };
// Màu định danh riêng cho từng lĩnh vực khi so sánh cạnh nhau (biểu đồ cột nhiều chuỗi + tròn) — lấy
// nguyên từ bảng biến CSS đã có của Quân Sư (--qs-gold/--qs-purple/--qs-good + cam đã dùng cho "thử
// thách" ở bản cũ của trang này) để không lệch tông toàn site.
const MAU_LINH_VUC: Record<LinhVucKey, string> = { tai_van: "#f1c85a", quan_van: "#8f6bff", suc_khoe: "#7fb8a0", tinh_duyen: "#e8a45c" };
const LINH_VUC_THU_TU: LinhVucKey[] = ["tai_van", "quan_van", "suc_khoe", "tinh_duyen"];

// --- Biểu đồ Gauge/Donut (1 lĩnh vực, điểm 0-10 hiện tại) — vòng tròn tiến độ bằng stroke-dasharray,
// không cần thư viện chart (repo không cài chart lib), đúng tinh thần "1 điểm neo, dễ đọc trên điện
// thoại" như ảnh Power-BI Thầy gửi, nhưng đổi sang tông vàng-cổ/navy của Quân Sư thay vì nền sáng. ---
function veGaugeDonut(diem: DiemLinhVuc) {
  const r = 30;
  const C = 2 * Math.PI * r;
  const pct = Math.max(0, Math.min(10, diem.diem)) / 10;
  const mauSac = MAU_SAC_HEX[diem.mauSac] ?? "#f1c85a";
  return { r, C, dash: pct * C, mauSac };
}

// --- Biểu đồ cột nhiều chuỗi (4 lĩnh vực × 10 năm trong Đại Vận đang xem) — bản dịch của "small
// multi-series bar chart" trong ảnh mẫu. ---
function veBieuDoCotNhieuChuoi(luuNien: LuuNienKhi[]) {
  const W = 100, H = 46;
  const n = luuNien.length || 1;
  const nhomW = W / n;
  const barW = (nhomW - 2) / 4;
  const nhom = luuNien.map((ln, i) => {
    const x0 = i * nhomW + 1;
    const cot = LINH_VUC_THU_TU.map((lv, j) => {
      const d = ln.diemCacLinhVuc.find((x) => x.linhVuc === lv)!;
      const h = (d.diem / 10) * (H - 6);
      return { x: x0 + j * barW, y: H - h, w: barW * 0.86, h, mauSac: MAU_LINH_VUC[lv] };
    });
    return { nam: ln.nam, cot };
  });
  return { W, H, nhom };
}

// --- Biểu đồ tròn (pie) — tỷ trọng tương đối giữa 4 lĩnh vực trong Đại Vận đang xem (tongQuan). Chỉ
// mang tính trực quan hóa TỶ LỆ so sánh 4 mảng, không phải "phần trăm may mắn tuyệt đối". ---
function veBieuDoTron(tongQuan: DiemLinhVuc[]) {
  const cx = 42, cy = 42, r = 38;
  const tong = tongQuan.reduce((s, d) => s + Math.max(d.diem, 0.4), 0) || 1; // sàn 0.4 để lát không biến mất hẳn khi điểm 0
  let goc = -90;
  const lat = tongQuan.map((d) => {
    const phanTram = Math.max(d.diem, 0.4) / tong;
    const gocQuet = phanTram * 360;
    const gocKetThuc = goc + gocQuet;
    const toXY = (a: number) => {
      const rad = (a * Math.PI) / 180;
      return [cx + r * Math.cos(rad), cy + r * Math.sin(rad)];
    };
    const [x1, y1] = toXY(goc);
    const [x2, y2] = toXY(gocKetThuc);
    const large = gocQuet > 180 ? 1 : 0;
    const path = `M ${cx} ${cy} L ${x1.toFixed(2)} ${y1.toFixed(2)} A ${r} ${r} 0 ${large} 1 ${x2.toFixed(2)} ${y2.toFixed(2)} Z`;
    const lat1 = { path, mauSac: MAU_LINH_VUC[d.linhVuc], linhVuc: d.linhVuc, diem: d.diem, phanTram: Math.round(phanTram * 100) };
    goc = gocKetThuc;
    return lat1;
  });
  return { cx, cy, r, lat };
}

const dvChiTiet = ketQua ? ketQua.danhSachDaiVan[ketQua.chiTietDaiVanIndex] : null;
// Năm Lưu Niên "đang chọn để hiện lời luận nổi bật" — ưu tiên năm hiện tại nếu có trong danh sách,
// không thì lấy năm đầu tiên của Đại Vận đang xem.
const namHienTai = new Date().getFullYear();
const luuNienNoiBat = dvChiTiet?.luuNien.find((ln) => ln.nam === namHienTai) ?? dvChiTiet?.luuNien[0] ?? null;
const bieuDoCot = dvChiTiet ? veBieuDoCotNhieuChuoi(dvChiTiet.luuNien) : null;
const bieuDoTron = dvChiTiet ? veBieuDoTron(dvChiTiet.tongQuan) : null;
---

<BaseLayout title="Xem Thời Vận — Phong Thủy Thiên Anh" description="Luận vận khí Đại Vận và Lưu Niên theo Bát Tự đầy đủ — chấm điểm 4 lĩnh vực kèm biểu đồ và lời luận ngắn gọn." appShell>
  <section class="qs qs-tv">
    <div class="qs-wrap">
      <a class="qs-back" href="/quan-su">← Quân Sư</a>
      <h1 class="qs-h1" style="margin-top:1rem;">Xem Thời Vận</h1>
      <p class="qs-sub">Vận khí theo từng Đại Vận 10 năm và từng Lưu Niên — chấm điểm Quan vận, Tài vận, Sức khỏe, Tình duyên kèm biểu đồ và lời luận ngắn.</p>

      {!user ? (
        <div class="qs-card" style="text-align:center;padding:1.5rem;">
          <p style="margin-bottom:1rem;">Cần đăng nhập để dùng tính năng này.</p>
          <div class="qs-row" style="max-width:360px;margin:0 auto;">
            <a href="/hoc-vien/dang-nhap" class="qs-btn" style="text-decoration:none;">Đăng nhập</a>
            <a href="/hoc-vien/dang-ky" class="qs-btn qs-btn-ghost" style="text-decoration:none;">Đăng ký tài khoản</a>
          </div>
        </div>
      ) : !coQuyen ? (
        <div class="qs-card" style="text-align:center;padding:1.5rem;">
          <p style="margin-bottom:1rem;">Tính năng này dành cho khách đã đăng ký gói (Cơ bản trở lên).</p>
          <a href="/quan-su/goi-thue-bao" class="qs-btn" style="text-decoration:none;display:inline-flex;">Xem gói thuê bao</a>
        </div>
      ) : !hs ? (
        <div class="qs-card" style="text-align:center;padding:1.5rem;">
          <p style="margin-bottom:1rem;">Cần khai báo ngày sinh trong hồ sơ mới xem được thời vận.</p>
          <a href="/hoc-vien/ho-so" class="qs-btn" style="text-decoration:none;display:inline-flex;">Khai báo hồ sơ</a>
        </div>
      ) : (
        <>
          <p class="qs-sub" style="font-size:0.85rem;">
            Theo hồ sơ: {hs.gender}, sinh {hs.day}/{hs.month}/{hs.year}{hs.hour != null ? ` — ${hs.hour} giờ` : ""}.
            <a href="/hoc-vien/ho-so" style="color:var(--qs-gold);"> Sửa hồ sơ</a>
          </p>

          {loi && <div class="qs-notice">{loi}</div>}

          {ketQua && dvChiTiet && (
            <div class="qs-result" style="display:block;">
              {/* --- Hàng thẻ số liệu lớn (stat tiles) --- */}
              <div class="qs-stat-row">
                <div class="qs-stat-tile">
                  <span class="v">{ketQua.laSo.nhatChu}</span>
                  <span class="l">Nhật Chủ ({ketQua.laSo.nhatChuHanh})</span>
                </div>
                <div class="qs-stat-tile">
                  <span class="v">{ketQua.vuongSuyGoc.capDo}</span>
                  <span class="l">Vượng suy nguyên cục</span>
                </div>
                <div class="qs-stat-tile">
                  <span class="v">{ketQua.dungThanGoc.dungThan}</span>
                  <span class="l">Dụng Thần</span>
                </div>
                <div class="qs-stat-tile">
                  <span class="v">{dvChiTiet.canChi}</span>
                  <span class="l">Đại Vận đang xem ({dvChiTiet.tuoiBatDau}–{dvChiTiet.tuoiKetThuc} tuổi)</span>
                </div>
              </div>
              {!ketQua.laSo.gioSinhKnown && <p style="margin-top:0.6rem;color:var(--qs-muted);font-size:0.82rem;">⚙ Không có giờ sinh — trụ Giờ và vận khí mang tính ước lượng (dùng 12h mặc định).</p>}

              {/* --- Dải 10 Đại Vận — mỗi thẻ là 1 tổng quan (điểm nền 10 năm), bấm để xem chi tiết --- */}
              <div class="qs-luck" style="margin-top:1rem;overflow-x:auto;">
                <h3>10 Đại Vận</h3>
                <div class="qs-dv-strip">
                  {ketQua.danhSachDaiVan.map((dv, i) => {
                    const trungBinh = dv.tongQuan.reduce((s, d) => s + d.diem, 0) / dv.tongQuan.length;
                    const dangXem = i === ketQua!.chiTietDaiVanIndex;
                    return (
                      <a href={`?daiVan=${i}`} class={`qs-dv-chip${dangXem ? " active" : ""}`}>
                        <span class="cc">{dv.canChi}</span>
                        <span class="tuoi">{dv.tuoiBatDau}–{dv.tuoiKetThuc}t</span>
                        <span class="diem">{trungBinh.toFixed(1)}/10</span>
                      </a>
                    );
                  })}
                </div>
              </div>

              {/* --- Pie: tỷ trọng 4 lĩnh vực trong Đại Vận đang xem --- */}
              <div class="qs-luck" style="margin-top:1rem;">
                <div class="qs-pie-row">
                  <svg viewBox="0 0 84 84" style="width:120px;height:120px;flex-shrink:0;">
                    {bieuDoTron!.lat.map((l) => <path d={l.path} fill={l.mauSac} opacity="0.92" />)}
                    <circle cx="42" cy="42" r="17" fill="var(--qs-navy)" />
                  </svg>
                  <div class="qs-pie-legend">
                    <h3 style="margin:0 0 0.5rem;">Tỷ trọng thuận lợi — {dvChiTiet.canChi}</h3>
                    {bieuDoTron!.lat.map((l) => (
                      <div class="row">
                        <span class="dot" style={`background:${l.mauSac}`}></span>
                        <span class="ten">{TEN_LINH_VUC[l.linhVuc]}</span>
                        <span class="pt">{l.diem}/10</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* --- Cột nhiều chuỗi: xu hướng 10 năm trong Đại Vận đang xem --- */}
              {bieuDoCot && (
                <div class="qs-luck" style="margin-top:1rem;">
                  <h3>Xu hướng 10 năm ({dvChiTiet.canChi})</h3>
                  <svg viewBox={`0 0 ${bieuDoCot.W} ${bieuDoCot.H}`} style="width:100%;height:80px;overflow:visible;">
                    {bieuDoCot.nhom.map((nh) => nh.cot.map((c) => <rect x={c.x} y={c.y} width={c.w} height={Math.max(c.h, 0.6)} fill={c.mauSac} rx="0.5" />))}
                  </svg>
                  <div class="qs-cot-nhan">
                    {bieuDoCot.nhom.map((nh) => <span>{nh.nam}</span>)}
                  </div>
                  <div class="qs-pie-legend" style="margin-top:0.6rem;flex-direction:row;gap:0.9rem;display:flex;flex-wrap:wrap;">
                    {LINH_VUC_THU_TU.map((lv) => (
                      <span style="font-size:0.72rem;color:var(--qs-muted);"><span class="dot" style={`background:${MAU_LINH_VUC[lv]};display:inline-block;width:8px;height:8px;border-radius:999px;margin-right:0.3rem;`}></span>{TEN_LINH_VUC[lv]}</span>
                    ))}
                  </div>
                </div>
              )}

              {/* --- 4 Gauge + lời luận cho năm nổi bật --- */}
              {luuNienNoiBat && (
                <div class="qs-luck" style="margin-top:1rem;">
                  <h3>Lưu Niên {luuNienNoiBat.nam} ({luuNienNoiBat.canChi}, {luuNienNoiBat.tuoi} tuổi)</h3>
                  <div class="qs-gauge-grid">
                    {luuNienNoiBat.diemCacLinhVuc.map((d) => {
                      const g = veGaugeDonut(d);
                      return (
                        <div class="qs-gauge-card">
                          <svg viewBox="0 0 76 76" style="width:88px;height:88px;">
                            <circle cx="38" cy="38" r={g.r} fill="none" stroke="var(--qs-navy-2)" stroke-width="7" />
                            <circle cx="38" cy="38" r={g.r} fill="none" stroke={g.mauSac} stroke-width="7" stroke-linecap="round"
                              stroke-dasharray={`${g.dash.toFixed(1)} ${g.C.toFixed(1)}`} transform="rotate(-90 38 38)" />
                            <text x="38" y="34" text-anchor="middle" font-size="15" font-weight="700" fill="var(--qs-ivory)">{d.diem}</text>
                            <text x="38" y="48" text-anchor="middle" font-size="7" fill="var(--qs-muted)">/10</text>
                          </svg>
                          <div class="ten">{TEN_LINH_VUC[d.linhVuc]}</div>
                          <div class="nhan" style={`color:${MAU_SAC_HEX[d.mauSac]}`}>{d.nhan}</div>
                          <p class="loi-luan">{luuNienNoiBat.loiLuan[d.linhVuc]}</p>
                        </div>
                      );
                    })}
                  </div>
                  {!luuNienNoiBat.loiLuanTuAI && <p class="qs-demo" style="margin-top:0.8rem;">⚙ Lời luận trên dùng câu mẫu an toàn dự phòng (chưa gọi được AI luận sâu lúc này).</p>}
                </div>
              )}

              {/* --- 10 thẻ năm (gọn, mở rộng bằng <details> — không cần JS) --- */}
              <div class="qs-luck" style="margin-top:1rem;">
                <h3>Chi tiết từng năm trong Đại Vận {dvChiTiet.canChi}</h3>
                {dvChiTiet.luuNien.map((ln) => {
                  const trungBinhNam = ln.diemCacLinhVuc.reduce((s, d) => s + d.diem, 0) / ln.diemCacLinhVuc.length;
                  return (
                    <details class="qs-detail" open={ln.nam === luuNienNoiBat?.nam}>
                      <summary>
                        {ln.nam} ({ln.canChi}, {ln.tuoi} tuổi) — trung bình {trungBinhNam.toFixed(1)}/10
                      </summary>
                      <div class="body">
                        {ln.diemCacLinhVuc.map((d) => (
                          <p style="margin:0 0 0.6rem;">
                            <strong style={`color:${MAU_SAC_HEX[d.mauSac]}`}>{TEN_LINH_VUC[d.linhVuc]} — {d.diem}/10 ({d.nhan})</strong><br />
                            {ln.loiLuan[d.linhVuc]}
                          </p>
                        ))}
                      </div>
                    </details>
                  );
                })}
              </div>

              <p class="qs-luuy" style="margin-top:1rem;">{ketQua.disclaimer}</p>
            </div>
          )}
        </>
      )}
    </div>
  </section>

  <BottomNav />
</BaseLayout>

<style>
  /* Riêng trang Xem Thời Vận: đổi ảnh nền `.qs` mặc định (bg-huyen-hoc.webp) sang ảnh "người trong
     vòng khí" Thầy chỉ định, làm mờ đậm hơn mức mặc định để chữ nổi rõ (Thầy: "cho mờ đi chút để
     chữ nổi hơn", 2026-08-24). Ghi đè scoped bằng `.qs-tv` cộng cấp — KHÔNG đụng `.qs` dùng chung
     trong quan-su.css nên các trang khác vẫn giữ nguyên ảnh nền cũ. */
  .qs.qs-tv {
    background:
      linear-gradient(180deg, rgba(7, 6, 5, 0.92) 0%, rgba(7, 6, 5, 0.86) 30%, rgba(7, 6, 5, 0.93) 72%, rgba(7, 6, 5, 0.98) 100%),
      url("/images/quan-su/nguoi-trong-vong-khi.jpg") center 12% / cover no-repeat;
  }

  /* Thẻ số liệu lớn (stat tiles) — bản dịch "big stat-number tiles" trong ảnh mẫu sang tông navy/vàng. */
  .qs-stat-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; margin-top: 1rem; }
  @media (min-width: 640px) { .qs-stat-row { grid-template-columns: repeat(4, 1fr); } }
  .qs-stat-tile {
    background: var(--qs-navy); border: 1px solid rgba(241, 200, 90, 0.18); border-radius: 12px;
    padding: 0.8rem 0.7rem; display: flex; flex-direction: column; gap: 0.2rem;
  }
  .qs-stat-tile .v { font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.5rem; color: var(--qs-gold); font-weight: 700; }
  .qs-stat-tile .l { font-size: 0.7rem; color: var(--qs-muted); }

  /* Dải 10 Đại Vận, cuộn ngang trên điện thoại. */
  .qs-dv-strip { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.3rem; }
  .qs-dv-chip {
    flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
    background: var(--qs-navy-2); border: 1px solid rgba(241, 200, 90, 0.16); border-radius: 10px;
    padding: 0.5rem 0.7rem; text-decoration: none; color: var(--qs-ivory); min-width: 74px;
  }
  .qs-dv-chip.active { border-color: var(--qs-gold); background: rgba(241, 200, 90, 0.1); }
  .qs-dv-chip .cc { font-weight: 700; font-size: 0.85rem; }
  .qs-dv-chip .tuoi { font-size: 0.66rem; color: var(--qs-muted); }
  .qs-dv-chip .diem { font-size: 0.72rem; color: var(--qs-gold); }

  /* Pie chart hàng ngang: vòng tròn bên trái, chú giải bên phải. */
