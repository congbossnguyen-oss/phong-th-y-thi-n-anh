---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BottomNav from "../../../components/quan-su/BottomNav.astro";
import "../../../styles/quan-su.css";
import { getQuestion, getCategory } from "../../../lib/quan-su";
import { dungThanHintFor } from "../../../lib/quan-su/divination";
import { siteConfig } from "../../../lib/site-config";

export const prerender = false;

const { id } = Astro.params;
const question = id ? getQuestion(id) : undefined;
if (!question) {
  return Astro.redirect("/quan-su");
}
const cat = getCategory(question.category);
const isLucHao = question.divination_method === "luc-hao";
// Ô nhập cần render dạng form (bỏ 'gieo-que' vì đó là bước gieo quẻ riêng). KHÔNG thu ngày sinh/
// giới tính — Thầy: "ngày sinh, giới tính bỏ, làm đúng như /gieo-que-kinh-dich" (2026-08-23).
const formInputs = [...question.required_inputs, ...question.optional_inputs].filter((i) => i.type !== "gieo-que");
// Nhóm câu hỏi mặc định lấy Hào Thế (= chính người hỏi) làm Dụng Thần (vd Sức khỏe) mới cần hỏi
// "hỏi cho ai" — hỏi cho cha/mẹ/con... thì Dụng Thần phải đổi sang đúng Lục Thân đại diện người đó
// (quy trình luận §1.1), không phải Hào Thế nữa. Nhóm đã cố định 1 Lục Thân theo chủ đề (vd "Con
// cái" → Tử Tôn) hoặc dùng khung riêng (framework) thì không áp dụng — giữ nguyên như cũ.
const choDoiTuongKhac = dungThanHintFor(question.category).kind === "the-hao";
---

<BaseLayout title={`${question.title} — Quân Sư Thiên Anh`} description={question.subtitle} appShell>
  <section class="qs">
    <div class="qs-wrap">
      <a class="qs-back" href={`/quan-su/${question.category}`}>← {cat?.title ?? "Quay lại"}</a>

      <p class="qs-eyebrow" style="margin-top:1rem;">Bước 1 · Câu hỏi</p>
      <h1 class="qs-h1">{question.title}</h1>
      <p class="qs-sub">{question.subtitle}</p>
      {cat?.notice && <div class="qs-notice">{cat.notice}</div>}

      {!isLucHao ? (
        <div class="qs-notice" style="background:rgba(107,78,158,0.12);border-color:rgba(107,78,158,0.4);color:#c3b3e0;">
          Nhóm này dùng công cụ <strong>Chọn ngày giờ</strong> (không gieo quẻ). Phần này sẽ nối với bộ Đại Cát Lợi sẵn có ở giai đoạn sau.
        </div>
      ) : (
        <>
          <p class="qs-eyebrow">Bước 2 · Thông tin</p>
          <form id="qs-form">
            {formInputs.map((inp) => (
              <div class="qs-field">
                <label for={`f-${inp.key}`}>{inp.label}{inp.required ? "" : " (không bắt buộc)"}</label>
                {inp.type === "text" || inp.type === "phuong-an-list" ? (
                  <textarea class="qs-textarea" id={`f-${inp.key}`} data-key={inp.key} rows={inp.type === "phuong-an-list" ? 3 : 2}></textarea>
                ) : (
                  <input class="qs-input" id={`f-${inp.key}`} data-key={inp.key} type={inp.type === "date" ? "date" : inp.type === "time" ? "time" : "text"} />
                )}
                {inp.helpText && <div class="help">{inp.helpText}</div>}
              </div>
            ))}
          </form>

          {choDoiTuongKhac && (
            <div class="qs-field">
              <label for="f-doi-tuong">Hỏi cho ai?</label>
              <select class="qs-input" id="f-doi-tuong">
                <option value="chinh-toi">Chính tôi</option>
                <option value="cha-me">Cha / mẹ</option>
                <option value="con">Con</option>
                <option value="vo">Vợ</option>
                <option value="chong">Chồng</option>
                <option value="anh-chi-em">Anh chị em / bạn bè</option>
                <option value="nguoi-khac">Người khác</option>
              </select>
              <div class="help">Hỏi cho người thân thì Quân Sư đổi Dụng Thần đúng theo người đó (cha/mẹ → Phụ Mẫu, con → Tử Tôn, vợ → Thê Tài, chồng → Quan Quỷ...) thay vì tính cho chính anh/chị.</div>
            </div>
          )}

          <p class="qs-eyebrow">Bước 3 · Cách lập quẻ</p>
          <p class="qs-sub">Chọn 1 trong 4 cách lập quẻ Kinh Dịch — kết quả luận giải như nhau, chỉ khác cách nhập.</p>
          <div class="qs-methods" id="qs-methods">
            <button type="button" class="qs-method active" data-method="gieo-tay">
              <span class="ti">Gieo đồng xu</span>
              <span class="de">Tự gieo 3 đồng xu 6 lần, chọn đúng Âm/Dương và hào động</span>
            </button>
            <button type="button" class="qs-method" data-method="mai-hoa">
              <span class="ti">Mai Hoa Dịch Số</span>
              <span class="de">Lập quẻ tự động theo giờ hỏi việc</span>
            </button>
            <button type="button" class="qs-method" data-method="seri-tien">
              <span class="ti">Seri tiền</span>
              <span class="de">Tĩnh tâm, rút 1 tờ tiền, nhập số seri</span>
            </button>
            <button type="button" class="qs-method" data-method="3-so">
              <span class="ti">3 số tự nhiên</span>
              <span class="de">Tĩnh tâm, tự chọn hoặc nhập ngẫu nhiên đúng 3 chữ số từ 0-9</span>
            </button>
          </div>

          <div class="qs-field qs-hidden" id="qs-seri-field">
            <label for="f-seri-tien">Seri tiền</label>
            <input class="qs-input" id="f-seri-tien" type="text" inputmode="numeric" placeholder="Ví dụ: AB 12345678" />
            <div class="help">Tĩnh tâm nghĩ về việc đang phân vân, rút ngẫu nhiên 1 tờ tiền đang có trong người, rồi nhập đúng dãy số seri trên tờ đó.</div>
            <details class="qs-detail">
              <summary>Xem hướng dẫn gieo quẻ bằng Seri tiền</summary>
              <div class="body">
                Hãy giữ tâm bình tĩnh và tập trung suy nghĩ về <strong>một việc cần hỏi</strong>. Một việc nên tập trung hỏi một câu rõ ràng, không nên hỏi nhiều việc cùng lúc.<br /><br />
                Sau đó, hãy <strong>rút một tờ tiền bất kỳ hiện đang có bên mình</strong>, nhập <strong>dãy số seri trên tờ tiền</strong> vào ô bên trên và nhấn <strong>Xem kết quả</strong>.<br /><br />
                Hệ thống sẽ tự động lập quẻ và đưa ra kết quả.
              </div>
            </details>
          </div>

          <div class="qs-field qs-hidden" id="qs-3so-field">
            <label for="f-3-so">3 số tự nhiên</label>
            <input class="qs-input" id="f-3-so" type="text" inputmode="numeric" maxlength="3" placeholder="Ví dụ: 768" />
            <div class="help">Tĩnh tâm nghĩ về việc đang phân vân, rồi tự chọn hoặc nhập ngẫu nhiên đúng 3 chữ số từ 0 đến 9 (số thứ nhất = quẻ thượng, số thứ hai = quẻ hạ, số thứ ba = hào động).</div>
          </div>

          <p class="qs-eyebrow">Bước 4 · An quẻ</p>
          <p class="qs-sub" id="qs-step-sub">Thành tâm nghĩ về việc muốn hỏi, tự gieo 3 đồng xu (hoặc vật tương đương) 6 lần từ hào 1 đến hào 6, rồi chọn đúng Âm/Dương và đánh dấu hào động (nếu có) vào bảng dưới.</p>
          <details class="qs-detail" id="qs-gieo-tay-huong-dan">
            <summary>Xem hướng dẫn gieo xu Lục Hào</summary>
            <div class="body">
              Trước khi gieo quẻ, hãy giữ tâm bình tĩnh và tập trung suy nghĩ về <strong>một việc cần hỏi</strong>. Một việc nên tập trung hỏi một câu rõ ràng, không nên hỏi nhiều việc cùng lúc.<br /><br />
              Chuẩn bị <strong>3 đồng xu</strong>.<br /><br />
              <strong>Quy ước:</strong> mặt có nhiều chữ là <strong>Âm</strong>, mặt có ít chữ là <strong>Dương</strong>.<br /><br />
              <strong>Cách xác định hào:</strong><br />
              2 Dương 1 Âm = <strong>Hào Âm</strong><br />
              2 Âm 1 Dương = <strong>Hào Dương</strong><br />
              3 Dương = <strong>Hào Dương động</strong><br />
              3 Âm = <strong>Hào Âm động</strong><br /><br />
              Khi gieo, <strong>nam xóc 7 lần, nữ xóc 9 lần</strong>, sau đó thả 3 đồng xu xuống đĩa và ghi nhận kết quả. Thực hiện liên tục <strong>6 lần</strong>.<br /><br />
              Điền kết quả lần lượt <strong>từ dưới lên trên</strong>, lần gieo đầu tiên là <strong>Hào 1</strong>, lần cuối cùng là <strong>Hào 6</strong>. Nếu xuất hiện <strong>Hào động</strong>, hãy tích chọn vào ô <strong>Động</strong> tương ứng.
            </div>
          </details>
          <div class="qs-hao-table" id="qs-toss-picker"></div>
          <div class="qs-row" style="max-width:420px;">
            <button class="qs-btn" id="qs-gieo" type="button" disabled>Xem kết quả</button>
            <button class="qs-btn qs-btn-ghost" id="qs-lai" type="button" style="display:none;">Làm lại</button>
          </div>

          <div class="qs-result qs-hidden" id="qs-result" data-zalo={siteConfig.social.zalo}></div>

          <script type="application/json" id="qs-question" set:html={JSON.stringify(question)}></script>
          <script>
            import { renderKetQuaHtml } from "../../../lib/quan-su/render-ket-qua-client";

            const qEl = document.getElementById("qs-question");
            const question = JSON.parse(qEl?.textContent || "{}");
            const tossPicker = document.getElementById("qs-toss-picker");
            const gieoBtn = document.getElementById("qs-gieo");
            const laiBtn = document.getElementById("qs-lai");
            const resultEl = document.getElementById("qs-result");
            const ZALO_HREF = resultEl?.dataset.zalo || "";
            const methodsEl = document.getElementById("qs-methods");
            const seriField = document.getElementById("qs-seri-field");
            const so3Field = document.getElementById("qs-3so-field");
            const gieoTayHuongDan = document.getElementById("qs-gieo-tay-huong-dan");
            const stepSub = document.getElementById("qs-step-sub");
            let castingMethod = "gieo-tay";
            const HAO_TEN = { 6: "Thượng", 5: "Ngũ", 4: "Tứ", 3: "Tam", 2: "Nhị", 1: "Sơ" };

            const METHOD_SUB = {
              "gieo-tay": "Thành tâm nghĩ về việc muốn hỏi, tự gieo 3 đồng xu (hoặc vật tương đương) 6 lần từ hào 1 đến hào 6, rồi chọn đúng Âm/Dương và đánh dấu hào động (nếu có) vào bảng dưới.",
              "mai-hoa": "Quân Sư lập quẻ theo đúng thời điểm anh/chị bấm — không cần thao tác gì thêm.",
              "seri-tien": "Tĩnh tâm nghĩ về điều anh/chị đang phân vân, rút ngẫu nhiên 1 tờ tiền, rồi nhập seri của tờ đó.",
              "3-so": "Tĩnh tâm nghĩ về điều anh/chị đang phân vân, rồi tự chọn hoặc nhập ngẫu nhiên đúng 3 chữ số từ 0 đến 9.",
            };
            const METHOD_BTN_LABEL = { "gieo-tay": "Xem kết quả" };

            // Bảng chọn Âm/Dương + Động cho từng hào — đúng kiểu /gieo-que-kinh-dich (khác kiểu bấm
            // ảnh xu trước đây). Mặc định mọi hào là Dương/tĩnh; anh/chị tự đổi theo đúng mặt xu thật
            // đã gieo, không bắt buộc phải bấm hết mới cho xem kết quả — giống hệt trang tham khảo.
            function buildManualPicker() {
              tossPicker.innerHTML = "";
              for (let h = 6; h >= 1; h--) {
                const row = document.createElement("div");
                row.className = "qs-hao-row";
                row.innerHTML = `
                  <span class="qs-hao-label">${h} - ${HAO_TEN[h]}</span>
                  <select class="qs-hao-select" data-hao="${h}">
                    <option value="1">────</option>
                    <option value="0">── ──</option>
                  </select>
                  <label class="qs-hao-dong"><input type="checkbox" data-hao="${h}" /> Động</label>
                `;
                tossPicker.appendChild(row);
              }
              gieoBtn.disabled = false;
            }

            // Đánh dấu ô đã bấm/chọn (đổi màu, viền sáng) — Thầy: "hình như không ấn được" (2026-08-
            // 23). Bản thân select/checkbox vẫn nhận sự kiện bình thường, nhưng KHÔNG có phản hồi
            // hình ảnh khi chọn xong nên trông như chưa ăn. Bắt sự kiện ủy quyền trên cả bảng, không
            // gắn riêng từng hào — đỡ phải gắn lại listener mỗi lần buildManualPicker() dựng lại DOM.
            tossPicker?.addEventListener("change", (e) => {
              if (e.target.matches("select.qs-hao-select")) e.target.classList.add("qs-hao-set");
            });

            // Đổi Âm/Dương (0/1) + Động (có/không) của 1 hào thành tổng 3 đồng xu (6/7/8/9) — đúng
            // công thức: Dương tĩnh=7, Dương động=9 (lão dương), Âm tĩnh=8, Âm động=6 (lão âm). Nhờ
            // vậy dùng lại được thẳng API "tosses" đã có sẵn, không cần sửa gì ở máy chủ.
            function haoToTossSum(gia, dong) {
              if (gia === 1) return dong ? 9 : 7;
              return dong ? 6 : 8;
            }

            function collectManualTosses() {
              const tosses = [];
              for (let h = 1; h <= 6; h++) {
                const gia = Number(tossPicker.querySelector(`select[data-hao="${h}"]`).value);
                const dong = tossPicker.querySelector(`input[type="checkbox"][data-hao="${h}"]`).checked;
                tosses.push(haoToTossSum(gia, dong));
              }
              return tosses;
            }

            methodsEl?.addEventListener("click", (e) => {
              const btn = e.target.closest(".qs-method");
              if (!btn) return;
              methodsEl.querySelectorAll(".qs-method").forEach((b) => b.classList.remove("active"));
              btn.classList.add("active");
              castingMethod = btn.dataset.method;
              seriField.classList.toggle("qs-hidden", castingMethod !== "seri-tien");
              so3Field.classList.toggle("qs-hidden", castingMethod !== "3-so");
              gieoTayHuongDan.classList.toggle("qs-hidden", castingMethod !== "gieo-tay");
              resultEl.classList.add("qs-hidden");
              laiBtn.style.display = "none";
              gieoBtn.textContent = METHOD_BTN_LABEL[castingMethod] || "Lập quẻ";
              if (castingMethod === "gieo-tay") {
                buildManualPicker();
              } else {
                tossPicker.innerHTML = "";
                gieoBtn.disabled = false;
              }
              if (stepSub) stepSub.textContent = METHOD_SUB[castingMethod] || METHOD_SUB["gieo-tay"];
            });

            buildManualPicker(); // mặc định đang ở "gieo-tay" khi tải trang

            async function submit(opts) {
              const moTaEl = document.querySelector('[data-key="mo_ta_tinh_huong"]');
              const doiTuongEl = document.getElementById("f-doi-tuong");
              try {
                resultEl.classList.remove("qs-hidden");
                resultEl.innerHTML = '<p class="qs-sub">Quân Sư đang luận…</p>';
                const res = await fetch("/api/quan-su/luan", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    question_id: question.question_id,
                    castingMethod: opts.castingMethod,
                    tosses: opts.tosses,
                    seriTien: opts.seriTien,
                    soTuNhien: opts.soTuNhien,
                    moTa: moTaEl ? moTaEl.value : undefined,
                    doiTuong: doiTuongEl ? doiTuongEl.value : undefined,
                  }),
                });
                const data = await res.json();
                if (res.status === 401) {
                  resultEl.innerHTML = `<div class="qs-notice">${data.error || "Vui lòng đăng nhập."}</div>
                    <div class="qs-row" style="max-width:360px;margin-top:0.6rem;">
                      <a href="/hoc-vien/dang-nhap?tiep=${encodeURIComponent(location.pathname + location.search)}" class="qs-btn" style="text-decoration:none;">Đăng nhập</a>
                      <a href="/hoc-vien/dang-ky" class="qs-btn qs-btn-ghost" style="text-decoration:none;">Đăng ký</a>
                    </div>`;
                  return;
                }
                if (res.status === 403 || res.status === 429) {
                  // 403 = chưa có gói đủ hạng; 429 = hết lượt (hết 10 lượt khuyến mãi HOẶC hết hạn
                  // 1 tháng khuyến mãi rơi về đây vì lúc đó coi như không còn quyền, HOẶC hết hạn
                  // mức/tháng của gói trả phí) — cả 2 đều dẫn khách sang xem gói thuê bao.
                  resultEl.innerHTML = `<div class="qs-notice">${data.error || "Cần gói thuê bao."}</div>
                    <a href="/quan-su/goi-thue-bao" class="qs-btn" style="text-decoration:none;display:inline-flex;margin-top:0.6rem;">Xem gói thuê bao</a>`;
                  return;
                }
                if (!res.ok) { resultEl.innerHTML = `<div class="qs-notice">${data.error || "Có lỗi xảy ra."}</div>`; return; }
                renderResult(data);
              } catch (e) {
                resultEl.innerHTML = '<div class="qs-notice">Không kết nối được máy chủ, vui lòng thử lại.</div>';
              }
            }

            // Phần dựng HTML kết quả (bảng quẻ, luận AI, chấm điểm...) chuyển sang module dùng chung
            // (10/9/2026) để trang Lịch sử luận giải tái dùng được, khỏi chép lại ~250 dòng.
            function renderResult(data) {
              resultEl.innerHTML = renderKetQuaHtml(data, ZALO_HREF);
              resultEl.scrollIntoView({ behavior: "smooth", block: "start" });
            }

            gieoBtn?.addEventListener("click", () => {
              // Ngày sinh KHÔNG bắt buộc — chỉ để thêm lớp vận trình bổ trợ, không phải điều kiện
              // để gieo quẻ. Bỏ trống thì vẫn luận được bình thường, chỉ là không kèm vận trình.
              // Hào cũng KHÔNG bắt buộc phải tự đổi hết — mặc định Dương/tĩnh vẫn là 1 kết quả gieo
              // hợp lệ, giống hệt hành vi trang tham khảo /gieo-que-kinh-dich (Thầy báo "gieo đồng xu
              // vẫn không được" liên tục, 2026-08-23 — nguyên nhân thật: nút này từng gọi
              // `manualComplete()` nhưng hàm đó CHƯA TỪNG được định nghĩa trong file, nên mỗi lần
              // bấm ở cách gieo tay đều ném ReferenceError và im lặng không làm gì — không phải lỗi
              // vùng chạm nhỏ như đã tưởng trước đó).
              if (castingMethod === "seri-tien") {
                const v = (document.getElementById("f-seri-tien")?.value || "").trim();
                if (v.replace(/\D/g, "").length < 2) { alert("Vui lòng nhập seri tiền (ít nhất 2 chữ số)."); return; }
              }
              if (castingMethod === "3-so") {
                const v = (document.getElementById("f-3-so")?.value || "").trim();
                if (!/^\d{3}$/.test(v)) { alert("Vui lòng nhập đúng 3 chữ số từ 0 đến 9."); return; }
              }
              resultEl.classList.add("qs-hidden");
              gieoBtn.disabled = true;
              laiBtn.style.display = "";

              if (castingMethod === "gieo-tay") {
                submit({ castingMethod, tosses: collectManualTosses() });
              } else if (castingMethod === "seri-tien") {
                submit({ castingMethod, seriTien: document.getElementById("f-seri-tien").value.trim() });
              } else if (castingMethod === "3-so") {
                submit({ castingMethod, soTuNhien: document.getElementById("f-3-so").value.trim() });
              } else {
                submit({ castingMethod });
              }
            });
            laiBtn?.addEventListener("click", () => {
              resultEl.classList.add("qs-hidden");
              laiBtn.style.display = "none";
              if (castingMethod === "gieo-tay") buildManualPicker();
              else gieoBtn.disabled = false;
            });
          </script>
        </>
      )}
    </div>
  </section>

  <BottomNav />
</BaseLayout>
