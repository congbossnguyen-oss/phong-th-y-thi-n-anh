---
// Trang chủ "app Quân Sư" — dựng lại theo đúng 4 ảnh tham khảo Thầy gửi (2026-08-23, chốt phương án
// B: khung app đầy đủ, không chỉ chỉnh từng trang riêng lẻ). Bố cục: Hero đạo sĩ → Module cốt lõi
// "Quân Sư Luận Giải" (RIÊNG, không gộp với Trạch Cát — Thầy nhắc rõ) → 5 icon nhóm nổi bật → toàn
// bộ nhóm câu hỏi (thu gọn) → thẻ Xem Thời Vận → thanh điều hướng 5 tab dưới cùng.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import "../../styles/quan-su.css";
import NutBatThongBao from "../../components/NutBatThongBao.astro";
import { getCategoriesWithCounts } from "../../lib/quan-su";

export const prerender = false;

const categories = getCategoriesWithCounts();

// 5 nhóm nổi bật hiện thành icon tròn ngay dưới module cốt lõi (đúng ảnh 1) — trỏ vào đúng
// category_id thật trong Question Library, không phải mục giả. Nhóm còn lại vẫn xem đủ ở khối
// "Xem tất cả" bên dưới, không mất tính năng nào.
//
// Icon vector 1 màu vàng (không dùng emoji nhiều màu) — Thầy: "icon chỉ để hình vector màu vàng,
// vòng tròn ngoài cũng vàng cho đồng bộ" (2026-08-23). Trước đó dùng emoji + vòng nhiều màu, đổi
// nền tảng hay ra màu khác ý muốn (ví dụ ☯ ra ô vuông tím trên iOS) — vector tự vẽ mới kiểm soát
// được đúng 1 màu trên mọi máy.
const NOI_BAT_DINH_NGHIA = [
  { id: "su-nghiep", label: "Công việc", icon: "briefcase" },
  { id: "tai-chinh", label: "Tài lộc", icon: "coin" },
  { id: "dau-tu", label: "Đầu tư", icon: "trend" },
  { id: "tinh-duyen-hon-nhan", label: "Tình cảm", icon: "heart" },
  { id: "nha-cua", label: "Gia đạo", icon: "home" },
] as const;
const noiBat = NOI_BAT_DINH_NGHIA.filter((n) => categories.some((c) => c.id === n.id));
---

<BaseLayout title="Quân Sư Thiên Anh" description="Hỏi Quân Sư — cố vấn quyết định dựa trên Kinh Dịch." appShell>
  <section class="qs qsh">
    <div class="qsh-hero">
      <img src="/images/quan-su/dao-si.png" alt="Quân Sư Thiên Anh" class="qsh-hero-img" />
      <div class="qsh-hero-text">
        <p class="qsh-tag">Thấu mệnh – Minh vận – Kiến tâm</p>
        <h1 class="qsh-title">Quân Sư<br />Thiên Anh</h1>
        <p class="qsh-slogan">Minh triết dẫn đường – An tâm hành động</p>
        <p class="qsh-sub">Hỏi đúng việc – Luận đúng quẻ – Tìm đúng hướng</p>
      </div>
    </div>

    <div class="qs-wrap" style="margin-top:0;">
      <div id="thong-bao" style="scroll-margin-top:1rem;">
        <NutBatThongBao />
      </div>

      <p class="qs-eyebrow" style="margin-top:1.4rem;">Module cốt lõi</p>
      <div class="qsh-module">
        <span class="qsh-module-ic">
          <img src="/images/quan-su/logo-am-duong.png" alt="" />
        </span>
        <div class="qsh-module-body">
          <h2>Huyền Cơ</h2>
          <p>Hỏi gì – Đáp nấy – Dịch lý soi đường. Đặt một việc, Quân Sư lập quẻ và chỉ hướng.</p>
        </div>
      </div>
      <a href="#hoi" class="qsh-cta">💬 Hỏi Quân Sư</a>

      <h2 id="hoi" class="qsh-section-title">Anh muốn hỏi việc gì?</h2>
      <div class="qsh-icon-row">
        {noiBat.map((n) => (
          <a href={`/quan-su/${n.id}`} class="qsh-icon-item">
            <span class="qsh-icon-badge">
              {n.icon === "briefcase" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5" stroke-linecap="round"/><path d="M3.5 12.5h17" /></svg>
              )}
              {n.icon === "coin" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v9M14.5 9.8c0-1-1-1.8-2.5-1.8s-2.5.9-2.5 1.9c0 2.7 5 1.3 5 4 0 1-1 1.9-2.5 1.9s-2.5-.8-2.5-1.8" stroke-linecap="round"/></svg>
              )}
              {n.icon === "trend" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 17 9.5 11l4 4L20 6" stroke-linecap="round" stroke-linejoin="round"/><path d="M14.5 6H20v5.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {n.icon === "heart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7.5-4.6-9.7-9.3C.6 7 2.4 4 5.6 4c1.9 0 3.4 1 4.4 2.5C11 5 12.5 4 14.4 4c3.2 0 5 3 3.3 6.7C15.5 15.4 12 20 12 20Z" stroke-linejoin="round"/></svg>
              )}
              {n.icon === "home" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 11.5 12 4l9 7.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10v9a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </span>
            <span>{n.label}</span>
          </a>
        ))}
      </div>

      <details class="qsh-more">
        <summary>Xem tất cả {categories.length} nhóm câu hỏi</summary>
        <div class="qs-grid" style="margin-top:1rem;">
          {categories.map((c) => (
            <a class="qs-card" href={`/quan-su/${c.id}`}>
              <div class="ic">{c.icon}</div>
              <div class="ti">{c.title}</div>
              <div class="de">{c.subtitle}</div>
              <div class="ct">{c.questionCount} câu hỏi</div>
            </a>
          ))}
        </div>
      </details>

      <a href="/quan-su/xem-thoi-van" class="qsh-tv-card">
        <div>
          <p class="qs-eyebrow" style="margin:0 0 0.2rem;">Thời vận</p>
          <h3>Xem Thời Vận</h3>
          <p>Đại vận và năm nay đang thuận hay chưa — bằng sơ đồ và luận ngắn.</p>
        </div>
        <span class="qsh-arrow">→</span>
      </a>

      <p class="qs-sub" style="margin-top:1rem;">
        Chưa có gói? <a href="/quan-su/goi-thue-bao" style="color:var(--qs-gold);">Xem gói thuê bao Quân Sư</a>
      </p>

      <!-- Trạch Cát — 9 công cụ nổi bật của Đại Cát Lợi, trỏ THẲNG vào route thật đã có sẵn (không
           tạo trang mới). "Nhập Trạch" và "Động Thổ" cùng trỏ 1 route vì công cụ xem-ngay-cao-cap
           xử lý chung cả 2 việc đó. Cưới Hỏi và Sinh Cho Bé là dịch vụ trả phí đang thử nghiệm nội
           bộ — trang đích tự hiện đúng trạng thái, không cần xử lý gì thêm ở đây. -->
      <p class="qsh-section-title" style="margin-top:0.4rem;">Xem ngày · Trạch Cát</p>
      <div class="qsh-trach-cat-grid">
        {[
          { href: "/xem-ngay-tot-xau", label: "Xem Ngày Tốt", sub: "Cho từng công việc", c: "#5fcf8a", icon: "calendar" },
          { href: "/dai-cat-loi/ngay-ky-hop-dong", label: "Ký Hợp Đồng", sub: "Ngày giờ ký kết", c: "#b18aff", icon: "doc" },
          { href: "/dai-cat-loi/ngay-khai-truong", label: "Khai Trương", sub: "Đại cát – phát lộc", c: "#f0a34d", icon: "store" },
          { href: "/dai-cat-loi/ngay-cuoi-hoi", label: "Cưới Hỏi", sub: "Trọn gói viên mãn", c: "#e879a6", icon: "couple" },
          { href: "/dai-cat-loi/xem-ngay-cao-cap", label: "Nhập Trạch", sub: "Về nhà mới", c: "#4fd1c5", icon: "home" },
          { href: "/dai-cat-loi/xem-ngay-cao-cap", label: "Động Thổ", sub: "Ngày khởi công", c: "#f1c85a", icon: "shovel" },
          { href: "/dai-cat-loi/nhan-chuc", label: "Nhận Chức", sub: "Ngày nhậm chức", c: "#5aa8f1", icon: "badge" },
          { href: "/dai-cat-loi/trach-nhat-sinh-no", label: "Sinh Cho Bé", sub: "Chọn giờ sinh", c: "#7fd99a", icon: "baby" },
          { href: "/tinh-trung-tang", label: "Ngày Trùng Tang", sub: "Tra – phân tích", c: "#e8735c", icon: "bowl" },
        ].map((t) => (
          <a href={t.href} class="qsh-tc-item" style={`--c:${t.c};`}>
            <span class="qsh-tc-badge">
              {t.icon === "calendar" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4" stroke-linecap="round"/></svg>}
              {t.icon === "doc" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3.5h9l3 3v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1Z" stroke-linejoin="round"/><path d="M8.5 12h7M8.5 15.5h7M8.5 8.5h4" stroke-linecap="round"/></svg>}
              {t.icon === "store" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 9.5 5 4h14l1 5.5" stroke-linejoin="round"/><path d="M4 9.5a2.3 2.3 0 0 0 4.4 1 2.3 2.3 0 0 0 4.4 0 2.3 2.3 0 0 0 4.4 0 2.3 2.3 0 0 0 4.4-1" stroke-linejoin="round"/><path d="M5.5 11v9h13v-9" /><path d="M10 20v-5.5h4V20" /></svg>}
              {t.icon === "couple" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="8.5" cy="7" r="2.6"/><circle cx="15.5" cy="7" r="2.6"/><path d="M3.5 20v-2.5a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4V20M10.5 20v-2.5a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4V20" stroke-linecap="round"/></svg>}
              {t.icon === "home" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 11.5 12 4l9 7.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10v9a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-9" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              {t.icon === "shovel" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M15 3 21 9l-3 3-6-6Z" stroke-linejoin="round"/><path d="M13.5 8.5 4 18a2.1 2.1 0 0 0 3 3l9.5-9.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              {t.icon === "badge" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="9" r="5.5"/><path d="M9 13.5 7 21l5-2.5L17 21l-2-7.5" stroke-linejoin="round"/></svg>}
              {t.icon === "baby" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8.5"/><path d="M9 13c.7.9 1.8 1.5 3 1.5s2.3-.6 3-1.5" stroke-linecap="round"/><path d="M9 9.5h.01M15 9.5h.01" stroke-linecap="round" stroke-width="2.4"/></svg>}
              {t.icon === "bowl" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3.5 11h17a8.5 6 0 0 1-17 0Z" stroke-linejoin="round"/><path d="M7 11V8a5 5 0 0 1 10 0v3" /></svg>}
            </span>
            <span class="qsh-tc-label">{t.label}</span>
            <span class="qsh-tc-sub">{t.sub}</span>
          </a>
        ))}
      </div>

      <!-- Dịch vụ VIP — trỏ vào hub trả-phí-theo-lượt sẵn có, KHÔNG nằm trong gói thuê bao Quân Sư
           (mô hình thu phí khác nhau, xem project_quan-su-app-scope.md). -->
      <a href="/dai-cat-loi/dich-vu-thu-phi" class="qsh-vip-card">
        <img src="/images/quan-su/rong-vang.png" alt="" class="qsh-vip-bg" />
        <div class="qsh-vip-crown">👑</div>
        <div class="qsh-vip-body">
          <p class="qsh-vip-badge">VIP</p>
          <h3>Tư vấn 1:1 cùng chuyên gia</h3>
          <p>Phân tích chuyên sâu · Giải pháp cá nhân hóa · Bảo mật tuyệt đối</p>
          <span class="qsh-vip-cta">Khám phá ngay →</span>
        </div>
      </a>

      <!-- Công cụ hữu ích — CHỈ 4/8 mục có trang thật tương ứng trên site (Can Chi/Ngũ Hành/Cung
           Hoàng Đạo/Phong Thủy Nhà chưa có công cụ tra cứu riêng — không đưa vào để tránh dẫn khách
           tới trang không tồn tại; bổ sung sau khi các công cụ đó được xây). -->
      <p class="qsh-section-title">Công cụ hữu ích</p>
      <div class="qsh-tool-grid">
        {[
          { href: "/dai-cat-loi/doi-lich-am-duong", label: "Đổi Lịch", icon: "calendar" },
          { href: "/gieo-que-kinh-dich", label: "64 Quẻ Dịch", icon: "yinyang" },
          { href: "/dai-cat-loi/ngay-gio-xuat-hanh", label: "Hướng Xuất Hành", icon: "compass" },
          { href: "/dai-cat-loi/gio-tot-trong-ngay", label: "Giờ Hoàng Đạo", icon: "clock" },
        ].map((t) => (
          <a href={t.href} class="qsh-tool-item">
            <span class="qsh-tool-ic">
              {t.icon === "calendar" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4" stroke-linecap="round"/></svg>}
              {t.icon === "yinyang" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9" /><path d="M12 3a4.5 4.5 0 0 1 0 9 4.5 4.5 0 0 0 0 9 9 9 0 0 0 0-18Z" fill="currentColor" stroke="none" /><circle cx="12" cy="7.5" r="1.1" fill="var(--qs-midnight)" stroke="none" /><circle cx="12" cy="16.5" r="1.1" fill="currentColor" stroke="none" /></svg>}
              {t.icon === "compass" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9" /><path d="m15 9-2 6-6 2 2-6 6-2Z" stroke-linejoin="round" /></svg>}
              {t.icon === "clock" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
            </span>
            <span>{t.label}</span>
          </a>
        ))}
      </div>

      <!-- Banner cuối trang — ảnh hoa sen + đèn lồng nền trong suốt, chữ đè lên giữa. -->
      <div class="qsh-banner">
        <img src="/images/quan-su/hoa-sen.png" alt="" class="qsh-banner-bg" />
        <p>Hỏi việc – Luận quẻ – Biết thời<br />Chọn thời – Hành động – Chủ động cuộc đời</p>
      </div>
    </div>
  </section>

  <BottomNav />
</BaseLayout>

<style>
  /* Riêng trang chủ Quân Sư: PHẲNG, không dùng ảnh nền huyền học riêng nữa — ảnh hero (dao-si.png)
     giờ đã gộp sẵn đủ phong cảnh/trăng/bát quái, thêm 1 ảnh nền nữa ở dưới là thừa (Thầy: "bỏ 2 ảnh
     đó đi thay bằng ảnh đạo sĩ 2", 2026-08-23 — chỉ còn ĐÚNG 1 ảnh cho cả trang chủ). Ghi đè nền
     phẳng cho `.qsh` thay vì đụng `.qs` trong quan-su.css, để KHÔNG ảnh hưởng các trang khác (danh
     sách câu hỏi, kết quả luận...) vẫn đang dùng ảnh nền đó bình thường. */
  .qsh { padding-top: 0; background: var(--qs-midnight); }

  /* MỘT ảnh đạo sĩ xuyên suốt làm nền, chữ đè lên trên — KHÔNG tách 2 khối riêng (Thầy: "chỉ cần
     để 1 ảnh của Quân Sư thôi", 2026-08-23). Ảnh phủ toàn bộ hero, làm mờ dần từ trái (chữ) sang
     phải + từ trên xuống dưới để chữ vẫn đọc rõ mà ảnh không bị cắt cứng thành khối riêng. */
  .qsh-hero {
    position: relative;
    /* Ảnh gốc khổ dọc cao (941×1672 ~ tỉ lệ 0.56) — khung càng thấp càng cắt mất nhiều ảnh. 460px
       lộ được phần thân trên + cuộn giấy trên tay đầy đủ hơn hẳn mốc 400px cũ (Thầy: "ảnh đạo sĩ
       bị cắt 1/2", 2026-08-23). */
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--qs-midnight);
  }
  .qsh-hero-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 78% 8%;
  }
  .qsh-hero::before {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(7,6,5,0.97) 0%, rgba(7,6,5,0.86) 50%, rgba(7,6,5,0.3) 82%, rgba(7,6,5,0.08) 100%),
      linear-gradient(0deg, rgba(7,6,5,0.94) 0%, rgba(7,6,5,0.25) 55%, rgba(7,6,5,0.4) 100%);
  }
  .qsh-hero-text { position: relative; z-index: 1; padding: 1.6rem 1.2rem 1.4rem; max-width: 74%; }
  /* Chữ vàng/ivory trên ảnh có mảng sáng vàng-kim dễ bị lẫn nền — Thầy: "đang bị hòa vào màu nền"
     (2026-08-23). Ngoài tăng độ tối của lớp phủ (::before trên), thêm text-shadow làm viền tối
     quanh chữ — cách chắc chắn nhất, không phụ thuộc vùng sáng/tối cụ thể của ảnh nền. */
  .qsh-tag {
    color: var(--qs-gold); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.7rem; font-weight: 700; margin: 0 0 0.4rem;
    text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.8);
  }
  .qsh-title {
    font-family: "Cormorant Garamond", Georgia, serif; font-weight: 700;
    font-size: clamp(1.9rem, 8vw, 2.6rem); line-height: 1.05; color: var(--qs-ivory); margin: 0 0 0.6rem;
    text-shadow: 0 2px 6px rgba(0,0,0,0.9), 0 4px 22px rgba(0,0,0,0.7);
  }
  .qsh-slogan { color: var(--qs-ivory); font-size: 0.85rem; margin: 0 0 0.3rem; text-shadow: 0 1px 4px rgba(0,0,0,0.85); }
  .qsh-sub { color: var(--qs-muted); font-size: 0.76rem; margin: 0; text-shadow: 0 1px 4px rgba(0,0,0,0.85); }

  .qsh-module {
    display: flex; gap: 0.9rem; align-items: flex-start;
    background: linear-gradient(160deg, rgba(241, 200, 90, 0.1), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(241, 200, 90, 0.28); border-radius: 16px; padding: 1.1rem;
  }
  .qsh-module-ic {
    flex: 0 0 auto; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
    border-radius: 999px; overflow: hidden; border: 1px solid rgba(241, 200, 90, 0.35);
    box-shadow: 0 0 14px rgba(241, 200, 90, 0.2);
  }
  /* Logo Am Dương (Thầy cấp) đã là badge tròn nền tối sẵn — bọc tròn + viền vàng nhẹ thay vì nền
     tint riêng, tránh chồng 2 lớp nền lên nhau. */
