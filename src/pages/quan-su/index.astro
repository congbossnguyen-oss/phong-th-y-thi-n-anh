---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/quan-su.css";
import NutBatThongBao from "../../components/NutBatThongBao.astro";
import { APP_OPENING_PROMPT, getCategoriesWithCounts } from "../../lib/quan-su";

export const prerender = false;

const categories = getCategoriesWithCounts();
---

<BaseLayout title="Quân Sư Thiên Anh" description="Hỏi Quân Sư — cố vấn quyết định dựa trên Kinh Dịch.">
  <section class="qs">
    <div class="qs-wrap">
      <p class="qs-eyebrow">Quân Sư Thiên Anh</p>
      <h1 class="qs-h1">{APP_OPENING_PROMPT}</h1>
      <p class="qs-sub">Chọn một vấn đề anh/chị đang phân vân — Quân Sư sẽ cùng anh/chị nhìn cho rõ.</p>

      <NutBatThongBao />


      <div class="qs-grid">
        {categories.map((c) => (
          <a class="qs-card" href={`/quan-su/${c.id}`}>
            <div class="ic">{c.icon}</div>
            <div class="ti">{c.title}</div>
            <div class="de">{c.subtitle}</div>
            <div class="ct">{c.questionCount} câu hỏi</div>
          </a>
        ))}
        <a class="qs-card" href="/quan-su/xem-thoi-van">
          <div class="ic">🌙</div>
          <div class="ti">Xem Thời Vận</div>
          <div class="de">Đại vận và năm nay đang thuận hay chưa — bằng sơ đồ và luận ngắn.</div>
          <div class="ct">Dành cho khách có gói</div>
        </a>
      </div>

      <p class="qs-sub" style="margin-top:1.6rem;">
        Chưa có gói? <a href="/quan-su/goi-thue-bao" style="color:var(--qs-gold);">Xem gói thuê bao Quân Sư</a>
      </p>
    </div>
  </section>
</BaseLayout>
