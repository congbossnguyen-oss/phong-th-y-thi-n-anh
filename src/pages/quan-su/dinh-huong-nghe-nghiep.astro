// (App Store, không link ra web). Module này ĐANG BÁN THẬT trên web nhưng trước đây hoàn toàn
// KHÔNG có mặt trong app: nó cố ý không nằm trong `paidTools` (xem ghi chú đầu danh sách đó) nên
// trang /quan-su/dich-vu-vip — vốn dựng từ paidTools — cũng không liệt kê. Nay bổ sung thẳng vào
// danh sách VIP của app cùng với trang này.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
