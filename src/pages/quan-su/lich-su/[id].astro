---
// CHI TIẾT 1 LƯỢT LỊCH SỬ — xem chú thích đầu file lich-su/index.astro.
//
// "Cách hóa giải" tính khoá/mở theo GÓI HIỆN TẠI (lúc khách MỞ LẠI trang này), KHÔNG phải gói lúc
// hỏi — nếu khách nâng cấp lên Cao cấp sau đó, mở lại lịch sử cũ cũng thấy được hóa giải luôn (đúng
// tinh thần "trả tiền Cao cấp là được xem đủ", không phải mãi mãi mất phần đó vì lúc hỏi còn Cơ
// bản). Cùng logic hệt luan.ts.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BottomNav from "../../../components/quan-su/BottomNav.astro";
import "../../../styles/quan-su.css";
import { getQuestion } from "../../../lib/quan-su";
import { siteConfig } from "../../../lib/site-config";
import { layMotLuotLichSu } from "../../../lib/quan-su/lich-su-luan";
import { duocKhuyenMai } from "../../../lib/quan-su/khuyen-mai-luan-giai";
import { layGoiDangHoatDong } from "../../../lib/subscriptions/access";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/hoc-vien/dang-nhap?tiep=${encodeURIComponent(Astro.url.pathname)}`);
}

const { id } = Astro.params;
const muc = id ? await layMotLuotLichSu(user.id, id) : null;
if (!muc) {
  return Astro.redirect("/quan-su/lich-su");
}

const cauHoi = getQuestion(muc.questionId);

let hoaGiaiBiKhoa = false;
if (user.isAdmin !== true && muc.ketQua.luanAI && muc.ketQua.luanAI.phuong_phap_hoa_giai.length > 0) {
  const coKhuyenMai = await duocKhuyenMai(user.id);
  if (!coKhuyenMai) {
    const goiThat = await layGoiDangHoatDong(user.id);
    hoaGiaiBiKhoa = goiThat?.tier !== "cao_cap";
  }
}

const TEN_CACH_LAP: Record<string, string> = {
  "gieo-tay": "Gieo đồng xu",
  "mai-hoa": "Mai hoa dịch số",
  "seri-tien": "Seri tiền",
  "3-so": "3 số tự nhiên",
};

function dinhDangNgayGio(d: Date): string {
  return new Intl.DateTimeFormat("vi-VN", {
    day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit",
    timeZone: "Asia/Ho_Chi_Minh",
  }).format(d);
}
---

<BaseLayout title={`${cauHoi?.title ?? "Lượt hỏi"} — Lịch sử Quân Sư`} description="Xem lại 1 lượt luận giải Quân Sư đã hỏi." appShell noIndex>
  <section class="qs">
    <div class="qs-wrap">
      <a class="qs-back" href="/quan-su/lich-su">← Lịch sử luận giải</a>
      <p class="qs-eyebrow" style="margin-top:1rem;">{dinhDangNgayGio(muc.createdAt)} · {TEN_CACH_LAP[muc.castingMethod] ?? muc.castingMethod}</p>
      <h1 class="qs-h1">{cauHoi?.title ?? muc.ketQua.question?.title ?? "Câu hỏi"}</h1>

      {muc.questionId === "cau-hoi-tu-do" && muc.dauVao.moTa && (
        <p class="qs-sub" style="font-style:italic;">"{muc.dauVao.moTa}"</p>
      )}
      {muc.dauVao.castingMethod === "seri-tien" && muc.dauVao.seriTien && (
        <p class="qs-sub">Seri tiền đã dùng: <strong style="color:var(--qs-ivory);">{muc.dauVao.seriTien}</strong></p>
      )}
      {muc.dauVao.castingMethod === "3-so" && muc.dauVao.soTuNhien && (
        <p class="qs-sub">3 số đã dùng: <strong style="color:var(--qs-ivory);">{muc.dauVao.soTuNhien}</strong></p>
      )}

      <div id="ls-result" data-zalo={siteConfig.social.zalo}></div>

      <script type="application/json" id="ls-data" set:html={JSON.stringify({ ...muc.ketQua, hoaGiaiBiKhoa })}></script>
      <script>
        import { renderKetQuaHtml } from "../../../lib/quan-su/render-ket-qua-client";
        const dataEl = document.getElementById("ls-data");
        const data = JSON.parse(dataEl?.textContent || "{}");
        const resultEl = document.getElementById("ls-result");
        if (resultEl) resultEl.innerHTML = renderKetQuaHtml(data, resultEl.dataset.zalo || "");
      </script>
    </div>
  </section>

  <BottomNav />
</BaseLayout>
