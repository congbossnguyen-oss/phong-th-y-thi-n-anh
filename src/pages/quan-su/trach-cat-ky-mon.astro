---
// Bản in-app của dịch vụ VIP "Trạch Cát Kỳ Môn" — tự chứa trong app Quân Sư (App Store, không link
// ra web). Trước đây trang này CHƯA TỒN TẠI: nút "Trạch Cát Kỳ Môn" ở /quan-su/dich-vu-vip trỏ tới
// /quan-su/trach-cat-ky-mon, rơi vào route bắt-tất [category].astro (dành cho nhóm câu hỏi Hỏi Đáp,
// không phải danh mục dịch vụ VIP) rồi lặng lẽ redirect về /quan-su — khách bấm vào coi như vô hiệu.
//
// Từ 1/9/2026: dùng bản component ĐỘC LẬP `components/quan-su/tools/TrachCatKyMon.astro` (toolSlug
// `trach-cat-ky-mon-qs`, API riêng `/api/quan-su/vip/trach-cat-ky-mon-qs/*`) thay vì component
// dùng chung với web — module 9/12 trong việc tách Quân Sư khỏi web.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";
import TrachCatKyMon from "../../components/quan-su/tools/TrachCatKyMon.astro";
import SapRaMat from "../../components/quan-su/SapRaMat.astro";

export const prerender = false;

// Nhóm Kỳ Môn để dạng SẮP RA MẮT (anh Công 27/8/2026) — còn hoàn thiện thêm về phương pháp.
// Chỉ tài khoản quản trị vào dùng thật để kiểm thử; khách thấy màn thông báo.
const laQuanTri = Astro.locals.user?.isAdmin === true;
---

<BaseLayout title="Trạch Cát Kỳ Môn — Quân Sư Thiên Anh" description="Trạch Cát Kỳ Môn trong app Quân Sư." appShell>
  <PageHero
    eyebrow="Kỳ Môn Độn Giáp"
    title="Trạch Cát Kỳ Môn"
    breadcrumbs={[{ label: "Quân Sư", href: "/quan-su" }, { label: "Kỳ Môn Độn Giáp", href: "/quan-su/ky-mon" }, { label: "Trạch Cát Kỳ Môn" }]}
  />
  {laQuanTri ? (
    <>
      <VipQuyenBanner />
    <TrachCatKyMon anGia />
    </>
  ) : (
    <SapRaMat ten="Trạch Cát Kỳ Môn" moTa="Chọn ngày giờ tốt theo bàn Kỳ Môn Mệnh của chính chủ sự — mỗi người ra một bộ ngày riêng." />
  )}
  <BottomNav />
</BaseLayout>
