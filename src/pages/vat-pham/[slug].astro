---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { products } from "../../lib/placeholder-data";

export const prerender = true;

export async function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;

import { formatProductPrice as formatPrice } from "../../lib/product-price";

// Nội dung giới thiệu chi tiết (một số sản phẩm mới có). Cast để tránh lỗi union khi mảng sản phẩm
// không đồng nhất — cùng cách trang đang xử lý `product.benefits`.
type KhoiNoiDung = { tieuDe?: string; doanVan?: string[]; gachDau?: string[]; luuY?: string; cta?: string };
const noiDungChiTiet = (product as { noiDungChiTiet?: KhoiNoiDung[] }).noiDungChiTiet;
---

<BaseLayout title={product.name} description={`${product.name} — vật phẩm phong thủy ${product.category} từ Thiên Anh.`}>
  <PageHero
    eyebrow="Vật phẩm"
    title={product.name}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Vật phẩm", href: "/vat-pham" }, { label: product.name }]}
  />

  <Container class="grid gap-10 py-16 lg:grid-cols-2">
    <div class="aspect-square overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
      {product.image ? (
        <img src={product.image} alt={product.name} class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-(--color-ink-500)">Ảnh đang cập nhật</div>
      )}
    </div>

    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-(--color-gold-500)">{product.category}</p>
      <h1 class="mt-2 font-display text-2xl font-semibold text-(--color-ink-950) sm:text-3xl">{product.name}</h1>
      <p class="mt-3 font-display text-3xl font-semibold text-(--color-gold-300)">{formatPrice(product.price)}</p>

      <p class="mt-5 text-sm leading-relaxed text-(--color-ink-700)">
        {product.description ?? (
          <>
            Mô tả chi tiết công dụng, chất liệu và hướng dẫn sử dụng vật phẩm sẽ được cập nhật đầy đủ khi có
            nội dung chính thức. Vật phẩm được lựa chọn kỹ lưỡng, phù hợp cho mục đích {product.category.toLowerCase()}.
          </>
        )}
      </p>

      <div class="mt-6 flex items-center gap-3">
        <div class="flex items-center rounded-(--radius-control) border border-(--color-ivory-300)">
          <button type="button" id="qty-decrease" aria-label="Giảm số lượng" class="flex size-11 items-center justify-center text-(--color-ink-800) hover:bg-(--color-ivory-200)">−</button>
          <span id="qty-value" class="w-10 text-center text-sm font-medium" aria-live="polite">1</span>
          <button type="button" id="qty-increase" aria-label="Tăng số lượng" class="flex size-11 items-center justify-center text-(--color-ink-800) hover:bg-(--color-ivory-200)">+</button>
        </div>
        <Button
          size="lg"
          id="add-to-cart-btn"
          class="js-add-to-cart flex-1"
          data-slug={product.slug}
          data-name={product.name}
          data-price={String(product.price)}
          data-qty="1"
        >
          <Icon name="cart" class="size-4.5" />
          Thêm vào giỏ hàng
        </Button>
      </div>
      <p class="mt-3 text-xs text-(--color-ink-600)">Thanh toán khi nhận hàng (COD) hoặc chuyển khoản — không cần thẻ tín dụng.</p>
    </div>
  </Container>

  {noiDungChiTiet && (
    <section class="border-t border-(--color-ivory-300) bg-(--color-ivory-50) py-16">
      <Container class="max-w-3xl">
        <div class="space-y-9">
          {noiDungChiTiet.map((khoi) => (
            <div>
              {khoi.cta ? (
                <div class="rounded-(--radius-card) border-2 border-(--color-cinnabar-400) bg-(--color-cinnabar-400)/10 px-6 py-5 text-center">
                  <p class="font-display text-lg font-bold uppercase tracking-wide text-(--color-cinnabar-500)">{khoi.cta}</p>
                </div>
              ) : (
                <>
                  {khoi.tieuDe && (
                    <h2 class="font-display text-xl font-semibold text-(--color-ink-950) sm:text-2xl">{khoi.tieuDe}</h2>
                  )}
                  {khoi.doanVan?.map((doan) => (
                    <p class="mt-3 text-sm leading-relaxed text-(--color-ink-700)">{doan}</p>
                  ))}
                  {khoi.gachDau && (
                    <ul class="mt-4 space-y-2.5">
                      {khoi.gachDau.map((y) => (
                        <li class="flex items-start gap-3 text-sm leading-relaxed text-(--color-ink-700)">
                          <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-(--color-gold-300)/12 text-(--color-gold-400)">
                            <Icon name="check-circle" class="size-4" />
                          </span>
                          <span>{y}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {khoi.luuY && (
                    <p class="mt-4 rounded-(--radius-card) border-l-4 border-(--color-gold-400) bg-(--color-gold-300)/8 px-4 py-3 text-sm italic leading-relaxed text-(--color-ink-800)">
                      {khoi.luuY}
                    </p>
                  )}
                </>
              )}
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  {product.benefits && (
    <section class="bg-(--color-ivory-100) py-16">
      <Container>
        <h2 class="font-display text-2xl font-semibold text-(--color-ink-950)">Công dụng nổi bật</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {product.benefits.map((benefit) => (
            <div class="flex items-start gap-3 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-5">
              <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-(--color-gold-300)/10 text-(--color-gold-400)">
                <Icon name="check-circle" class="size-4.5" />
              </span>
              <div>
                <h3 class="font-display text-base font-semibold text-(--color-ink-950)">{benefit.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-(--color-ink-600)">{benefit.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  <script>
    const qtyValue = document.getElementById("qty-value")!;
    const addBtn = document.getElementById("add-to-cart-btn")!;
    let qty = 1;

    document.getElementById("qty-decrease")?.addEventListener("click", () => {
      qty = Math.max(1, qty - 1);
      qtyValue.textContent = String(qty);
      addBtn.dataset.qty = String(qty);
    });
    document.getElementById("qty-increase")?.addEventListener("click", () => {
      qty += 1;
      qtyValue.textContent = String(qty);
      addBtn.dataset.qty = String(qty);
    });
  </script>
</BaseLayout>
