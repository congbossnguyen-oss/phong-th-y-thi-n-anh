---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { products } from "../../lib/placeholder-data";

export const prerender = true;

export async function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;

const formatPrice = (price: number) =>
  price.toLocaleString("vi-VN", { style: "currency", currency: "VND" });
---

<BaseLayout title={product.name} description={`${product.name} — vật phẩm phong thủy ${product.category} từ Thiên Anh.`}>
  <PageHero
    eyebrow="Vật phẩm"
    title={product.name}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Vật phẩm", href: "/vat-pham" }, { label: product.name }]}
  />

  <Container class="grid gap-10 py-16 lg:grid-cols-2">
    <div class="aspect-square rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
      <!-- TODO: ảnh sản phẩm thật (nhiều góc) từ Sanity -->
    </div>

    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-(--color-gold-500)">{product.category}</p>
      <h1 class="mt-2 font-display text-2xl font-semibold text-(--color-ink-950) sm:text-3xl">{product.name}</h1>
      <p class="mt-3 font-display text-3xl font-semibold text-(--color-cinnabar-500)">{formatPrice(product.price)}</p>

      <p class="mt-5 text-sm leading-relaxed text-(--color-ink-700)">
        Mô tả chi tiết công dụng, chất liệu và hướng dẫn sử dụng vật phẩm sẽ được cập nhật đầy đủ khi có
        nội dung chính thức. Vật phẩm được lựa chọn kỹ lưỡng, phù hợp cho mục đích {product.category.toLowerCase()}.
      </p>

      <div class="mt-6 flex items-center gap-3">
        <div class="flex items-center rounded-(--radius-control) border border-(--color-ivory-300)">
          <button type="button" aria-label="Giảm số lượng" class="flex size-11 items-center justify-center text-(--color-ink-800) hover:bg-(--color-ivory-200)">−</button>
          <span class="w-10 text-center text-sm font-medium" aria-live="polite">1</span>
          <button type="button" aria-label="Tăng số lượng" class="flex size-11 items-center justify-center text-(--color-ink-800) hover:bg-(--color-ivory-200)">+</button>
        </div>
        <Button size="lg" class="flex-1">
          <Icon name="cart" class="size-4.5" />
          Thêm vào giỏ hàng
        </Button>
      </div>
      <p class="mt-3 text-xs text-(--color-ink-600)">Thanh toán khi nhận hàng (COD) hoặc chuyển khoản — không cần thẻ tín dụng.</p>
    </div>
  </Container>
</BaseLayout>
