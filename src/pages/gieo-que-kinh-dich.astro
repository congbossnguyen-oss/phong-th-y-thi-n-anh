    "Phong Thủy Hoán": "Cách Hà Ngộ Đò",
    "Thủy Trạch Tiết": "Chước Lộc Tầm Đường",
    "Phong Trạch Trung Phu": "Hành Tẩu Bạc Băng",
    "Lôi Sơn Tiểu Quá": "Cấp Quá Độc Kiều / Phi Điểu Di Âm",
    "Thủy Hỏa Ký Tế": "Kim Bảng Đề Danh",
    "Hỏa Thủy Vị Tế": "Thái Tuế Nguyệt Kiến / Tiểu Hồ Ngật Tế",
  };

  // Nhãn đời quái chỉ giữ lại khi thuộc nhóm "đáng chú ý" (Lục Hợp/Lục Xung/Du Hồn/Quy Hồn) — bỏ các
  // nhãn thông thường (Bát Thuần/Nhất Thế..Ngũ Thế) theo đúng yêu cầu, chỉ xử lý chuỗi hiển thị
  // `cungLabel` đã có sẵn từ engine, không tính lại giá trị.
  const NOTABLE_CUNG_TAGS = new Set(["Lục Hợp", "Lục Xung", "Du Hồn", "Quy Hồn"]);
  function formatHoQue(cungName: string, cungLabel: string): string {
    const m = cungLabel.match(/\(([^)]+)\)/);
    const tag = m ? m[1] : null;
    return tag && NOTABLE_CUNG_TAGS.has(tag) ? `Họ ${cungName} (${tag})` : `Họ ${cungName}`;
  }

  // Chữ Họ quẻ và tên tượng quẻ LUÔN giữ màu cố định (ghi/đen), không đổi theo hào động — chỉ vạch hào
  // (`dongPositions`, dùng riêng cho `lightHexBars`) mới đổi màu đỏ khi động.
  function lightQueBlock(name: string, lines: readonly (0 | 1)[], dongPositions: number[], cungText: string, tenTuong?: string): string {
    const subColor = LIGHT.textMuted;
    const tenTuongColor = LIGHT.text;
    return `
      <div style="border:1.5px solid ${LIGHT.borderLight};border-radius:10px;padding:14px 10px;text-align:center;">
        <p style="margin:0;font-size:16px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;color:${LIGHT.red};">${name}</p>
        <div style="margin-top:10px;">${lightHexBars(lines, dongPositions)}</div>
        <p style="margin:10px 0 0;font-size:12px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:${subColor};">${cungText}</p>
        ${tenTuong ? `<p style="margin:4px 0 0;font-size:10px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:${tenTuongColor};">${tenTuong}</p>` : ""}
      </div>
    `;
  }

  // Bảng hào cho 1 bên (Chính hoặc Biến), đúng bố cục ảnh mẫu simkinhdich.com: tách 2 bảng xếp chồng —
  // bảng trên (Nạp Giáp/Lục Thân/Tuần Không...) + bảng dưới (Vượng Suy/Trường Sinh). Chỉ đọc field có
  // sẵn từ engine (`h.xunKong`, `h.growthDay`, `h.growthMonth`, `h.nguHanh`...), không tự tính lại gì.
  // `Q.Thần` chưa có nguồn xác nhận công thức nên luôn hiện "-" (theo đúng chỉ thị, không tự suy đoán).
  // T/Ư chỉ hiện ở bên Chính (Thế/Ứng an tại quẻ chính); Lục Thú chỉ hiện ở bên Biến; P.Thần chỉ hiện
  // ở bên Chính — theo đúng yêu cầu rút gọn cột.
  // `dongPositions`: engine không đánh dấu `isDong` cho hào bên Biến (biến không tự mang trạng thái
  // động), nên bên Biến cần vị trí hào động của Chính truyền vào để tô đỏ đúng hào đã "hóa ra".
  function sideHaoTables(q: QueDayDu, isBien: boolean, dongPositions: number[] = []): string {
    const rows = [...q.hao].reverse();

    const headerLabels = [
      "Hào",
      ...(isBien ? [] : ["T/Ư"]),
      "Lục Thân",
      "Địa Chi",
      ...(isBien ? [] : ["P.Thần"]),
      "T.K",
      ...(isBien ? ["Lục Thú"] : []),
    ];
    const upperHeader = headerLabels.map((label) => `<th style="padding:5px 3px;">${label}</th>`).join("");

    // P.Thần (Phục Thần) KHÔNG được tô đỏ dù hào đó có động hay không — Phục Thần là hào ẩn mượn từ
    // quẻ thuần bản cung, không phải hào thật đang động trong quẻ hiện tại, nên giữ nguyên màu chữ.
    const upperRows = rows
      .map((h) => {
        const isRowDong = h.isDong || dongPositions.includes(h.hao);
        const rowColor = isRowDong ? LIGHT.dong : LIGHT.text;
        const cells = [
          `<td style="padding:5px 4px;text-align:center;font-weight:700;color:${rowColor};">${h.value === 1 ? "&mdash;" : "&#8212;&nbsp;&#8212;"}</td>`,
          ...(isBien ? [] : [`<td style="padding:5px 4px;text-align:center;color:${rowColor};font-weight:600;">${h.theUng ?? ""}</td>`]),
          `<td style="padding:5px 4px;text-align:center;color:${rowColor};font-weight:${isRowDong ? "700" : "400"};">${h.lucThan}</td>`,
          `<td style="padding:5px 4px;text-align:center;color:${rowColor};font-weight:700;white-space:nowrap;">${CHI[h.chiIndex]} - ${h.nguHanh}</td>`,
          ...(isBien ? [] : [`<td style="padding:5px 4px;text-align:center;color:${LIGHT.text};white-space:nowrap;">${h.phucThan ? `${CHI[h.phucThan.chiIndex]} - ${CHI_NGU_HANH[h.phucThan.chiIndex]}` : "-"}</td>`]),
          `<td style="padding:5px 4px;text-align:center;color:${rowColor};">${h.xunKong ? "K" : "-"}</td>`,
          ...(isBien ? [`<td style="padding:5px 4px;text-align:center;color:${rowColor};">${h.lucThu}</td>`] : []),
        ];
        return `<tr style="border-bottom:1px solid ${LIGHT.borderLight};">${cells.join("")}</tr>`;
      })
      .join("");

    const lowerRows = rows
      .map((h) => {
        const rowColor = h.isDong || dongPositions.includes(h.hao) ? LIGHT.dong : LIGHT.text;
        return `
          <tr style="border-bottom:1px solid ${LIGHT.borderLight};">
            <td style="padding:5px 4px;text-align:center;font-weight:700;color:${rowColor};white-space:nowrap;">${CHI[h.chiIndex]} - ${h.nguHanh}</td>
            <td style="padding:5px 4px;text-align:center;color:${rowColor};">${h.vuongSuy}</td>
            <td style="padding:5px 4px;text-align:center;color:${rowColor};">-</td>
            <td style="padding:5px 4px;text-align:center;color:${rowColor};">${h.growthDay}</td>
            <td style="padding:5px 4px;text-align:center;color:${rowColor};">${h.growthMonth}</td>
          </tr>
        `;
      })
      .join("");

    return `
      <div>
        <table style="width:100%;border-collapse:collapse;font-size:15px;">
          <thead>
            <tr style="background:${LIGHT.headerBg};">${upperHeader}</tr>
          </thead>
          <tbody>${upperRows}</tbody>
        </table>
        <table style="width:100%;border-collapse:collapse;font-size:15px;margin-top:10px;">
          <thead>
            <tr style="background:${LIGHT.headerBg};">
              <th style="padding:5px 3px;">Hào</th><th style="padding:5px 3px;">V-S</th><th style="padding:5px 3px;">Q.Thần</th><th style="padding:5px 3px;">TS Ngày</th><th style="padding:5px 3px;">TS Tháng</th>
            </tr>
          </thead>
          <tbody>${lowerRows}</tbody>
        </table>
      </div>
    `;
  }

  function buildExportCardHtml(cast: FullCastResult, methodLabel: string, viecCanXem: string, timeLabel: string): string {
    const queCols = cast.bien ? 3 : 2;
    const blocks = [
      lightQueBlock(cast.chinh.name, cast.chinh.lines, cast.dongPositions, formatHoQue(cast.chinh.cungTrigram.name, cast.chinh.cungLabel), TEN_TUONG_QUE[cast.chinh.name]),
      lightQueBlock(cast.hoQue.name, cast.hoQue.lines, [], formatHoQue(cast.hoQue.cungTrigram.name, cast.hoQue.cungLabel)),
    ];
    if (cast.bien) {
      blocks.push(lightQueBlock(cast.bien.name, cast.bien.lines, cast.dongPositions, formatHoQue(cast.bien.cungTrigram.name, cast.bien.cungLabel), TEN_TUONG_QUE[cast.bien.name]));
    }
    // Bảng hào theo đúng bố cục ảnh mẫu (simkinhdich.com): Chính/Biến đặt song song 2 cột, mỗi bên tách
    // 2 bảng xếp chồng (không đưa Ngũ Hành/Quan hệ Nhật-Nguyệt thành cột riêng theo yêu cầu).
    const tables = cast.bien
      ? `<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;"><div style="border-right:1px solid ${LIGHT.border};">${sideHaoTables(cast.chinh, false)}</div><div>${sideHaoTables(cast.bien, true, cast.dongPositions)}</div></div>`
      : sideHaoTables(cast.chinh, false);

    return `
      <div style="width:${CARD_WIDTH}px;min-height:${CARD_HEIGHT}px;font-family:Tahoma,'Segoe UI',Arial,sans-serif;background:${LIGHT.bg};color:${LIGHT.text};border:3px solid ${LIGHT.border};border-radius:16px;padding:20px;box-sizing:border-box;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:2px solid ${LIGHT.borderLight};padding-bottom:10px;">
          <p style="margin:0;font-size:16px;font-weight:800;letter-spacing:.02em;color:${LIGHT.red};">PHONGTHUYTHIENANH.COM</p>
          <img src="/images/brand/zhi-gong-logo.png" style="width:44px;height:44px;border-radius:9999px;border:2px solid ${LIGHT.border};object-fit:cover;flex-shrink:0;" />
        </div>
        <div style="margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:4px 24px;font-size:11px;line-height:1.7;">
          <p style="margin:0;">Phương pháp lập quẻ: <strong style="color:${LIGHT.text};">${methodLabel}</strong></p>
          <p style="margin:0;">Việc cần xem: <strong style="color:${LIGHT.text};">${viecCanXem || "—"}</strong></p>
          <p style="margin:0;">Thời gian lập quẻ: <strong style="color:${LIGHT.text};">${timeLabel}</strong></p>
          <p style="margin:0;">Theo Âm lịch: <strong style="color:${LIGHT.text};">${cast.amLichText}</strong></p>
          <p style="margin:0;grid-column:1 / -1;">Can Chi: <strong style="color:${LIGHT.text};">${cast.canChiText}</strong></p>
          <p style="margin:0;">Tiết khí: <strong style="color:${LIGHT.red};">${cast.tietKhi}</strong></p>
          <p style="margin:0;">Tuần Không: <strong style="color:${LIGHT.text};">${cast.tuanKhong}</strong></p>
          <p style="margin:0;">Nhật thần: <strong style="color:${LIGHT.text};">${cast.nhatThan}</strong></p>
          <p style="margin:0;">Nguyệt lệnh: <strong style="color:${LIGHT.text};">${cast.nguyetLenh}</strong></p>
        </div>
        <div style="margin-top:20px;display:grid;grid-template-columns:repeat(${queCols}, 1fr);gap:14px;">${blocks.join("")}</div>
        <div style="margin-top:22px;">${tables}</div>
        <p style="margin:12px 0 0;font-size:9px;color:${LIGHT.textMuted};text-align:center;">Lập quẻ Kinh Dịch tại Phong Thủy Thiên Anh — phongthuythienanh.com</p>
      </div>
    `;
  }

  async function captureCardAsPng(cardEl: HTMLElement): Promise<string> {
    const { toPng } = await import("html-to-image");
    // Không ép `height` cứng — thẻ dùng `min-height` nên chiều cao thật có thể lớn hơn CARD_HEIGHT tuỳ
    // nội dung; để html-to-image tự đo chiều cao thật (offsetHeight) của phần tử, tránh cắt mất nội dung.
    return await toPng(cardEl, { backgroundColor: LIGHT.bg, pixelRatio: 2, skipFonts: true, width: CARD_WIDTH, height: cardEl.offsetHeight });
  }

  async function renderExportCard(
    prefix: string,
    resultId: string,
    cast: FullCastResult,
    methodLabel: string,
    viecCanXem: string,
    timeLabel: string,
    fileBase: string,
  ) {
    const resultEl = document.getElementById(resultId)!;
    const cardEl = document.getElementById(`${prefix}-card`)!;
    cardEl.innerHTML = buildExportCardHtml(cast, methodLabel, viecCanXem, timeLabel);
    resultEl.classList.remove("hidden");
    try {
      const dataUrl = await captureCardAsPng(cardEl);
      const img = document.getElementById(`${prefix}-preview-img`) as HTMLImageElement;
      img.src = dataUrl;
      const saveBtn = document.getElementById(`${prefix}-save-image`) as HTMLButtonElement;
      saveBtn.onclick = () => {
        const link = document.createElement("a");
        link.download = `${fileBase}.png`;
        link.href = dataUrl;
        link.click();
      };
    } catch (err) {
      console.error("Không tạo được ảnh kết quả:", err);
      alert("Đã lập quẻ xong nhưng không tạo được ảnh, vui lòng thử lại.");
    }
    resultEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function formatTimeLabel(input: CastInput): string {
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${pad(input.day)}/${pad(input.month)}/${input.year} ${pad(input.hour)}:${pad(input.minute ?? 0)}`;
  }

  function handleLunarError(err: unknown): boolean {
    if (err instanceof Error && err.message.includes("Âm lịch")) {
      alert(err.message);
      return true;
    }
    return false;
  }

  function fileDateSlug(input: CastInput): string {
    return `${input.year}-${String(input.month).padStart(2, "0")}-${String(input.day).padStart(2, "0")}`;
  }

  // --- Mai Hoa ---
  document.getElementById("form-maihoa")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("mh-label") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("mh");
      const cast = maiHoaCast(input);
      await renderExportCard("mh", "result-maihoa", cast, "Gieo quẻ Mai Hoa Dịch Số", label, formatTimeLabel(input), `mai-hoa-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Không lập được quẻ, vui lòng kiểm tra lại thời gian nhập vào.");
    }
  });

  // --- Lục Hào (nhập tay) ---
  document.getElementById("form-luchao")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("lh-label") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("lh");
      const values: LineVal[] = [];
      const dongPositions: number[] = [];
      for (let n = 1; n <= 6; n++) {
        const v = parseInt((document.getElementById(`lh-hao-${n}-value`) as HTMLSelectElement).value, 10) as LineVal;
        values.push(v);
        if ((document.getElementById(`lh-hao-${n}-dong`) as HTMLInputElement).checked) dongPositions.push(n);
      }
      const cast = lucHaoCastManual(values, dongPositions, input);
      await renderExportCard("lh", "result-luchao", cast, "Lục Hào — nhập tay", label, formatTimeLabel(input), `luc-hao-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Không lập được quẻ, vui lòng kiểm tra lại thông tin đã nhập.");
    }
  });

  // --- Seri tiền ---
  document.getElementById("form-serial")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("sr-label") as HTMLInputElement).value.trim();
    const serial = (document.getElementById("sr-serial") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("sr");
      const cast = seriTienCast(serial, input);
      await renderExportCard("sr", "result-serial", cast, `Lập quẻ bằng Seri tiền - ${serial}`, label, formatTimeLabel(input), `seri-tien-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Vui lòng nhập số Seri hợp lệ (ít nhất 2 chữ số).");
    }
  });

  // --- Số điện thoại ---
  document.getElementById("form-phone")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("ph-label") as HTMLInputElement).value.trim();
    const phone = (document.getElementById("ph-phone") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("ph");
      const cast = soDienThoaiCast(phone, input);
      await renderExportCard("ph", "result-phone", cast, `Lập quẻ bằng Số điện thoại - ${phone}`, label, formatTimeLabel(input), `so-dien-thoai-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Vui lòng nhập số điện thoại hợp lệ (ít nhất 2 chữ số).");
    }
  });
</script>
