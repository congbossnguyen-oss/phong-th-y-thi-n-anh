---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;

const inputClass =
  "mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20";
const selectClass =
  "w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20";
const labelClass = "text-sm font-medium text-(--color-ink-800)";
const haoPositionName: Record<number, string> = { 1: "Sơ", 2: "Nhị", 3: "Tam", 4: "Tứ", 5: "Ngũ", 6: "Thượng" };
---

<BaseLayout
  title="Lập quẻ Kinh Dịch — Mai Hoa, Lục Hào, Seri tiền, 3 số tự nhiên"
  description="Lập quẻ Kinh Dịch đầy đủ theo 4 phương pháp: Mai Hoa Dịch Số, Lục Hào (gieo đồng xu), Seri tiền, 3 số tự nhiên — luận giải Nạp Giáp, Lục Thân, Lục Thú, Thế Ứng, Tuần Không."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập quẻ Kinh Dịch"
    description="Chọn 1 trong 4 phương pháp lập quẻ bên dưới. Kết quả hiển thị đầy đủ: quẻ chính, quẻ biến (nếu có hào động), Nạp Giáp Can Chi từng hào, Lục Thân, Lục Thú, Thế/Ứng và Tuần Không."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập quẻ Kinh Dịch" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-5xl">
      <div id="kd-tabs" class="mx-auto grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <button type="button" data-tab="maihoa" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="size-14 shrink-0 overflow-hidden rounded-full border border-(--color-gold-400)/30">
            <img src="/images/tools/mai-hoa.jpg" alt="Mai Hoa Dịch Số" class="size-full object-cover" />
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Mai Hoa Dịch Số</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Lập quẻ theo Năm/Tháng/Ngày/Giờ tại thời điểm hỏi việc — phương pháp cổ điển của Thiệu Khang Tiết.</span>
        </button>
        <button type="button" data-tab="luchao" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="size-14 shrink-0 overflow-hidden rounded-full border border-(--color-gold-400)/30">
            <img src="/images/tools/luc-hao.jpg" alt="Lục Hào" class="size-full object-cover" />
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Lục Hào (gieo đồng xu)</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Tự gieo 3 đồng xu 6 lần theo nghi thức truyền thống, rồi nhập lại kết quả từng hào.</span>
        </button>
        <button type="button" data-tab="serial" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="size-14 shrink-0 overflow-hidden rounded-full border border-(--color-gold-400)/30">
            <img src="/images/tools/tien.jpg" alt="Seri tiền" class="size-full object-cover" />
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Seri tiền</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Lập quẻ từ dãy số Seri trên tờ tiền — theo cách "số linh quẻ" ứng dụng Mai Hoa Dịch Số.</span>
        </button>
        <button type="button" data-tab="3so" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="size-14 shrink-0 overflow-hidden rounded-full border border-(--color-gold-400)/30">
            <img src="/images/tools/so-dien-thoai.jpg" alt="3 số tự nhiên" class="size-full object-cover" />
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">3 số tự nhiên</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Tĩnh tâm, tự chọn hoặc nhập ngẫu nhiên đúng 3 chữ số từ 0-9 để lập quẻ.</span>
        </button>
      </div>

      <!-- Mai Hoa -->
      <div id="panel-maihoa" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-maihoa" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ Mai Hoa</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="mh-label" class={labelClass}>Việc cần xem</label>
            <input id="mh-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="mh-day" class={selectClass}></select>
              <select id="mh-month" class={selectClass}></select>
              <select id="mh-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="mh-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="mh-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="mh-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>
          <p class="mt-4 text-xs text-(--color-ink-500)">
            Mai Hoa Dịch Số dùng Năm/Tháng/Ngày/Giờ Âm lịch tại thời điểm lập quẻ để tính ra quẻ Thượng, quẻ Hạ và hào động theo đúng công thức của Thiệu Khang Tiết.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-maihoa" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="mh-card"></div></div>
          <img id="mh-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="mh-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <!-- Lục Hào -->
      <div id="panel-luchao" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-luchao" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ Lục Hào</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="lh-label" class={labelClass}>Việc cần xem</label>
            <input id="lh-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="lh-day" class={selectClass}></select>
              <select id="lh-month" class={selectClass}></select>
              <select id="lh-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="lh-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="lh-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="lh-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>

          <details class="mt-4 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-100) p-3">
            <summary class="cursor-pointer text-sm font-medium text-(--color-gold-300)">Xem hướng dẫn gieo xu Lục Hào</summary>
            <div class="mt-2 space-y-2 text-xs leading-relaxed text-(--color-ink-600)">
              <p>Trước khi gieo quẻ, hãy giữ tâm bình tĩnh và tập trung suy nghĩ về <strong>một việc cần hỏi</strong>. Một việc nên tập trung hỏi một câu rõ ràng, không nên hỏi nhiều việc cùng lúc.</p>
              <p>Chuẩn bị <strong>3 đồng xu</strong>.</p>
              <p class="font-medium text-(--color-ink-700)">Quy ước:</p>
              <ul class="list-disc space-y-1 pl-5">
                <li>Mặt có nhiều chữ là <strong>Âm</strong></li>
                <li>Mặt có ít chữ là <strong>Dương</strong></li>
              </ul>
              <p class="font-medium text-(--color-ink-700)">Cách xác định hào:</p>
              <ul class="list-disc space-y-1 pl-5">
                <li>2 Dương 1 Âm = <strong>Hào Âm</strong></li>
                <li>2 Âm 1 Dương = <strong>Hào Dương</strong></li>
                <li>3 Dương = <strong>Hào Dương động</strong></li>
                <li>3 Âm = <strong>Hào Âm động</strong></li>
              </ul>
              <p>Khi gieo, <strong>nam xóc 7 lần, nữ xóc 9 lần</strong>, sau đó thả 3 đồng xu xuống đĩa và ghi nhận kết quả.</p>
              <p>Thực hiện liên tục <strong>6 lần</strong>.</p>
              <p>Điền kết quả lần lượt <strong>từ dưới lên trên</strong>, lần gieo đầu tiên là <strong>Hào 1</strong>, lần cuối cùng là <strong>Hào 6</strong>.</p>
              <p>Nếu xuất hiện <strong>Hào động</strong>, hãy tích chọn vào ô <strong>Hào động</strong> tương ứng.</p>
            </div>
          </details>

          <div class="mt-6 overflow-x-auto rounded-(--radius-control) border border-(--color-ivory-300)">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-(--color-ivory-300) bg-(--color-ivory-100) text-xs uppercase tracking-wide text-(--color-ink-600)">
                  <th class="p-2 text-left">Hào</th>
                  <th class="p-2">Âm - Dương</th>
                  <th class="p-2">Động</th>
                </tr>
              </thead>
              <tbody>
                {[6, 5, 4, 3, 2, 1].map((n) => (
                  <tr class="border-b border-(--color-ivory-300) last:border-b-0">
                    <td class="p-2 text-(--color-ink-700)">{n} - {haoPositionName[n]}</td>
                    <td class="p-2">
                      <select id={`lh-hao-${n}-value`} class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-1.5 text-center text-sm">
                        <option value="1">————</option>
                        <option value="0">— —</option>
                      </select>
                    </td>
                    <td class="p-2 text-center">
                      <input id={`lh-hao-${n}-dong`} type="checkbox" class="size-4 rounded border-(--color-ivory-300)" />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-3 text-xs text-(--color-ink-500)">
            Thành tâm nghĩ về việc muốn hỏi, tự gieo 3 đồng xu (hoặc dùng vật tương đương) 6 lần từ hào 1 đến hào 6, rồi chọn đúng Âm/Dương và đánh dấu hào động (nếu có) vào bảng trên.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-luchao" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="lh-card"></div></div>
          <img id="lh-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="lh-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <!-- Seri tiền -->
      <div id="panel-serial" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-serial" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ bằng Serial Tiền</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="sr-label" class={labelClass}>Việc cần xem</label>
            <input id="sr-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <details class="mt-4 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-100) p-3">
            <summary class="cursor-pointer text-sm font-medium text-(--color-gold-300)">Xem hướng dẫn gieo quẻ bằng Seri tiền</summary>
            <div class="mt-2 space-y-2 text-xs leading-relaxed text-(--color-ink-600)">
              <p>Hãy giữ tâm bình tĩnh và tập trung suy nghĩ về <strong>một việc cần hỏi</strong>. Một việc nên tập trung hỏi một câu rõ ràng, không nên hỏi nhiều việc cùng lúc.</p>
              <p>Sau đó, hãy <strong>rút một tờ tiền bất kỳ hiện đang có bên mình</strong>, nhập <strong>dãy số seri trên tờ tiền</strong> vào ô bên dưới và nhấn <strong>Lập Quẻ</strong>.</p>
              <p>Hệ thống sẽ tự động lập quẻ và đưa ra kết quả.</p>
            </div>
          </details>

          <div class="mt-4">
            <label for="sr-serial" class={labelClass}>Số Serial Tiền: <span class="text-(--color-cinnabar-400)">*</span></label>
            <input id="sr-serial" type="text" inputmode="numeric" placeholder="19228888" required class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="sr-day" class={selectClass}></select>
              <select id="sr-month" class={selectClass}></select>
              <select id="sr-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="sr-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="sr-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="sr-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>
          <p class="mt-4 text-xs text-(--color-ink-500)">
            Chia dãy số Seri làm 2 nửa: tổng chữ số nửa đầu (dư 8) ra quẻ Thượng, tổng chữ số nửa sau (dư 8) ra quẻ Hạ, tổng tất cả chữ số (dư 6) ra hào động — theo cách "số linh quẻ" ứng dụng Mai Hoa Dịch Số cho số bất kỳ.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-serial" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="sr-card"></div></div>
          <img id="sr-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="sr-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <!-- 3 số tự nhiên -->
      <div id="panel-3so" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-3so" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ bằng 3 số tự nhiên</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="tn-label" class={labelClass}>Việc cần xem</label>
            <input id="tn-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <label for="tn-so" class={labelClass}>3 chữ số tự nhiên (0-9): <span class="text-(--color-cinnabar-400)">*</span></label>
            <input id="tn-so" type="text" inputmode="numeric" maxlength="3" placeholder="768" required class={inputClass} />
            <p class="mt-1.5 text-xs text-(--color-ink-500)">Số thứ nhất = quẻ Thượng, số thứ hai = quẻ Hạ, số thứ ba = hào động.</p>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="tn-day" class={selectClass}></select>
              <select id="tn-month" class={selectClass}></select>
              <select id="tn-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="tn-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="tn-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="tn-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>
          <p class="mt-4 text-xs text-(--color-ink-500)">
            Tĩnh tâm nghĩ về việc đang phân vân, rồi tự chọn hoặc nhập ngẫu nhiên đúng 3 chữ số từ 0 đến 9. Số thứ nhất chia dư 8 ra quẻ Thượng, số thứ hai chia dư 8 ra quẻ Hạ, số thứ ba chia dư 6 ra hào động.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-3so" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="tn-card"></div></div>
          <img id="tn-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="tn-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
        <h2 class="font-display text-lg font-semibold text-(--color-ink-950)">Lưu ý về công cụ này</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-ink-600)">
          Công cụ lập quẻ và tính toán Nạp Giáp, Lục Thân, Lục Thú, Thế/Ứng, Tuần Không theo đúng phương pháp Nạp
          Giáp Kinh Phòng cổ điển. Kết quả mang tính tham khảo — việc luận đoán cát hung cụ thể (vượng suy Dụng
          Thần, phối hợp Nhật/Nguyệt kiến, Động biến sinh khắc...) đòi hỏi kiến thức chuyên sâu, nên tham vấn chuyên
          gia để có kết luận chính xác nhất.
        </p>
        <a href="/lien-he" class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">
          Liên hệ luận giải quẻ chuyên sâu →
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  .kd-tab-btn {
    border-color: var(--color-ivory-300);
    background: var(--color-ivory-50);
  }
  .kd-tab-btn:hover {
    border-color: var(--color-gold-400);
  }
  .kd-tab-btn.active {
    border-color: var(--color-gold-400);
    background: var(--color-ivory-100);
    box-shadow: 0 0 0 1px var(--color-gold-400);
  }
</style>

<script>
  import {
    maiHoaCast,
    lucHaoCastManual,
    queTu3SoCast,
    seriTienCast,
    type FullCastResult,
    type QueDayDu,
    type CastInput,
    type LineVal,
  } from "../lib/luc-hao";
  import { CAN, CHI } from "../lib/menh-nap-am";
  import { lunarToSolar } from "../lib/lunar-calendar";

  // --- Bộ chọn phương pháp (4 thẻ) <-> panel form ---
  const selectorEl = document.getElementById("kd-tabs")!;
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".kd-tab-btn"));
  const panels: Record<string, HTMLElement> = {
    maihoa: document.getElementById("panel-maihoa")!,
    luchao: document.getElementById("panel-luchao")!,
    serial: document.getElementById("panel-serial")!,
    "3so": document.getElementById("panel-3so")!,
  };
  function activateTab(tab: string) {
    tabButtons.forEach((btn) => btn.classList.toggle("active", btn.dataset.tab === tab));
    Object.entries(panels).forEach(([key, el]) => el.classList.toggle("hidden", key !== tab));
    selectorEl.classList.add("hidden");
    panels[tab]?.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  function showSelector() {
    selectorEl.classList.remove("hidden");
    Object.values(panels).forEach((el) => el.classList.add("hidden"));
    selectorEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  tabButtons.forEach((btn) => btn.addEventListener("click", () => activateTab(btn.dataset.tab!)));
  document.querySelectorAll<HTMLButtonElement>(".kd-back-link").forEach((btn) => btn.addEventListener("click", showSelector));

  // --- Sinh danh sách lựa chọn Ngày/Tháng/Năm/Giờ/Phút cho cả 4 form ---
  function populateSelect(el: HTMLSelectElement, options: [string | number, string][]) {
    el.innerHTML = options.map(([v, l]) => `<option value="${v}">${l}</option>`).join("");
  }
  const DAY_OPTIONS: [number, string][] = Array.from({ length: 31 }, (_, i) => [i + 1, String(i + 1).padStart(2, "0")]);
  const MONTH_OPTIONS: [number, string][] = Array.from({ length: 12 }, (_, i) => [i + 1, `Tháng ${i + 1}`]);
  const nowYear = new Date().getFullYear();
  const YEAR_OPTIONS: [number, string][] = Array.from({ length: 9 }, (_, i) => nowYear - 5 + i).map((y) => [y, String(y)]);
  const HOUR_OPTIONS: [number, string][] = Array.from({ length: 24 }, (_, i) => [i, String(i).padStart(2, "0")]);
  const MINUTE_OPTIONS: [number, string][] = Array.from({ length: 60 }, (_, i) => [i, String(i).padStart(2, "0")]);

  const PREFIXES = ["mh", "lh", "sr", "tn"];
  const now = new Date();
  PREFIXES.forEach((p) => {
    const daySel = document.getElementById(`${p}-day`) as HTMLSelectElement;
    const monthSel = document.getElementById(`${p}-month`) as HTMLSelectElement;
    const yearSel = document.getElementById(`${p}-year`) as HTMLSelectElement;
    const hourSel = document.getElementById(`${p}-hour`) as HTMLSelectElement;
    const minuteSel = document.getElementById(`${p}-minute`) as HTMLSelectElement;
    populateSelect(daySel, DAY_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(monthSel, MONTH_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(yearSel, YEAR_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(hourSel, HOUR_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(minuteSel, MINUTE_OPTIONS.map(([v, l]) => [v, l]));
    daySel.value = String(now.getDate());
    monthSel.value = String(now.getMonth() + 1);
    yearSel.value = String(now.getFullYear());
    hourSel.value = String(now.getHours());
    minuteSel.value = String(now.getMinutes());
  });

  function readCastInput(prefix: string): CastInput {
    const day = parseInt((document.getElementById(`${prefix}-day`) as HTMLSelectElement).value, 10);
    const month = parseInt((document.getElementById(`${prefix}-month`) as HTMLSelectElement).value, 10);
    const year = parseInt((document.getElementById(`${prefix}-year`) as HTMLSelectElement).value, 10);
    const hour = parseInt((document.getElementById(`${prefix}-hour`) as HTMLSelectElement).value, 10);
    const minute = parseInt((document.getElementById(`${prefix}-minute`) as HTMLSelectElement).value, 10);
    const lunarCheckbox = document.getElementById(`${prefix}-lunar`) as HTMLInputElement | null;
    if (lunarCheckbox?.checked) {
      const solar = lunarToSolar(day, month, year);
      return { day: solar.d, month: solar.m, year: solar.y, hour, minute };
    }
    return { day, month, year, hour, minute };
  }

  // --- Thẻ kết quả đỏ tía sẫm/vàng (theo đúng bảng màu chủ đạo của site) để xuất ảnh PNG ---
  const CARD_COLORS = {
    bg: "radial-gradient(ellipse at 50% 28%, #5a1a24 0%, #3d1015 55%, #2a0a0e 100%)",
    // `html-to-image` chỉ nhận màu đặc cho backgroundColor — không nhận chuỗi gradient của `bg`.
    bgSolid: "#3d1015",
    border: "#c9a256",
    borderLight: "#8f6f37",
    text: "#f7ecd9",
    textMuted: "#d8c3a3",
    red: "#d15c4a",
    gold: "#c9a256",
    dong: "#d15c4a",
    headerBg: "#dcbd7a",
    headerText: "#241812",
    // 4 khung bảng phải có nền RIÊNG, cố định. Nếu để trong suốt, chúng ăn theo gradient của thẻ nên
    // 2 bảng dưới (rơi vào vùng tối nhất của gradient) sẽ đen sẫm hơn hẳn 2 bảng trên — lệch so với mẫu.
    // CẢ 4 khung bảng đều dùng nền giấy kem + chữ nâu đen (theo ảnh mẫu), giống 3 ô quẻ ở trên.
    // Phải đặt nền cố định, không để trong suốt — nếu trong suốt chúng sẽ ăn theo gradient của thẻ.
    paperBg: "#f2e6ca",
    paperText: "#3f3524",
    paperDong: "#b3311f",
    paperBorder: "#d5c197",
    // Khung quẻ dùng nền giấy cũ sáng (tách khỏi nền thẻ tối) nên cần bộ màu chữ/vạch riêng.
    panelBg: "linear-gradient(160deg, #f7ecd4 0%, #ecdcb8 100%)",
    panelText: "#2b2116",
    panelMuted: "#6b5a3d",
    // Vạch hào dùng gradient (sáng trên → tối dưới) cho có khối, đúng như ảnh mẫu; tách riêng khỏi
    // `dong` vì `dong` còn dùng làm màu CHỮ trong bảng nên phải giữ là màu đặc.
    bar: "linear-gradient(180deg, #6f6656 0%, #474133 100%)",
    barDong: "linear-gradient(180deg, #d4452f 0%, #b32d1c 100%)",
  };
  const CARD_WIDTH = 860;
  const CARD_HEIGHT = 1030;

  // Khung tượng quẻ thu hẹp lại (130px -> 108px) để nhường chỗ cho bảng hào; từng hào vị dày hơn
  // (9px -> 12px) cho rõ ràng hơn khi xem trên điện thoại.
  function lightHexBars(lines: readonly (0 | 1)[], dongPositions: number[]): string {
    const rows = lines.map((line, i) => ({ line, pos: i + 1 })).reverse();
    const bars = rows
      .map(({ line, pos }) => {
        const isDong = dongPositions.includes(pos);
        const color = isDong ? CARD_COLORS.barDong : CARD_COLORS.bar;
        if (line === 1) return `<div style="height:12px;border-radius:2px;background:${color};"></div>`;
        return `<div style="height:12px;display:flex;justify-content:space-between;"><div style="width:42%;height:100%;border-radius:2px;background:${color};"></div><div style="width:42%;height:100%;border-radius:2px;background:${color};"></div></div>`;
      })
      .join("");
    return `<div style="display:flex;flex-direction:column;gap:7px;width:108px;margin:0 auto;">${bars}</div>`;
  }

  // Tên tượng quẻ (điềm triệu) theo tên 64 quẻ — do người dùng cung cấp trực tiếp (đã sửa 3 chỗ lệch
  // dòng so với bảng gốc: Trạch Hỏa Cách, Địa Lôi Phục, Thiên Sơn Độn). Chỉ hiện cho Quẻ Chính/Quẻ Biến.
  const TEN_TUONG_QUE: Record<string, string> = {
    "Thuần Càn": "Khốn Long Đắc Thủy",
    "Thuần Khôn": "Ngạ Hổ Đắc Thực",
    "Thủy Lôi Truân": "Loạn Ti Vô Đầu",
    "Sơn Thủy Mông": "Tiểu Quỷ Thâu Tiền",
    "Thủy Thiên Nhu": "Minh Châu Xuất Thổ",
    "Thiên Thủy Tụng": "Nhị Nhân Tranh Lộ",
    "Địa Thủy Sư": "Mã Đáo Thành Công",
    "Thủy Địa Tỷ": "Thuận Phong Hành Thuyền",
    "Phong Thiên Tiểu Súc": "Mật Vân Bất Vũ",
    "Thiên Trạch Lý": "Phượng Minh Kỳ Sơn",
    "Địa Thiên Thái": "Hỷ Báo Tam Nguyên",
    "Thiên Địa Bĩ": "Hổ Lạc Hãm Khanh",
    "Thiên Hỏa Đồng Nhân": "Tiên Nhân Chỉ Lộ",
    "Hỏa Thiên Đại Hữu": "Nhuyễn Mộc Nô Tước",
    "Địa Sơn Khiêm": "Nhị Nhân Phân Kim",
    "Lôi Địa Dự": "Thanh Long Đắc Vị",
    "Trạch Lôi Tùy": "Bộ Bộ Đăng Cao",
    "Sơn Phong Cổ": "Thôi Ma Phần Đạo",
    "Địa Trạch Lâm": "Hạn Đắc Cam Lâm",
    "Phong Địa Quán": "Hạn Bồng Phùng Hà",
    "Hỏa Lôi Phệ Hạp": "Cô Nhân Ngộ Thực",
    "Sơn Hỏa Bí": "Hỷ Khí Doanh Môn",
    "Sơn Địa Bác": "Ưng Thước Đồng Lâm",
    "Địa Lôi Phục": "Phu Thê Phản Mục",
    "Thiên Lôi Vô Vọng": "Điểu Bị Lao Lung",
    "Sơn Thiên Đại Súc": "Trận Thế Đắc Khai",
    "Sơn Lôi Di": "Vị Thủy Điếu Ngư",
    "Trạch Phong Đại Quá": "Dạ Mộng Kim Ngân",
    "Thuần Khảm": "Thủy Để Lao Nguyệt",
    "Thuần Ly": "Thiên Quan Tứ Phúc",
    "Trạch Sơn Hàm": "Manh Nha Xuất Thổ",
    "Lôi Phong Hằng": "Ngư Lai Tràng Võng",
    "Thiên Sơn Độn": "Nùng Vân Tế Nhật",
    "Lôi Thiên Đại Tráng": "Công Sư Đắc Mộc",
    "Hỏa Địa Tấn": "Sừ Địa Đắc Kim",
    "Địa Hỏa Minh Di": "Phi Điểu Thương Cánh",
    "Phong Hỏa Gia Nhân": "Cảnh Lý Quan Hoa",
    "Hỏa Trạch Khuê": "Phản Mại Trư Dương",
    "Thủy Sơn Kiển": "Vũ Tuyết Tải Đồ",
    "Lôi Thủy Giải": "Ngũ Quan Thoát Nạn",
    "Sơn Trạch Tổn": "Thôi Xa Phí Lực",
    "Phong Lôi Ích": "Khô Mộc Khai Hoa",
    "Trạch Thiên Quải": "Du Phong Thoát Võng",
    "Thiên Phong Cấu": "Tha Hương Ngộ Hữu",
    "Trạch Địa Tụy": "Ngư Lý Hóa Long",
    "Địa Phong Thăng": "Chỉ Nhật Cao Thăng",
    "Trạch Thủy Khốn": "Thoát Lãng Trừu Đê",
    "Thủy Phong Tỉnh": "Khô Tỉnh Sanh Tuyền",
    "Trạch Hỏa Cách": "Hạn Miêu Đắc Vũ",
    "Hỏa Phong Đỉnh": "Ngư Ông Đắc Lợi",
    "Thuần Chấn": "Kim Chung Dạ Tràng",
    "Thuần Cấn": "Nhân Đoản Táo Cao",
    "Phong Sơn Tiệm": "Tuấn Mã Xuất Lung",
    "Lôi Trạch Quy Muội": "Duyên Mộc Cầu Ngư",
    "Lôi Hỏa Phong": "Cổ Kính Trùng Minh",
    "Hỏa Sơn Lữ": "Túc Điểu Phần Sào",
    "Thuần Tốn": "Châu Đắc Thuận Phong",
    "Thuần Đoài": "Lưỡng Hỷ Lâm Môn",
    "Phong Thủy Hoán": "Cách Hà Vọng Kim",
    "Thủy Trạch Tiết": "Trảm Tướng Phong Thần",
    "Phong Trạch Trung Phu": "Hành Tẩu Bạc Băng",
    "Lôi Sơn Tiểu Quá": "Cấp Quá Độc Kiều",
    "Thủy Hỏa Ký Tế": "Kim Bảng Đề Danh",
    "Hỏa Thủy Vị Tế": "Tiểu Nhân Hãm Hại",
  };

  // Nhãn đời quái chỉ giữ lại khi thuộc nhóm "đáng chú ý" (Lục Hợp/Lục Xung/Du Hồn/Quy Hồn) — bỏ các
  // nhãn thông thường (Bát Thuần/Nhất Thế..Ngũ Thế) theo đúng yêu cầu, chỉ xử lý chuỗi hiển thị
  // `cungLabel` đã có sẵn từ engine, không tính lại giá trị.
  const NOTABLE_CUNG_TAGS = new Set(["Lục Hợp", "Lục Xung", "Du Hồn", "Quy Hồn"]);
  function formatHoQue(cungName: string, cungLabel: string): string {
    const m = cungLabel.match(/\(([^)]+)\)/);
    const tag = m ? m[1] : null;
    return tag && NOTABLE_CUNG_TAGS.has(tag) ? `Họ ${cungName} (${tag})` : `Họ ${cungName}`;
  }

  // Chữ Họ quẻ và tên tượng quẻ LUÔN giữ màu cố định (ghi/đen), không đổi theo hào động — chỉ vạch hào
  // (`dongPositions`, dùng riêng cho `lightHexBars`) mới đổi màu đỏ khi động. In hoa chỉ áp dụng cho
  // TÊN QUẺ, và chỉ khi quẻ đó có hào động (Chính có hào động / Biến luôn có vì chỉ tồn tại khi động) —
  // Hỗ không bao giờ in hoa. Họ quẻ và tên tượng không còn in hoa (giữ nguyên dạng chữ thường).
  // Tên quẻ dài (3-4 chữ, vd "Phong Trạch Trung Phu") ở cỡ chữ mặc định 18px dễ tràn dòng trong khung
  // hẹp (bố cục 3 cột khi có quẻ Biến) — giảm cỡ chữ dần theo số chữ để cố gắng giữ 1 dòng cho đẹp,
  // thay vì để trình duyệt tự xuống dòng lệch (vd 3 chữ trên/1 chữ dưới).
  function queNameFontSize(name: string): number {
    const wordCount = name.trim().split(/\s+/).length;
    if (wordCount >= 4) return 14;
    if (wordCount === 3) return 16;
    return 18;
  }

  function lightQueBlock(name: string, lines: readonly (0 | 1)[], dongPositions: number[], cungText: string, tenTuong?: string): string {
    const subColor = CARD_COLORS.panelMuted;
    const tenTuongColor = CARD_COLORS.panelText;
    const nameTransform = dongPositions.length > 0 ? "uppercase" : "none";
    return `
      <div style="border:2px solid ${CARD_COLORS.border};border-radius:12px;padding:14px 10px;text-align:center;background:${CARD_COLORS.panelBg};">
        <p style="margin:0;min-height:26px;display:flex;align-items:center;justify-content:center;font-size:${queNameFontSize(name)}px;font-weight:800;line-height:1.2;letter-spacing:.02em;text-transform:${nameTransform};color:${CARD_COLORS.red};white-space:nowrap;">${name}</p>
        <div style="margin-top:10px;">${lightHexBars(lines, dongPositions)}</div>
        <p style="margin:10px 0 0;font-size:12px;font-weight:700;letter-spacing:.02em;color:${subColor};">${cungText}</p>
        ${tenTuong ? `<p style="margin:4px 0 0;font-size:14px;font-weight:700;letter-spacing:.02em;color:${tenTuongColor};white-space:nowrap;">${tenTuong}</p>` : ""}
      </div>
    `;
  }

  // Rút gọn Lục Thân cho ô Phục Thần: "Huynh Đệ" -> "Huynh", v.v.
  const LUC_THAN_ABBREV: Record<string, string> = {
    "Huynh Đệ": "Huynh",
    "Tử Tôn": "Tử",
    "Thê Tài": "Thê",
    "Quan Quỷ": "Quan",
    "Phụ Mẫu": "Phụ",
  };

  // Bảng hào cho 1 bên (Chính hoặc Biến), đúng bố cục ảnh mẫu simkinhdich.com: tách 2 bảng xếp chồng —
  // bảng trên (Nạp Giáp/Lục Thân/Tuần Không...) + bảng dưới (Vượng Suy/Trường Sinh). Chỉ đọc field có
  // sẵn từ engine (`h.xunKong`, `h.growthDay`, `h.growthMonth`, `h.canIndex`...), không tự tính lại gì.
  // Cột "Can Chi" hiện Thiên Can + Địa Chi (Nạp Giáp đầy đủ), không hiện riêng Ngũ Hành.
  // `Q.Thần` chưa có nguồn xác nhận công thức nên luôn hiện "-" (theo đúng chỉ thị, không tự suy đoán).
  // T/Ư chỉ hiện ở bên Chính (Thế/Ứng an tại quẻ chính); Lục Thú chỉ hiện ở bên Biến; P.Thần chỉ hiện
  // ở bên Chính — theo đúng yêu cầu rút gọn cột.
  // `dongPositions`: engine không đánh dấu `isDong` cho hào bên Biến (biến không tự mang trạng thái
  // động), nên bên Biến cần vị trí hào động của Chính truyền vào để tô đỏ đúng hào đã "hóa ra".
  function sideHaoTables(q: QueDayDu, isBien: boolean, dongPositions: number[] = []): string {
    const rows = [...q.hao].reverse();

    const headerLabels = [
      "Hào",
      ...(isBien ? [] : ["T/Ư"]),
      "Lục Thân",
      "Can Chi",
      ...(isBien ? [] : ["P.Thần"]),
      "T.K",
      ...(isBien ? ["Lục Thú"] : []),
    ];
    const upperHeader = headerLabels.map((label) => `<th style="padding:7px 4px;white-space:nowrap;color:${CARD_COLORS.headerText};">${label}</th>`).join("");

    // P.Thần (Phục Thần) KHÔNG được tô đỏ dù hào đó có động hay không — Phục Thần là hào ẩn mượn từ
    // quẻ thuần bản cung, không phải hào thật đang động trong quẻ hiện tại, nên giữ nguyên màu chữ.
    const upperRows = rows
      .map((h) => {
        const isRowDong = h.isDong || dongPositions.includes(h.hao);
        const rowColor = isRowDong ? CARD_COLORS.paperDong : CARD_COLORS.paperText;
        const cells = [
          `<td style="padding:7px 5px;text-align:center;font-weight:700;color:${rowColor};">${h.value === 1 ? "&mdash;" : "&#8212;&nbsp;&#8212;"}</td>`,
          ...(isBien ? [] : [`<td style="padding:7px 5px;text-align:center;color:${rowColor};font-weight:600;">${h.theUng ?? ""}</td>`]),
          `<td style="padding:7px 5px;text-align:center;color:${rowColor};font-weight:${isRowDong ? "700" : "400"};white-space:nowrap;">${h.lucThan}</td>`,
          `<td style="padding:7px 5px;text-align:center;color:${rowColor};font-weight:${isRowDong ? "700" : "400"};white-space:nowrap;">${CHI[h.chiIndex]}-${h.nguHanh}</td>`,
          ...(isBien ? [] : [`<td style="padding:7px 5px;text-align:center;color:${CARD_COLORS.paperText};white-space:nowrap;">${h.phucThan ? `${LUC_THAN_ABBREV[h.phucThan.lucThan]}-${CHI[h.phucThan.chiIndex]}` : "-"}</td>`]),
          `<td style="padding:7px 5px;text-align:center;color:${rowColor};">${h.xunKong ? "K" : "-"}</td>`,
          ...(isBien ? [`<td style="padding:7px 5px;text-align:center;color:${rowColor};font-weight:${isRowDong ? "700" : "400"};white-space:nowrap;">${h.lucThu}</td>`] : []),
        ];
        return `<tr style="border-bottom:1px solid ${CARD_COLORS.paperBorder};">${cells.join("")}</tr>`;
      })
      .join("");

    const lowerRows = rows
      .map((h) => {
        const isRowDong = h.isDong || dongPositions.includes(h.hao);
        const rowColor = isRowDong ? CARD_COLORS.paperDong : CARD_COLORS.paperText;
        return `
          <tr style="border-bottom:1px solid ${CARD_COLORS.paperBorder};">
            <td style="padding:7px 2px;text-align:center;font-weight:${isRowDong ? "700" : "400"};color:${rowColor};white-space:nowrap;">${CAN[h.canIndex]} ${CHI[h.chiIndex]}</td>
            <td style="padding:7px 2px;text-align:center;color:${rowColor};white-space:nowrap;">${h.vuongSuy}</td>
            <td style="padding:7px 2px;text-align:center;color:${rowColor};white-space:nowrap;">-</td>
            <td style="padding:7px 2px;text-align:center;color:${rowColor};white-space:nowrap;">${h.growthDay}</td>
            <td style="padding:7px 2px;text-align:center;color:${rowColor};white-space:nowrap;">${h.growthMonth}</td>
          </tr>
        `;
      })
      .join("");

    return `
      <div>
        <div style="border:2px solid ${CARD_COLORS.border};border-radius:10px;overflow:hidden;background:${CARD_COLORS.paperBg};">
          <table style="width:100%;border-collapse:collapse;font-size:18px;">
            <thead>
              <tr style="background:${CARD_COLORS.headerBg};">${upperHeader}</tr>
            </thead>
            <tbody>${upperRows}</tbody>
          </table>
        </div>
        <div style="border:2px solid ${CARD_COLORS.border};border-radius:10px;overflow:hidden;background:${CARD_COLORS.paperBg};margin-top:10px;">
          <table style="width:100%;table-layout:fixed;border-collapse:collapse;font-size:14px;">
            <thead>
              <tr style="background:${CARD_COLORS.headerBg};color:${CARD_COLORS.headerText};">
                <th style="padding:7px 2px;width:20%;white-space:nowrap;">Hào</th><th style="padding:7px 2px;width:20%;white-space:nowrap;">V-S</th><th style="padding:7px 2px;width:20%;white-space:nowrap;">Q.Thần</th><th style="padding:7px 2px;width:20%;white-space:nowrap;">TS Ngày</th><th style="padding:7px 2px;width:20%;white-space:nowrap;">TS Tháng</th>
              </tr>
            </thead>
            <tbody>${lowerRows}</tbody>
          </table>
        </div>
      </div>
    `;
  }

  // Hoa văn mây (tường vân) vẽ bằng SVG thuần — hoạ tiết nền chìm, không phụ thuộc file ảnh ngoài nên
  // `html-to-image` luôn chụp được (ảnh ngoài từng gây lỗi thiếu hình khi mạng chậm).
  // Mỗi cụm gồm 3 vòng xoắn lồng nhau (đầu mây) + dải đuôi vắt ngang, đúng dáng mây cổ truyền.
  function cloudMotif(): string {
    return `<svg viewBox="0 0 200 100" fill="none" stroke="${CARD_COLORS.gold}" stroke-width="4" stroke-linecap="round" style="display:block;width:100%;height:auto;">
      <path d="M46 78a26 26 0 1 1 26-28"/>
      <path d="M60 78a15 15 0 1 1 15-16"/>
      <path d="M74 78a5 5 0 1 1 5-6"/>
      <path d="M46 78h96c16 0 24-12 19-24"/>
      <path d="M142 54a13 13 0 1 1 13-14"/>
    </svg>`;
  }

  // Rải mây quanh rìa thẻ, độ mờ rất thấp để không lấn chữ. Dùng scaleX(-1) để lật hướng cho tự nhiên.
  const CLOUD_LAYER = [
    "left:-56px;top:96px;width:290px;transform:rotate(-8deg);opacity:.20;",
    "right:-70px;top:430px;width:330px;transform:scaleX(-1) rotate(-6deg);opacity:.17;",
    "left:-40px;bottom:150px;width:300px;transform:rotate(5deg);opacity:.17;",
    "right:-50px;bottom:-10px;width:280px;transform:scaleX(-1) rotate(4deg);opacity:.15;",
    "left:250px;top:-34px;width:250px;transform:rotate(-3deg);opacity:.11;",
  ]
    .map((pos) => `<div style="position:absolute;${pos}pointer-events:none;">${cloudMotif()}</div>`)
    .join("");

  function buildExportCardHtml(cast: FullCastResult, methodLabel: string, viecCanXem: string, timeLabel: string): string {
    const queCols = cast.bien ? 3 : 2;
    const blocks = [
      lightQueBlock(cast.chinh.name, cast.chinh.lines, cast.dongPositions, formatHoQue(cast.chinh.cungTrigram.name, cast.chinh.cungLabel), TEN_TUONG_QUE[cast.chinh.name]),
      lightQueBlock(cast.hoQue.name, cast.hoQue.lines, [], formatHoQue(cast.hoQue.cungTrigram.name, cast.hoQue.cungLabel)),
    ];
    if (cast.bien) {
      blocks.push(lightQueBlock(cast.bien.name, cast.bien.lines, cast.dongPositions, formatHoQue(cast.bien.cungTrigram.name, cast.bien.cungLabel), TEN_TUONG_QUE[cast.bien.name]));
    }
    // Bảng hào theo đúng bố cục ảnh mẫu (simkinhdich.com): Chính/Biến đặt song song 2 cột, mỗi bên tách
    // 2 bảng xếp chồng (không đưa Ngũ Hành/Quan hệ Nhật-Nguyệt thành cột riêng theo yêu cầu).
    const tables = cast.bien
      ? `<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;"><div>${sideHaoTables(cast.chinh, false)}</div><div>${sideHaoTables(cast.bien, true, cast.dongPositions)}</div></div>`
      : sideHaoTables(cast.chinh, false);

    return `
      <div style="position:relative;width:${CARD_WIDTH}px;min-height:${CARD_HEIGHT}px;font-family:Tahoma,'Segoe UI',Arial,sans-serif;background:${CARD_COLORS.bg};color:${CARD_COLORS.text};border:3px solid ${CARD_COLORS.border};border-radius:16px;padding:20px;box-sizing:border-box;overflow:hidden;">
        ${CLOUD_LAYER}
        <img src="/images/brand/chim-hac-vector.png" style="position:absolute;right:2px;top:14px;width:220px;opacity:.72;filter:saturate(.6) brightness(1.18);pointer-events:none;" />
        <div style="position:relative;display:flex;align-items:center;gap:10px;border-bottom:2px solid ${CARD_COLORS.borderLight};padding-bottom:10px;">
          <img src="/images/brand/thien-anh-logo-badge.png" style="width:44px;height:44px;border-radius:9999px;border:2px solid ${CARD_COLORS.border};object-fit:cover;flex-shrink:0;" />
          <p style="margin:0;font-size:16px;font-weight:800;letter-spacing:.02em;color:${CARD_COLORS.gold};">PHONGTHUYTHIENANH.COM</p>
        </div>
        <div style="position:relative;margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:4px 24px;font-size:11px;line-height:1.7;color:${CARD_COLORS.textMuted};">
          <p style="margin:0;">Phương pháp lập quẻ: <strong style="color:${CARD_COLORS.text};">${methodLabel}</strong></p>
          <p style="margin:0;">Việc cần xem: <strong style="color:${CARD_COLORS.text};">${viecCanXem || "—"}</strong></p>
          <p style="margin:0;">Thời gian lập quẻ: <strong style="color:${CARD_COLORS.text};">${timeLabel}</strong></p>
          <p id="am-lich-row" style="margin:0;">Theo Âm lịch: <strong style="color:${CARD_COLORS.text};">${cast.amLichText}</strong></p>
          <p style="margin:0;grid-column:1 / -1;">Can Chi: <strong style="color:${CARD_COLORS.text};">${cast.canChiText}</strong></p>
          <p style="margin:0;font-size:13px;">Tiết khí: <strong style="color:${CARD_COLORS.text};">${cast.tietKhi}</strong></p>
          <p style="margin:0;font-size:15px;">Tuần Không: <strong style="color:${CARD_COLORS.text};">${cast.tuanKhong}</strong></p>
          ${cast.fanYin.enabled ? `<p style="margin:0;grid-column:1 / -1;font-size:16px;">Phản Ngâm: <strong style="color:${CARD_COLORS.red};">${cast.fanYin.label}</strong></p>` : ""}
          ${cast.fuYin.enabled ? `<p style="margin:0;grid-column:1 / -1;font-size:16px;">Phục Ngâm: <strong style="color:${CARD_COLORS.red};">${cast.fuYin.label}</strong></p>` : ""}
        </div>
        <div style="position:relative;margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div style="background:rgba(220,189,122,0.14);border:1px solid rgba(201,162,86,0.45);border-radius:10px;padding:6px 12px;text-align:center;">
            <p style="margin:0;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:${CARD_COLORS.gold};opacity:.85;">Nhật Thần</p>
            <p style="margin:1px 0 0;font-size:19px;font-weight:800;line-height:1.15;color:${CARD_COLORS.text};">${cast.nhatThan}</p>
          </div>
          <div style="background:rgba(220,189,122,0.14);border:1px solid rgba(201,162,86,0.45);border-radius:10px;padding:6px 12px;text-align:center;">
            <p style="margin:0;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:${CARD_COLORS.gold};opacity:.85;">Nguyệt Lệnh</p>
            <p style="margin:1px 0 0;font-size:19px;font-weight:800;line-height:1.15;color:${CARD_COLORS.text};">${cast.nguyetLenh}</p>
          </div>
        </div>
        <div style="position:relative;margin-top:14px;display:grid;grid-template-columns:repeat(${queCols}, 1fr);gap:14px;">${blocks.join("")}</div>
        <div style="position:relative;margin-top:22px;">${tables}</div>
        <p style="position:relative;margin:12px 0 0;font-size:9px;color:${CARD_COLORS.textMuted};text-align:center;">Lập quẻ Kinh Dịch tại Phong Thủy Thiên Anh — phongthuythienanh.com</p>
      </div>
    `;
  }

  // Đợi toàn bộ <img> bên trong card tải + decode xong trước khi chụp — nếu không, trên mạng thật
  // (đặc biệt mobile) ảnh nặng như chim hạc (~950KB) có thể chưa tải kịp lúc `toPng()` chụp, khiến
  // ảnh xuất ra bị thiếu dù DOM vẫn hiển thị đúng khi xem trực tiếp (chỉ lộ ra khi mạng chậm hơn
  // localhost, nên không phát hiện được lúc test local).
  async function waitForImagesToLoad(cardEl: HTMLElement): Promise<void> {
    const imgs = Array.from(cardEl.querySelectorAll("img"));
    await Promise.all(
      imgs.map((img) => {
        if (img.complete && img.naturalWidth > 0) {
          return img.decode().catch(() => undefined);
        }
        return new Promise<void>((resolve) => {
          img.addEventListener("load", () => img.decode().then(() => resolve()).catch(() => resolve()), { once: true });
          img.addEventListener("error", () => resolve(), { once: true });
        });
      }),
    );
  }

  async function captureCardAsPng(cardEl: HTMLElement): Promise<string> {
    const { toPng } = await import("html-to-image");
    await waitForImagesToLoad(cardEl);
    // Không ép `height` cứng — thẻ dùng `min-height` nên chiều cao thật có thể lớn hơn CARD_HEIGHT tuỳ
    // nội dung; để html-to-image tự đo chiều cao thật (offsetHeight) của phần tử, tránh cắt mất nội dung.
    return await toPng(cardEl, { backgroundColor: CARD_COLORS.bgSolid, pixelRatio: 2, skipFonts: true, width: CARD_WIDTH, height: cardEl.offsetHeight });
  }

  async function renderExportCard(
    prefix: string,
    resultId: string,
    cast: FullCastResult,
    methodLabel: string,
    viecCanXem: string,
    timeLabel: string,
    fileBase: string,
  ) {
    const resultEl = document.getElementById(resultId)!;
    const cardEl = document.getElementById(`${prefix}-card`)!;
    cardEl.innerHTML = buildExportCardHtml(cast, methodLabel, viecCanXem, timeLabel);
    resultEl.classList.remove("hidden");
    try {
      const dataUrl = await captureCardAsPng(cardEl);
      const img = document.getElementById(`${prefix}-preview-img`) as HTMLImageElement;
      img.src = dataUrl;
      const saveBtn = document.getElementById(`${prefix}-save-image`) as HTMLButtonElement;
      saveBtn.onclick = () => {
        const link = document.createElement("a");
        link.download = `${fileBase}.png`;
        link.href = dataUrl;
        link.click();
      };
    } catch (err) {
      console.error("Không tạo được ảnh kết quả:", err);
      alert("Đã lập quẻ xong nhưng không tạo được ảnh, vui lòng thử lại.");
    }
    resultEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function formatTimeLabel(input: CastInput): string {
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${pad(input.day)}/${pad(input.month)}/${input.year} ${pad(input.hour)}:${pad(input.minute ?? 0)}`;
  }

  function handleLunarError(err: unknown): boolean {
    if (err instanceof Error && err.message.includes("Âm lịch")) {
      alert(err.message);
      return true;
    }
    return false;
  }

  function fileDateSlug(input: CastInput): string {
    return `${input.year}-${String(input.month).padStart(2, "0")}-${String(input.day).padStart(2, "0")}`;
  }

  // Vô hiệu hoá + đổi chữ nút submit trong lúc chờ (đặc biệt `captureCardAsPng` — dựng ảnh PNG
  // pixelRatio 2 có thể mất vài giây, trước đây không có phản hồi gì nên trông như bị treo/không
  // lên kết quả dù thực ra vẫn đang chạy).
  function setFormBusy(form: HTMLFormElement, busy: boolean) {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (!btn) return;
    if (busy) {
      btn.dataset.originalText = btn.textContent ?? "";
      btn.disabled = true;
      btn.textContent = "Đang lập quẻ...";
    } else {
      btn.disabled = false;
      if (btn.dataset.originalText) btn.textContent = btn.dataset.originalText;
    }
  }

  // --- Mai Hoa ---
  document.getElementById("form-maihoa")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const label = (document.getElementById("mh-label") as HTMLInputElement).value.trim();
    setFormBusy(form, true);
    try {
      const input = readCastInput("mh");
      const cast = maiHoaCast(input);
      await renderExportCard("mh", "result-maihoa", cast, "Gieo quẻ Mai Hoa Dịch Số", label, formatTimeLabel(input), `mai-hoa-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Không lập được quẻ, vui lòng kiểm tra lại thời gian nhập vào.");
    } finally {
      setFormBusy(form, false);
    }
  });

  // --- Lục Hào (nhập tay) ---
  document.getElementById("form-luchao")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const label = (document.getElementById("lh-label") as HTMLInputElement).value.trim();
    setFormBusy(form, true);
    try {
      const input = readCastInput("lh");
      const values: LineVal[] = [];
      const dongPositions: number[] = [];
      for (let n = 1; n <= 6; n++) {
        const v = parseInt((document.getElementById(`lh-hao-${n}-value`) as HTMLSelectElement).value, 10) as LineVal;
        values.push(v);
        if ((document.getElementById(`lh-hao-${n}-dong`) as HTMLInputElement).checked) dongPositions.push(n);
      }
      const cast = lucHaoCastManual(values, dongPositions, input);
      await renderExportCard("lh", "result-luchao", cast, "Lục Hào — nhập tay", label, formatTimeLabel(input), `luc-hao-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Không lập được quẻ, vui lòng kiểm tra lại thông tin đã nhập.");
    } finally {
      setFormBusy(form, false);
    }
  });

  // --- Seri tiền ---
  document.getElementById("form-serial")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const label = (document.getElementById("sr-label") as HTMLInputElement).value.trim();
    const serial = (document.getElementById("sr-serial") as HTMLInputElement).value.trim();
    setFormBusy(form, true);
    try {
      const input = readCastInput("sr");
      const cast = seriTienCast(serial, input);
      await renderExportCard("sr", "result-serial", cast, `Lập quẻ bằng Seri tiền - ${serial}`, label, formatTimeLabel(input), `seri-tien-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Vui lòng nhập số Seri hợp lệ (ít nhất 2 chữ số).");
    } finally {
      setFormBusy(form, false);
    }
  });

  // --- 3 số tự nhiên ---
  document.getElementById("form-3so")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const label = (document.getElementById("tn-label") as HTMLInputElement).value.trim();
    const soTuNhien = (document.getElementById("tn-so") as HTMLInputElement).value.trim();
    setFormBusy(form, true);
    try {
      const input = readCastInput("tn");
      const cast = queTu3SoCast(soTuNhien, input);
      await renderExportCard("tn", "result-3so", cast, `Lập quẻ bằng 3 số tự nhiên - ${soTuNhien}`, label, formatTimeLabel(input), `3-so-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Vui lòng nhập đúng 3 chữ số từ 0 đến 9.");
    } finally {
      setFormBusy(form, false);
    }
  });
</script>
