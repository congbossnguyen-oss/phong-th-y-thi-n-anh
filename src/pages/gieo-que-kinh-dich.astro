---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;

const inputClass =
  "mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20";
const selectClass =
  "w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20";
const labelClass = "text-sm font-medium text-(--color-ink-800)";
const haoPositionName: Record<number, string> = { 1: "Sơ", 2: "Nhị", 3: "Tam", 4: "Tứ", 5: "Ngũ", 6: "Thượng" };
---

<BaseLayout
  title="Lập quẻ Kinh Dịch — Mai Hoa, Lục Hào, Seri tiền, Số điện thoại"
  description="Lập quẻ Kinh Dịch đầy đủ theo 4 phương pháp: Mai Hoa Dịch Số, Lục Hào (gieo đồng xu), Seri tiền, Số điện thoại — luận giải Nạp Giáp, Lục Thân, Lục Thú, Thế Ứng, Tuần Không."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập quẻ Kinh Dịch"
    description="Chọn 1 trong 4 phương pháp lập quẻ bên dưới. Kết quả hiển thị đầy đủ: quẻ chính, quẻ biến (nếu có hào động), Nạp Giáp Can Chi từng hào, Lục Thân, Lục Thú, Thế/Ứng và Tuần Không."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập quẻ Kinh Dịch" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-5xl">
      <div id="kd-tabs" class="mx-auto grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <button type="button" data-tab="maihoa" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-(--color-gold-400)/30 bg-(--color-gold-400)/10">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-7 text-(--color-gold-400)">
              <circle cx="12" cy="12" r="2.1" /><circle cx="12" cy="5.4" r="2.6" /><circle cx="17.9" cy="8.8" r="2.6" />
              <circle cx="15.9" cy="16.1" r="2.6" /><circle cx="8.1" cy="16.1" r="2.6" /><circle cx="6.1" cy="8.8" r="2.6" />
            </svg>
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Mai Hoa Dịch Số</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Lập quẻ theo Năm/Tháng/Ngày/Giờ tại thời điểm hỏi việc — phương pháp cổ điển của Thiệu Khang Tiết.</span>
        </button>
        <button type="button" data-tab="luchao" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-(--color-gold-400)/30 bg-(--color-gold-400)/10">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-7 text-(--color-gold-400)">
              <ellipse cx="12" cy="6.5" rx="7" ry="3" />
              <path d="M5 6.5v5c0 1.66 3.13 3 7 3s7-1.34 7-3v-5" />
              <path d="M5 11.5v5c0 1.66 3.13 3 7 3s7-1.34 7-3v-5" />
            </svg>
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Lục Hào (gieo đồng xu)</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Tự gieo 3 đồng xu 6 lần theo nghi thức truyền thống, rồi nhập lại kết quả từng hào.</span>
        </button>
        <button type="button" data-tab="serial" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-(--color-gold-400)/30 bg-(--color-gold-400)/10">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-7 text-(--color-gold-400)">
              <rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" />
              <path d="M6.5 9h.01M17.5 15h.01" stroke-linecap="round" />
            </svg>
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Seri tiền</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Lập quẻ từ dãy số Seri trên tờ tiền — theo cách "số linh quẻ" ứng dụng Mai Hoa Dịch Số.</span>
        </button>
        <button type="button" data-tab="phone" class="kd-tab-btn flex h-full flex-col items-center rounded-(--radius-card) border p-6 text-center transition">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-(--color-gold-400)/30 bg-(--color-gold-400)/10">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-7 text-(--color-gold-400)">
              <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="mt-4 flex min-h-[2.75rem] items-center justify-center font-display text-base font-semibold text-(--color-ink-950)">Số điện thoại</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">Lập quẻ từ dãy số điện thoại đang dùng, cùng cách "số linh quẻ" như Seri tiền.</span>
        </button>
      </div>

      <!-- Mai Hoa -->
      <div id="panel-maihoa" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-maihoa" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ Mai Hoa</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="mh-label" class={labelClass}>Việc cần xem</label>
            <input id="mh-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="mh-day" class={selectClass}></select>
              <select id="mh-month" class={selectClass}></select>
              <select id="mh-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="mh-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="mh-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="mh-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>
          <p class="mt-4 text-xs text-(--color-ink-500)">
            Mai Hoa Dịch Số dùng Năm/Tháng/Ngày/Giờ Âm lịch tại thời điểm lập quẻ để tính ra quẻ Thượng, quẻ Hạ và hào động theo đúng công thức của Thiệu Khang Tiết.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-maihoa" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="mh-card"></div></div>
          <img id="mh-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="mh-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <!-- Lục Hào -->
      <div id="panel-luchao" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-luchao" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ Lục Hào</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="lh-label" class={labelClass}>Việc cần xem</label>
            <input id="lh-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="lh-day" class={selectClass}></select>
              <select id="lh-month" class={selectClass}></select>
              <select id="lh-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="lh-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="lh-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="lh-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>

          <div class="mt-6 overflow-x-auto rounded-(--radius-control) border border-(--color-ivory-300)">
            <table class="w-full min-w-[420px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-(--color-ivory-300) bg-(--color-ivory-100) text-xs uppercase tracking-wide text-(--color-ink-600)">
                  <th class="p-2 text-left">Hào</th>
                  <th class="p-2">Âm - Dương</th>
                  <th class="p-2">Động</th>
                </tr>
              </thead>
              <tbody>
                {[6, 5, 4, 3, 2, 1].map((n) => (
                  <tr class="border-b border-(--color-ivory-300) last:border-b-0">
                    <td class="p-2 text-(--color-ink-700)">{n} - {haoPositionName[n]}</td>
                    <td class="p-2">
                      <select id={`lh-hao-${n}-value`} class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-1.5 text-center text-sm">
                        <option value="1">——————</option>
                        <option value="0">—— ——</option>
                      </select>
                    </td>
                    <td class="p-2 text-center">
                      <input id={`lh-hao-${n}-dong`} type="checkbox" class="size-4 rounded border-(--color-ivory-300)" />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-3 text-xs text-(--color-ink-500)">
            Thành tâm nghĩ về việc muốn hỏi, tự gieo 3 đồng xu (hoặc dùng vật tương đương) 6 lần từ hào 1 đến hào 6, rồi chọn đúng Âm/Dương và đánh dấu hào động (nếu có) vào bảng trên.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-luchao" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="lh-card"></div></div>
          <img id="lh-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="lh-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <!-- Seri tiền -->
      <div id="panel-serial" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-serial" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ bằng Serial Tiền</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="sr-label" class={labelClass}>Việc cần xem</label>
            <input id="sr-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <label for="sr-serial" class={labelClass}>Số Serial Tiền: <span class="text-(--color-cinnabar-400)">*</span></label>
            <input id="sr-serial" type="text" inputmode="numeric" placeholder="19228888" required class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="sr-day" class={selectClass}></select>
              <select id="sr-month" class={selectClass}></select>
              <select id="sr-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="sr-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="sr-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="sr-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>
          <p class="mt-4 text-xs text-(--color-ink-500)">
            Chia dãy số Seri làm 2 nửa: tổng chữ số nửa đầu (dư 8) ra quẻ Thượng, tổng chữ số nửa sau (dư 8) ra quẻ Hạ, tổng tất cả chữ số (dư 6) ra hào động — theo cách "số linh quẻ" ứng dụng Mai Hoa Dịch Số cho số bất kỳ.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-serial" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="sr-card"></div></div>
          <img id="sr-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="sr-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <!-- Số điện thoại -->
      <div id="panel-phone" class="kd-panel mt-6 hidden">
        <button type="button" class="kd-back-link mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">← Đổi phương pháp lập quẻ</button>
        <form id="form-phone" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Lập quẻ bằng Số Điện Thoại</h2>
          <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
            <label for="ph-label" class={labelClass}>Việc cần xem</label>
            <input id="ph-label" type="text" placeholder="Việc cần xem...." class={inputClass} />
          </div>
          <div class="mt-4">
            <label for="ph-phone" class={labelClass}>Số điện thoại: <span class="text-(--color-cinnabar-400)">*</span></label>
            <input id="ph-phone" type="text" inputmode="numeric" placeholder="0912345678" required class={inputClass} />
          </div>
          <div class="mt-4">
            <p class={labelClass}>Ngày lập quẻ:</p>
            <div class="mt-1.5 grid grid-cols-3 gap-3">
              <select id="ph-day" class={selectClass}></select>
              <select id="ph-month" class={selectClass}></select>
              <select id="ph-year" class={selectClass}></select>
            </div>
          </div>
          <div class="mt-4">
            <p class={labelClass}>Giờ lập quẻ:</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <select id="ph-hour" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Giờ</span>
              <select id="ph-minute" class={`${selectClass} w-24`}></select>
              <span class="text-sm text-(--color-ink-600)">Phút</span>
            </div>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
            <input id="ph-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày Âm lịch
          </label>
          <p class="mt-4 text-xs text-(--color-ink-500)">
            Áp dụng cùng cách "số linh quẻ" như Seri tiền, tính trên toàn bộ dãy số điện thoại đã nhập.
          </p>
          <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập quẻ</Button>
        </form>
        <div id="result-phone" class="mt-8 hidden">
          <div class="pointer-events-none h-0 overflow-hidden"><div id="ph-card"></div></div>
          <img id="ph-preview-img" alt="Quẻ Kinh Dịch" class="w-full rounded-2xl border-2 border-(--color-gold-400)/60" />
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button id="ph-save-image" type="button" variant="secondary">Lưu ảnh</Button>
            <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
        <h2 class="font-display text-lg font-semibold text-(--color-ink-950)">Lưu ý về công cụ này</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-ink-600)">
          Công cụ lập quẻ và tính toán Nạp Giáp, Lục Thân, Lục Thú, Thế/Ứng, Tuần Không theo đúng phương pháp Nạp
          Giáp Kinh Phòng cổ điển. Kết quả mang tính tham khảo — việc luận đoán cát hung cụ thể (vượng suy Dụng
          Thần, phối hợp Nhật/Nguyệt kiến, Động biến sinh khắc...) đòi hỏi kiến thức chuyên sâu, nên tham vấn chuyên
          gia để có kết luận chính xác nhất.
        </p>
        <a href="/lien-he" class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">
          Liên hệ luận giải quẻ chuyên sâu →
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  .kd-tab-btn {
    border-color: var(--color-ivory-300);
    background: var(--color-ivory-50);
  }
  .kd-tab-btn:hover {
    border-color: var(--color-gold-400);
  }
  .kd-tab-btn.active {
    border-color: var(--color-gold-400);
    background: var(--color-ivory-100);
    box-shadow: 0 0 0 1px var(--color-gold-400);
  }
</style>

<script>
  import {
    maiHoaCast,
    lucHaoCastManual,
    seriTienCast,
    soDienThoaiCast,
    type FullCastResult,
    type QueDayDu,
    type CastInput,
    type LineVal,
  } from "../lib/luc-hao";
  import { CAN, CHI } from "../lib/menh-nap-am";
  import { lunarToSolar } from "../lib/lunar-calendar";

  // --- Bộ chọn phương pháp (4 thẻ) <-> panel form ---
  const selectorEl = document.getElementById("kd-tabs")!;
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".kd-tab-btn"));
  const panels: Record<string, HTMLElement> = {
    maihoa: document.getElementById("panel-maihoa")!,
    luchao: document.getElementById("panel-luchao")!,
    serial: document.getElementById("panel-serial")!,
    phone: document.getElementById("panel-phone")!,
  };
  function activateTab(tab: string) {
    tabButtons.forEach((btn) => btn.classList.toggle("active", btn.dataset.tab === tab));
    Object.entries(panels).forEach(([key, el]) => el.classList.toggle("hidden", key !== tab));
    selectorEl.classList.add("hidden");
    panels[tab]?.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  function showSelector() {
    selectorEl.classList.remove("hidden");
    Object.values(panels).forEach((el) => el.classList.add("hidden"));
    selectorEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  tabButtons.forEach((btn) => btn.addEventListener("click", () => activateTab(btn.dataset.tab!)));
  document.querySelectorAll<HTMLButtonElement>(".kd-back-link").forEach((btn) => btn.addEventListener("click", showSelector));

  // --- Sinh danh sách lựa chọn Ngày/Tháng/Năm/Giờ/Phút cho cả 4 form ---
  function populateSelect(el: HTMLSelectElement, options: [string | number, string][]) {
    el.innerHTML = options.map(([v, l]) => `<option value="${v}">${l}</option>`).join("");
  }
  const DAY_OPTIONS: [number, string][] = Array.from({ length: 31 }, (_, i) => [i + 1, String(i + 1).padStart(2, "0")]);
  const MONTH_OPTIONS: [number, string][] = Array.from({ length: 12 }, (_, i) => [i + 1, `Tháng ${i + 1}`]);
  const nowYear = new Date().getFullYear();
  const YEAR_OPTIONS: [number, string][] = Array.from({ length: 9 }, (_, i) => nowYear - 5 + i).map((y) => [y, String(y)]);
  const HOUR_OPTIONS: [number, string][] = Array.from({ length: 24 }, (_, i) => [i, String(i).padStart(2, "0")]);
  const MINUTE_OPTIONS: [number, string][] = Array.from({ length: 60 }, (_, i) => [i, String(i).padStart(2, "0")]);

  const PREFIXES = ["mh", "lh", "sr", "ph"];
  const now = new Date();
  PREFIXES.forEach((p) => {
    const daySel = document.getElementById(`${p}-day`) as HTMLSelectElement;
    const monthSel = document.getElementById(`${p}-month`) as HTMLSelectElement;
    const yearSel = document.getElementById(`${p}-year`) as HTMLSelectElement;
    const hourSel = document.getElementById(`${p}-hour`) as HTMLSelectElement;
    const minuteSel = document.getElementById(`${p}-minute`) as HTMLSelectElement;
    populateSelect(daySel, DAY_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(monthSel, MONTH_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(yearSel, YEAR_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(hourSel, HOUR_OPTIONS.map(([v, l]) => [v, l]));
    populateSelect(minuteSel, MINUTE_OPTIONS.map(([v, l]) => [v, l]));
    daySel.value = String(now.getDate());
    monthSel.value = String(now.getMonth() + 1);
    yearSel.value = String(now.getFullYear());
    hourSel.value = String(now.getHours());
    minuteSel.value = String(now.getMinutes());
  });

  function readCastInput(prefix: string): CastInput {
    const day = parseInt((document.getElementById(`${prefix}-day`) as HTMLSelectElement).value, 10);
    const month = parseInt((document.getElementById(`${prefix}-month`) as HTMLSelectElement).value, 10);
    const year = parseInt((document.getElementById(`${prefix}-year`) as HTMLSelectElement).value, 10);
    const hour = parseInt((document.getElementById(`${prefix}-hour`) as HTMLSelectElement).value, 10);
    const minute = parseInt((document.getElementById(`${prefix}-minute`) as HTMLSelectElement).value, 10);
    const lunarCheckbox = document.getElementById(`${prefix}-lunar`) as HTMLInputElement | null;
    if (lunarCheckbox?.checked) {
      const solar = lunarToSolar(day, month, year);
      return { day: solar.d, month: solar.m, year: solar.y, hour, minute };
    }
    return { day, month, year, hour, minute };
  }

  function tuanKhongChiIndices(tuanKhong: string): number[] {
    return tuanKhong.split(" - ").map((s) => CHI.indexOf(s.trim())).filter((i) => i >= 0);
  }

  // --- Thẻ kết quả màu sáng (be/đỏ/đen) để xuất ảnh PNG — bám theo đúng bảng màu/bố cục tham khảo ---
  const LIGHT = {
    bg: "#f6efe0",
    border: "#d9c48f",
    borderLight: "#e6d9ae",
    text: "#2b2116",
    textMuted: "#6b5a3d",
    red: "#b3311f",
    gold: "#c9a256",
    dong: "#c0392b",
    headerBg: "#efe1b8",
  };
  const CARD_WIDTH = 820;

  function lightHexBars(lines: readonly (0 | 1)[], dongPositions: number[]): string {
    const rows = lines.map((line, i) => ({ line, pos: i + 1 })).reverse();
    const bars = rows
      .map(({ line, pos }) => {
        const isDong = dongPositions.includes(pos);
        const color = isDong ? LIGHT.dong : LIGHT.gold;
        if (line === 1) return `<div style="height:7px;border-radius:2px;background:${color};"></div>`;
        return `<div style="height:7px;display:flex;justify-content:space-between;"><div style="width:42%;height:100%;border-radius:2px;background:${color};"></div><div style="width:42%;height:100%;border-radius:2px;background:${color};"></div></div>`;
      })
      .join("");
    return `<div style="display:flex;flex-direction:column;gap:5px;width:110px;margin:0 auto;">${bars}</div>`;
  }

  function lightQueBlock(title: string, name: string, symbol: string, lines: readonly (0 | 1)[], dongPositions: number[], cungText: string): string {
    return `
      <div style="border:1.5px solid ${LIGHT.borderLight};border-radius:10px;padding:10px;text-align:center;">
        <p style="margin:0;font-size:10px;font-weight:800;letter-spacing:.04em;color:${LIGHT.red};">${title}</p>
        <div style="margin-top:8px;">${lightHexBars(lines, dongPositions)}</div>
        <p style="margin:8px 0 0;font-size:12px;font-weight:700;">${name} <span style="color:${LIGHT.textMuted};font-weight:500;">(${symbol})</span></p>
        <p style="margin:2px 0 0;font-size:10px;color:${LIGHT.textMuted};">${cungText}</p>
      </div>
    `;
  }

  function lightHaoTable(title: string, q: QueDayDu, tuanKhongChi: number[]): string {
    const rows = [...q.hao].reverse();
    const trs = rows
      .map((h) => {
        const isK = tuanKhongChi.includes(h.chiIndex);
        const rowColor = h.isDong ? LIGHT.red : LIGHT.text;
        return `
          <tr style="border-bottom:1px solid ${LIGHT.borderLight};">
            <td style="padding:3px 4px;text-align:center;font-weight:700;color:${rowColor};">${h.hao}${h.isDong ? " ●" : ""}</td>
            <td style="padding:3px 4px;text-align:center;color:${LIGHT.red};font-weight:600;">${h.theUng ?? ""}</td>
            <td style="padding:3px 4px;text-align:center;">${h.lucThan}</td>
            <td style="padding:3px 4px;text-align:center;">${h.vuongSuy}</td>
            <td style="padding:3px 4px;text-align:center;font-weight:700;white-space:nowrap;">${CAN[h.canIndex]} ${CHI[h.chiIndex]}${isK ? ` <span style="font-size:8px;background:${LIGHT.headerBg};padding:0 3px;border-radius:3px;">Không</span>` : ""}</td>
            <td style="padding:3px 4px;text-align:center;color:${LIGHT.textMuted};white-space:nowrap;">${h.phucThan ? `${h.phucThan.lucThan} ${CAN[h.phucThan.canIndex]} ${CHI[h.phucThan.chiIndex]}` : "—"}</td>
            <td style="padding:3px 4px;text-align:center;">${h.lucThu}</td>
          </tr>
        `;
      })
      .join("");
    return `
      <div>
        <p style="margin:0 0 4px;font-size:10px;font-weight:800;color:${LIGHT.red};text-align:center;">${title}</p>
        <table style="width:100%;border-collapse:collapse;font-size:9px;">
          <thead>
            <tr style="background:${LIGHT.headerBg};">
              <th style="padding:3px 2px;">Hào</th><th style="padding:3px 2px;">T/Ư</th><th style="padding:3px 2px;">Lục Thân</th><th style="padding:3px 2px;">V-S</th><th style="padding:3px 2px;">Can Chi</th><th style="padding:3px 2px;">P.Thần</th><th style="padding:3px 2px;">Lục Thú</th>
            </tr>
          </thead>
          <tbody>${trs}</tbody>
        </table>
      </div>
    `;
  }

  function buildExportCardHtml(cast: FullCastResult, methodLabel: string, viecCanXem: string, timeLabel: string): string {
    const tuanKhongChi = tuanKhongChiIndices(cast.tuanKhong);
    const queCols = cast.bien ? 3 : 2;
    const blocks = [
      lightQueBlock("QUẺ CHÍNH", cast.chinh.name, `${cast.chinh.upper.symbol}${cast.chinh.lower.symbol}`, cast.chinh.lines, cast.dongPositions, `Quái ${cast.chinh.cungTrigram.name} — ${cast.chinh.cungLabel}`),
      lightQueBlock("QUẺ HỖ", cast.hoQue.name, `${cast.hoQue.upper.symbol}${cast.hoQue.lower.symbol}`, cast.hoQue.lines, [], `Quái ${cast.hoQue.cungLabel}`),
    ];
    if (cast.bien) {
      blocks.push(lightQueBlock("QUẺ BIẾN", cast.bien.name, `${cast.bien.upper.symbol}${cast.bien.lower.symbol}`, cast.bien.lines, [], `Quái ${cast.bien.cungTrigram.name} — ${cast.bien.cungLabel}`));
    }
    const tables = cast.bien
      ? `<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">${lightHaoTable("Quẻ chính", cast.chinh, tuanKhongChi)}${lightHaoTable("Quẻ biến", cast.bien, tuanKhongChi)}</div>`
      : lightHaoTable("Quẻ chính", cast.chinh, tuanKhongChi);

    return `
      <div style="width:${CARD_WIDTH}px;font-family:Arial,'Helvetica Neue',sans-serif;background:${LIGHT.bg};color:${LIGHT.text};border:3px solid ${LIGHT.border};border-radius:16px;padding:20px;box-sizing:border-box;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid ${LIGHT.borderLight};padding-bottom:10px;">
          <div>
            <p style="margin:0;font-size:16px;font-weight:800;letter-spacing:.02em;color:${LIGHT.red};">PHONGTHUYTHIENANH.COM</p>
            <p style="margin:3px 0 0;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:${LIGHT.textMuted};">Phần mềm lập quẻ Kinh Dịch</p>
          </div>
          <img src="/images/brand/zhi-gong-logo.png" style="width:44px;height:44px;border-radius:9999px;border:2px solid ${LIGHT.border};object-fit:cover;" />
        </div>
        <div style="margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:4px 24px;font-size:11px;line-height:1.7;">
          <p style="margin:0;"><strong>Phương pháp lập quẻ:</strong> ${methodLabel}</p>
          <p style="margin:0;"><strong>Việc cần xem:</strong> ${viecCanXem || "—"}</p>
          <p style="margin:0;"><strong>Thời gian lập quẻ:</strong> ${timeLabel}</p>
          <p style="margin:0;"><strong>Theo Âm lịch:</strong> ${cast.amLichText}</p>
          <p style="margin:0;grid-column:1 / -1;"><strong>Can Chi:</strong> ${cast.canChiText}</p>
          <p style="margin:0;"><strong>Tiết khí:</strong> ${cast.tietKhi}</p>
          <p style="margin:0;"><strong>Tuần Không:</strong> ${cast.tuanKhong}</p>
          <p style="margin:0;"><strong>Nhật thần:</strong> ${cast.nhatThan}</p>
          <p style="margin:0;"><strong>Nguyệt lệnh:</strong> ${cast.nguyetLenh}</p>
        </div>
        <div style="margin-top:16px;display:grid;grid-template-columns:repeat(${queCols}, 1fr);gap:10px;">${blocks.join("")}</div>
        <div style="margin-top:16px;">${tables}</div>
        <p style="margin:12px 0 0;font-size:9px;color:${LIGHT.textMuted};text-align:center;">Lập quẻ Kinh Dịch tại Phong Thủy Thiên Anh — phongthuythienanh.com</p>
      </div>
    `;
  }

  async function captureCardAsPng(cardEl: HTMLElement): Promise<string> {
    const { toPng } = await import("html-to-image");
    return await toPng(cardEl, { backgroundColor: LIGHT.bg, pixelRatio: 2, skipFonts: true, width: CARD_WIDTH });
  }

  async function renderExportCard(
    prefix: string,
    resultId: string,
    cast: FullCastResult,
    methodLabel: string,
    viecCanXem: string,
    timeLabel: string,
    fileBase: string,
  ) {
    const resultEl = document.getElementById(resultId)!;
    const cardEl = document.getElementById(`${prefix}-card`)!;
    cardEl.innerHTML = buildExportCardHtml(cast, methodLabel, viecCanXem, timeLabel);
    resultEl.classList.remove("hidden");
    try {
      const dataUrl = await captureCardAsPng(cardEl);
      const img = document.getElementById(`${prefix}-preview-img`) as HTMLImageElement;
      img.src = dataUrl;
      const saveBtn = document.getElementById(`${prefix}-save-image`) as HTMLButtonElement;
      saveBtn.onclick = () => {
        const link = document.createElement("a");
        link.download = `${fileBase}.png`;
        link.href = dataUrl;
        link.click();
      };
    } catch (err) {
      console.error("Không tạo được ảnh kết quả:", err);
      alert("Đã lập quẻ xong nhưng không tạo được ảnh, vui lòng thử lại.");
    }
    resultEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function formatTimeLabel(input: CastInput): string {
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${pad(input.day)}/${pad(input.month)}/${input.year} ${pad(input.hour)}:${pad(input.minute ?? 0)}`;
  }

  function handleLunarError(err: unknown): boolean {
    if (err instanceof Error && err.message.includes("Âm lịch")) {
      alert(err.message);
      return true;
    }
    return false;
  }

  function fileDateSlug(input: CastInput): string {
    return `${input.year}-${String(input.month).padStart(2, "0")}-${String(input.day).padStart(2, "0")}`;
  }

  // --- Mai Hoa ---
  document.getElementById("form-maihoa")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("mh-label") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("mh");
      const cast = maiHoaCast(input);
      await renderExportCard("mh", "result-maihoa", cast, "Gieo quẻ Mai Hoa Dịch Số", label, formatTimeLabel(input), `mai-hoa-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Không lập được quẻ, vui lòng kiểm tra lại thời gian nhập vào.");
    }
  });

  // --- Lục Hào (nhập tay) ---
  document.getElementById("form-luchao")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("lh-label") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("lh");
      const values: LineVal[] = [];
      const dongPositions: number[] = [];
      for (let n = 1; n <= 6; n++) {
        const v = parseInt((document.getElementById(`lh-hao-${n}-value`) as HTMLSelectElement).value, 10) as LineVal;
        values.push(v);
        if ((document.getElementById(`lh-hao-${n}-dong`) as HTMLInputElement).checked) dongPositions.push(n);
      }
      const cast = lucHaoCastManual(values, dongPositions, input);
      await renderExportCard("lh", "result-luchao", cast, "Lục Hào — nhập tay", label, formatTimeLabel(input), `luc-hao-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Không lập được quẻ, vui lòng kiểm tra lại thông tin đã nhập.");
    }
  });

  // --- Seri tiền ---
  document.getElementById("form-serial")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("sr-label") as HTMLInputElement).value.trim();
    const serial = (document.getElementById("sr-serial") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("sr");
      const cast = seriTienCast(serial, input);
      await renderExportCard("sr", "result-serial", cast, `Lập quẻ bằng Seri tiền - ${serial}`, label, formatTimeLabel(input), `seri-tien-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Vui lòng nhập số Seri hợp lệ (ít nhất 2 chữ số).");
    }
  });

  // --- Số điện thoại ---
  document.getElementById("form-phone")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const label = (document.getElementById("ph-label") as HTMLInputElement).value.trim();
    const phone = (document.getElementById("ph-phone") as HTMLInputElement).value.trim();
    try {
      const input = readCastInput("ph");
      const cast = soDienThoaiCast(phone, input);
      await renderExportCard("ph", "result-phone", cast, `Lập quẻ bằng Số điện thoại - ${phone}`, label, formatTimeLabel(input), `so-dien-thoai-${fileDateSlug(input)}`);
    } catch (err) {
      console.error(err);
      if (!handleLunarError(err)) alert("Vui lòng nhập số điện thoại hợp lệ (ít nhất 2 chữ số).");
    }
  });
</script>
