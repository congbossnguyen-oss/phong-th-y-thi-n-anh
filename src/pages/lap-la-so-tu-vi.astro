---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;

const inputClass =
  "mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20";
const selectClass =
  "w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20";
const labelClass = "text-sm font-medium text-(--color-ink-800)";
// Validation UI thuần túy cho "Năm xem" (không đụng thuật toán lịch/engine) — giới hạn hợp lý để tránh
// nhập số vô nghĩa (âm, quá xa quá khứ/tương lai) gây hiển thị tuổi/Đại Vận sai lệch.
const VIEWING_YEAR_MIN = 1900;
const VIEWING_YEAR_MAX = new Date().getFullYear() + 10;
---

<BaseLayout
  title="Lập lá số Tử Vi — Tử Vi Đẩu Số"
  description="Lập lá số Tử Vi Đẩu Số theo ngày giờ sinh: 12 cung, 14 chính tinh, Miếu/Vượng/Đắc/Hãm, Tứ Hóa, các phụ tinh chính và Đại Vận."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập lá số Tử Vi"
    description="Nhập đầy đủ ngày giờ sinh (Dương lịch hoặc Âm lịch) và giới tính để lập lá số Tử Vi Đẩu Số — hiển thị 12 cung, 14 chính tinh, Miếu/Vượng/Đắc/Hãm, Tứ Hóa, các phụ tinh chính và Đại Vận."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập lá số Tử Vi" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-3xl">
      <form id="form-tuvi" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
        <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Thông tin lập lá số</h2>
        <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
          <label for="tv-name" class={labelClass}>Họ tên (không bắt buộc)</label>
          <input id="tv-name" type="text" placeholder="Nguyễn Văn A" class={inputClass} />
        </div>

        <div class="mt-4">
          <p class={labelClass}>Giới tính</p>
          <div class="mt-1.5 flex gap-3">
            <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm has-checked:border-(--color-gold-400) has-checked:bg-(--color-ivory-100)">
              <input type="radio" name="tv-gender" value="Nam" checked class="size-4" /> Nam
            </label>
            <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm has-checked:border-(--color-gold-400) has-checked:bg-(--color-ivory-100)">
              <input type="radio" name="tv-gender" value="Nữ" class="size-4" /> Nữ
            </label>
          </div>
        </div>

        <div class="mt-4">
          <p class={labelClass}>Ngày sinh:</p>
          <div class="mt-1.5 grid grid-cols-3 gap-3">
            <select id="tv-day" class={selectClass}></select>
            <select id="tv-month" class={selectClass}></select>
            <select id="tv-year" class={selectClass}></select>
          </div>
        </div>

        <div class="mt-4">
          <p class={labelClass}>Giờ sinh:</p>
          <select id="tv-hour" class={selectClass}></select>
        </div>

        <label class="mt-4 flex items-center gap-2 text-sm text-(--color-ink-700)">
          <input id="tv-lunar" type="checkbox" class="size-4 rounded border-(--color-ivory-300)" /> Ngày sinh trên là Âm lịch
        </label>

        <div class="mt-4">
          <label for="tv-viewing-year" class={labelClass}>Năm xem (để tính tuổi và mốc Đại Vận)</label>
          <input
            id="tv-viewing-year"
            type="number"
            min={VIEWING_YEAR_MIN}
            max={VIEWING_YEAR_MAX}
            step="1"
            class={inputClass}
          />
          <p class="mt-1 text-xs text-(--color-ink-500)">Để trống nếu không cần xem tuổi/Đại Vận. Nhập từ {VIEWING_YEAR_MIN} đến {VIEWING_YEAR_MAX}.</p>
        </div>

        <p class="mt-4 text-xs text-(--color-ink-500)">
          Engine tính theo profile Nam Phái phổ biến. Vị trí 12 cung, 14 chính tinh và Tứ Hóa đã được đối chiếu khớp
          với lá số mẫu tham chiếu; một số phụ tinh và trạng thái Miếu/Vượng ở các cung khác vị trí đã đối chiếu là suy
          ra theo tài liệu phổ biến, mang tính tham khảo.
        </p>
        <Button type="submit" size="lg" class="mt-5 w-full sm:w-auto">Lập lá số</Button>
      </form>

      <div id="result-tuvi" class="mt-8 hidden">
        <div class="pointer-events-none h-0 overflow-hidden"><div id="tv-card"></div></div>
        <p id="tv-loading" class="py-6 text-center text-sm text-(--color-ink-500)">Đang tạo ảnh lá số…</p>
        <div class="overflow-x-auto">
          <img id="tv-preview-img" alt="Lá số Tử Vi" class="mx-auto hidden rounded-2xl border-2 border-(--color-gold-400)/60" />
        </div>
        <div id="tv-save-row" class="mt-4 hidden flex-wrap items-center justify-center gap-3">
          <Button id="tv-save-image" type="button" variant="secondary">Lưu ảnh</Button>
          <p class="text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
        </div>
      </div>

      <div class="mt-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
        <h2 class="font-display text-lg font-semibold text-(--color-ink-950)">Lưu ý về công cụ này</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-ink-600)">
          Lá số Tử Vi là công cụ tham khảo, tính theo các quy tắc phổ biến của Tử Vi Đẩu Số (Nam phái). Việc luận giải
          cát hung cụ thể (cách cục, sao xung hợp, vận hạn từng giai đoạn...) đòi hỏi kiến thức chuyên sâu, nên tham
          vấn chuyên gia để có kết luận chính xác nhất.
        </p>
        <a href="/lien-he" class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">
          Liên hệ luận giải lá số chuyên sâu →
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { tinhTuVi, type TuViChart, type CungKetQua } from "../lib/tu-vi/engine";
  import { lunarToSolar } from "../lib/lunar-calendar";
  import { getTapDieu } from "../lib/tu-vi/tap-dieu";
  import { colorOfSao, isCat } from "../lib/tu-vi/hien-thi-sao";

  function populateSelect(el: HTMLSelectElement, options: [string | number, string][]) {
    el.innerHTML = options.map(([v, l]) => `<option value="${v}">${l}</option>`).join("");
  }
  const DAY_OPTIONS: [number, string][] = Array.from({ length: 31 }, (_, i) => [i + 1, String(i + 1).padStart(2, "0")]);
  const MONTH_OPTIONS: [number, string][] = Array.from({ length: 12 }, (_, i) => [i + 1, `Tháng ${i + 1}`]);
  const nowYear = new Date().getFullYear();
  const YEAR_OPTIONS: [number, string][] = Array.from({ length: 100 }, (_, i) => nowYear - i).map((y) => [y, String(y)]);
  // Giờ sinh chọn theo 12 Chi (giờ đại diện đầu mỗi canh giờ) — khớp công thức gioChiIndex trong engine.
  const HOUR_OPTIONS: [number, string][] = [
    [23, "Tý (23h-01h)"], [1, "Sửu (01h-03h)"], [3, "Dần (03h-05h)"], [5, "Mão (05h-07h)"],
    [7, "Thìn (07h-09h)"], [9, "Tỵ (09h-11h)"], [11, "Ngọ (11h-13h)"], [13, "Mùi (13h-15h)"],
    [15, "Thân (15h-17h)"], [17, "Dậu (17h-19h)"], [19, "Tuất (19h-21h)"], [21, "Hợi (21h-23h)"],
  ];

  const daySel = document.getElementById("tv-day") as HTMLSelectElement;
  const monthSel = document.getElementById("tv-month") as HTMLSelectElement;
  const yearSel = document.getElementById("tv-year") as HTMLSelectElement;
  const hourSel = document.getElementById("tv-hour") as HTMLSelectElement;
  const viewingYearInput = document.getElementById("tv-viewing-year") as HTMLInputElement;
  populateSelect(daySel, DAY_OPTIONS);
  populateSelect(monthSel, MONTH_OPTIONS);
  populateSelect(yearSel, YEAR_OPTIONS);
  populateSelect(hourSel, HOUR_OPTIONS);
  const now = new Date();
  daySel.value = String(now.getDate());
  monthSel.value = String(now.getMonth() + 1);
  yearSel.value = String(now.getFullYear() - 30);
  hourSel.value = "11";
  viewingYearInput.value = String(now.getFullYear());

  const LIGHT = {
    bg: "#f6efe0",
    border: "#c9a256",
    borderLight: "#e6d9ae",
    cellBorder: "#d9c48f",
    text: "#2b2116",
    textMuted: "#6b5a3d",
    red: "#b3311f",
    gold: "#c9a256",
    headerBg: "#efe1b8",
    menhBg: "#f6e2c4",
  };
  // CARD_WIDTH/CARD_HEIGHT là kích thước CSS thật; xuất ảnh dùng pixelRatio 2 để ra đúng 1440x2000px.
  const CARD_WIDTH = 720;
  const CARD_HEIGHT = 1460;
  const TT_ABBR: Record<string, string> = { "Miếu": "(M)", "Vượng": "(V)", "Đắc": "(Đ)", "Bình": "(B)", "Hãm": "(H)", "Chưa xác định": "(?)" };
  const TU_HOA_ABBR: Record<string, string> = { "Lộc": "L", "Quyền": "Q", "Khoa": "K", "Kỵ": "H" };
  // Chủ Mệnh/Chủ Thân: engine trả "NEED_GOLDEN_MASTER_REVIEW" cho 8/12 Chi năm sinh chưa có Golden
  // Master xác nhận (Phase 8) — hiển thị thân thiện hơn thay vì lộ nguyên chuỗi kỹ thuật.
  function displayChuMenhThan(value: string): string {
    return value === "NEED_GOLDEN_MASTER_REVIEW" ? "Chưa xác định (cần thêm dữ liệu)" : value;
  }

  // Bố cục lưới 4x4 chuẩn Tử Vi: hàng trên Tỵ-Ngọ-Mùi-Thân, cột phải Dậu-Tuất, hàng dưới (trái->phải)
  // Dần-Sửu-Tý-Hợi, cột trái Mão-Thìn (từ dưới lên) — trung tâm 2x2 gộp làm bảng Thiên Bàn.
  const GRID_CELLS: { chiIndex: number; row: number; col: number }[] = [
    { chiIndex: 5, row: 1, col: 1 }, { chiIndex: 6, row: 1, col: 2 }, { chiIndex: 7, row: 1, col: 3 }, { chiIndex: 8, row: 1, col: 4 },
    { chiIndex: 4, row: 2, col: 1 }, { chiIndex: 9, row: 2, col: 4 },
    { chiIndex: 3, row: 3, col: 1 }, { chiIndex: 10, row: 3, col: 4 },
    { chiIndex: 2, row: 4, col: 1 }, { chiIndex: 1, row: 4, col: 2 }, { chiIndex: 0, row: 4, col: 3 }, { chiIndex: 11, row: 4, col: 4 },
  ];

  type DisplayStar = { name: string; tuHoa?: "Lộc" | "Quyền" | "Khoa" | "Kỵ" };

  function starLineHtml(s: DisplayStar): string {
    const tuHoaTag = s.tuHoa ? `<sup style="color:${LIGHT.red};font-weight:800;">${TU_HOA_ABBR[s.tuHoa]}</sup>` : "";
    const color = colorOfSao(s.name, LIGHT.textMuted);
    return `<div style="font-size:7px;font-weight:700;color:${color};line-height:1.4;white-space:nowrap;">${s.name}${tuHoaTag}</div>`;
  }

  // Tab nối Tuần/Triệt giữa 2 cung liền cạnh — thay cho badge trong từng ô (yêu cầu Công: "1 ô nối giữa
  // 2 cung bị tuần hoặc triệt"). `edge` là cạnh của Ô HIỆN TẠI giáp với ô kia.
  // `bias`: vị trí dọc theo cạnh chung — "middle" (mặc định, giữa cạnh) hoặc "start"/"end" cho 4 cặp Tý-
  // Sửu/Ngọ-Mùi/Mão-Thìn/Dậu-Tuất (2 cung liền cạnh bảng giữa VÀ liền nhau): yêu cầu Công đẩy về đúng
  // điểm giao 3 cạnh hướng vào ô trung tâm thay vì giữa cạnh.
  function edgeTabHtml(edge: "top" | "bottom" | "left" | "right", label: string, bg: string, fg: string, bias: "start" | "middle" | "end" = "middle"): string {
    const vertical = edge === "left" || edge === "right";
    const size = label.length * 7 + 6;
    const alongPos =
      edge === "right" ? "right:-5px;" : edge === "left" ? "left:-5px;" : edge === "bottom" ? "bottom:-5px;" : "top:-5px;";
    const perpPos = vertical
      ? (bias === "start" ? "top:2px;" : bias === "end" ? "bottom:2px;" : "top:50%;transform:translateY(-50%);")
      : (bias === "start" ? "left:2px;" : bias === "end" ? "right:2px;" : "left:50%;transform:translateX(-50%);");
    const dim = vertical ? `width:10px;height:${size}px;` : `width:${size}px;height:10px;`;
    const writingMode = vertical ? "writing-mode:vertical-rl;text-orientation:upright;" : "";
    return `<div style="position:absolute;${alongPos}${perpPos}${dim}${writingMode}display:flex;align-items:center;justify-content:center;font-size:7px;font-weight:800;letter-spacing:.02em;color:${fg};background:${bg};border-radius:3px;z-index:3;box-shadow:0 0 0 1px ${LIGHT.border};">${label}</div>`;
  }

  // Chỉ "start"/"end" khi CẢ 2 cung đều liền cạnh bảng giữa VÀ liền nhau (4 cặp cố định: Tý-Sửu, Ngọ-Mùi,
  // Mão-Thìn, Dậu-Tuất) — đẩy về đúng điểm giao 3 cạnh hướng vào ô trung tâm. Các cặp còn lại (có 1 cung
  // là 1 trong 4 cung góc Dần/Thân/Tỵ/Hợi) giữ nguyên "middle" (giữa cạnh) như trước.
  function edgeEdgeBias(a: { row: number; col: number }, b: { row: number; col: number }): "start" | "middle" | "end" {
    const isEdgeRowPair = (a.row === 1 || a.row === 4) && a.row === b.row && ((a.col === 2 && b.col === 3) || (a.col === 3 && b.col === 2));
    if (isEdgeRowPair) return a.row === 1 ? "end" : "start";
    const isEdgeColPair = (a.col === 1 || a.col === 4) && a.col === b.col && ((a.row === 2 && b.row === 3) || (a.row === 3 && b.row === 2));
    if (isEdgeColPair) return a.col === 1 ? "end" : "start";
    return "middle";
  }

  // Yêu cầu Công (bản mới nhất): với 4 cặp Tý-Sửu/Ngọ-Mùi/Mão-Thìn/Dậu-Tuất, KHÔNG đặt tab dọc theo cạnh
  // chung nữa — thay bằng 1 THANH DUY NHẤT nằm NGANG (cặp cùng hàng) hoặc DỌC (cặp cùng cột), phủ vào cả
  // 2 cung để trông như "nối liền" 2 cung đó, tâm thanh đặt đúng điểm giao 3 cạnh hướng vào bảng giữa.
  // Vẽ 1 lần duy nhất ở cấp lưới (không lặp lại theo từng ô) bằng % vị trí trên hệ tọa độ lưới 0-4.
  function tuanTrietBridgeHtml(chiA: number, chiB: number, chiToRowCol: Record<number, { row: number; col: number }>, label: string, bg: string, fg: string): string {
    const a = chiToRowCol[chiA], b = chiToRowCol[chiB];
    const bias = edgeEdgeBias(a, b);
    if (bias === "middle") return ""; // cặp không đặc biệt (có cung góc) — giữ tab từng ô như cũ.
    const isRowPair = a.row === b.row;
    // Yêu cầu Công: thanh chỉ cần đủ nhỏ để đọc được chữ TUẦN/TRIỆT, không cần phủ rộng vào 2 cung.
    const barLen = 0.34;
    const barThick = 0.06;
    const cx = isRowPair ? 2 : (bias === "end" ? 1 : 3);
    const cy = isRowPair ? (bias === "end" ? 1 : 3) : 2;
    const w = isRowPair ? barLen : barThick;
    const h = isRowPair ? barThick : barLen;
    const leftPct = ((cx - w / 2) / 4) * 100;
    const topPct = ((cy - h / 2) / 4) * 100;
    const writingMode = isRowPair ? "" : "writing-mode:vertical-rl;text-orientation:upright;";
    return `<div style="position:absolute;left:${leftPct}%;top:${topPct}%;width:${(w / 4) * 100}%;height:${(h / 4) * 100}%;${writingMode}display:flex;align-items:center;justify-content:center;overflow:visible;white-space:nowrap;font-size:6px;font-weight:800;letter-spacing:.01em;color:${fg};background:${bg};border-radius:3px;z-index:6;box-shadow:0 0 0 1px ${LIGHT.border};">${label}</div>`;
  }

  function cellHtml(p: CungKetQua, tapDieuNames: string[], tuanTrietTabsHtml: string, isCurrentDaiVan: boolean): string {
    // Yêu cầu Công: mỗi chính tinh xuống hàng riêng (chính tinh 1, dưới là chính tinh 2), không nằm
    // chung 1 dòng.
    // Yêu cầu Công: bỏ hẳn sup Tứ Hóa trên chính tinh (đã có sẵn ở khối tóm tắt giữa bảng, không lặp lại
    // ở đây nữa); chữ trạng thái (M)/(V)/(Đ)/(B)/(H) to bằng đúng cỡ chữ tên chính tinh, không nhỏ hơn.
    const chinhTinhHtml = p.chinhTinh
      .map((s) => {
        const color = colorOfSao(s.name, LIGHT.text);
        return `<div style="line-height:1.15;"><span style="font-weight:800;font-size:11px;color:${color};white-space:nowrap;">${s.name}</span><span style="font-weight:800;font-size:11px;color:${LIGHT.textMuted};"> ${TT_ABBR[s.trangThai]}</span></div>`;
      })
      .join("");
    // Yêu cầu Công: nơi an Thân hiện "(THÂN)" chữ hoa in đậm ngay cạnh CUNG CHỨC, cỡ chữ bằng đúng cỡ chữ
    // cung chức (12px).
    const thanTag = p.isThan ? ` <strong style="font-size:12px;font-weight:800;color:${LIGHT.text};">(THÂN)</strong>` : "";

    const allPhu: DisplayStar[] = [...p.phuTinh, ...tapDieuNames.map((n) => ({ name: n }))];
    const catHtml = allPhu.filter((s) => isCat(s.name)).map(starLineHtml).join("");
    const hungHtml = allPhu.filter((s) => !isCat(s.name)).map(starLineHtml).join("");

    // Bố cục theo yêu cầu Công: 1 hàng trên cùng gồm Can Chi (trái) — tên cung (giữa, to nhất, đậm, đen,
    // đẩy lên cao nhất) — mốc Đại Vận (phải); dưới là chính tinh xếp dọc (đậm, màu Ngũ Hành); hàng dưới
    // trái = phụ tinh tốt (sát lề trái), phải = phụ tinh xấu (sát lề phải); Trường Sinh ở giữa dưới cùng.
    // Yêu cầu Công: cung đang ở đúng mốc Đại Vận hiện tại (theo Năm xem) phủ 1 lớp mờ để dễ nhận diện.
    const currentDaiVanOverlay = isCurrentDaiVan
      ? `<div style="position:absolute;inset:0;background:${LIGHT.gold}40;border:2px solid ${LIGHT.gold};box-sizing:border-box;pointer-events:none;z-index:1;"></div>`
      : "";
    return `
      <div style="position:relative;height:100%;">
        ${tuanTrietTabsHtml}
        <div style="position:relative;border:1px solid ${LIGHT.cellBorder};background:${p.isMenh || p.isThan ? LIGHT.menhBg : LIGHT.bg};padding:5px;box-sizing:border-box;height:100%;display:flex;flex-direction:column;overflow:hidden;">
          ${currentDaiVanOverlay}
          <div style="display:flex;justify-content:space-between;align-items:center;gap:4px;">
            <span style="font-size:8px;color:${LIGHT.textMuted};white-space:nowrap;flex-shrink:0;">${p.canName}${p.chiName}</span>
            <span style="flex:1;text-align:center;font-size:12px;font-weight:800;color:${LIGHT.text};white-space:nowrap;overflow:hidden;">${p.cungName.toUpperCase()}${thanTag}</span>
            <span style="font-size:8px;color:${LIGHT.textMuted};white-space:nowrap;flex-shrink:0;">${p.daiVanTuoi[0]}-${p.daiVanTuoi[1]}</span>
          </div>
          <div style="text-align:center;margin-top:0;">${chinhTinhHtml}</div>
          <div style="flex:1;min-height:0;display:flex;justify-content:space-between;gap:3px;margin-top:3px;">
            <div style="display:flex;flex-direction:column;align-items:flex-start;min-width:0;">${catHtml}</div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;min-width:0;text-align:right;">${hungHtml}</div>
          </div>
          <div style="text-align:center;font-size:7px;font-weight:800;color:${LIGHT.textMuted};margin-top:2px;white-space:nowrap;">${p.trangSinh}${p.thaiTue ? " · " + p.thaiTue : ""}</div>
        </div>
      </div>
    `;
  }

  function centerPanelHtml(chart: TuViChart, name: string, timeLabel: string): string {
    return `
      <div style="grid-row:2 / span 2;grid-column:2 / span 2;border:1px solid ${LIGHT.cellBorder};background:${LIGHT.headerBg};padding:10px 12px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;overflow:hidden;">
        <div style="font-size:10px;line-height:1.85;color:${LIGHT.text};">
          ${name ? `<p style="margin:0;font-weight:800;font-size:12px;">${name}</p>` : ""}
          <p style="margin:0;">${chart.input.gender} — ${chart.amDuongNam}</p>
          <p style="margin:0;">Dương lịch: <strong>${timeLabel}</strong></p>
          <p style="margin:0;">Âm lịch: <strong>${chart.lunarDay}/${chart.lunarMonth}${chart.lunarIsLeap ? " (nhuận)" : ""}/${chart.lunarYear}</strong> — giờ ${chart.gioChiName}</p>
          <p style="margin:0;">Năm sinh: <strong>${chart.yearCanName} ${chart.yearChiName}</strong>${chart.tuoiNamXem !== null ? ` — ${chart.tuoiNamXem} tuổi (năm ${chart.input.viewingYear})` : ""}</p>
          <p style="margin:0;">Bản mệnh: <strong>${chart.banMenhNapAm}</strong> (${chart.banMenhElement})</p>
          <p style="margin:0;">Cục: <strong>${chart.cucName}</strong> — Mệnh Quái: <strong>${chart.menhQuai}</strong></p>
          <p style="margin:0;">Chủ Mệnh: <strong>${displayChuMenhThan(chart.chuMenh)}</strong> — Chủ Thân: <strong>${displayChuMenhThan(chart.chuThan)}</strong></p>
          <p style="margin:0;">Tứ Hóa: <strong style="color:${LIGHT.red};">${chart.tuHoa.loc}</strong> L · <strong style="color:${LIGHT.red};">${chart.tuHoa.quyen}</strong> Q · <strong style="color:${LIGHT.red};">${chart.tuHoa.khoa}</strong> K · <strong style="color:${LIGHT.red};">${chart.tuHoa.ky}</strong> H</p>
        </div>
      </div>
    `;
  }

  // Mirror của rules.ts tamHopGroup() — CHỈ dùng để vẽ đường tam hợp minh họa, không tính lại logic engine.
  const TAM_HOP_GROUPS: number[][] = [[8, 0, 4], [2, 6, 10], [5, 9, 1], [11, 3, 7]];

  // Điểm chung duy nhất để bắn 3 tia từ cung Mệnh. Yêu cầu Công: (1) Tý/Sửu/Mão/Thìn/Ngọ/Mùi/Dậu/Tuất —
  // các cung có cạnh áp thẳng vào bảng giữa — bắn từ CHÍNH GIỮA cạnh đó; (2) Dần/Thân/Tỵ/Hợi — 4 cung góc
  // của lưới, chỉ chạm bảng giữa đúng 1 điểm góc — bắn từ ĐÚNG GÓC giao 3 cung đó.
  function centerFacingAnchor(rc: { row: number; col: number }): { x: number; y: number } {
    const isTopRow = rc.row === 1;
    const isBottomRow = rc.row === 4;
    const isLeftCol = rc.col === 1;
    const isRightCol = rc.col === 4;
    const isCorner = (isTopRow || isBottomRow) && (isLeftCol || isRightCol);
    if (isCorner) return { x: isLeftCol ? 1 : 3, y: isTopRow ? 1 : 3 };
    if (isTopRow) return { x: rc.col - 0.5, y: 1 };
    if (isBottomRow) return { x: rc.col - 0.5, y: 3 };
    if (isLeftCol) return { x: 1, y: rc.row - 0.5 };
    return { x: 3, y: rc.row - 0.5 }; // isRightCol — 12 cung ngoài luôn rơi vào 1 trong 4 nhánh trên.
  }

  function edgeBetween(a: { row: number; col: number }, b: { row: number; col: number }): "top" | "bottom" | "left" | "right" | null {
    if (a.row === b.row) return b.col > a.col ? "right" : "left";
    if (a.col === b.col) return b.row > a.row ? "bottom" : "top";
    return null; // Tuần/Triệt luôn là 2 Chi liền nhau trong vòng 12, và vòng 12 cung xếp viền ngoài lưới
    // 4x4 nên luôn liền cạnh — nhánh này chỉ để không bao giờ crash nếu có trường hợp bất thường.
  }

  // Với 4 cặp Tý-Sửu/Ngọ-Mùi/Mão-Thìn/Dậu-Tuất KHÔNG render tab theo từng ô nữa — đã có 1 thanh ngang/dọc
  // DUY NHẤT nối 2 cung ở cấp lưới (`tuanTrietBridgeHtml`, gọi 1 lần trong buildExportCardHtml). Hàm này
  // chỉ còn xử lý các cặp "middle" (1 trong 2 cung là cung góc Dần/Thân/Tỵ/Hợi) — giữ nguyên tab từng ô.
  function tuanTrietTabsFor(chiIndex: number, chart: TuViChart, chiToRowCol: Record<number, { row: number; col: number }>): string {
    let html = "";
    const tuanChis = chart.cungs.filter((c) => c.tuan).map((c) => c.chiIndex);
    if (tuanChis.length === 2 && tuanChis.includes(chiIndex)) {
      const other = tuanChis.find((i) => i !== chiIndex)!;
      const a = chiToRowCol[chiIndex], b = chiToRowCol[other];
      if (edgeEdgeBias(a, b) === "middle") {
        const edge = edgeBetween(a, b);
        if (edge) html += edgeTabHtml(edge, "TUẦN", LIGHT.gold, LIGHT.text, "middle");
      }
    }
    const trietChis = chart.cungs.filter((c) => c.triet).map((c) => c.chiIndex);
    if (trietChis.length === 2 && trietChis.includes(chiIndex)) {
      const other = trietChis.find((i) => i !== chiIndex)!;
      const a = chiToRowCol[chiIndex], b = chiToRowCol[other];
      if (edgeEdgeBias(a, b) === "middle") {
        const edge = edgeBetween(a, b);
        if (edge) html += edgeTabHtml(edge, "TRIỆT", "#2c4a7c", "#ffffff", "middle");
      }
    }
    return html;
  }

  // Yêu cầu Công: từ cung Mệnh kẻ 2 đường tới 2 cung tam hợp + 1 đường tới cung đối diện (xung chiếu) —
  // minh họa Tam Phương Tứ Chính. Đường mờ, nằm dưới lớp chữ (opacity thấp) để không che nội dung.
  function menhLinesHtml(chart: TuViChart, chiToRowCol: Record<number, { row: number; col: number }>): string {
    const menhChi = chart.menhChiIndex;
    const group = TAM_HOP_GROUPS.find((g) => g.includes(menhChi))!;
    const tamHopPartners = group.filter((c) => c !== menhChi);
    const doiCung = (menhChi + 6) % 12;
    // Yêu cầu Công: điểm ĐẾN cũng phải là điểm neo riêng của đúng cung đích (giữa cạnh nếu cung đích liền
    // cạnh bảng giữa, hoặc đúng góc giao 3 cung nếu cung đích là 1 trong 4 cung góc) — KHÔNG lấy tâm cung
    // rồi cắt tùy theo góc nghiêng của tia như trước (mỗi tia khi đó sẽ vào 1 điểm khác nhau tùy hướng).
    const fromAnchor = centerFacingAnchor(chiToRowCol[menhChi]);
    const lines = [...tamHopPartners, doiCung]
      .map((t) => {
        const toAnchor = centerFacingAnchor(chiToRowCol[t]);
        return `<line x1="${fromAnchor.x}" y1="${fromAnchor.y}" x2="${toAnchor.x}" y2="${toAnchor.y}" stroke="${LIGHT.textMuted}" stroke-width="0.004" />`;
      })
      .join("");
    return `<svg viewBox="0 0 4 4" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.45;z-index:5;">${lines}</svg>`;
  }

  function buildExportCardHtml(chart: TuViChart, name: string, timeLabel: string): string {
    const tapDieuByChi: string[][] = Array.from({ length: 12 }, () => []);
    for (const s of getTapDieu(chart)) {
      tapDieuByChi[s.chiIndex].push(s.name);
    }
    const chiToRowCol: Record<number, { row: number; col: number }> = {};
    for (const c of GRID_CELLS) chiToRowCol[c.chiIndex] = { row: c.row, col: c.col };

    // Yêu cầu Công: cung đang ở đúng Đại Vận hiện tại (theo tuổi/Năm xem) — chỉ có khi đã nhập Năm xem.
    const currentDaiVanChiIndex = chart.tuoiNamXem !== null
      ? chart.cungs.find((c) => chart.tuoiNamXem! >= c.daiVanTuoi[0] && chart.tuoiNamXem! <= c.daiVanTuoi[1])?.chiIndex
      : undefined;

    const cells = GRID_CELLS.map(({ chiIndex, row, col }) => {
      const p = chart.cungs[chiIndex];
      const tabs = tuanTrietTabsFor(chiIndex, chart, chiToRowCol);
      return `<div style="grid-row:${row};grid-column:${col};">${cellHtml(p, tapDieuByChi[chiIndex], tabs, chiIndex === currentDaiVanChiIndex)}</div>`;
    }).join("");

    const tuanChisAll = chart.cungs.filter((c) => c.tuan).map((c) => c.chiIndex);
    const trietChisAll = chart.cungs.filter((c) => c.triet).map((c) => c.chiIndex);
    const tuanTrietBridges =
      (tuanChisAll.length === 2 ? tuanTrietBridgeHtml(tuanChisAll[0], tuanChisAll[1], chiToRowCol, "TUẦN", LIGHT.gold, LIGHT.text) : "") +
      (trietChisAll.length === 2 ? tuanTrietBridgeHtml(trietChisAll[0], trietChisAll[1], chiToRowCol, "TRIỆT", "#2c4a7c", "#ffffff") : "");
    return `
      <div style="width:${CARD_WIDTH}px;height:${CARD_HEIGHT}px;font-family:Tahoma,'Segoe UI',Arial,sans-serif;background:${LIGHT.bg};color:${LIGHT.text};border:3px solid ${LIGHT.border};border-radius:16px;padding:14px;box-sizing:border-box;display:flex;flex-direction:column;">
        <div style="display:flex;align-items:center;gap:8px;border-bottom:2px solid ${LIGHT.border};padding-bottom:8px;flex-shrink:0;">
          <img src="/images/brand/zhi-gong-logo.png" style="width:32px;height:32px;border-radius:9999px;border:2px solid ${LIGHT.border};object-fit:cover;flex-shrink:0;" />
          <div>
            <p style="margin:0;font-size:14px;font-weight:800;letter-spacing:.02em;color:${LIGHT.red};">PHONGTHUYTHIENANH.COM</p>
            <p style="margin:0;font-size:9px;font-weight:700;letter-spacing:.04em;color:${LIGHT.textMuted};">LÁ SỐ TỬ VI ĐẨU SỐ</p>
          </div>
        </div>
        <div style="position:relative;flex:1;min-height:0;margin-top:8px;display:grid;grid-template-columns:repeat(4, 1fr);grid-template-rows:repeat(4, 1fr);gap:4px;">
          ${cells}
          ${centerPanelHtml(chart, name, timeLabel)}
          ${menhLinesHtml(chart, chiToRowCol)}
          ${tuanTrietBridges}
        </div>
        <p style="margin:6px 0 0;font-size:8px;color:${LIGHT.textMuted};text-align:center;flex-shrink:0;">Lập lá số Tử Vi tại Phong Thủy Thiên Anh — phongthuythienanh.com</p>
      </div>
    `;
  }

  async function waitForImagesToLoad(cardEl: HTMLElement): Promise<void> {
    const imgs = Array.from(cardEl.querySelectorAll("img"));
    await Promise.all(
      imgs.map((img) => {
        if (img.complete && img.naturalWidth > 0) {
          return img.decode().catch(() => undefined);
        }
        return new Promise<void>((resolve) => {
          img.addEventListener("load", () => img.decode().then(() => resolve()).catch(() => resolve()), { once: true });
          img.addEventListener("error", () => resolve(), { once: true });
        });
      }),
    );
  }

  // Bảo vệ khỏi treo vô thời hạn nếu html-to-image không bao giờ resolve (đã quan sát được trong thực
  // tế: toPng() có thể không resolve/reject — không có lỗi nào được ném ra — khiến người dùng nhìn thấy
  // "Đang tạo ảnh…" mãi mãi mà không có phản hồi). Đây là fix UI thuần túy (thêm timeout + fallback
  // hiển thị), KHÔNG đụng đến engine/rule tính toán lá số.
  function withTimeout<T>(promise: Promise<T>, ms: number, message: string): Promise<T> {
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject(new Error(message)), ms);
      promise.then(
        (value) => { clearTimeout(timer); resolve(value); },
        (err) => { clearTimeout(timer); reject(err); },
      );
    });
  }

  async function captureCardAsPng(cardEl: HTMLElement): Promise<string> {
    const { toPng } = await import("html-to-image");
    await waitForImagesToLoad(cardEl);
    return await toPng(cardEl, { backgroundColor: LIGHT.bg, pixelRatio: 2, skipFonts: true, width: CARD_WIDTH, height: CARD_HEIGHT });
  }

  document.getElementById("form-tuvi")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = (document.getElementById("tv-name") as HTMLInputElement).value.trim();
    const gender = (document.querySelector('input[name="tv-gender"]:checked') as HTMLInputElement).value as "Nam" | "Nữ";
    const isLunar = (document.getElementById("tv-lunar") as HTMLInputElement).checked;
    const hour = parseInt(hourSel.value, 10);
    // Validation UI (khớp min/max đặt ở frontmatter — VIEWING_YEAR_MIN=1900/VIEWING_YEAR_MAX=nowYear+10):
    // phòng trường hợp trình duyệt không chặn được giá trị vô lý (vd. gõ tay bỏ qua spinner), tự bỏ qua
    // thay vì để tuổi/Đại Vận hiển thị sai lệch. Không đụng thuật toán lịch/engine.
    const rawViewingYear = parseInt(viewingYearInput.value, 10);
    const viewingYear = (rawViewingYear && rawViewingYear >= 1900 && rawViewingYear <= nowYear + 10) ? rawViewingYear : undefined;
    let day = parseInt(daySel.value, 10);
    let month = parseInt(monthSel.value, 10);
    let year = parseInt(yearSel.value, 10);

    const submitBtn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const loadingEl = document.getElementById("tv-loading")!;
    const imgEl = document.getElementById("tv-preview-img") as HTMLImageElement;
    const saveRowEl = document.getElementById("tv-save-row")!;

    try {
      if (isLunar) {
        const solar = lunarToSolar(day, month, year);
        day = solar.d;
        month = solar.m;
        year = solar.y;
      }
      const chart = tinhTuVi({ day, month, year, hour, gender, viewingYear });
      const pad = (n: number) => String(n).padStart(2, "0");
      const timeLabel = `${pad(day)}/${pad(month)}/${year}`;

      const resultEl = document.getElementById("result-tuvi")!;
      const cardEl = document.getElementById("tv-card")!;
      cardEl.innerHTML = buildExportCardHtml(chart, name, timeLabel);
      resultEl.classList.remove("hidden");
      loadingEl.classList.remove("hidden");
      loadingEl.textContent = "Đang tạo ảnh lá số…";
      imgEl.classList.add("hidden");
      saveRowEl.classList.add("hidden");
      saveRowEl.classList.remove("flex");
      if (submitBtn) submitBtn.disabled = true;
      resultEl.scrollIntoView({ behavior: "smooth", block: "nearest" });

      try {
        const dataUrl = await withTimeout(captureCardAsPng(cardEl), 15000, "Quá thời gian tạo ảnh (15s)");
        imgEl.src = dataUrl;
        imgEl.classList.remove("hidden");
        loadingEl.classList.add("hidden");
        saveRowEl.classList.remove("hidden");
        saveRowEl.classList.add("flex");
        const saveBtn = document.getElementById("tv-save-image") as HTMLButtonElement;
        saveBtn.onclick = () => {
          const link = document.createElement("a");
          link.download = `tu-vi-${year}-${pad(month)}-${pad(day)}.png`;
          link.href = dataUrl;
          link.click();
        };
      } catch (err) {
        console.error("Không tạo được ảnh lá số:", err);
        loadingEl.textContent = "Đã lập lá số xong nhưng không tạo được ảnh xuất. Bạn có thể thử lập lại lá số để tạo ảnh lần nữa.";
      }
    } catch (err) {
      console.error(err);
      alert("Không lập được lá số, vui lòng kiểm tra lại thông tin đã nhập.");
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
