---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { siteConfig } from "../lib/site-config";
import { getCourseBySlug } from "../lib/cms/queries";

export const prerender = false;

const status = Astro.url.searchParams.get("status");
const courseSlug = Astro.url.searchParams.get("khoa-hoc");
const requestedCourse = courseSlug ? await getCourseBySlug(courseSlug) : null;
const prefilledMessage = requestedCourse
  ? `Tôi muốn đăng ký khóa học "${requestedCourse.name}". Vui lòng liên hệ tư vấn lịch học.`
  : "";
---

<BaseLayout title="Liên hệ / Đặt lịch tư vấn" description="Liên hệ và đặt lịch tư vấn phong thủy cùng Thiên Anh.">
  <PageHero
    eyebrow="Liên hệ"
    title="Đặt lịch tư vấn"
    description="Để lại thông tin, đội ngũ Thiên Anh sẽ liên hệ tư vấn trong vòng 24 giờ làm việc."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Liên hệ" }]}
  />

  <Container class="grid gap-10 py-16 lg:grid-cols-5">
    <div class="lg:col-span-3">
      {status === "success" && (
        <div class="mb-5 flex items-center gap-2.5 rounded-(--radius-control) border border-(--color-success-500)/30 bg-(--color-success-500)/10 px-4 py-3 text-sm text-(--color-success-500)">
          <Icon name="check-circle" class="size-5 shrink-0" />
          Cảm ơn bạn đã gửi yêu cầu! Thiên Anh sẽ liên hệ lại trong vòng 24 giờ làm việc.
        </div>
      )}
      {status === "error" && (
        <div class="mb-5 rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-4 py-3 text-sm text-(--color-danger-500)">
          Vui lòng điền đầy đủ Họ tên và Số điện thoại.
        </div>
      )}
      <form
        id="contact-form"
        method="post"
        action="/api/contact/submit"
        class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-(--color-ink-800)">Họ và tên <span class="text-(--color-danger-500)">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20" />
          </div>
          <div>
            <label for="phone" class="text-sm font-medium text-(--color-ink-800)">Số điện thoại <span class="text-(--color-danger-500)">*</span></label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20" />
          </div>
        </div>

        <div class="mt-5">
          <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
          <input id="email" name="email" type="email" autocomplete="email"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20" />
        </div>

        <div class="mt-5">
          <label for="topic" class="text-sm font-medium text-(--color-ink-800)">Nhu cầu tư vấn</label>
          <select id="topic" name="topic"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20">
            <option>Phong thủy nhà ở</option>
            <option>Phong thủy nhà chuyên sâu</option>
            <option>Phong thủy văn phòng</option>
            <option>Xem ngày cao cấp</option>
            <option>Bát tự</option>
            <option selected={!!requestedCourse}>Đăng ký khóa học</option>
            <option>Khác</option>
          </select>
        </div>

        <div class="mt-5">
          <label for="message" class="text-sm font-medium text-(--color-ink-800)">Nội dung cần tư vấn</label>
          <textarea id="message" name="message" rows="4"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20">{prefilledMessage}</textarea>
        </div>

        <!-- honeypot chống spam bot, ẩn với người dùng thật -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <Button type="submit" size="lg" class="mt-6 w-full sm:w-auto">Gửi yêu cầu tư vấn</Button>
        <p class="mt-3 text-xs text-(--color-ink-600)">Bằng việc gửi form, bạn đồng ý để Thiên Anh liên hệ tư vấn qua số điện thoại/email đã cung cấp.</p>
      </form>
    </div>

    <aside class="lg:col-span-2">
      <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <h2 class="font-display text-lg font-semibold text-(--color-ink-950)">Thông tin liên hệ</h2>
        <ul class="mt-4 space-y-4 text-sm text-(--color-ink-700)">
          <li class="flex items-start gap-3">
            <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-(--color-gold-400)" />
            {siteConfig.address}
          </li>
          <li class="flex items-center gap-3">
            <Icon name="phone" class="size-5 shrink-0 text-(--color-gold-400)" />
            <a href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`} class="hover:underline">{siteConfig.hotline}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mail" class="size-5 shrink-0 text-(--color-gold-400)" />
            <a href={`mailto:${siteConfig.email}`} class="hover:underline">{siteConfig.email}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="clock" class="size-5 shrink-0 text-(--color-gold-400)" />
            {siteConfig.workingHours}
          </li>
        </ul>
      </div>

      <div class="mt-5 aspect-4/3 overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
        <!-- TODO: nhúng Google Maps địa chỉ thật -->
      </div>
    </aside>
  </Container>
</BaseLayout>
