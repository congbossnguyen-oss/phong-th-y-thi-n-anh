---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { siteConfig } from "../lib/site-config";
import { getCourseBySlug } from "../lib/cms/queries";

export const prerender = false;

const courseSlug = Astro.url.searchParams.get("khoa-hoc");
const requestedCourse = courseSlug ? await getCourseBySlug(courseSlug) : null;
const topicParam = Astro.url.searchParams.get("topic");
const isTrungTangTopic = topicParam === "trung-tang";
const prefilledMessage = requestedCourse
  ? `Tôi muốn đăng ký khóa học "${requestedCourse.name}". Vui lòng liên hệ tư vấn lịch học.`
  : isTrungTangTopic
    ? "Tôi muốn được tư vấn trực tiếp về Trùng Tang — chọn giờ liệm/hạ huyệt và phương án hóa giải phù hợp cho người thân."
    : "";
---

<BaseLayout title="Liên hệ / Đặt lịch tư vấn" description="Liên hệ và đặt lịch tư vấn phong thủy cùng Thiên Anh.">
  <PageHero
    eyebrow="Liên hệ"
    title="Đặt lịch tư vấn"
    description="Để lại thông tin, đội ngũ Thiên Anh sẽ liên hệ tư vấn trong vòng 24 giờ làm việc."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Liên hệ" }]}
  />

  <Container class="grid gap-10 py-16 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <div id="form-success" class="mb-5 hidden items-center gap-2.5 rounded-(--radius-control) border border-(--color-success-500)/30 bg-(--color-success-500)/10 px-4 py-3 text-sm text-(--color-success-500)">
        <Icon name="check-circle" class="size-5 shrink-0" />
        Cảm ơn bạn đã gửi yêu cầu! Thiên Anh sẽ liên hệ lại trong vòng 24 giờ làm việc.
      </div>
      <div id="form-error" class="mb-5 hidden rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-4 py-3 text-sm text-(--color-danger-500)">
        <span id="form-error-text">Vui lòng điền đầy đủ Họ tên và Số điện thoại.</span>
      </div>
      <form
        id="contact-form"
        class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-(--color-ink-800)">Họ và tên <span class="text-(--color-danger-500)">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" maxlength="100"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20" />
          </div>
          <div>
            <label for="phone" class="text-sm font-medium text-(--color-ink-800)">Số điện thoại <span class="text-(--color-danger-500)">*</span></label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" maxlength="20"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20" />
          </div>
        </div>

        <div class="mt-5">
          <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="150"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20" />
        </div>

        <div class="mt-5">
          <label for="topic" class="text-sm font-medium text-(--color-ink-800)">Nhu cầu tư vấn</label>
          <select id="topic" name="topic"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20">
            <option>Phong thủy nhà ở</option>
            <option>Phong thủy nhà chuyên sâu</option>
            <option>Phong thủy văn phòng</option>
            <option>Xem ngày cao cấp</option>
            <option>Bát tự</option>
            <option selected={isTrungTangTopic}>Trùng Tang — chọn giờ liệm/hạ huyệt</option>
            <option selected={!!requestedCourse}>Đăng ký khóa học</option>
            <option>Khác</option>
          </select>
        </div>

        <div class="mt-5">
          <label for="message" class="text-sm font-medium text-(--color-ink-800)">Nội dung cần tư vấn</label>
          <textarea id="message" name="message" rows="4" maxlength="3000"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm text-(--color-ink-950) focus:border-(--color-gold-400) focus:outline-none focus:ring-2 focus:ring-(--color-gold-400)/20">{prefilledMessage}</textarea>
        </div>

        <!-- honeypot chống spam bot, ẩn với người dùng thật -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <Button type="submit" size="lg" class="mt-6 w-full sm:w-auto">Gửi yêu cầu tư vấn</Button>
        <p class="mt-3 text-xs text-(--color-ink-600)">Bằng việc gửi form, bạn đồng ý để Thiên Anh liên hệ tư vấn qua số điện thoại/email đã cung cấp.</p>
      </form>
    </div>

    <aside class="lg:col-span-2">
      <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <h2 class="font-display text-lg font-semibold text-(--color-ink-950)">Thông tin liên hệ</h2>
        <ul class="mt-4 space-y-4 text-sm text-(--color-ink-700)">
          <li class="flex items-start gap-3">
            <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-(--color-gold-400)" />
            {siteConfig.address}
          </li>
          <li class="flex items-center gap-3">
            <Icon name="phone" class="size-5 shrink-0 text-(--color-gold-400)" />
            <a href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`} class="hover:underline">{siteConfig.hotline}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mail" class="size-5 shrink-0 text-(--color-gold-400)" />
            <a href={`mailto:${siteConfig.email}`} class="hover:underline">{siteConfig.email}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="clock" class="size-5 shrink-0 text-(--color-gold-400)" />
            {siteConfig.workingHours}
          </li>
        </ul>
      </div>

      <div class="mt-5 aspect-4/3 overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
        <iframe
          title={`Bản đồ ${siteConfig.name} — ${siteConfig.address}`}
          src={`https://www.google.com/maps?q=${encodeURIComponent(siteConfig.address)}&output=embed`}
          class="h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </aside>
  </Container>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const successBox = document.getElementById("form-success");
    const errorBox = document.getElementById("form-error");
    const errorText = document.getElementById("form-error-text");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      successBox?.classList.remove("flex");
      successBox?.classList.add("hidden");
      errorBox?.classList.add("hidden");

      const data = new FormData(form);

      // Honeypot: bot thường điền cả field ẩn này, người dùng thật để trống — âm thầm
      // giả vờ thành công, không gọi API thật, để không lộ cho bot biết bị chặn.
      if (data.get("website")) {
        successBox?.classList.remove("hidden");
        successBox?.classList.add("flex");
        form.reset();
        return;
      }

      const name = data.get("name")?.toString().trim();
      const phone = data.get("phone")?.toString().trim();

      if (!name || !phone) {
        if (errorText) errorText.textContent = "Vui lòng điền đầy đủ Họ tên và Số điện thoại.";
        errorBox?.classList.remove("hidden");
        return;
      }

      // Validate email nếu có nhập (khớp kiểm tra phía server). type=email không tự chạy vì đã
      // preventDefault. maxlength trên input đã chặn độ dài, đây chỉ kiểm định dạng.
      const emailVal = data.get("email")?.toString().trim() || "";
      if (emailVal && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        if (errorText) errorText.textContent = "Email không đúng định dạng. Vui lòng kiểm tra lại.";
        errorBox?.classList.remove("hidden");
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) submitButton.disabled = true;

      try {
        const res = await fetch("/api/contact/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            phone,
            email: data.get("email")?.toString().trim() || null,
            topic: data.get("topic")?.toString().trim() || null,
            message: data.get("message")?.toString().trim() || null,
          }),
        });
        const json = await res.json().catch(() => null);

        if (res.ok && json?.ok) {
          successBox?.classList.remove("hidden");
          successBox?.classList.add("flex");
          form.reset();
        } else {
          if (errorText) errorText.textContent = "Có lỗi xảy ra, vui lòng thử lại hoặc gọi hotline.";
          errorBox?.classList.remove("hidden");
        }
      } catch {
        if (errorText) errorText.textContent = "Không thể kết nối, vui lòng kiểm tra mạng và thử lại.";
        errorBox?.classList.remove("hidden");
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
