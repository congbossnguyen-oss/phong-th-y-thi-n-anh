---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";

export const prerender = true;
---

<BaseLayout
  title="Con Số May Mắn 00–99"
  description="Quét toàn bộ 100 số từ 00 đến 99, chấm điểm theo Ngũ Hành bản mệnh, cấu trúc cặp số và Nạp Âm ngày, trả về 3 con số may mắn nhất cho một ngày cụ thể."
  appShell
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Con Số May Mắn 00–99"
    description="Nhập năm sinh và ngày cần xem — hệ thống tự quét cả 100 số, chấm điểm và xếp hạng, không dùng bảng số cố định."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Con Số May Mắn 00–99" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-xs text-(--color-ink-600)">
        Công cụ xếp hạng con số theo hệ thống phong thủy số đã cấu hình (Ngũ Hành số theo Hà Đồ/Lạc Thư, cấu trúc cặp
        số, Nạp Âm ngày) — không phải bằng chứng khoa học về khả năng một con số tạo ra may mắn. Riêng tiêu chí Cung
        Mệnh và Trạch Cát ngày chưa được tính do hệ thống chưa có đủ dữ liệu.
      </div>

      <form id="csmm-form" class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <div>
          <label for="csmm-nam-sinh" class="text-xs font-medium text-(--color-ink-600)">Năm sinh (dương lịch)</label>
          <input type="number" id="csmm-nam-sinh" min="1900" max="2100" required placeholder="1996" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
        <div class="mt-3">
          <DateSelect idPrefix="csmm-ngay-tinh" label="Ngày tính" />
        </div>
        <div class="mt-3">
          <label for="csmm-muc-dich" class="text-xs font-medium text-(--color-ink-600)">Mục đích</label>
          <select id="csmm-muc-dich" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="TONG_VAN">Tổng vận</option>
            <option value="TAI_LOC">Tài lộc</option>
            <option value="CONG_VIEC">Công việc</option>
            <option value="GIAO_TIEP">Giao tiếp</option>
            <option value="TINH_CAM">Tình cảm</option>
          </select>
        </div>
        <Button type="submit" size="lg" class="mt-4 w-full">Tìm số may mắn</Button>
      </form>

      <div id="csmm-loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

      <div id="csmm-ket-qua" class="mt-4 hidden space-y-2"></div>
    </div>
  </Container>
  <BottomNav />
</BaseLayout>

<script>
  import { readDateSelects } from "../../lib/date-select";

  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface LuckyNumberSimpleResult { diem: number; moTa: string }
  interface CauTrucCapSoResult { diem: number; moTa: string }
  interface LuckyNumberResult {
    soMay: number;
    nhan: string;
    diem: number;
    banMenh: LuckyNumberSimpleResult;
    cauTrucCapSo: CauTrucCapSoResult;
    ngay: LuckyNumberSimpleResult;
  }

  const form = document.getElementById("csmm-form") as HTMLFormElement;
  const loiEl = document.getElementById("csmm-loi")!;
  const ketQuaEl = document.getElementById("csmm-ket-qua")!;

  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const namSinh = (document.getElementById("csmm-nam-sinh") as HTMLInputElement).value;
    const ngayTinh = readDateSelects("csmm-ngay-tinh");
    const purpose = (document.getElementById("csmm-muc-dich") as HTMLSelectElement).value;

    if (!ngayTinh) {
      loiEl.textContent = "Vui lòng chọn đầy đủ ngày tính.";
      loiEl.classList.remove("hidden");
      return;
    }
    const { year, month, day } = ngayTinh;

    try {
      const res = await fetch(`/api/con-so-may-man?namSinh=${namSinh}&day=${day}&month=${month}&year=${year}&purpose=${purpose}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const results = data.results as LuckyNumberResult[];
      ketQuaEl.innerHTML = results
        .map((r, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-4">
            <div class="flex items-center justify-between">
              <p class="font-display text-2xl font-bold text-(--color-ink-950)">${huyChuong} ${nhanDotHtml(r.nhan)}</p>
              <p class="text-sm font-semibold text-(--color-gold-400)">⭐ ${r.diem}/10</p>
            </div>
            <div class="mt-2 space-y-0.5 text-xs text-(--color-ink-500)">
              <p>Bản mệnh: ${r.banMenh.moTa}</p>
              <p>Cấu trúc cặp số: ${r.cauTrucCapSo.moTa}</p>
              <p>Ngày: ${r.ngay.moTa}</p>
            </div>
          </div>`;
        })
        .join("");
      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
