    eyebrow="Đại Cát Lợi"
    title="Chọn Năm Sinh Con"
    description="Nhập năm sinh cha, năm sinh mẹ, giới tính con và khoảng năm muốn xem — hệ thống tự tính Cha→Con, Mẹ→Con và xếp hạng năm tốt nhất."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Chọn Năm Sinh Con" }]}
  />

  <ChonNamSinhCon />
