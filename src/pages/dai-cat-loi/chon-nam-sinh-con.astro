---
// TRANG "Chọn Năm Sinh Con" (bản web) — chỉ lo khung trang (SEO/PageHero/breadcrumbs); toàn bộ
// công cụ nằm ở component dùng chung `ChonNamSinhCon.astro`, cũng được bản in-app Quân Sư
// (`/quan-su/chon-nam-sinh-con`) tái sử dụng.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import ChonNamSinhCon from "../../components/tools/ChonNamSinhCon.astro";

export const prerender = true;
---

<BaseLayout
  title="Chọn Năm Sinh Con"
  description="Tìm năm sinh con phù hợp nhất với cả cha và mẹ theo Mệnh, Thiên Can, Địa Chi, Cung Mệnh Bát Trạch và Niên Mệnh — quét 1 khoảng năm, xếp hạng, không hard-code."
>
