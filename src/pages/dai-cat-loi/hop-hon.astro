---
// TRANG DỊCH VỤ VIP "Hợp Hôn Bát Tự × Tử Vi" (bản web) — chỉ lo khung trang (SEO/PageHero/
// breadcrumbs); toàn bộ logic form/thanh toán/kết quả nằm ở component dùng chung `HopHon.astro`,
// cũng được bản in-app Quân Sư (`/quan-su/hop-hon`) tái sử dụng y hệt.
//
// ✅ ĐÃ MỞ BÁN (1/9/2026) — khoá admin trước đây nằm trong component + API checkout, đã gỡ ở cả
// hai chỗ đó.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import HopHon from "../../components/tools/HopHon.astro";

export const prerender = false;

const TOOL_PRICE_LABEL = dinhDangTien(GIA_CONG_CU["hop-hon"]);
---

<BaseLayout
  title="Hợp Hôn Bát Tự × Tử Vi"
  description="Tầng luận sâu cho việc kết hôn: đối chiếu đủ hai lá số qua 5 trục — bổ khuyết ngũ hành hai chiều, Cung Phu Thê và sao phối ngẫu, tính cách qua Thập Thần, Tứ Hóa giao thoa bên Tử Vi, và mức đồng bộ vận trình. Trả bản đồ điểm mạnh và điểm cần vun đắp, không chấm điểm phán quyết."
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Hợp Hôn Bát Tự × Tử Vi"
    description={`Chạy tiếp sau vòng xem tuổi theo năm sinh — đối chiếu đủ hai lá số qua 5 trục. Phí ${TOOL_PRICE_LABEL}/lượt.`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Hợp Hôn" },
    ]}
  />

  <HopHon />

  {/* Liên kết ngữ cảnh sang bản luận sâu của TỪNG hệ. Công cụ trên đối chiếu hai hệ với nhau;
      khách muốn đọc trọn một hệ thì phải có đường đi tới, nếu không hai trang đó gần như không
      ai vào được ngoài lối trực tiếp. */}
  <Container class="pb-16">
    <aside class="mx-auto max-w-4xl rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-6">
      <p class="font-display text-lg font-bold text-(--color-ink-950)">Muốn đọc sâu từng lá số?</p>
      <p class="mt-2 text-sm leading-relaxed text-(--color-ink-700)">
        Bản Hợp Hôn ở trên đối chiếu hai lá số của hai người theo 5 trục. Đọc trọn một hệ tại
        <a href="/dai-cat-loi/luan-giai-bat-tu-toan-dien" class="font-semibold text-(--color-gold-700) hover:underline">Luận Giải Bát Tự Toàn Diện</a>
        hoặc
        <a href="/dai-cat-loi/luan-giai-tu-vi" class="font-semibold text-(--color-gold-700) hover:underline">Luận Giải Tử Vi</a>.
      </p>
    </aside>
  </Container>
</BaseLayout>
