---
// TRANG DỊCH VỤ VIP "Hợp Hôn Bát Tự × Tử Vi" — 999.000đ.
//  - Chưa có ?orderCode → FORM nhập ngày giờ sinh của CẢ HAI người + thanh toán QR.
//  - Có ?orderCode đã confirmed → server tính (tinhHopHon, thuần công thức) và hiện bản đồ 5 trục.
//
// ⏸️ THỬ NGHIỆM NỘI BỘ: chủ đề nhạy cảm nhất trong bộ — khách thường thấy thông báo, chỉ admin dùng
// được. Cả trang này và API checkout đều khóa; mở bán thì gỡ ở CẢ HAI chỗ.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import { getOrderByCode } from "../../lib/db/orders";
import { tinhHopHon, diemRadarTheoTruc, diemVongTron, type HopHonKetQua } from "../../lib/hop-hon";
import type { DauVaoHopHon } from "../api/dai-cat-loi/hop-hon/checkout";

export const prerender = false;

const laQuanTri = Astro.locals.user?.isAdmin === true;
const TOOL_SLUG = "hop-hon";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);

const orderCode = Astro.url.searchParams.get("orderCode");
let ketQua: HopHonKetQua | null = null;
let loiTinh: string | null = null;
if (orderCode) {
  const order = await getOrderByCode(orderCode);
  if (order && order.orderType === "tool" && order.toolSlug === TOOL_SLUG && order.status === "confirmed" && order.toolInputSnapshot) {
    try {
      ketQua = tinhHopHon(JSON.parse(order.toolInputSnapshot) as DauVaoHopHon);
    } catch (err) {
      loiTinh = err instanceof Error ? err.message : "Không tính được kết quả từ dữ liệu đã lưu.";
    }
  }
}

// Màu theo mức — dùng biến CSS sẵn có nên tự đảo đúng theo theme sáng/tối.
const MUC_STYLE: Record<string, { nhan: string; mau: string }> = {
  rat_thuan: { nhan: "Rất thuận", mau: "var(--color-success-500)" },
  thuan: { nhan: "Thuận", mau: "var(--color-success-500)" },
  can_dieu_chinh: { nhan: "Cần chủ động điều chỉnh", mau: "var(--color-gold-400)" },
  can_can_nhac: { nhan: "Cần luận kỹ", mau: "var(--color-cinnabar-500)" },
  khong_du_du_lieu: { nhan: "Chưa đủ dữ liệu", mau: "var(--color-ink-500)" },
};
const DONG_THUAN_STYLE: Record<string, string> = {
  cao: "var(--color-success-500)",
  trung: "var(--color-gold-400)",
  thap: "var(--color-cinnabar-500)",
  chua_du_du_lieu: "var(--color-ink-500)",
};
const gioOptions = Array.from({ length: 24 }, (_, i) => i);
const namNay = new Date().getFullYear();

/**
 * Dựng SVG radar ngũ giác "Bản đồ 5 trục" — server-render (không JS phía client), quy đổi từ đúng
 * hình học dùng chung `diemRadarTheoTruc`/`diemVongTron` nên khớp 100% với bản trong PDF.
 */
function veRadarSvg(ketQua: HopHonKetQua): string {
  const TAM = 165;
  const BAN_KINH = 118;
  const diems = diemRadarTheoTruc(ketQua.cacTruc);
  // SVG trục y hướng XUỐNG — trừ dy để "lên" (ngược math convention của radar.ts).
  const toaDo = (goc: number, tyLe: number) => {
    const { dx, dy } = diemVongTron(goc, tyLe);
    return { x: TAM + dx * BAN_KINH, y: TAM - dy * BAN_KINH };
  };

  const vongLuoi = [0.25, 0.5, 0.75, 1].map((tyLe) => {
    const pts = diems.map((d) => toaDo(d.goc, tyLe)).map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
    return `<polygon points="${pts}" fill="none" stroke="var(--color-ivory-300)" stroke-width="1" />`;
  }).join("");

  const truc = diems.map((d) => {
    const ngoai = toaDo(d.goc, 1);
    return `<line x1="${TAM}" y1="${TAM}" x2="${ngoai.x.toFixed(1)}" y2="${ngoai.y.toFixed(1)}" stroke="var(--color-ivory-300)" stroke-width="1" />`;
  }).join("");

  const duLieuPts = diems.map((d) => toaDo(d.goc, d.tyLe)).map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
  const vungDuLieu = `<polygon points="${duLieuPts}" fill="var(--color-gold-400)" fill-opacity="0.16" stroke="var(--color-gold-400)" stroke-width="2" stroke-linejoin="round" />`;

  const cham = diems.map((d) => {
    const p = toaDo(d.goc, d.tyLe);
    const mau = MUC_STYLE[d.muc].mau;
    return `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="5" fill="${mau}" stroke="var(--color-ivory-50)" stroke-width="1.5" />`;
  }).join("");

  const nhan = diems.map((d) => {
    const p = toaDo(d.goc, 1.24);
    const { dx } = diemVongTron(d.goc, 1);
    const canh = dx > 0.3 ? "start" : dx < -0.3 ? "end" : "middle";
    return `<text x="${p.x.toFixed(1)}" y="${p.y.toFixed(1)}" text-anchor="${canh}" dominant-baseline="middle" font-size="11" font-weight="600" fill="var(--color-ink-800)">${escHtml(d.ten)}</text>`;
  }).join("");

  return `<svg viewBox="0 0 330 330" role="img" aria-label="Bản đồ 5 trục hợp hôn" style="width:100%;max-width:360px;margin:0 auto;display:block;">${vongLuoi}${truc}${vungDuLieu}${cham}${nhan}</svg>`;
}
function escHtml(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
const radarSvg = ketQua ? veRadarSvg(ketQua) : "";
---

<BaseLayout
  title="Hợp Hôn Bát Tự × Tử Vi"
  description="Tầng luận sâu cho việc kết hôn: đối chiếu đủ hai lá số qua 5 trục — bổ khuyết ngũ hành hai chiều, Cung Phu Thê và sao phối ngẫu, tính cách qua Thập Thần, Tứ Hóa giao thoa bên Tử Vi, và mức đồng bộ vận trình. Trả bản đồ điểm mạnh và điểm cần vun đắp, không chấm điểm phán quyết."
  noIndex
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Hợp Hôn Bát Tự × Tử Vi"
    description={`Chạy tiếp sau vòng xem tuổi theo năm sinh — đối chiếu đủ hai lá số qua 5 trục. Phí ${TOOL_PRICE_LABEL}/lượt.`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Hợp Hôn" },
    ]}
  />

  <Container class="py-10">
    <div class="mx-auto max-w-4xl">

      {!laQuanTri && (
        <div class="rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-6">
          <p class="font-display text-xl font-bold text-(--color-ink-950)">Dịch vụ đang hoàn thiện</p>
          <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">
            Hợp Hôn là dịch vụ nhạy cảm nhất trong bộ công cụ của Thiên Anh, nên chúng tôi đang kiểm chứng
            kỹ trước khi mở rộng. Trong lúc chờ, mời bạn liên hệ hotline để được chuyên gia luận trực tiếp
            trên chính hai lá số của hai bạn.
          </p>
          <a href="/dai-cat-loi/chon-tuoi-ket-hon" class="mt-4 inline-flex rounded-(--radius-control) border border-(--color-gold-400) px-4 py-2.5 text-sm font-semibold text-(--color-gold-400) hover:bg-(--color-gold-400)/10">
            Xem trước công cụ Chọn Tuổi Kết Hôn (miễn phí, theo năm sinh)
          </a>
        </div>
      )}

      {laQuanTri && loiTinh && (
        <div class="mb-6 rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)">
          {loiTinh}
        </div>
      )}

      {/* ---------------- KẾT QUẢ ---------------- */}
      {laQuanTri && ketQua && (
        <div>
          {/* Tổng quan */}
          <div class="rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/8 p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-(--color-gold-400)">Tổng quan</p>
            <p class="mt-2 font-display text-3xl font-bold text-(--color-ink-950)">{ketQua.tenNhanTongQuan}</p>
            <p class="mt-3 text-sm leading-relaxed text-(--color-ink-800)">{ketQua.cauTongQuan}</p>
            <p class="mt-4 text-xs text-(--color-ink-500)">
              Bản đồ này KHÔNG chấm điểm số — mỗi trục được luận riêng, vì hôn nhân không quy về một con số được.
            </p>
          </div>

          {/* Hai lá số */}
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {[["Người thứ nhất", ketQua.laSoA], ["Người thứ hai", ketQua.laSoB]].map(([nhan, ls]: any) => (
              <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-(--color-ink-500)">{nhan}</p>
                <p class="mt-1.5 font-display text-base font-semibold text-(--color-ink-950)">{ls.tuTru}</p>
                <p class="mt-2 text-sm text-(--color-ink-700)">
                  Nhật Chủ <strong class="text-(--color-ink-950)">{ls.nhatChu}</strong> · Dụng Thần{" "}
                  <strong class="text-(--color-ink-950)">{ls.dungThan}</strong> · Hỷ {ls.hyThan} · Kỵ {ls.kyThan}
                </p>
                {!ls.gioSinhBiet && (
                  <p class="mt-2 text-xs text-(--color-gold-400)">⚠ Chưa có giờ sinh — kết quả ở mức tương đối, phần Tử Vi không chạy được.</p>
                )}
              </div>
            ))}
          </div>

          {/* Tầng 0 */}
          <div class="mt-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4">
            <p class="text-sm">
              <span class="font-semibold text-(--color-ink-950)">Vòng sơ loại theo năm sinh:</span>{" "}
              <span class="text-(--color-ink-800)">{ketQua.soLoaiNamSinh.nhan} ({ketQua.soLoaiNamSinh.diem}/10)</span>
            </p>
            <p class="mt-1.5 text-xs text-(--color-ink-500)">
              Tầng này chỉ đọc NĂM SINH (nạp âm, thiên can, địa chi, cung phi) nên hai người sinh cùng năm luôn ra
              cùng kết quả. Năm trục bên dưới mới là phần luận theo đủ lá số của từng người.
            </p>
          </div>

          {/* 5 trục */}
          <p class="mt-8 font-display text-2xl font-bold text-(--color-ink-950)">Bản đồ 5 trục</p>
          <div class="mt-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5" set:html={radarSvg} />
          <p class="mt-2 text-center text-xs text-(--color-ink-500)">
            Càng ra ngoài rìa càng thuận; "chưa đủ dữ liệu" đặt ở giữa (trung tính), không phải điểm xấu.
          </p>
          <div class="mt-4 space-y-4">
            {ketQua.cacTruc.map((t) => (
              <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5" style={`border-left:3px solid ${MUC_STYLE[t.muc].mau}`}>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <p class="font-display text-lg font-semibold text-(--color-ink-950)">{t.ten}</p>
                  <span class="rounded-(--radius-pill) px-2.5 py-0.5 text-xs font-bold" style={`color:${MUC_STYLE[t.muc].mau};background:color-mix(in srgb, ${MUC_STYLE[t.muc].mau} 16%, transparent)`}>
                    {MUC_STYLE[t.muc].nhan}
                  </span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">{t.tomTat}</p>
                {t.canCu.length > 0 && (
                  <ul class="mt-3 space-y-1.5">
                    {t.canCu.map((c) => (
                      <li class="text-xs leading-relaxed text-(--color-ink-700)">· {c}</li>
                    ))}
                  </ul>
                )}
                {t.dieuChinh && (
                  <p class="mt-3 rounded-(--radius-control) bg-(--color-gold-400)/10 px-3 py-2 text-xs leading-relaxed text-(--color-ink-800)">
                    <strong class="text-(--color-gold-400)">Nên làm:</strong> {t.dieuChinh}
                  </p>
                )}
              </div>
            ))}
          </div>

          {/* Đồng thuận 2 hệ */}
          <div class="mt-6 rounded-(--radius-card) border p-4" style={`border-color:color-mix(in srgb, ${DONG_THUAN_STYLE[ketQua.dongThuanHaiHe.muc]} 40%, transparent);background:color-mix(in srgb, ${DONG_THUAN_STYLE[ketQua.dongThuanHaiHe.muc]} 10%, transparent)`}>
            <p class="text-xs font-semibold uppercase tracking-wider" style={`color:${DONG_THUAN_STYLE[ketQua.dongThuanHaiHe.muc]}`}>
              Mức đồng thuận Bát Tự × Tử Vi
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-(--color-ink-800)">{ketQua.dongThuanHaiHe.moTa}</p>
          </div>

          {/* Điểm mạnh / cần điều chỉnh */}
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-(--radius-card) border border-(--color-success-500)/40 bg-(--color-success-500)/8 p-5">
              <p class="font-display text-base font-bold text-(--color-success-500)">Điểm mạnh của cặp này</p>
              <ul class="mt-2.5 space-y-2">
                {ketQua.diemManh.map((d) => <li class="text-sm leading-relaxed text-(--color-ink-800)">✓ {d}</li>)}
              </ul>
            </div>
            <div class="rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/8 p-5">
              <p class="font-display text-base font-bold text-(--color-gold-400)">Cần chủ động vun đắp</p>
              {ketQua.canDieuChinh.length > 0 ? (
                <ul class="mt-2.5 space-y-2">
                  {ketQua.canDieuChinh.map((d) => <li class="text-sm leading-relaxed text-(--color-ink-800)">→ {d}</li>)}
                </ul>
              ) : (
                <p class="mt-2.5 text-sm text-(--color-ink-800)">Không có điểm nào cần điều chỉnh gấp — giữ nếp hiện tại là được.</p>
              )}
            </div>
          </div>

          <p class="mt-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-xs leading-relaxed text-(--color-ink-700)">
            {ketQua.disclaimer}
          </p>

          <a href="/lien-he" class="mt-4 inline-flex rounded-(--radius-control) bg-(--color-cinnabar-500) px-5 py-3 text-sm font-semibold text-white hover:opacity-90">
            Đặt lịch để chuyên gia đọc bản đồ này cùng hai bạn
          </a>
        </div>
      )}

      {/* ---------------- FORM ---------------- */}
      {laQuanTri && !ketQua && (
        <div>
          <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
            <p class="font-display text-lg font-semibold text-(--color-ink-950)">Dịch vụ này cho bạn gì?</p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-(--color-ink-800)">
              <li>· Ngũ hành hai bên có bù đúng chỗ thiếu của nhau không — xét <strong>hai chiều riêng</strong>, chỉ ra cả trường hợp "một người gánh".</li>
              <li>· Cung Phu Thê và sao phối ngẫu — luận theo Dụng Thần từng người, nên <strong>hợp chưa chắc tốt, xung chưa chắc xấu</strong>.</li>
              <li>· Tính cách qua Thập Thần: cặp nào dễ va nhau về hành vi, và cách điều chỉnh cụ thể.</li>
              <li>· Bên Tử Vi: Cung Phu Thê, cộng hưởng Mệnh ↔ Phu Thê, và Tứ Hóa giao thoa giữa hai lá.</li>
              <li>· Mức đồng bộ vận trình 30 năm tới — có quãng nào cả hai cùng vào vận trầm không.</li>
            </ul>
            <p class="mt-3 text-xs text-(--color-ink-500)">
              Cần đủ ngày sinh của cả hai. Có giờ sinh thì mở thêm được phần Tử Vi; thiếu giờ vẫn chạy được các phần còn lại.
            </p>
          </div>

          <form id="hh-form" class="mt-6 space-y-5">
            {[["A", "Người thứ nhất"], ["B", "Người thứ hai"]].map(([ma, nhan]) => (
              <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
                <p class="font-display text-base font-semibold text-(--color-ink-950)">{nhan}</p>
                <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                  <input type="number" name={`${ma}-day`} min="1" max="31" placeholder="Ngày" required class="hh-input" />
                  <input type="number" name={`${ma}-month`} min="1" max="12" placeholder="Tháng" required class="hh-input" />
                  <input type="number" name={`${ma}-year`} min="1900" max={namNay} placeholder="Năm" required class="hh-input" />
                  <select name={`${ma}-gender`} required class="hh-input">
                    <option value="">Giới tính</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                  </select>
                </div>
                <div class="mt-3">
                  <select name={`${ma}-hour`} class="hh-input w-full">
                    <option value="">Giờ sinh (không bắt buộc — có thì mở thêm phần Tử Vi)</option>
                    {gioOptions.map((h) => <option value={h}>{h}h — {h}:00–{h}:59</option>)}
                  </select>
                </div>
              </div>
            ))}

            <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
              <p class="font-display text-base font-semibold text-(--color-ink-950)">Thông tin liên hệ</p>
              <div class="mt-3 space-y-3">
                <input type="text" name="customerName" placeholder="Họ tên người đặt" required class="hh-input w-full" />
                <input type="tel" name="customerPhone" placeholder="Số điện thoại" required class="hh-input w-full" />
                <input type="email" name="customerEmail" placeholder="Email (để nhận kết quả)" class="hh-input w-full" />
              </div>
            </div>

            <MaKhuyenMai idPrefix="hh-km" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />

            <Button type="submit" class="w-full">Thanh toán {TOOL_PRICE_LABEL} &amp; xem bản đồ hợp hôn</Button>
          </form>

          <div id="hh-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>
          <div id="hh-qr" class="mt-6 hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5 text-center"></div>
        </div>
      )}
    </div>
  </Container>
</BaseLayout>

<style>
  .hh-input {
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-50);
    color: var(--color-ink-900);
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
  }
  .hh-input:focus-visible {
    outline: 2px solid var(--color-gold-400);
    outline-offset: 1px;
  }
</style>

<script>
  const form = document.getElementById("hh-form") as HTMLFormElement | null;
  const loiEl = document.getElementById("hh-loi") as HTMLElement | null;
  const qrEl = document.getElementById("hh-qr") as HTMLElement | null;

  function docNguoi(fd: FormData, ma: string) {
    const gio = String(fd.get(`${ma}-hour`) ?? "");
    return {
      day: Number(fd.get(`${ma}-day`)),
      month: Number(fd.get(`${ma}-month`)),
      year: Number(fd.get(`${ma}-year`)),
      gender: String(fd.get(`${ma}-gender`) ?? ""),
      ...(gio !== "" ? { hour: Number(gio) } : {}),
    };
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!loiEl || !qrEl) return;
    loiEl.classList.add("hidden");
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = "Đang tạo đơn…"; }

    const fd = new FormData(form);
    // Quy ước của MaKhuyenMai.astro: trang tự đọc `${idPrefix}-input` rồi gửi lên dưới khóa maKhuyenMai.
    const maKM = (document.getElementById("hh-km-input") as HTMLInputElement | null)?.value ?? "";

    try {
      // Gửi JSON kèm Content-Type — form POST thuần bị chặn CSRF trong trình duyệt Zalo/Facebook.
      const res = await fetch("/api/dai-cat-loi/hop-hon/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nguoiA: docNguoi(fd, "A"),
          nguoiB: docNguoi(fd, "B"),
          customerName: fd.get("customerName"),
          customerPhone: fd.get("customerPhone"),
          customerEmail: fd.get("customerEmail"),
          maKhuyenMai: maKM,
        }),
      });
      const data = await res.json();
      if (!data.ok) {
        loiEl.textContent = data.error ?? "Không tạo được đơn hàng.";
        loiEl.classList.remove("hidden");
        return;
      }
      if (data.mienPhi) { window.location.href = `?orderCode=${data.orderCode}`; return; }
      qrEl.innerHTML = `
        <p class="font-display text-lg font-semibold text-(--color-ink-950)">Quét mã để thanh toán</p>
        <p class="mt-1 text-sm text-(--color-ink-700)">Mã đơn: <strong>${data.orderCode}</strong></p>
        <img src="${data.qrUrl}" alt="Mã QR thanh toán" class="mx-auto mt-3 max-w-xs rounded-(--radius-control)" />
        <p class="mt-3 text-xs text-(--color-ink-500)">Trang sẽ tự chuyển sang kết quả sau khi nhận được thanh toán.</p>`;
      qrEl.classList.remove("hidden");
      qrEl.scrollIntoView({ behavior: "smooth", block: "center" });

      const poll = setInterval(async () => {
        const r = await fetch(`/api/dai-cat-loi/hop-hon/result?orderCode=${encodeURIComponent(data.orderCode)}`)
          .then((x) => x.json())
          .catch(() => null);
        if (r?.status === "confirmed") { clearInterval(poll); window.location.href = `?orderCode=${data.orderCode}`; }
      }, 4000);
    } catch {
      loiEl.textContent = "Lỗi kết nối, vui lòng thử lại.";
      loiEl.classList.remove("hidden");
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = "Thanh toán & xem bản đồ hợp hôn"; }
    }
  });
</script>
