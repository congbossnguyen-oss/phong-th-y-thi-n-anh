---
// TRANG DỊCH VỤ VIP "Định Hướng Nghề Nghiệp (Bát Tự × Tử Vi)" (bản web) — chỉ lo khung trang
// (SEO/PageHero/breadcrumbs); toàn bộ logic form/thanh toán/kết quả nằm ở component dùng chung
// `DinhHuongNgheNghiep.astro`, cũng được bản in-app Quân Sư (`/quan-su/dinh-huong-nghe-nghiep`)
// tái sử dụng y hệt.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import DinhHuongNgheNghiep from "../../components/tools/DinhHuongNgheNghiep.astro";

export const prerender = false;

const TOOL_PRICE_LABEL = dinhDangTien(GIA_CONG_CU["dinh-huong-nghe-nghiep"]);
---

<BaseLayout
  title="Định Hướng Nghề Nghiệp — Bát Tự × Tử Vi"
  description="Định hướng nghề nghiệp kết hợp hai hệ Bát Tự và Tử Vi: 5 trục năng lực, xu hướng Quan Lộc/Kinh Doanh, nhóm ngành nên theo, các giai đoạn vận và mức đồng thuận giữa hai hệ. Dịch vụ VIP, trả kết quả kèm PDF về email."
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Định Hướng Nghề Nghiệp — Bát Tự × Tử Vi"
    description={`Kết hợp hai hệ độc lập Bát Tự và Tử Vi để định hướng nghề: 5 trục năng lực, nhóm ngành nên theo, các giai đoạn vận, và mức đồng thuận hai hệ. Phí ${TOOL_PRICE_LABEL}/lượt, thanh toán QR, kết quả gửi kèm PDF về email.`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Định Hướng Nghề Nghiệp" },
    ]}
  />

  <DinhHuongNgheNghiep />

  {/* Liên kết ngữ cảnh sang bản luận sâu của TỪNG hệ. Công cụ trên đối chiếu hai hệ với nhau;
      khách muốn đọc trọn một hệ thì phải có đường đi tới, nếu không hai trang đó gần như không
      ai vào được ngoài lối trực tiếp. */}
  <Container class="pb-16">
    <aside class="mx-auto max-w-4xl rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-6">
      <p class="font-display text-lg font-bold text-(--color-ink-950)">Muốn đọc sâu từng hệ?</p>
      <p class="mt-2 text-sm leading-relaxed text-(--color-ink-700)">
        Bản Định Hướng Nghề Nghiệp ở trên chỉ đọc hai hệ theo trục nghề nghiệp. Đọc trọn một hệ tại
        <a href="/dai-cat-loi/luan-giai-bat-tu-toan-dien" class="font-semibold text-(--color-gold-700) hover:underline">Luận Giải Bát Tự Toàn Diện</a>
        hoặc
        <a href="/dai-cat-loi/luan-giai-tu-vi" class="font-semibold text-(--color-gold-700) hover:underline">Luận Giải Tử Vi</a>.
      </p>
    </aside>
  </Container>
</BaseLayout>
