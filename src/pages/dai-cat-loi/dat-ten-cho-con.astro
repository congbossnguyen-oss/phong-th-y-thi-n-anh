---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { siteConfig } from "../../lib/site-config";
import { dinhDangTien, GIA_CONG_CU } from "../../lib/payments/gia-cong-cu";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";

// Render phía máy chủ (không prerender) để đọc được phiên đăng nhập — cần nhận diện tài khoản
// QUẢN TRỊ (test 0đ trọn luồng thật). Prerender thì Astro.locals.user luôn rỗng lúc build.
export const prerender = false;

const namNay = new Date().getFullYear();
const TOOL_SLUG = "dat-ten-cho-con";
const TOOL_PRICE = GIA_CONG_CU["dat-ten-cho-con"];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
const hotlineHref = `tel:${siteConfig.hotline.replace(/\s/g, "")}`;

// ĐÃ MỞ BÁN + THU PHÍ (chủ dự án chốt 2026-08-18): khách thanh toán thật qua QR; tài khoản quản
// trị được checkout-cong-cu tạo đơn 0đ tự xác nhận (cờ laQuanTri lấy từ phiên đăng nhập) nên vẫn
// test miễn phí trọn luồng. Không bắt đăng nhập với khách — orderCode làm "vé" mở kết quả.
const laQuanTri = Astro.locals.user?.isAdmin === true;
import DatTenChoCon from "../../components/tools/DatTenChoCon.astro";
---

<BaseLayout
  title="Đặt Tên Cho Con Theo Việt Danh Học"
  description="Từ ngày giờ sinh của bé, lập Tứ Trụ theo tiết khí, chỉ ra ngũ hành còn thiếu cần bổ, rồi gợi ý danh sách 20 tên đẹp hợp mệnh — mỗi tên chấm điểm theo Tứ Đại Cục 81 số. Kèm chức năng đánh giá tên bạn đã chọn. Dịch vụ VIP 499.000đ/lượt, thanh toán qua QR."
  appShell
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Đặt Tên Cho Con Theo Việt Danh Học"
    description="Nhập ngày giờ sinh của bé, hệ thống lập Tứ Trụ theo tiết khí, chỉ ra ngũ hành còn thiếu và gợi ý những cái tên đẹp hợp mệnh, chấm điểm theo Tứ Đại Cục."
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Đặt Tên Cho Con" },
    ]}
  />
  <VipQuyenBanner />

  <DatTenChoCon />
</BaseLayout>
