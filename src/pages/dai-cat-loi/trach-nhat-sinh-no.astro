---
// TRANG DỊCH VỤ VIP "Trạch Nhật Sinh Nở — Chọn Ngày Giờ Sinh Cho Bé" (bản web) — chỉ lo khung
// trang (SEO/PageHero/breadcrumbs); toàn bộ logic form/thanh toán/kết quả nằm ở component dùng
// chung `TrachNhatSinhNo.astro`, cũng chính là component bản in-app Quân Sư
// (`/quan-su/trach-nhat-sinh-no`) dùng — nên hai nơi luôn ra CÙNG một kết quả, không thể lệch.
//
// 🧹 Đã dọn code chết (27/8/2026): frontmatter trước đây còn nguyên phần tính toán từ thời chưa
// tách component — `getOrderByCode()` + `phanTichTrachNhatSinhNo()` cùng ~15 import/biến không hề
// được markup dùng tới (markup chỉ dùng đúng `TOOL_PRICE_LABEL`). Chúng VẪN CHẠY mỗi lượt xem
// trang: thừa 1 truy vấn CSDL và thừa TRỌN một lượt phân tích Bát Tự + Tử Vi, xong vứt đi, rồi
// component tính lại lần nữa. Xoá đi là hết tính hai lần, KHÔNG đổi gì về hiển thị/kết quả.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";
import TrachNhatSinhNo from "../../components/tools/TrachNhatSinhNo.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";

export const prerender = false;

const TOOL_PRICE_LABEL = dinhDangTien(GIA_CONG_CU["trach-nhat-sinh-no"]);
---

<BaseLayout
  title="Chọn Ngày Giờ Sinh Cho Bé"
  description="Lập toàn bộ ứng viên trong khung dự sinh bác sĩ cho phép, kết hợp Bát Tự (xếp hạng ngày) và Tử Vi (chọn giờ) để đưa ra phương án ưu tiên kèm 2 phương án dự phòng, luôn nêu rõ khuyết điểm. Dịch vụ VIP, trả kết quả kèm PDF về email."
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Chọn Ngày Giờ Sinh Cho Bé"
    description={`Trạch nhật sinh nở — chọn ngày giờ sinh cho bé trong khung bác sĩ cho phép, kết hợp Bát Tự và Tử Vi làm hai lớp lọc độc lập, không cộng điểm chéo. Phí ${TOOL_PRICE_LABEL}/lượt, thanh toán QR, kết quả kèm PDF gửi về email.`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Chọn Ngày Giờ Sinh Cho Bé" },
    ]}
  />
  <VipQuyenBanner />

  <TrachNhatSinhNo />
</BaseLayout>
