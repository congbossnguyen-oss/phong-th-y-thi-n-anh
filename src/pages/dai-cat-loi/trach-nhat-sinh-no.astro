---
// TRANG DỊCH VỤ VIP "Trạch Nhật Sinh Nở — Chọn Ngày Giờ Sinh Cho Bé" — 499.000đ.
//  - Chưa có ?orderCode → hiện FORM khung ngày dự sinh + thanh toán QR (poll trạng thái).
//  - Có ?orderCode đã confirmed → server tính kết quả (thuần công thức, không AI) và hiện phương án.
// ⏸️ THỬ NGHIỆM NỘI BỘ: chỉ tài khoản quản trị thấy form/dùng được, khách thấy màn "đang thử nghiệm".
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import { getOrderByCode } from "../../lib/db/orders";
import { phanTichTrachNhatSinhNo, type BirthSelectionInput, type PhanTichTrachNhatKetQua } from "../../lib/trach-nhat-sinh-no";
import DoHinhUngVien from "../../components/trach-nhat-sinh-no/DoHinhUngVien.astro";
import TabBatTu from "../../components/trach-nhat-sinh-no/TabBatTu.astro";
import TabTuVi from "../../components/trach-nhat-sinh-no/TabTuVi.astro";
import TongQuanKetQua from "../../components/trach-nhat-sinh-no/TongQuanKetQua.astro";
import BangSoSanhPhuongAn from "../../components/trach-nhat-sinh-no/BangSoSanhPhuongAn.astro";
import { siteConfig } from "../../lib/site-config";

export const prerender = false;

const laQuanTri = Astro.locals.user?.isAdmin === true;
const TOOL_SLUG = "trach-nhat-sinh-no";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);

const orderCode = Astro.url.searchParams.get("orderCode");
let ketQua: PhanTichTrachNhatKetQua | null = null;
let order: Awaited<ReturnType<typeof getOrderByCode>> | null = null;
if (orderCode) {
  order = await getOrderByCode(orderCode);
  if (order && order.orderType === "tool" && order.toolSlug === TOOL_SLUG && order.status === "confirmed" && order.toolInputSnapshot) {
    try {
      ketQua = phanTichTrachNhatSinhNo(JSON.parse(order.toolInputSnapshot) as BirthSelectionInput);
    } catch {
      ketQua = null;
    }
  }
}

const r = ketQua?.recommendation ?? null;
/** Tra ứng viên đầy đủ từ id trên thẻ tóm tắt — để vẽ đồ hình cho CẢ phương án chính lẫn dự phòng. */
const timUngVien = (id: string | undefined) => (ketQua && id ? ketQua.tatCaUngVien.find((c) => c.id === id) ?? null : null);
const primaryCandidate = timUngVien(r?.primary?.candidateId);
const BAND_NHAN: Record<string, string> = {
  rat_thuan: "Rất thuận", thuan: "Thuận", trung_binh: "Trung bình", thu_thach: "Có thử thách", nghich: "Nghịch",
};
const HINH_THUC_SINH = [
  { value: "scheduled_c_section", label: "Mổ chủ động (bác sĩ cho khung giờ)" },
  { value: "labor", label: "Chờ chuyển dạ (sinh thường)" },
  { value: "unknown", label: "Chưa rõ" },
];
const UU_TIEN = [
  { value: "balanced", label: "Cân bằng mọi mặt" },
  { value: "health", label: "Sức khỏe" },
  { value: "wealth", label: "Tài vận" },
  { value: "career", label: "Công danh" },
  { value: "academic", label: "Học hành" },
];
---

<BaseLayout
  title="Chọn Ngày Giờ Sinh Cho Bé"
  description="Lập toàn bộ ứng viên trong khung dự sinh bác sĩ cho phép, kết hợp Bát Tự (xếp hạng ngày) và Tử Vi (chọn giờ) để đưa ra phương án ưu tiên kèm 2 phương án dự phòng, luôn nêu rõ khuyết điểm. Dịch vụ VIP, trả kết quả kèm PDF về email."
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Chọn Ngày Giờ Sinh Cho Bé"
    description={`Trạch nhật sinh nở — chọn ngày giờ sinh cho bé trong khung bác sĩ cho phép, kết hợp Bát Tự và Tử Vi làm hai lớp lọc độc lập, không cộng điểm chéo. Phí ${TOOL_PRICE_LABEL}/lượt, thanh toán QR, kết quả kèm PDF gửi về email.`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Chọn Ngày Giờ Sinh Cho Bé" },
    ]}
  />

  <Container class="py-12">
    <div class="mx-auto max-w-4xl">
      {ketQua && r ? (
        <>
          <p class="mb-5 text-center text-sm font-bold text-slate-700">
            Kết quả cho: <span class="text-(--color-gold-400)">{order?.customerName}</span> · Mã đơn: {orderCode}
          </p>

          <div class="mb-5 rounded-(--radius-card) border-2 border-(--color-gold-400)/50 bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-800)">
            Đã lập <strong>{r.soUngVienSinhRa}</strong> ứng viên, còn <strong>{r.soUngVienConLaiSauLoc}</strong> phương án đạt đủ tiêu chí sau khi lọc.
            <p class="mt-1 text-xs text-(--color-ink-600)">{r.medicalConstraintSummary}</p>
          </div>

          {!r.primary ? (
            <div class="rounded-2xl border-2 border-(--color-cinnabar-400) bg-white p-6 text-center shadow-lg">
              <p class="text-3xl">😕</p>
              <p class="mt-2 font-display text-lg font-bold text-slate-900">Không có phương án nào thực sự nổi trội</p>
              <p class="mt-1 text-sm text-slate-600">Trong khung dự sinh đã cho, chưa tìm được lựa chọn đạt đủ tiêu chí. Vui lòng nới rộng khung ngày/khung giờ bệnh viện, hoặc liên hệ trực tiếp để được tư vấn thêm.</p>
            </div>
          ) : (
            <div class="tns-tabs">
              <input type="radio" name="tns-tab" id="tab-tong-quan" checked />
              <input type="radio" name="tns-tab" id="tab-phuong-an" />
              <input type="radio" name="tns-tab" id="tab-bat-tu" />
              <input type="radio" name="tns-tab" id="tab-tu-vi" />
              <input type="radio" name="tns-tab" id="tab-du-phong" />

              {/* Thanh chuyển mục dạng nút — theo mẫu dashboard anh Công gửi 22/8/2026. */}
              <div class="mb-5 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
                <label for="tab-tong-quan" class="lb cursor-pointer rounded-lg px-2 py-2.5 text-center text-[11px] font-extrabold uppercase tracking-wide sm:text-xs">📊 Tổng quan</label>
                <label for="tab-phuong-an" class="lb cursor-pointer rounded-lg px-2 py-2.5 text-center text-[11px] font-extrabold uppercase tracking-wide sm:text-xs">🎯 Phương án chọn</label>
                <label for="tab-bat-tu" class="lb cursor-pointer rounded-lg px-2 py-2.5 text-center text-[11px] font-extrabold uppercase tracking-wide sm:text-xs">🌿 Bát Tự</label>
                <label for="tab-tu-vi" class="lb cursor-pointer rounded-lg px-2 py-2.5 text-center text-[11px] font-extrabold uppercase tracking-wide sm:text-xs">⭐ Tử Vi</label>
                <label for="tab-du-phong" class="lb cursor-pointer rounded-lg px-2 py-2.5 text-center text-[11px] font-extrabold uppercase tracking-wide sm:text-xs">🔁 Dự phòng</label>
              </div>

              {/* TAB 0 — Tổng quan: thẻ số liệu, đồng hồ điểm, phễu lọc */}
              <section class="pane pane-tong-quan">
                <TongQuanKetQua r={r} />
              </section>

              {/* TAB 2 — Chi tiết Bát Tự của phương án ưu tiên */}
              <section class="pane pane-bat-tu">
                <p class="mb-3 rounded-xl bg-(--color-ivory-100) p-3 text-center text-xs font-semibold text-(--color-ink-700)">
                  Lá số Bát Tự của <strong>phương án ưu tiên</strong> ({r.primary.ngayDuongLich} · {r.primary.khungGio}). Bát Tự đảm nhận việc <strong>xếp hạng NGÀY</strong>.
                </p>
                <TabBatTu candidate={primaryCandidate} />
              </section>

              {/* TAB 3 — Chi tiết Tử Vi của phương án ưu tiên */}
              <section class="pane pane-tu-vi">
                <p class="mb-3 rounded-xl bg-(--color-ivory-100) p-3 text-center text-xs font-semibold text-(--color-ink-700)">
                  Lá số Tử Vi của <strong>phương án ưu tiên</strong> ({r.primary.ngayDuongLich} · {r.primary.khungGio}). Tử Vi đảm nhận việc <strong>chọn GIỜ</strong> trong ngày đã chọn — hai hệ độc lập, không cộng điểm chéo.
                </p>
                <TabTuVi candidate={primaryCandidate} ngayDuongLich={r.primary.ngayDuongLich} khungGio={r.primary.khungGio} tuTru={r.primary.tuTru} />
              </section>

              {/* TAB 1 — Phương án chọn ngày tối ưu */}
              <section class="pane pane-phuong-an">
              {/* ⭐ Phương án ưu tiên */}
              <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/60 bg-white shadow-lg">
                <div class="bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-5 py-3">
                  <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-on-accent)">⭐ Phương án ưu tiên</h3>
                </div>
                <div class="p-5">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="font-display text-2xl font-black text-slate-900">{r.primary.ngayDuongLich} <span class="text-lg font-bold text-(--color-gold-600)">· {r.primary.khungGio}</span></p>
                    <div class="rounded-xl bg-slate-900 px-4 py-2 text-center">
                      <p class="font-display text-2xl font-black leading-none text-white">{r.primary.diem.tong}<span class="text-sm font-bold text-white/50">/100</span></p>
                      <p class="mt-0.5 text-[10px] font-extrabold uppercase tracking-wide text-(--color-gold-300)">{r.primary.diem.mucNhan}</p>
                    </div>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Vượng suy: {r.primary.vuongSuy}</span>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Dụng Thần: {r.primary.dungThan}</span>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Cung Mệnh: {r.primary.cungMenh}</span>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Cục: {r.primary.cuc}</span>
                  </div>

                  <DoHinhUngVien candidate={primaryCandidate} />

                  <p class="mt-4 text-sm font-bold text-slate-700">Tứ trụ đầy đủ: {r.primary.tuTru}</p>
                  {r.primary.diemNoiBat.length > 0 && (
                    <div class="mt-4">
                      <p class="text-xs font-extrabold uppercase tracking-wide text-emerald-700">Điểm nổi bật</p>
                      <ul class="mt-1 space-y-1">
                        {r.primary.diemNoiBat.map((d) => (<li class="text-sm font-semibold text-emerald-800">✓ {d}</li>))}
                      </ul>
                    </div>
                  )}
                  <div class="mt-4">
                    <p class="text-xs font-extrabold uppercase tracking-wide text-(--color-cinnabar-600)">Điểm cần lưu ý (không gỡ được)</p>
                    <ul class="mt-1 space-y-1">
                      {r.primary.diemCanLuuY.map((d) => (<li class="text-sm font-semibold text-(--color-cinnabar-700)">△ {d}</li>))}
                    </ul>
                  </div>
                </div>
              </div>

              {/* Vì sao chọn */}
              <div class="mt-5 overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
                <div class="bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-5 py-3">
                  <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-on-accent)">Vì sao chọn phương án này?</h3>
                </div>
                <div class="space-y-3 p-5">
                  {r.decisiveFactors.map((f) => (
                    <div>
                      <p class="text-sm font-extrabold text-slate-900">{f.label}</p>
                      <p class="text-sm font-semibold text-slate-700">{f.detail}</p>
                    </div>
                  ))}
                </div>
              </div>

              {/* So sánh nhanh — bảng có thanh dữ liệu trong ô */}
              {r.alternatives.length > 0 && (
                <div class="mt-5"><BangSoSanhPhuongAn primary={r.primary} alternatives={r.alternatives} /></div>
              )}

              </section>

              {/* TAB 4 — Các phương án dự phòng */}
              <section class="pane pane-du-phong">
                <p class="mb-3 rounded-xl bg-(--color-ivory-100) p-3 text-center text-xs font-semibold text-(--color-ink-700)">
                  Nếu vì lý do y tế không dùng được phương án chính, đây là các phương án thay thế đã qua đủ vòng lọc — kèm đồ hình và khuyết điểm riêng.
                </p>
              {/* Phương án dự phòng */}
              {r.alternatives.map((alt, i) => (
                <div class="mt-5 overflow-hidden rounded-2xl border-2 border-slate-300 bg-white shadow-lg">
                  <div class="bg-slate-100 px-5 py-3">
                    <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-slate-800">Phương án dự phòng {i + 2}</h3>
                  </div>
                  <div class="p-5">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <p class="font-display text-xl font-black text-slate-900">{alt.ngayDuongLich} <span class="text-base font-bold text-slate-600">· {alt.khungGio}</span></p>
                      <div class="rounded-lg bg-slate-100 px-3 py-1.5 text-center">
                        <p class="font-display text-lg font-black leading-none text-slate-800">{alt.diem.tong}<span class="text-xs font-bold text-slate-400">/100</span></p>
                        <p class="text-[9.5px] font-extrabold uppercase tracking-wide text-slate-500">{alt.diem.mucNhan}</p>
                      </div>
                    </div>
                    <p class="mt-1 text-sm font-bold text-slate-700">Tứ trụ: {alt.tuTru}</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Vượng suy: {alt.vuongSuy}</span>
                      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Dụng Thần: {alt.dungThan}</span>
                      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Cung Mệnh: {alt.cungMenh}</span>
                    </div>

                    <DoHinhUngVien candidate={timUngVien(alt.candidateId)} gon />

                    <div class="mt-4">
                      <p class="text-xs font-extrabold uppercase tracking-wide text-(--color-cinnabar-600)">Khuyết điểm cần lưu ý</p>
                      <ul class="mt-1 space-y-1">
                        {alt.diemCanLuuY.map((d) => (<li class="text-sm font-semibold text-(--color-cinnabar-700)">△ {d}</li>))}
                      </ul>
                    </div>
                  </div>
                </div>
              ))}
              </section>
            </div>
          )}

          <div class="mt-6 rounded-xl border border-(--color-gold-400)/40 bg-(--color-gold-400)/5 p-4 text-center text-sm font-semibold text-(--color-ink-800)">
            📄 Bản đầy đủ (PDF, kèm chuỗi Đại Vận/Đại Hạn chi tiết) đã được gửi về email bạn đăng ký. Trang này bạn có thể lưu lại để xem sau bằng chính đường dẫn (có mã đơn).
          </div>

          <div class="mt-4 rounded-xl bg-(--color-ivory-100) p-4 text-center text-xs font-semibold italic text-(--color-ink-700)">
            <p>{r.disclaimer.medical}</p>
            <p class="mt-1">{r.disclaimer.metaphysics}</p>
          </div>

          {/* CTA cuối trang — mời khách trao đổi trực tiếp với chuyên gia sau khi xem kết quả. */}
          <div class="mt-6 overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/60 bg-gradient-to-br from-[#241a10] to-[#3a2c17] p-6 text-center shadow-xl">
            <p class="font-display text-xl font-extrabold text-(--color-gold-300)">Cần chuyên gia xem kỹ hơn cho trường hợp của gia đình?</p>
            <p class="mx-auto mt-2 max-w-2xl text-sm font-semibold text-white/85">
              Kết quả trên là phần tính toán theo mô hình. Với quyết định quan trọng như ngày giờ sinh của bé,
              gia đình nên trao đổi trực tiếp để đối chiếu thêm lá số cha mẹ, phương vị, và tình hình y tế thực tế.
            </p>
            <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
              <a
                href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`}
                class="inline-flex items-center gap-2 rounded-(--radius-pill) bg-(--color-gold-400) px-6 py-3 text-sm font-extrabold text-(--color-on-accent) shadow-lg transition hover:bg-(--color-gold-300)"
              >
                📞 Gọi tư vấn: {siteConfig.hotline}
              </a>
              <a
                href="https://zalo.me/0836768768"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-(--radius-pill) border-2 border-(--color-gold-400) px-6 py-3 text-sm font-extrabold text-(--color-gold-300) transition hover:bg-(--color-gold-400)/15"
              >
                💬 Nhắn Zalo
              </a>
              <a
                href="/dich-vu"
                class="inline-flex items-center gap-2 rounded-(--radius-pill) border-2 border-white/30 px-6 py-3 text-sm font-extrabold text-white/90 transition hover:bg-white/10"
              >
                Xem các dịch vụ khác →
              </a>
            </div>
          </div>
        </>
      ) : (
        <>
          {laQuanTri ? (
            <>
              <div class="mb-4 rounded-(--radius-card) border-2 border-amber-400 bg-amber-50 p-4 text-sm font-medium text-amber-800">
                🔒 CHẾ ĐỘ QUẢN TRỊ — dịch vụ đang thử nghiệm nội bộ, chỉ tài khoản quản trị thấy & dùng được. Đơn của bạn được tạo ở mức 0đ và tự xác nhận để test trọn luồng thu phí ({TOOL_PRICE_LABEL}/lượt khi mở bán).
              </div>

              <div class="mb-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-600)">
                <p class="font-medium text-(--color-ink-800)">Dịch vụ này cho bạn gì?</p>
                <ul class="mt-1.5 list-disc space-y-1 pl-5">
                  <li>Lập <strong>toàn bộ ứng viên</strong> trong khung dự sinh (mỗi ngày × 12 giờ), không chỉ nhìn vài ngày.</li>
                  <li><strong>Bát Tự xếp hạng NGÀY</strong> (vượng suy, gốc, Ấn tinh, ngũ hành lưu thông, Đại Vận) — <strong>Tử Vi chọn GIỜ</strong> trong ngày đã chọn (Mệnh/Thân/Cục, Tuần–Triệt, sát tinh). Hai hệ không cộng điểm chéo, bên nào cũng có quyền phủ quyết.</li>
                  <li>Trả về <strong>1 phương án chính + tối đa 2 dự phòng</strong>, luôn nêu rõ khuyết điểm không gỡ được.</li>
                </ul>
                <p class="mt-2 text-xs text-(--color-ink-500)">⚠️ Chỉ định y khoa của bác sĩ luôn là quyết định cuối cùng. Kết quả kèm <strong>PDF gửi về email</strong>.</p>
              </div>

              <form id="tnsn-form" class="flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
                <DateSelect idPrefix="tnsn-tu" label="Từ ngày (dự sinh)" required yearsBack={0} yearsForward={1} />
                <DateSelect idPrefix="tnsn-den" label="Đến ngày (dự sinh)" required yearsBack={0} yearsForward={1} />
                <p class="-mt-1 text-xs text-(--color-ink-500)">Tối đa 31 ngày cho một lần tính.</p>

                <div>
                  <span class="text-xs font-medium text-slate-600">Giới tính bé <span class="text-(--color-cinnabar-400)">*</span></span>
                  <div class="mt-1.5 flex gap-3">
                    <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) has-[:checked]:border-(--color-gold-500) has-[:checked]:bg-(--color-gold-400)/15">
                      <input type="radio" name="tnsn-gioi-tinh" value="Nam" /> Nam
                    </label>
                    <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) has-[:checked]:border-(--color-gold-500) has-[:checked]:bg-(--color-gold-400)/15">
                      <input type="radio" name="tnsn-gioi-tinh" value="Nữ" /> Nữ
                    </label>
                  </div>
                </div>

                <div>
                  <label for="tnsn-hinh-thuc" class="text-xs font-medium text-slate-600">Hình thức sinh <span class="text-(--color-cinnabar-400)">*</span></label>
                  <select id="tnsn-hinh-thuc" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2.5 text-sm text-(--color-ink-800)">
                    {HINH_THUC_SINH.map((h) => (<option value={h.value}>{h.label}</option>))}
                  </select>
                </div>

                <div id="tnsn-khung-vien" class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="tnsn-gio-tu" class="text-xs text-(--color-ink-600)">Bệnh viện mổ từ giờ</label>
                    <input type="number" id="tnsn-gio-tu" min="0" max="23" placeholder="vd 8" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
                  </div>
                  <div>
                    <label for="tnsn-gio-den" class="text-xs text-(--color-ink-600)">Đến giờ</label>
                    <input type="number" id="tnsn-gio-den" min="1" max="24" placeholder="vd 17" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
                  </div>
                </div>
                <p class="-mt-2 text-xs text-(--color-ink-500)">Áp dụng cho mọi ngày trong khung. Bỏ trống nếu chưa rõ hoặc sinh thường — hệ thống xét đủ 12 giờ.</p>

                <div>
                  <label for="tnsn-uu-tien" class="text-xs font-medium text-slate-600">Ưu tiên của gia đình</label>
                  <select id="tnsn-uu-tien" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2.5 text-sm text-(--color-ink-800)">
                    {UU_TIEN.map((u) => (<option value={u.value}>{u.label}</option>))}
                  </select>
                </div>

                <div class="border-t border-(--color-ivory-300) pt-4">
                  <p class="text-sm font-medium text-(--color-ink-800)">Thông tin liên hệ (để nhận kết quả & PDF sau khi thanh toán)</p>
                  <div class="mt-2 grid gap-3">
                    <input type="text" id="tnsn-ten" placeholder="Họ tên" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                    <input type="tel" id="tnsn-sdt" placeholder="Số điện thoại" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                    <input type="email" id="tnsn-email" placeholder="Email (để nhận PDF)" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                  </div>
                </div>

                <MaKhuyenMai idPrefix="tnsn-ma" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />

                <Button type="submit" size="lg">Tìm ngày giờ sinh tốt nhất</Button>
              </form>

              <div id="tnsn-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
                <p class="font-medium text-(--color-ink-900)">⏳ Đang lập ứng viên và xếp hạng…</p>
              </div>
              <div id="tnsn-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

              <div id="tnsn-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-amber-300 bg-white p-6 text-center text-slate-900 shadow-lg">
                <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="tnsn-so-tien">{TOOL_PRICE_LABEL}</span></p>
                <img id="tnsn-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-slate-200" />
                <p class="text-sm text-slate-600">Mã đơn hàng: <strong id="tnsn-order-code"></strong></p>
                <p id="tnsn-trang-thai" class="text-sm font-medium text-amber-600">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
              </div>
            </>
          ) : (
            <div class="mx-auto max-w-xl rounded-(--radius-card) border-2 border-(--color-gold-400)/50 bg-(--color-ivory-100) p-8 text-center">
              <p class="text-3xl">🚧</p>
              <p class="mt-3 font-display text-lg font-bold text-(--color-ink-900)">Dịch vụ đang trong giai đoạn thử nghiệm nội bộ</p>
              <p class="mt-2 text-sm text-(--color-ink-600)">Chúng tôi đang hoàn thiện chất lượng tính toán trước khi mở bán chính thức. Vui lòng quay lại sau, hoặc liên hệ hotline để được thông báo ngay khi ra mắt.</p>
            </div>
          )}
        </>
      )}
    </div>
  </Container>
</BaseLayout>

<style>
  /* Tab thuần CSS (không cần JS) — cùng khuôn đã dùng ở module Định Hướng Nghề Nghiệp. */
  .tns-tabs > input { position: absolute; opacity: 0; pointer-events: none; }
  .pane { display: none; }
  #tab-tong-quan:checked ~ .pane-tong-quan,
  #tab-phuong-an:checked ~ .pane-phuong-an,
  #tab-bat-tu:checked ~ .pane-bat-tu,
  #tab-tu-vi:checked ~ .pane-tu-vi,
  #tab-du-phong:checked ~ .pane-du-phong { display: block; }

  /* Nút chưa chọn: viền vàng, nền trong — nút đang chọn: nền vàng đặc (mẫu dashboard 22/8/2026). */
  .tns-tabs .lb {
    background: transparent;
    color: var(--color-gold-600);
    border: 2px solid color-mix(in srgb, var(--color-gold-400) 45%, transparent);
    transition: background .15s ease, color .15s ease;
  }
  .tns-tabs .lb:hover { background: color-mix(in srgb, var(--color-gold-400) 15%, transparent); }
  #tab-tong-quan:checked ~ div label[for="tab-tong-quan"],
  #tab-phuong-an:checked ~ div label[for="tab-phuong-an"],
  #tab-bat-tu:checked ~ div label[for="tab-bat-tu"],
  #tab-tu-vi:checked ~ div label[for="tab-tu-vi"],
  #tab-du-phong:checked ~ div label[for="tab-du-phong"] {
    background: var(--color-gold-400);
    border-color: var(--color-gold-400);
    color: var(--color-on-accent);
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
  }
</style>

<script>
  import { readDateSelects } from "../../lib/date-select";

  const form = document.getElementById("tnsn-form") as HTMLFormElement | null;
  if (form) {
    const loiEl = document.getElementById("tnsn-loi")!;
    const dangChayEl = document.getElementById("tnsn-dang-chay")!;
    const thanhToanEl = document.getElementById("tnsn-thanh-toan")!;
    const qrImg = document.getElementById("tnsn-qr") as HTMLImageElement;
    const orderCodeEl = document.getElementById("tnsn-order-code")!;
    const trangThaiEl = document.getElementById("tnsn-trang-thai")!;
    const soTienEl = document.getElementById("tnsn-so-tien")!;
    const nutSubmit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const hinhThucSelect = document.getElementById("tnsn-hinh-thuc") as HTMLSelectElement;
    const khungVienBox = document.getElementById("tnsn-khung-vien")!;

    const capNhatKhungVien = () => {
      khungVienBox.classList.toggle("hidden", hinhThucSelect.value !== "scheduled_c_section");
    };
    capNhatKhungVien();
    hinhThucSelect.addEventListener("change", capNhatKhungVien);

    let pollTimer: ReturnType<typeof setInterval> | null = null;
    let dangHoi = false;
    const doc = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";

    const tatDangChay = () => { dangChayEl.classList.add("hidden"); if (nutSubmit) nutSubmit.disabled = false; };
    const baoLoi = (msg: string) => { tatDangChay(); loiEl.textContent = msg; loiEl.classList.remove("hidden"); };
    const dungCho = () => { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } };

    async function kiemTra(orderCode: string) {
      if (dangHoi) return;
      dangHoi = true;
      try {
        const res = await fetch(`/api/dai-cat-loi/trach-nhat-sinh-no/result?orderCode=${encodeURIComponent(orderCode)}`);
        const data = await res.json();
        if (!data.ok) return;
        if (data.status === "cancelled") { dungCho(); trangThaiEl.textContent = "Đơn hàng đã bị hủy."; return; }
        if (data.status !== "confirmed") return;
        dungCho();
        window.location.href = `/dai-cat-loi/trach-nhat-sinh-no?orderCode=${encodeURIComponent(orderCode)}`;
      } catch {
        // mạng chập chờn — nhịp sau thử lại
      } finally {
        dangHoi = false;
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      loiEl.classList.add("hidden");

      const tu = readDateSelects("tnsn-tu");
      const den = readDateSelects("tnsn-den");
      if (!tu || !den) return baoLoi("Vui lòng chọn đầy đủ khung ngày dự sinh.");
      const gioiTinh = (document.querySelector('input[name="tnsn-gioi-tinh"]:checked') as HTMLInputElement | null)?.value;
      if (!gioiTinh) return baoLoi("Vui lòng chọn giới tính của bé.");
      if (!doc("tnsn-ten") || !doc("tnsn-sdt")) return baoLoi("Vui lòng nhập họ tên và số điện thoại.");

      const gioTu = doc("tnsn-gio-tu");
      const gioDen = doc("tnsn-gio-den");
      const hospitalTimeWindows =
        hinhThucSelect.value === "scheduled_c_section" && gioTu !== "" && gioDen !== ""
          ? [{ startHour: Number(gioTu), endHour: Number(gioDen) }]
          : undefined;

      const payload: Record<string, unknown> = {
        startDate: { year: tu.year, month: tu.month, day: tu.day },
        endDate: { year: den.year, month: den.month, day: den.day },
        babyGender: gioiTinh,
        deliveryMode: hinhThucSelect.value,
        ...(hospitalTimeWindows ? { hospitalTimeWindows } : {}),
        familyPriority: (document.getElementById("tnsn-uu-tien") as HTMLSelectElement).value,
        customerName: doc("tnsn-ten"),
        customerPhone: doc("tnsn-sdt"),
        ...(doc("tnsn-email") ? { customerEmail: doc("tnsn-email") } : {}),
        ...(doc("tnsn-ma-input") ? { maKhuyenMai: doc("tnsn-ma-input") } : {}),
      };

      dangChayEl.classList.remove("hidden");
      if (nutSubmit) nutSubmit.disabled = true;
      try {
        const res = await fetch("/api/dai-cat-loi/trach-nhat-sinh-no/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
        tatDangChay();
        orderCodeEl.textContent = data.orderCode;

        if (data.mienPhi) { dangChayEl.classList.remove("hidden"); await kiemTra(data.orderCode); return; }

        soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
        qrImg.src = data.qrUrl;
        trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
        thanhToanEl.classList.remove("hidden");
        thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
        pollTimer = setInterval(() => kiemTra(data.orderCode), 3000);
      } catch {
        baoLoi("Có lỗi xảy ra. Vui lòng thử lại.");
      }
    });
  }
</script>
