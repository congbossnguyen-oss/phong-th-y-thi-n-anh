---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Xem Tuổi Xông Đất – Xông Nhà"
  description="Tìm tuổi xông đất/xông nhà đầu năm phù hợp nhất với gia chủ: ưu tiên Địa Chi hợp với năm, Thiên Can hợp gia chủ, có Lộc/Quý Nhân/Dịch Mã, loại trừ Xung/Hình/Hại/Phá, Tam Tai, Thái Tuế."
  appShell
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Xem Tuổi Xông Đất – Xông Nhà"
    description="Nhập năm sinh gia chủ, năm cần xông và khoảng năm sinh ứng viên — hệ thống tự quét, loại trừ tuổi xấu và xếp hạng tuổi tốt nhất."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Xem Tuổi Xông Đất – Xông Nhà" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <form id="form-xong-dat" class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="xd-nam-gia-chu" class="text-xs font-medium text-(--color-ink-600)">Năm sinh gia chủ</label>
            <input type="number" id="xd-nam-gia-chu" min="1900" max="2100" required placeholder="1988" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="xd-nam-xong" class="text-xs font-medium text-(--color-ink-600)">Năm xông đất/xông nhà</label>
            <input type="number" id="xd-nam-xong" min="1900" max="2100" required placeholder="2027" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div>
            <label for="xd-tu-nam" class="text-xs font-medium text-(--color-ink-600)">Ứng viên: từ năm sinh</label>
            <input type="number" id="xd-tu-nam" min="1900" max="2100" required placeholder="1970" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="xd-den-nam" class="text-xs font-medium text-(--color-ink-600)">Ứng viên: đến năm sinh</label>
            <input type="number" id="xd-den-nam" min="1900" max="2100" required placeholder="2010" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
        </div>
        <p class="mt-2 text-xs text-(--color-ink-400)">Tối đa 60 năm mỗi lượt quét.</p>
        <Button type="submit" size="lg" class="mt-4 w-full">Tìm tuổi xông đất/xông nhà</Button>
      </form>

      <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

      <div id="ket-qua" class="mt-4 hidden">
        <div id="danh-sach-tot" class="space-y-2"></div>
        <div class="mt-4">
          <button type="button" id="toggle-tuoi-tranh" class="text-sm font-semibold text-(--color-cinnabar-500) hover:underline">
            🔴 Xem danh sách tuổi nên tránh
          </button>
          <div id="danh-sach-tranh" class="mt-2 hidden space-y-1.5"></div>
        </div>
      </div>

      <div class="mt-6 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Ngoài tuổi — cần xét thêm vận khí, trạng thái của người xông</p>
        <p class="mt-2 text-sm text-(--color-ink-600)">
          Hợp tuổi chỉ là 1 điều kiện. Trong danh sách tuổi tốt ở trên, hãy ưu tiên chọn người đang có trạng thái tốt
          dưới đây, và tránh mời người đang gặp các trường hợp nên loại trừ — dù người đó hợp tuổi.
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <p class="text-sm font-semibold text-emerald-600">🟢 Ưu tiên người đang</p>
            <ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-(--color-ink-700)">
              <li>Công việc thuận lợi, có xu hướng phát triển</li>
              <li>Tài chính ổn định, làm ăn có kết quả</li>
              <li>Gia đình, hôn nhân tương đối hòa thuận</li>
              <li>Sức khỏe và tinh thần ổn định</li>
              <li>Đang có nhiều việc vui hoặc thành tựu tốt</li>
              <li>Tính cách tích cực, vui vẻ, cởi mở</li>
              <li>Nói năng tích cực, không thường than thở</li>
              <li>Quan hệ tốt với gia chủ, không mâu thuẫn</li>
              <li>Có năng lượng và khí thế tốt</li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-(--color-cinnabar-500)">🔴 Nên tránh mời người đang</p>
            <ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-(--color-ink-700)">
              <li>Có tang sự hoặc trong thời gian chịu tang</li>
              <li>Gặp biến cố lớn trong gia đình</li>
              <li>Bệnh nặng hoặc sức khỏe suy yếu nghiêm trọng</li>
              <li>Khủng hoảng tài chính nghiêm trọng</li>
              <li>Làm ăn thua lỗ hoặc sự nghiệp suy thoái mạnh</li>
              <li>Tranh chấp hoặc kiện tụng nghiêm trọng</li>
              <li>Gia đạo đang mâu thuẫn nghiêm trọng</li>
              <li>Tâm lý quá tiêu cực, buồn bã, bất ổn</li>
              <li>Có mâu thuẫn trực tiếp với gia chủ</li>
            </ul>
          </div>
        </div>

        <p class="mt-4 text-xs text-(--color-ink-500)">
          Nếu gia chủ có mục tiêu cụ thể (cầu tài lộc, cầu công danh, cầu gia đạo, cầu sức khỏe, cầu bình an), nên ưu
          tiên chọn người đang thuận lợi đúng mảng đó. Đây là bước đánh giá thực tế, cần bạn tự nhận định theo từng
          người — hệ thống không thể tính tự động phần này chỉ từ năm sinh.
        </p>
      </div>

      <p class="mt-4 text-xs text-(--color-ink-500)">
        Hoàng Ốc/Kim Lâu không dùng làm tiêu chí chọn người xông đất — đây chỉ là công cụ tham khảo theo hệ thống
        phong thủy đã cấu hình, không khẳng định chắc chắn về tài lộc hay vận hạn.
      </p>
    </div>
  </Container>
  <BottomNav />
</BaseLayout>

<script>
  interface NguoiCanChi { namSinh: number; can: string; chi: string }
  interface XongDatBonus { loc: boolean; quyNhan: boolean; dichMa: boolean }
  interface XongDatCandidateResult {
    ungVien: NguoiCanChi;
    diem: number;
    diaChiNam: { diem: number; moTa: string };
    thienCanGiaChu: { diem: number; moTa: string };
    bonus: XongDatBonus;
    lyDoNoiBat: string[];
  }
  interface XongDatExcludedResult { ungVien: NguoiCanChi; lyDo: string[] }
  interface XemTuoiXongDatOutput { hopLe: XongDatCandidateResult[]; loaiTru: XongDatExcludedResult[] }

  const form = document.getElementById("form-xong-dat") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;
  const danhSachTotEl = document.getElementById("danh-sach-tot")!;
  const danhSachTranhEl = document.getElementById("danh-sach-tranh")!;
  const toggleTranhBtn = document.getElementById("toggle-tuoi-tranh") as HTMLButtonElement;

  toggleTranhBtn.addEventListener("click", () => danhSachTranhEl.classList.toggle("hidden"));

  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const giaChuNamSinh = (document.getElementById("xd-nam-gia-chu") as HTMLInputElement).value;
    const namXong = (document.getElementById("xd-nam-xong") as HTMLInputElement).value;
    const tuNamSinhUngVien = (document.getElementById("xd-tu-nam") as HTMLInputElement).value;
    const denNamSinhUngVien = (document.getElementById("xd-den-nam") as HTMLInputElement).value;

    try {
      const res = await fetch(
        `/api/xem-tuoi-xong-dat?giaChuNamSinh=${giaChuNamSinh}&namXong=${namXong}&tuNamSinhUngVien=${tuNamSinhUngVien}&denNamSinhUngVien=${denNamSinhUngVien}&limit=5`,
      );
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const output = data as XemTuoiXongDatOutput;

      if (output.hopLe.length === 0) {
        danhSachTotEl.innerHTML = `<p class="text-sm text-(--color-ink-500)">Không tìm được tuổi phù hợp trong khoảng năm đã chọn — thử mở rộng khoảng năm sinh ứng viên.</p>`;
      } else {
        danhSachTotEl.innerHTML = output.hopLe
          .map((r, i) => {
            const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
            return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-3">
              <div class="flex items-center justify-between">
                <p class="font-display text-base font-bold text-(--color-ink-950)">${huyChuong} Năm sinh ${r.ungVien.namSinh} <span class="text-xs font-normal text-(--color-ink-500)">(${r.ungVien.can} ${r.ungVien.chi})</span></p>
                <span class="text-sm font-semibold">⭐ ${r.diem}/10</span>
              </div>
              <ul class="mt-1.5 list-disc pl-4 text-xs text-(--color-ink-500)">
                ${r.lyDoNoiBat.map((l) => `<li>${l}</li>`).join("")}
              </ul>
            </div>`;
          })
          .join("");
      }

      if (output.loaiTru.length === 0) {
        danhSachTranhEl.innerHTML = `<p class="text-sm text-(--color-ink-500)">Không có tuổi nào bị loại trừ trong khoảng đã chọn.</p>`;
      } else {
        danhSachTranhEl.innerHTML = output.loaiTru
          .map(
            (e) =>
              `<p class="text-sm text-(--color-ink-600)">🔴 <strong>${e.ungVien.namSinh}</strong> (${e.ungVien.can} ${e.ungVien.chi}) — ${e.lyDo.join(" + ")}</p>`,
          )
          .join("");
      }

      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
