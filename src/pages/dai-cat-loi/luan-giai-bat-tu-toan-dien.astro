---
// TRANG "Luận Giải Bát Tự Toàn Diện" — 12 giai đoạn A-L, 3 tầng: Free (không AI) → Luận Cơ Bản (trả
// phí lần 1) → Luận Nâng Cao (trả phí lần 2). 2 tầng trả phí BẮT BUỘC đăng nhập (khác mọi công cụ
// khác trong repo — SPEC mục 0.4), quyền truy cập gắn theo TÀI KHOẢN, không theo orderCode.
//
// ⚠️ CHƯA PUBLISH: trang KHÔNG được gắn link ở bất kỳ menu/nav nào — chỉ truy cập qua URL trực tiếp
// để anh Công test. Khi test xong, gỡ dòng này và thêm vào /dai-cat-loi + menu Công cụ.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import { getConfirmedToolOrderForUser } from "../../lib/db/orders";
import { taoBaoCaoCoBan, taoBaoCaoNangCao } from "../../lib/luan-giai-toan-dien/orchestrator";
import { hashLaSo, cacheCoBan, cacheNangCao } from "../../lib/luan-giai-toan-dien/cache";
import type { BatTuInput } from "../../lib/bat-tu";

export const prerender = false;

const TOOL_SLUG_CO_BAN = "luan-giai-bat-tu-co-ban" as const;
const TOOL_SLUG_NANG_CAO = "luan-giai-bat-tu-nang-cao" as const;
const GIA_CO_BAN = GIA_CONG_CU[TOOL_SLUG_CO_BAN];
const GIA_NANG_CAO = GIA_CONG_CU[TOOL_SLUG_NANG_CAO];

const user = Astro.locals.user;

let baoCaoCoBan: Awaited<ReturnType<typeof taoBaoCaoCoBan>> | null = null;
let baoCaoNangCao: Awaited<ReturnType<typeof taoBaoCaoNangCao>> | null = null;
let loiTinhBaoCao: string | null = null;

if (user) {
  const donCoBan = await getConfirmedToolOrderForUser(user.id, TOOL_SLUG_CO_BAN);
  const donNangCao = await getConfirmedToolOrderForUser(user.id, TOOL_SLUG_NANG_CAO);

  try {
    if (donCoBan?.toolInputSnapshot) {
      const input = JSON.parse(donCoBan.toolInputSnapshot) as BatTuInput;
      const key = hashLaSo(input);
      baoCaoCoBan = cacheCoBan.get(key);
      if (!baoCaoCoBan) {
        baoCaoCoBan = await taoBaoCaoCoBan(input);
        cacheCoBan.set(key, baoCaoCoBan);
      }
    }
    if (donNangCao?.toolInputSnapshot) {
      const input = JSON.parse(donNangCao.toolInputSnapshot) as BatTuInput;
      const key = hashLaSo(input);
      baoCaoNangCao = cacheNangCao.get(key);
      if (!baoCaoNangCao) {
        baoCaoNangCao = await taoBaoCaoNangCao(input);
        cacheNangCao.set(key, baoCaoNangCao);
      }
    }
  } catch (err) {
    loiTinhBaoCao = err instanceof Error ? err.message : "Không tính được báo cáo.";
  }
}

const gioOptions = Array.from({ length: 24 }, (_, i) => i);
---

<BaseLayout
  title="Luận Giải Bát Tự Toàn Diện"
  description="Báo cáo luận giải Bát Tự toàn diện theo 12 giai đoạn: nền tảng, tính cách, Thập Thần, Thần Sát, Mộ Khố, Lục Thân, nghề nghiệp - tài - quan, hôn nhân, sức khỏe, ngũ hành thực hành, Đại Vận trọn đời và kết luận."
  appShell
  noIndex
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP · Đang thử nghiệm"
    title="Luận Giải Bát Tự Toàn Diện"
    description={`Báo cáo luận giải Bát Tự đầy đủ theo 12 giai đoạn — mở đầu miễn phí, Luận Cơ Bản ${dinhDangTien(GIA_CO_BAN)}, Luận Nâng Cao ${dinhDangTien(GIA_NANG_CAO)} (mua thêm sau vẫn được).`}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Luận Giải Bát Tự Toàn Diện" }]}
  />

  <Container class="py-12">
    <div class="mx-auto max-w-4xl">
      {loiTinhBaoCao && (
        <div class="mb-5 rounded-(--radius-card) border-2 border-(--color-danger-500) bg-(--color-danger-500)/10 p-4 text-sm font-bold text-(--color-danger-500)">
          ⚠️ Có lỗi khi tính báo cáo: {loiTinhBaoCao}
        </div>
      )}

      {/* --- Đã có báo cáo Cơ Bản (đã mua + tính xong) --- */}
      {baoCaoCoBan && (
        <section class="mb-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Luận Cơ Bản</h2>
          <p class="mt-2 text-xs text-(--color-ink-500)">{baoCaoCoBan.disclaimerDauBai}</p>
          <div class="mt-4 grid grid-cols-2 gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4 text-sm sm:grid-cols-4">
            {baoCaoCoBan.laSo.tuTru.map((t) => (
              <div class="text-center">
                <p class="text-xs text-(--color-ink-500)">{t.tru}</p>
                <p class="font-bold text-(--color-ink-900)">{t.can} {t.chi}</p>
              </div>
            ))}
          </div>
          <div class="mt-6 space-y-6">
            {baoCaoCoBan.giaiDoan.length === 0 && (
              <p class="text-sm text-(--color-ink-600)">⚠️ Phần luận AI chưa chạy được (chưa cấu hình khoá AI trên máy chủ).</p>
            )}
            {baoCaoCoBan.giaiDoan.map((gd) => (
              <div>
                <h3 class="font-display text-lg font-bold text-(--color-gold-600)">{gd.tieuDe}</h3>
                <p class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-(--color-ink-800)">{gd.noiDung}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 text-xs text-(--color-ink-500)">{baoCaoCoBan.disclaimerCuoiBai}</p>
          {!baoCaoNangCao && (
            <div class="mt-6 rounded-(--radius-control) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-800)">
              <p>{baoCaoCoBan.ctaNangCao}</p>
              <Button id="ldbtd-mua-nang-cao" size="md" class="mt-3">Xem Luận Nâng Cao — {dinhDangTien(GIA_NANG_CAO)}</Button>
            </div>
          )}
        </section>
      )}

      {/* --- Đã có báo cáo Nâng Cao --- */}
      {baoCaoNangCao && (
        <section class="mb-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
          <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Luận Nâng Cao</h2>
          <div class="mt-6 space-y-6">
            {baoCaoNangCao.giaiDoan.length === 0 && (
              <p class="text-sm text-(--color-ink-600)">⚠️ Phần luận AI chưa chạy được (chưa cấu hình khoá AI trên máy chủ).</p>
            )}
            {baoCaoNangCao.giaiDoan.map((gd) => (
              <div>
                <h3 class="font-display text-lg font-bold text-(--color-gold-600)">{gd.tieuDe}</h3>
                <p class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-(--color-ink-800)">{gd.noiDung}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 text-xs text-(--color-ink-500)">{baoCaoNangCao.disclaimerCuoiBai}</p>
        </section>
      )}

      {/* --- Form nhập ngày sinh + xem trước Free --- */}
      <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <h2 class="font-display text-xl font-bold text-(--color-ink-950)">
          {baoCaoCoBan ? "Lập lá số khác" : "Lập lá số — xem gợi mở miễn phí"}
        </h2>
        <form id="ldbtd-form" class="mt-4 flex flex-col gap-4">
          <DateSelect idPrefix="ldbtd-sinh" label="Ngày sinh (dương lịch)" required yearsBack={90} yearsForward={0} />
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="ldbtd-gio" class="text-xs font-medium text-(--color-ink-600)">Giờ sinh <span class="text-(--color-cinnabar-400)">*</span></label>
              <select id="ldbtd-gio" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2.5 text-sm text-(--color-ink-800)">
                <option value="">Chọn giờ (0–23)</option>
                {gioOptions.map((h) => <option value={h}>{`${h}h — ${h}:00–${h}:59`}</option>)}
              </select>
            </div>
            <div>
              <label for="ldbtd-phut" class="text-xs font-medium text-(--color-ink-600)">Phút (nếu nhớ)</label>
              <input type="number" id="ldbtd-phut" min="0" max="59" placeholder="vd 20" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <div>
            <span class="text-xs font-medium text-(--color-ink-600)">Giới tính <span class="text-(--color-cinnabar-400)">*</span></span>
            <div class="mt-1.5 flex gap-3">
              <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) has-[:checked]:border-(--color-gold-500) has-[:checked]:bg-(--color-gold-400)/15">
                <input type="radio" name="ldbtd-gioi-tinh" value="Nam" /> Nam
              </label>
              <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) has-[:checked]:border-(--color-gold-500) has-[:checked]:bg-(--color-gold-400)/15">
                <input type="radio" name="ldbtd-gioi-tinh" value="Nữ" /> Nữ
              </label>
            </div>
          </div>
          <Button type="submit" size="lg">Xem gợi mở miễn phí</Button>
        </form>

        <div id="ldbtd-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

        <div id="ldbtd-free-result" class="mt-6 hidden rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-5">
          <p id="ldbtd-free-latu" class="text-xs font-medium text-(--color-ink-600)"></p>
          <p id="ldbtd-free-text" class="mt-2 whitespace-pre-line text-sm leading-relaxed text-(--color-ink-800)"></p>

          <div class="mt-5 border-t border-(--color-gold-400)/30 pt-4">
            {user ? (
              <div class="flex flex-col gap-3 sm:flex-row">
                <div class="flex-1">
                  <label for="ldbtd-sdt" class="text-xs font-medium text-(--color-ink-600)">Số điện thoại liên hệ <span class="text-(--color-cinnabar-400)">*</span></label>
                  <input type="tel" id="ldbtd-sdt" placeholder="Số điện thoại" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                </div>
              </div>
            ) : (
              <p class="text-sm text-(--color-ink-700)">
                Cần <a href="/hoc-vien/dang-nhap" class="font-bold text-(--color-gold-600) hover:underline">đăng nhập</a> để mua bản luận giải đầy đủ (báo cáo gắn theo tài khoản, xem lại không mất phí).
              </p>
            )}
            {user && <MaKhuyenMai idPrefix="ldbtd-ma" toolSlug={TOOL_SLUG_CO_BAN} giaGoc={GIA_CO_BAN} />}
            {user && !baoCaoCoBan && (
              <Button id="ldbtd-mua-co-ban" size="lg" class="mt-4 w-full sm:w-auto">Xem Luận Cơ Bản — {dinhDangTien(GIA_CO_BAN)}</Button>
            )}
          </div>
        </div>

        <div id="ldbtd-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
          <p class="font-medium text-(--color-ink-900)">⏳ Đang xử lý…</p>
        </div>
        <div id="ldbtd-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
          <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="ldbtd-so-tien"></span></p>
          <img id="ldbtd-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
          <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="ldbtd-order-code"></strong></p>
          <p id="ldbtd-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
        </div>
      </section>
    </div>
  </Container>
  <BottomNav />
</BaseLayout>

<script define:vars={{ daDangNhap: !!user }}>
  window.__ldbtdDaDangNhap = daDangNhap;
</script>
<script>
  import { readDateSelects } from "../../lib/date-select";

  const form = document.getElementById("ldbtd-form") as HTMLFormElement | null;
  if (form) {
    const loiEl = document.getElementById("ldbtd-loi")!;
    const dangChayEl = document.getElementById("ldbtd-dang-chay")!;
    const freeResultEl = document.getElementById("ldbtd-free-result")!;
    const freeLaTuEl = document.getElementById("ldbtd-free-latu")!;
    const freeTextEl = document.getElementById("ldbtd-free-text")!;
    const thanhToanEl = document.getElementById("ldbtd-thanh-toan")!;
    const qrImg = document.getElementById("ldbtd-qr") as HTMLImageElement;
    const orderCodeEl = document.getElementById("ldbtd-order-code")!;
    const trangThaiEl = document.getElementById("ldbtd-trang-thai")!;
    const soTienEl = document.getElementById("ldbtd-so-tien")!;
    const nutMuaCoBan = document.getElementById("ldbtd-mua-co-ban") as HTMLButtonElement | null;
    const nutMuaNangCao = document.getElementById("ldbtd-mua-nang-cao") as HTMLButtonElement | null;

    let pollTimer: ReturnType<typeof setInterval> | null = null;
    let dangHoi = false;
    const doc = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";

    const baoLoi = (msg: string) => { dangChayEl.classList.add("hidden"); loiEl.textContent = msg; loiEl.classList.remove("hidden"); };
    const dungCho = () => { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } };

    function docDauVao(): Record<string, unknown> | null {
      const sinh = readDateSelects("ldbtd-sinh");
      if (!sinh) { baoLoi("Vui lòng chọn đầy đủ ngày, tháng, năm sinh."); return null; }
      const gio = doc("ldbtd-gio");
      if (gio === "") { baoLoi("Vui lòng chọn giờ sinh."); return null; }
      const gioiTinh = (document.querySelector('input[name="ldbtd-gioi-tinh"]:checked') as HTMLInputElement | null)?.value;
      if (!gioiTinh) { baoLoi("Vui lòng chọn giới tính."); return null; }
      return {
        ngaySinh: { year: sinh.year, month: sinh.month, day: sinh.day },
        gio: Number(gio),
        ...(doc("ldbtd-phut") ? { phut: Number(doc("ldbtd-phut")) } : {}),
        gioiTinh,
      };
    }

    async function kiemTra(orderCode: string) {
      if (dangHoi) return;
      dangHoi = true;
      try {
        const res = await fetch(`/api/dai-cat-loi/luan-giai-bat-tu-toan-dien/result?orderCode=${encodeURIComponent(orderCode)}`);
        const data = await res.json();
        if (!data.ok) return;
        if (data.status === "cancelled") { dungCho(); trangThaiEl.textContent = "Đơn hàng đã bị hủy."; return; }
        if (data.status !== "confirmed") return;
        dungCho();
        window.location.href = "/dai-cat-loi/luan-giai-bat-tu-toan-dien";
      } catch {
        // mạng chập chờn — nhịp sau thử lại
      } finally {
        dangHoi = false;
      }
    }

    async function muaTang(tang: "co_ban" | "nang_cao") {
      const dauVao = docDauVao();
      if (!dauVao) return;
      const sdt = doc("ldbtd-sdt");
      if (!sdt) return baoLoi("Vui lòng nhập số điện thoại liên hệ.");

      const payload = { ...dauVao, tang, customerPhone: sdt, maKhuyenMai: doc("ldbtd-ma-input") || undefined };
      dangChayEl.classList.remove("hidden");
      loiEl.classList.add("hidden");
      try {
        const res = await fetch("/api/dai-cat-loi/luan-giai-bat-tu-toan-dien/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
        dangChayEl.classList.add("hidden");
        orderCodeEl.textContent = data.orderCode;

        if (data.mienPhi) { dangChayEl.classList.remove("hidden"); await kiemTra(data.orderCode); return; }

        soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
        qrImg.src = data.qrUrl;
        trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
        thanhToanEl.classList.remove("hidden");
        thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
        pollTimer = setInterval(() => kiemTra(data.orderCode), 3000);
      } catch {
        baoLoi("Có lỗi xảy ra. Vui lòng thử lại.");
      }
    }

    nutMuaCoBan?.addEventListener("click", () => muaTang("co_ban"));
    nutMuaNangCao?.addEventListener("click", () => muaTang("nang_cao"));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      loiEl.classList.add("hidden");
      const dauVao = docDauVao();
      if (!dauVao) return;

      dangChayEl.classList.remove("hidden");
      freeResultEl.classList.add("hidden");
      try {
        const res = await fetch("/api/dai-cat-loi/luan-giai-bat-tu-toan-dien/xem-truoc", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(dauVao),
        });
        const data = await res.json();
        dangChayEl.classList.add("hidden");
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không lập được lá số.");

        freeLaTuEl.textContent = `Tứ Trụ: ${data.laSo.tuTru.join(" / ")} — Nhật Chủ ${data.laSo.nhatChu} — ${data.laSo.capDoVuongSuy} — Dụng Thần ${data.laSo.dungThan}`;
        freeTextEl.textContent = data.goiMo;
        freeResultEl.classList.remove("hidden");
        freeResultEl.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch {
        baoLoi("Có lỗi xảy ra. Vui lòng thử lại.");
      }
    });
  }
</script>
