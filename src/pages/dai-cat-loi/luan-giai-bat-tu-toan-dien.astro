---
// TRANG "Luận Giải Bát Tự Toàn Diện" — 12 giai đoạn A-L, 3 tầng: Free (không AI) → Luận Cơ Bản (trả
// phí lần 1) → Luận Nâng Cao (trả phí lần 2). 2 tầng trả phí BẮT BUỘC đăng nhập (khác mọi công cụ
// khác trong repo — SPEC mục 0.4), quyền truy cập gắn theo TÀI KHOẢN, không theo orderCode.
//
// ⚠️ CHƯA PUBLISH: trang KHÔNG được gắn link ở bất kỳ menu/nav nào — chỉ truy cập qua URL trực tiếp
// để anh Công test. Khi test xong, gỡ dòng này và thêm vào /dai-cat-loi + menu Công cụ.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import BieuDoGiaiDoanVan from "../../components/luan-giai-toan-dien/BieuDoGiaiDoanVan.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import { getConfirmedToolOrderForUser } from "../../lib/db/orders";
import { taoBaoCaoCoBan, taoBaoCaoNangCao } from "../../lib/luan-giai-toan-dien/orchestrator";
import { hashLaSo, cacheCoBan, cacheNangCao } from "../../lib/luan-giai-toan-dien/cache";
import type { BatTuInput } from "../../lib/bat-tu";

export const prerender = false;

const TOOL_SLUG_CO_BAN = "luan-giai-bat-tu-co-ban" as const;
const TOOL_SLUG_NANG_CAO = "luan-giai-bat-tu-nang-cao" as const;
const GIA_CO_BAN = GIA_CONG_CU[TOOL_SLUG_CO_BAN];
const GIA_NANG_CAO = GIA_CONG_CU[TOOL_SLUG_NANG_CAO];

const user = Astro.locals.user;

let baoCaoCoBan: Awaited<ReturnType<typeof taoBaoCaoCoBan>> | null = null;
let baoCaoNangCao: Awaited<ReturnType<typeof taoBaoCaoNangCao>> | null = null;
let loiTinhBaoCao: string | null = null;
// Đã mua nhưng KHÔNG phải admin → không hiện báo cáo trực tiếp trên trang (đang tối ưu tốc độ hiển
// thị, ~30s/lần tải là chưa đạt). Khách vẫn nhận đủ nội dung qua email (đã gửi tự động lúc thanh
// toán xong, xem orders.ts). Admin (Công) vẫn xem trực tiếp trên trang để tự kiểm tra chất lượng.
let coDonCoBanChuaHienThi = false;
let coDonNangCaoChuaHienThi = false;

if (user) {
  const donCoBan = await getConfirmedToolOrderForUser(user.id, TOOL_SLUG_CO_BAN);
  const donNangCao = await getConfirmedToolOrderForUser(user.id, TOOL_SLUG_NANG_CAO);

  if (donCoBan?.toolInputSnapshot) coDonCoBanChuaHienThi = true;
  if (donNangCao?.toolInputSnapshot) coDonNangCaoChuaHienThi = true;

  if (user.isAdmin) {
    try {
      if (donCoBan?.toolInputSnapshot) {
        const input = JSON.parse(donCoBan.toolInputSnapshot) as BatTuInput;
        const key = hashLaSo(input);
        baoCaoCoBan = cacheCoBan.get(key);
        if (!baoCaoCoBan) {
          baoCaoCoBan = await taoBaoCaoCoBan(input);
          cacheCoBan.set(key, baoCaoCoBan);
        }
      }
      if (donNangCao?.toolInputSnapshot) {
        const input = JSON.parse(donNangCao.toolInputSnapshot) as BatTuInput;
        const key = hashLaSo(input);
        baoCaoNangCao = cacheNangCao.get(key);
        if (!baoCaoNangCao) {
          baoCaoNangCao = await taoBaoCaoNangCao(input);
          cacheNangCao.set(key, baoCaoNangCao);
        }
      }
    } catch (err) {
      loiTinhBaoCao = err instanceof Error ? err.message : "Không tính được báo cáo.";
    }
  }
}

const gioOptions = Array.from({ length: 24 }, (_, i) => i);

/** Màu ô đồ hình MỒI (Cơ Bản) theo điểm thô -1..1 — dùng chung cách tô màu với dải Lưu Niên bên tầng Free. */
function mauTheoDiemMoi(diem: number): string {
  if (diem > 0) return "#16a34a";
  if (diem < 0) return "#c0392b";
  return "#8a8270";
}
---

<BaseLayout
  title="Luận Giải Bát Tự Toàn Diện"
  description="Báo cáo luận giải Bát Tự toàn diện theo 12 giai đoạn: nền tảng, tính cách, Thập Thần, Thần Sát, Mộ Khố, Lục Thân, nghề nghiệp - tài - quan, hôn nhân, sức khỏe, ngũ hành thực hành, Đại Vận trọn đời và kết luận."
  noIndex
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP · Đang thử nghiệm"
    title="Luận Giải Bát Tự Toàn Diện"
    description={`Báo cáo luận giải Bát Tự đầy đủ theo 12 giai đoạn — mở đầu miễn phí, Luận Cơ Bản ${dinhDangTien(GIA_CO_BAN)}, Luận Nâng Cao ${dinhDangTien(GIA_NANG_CAO)} (mua thêm sau vẫn được).`}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Luận Giải Bát Tự Toàn Diện" }]}
  />

  <Container class="py-12">
    <div class="mx-auto max-w-4xl">
      {loiTinhBaoCao && (
        <div class="mb-5 rounded-(--radius-card) border-2 border-(--color-danger-500) bg-(--color-danger-500)/10 p-4 text-sm font-bold text-(--color-danger-500)">
          ⚠️ Có lỗi khi tính báo cáo: {loiTinhBaoCao}
        </div>
      )}

      {/* --- Đã mua Cơ Bản nhưng KHÔNG phải admin: không hiện trực tiếp, báo đã gửi qua email --- */}
      {coDonCoBanChuaHienThi && !baoCaoCoBan && (
        <div class="mb-10 rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-6 text-sm text-(--color-ink-800)">
          <p class="font-display text-lg font-bold text-(--color-ink-950)">✅ Đã mua Luận Cơ Bản</p>
          <p class="mt-2">Bản luận giải đầy đủ (PDF) đã được gửi tới email tài khoản của bạn ngay sau khi thanh toán thành công. Vui lòng kiểm tra hộp thư (kể cả mục Spam/Quảng cáo).</p>
        </div>
      )}

      {/* --- Đã có báo cáo Cơ Bản (chỉ admin xem trực tiếp trên trang) --- */}
      {baoCaoCoBan && (
        <section class="mb-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Luận Cơ Bản</h2>
            {baoCaoCoBan.giaiDoan.length > 0 && (
              <button type="button" class="ldbtd-tts-btn shrink-0 rounded-full border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 px-3 py-1.5 text-xs font-medium text-(--color-gold-700)" data-tts-target="ldbtd-cobantoanbo">🔊 Nghe toàn bộ</button>
            )}
          </div>
          <p class="mt-2 text-xs text-(--color-ink-500)">{baoCaoCoBan.disclaimerDauBai}</p>
          <div class="mt-4 grid grid-cols-2 gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4 text-sm sm:grid-cols-4">
            {baoCaoCoBan.laSo.tuTru.map((t) => (
              <div class="text-center">
                <p class="text-xs text-(--color-ink-500)">{t.tru}</p>
                <p class="font-bold text-(--color-ink-900)">{t.can} {t.chi}</p>
              </div>
            ))}
          </div>
          <div class="mt-3 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4 text-sm">
            <p><span class="font-bold text-(--color-ink-900)">Nhật Chủ:</span> {baoCaoCoBan.laSo.nhatChu} — <span class="font-bold text-(--color-ink-900)">Vượng Suy:</span> {baoCaoCoBan.laSo.capDoVuongSuy}</p>
            <p class="mt-1"><span class="font-bold text-(--color-ink-900)">Dụng Thần:</span> {baoCaoCoBan.laSo.dungThan} · <span class="font-bold text-(--color-ink-900)">Hỷ Thần:</span> {baoCaoCoBan.laSo.hyThan} · <span class="font-bold text-(--color-ink-900)">Kỵ Thần:</span> {baoCaoCoBan.laSo.kyThan}</p>
            {baoCaoCoBan.laSo.dieuHauNote && <p class="mt-1 text-(--color-gold-700)">🌡️ Điều Hậu: {baoCaoCoBan.laSo.dieuHauNote}</p>}
          </div>

          {(baoCaoCoBan.moiDaiVan.length > 0 || baoCaoCoBan.moiLuuNien.length > 0) && (
            <div class="mt-3 rounded-(--radius-control) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-4">
              <p class="text-sm font-bold text-(--color-ink-900)">Xem trước: Đại Vận & Lưu Niên</p>
              <p class="mt-1 text-xs text-(--color-ink-600)">Ước tính thô 1 chỉ số theo Dụng/Hỷ/Kỵ Thần nguyên cục — bản Nâng Cao tính lại Dụng Thần theo từng Đại Vận, tách 4 khía cạnh (Sức khỏe/Công việc/Tài lộc/Lục thân) và luận chi tiết từng năm bằng AI.</p>
              {baoCaoCoBan.moiDaiVan.length > 0 && (
                <div class="mt-3">
                  <p class="text-xs font-medium text-(--color-ink-600)">Đại Vận trọn đời</p>
                  <div class="mt-1 flex gap-1">
                    {baoCaoCoBan.moiDaiVan.map((m) => (
                      <div class="flex-1 rounded-sm py-2 text-center" style={`background-color:${mauTheoDiemMoi(m.diem)}22`} title={`${m.nhan} — ${m.canChi}`}>
                        <p class="text-[9px] leading-tight text-(--color-ink-600)">{m.nhan}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {baoCaoCoBan.moiLuuNien.length > 0 && (
                <div class="mt-3">
                  <p class="text-xs font-medium text-(--color-ink-600)">Lưu Niên {baoCaoCoBan.moiLuuNien.length} năm tới</p>
                  <div class="mt-1 flex gap-2">
                    {baoCaoCoBan.moiLuuNien.map((m) => (
                      <div class="flex-1 rounded-(--radius-control) border border-(--color-ivory-300) bg-white px-2 py-2 text-center">
                        <p class="text-xs font-medium text-(--color-ink-600)">{m.nhan}</p>
                        <p class="mt-0.5 text-sm font-bold" style={`color:${mauTheoDiemMoi(m.diem)}`}>{m.canChi}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          <div class="mt-6 space-y-6" id="ldbtd-cobantoanbo">
            {baoCaoCoBan.giaiDoan.length === 0 && (
              <p class="text-sm text-(--color-ink-600)">⚠️ Phần luận AI chưa chạy được (chưa cấu hình khoá AI trên máy chủ).</p>
            )}
            {baoCaoCoBan.giaiDoan.map((gd, i) => (
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-display text-lg font-bold text-(--color-gold-600)">{gd.tieuDe}</h3>
                  <button type="button" class="ldbtd-tts-btn text-sm text-(--color-gold-600)" data-tts-target={`ldbtd-cb-p-${i}`} aria-label={`Nghe ${gd.tieuDe}`}>🔊</button>
                </div>
                <p id={`ldbtd-cb-p-${i}`} class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-(--color-ink-800)">{gd.noiDung}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 text-xs text-(--color-ink-500)">{baoCaoCoBan.disclaimerCuoiBai}</p>
          {!coDonNangCaoChuaHienThi && (
            <div class="mt-6 rounded-(--radius-control) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-800)">
              <p>{baoCaoCoBan.ctaNangCao}</p>
              <Button id="ldbtd-mua-nang-cao" size="md" class="mt-3">Xem Luận Nâng Cao — {dinhDangTien(GIA_NANG_CAO)}</Button>
            </div>
          )}
        </section>
      )}

      {/* --- Đã mua Nâng Cao nhưng KHÔNG phải admin: không hiện trực tiếp, báo đã gửi qua email --- */}
      {coDonNangCaoChuaHienThi && !baoCaoNangCao && (
        <div class="mb-10 rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-6 text-sm text-(--color-ink-800)">
          <p class="font-display text-lg font-bold text-(--color-ink-950)">✅ Đã mua Luận Nâng Cao</p>
          <p class="mt-2">Bản luận giải đầy đủ (PDF) đã được gửi tới email tài khoản của bạn ngay sau khi thanh toán thành công. Vui lòng kiểm tra hộp thư (kể cả mục Spam/Quảng cáo).</p>
        </div>
      )}

      {/* --- Đã có báo cáo Nâng Cao (chỉ admin xem trực tiếp trên trang) --- */}
      {baoCaoNangCao && (
        <section class="mb-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Luận Nâng Cao</h2>
            {baoCaoNangCao.giaiDoan.length > 0 && (
              <button type="button" class="ldbtd-tts-btn shrink-0 rounded-full border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 px-3 py-1.5 text-xs font-medium text-(--color-gold-700)" data-tts-target="ldbtd-nangcaotoanbo">🔊 Nghe toàn bộ</button>
            )}
          </div>
          <div class="mt-6 space-y-6" id="ldbtd-nangcaotoanbo">
            {baoCaoNangCao.giaiDoan.length === 0 && (
              <p class="text-sm text-(--color-ink-600)">⚠️ Phần luận AI chưa chạy được (chưa cấu hình khoá AI trên máy chủ).</p>
            )}
            {baoCaoNangCao.giaiDoan.map((gd, i) => (
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-display text-lg font-bold text-(--color-gold-600)">{gd.tieuDe}</h3>
                  <button type="button" class="ldbtd-tts-btn text-sm text-(--color-gold-600)" data-tts-target={`ldbtd-nc-p-${i}`} aria-label={`Nghe ${gd.tieuDe}`}>🔊</button>
                </div>
                <p id={`ldbtd-nc-p-${i}`} class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-(--color-ink-800)">{gd.noiDung}</p>
                {gd.ma === "K" && (
                  <div class="mt-4 space-y-4">
                    <BieuDoGiaiDoanVan
                      tieuDe="Đồ hình Đại Vận trọn đời"
                      moTa={`So với Dụng Thần ${baoCaoNangCao.laSo.dungThan} · Hỷ Thần ${baoCaoNangCao.laSo.hyThan} · Kỵ Thần ${baoCaoNangCao.laSo.kyThan}`}
                      danhSach={baoCaoNangCao.daiVanBieuDo}
                    />
                    <BieuDoGiaiDoanVan
                      tieuDe="Đồ hình Lưu Niên — 10 năm tới"
                      moTa={`Từ năm ${baoCaoNangCao.luuNienBieuDo[0]?.nhan ?? ""} đến ${baoCaoNangCao.luuNienBieuDo.at(-1)?.nhan ?? ""}`}
                      danhSach={baoCaoNangCao.luuNienBieuDo}
                    />
                  </div>
                )}
              </div>
            ))}
          </div>
          <p class="mt-6 text-xs text-(--color-ink-500)">{baoCaoNangCao.disclaimerCuoiBai}</p>
        </section>
      )}

      {/* --- Form nhập ngày sinh + xem trước Free --- */}
      <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <h2 class="font-display text-xl font-bold text-(--color-ink-950)">
          {coDonCoBanChuaHienThi ? "Lập lá số khác" : "Lập lá số — xem gợi mở miễn phí"}
        </h2>
        <form id="ldbtd-form" class="mt-4 flex flex-col gap-4">
          <DateSelect idPrefix="ldbtd-sinh" label="Ngày sinh (dương lịch)" required yearsBack={90} yearsForward={0} />
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="ldbtd-gio" class="text-xs font-medium text-(--color-ink-600)">Giờ sinh <span class="text-(--color-cinnabar-400)">*</span></label>
              <select id="ldbtd-gio" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2.5 text-sm text-(--color-ink-800)">
                <option value="">Chọn giờ (0–23)</option>
                {gioOptions.map((h) => <option value={h}>{`${h}h — ${h}:00–${h}:59`}</option>)}
              </select>
            </div>
            <div>
              <label for="ldbtd-phut" class="text-xs font-medium text-(--color-ink-600)">Phút (nếu nhớ)</label>
              <input type="number" id="ldbtd-phut" min="0" max="59" placeholder="vd 20" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <div>
            <span class="text-xs font-medium text-(--color-ink-600)">Giới tính <span class="text-(--color-cinnabar-400)">*</span></span>
            <div class="mt-1.5 flex gap-3">
              <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) has-[:checked]:border-(--color-gold-500) has-[:checked]:bg-(--color-gold-400)/15">
                <input type="radio" name="ldbtd-gioi-tinh" value="Nam" /> Nam
              </label>
              <label class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) has-[:checked]:border-(--color-gold-500) has-[:checked]:bg-(--color-gold-400)/15">
                <input type="radio" name="ldbtd-gioi-tinh" value="Nữ" /> Nữ
              </label>
            </div>
          </div>
          <Button type="submit" size="lg">Xem gợi mở miễn phí</Button>
        </form>

        <div id="ldbtd-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

        <div id="ldbtd-free-result" class="mt-6 hidden rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-5">
          <div id="ldbtd-free-tutru" class="grid grid-cols-4 gap-2"></div>

          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div id="ldbtd-free-nguhanh" class="flex items-center gap-4 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3"></div>
            <div id="ldbtd-free-gauge" class="flex flex-col items-center justify-center rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3"></div>
          </div>

          <div id="ldbtd-free-daivan" class="mt-4 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3"></div>

          <div id="ldbtd-free-luunien" class="mt-4 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3"></div>

          <div class="mt-4 flex items-center justify-between gap-2">
            <p class="text-xs font-medium text-(--color-ink-600)">Gợi mở miễn phí</p>
            <button type="button" class="ldbtd-tts-btn shrink-0 rounded-full border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 px-3 py-1.5 text-xs font-medium text-(--color-gold-700)" data-tts-target="ldbtd-free-text">🔊 Nghe thử</button>
          </div>
          <p id="ldbtd-free-text" class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-(--color-ink-800)"></p>

          <div class="mt-5 border-t border-(--color-gold-400)/30 pt-4">
            {!user && (
              <p class="text-sm text-(--color-ink-700)">
                Cần <a href="/hoc-vien/dang-nhap" class="font-bold text-(--color-gold-600) hover:underline">đăng nhập</a> để mua bản luận giải đầy đủ (báo cáo gắn theo tài khoản, xem lại không mất phí).
              </p>
            )}
            {user && !coDonCoBanChuaHienThi && <MaKhuyenMai idPrefix="ldbtd-ma" toolSlug={TOOL_SLUG_CO_BAN} giaGoc={GIA_CO_BAN} />}
            {user && !coDonCoBanChuaHienThi && (
              <Button id="ldbtd-mua-co-ban" size="lg" class="mt-4 w-full sm:w-auto">Xem Luận Cơ Bản — {dinhDangTien(GIA_CO_BAN)}</Button>
            )}
          </div>
        </div>

        <div id="ldbtd-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
          <p class="font-medium text-(--color-ink-900)">⏳ Đang xử lý…</p>
        </div>
        <div id="ldbtd-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
          <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="ldbtd-so-tien"></span></p>
          <img id="ldbtd-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
          <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="ldbtd-order-code"></strong></p>
          <p id="ldbtd-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
        </div>
      </section>
    </div>
  </Container>
</BaseLayout>

<script define:vars={{ daDangNhap: !!user }}>
  window.__ldbtdDaDangNhap = daDangNhap;
</script>
<script>
  import { readDateSelects } from "../../lib/date-select";

  const form = document.getElementById("ldbtd-form") as HTMLFormElement | null;
  if (form) {
    const loiEl = document.getElementById("ldbtd-loi")!;
    const dangChayEl = document.getElementById("ldbtd-dang-chay")!;
    const freeResultEl = document.getElementById("ldbtd-free-result")!;
    const freeTextEl = document.getElementById("ldbtd-free-text")!;

    const NGU_HANH_COLOR: Record<string, string> = { Mộc: "#16a34a", Hỏa: "#dc2626", Thổ: "#8b5a2b", Kim: "#64748b", Thủy: "#2563eb" };
    const MAU_VANG = "#ad8843";

    function renderTuTru(tuTru: { tru: string; can: string; chi: string; hanhCan: string; hanhChi: string }[]) {
      const el = document.getElementById("ldbtd-free-tutru");
      if (!el) return;
      el.innerHTML = tuTru.map((t) => `
        <div class="rounded-lg border p-2 text-center" style="border-color:${NGU_HANH_COLOR[t.hanhCan]}55;background:${NGU_HANH_COLOR[t.hanhCan]}12;">
          <p class="text-[10px] font-medium text-(--color-ink-500)">${t.tru}</p>
          <p class="text-sm font-bold" style="color:${NGU_HANH_COLOR[t.hanhCan]}">${t.can}</p>
          <p class="text-sm font-bold" style="color:${NGU_HANH_COLOR[t.hanhChi]}">${t.chi}</p>
        </div>
      `).join("");
    }

    function renderNguHanhDonut(phanBo: Record<string, number>) {
      const el = document.getElementById("ldbtd-free-nguhanh");
      if (!el) return;
      const order = ["Mộc", "Hỏa", "Thổ", "Kim", "Thủy"];
      const total = order.reduce((s, h) => s + (phanBo[h] || 0), 0) || 1;
      let acc = 0;
      const stops = order.map((h) => {
        const start = (acc / total) * 100;
        acc += phanBo[h] || 0;
        const end = (acc / total) * 100;
        return `${NGU_HANH_COLOR[h]} ${start}% ${end}%`;
      }).join(", ");
      el.innerHTML = `
        <div class="relative size-20 shrink-0 rounded-full" style="background: conic-gradient(${stops});">
          <div class="absolute inset-[18%] flex items-center justify-center rounded-full bg-(--color-ivory-50) text-center text-[9px] font-semibold leading-tight text-(--color-ink-700)">Ngũ<br/>Hành</div>
        </div>
        <div class="flex flex-col gap-1 text-xs">
          ${order.map((h) => `<div class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-full" style="background:${NGU_HANH_COLOR[h]}"></span><span class="text-(--color-ink-700)">${h}: ${phanBo[h] || 0}</span></div>`).join("")}
        </div>
      `;
    }

    function renderGauge(diem: number, capDo: string) {
      const el = document.getElementById("ldbtd-free-gauge");
      if (!el) return;
      const clamped = Math.max(0, Math.min(100, diem));
      const circumference = Math.PI * 50;
      const offset = circumference * (1 - clamped / 100);
      el.innerHTML = `
        <svg viewBox="0 0 120 68" class="w-36">
          <path d="M10,60 A50,50 0 0 1 110,60" fill="none" stroke="#e7ddc9" stroke-width="10" stroke-linecap="round"/>
          <path d="M10,60 A50,50 0 0 1 110,60" fill="none" stroke="${MAU_VANG}" stroke-width="10" stroke-linecap="round"
                stroke-dasharray="${circumference}" stroke-dashoffset="${offset}"/>
        </svg>
        <p class="-mt-3 text-center text-lg font-bold text-(--color-ink-900)">${clamped}%</p>
        <p class="text-center text-xs text-(--color-ink-600)">Vượng Suy: ${capDo}</p>
      `;
    }

    function renderDaiVanSong(daiVan: { can: string; chi: string; startAge: number; endAge: number; diem: number }[]) {
      const el = document.getElementById("ldbtd-free-daivan");
      if (!el || !daiVan.length) return;
      const w = 600, h = 130, padX = 24, padY = 18;
      const n = daiVan.length;
      const xStep = n > 1 ? (w - padX * 2) / (n - 1) : 0;
      const yMid = h / 2;
      const yScale = h / 2 - padY;
      const pts = daiVan.map((v, i) => ({ x: padX + i * xStep, y: yMid - v.diem * yScale, v }));
      let path = `M ${pts[0].x},${pts[0].y}`;
      for (let i = 1; i < pts.length; i++) {
        const p0 = pts[i - 1], p1 = pts[i];
        const cx = (p0.x + p1.x) / 2;
        path += ` C ${cx},${p0.y} ${cx},${p1.y} ${p1.x},${p1.y}`;
      }
      const areaPath = `${path} L ${pts[pts.length - 1].x},${yMid} L ${pts[0].x},${yMid} Z`;
      const dots = pts.map((p) => `<circle cx="${p.x}" cy="${p.y}" r="3" fill="${p.v.diem >= 0 ? "#16a34a" : "#c0392b"}"/>`).join("");
      const labels = pts.map((p) => `<text x="${p.x}" y="${h - 2}" font-size="9" text-anchor="middle" fill="#8a8270">${p.v.startAge}</text>`).join("");
      el.innerHTML = `
        <p class="mb-1 text-xs font-medium text-(--color-ink-600)">Xu hướng Đại Vận theo tuổi (ước tính thô theo Dụng/Hỷ/Kỵ Thần — bản luận đầy đủ sẽ phân tích chi tiết từng vận)</p>
        <svg viewBox="0 0 ${w} ${h}" class="w-full">
          <line x1="${padX}" y1="${yMid}" x2="${w - padX}" y2="${yMid}" stroke="#d8cdb4" stroke-width="1"/>
          <path d="${areaPath}" fill="${MAU_VANG}22" stroke="none"/>
          <path d="${path}" fill="none" stroke="${MAU_VANG}" stroke-width="2"/>
          ${dots}
          ${labels}
        </svg>
      `;
    }
    function renderLuuNienFree(luuNien: { year: number; tuoi: number; can: string; chi: string; diem: number }[]) {
      const el = document.getElementById("ldbtd-free-luunien");
      if (!el || !luuNien.length) return;
      const the = luuNien.map((n) => {
        const mau = n.diem > 0 ? "#16a34a" : n.diem < 0 ? "#c0392b" : "#8a8270";
        return `
          <div class="flex-1 rounded-(--radius-control) border border-(--color-ivory-300) bg-white px-2 py-2 text-center">
            <p class="text-xs font-medium text-(--color-ink-600)">${n.year} (${n.tuoi}t)</p>
            <p class="mt-0.5 text-sm font-bold" style="color:${mau}">${n.can} ${n.chi}</p>
          </div>`;
      }).join("");
      el.innerHTML = `
        <p class="mb-2 text-xs font-medium text-(--color-ink-600)">Lưu Niên ${luuNien.length} năm tới (ước tính thô so Dụng/Hỷ/Kỵ Thần nguyên cục — bản luận đầy đủ tính lại theo đúng Đại Vận từng năm, kèm luận chi tiết)</p>
        <div class="flex gap-2">${the}</div>
      `;
    }
    const thanhToanEl = document.getElementById("ldbtd-thanh-toan")!;
    const qrImg = document.getElementById("ldbtd-qr") as HTMLImageElement;
    const orderCodeEl = document.getElementById("ldbtd-order-code")!;
    const trangThaiEl = document.getElementById("ldbtd-trang-thai")!;
    const soTienEl = document.getElementById("ldbtd-so-tien")!;
    const nutMuaCoBan = document.getElementById("ldbtd-mua-co-ban") as HTMLButtonElement | null;
    const nutMuaNangCao = document.getElementById("ldbtd-mua-nang-cao") as HTMLButtonElement | null;

    let pollTimer: ReturnType<typeof setInterval> | null = null;
    let dangHoi = false;
    const doc = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";

    const baoLoi = (msg: string) => { dangChayEl.classList.add("hidden"); loiEl.textContent = msg; loiEl.classList.remove("hidden"); };
    const dungCho = () => { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } };

    function docDauVao(): Record<string, unknown> | null {
      const sinh = readDateSelects("ldbtd-sinh");
      if (!sinh) { baoLoi("Vui lòng chọn đầy đủ ngày, tháng, năm sinh."); return null; }
      const gio = doc("ldbtd-gio");
      if (gio === "") { baoLoi("Vui lòng chọn giờ sinh."); return null; }
      const gioiTinh = (document.querySelector('input[name="ldbtd-gioi-tinh"]:checked') as HTMLInputElement | null)?.value;
      if (!gioiTinh) { baoLoi("Vui lòng chọn giới tính."); return null; }
      return {
        ngaySinh: { year: sinh.year, month: sinh.month, day: sinh.day },
        gio: Number(gio),
        ...(doc("ldbtd-phut") ? { phut: Number(doc("ldbtd-phut")) } : {}),
        gioiTinh,
      };
    }

    async function kiemTra(orderCode: string) {
      if (dangHoi) return;
      dangHoi = true;
      try {
        const res = await fetch(`/api/dai-cat-loi/luan-giai-bat-tu-toan-dien/result?orderCode=${encodeURIComponent(orderCode)}`);
        const data = await res.json();
        if (!data.ok) return;
        if (data.status === "cancelled") { dungCho(); trangThaiEl.textContent = "Đơn hàng đã bị hủy."; return; }
        if (data.status !== "confirmed") return;
        dungCho();
        window.location.href = "/dai-cat-loi/luan-giai-bat-tu-toan-dien";
      } catch {
        // mạng chập chờn — nhịp sau thử lại
      } finally {
        dangHoi = false;
      }
    }

    async function muaTang(tang: "co_ban" | "nang_cao") {
      const dauVao = docDauVao();
      if (!dauVao) return;

      const payload = { ...dauVao, tang, maKhuyenMai: doc("ldbtd-ma-input") || undefined };
      dangChayEl.classList.remove("hidden");
      loiEl.classList.add("hidden");
      try {
        const res = await fetch("/api/dai-cat-loi/luan-giai-bat-tu-toan-dien/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
        dangChayEl.classList.add("hidden");
        orderCodeEl.textContent = data.orderCode;

        if (data.mienPhi) { dangChayEl.classList.remove("hidden"); await kiemTra(data.orderCode); return; }

        soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
        qrImg.src = data.qrUrl;
        trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
        thanhToanEl.classList.remove("hidden");
        thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
        pollTimer = setInterval(() => kiemTra(data.orderCode), 3000);
      } catch {
        baoLoi("Có lỗi xảy ra. Vui lòng thử lại.");
      }
    }

    nutMuaCoBan?.addEventListener("click", () => muaTang("co_ban"));
    nutMuaNangCao?.addEventListener("click", () => muaTang("nang_cao"));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      loiEl.classList.add("hidden");
      const dauVao = docDauVao();
      if (!dauVao) return;

      dangChayEl.classList.remove("hidden");
      freeResultEl.classList.add("hidden");
      try {
        const res = await fetch("/api/dai-cat-loi/luan-giai-bat-tu-toan-dien/xem-truoc", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(dauVao),
        });
        const data = await res.json();
        dangChayEl.classList.add("hidden");
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không lập được lá số.");

        const dongDieuHau = data.laSo.dieuHauNote ? `\n${data.laSo.dieuHauNote}` : "";
        freeTextEl.textContent = `Nhật Chủ ${data.laSo.nhatChu} — Dụng Thần ${data.laSo.dungThan} · Hỷ Thần ${data.laSo.hyThan} · Kỵ Thần ${data.laSo.kyThan}${dongDieuHau}\n\n${data.goiMo}`;
        if (data.doHinh) {
          renderTuTru(data.doHinh.tuTru);
          renderNguHanhDonut(data.doHinh.nguHanhPhanBo);
          renderGauge(data.doHinh.diemVuongSuy, data.laSo.capDoVuongSuy);
          renderDaiVanSong(data.doHinh.daiVan);
          renderLuuNienFree(data.doHinh.luuNien);
        }
        freeResultEl.classList.remove("hidden");
        freeResultEl.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch {
        baoLoi("Có lỗi xảy ra. Vui lòng thử lại.");
      }
    });
  }
</script>

<script>
  // Nghe bằng giọng đọc có sẵn của trình duyệt (Web Speech API) — miễn phí, không cần API key/backend.
  // Chất lượng giọng phụ thuộc thiết bị của khách; ưu tiên giọng tiếng Việt (vi-VN) nếu máy có.
  const tongHopGiong = window.speechSynthesis;
  let nutDangDoc: HTMLButtonElement | null = null;
  let danhSachGiong: SpeechSynthesisVoice[] = [];

  // Chrome/Edge tải danh sách giọng KHÔNG đồng bộ — lần gọi getVoices() đầu tiên (đặc biệt trước khi
  // trang tương tác) rất hay trả về mảng rỗng, khiến code rơi về giọng mặc định (thường là tiếng Anh)
  // dù máy khách THỰC SỰ có giọng tiếng Việt. Phải nghe sự kiện "voiceschanged" để lấy đúng danh sách.
  function capNhatDanhSachGiong() {
    const v = tongHopGiong.getVoices();
    if (v.length > 0) danhSachGiong = v;
  }
  capNhatDanhSachGiong();
  tongHopGiong.addEventListener("voiceschanged", capNhatDanhSachGiong);

  function timGiongTiengViet(): SpeechSynthesisVoice | undefined {
    const vi = danhSachGiong.filter((v) => v.lang === "vi-VN" || v.lang.startsWith("vi"));
    if (vi.length === 0) return undefined;
    return (
      vi.find((v) => /nữ|female|women/i.test(v.name)) ??
      vi.find((v) => !/nam\b|male|men\b/i.test(v.name)) ??
      vi[0]
    );
  }

  function dungDoc() {
    tongHopGiong.cancel();
    if (nutDangDoc) { nutDangDoc.textContent = nutDangDoc.dataset.nhanGoc ?? "🔊"; nutDangDoc = null; }
  }

  function docVanBan(btn: HTMLButtonElement, text: string) {
    const utter = new SpeechSynthesisUtterance(text);
    const giong = timGiongTiengViet();
    if (giong) utter.voice = giong;
    utter.lang = "vi-VN";
    utter.rate = 0.95;
    utter.onend = () => { if (nutDangDoc === btn) dungDoc(); };
    utter.onerror = () => { if (nutDangDoc === btn) dungDoc(); };

    btn.dataset.nhanGoc = btn.dataset.nhanGoc ?? btn.textContent ?? "🔊";
    btn.textContent = btn.dataset.nhanGoc?.includes("toàn bộ") ? "⏸ Dừng" : "⏸";
    nutDangDoc = btn;
    tongHopGiong.speak(utter);
  }

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>(".ldbtd-tts-btn");
    if (!btn) return;
    const targetId = btn.dataset.ttsTarget;
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;

    const dangDocDungNut = nutDangDoc === btn;
    dungDoc();
    if (dangDocDungNut) return; // bấm lại nút đang đọc → chỉ dừng.

    const text = target.innerText.trim();
    if (!text) return;

    // Nếu danh sách giọng chưa kịp tải (mảng rỗng), đợi 1 nhịp "voiceschanged" rồi mới đọc — tránh
    // đọc nhầm giọng mặc định trước khi kịp biết máy khách có giọng tiếng Việt hay không.
    if (danhSachGiong.length === 0) {
      let daDoc = false;
      const cho = () => {
        if (daDoc) return;
        daDoc = true;
        tongHopGiong.removeEventListener("voiceschanged", cho);
        docVanBan(btn, text);
      };
      tongHopGiong.addEventListener("voiceschanged", cho);
      setTimeout(cho, 300); // phòng khi trình duyệt không bắn sự kiện (Safari) — vẫn đọc sau tối đa 300ms.
      return;
    }
    docVanBan(btn, text);
  });

  document.addEventListener("astro:before-swap", dungDoc);
</script>
