---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Ngày đại cát cá nhân"
  description="Nhập năm sinh và chọn tháng cần xem — hệ thống tự quét toàn bộ tháng và tìm ra 3-5 ngày tốt nhất dành riêng cho bạn."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Ngày đại cát cá nhân"
    description="Không phải danh sách ngày tốt chung — hệ thống tính riêng cho tuổi và mục đích của bạn."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Ngày đại cát cá nhân" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <form id="dai-cat-form" class="flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <div>
          <label for="dai-cat-nam-sinh" class="text-sm font-medium text-(--color-ink-800)">Năm sinh của bạn</label>
          <input type="number" id="dai-cat-nam-sinh" placeholder="vd. 1990" min="1900" max="2100" required class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-sm font-medium text-(--color-ink-800)">Tháng cần xem</p>
            <div class="mt-1.5 grid grid-cols-2 gap-2">
              <select id="dai-cat-thang" aria-label="Tháng" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
              <select id="dai-cat-nam" aria-label="Năm" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
            </div>
          </div>
          <div>
            <label for="dai-cat-purpose" class="text-sm font-medium text-(--color-ink-800)">Mục đích (tùy chọn)</label>
            <select id="dai-cat-purpose" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
              <option value="TONG_VAN">Tổng vận</option>
              <option value="CAU_TAI">Cầu tài</option>
              <option value="CONG_VIEC">Công việc</option>
              <option value="GIAO_TIEP_TIEC_TUNG">Giao tế · tiệc tùng</option>
              <option value="TINH_CAM">Tình cảm</option>
            </select>
          </div>
        </div>
        <Button type="submit" size="lg">Tìm ngày đại cát</Button>
      </form>

      <div id="dai-cat-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <div id="dai-cat-ket-qua" class="mt-6 hidden space-y-6">
        <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p id="dai-cat-noi-bat" class="text-sm font-semibold text-(--color-cinnabar-500)"></p>
          <p class="mt-2 text-xs font-bold uppercase tracking-wide text-amber-600">🌟 Ngày đại cát nhất</p>
          <div id="dai-cat-tot-nhat" class="mt-3 space-y-1.5"></div>
        </div>

        <div id="dai-cat-nen-tranh-wrap" class="hidden rounded-2xl border-2 border-slate-200 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-500">⚠️ Ngày nên tránh</p>
          <div id="dai-cat-nen-tranh" class="mt-3 space-y-1.5"></div>
        </div>

        <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Toàn bộ tháng</p>
          <div id="dai-cat-list" class="mt-3 max-h-[420px] space-y-1.5 overflow-y-auto"></div>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface CatTinh {
    tang: string | null;
    nhan: string;
  }
  interface NgayDaiCat {
    solarDate: { year: number; month: number; day: number };
    lunarDate: { day: number };
    diem: number;
    hang: string;
    nhan: string;
    catCaNhan?: CatTinh | null;
  }

  const MAU_TANG: Record<string, string> = {
    "chan-loc": "bg-amber-100 text-amber-700",
    "chan-duong-quy": "bg-violet-100 text-violet-700",
    "chan-am-quy": "bg-indigo-100 text-indigo-700",
    "loc": "bg-amber-50 text-amber-600 ring-1 ring-amber-200",
    "tam-hop": "bg-emerald-100 text-emerald-700",
    "luc-hop": "bg-teal-100 text-teal-700",
  };
  const ICON_TANG: Record<string, string> = {
    "chan-loc": "💰", "chan-duong-quy": "🌤️", "chan-am-quy": "🌙", "loc": "🪙", "tam-hop": "☯", "luc-hop": "☯",
  };
  /** Badge tiêu chí cát tinh cá nhân — để dễ lọc ngày hợp tuổi. */
  function badgeCat(c: CatTinh | null | undefined): string {
    if (!c || !c.tang) return "";
    const mau = MAU_TANG[c.tang] ?? "bg-slate-100 text-slate-600";
    return `<span class="mt-1 inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-bold ${mau}">${ICON_TANG[c.tang] ?? ""} ${c.nhan}</span>`;
  }
  interface DaiCatResult {
    purpose: string;
    ngayXepHang: NgayDaiCat[];
    ngayTotNhat: NgayDaiCat[];
    ngayNenTranh: NgayDaiCat[];
  }

  const PURPOSE_LABEL: Record<string, string> = {
    TONG_VAN: "tổng vận",
    CAU_TAI: "cầu tài",
    CONG_VIEC: "công việc",
    GIAO_TIEP_TIEC_TUNG: "giao tế · tiệc tùng",
    TINH_CAM: "tình cảm",
  };

  const namSinhInput = document.getElementById("dai-cat-nam-sinh") as HTMLInputElement;
  const thangSelect = document.getElementById("dai-cat-thang") as HTMLSelectElement;
  const namSelect = document.getElementById("dai-cat-nam") as HTMLSelectElement;
  const purposeSelect = document.getElementById("dai-cat-purpose") as HTMLSelectElement;
  const form = document.getElementById("dai-cat-form") as HTMLFormElement;
  const loiEl = document.getElementById("dai-cat-loi")!;
  const ketQuaEl = document.getElementById("dai-cat-ket-qua")!;
  const noiBatEl = document.getElementById("dai-cat-noi-bat")!;
  const totNhatEl = document.getElementById("dai-cat-tot-nhat")!;
  const nenTranhWrapEl = document.getElementById("dai-cat-nen-tranh-wrap")!;
  const nenTranhEl = document.getElementById("dai-cat-nen-tranh")!;
  const listEl = document.getElementById("dai-cat-list")!;

  const today = new Date();
  for (let m = 1; m <= 12; m++) thangSelect.insertAdjacentHTML("beforeend", `<option value="${m}" ${m === today.getMonth() + 1 ? "selected" : ""}>Tháng ${m}</option>`);
  for (let y = today.getFullYear() - 1; y <= today.getFullYear() + 3; y++) namSelect.insertAdjacentHTML("beforeend", `<option value="${y}" ${y === today.getFullYear() ? "selected" : ""}>${y}</option>`);

  function dongNgay(n: NgayDaiCat, noiBat: boolean): string {
    const ngayStr = `${String(n.solarDate.day).padStart(2, "0")}/${String(n.solarDate.month).padStart(2, "0")}/${n.solarDate.year}`;
    const gioLink = `/dai-cat-loi/gio-tot-trong-ngay?year=${n.solarDate.year}&month=${n.solarDate.month}&day=${n.solarDate.day}`;
    return `
      <div class="flex items-center justify-between gap-2 rounded-lg border ${noiBat ? "border-amber-300 bg-amber-50/50" : "border-slate-100"} px-3 py-2.5">
        <div>
          <p class="text-sm font-bold text-slate-900">${ngayStr} (${n.lunarDate.day} âm)</p>
          <p class="text-sm">${nhanDotHtml(n.nhan)} — ${n.diem}/10</p>
          ${badgeCat(n.catCaNhan)}
        </div>
        <a href="${gioLink}" class="shrink-0 rounded-(--radius-control) border border-(--color-gold-400) px-3 py-1.5 text-xs font-semibold text-(--color-gold-500) hover:bg-(--color-gold-400)/10">Xem giờ tốt</a>
      </div>`;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const qs = `year=${namSelect.value}&month=${thangSelect.value}&namSinh=${namSinhInput.value}&purpose=${purposeSelect.value}&timeZone=Asia/Ho_Chi_Minh`;

    let result: DaiCatResult;
    try {
      const res = await fetch(`/api/ngay-dai-cat-ca-nhan?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      result = data;
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
      return;
    }

    const noiBat = result.ngayTotNhat[0];
    if (noiBat) {
      const ngayStr = `${String(noiBat.solarDate.day).padStart(2, "0")}/${String(noiBat.solarDate.month).padStart(2, "0")}`;
      noiBatEl.textContent = `🌟 Ngày nổi bật nhất cho ${PURPOSE_LABEL[result.purpose] ?? "tổng vận"}: ${ngayStr} — ${noiBat.diem}/10`;
    }

    totNhatEl.innerHTML = result.ngayTotNhat.map((n, i) => dongNgay(n, i === 0)).join("");

    if (result.ngayNenTranh.length > 0) {
      nenTranhEl.innerHTML = result.ngayNenTranh.map((n) => dongNgay(n, false)).join("");
      nenTranhWrapEl.classList.remove("hidden");
    } else {
      nenTranhWrapEl.classList.add("hidden");
    }

    listEl.innerHTML = result.ngayXepHang.map((n) => dongNgay(n, false)).join("");

    ketQuaEl.classList.remove("hidden");
  });
</script>
