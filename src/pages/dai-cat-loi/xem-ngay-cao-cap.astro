---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";

// ⚠️ KHÔNG bắt đăng nhập (chủ dự án chốt 2026-08-16) — đồng bộ với 2 module thu phí còn lại.
// Nhờ vậy trang quay lại được dạng tĩnh (prerender), tải nhanh hơn và Google index thoải mái.
// Kết quả sau khi thanh toán truy cập bằng orderCode làm "vé".
export const prerender = true;

const SON_24 = [
  "Tý", "Quý", "Sửu", "Cấn", "Dần", "Giáp", "Mão", "Ất", "Thìn", "Tốn", "Tỵ", "Bính",
  "Ngọ", "Đinh", "Mùi", "Khôn", "Thân", "Canh", "Dậu", "Tân", "Tuất", "Càn", "Hợi", "Nhâm",
];
// Cờ thử nghiệm: true = bỏ bước thanh toán, nộp form ra kết quả ngay (không tạo đơn thật).
// Khai báo ở frontmatter để MARKUP cũng dùng được — các ô chỉ có nghĩa khi thu phí (số điện
// thoại, mã khuyến mãi) phải ẩn đi lúc đang thử nghiệm, nếu không khách nhập mã, thấy báo giảm
// giá thành công, rồi form lại nộp sang test-calculate: mã không đi đâu cả mà khách tưởng đã
// dùng mất mã tặng. Script đọc lại cờ này qua data-test-mode trên thẻ form (1 nguồn sự thật).
// ĐÃ BẬT THU PHÍ (chủ dự án chốt 2026-08-18): khách thanh toán thật; admin vẫn được checkout-cong-cu
// tạo đơn 0đ tự xác nhận (cờ laQuanTri từ phiên đăng nhập ở checkout.ts) nên test trọn luồng miễn phí.
const TEST_MODE = false;

const TOOL_SLUG = "xem-ngay-cao-cap";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
import XemNgayCaoCap from "../../components/tools/XemNgayCaoCap.astro";
---

<BaseLayout
  title="Xem Ngày Cao Cấp (Động Thổ / Nhập Trạch)"
  description="Giám định ngày động thổ / nhập trạch theo Huyền Không Đại Quái: kiểm Ngũ Hoàng, Tam Sát, Bát Sát, Thái Tuế, Tuế Phá rồi luận cách cục Tam Tài Thiên - Địa - Nhân giao."
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Xem Ngày Cao Cấp — Động Thổ / Nhập Trạch"
    description="Phương pháp lõi Huyền Không Đại Quái: bắt đầu từ tọa nhà, lọc phương vị sát trước, rồi mới luận cách cục Tam Tài Thiên - Địa - Nhân giao."
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Xem Ngày Cao Cấp" },
    ]}
  />
  <VipQuyenBanner />

  <XemNgayCaoCap />
</BaseLayout>
