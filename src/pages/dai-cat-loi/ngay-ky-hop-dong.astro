---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";

export const prerender = true;
---

<BaseLayout
  title="Ngày ký hợp đồng"
  description="Tự động tìm và xếp hạng ngày đẹp cho ký kết, giao dịch, hợp tác — có thể xét thêm tuổi người ký."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Ngày ký hợp đồng"
    description="Chọn tháng cần xem — hệ thống tự xếp hạng ngày đẹp nhất cho ký kết/giao dịch. Nhập năm sinh người ký nếu muốn xét thêm tuổi."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Ngày ký hợp đồng" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <form id="ky-hop-dong-form" class="flex flex-col gap-3 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6 sm:flex-row sm:items-end">
        <div class="flex-1">
          <p class="text-sm font-medium text-(--color-ink-800)">Tháng cần xem</p>
          <div class="mt-1.5 grid grid-cols-2 gap-2">
            <select id="ky-hop-dong-thang" aria-label="Tháng" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
            <select id="ky-hop-dong-nam" aria-label="Năm" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
          </div>
        </div>
        <div class="flex-1">
          <label for="ky-hop-dong-nam-sinh" class="text-sm font-medium text-(--color-ink-800)">Năm sinh người ký (tùy chọn)</label>
          <input type="number" id="ky-hop-dong-nam-sinh" placeholder="vd. 1988" min="1900" max="2100" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
      </form>

      <div id="ky-hop-dong-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">✍️ Ngày ký hợp đồng</p>
        <div id="ky-hop-dong-list" class="mt-3 max-h-[520px] space-y-1.5 overflow-y-auto"></div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  interface KyHopDongNgay {
    solarDate: { year: number; month: number; day: number };
    lunarDate: { day: number };
    diem: number;
    hang: string;
    nhan: string;
  }
  interface KyHopDongResult {
    ngayXepHang: KyHopDongNgay[];
  }

  const thangSelect = document.getElementById("ky-hop-dong-thang") as HTMLSelectElement;
  const namSelect = document.getElementById("ky-hop-dong-nam") as HTMLSelectElement;
  const namSinhInput = document.getElementById("ky-hop-dong-nam-sinh") as HTMLInputElement;
  const loiEl = document.getElementById("ky-hop-dong-loi")!;
  const listEl = document.getElementById("ky-hop-dong-list")!;

  const today = new Date();
  for (let m = 1; m <= 12; m++) thangSelect.insertAdjacentHTML("beforeend", `<option value="${m}" ${m === today.getMonth() + 1 ? "selected" : ""}>Tháng ${m}</option>`);
  for (let y = today.getFullYear() - 1; y <= today.getFullYear() + 3; y++) namSelect.insertAdjacentHTML("beforeend", `<option value="${y}" ${y === today.getFullYear() ? "selected" : ""}>${y}</option>`);

  async function load() {
    loiEl.classList.add("hidden");
    listEl.innerHTML = '<p class="py-2 text-center text-sm text-slate-500">Đang tính điểm...</p>';

    let qs = `year=${namSelect.value}&month=${thangSelect.value}&timeZone=Asia/Ho_Chi_Minh`;
    const namSinh = namSinhInput.value;
    if (namSinh) qs += `&namSinhNguoiKy=${namSinh}`;

    let result: KyHopDongResult;
    try {
      const res = await fetch(`/api/ngay-ky-hop-dong?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        listEl.innerHTML = "";
        return;
      }
      result = data;
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
      listEl.innerHTML = "";
      return;
    }

    listEl.innerHTML = result.ngayXepHang
      .map((n) => {
        const ngayStr = `${String(n.solarDate.day).padStart(2, "0")}/${String(n.solarDate.month).padStart(2, "0")}/${n.solarDate.year}`;
        const gioLink = `/dai-cat-loi/gio-tot-trong-ngay?year=${n.solarDate.year}&month=${n.solarDate.month}&day=${n.solarDate.day}&purpose=KY_HOP_DONG`;
        return `
          <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-100 px-3 py-2.5">
            <div>
              <p class="text-sm font-bold text-slate-900">${ngayStr} (${n.lunarDate.day} âm)</p>
              <p class="text-sm">${n.nhan} — ${n.diem}/10</p>
            </div>
            <a href="${gioLink}" class="shrink-0 rounded-(--radius-control) border border-(--color-gold-400) px-3 py-1.5 text-xs font-semibold text-(--color-gold-500) hover:bg-(--color-gold-400)/10">Xem giờ ký hợp đồng</a>
          </div>`;
      })
      .join("");
  }

  thangSelect.addEventListener("change", load);
  namSelect.addEventListener("change", load);
  namSinhInput.addEventListener("change", load);
  load();
</script>
