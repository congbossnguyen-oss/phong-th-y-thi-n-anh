---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";

export const prerender = true;
---

<BaseLayout
  title="Ngày ký hợp đồng"
  description="Tự động tìm và xếp hạng ngày đẹp cho ký kết, giao dịch, hợp tác — có thể xét thêm tuổi người ký."
  appShell
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Ngày ký hợp đồng"
    description="Chọn tháng cần xem — hệ thống tự xếp hạng ngày đẹp nhất cho ký kết/giao dịch. Nhập năm sinh người ký nếu muốn xét thêm tuổi."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Ngày ký hợp đồng" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <form id="ky-hop-dong-form" class="flex flex-col gap-3 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6 sm:flex-row sm:items-end">
        <div class="flex-1">
          <p class="text-sm font-medium text-(--color-ink-800)">Tháng cần xem</p>
          <div class="mt-1.5 grid grid-cols-2 gap-2">
            <select id="ky-hop-dong-thang" aria-label="Tháng" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
            <select id="ky-hop-dong-nam" aria-label="Năm" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
          </div>
        </div>
        <div class="flex-1">
          <label for="ky-hop-dong-nam-sinh" class="text-sm font-medium text-(--color-ink-800)">Năm sinh người ký (tùy chọn)</label>
          <input type="number" id="ky-hop-dong-nam-sinh" placeholder="vd. 1988" min="1900" max="2100" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
      </form>

      <div id="ky-hop-dong-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">✍️ Ngày ký hợp đồng</p>
        <div id="ky-hop-dong-list" class="mt-3 max-h-[520px] space-y-1.5 overflow-y-auto"></div>
      </div>
    </div>
  </Container>
  <BottomNav />
</BaseLayout>

<script>
  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface QuanHeTuoi {
    diem: number;
    can: { moTa: string };
    chi: { moTa: string; xung: boolean; hinh: boolean; hai: boolean; pha: boolean; tamHop: boolean; lucHop: boolean };
    nguHanh: { moTa: string };
  }
  interface KyHopDongNgay {
    solarDate: { year: number; month: number; day: number };
    lunarDate: { day: number };
    diem: number;
    hang: string;
    nhan: string;
    nguoiKy?: QuanHeTuoi | null;
    catCaNhan?: { chanLoc: boolean; chanDuongQuy: boolean; chanAmQuy: boolean; loc: boolean } | null;
  }

  /** Badge sao cát cá nhân theo Can năm sinh: Chân Lộc / Chân Dương Quý / Chân Âm Quý / Lộc (địa chi). */
  function badgeChan(c: { chanLoc: boolean; chanDuongQuy: boolean; chanAmQuy: boolean; loc: boolean } | null | undefined): string {
    if (!c) return "";
    const ds: string[] = [];
    if (c.chanLoc) ds.push(`<span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-700" title="Ngày Chân Lộc theo Can năm sinh — vượng tài lộc, tốt nhất cho cá nhân">💰 Chân Lộc</span>`);
    else if (c.loc) ds.push(`<span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-600 ring-1 ring-amber-200" title="Lộc theo địa chi (chỉ trùng Chi Lộc, chưa đủ Can) — tạm được">🪙 Lộc (địa chi)</span>`);
    if (c.chanDuongQuy) ds.push(`<span class="inline-flex items-center rounded-full bg-violet-100 px-2 py-0.5 text-[11px] font-bold text-violet-700" title="Ngày Chân Dương Quý Nhân theo Can năm sinh — quý nhân phù trợ (ban ngày)">🌤️ Chân Dương Quý Nhân</span>`);
    if (c.chanAmQuy) ds.push(`<span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-[11px] font-bold text-indigo-700" title="Ngày Chân Âm Quý Nhân theo Can năm sinh — quý nhân phù trợ (ban đêm)">🌙 Chân Âm Quý Nhân</span>`);
    return ds.length ? `<span class="mt-1 flex flex-wrap gap-1">${ds.join("")}</span>` : "";
  }

  /** Badge quan hệ ngày ↔ tuổi người ký — chỉ hiện khi đã nhập năm sinh. */
  function badgeTuoi(t: QuanHeTuoi | null | undefined): string {
    if (!t) return "";
    const c = t.chi;
    let nhan: string, mau: string;
    if (c.xung) { nhan = "⚠ Xung tuổi người ký"; mau = "bg-rose-100 text-rose-700"; }
    else if (c.hinh || c.hai || c.pha) { nhan = "Hình/Hại/Phá tuổi"; mau = "bg-amber-100 text-amber-700"; }
    else if (c.tamHop) { nhan = "✓ Tam hợp tuổi"; mau = "bg-emerald-100 text-emerald-700"; }
    else if (c.lucHop) { nhan = "✓ Lục hợp tuổi"; mau = "bg-emerald-100 text-emerald-700"; }
    else { nhan = "Bình hòa tuổi"; mau = "bg-slate-100 text-slate-600"; }
    const chiTiet = `Chi: ${c.moTa} · Can: ${t.can.moTa} · Ngũ hành: ${t.nguHanh.moTa}`;
    return `<span class="mt-1 inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-bold ${mau}" title="${chiTiet}">${nhan}</span>`;
  }
  interface KyHopDongResult {
    ngayXepHang: KyHopDongNgay[];
  }

  const thangSelect = document.getElementById("ky-hop-dong-thang") as HTMLSelectElement;
  const namSelect = document.getElementById("ky-hop-dong-nam") as HTMLSelectElement;
  const namSinhInput = document.getElementById("ky-hop-dong-nam-sinh") as HTMLInputElement;
  const loiEl = document.getElementById("ky-hop-dong-loi")!;
  const listEl = document.getElementById("ky-hop-dong-list")!;

  const today = new Date();
  for (let m = 1; m <= 12; m++) thangSelect.insertAdjacentHTML("beforeend", `<option value="${m}" ${m === today.getMonth() + 1 ? "selected" : ""}>Tháng ${m}</option>`);
  for (let y = today.getFullYear() - 1; y <= today.getFullYear() + 3; y++) namSelect.insertAdjacentHTML("beforeend", `<option value="${y}" ${y === today.getFullYear() ? "selected" : ""}>${y}</option>`);

  async function load() {
    loiEl.classList.add("hidden");
    listEl.innerHTML = '<p class="py-2 text-center text-sm text-slate-500">Đang tính điểm...</p>';

    let qs = `year=${namSelect.value}&month=${thangSelect.value}&timeZone=Asia/Ho_Chi_Minh`;
    const namSinh = namSinhInput.value.trim();
    // Chỉ áp năm sinh khi đủ 4 chữ số — tránh gửi năm dở dang khi đang gõ.
    if (/^\d{4}$/.test(namSinh)) qs += `&namSinhNguoiKy=${namSinh}`;

    let result: KyHopDongResult;
    try {
      const res = await fetch(`/api/ngay-ky-hop-dong?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        listEl.innerHTML = "";
        return;
      }
      result = data;
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
      listEl.innerHTML = "";
      return;
    }

    listEl.innerHTML = result.ngayXepHang
      .map((n) => {
        const ngayStr = `${String(n.solarDate.day).padStart(2, "0")}/${String(n.solarDate.month).padStart(2, "0")}/${n.solarDate.year}`;
        const gioLink = `/dai-cat-loi/gio-tot-trong-ngay?year=${n.solarDate.year}&month=${n.solarDate.month}&day=${n.solarDate.day}&purpose=KY_HOP_DONG`;
        return `
          <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-100 px-3 py-2.5">
            <div>
              <p class="text-sm font-bold text-slate-900">${ngayStr} (${n.lunarDate.day} âm)</p>
              <p class="text-sm">${nhanDotHtml(n.nhan)} — ${n.diem}/10</p>
              ${badgeTuoi(n.nguoiKy)}
              ${badgeChan(n.catCaNhan)}
            </div>
            <a href="${gioLink}" class="shrink-0 rounded-(--radius-control) border border-(--color-gold-400) px-3 py-1.5 text-xs font-semibold text-(--color-gold-500) hover:bg-(--color-gold-400)/10">Xem giờ ký hợp đồng</a>
          </div>`;
      })
      .join("");
  }

  thangSelect.addEventListener("change", load);
  namSelect.addEventListener("change", load);
  // `change` chỉ chạy khi rời ô — thêm `input` có debounce để gõ xong năm sinh là tự xếp lại ngày.
  let hejTinhLai: ReturnType<typeof setTimeout>;
  namSinhInput.addEventListener("input", () => {
    clearTimeout(hejTinhLai);
    hejTinhLai = setTimeout(load, 500);
  });
  namSinhInput.addEventListener("change", load);
  load();
</script>
