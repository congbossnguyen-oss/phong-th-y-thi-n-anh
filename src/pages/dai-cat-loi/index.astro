---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { daiCatLoiTools as muc } from "../../lib/dai-cat-loi-tools";

export const prerender = true;
---

<BaseLayout
  title="Đại Cát Lợi"
  description="Bộ công cụ Trạch Cát cá nhân hóa: Ngày Đại Cát Cá Nhân, Vận May Trong Ngày, Ngày Ký Hợp Đồng, Giờ Tốt Trong Ngày, Ngày Khai Trương, Tuổi Hợp Làm Ăn."
>
  <PageHero
    eyebrow="Công cụ tra cứu"
    title="Đại Cát Lợi"
    description="Chọn 1 trong 6 công cụ bên dưới — mỗi công cụ tự động tính toán từ dữ liệu Trạch Cát và (khi có) tuổi của bạn, không cần biết trước phong thủy."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi" }]}
  />

  <Container class="py-16">
    <div class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
      {
        muc.map((m) => (
          <a
            href={m.href}
            class="relative flex flex-col gap-2 overflow-hidden rounded-2xl border-2 border-(--color-gold-300) bg-cover bg-center p-6 text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl"
            style="background-image:url('/nen%205.png')"
          >
            <span class="absolute inset-0 bg-black/55"></span>
            <span class="relative text-3xl">{m.icon}</span>
            <span class="relative font-display text-lg font-bold text-white">{m.title}</span>
            <span class="relative text-sm text-white/85">{m.desc}</span>
          </a>
        ))
      }
    </div>

    <a
      href="/dai-cat-loi/dich-vu-thu-phi"
      class="mx-auto mt-6 flex max-w-4xl items-center justify-between gap-3 rounded-2xl border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-5 transition hover:bg-(--color-gold-400)/15"
    >
      <span class="flex items-center gap-3">
        <span class="text-2xl">⭐</span>
        <span>
          <span class="block font-display text-base font-bold text-(--color-ink-950)">Dịch vụ VIP</span>
          <span class="block text-sm text-(--color-ink-600)">Công cụ trạch cát chuyên sâu, tính riêng cho từng trường hợp — thu phí theo lượt.</span>
        </span>
      </span>
      <span class="shrink-0 text-sm font-semibold text-(--color-gold-400)">Xem thêm →</span>
    </a>
  </Container>
</BaseLayout>
