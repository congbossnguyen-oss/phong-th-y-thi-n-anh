---
// TRANG "/kiem-chung" cho module Bát Trạch — BẮT BUỘC theo README.md gói build (thay cho khâu
// đối chiếu thủ công trước đây). KHÔNG link từ trang chính, chủ site tự vào bằng đường dẫn này.
//
// 🔒 Admin-only — cùng cơ chế với trang chính (xem GHI-CHU-CAN-CHU-SITE-XEM.md).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";

export const prerender = false;

if (Astro.locals.user?.isAdmin !== true) {
  return Astro.redirect("/");
}
---

<BaseLayout title="Kiểm chứng Bát Trạch (nội bộ)" description="Trang tự kiểm chứng nội bộ — không dùng cho khách.">
  <Container class="py-10">
    <div class="mx-auto max-w-5xl">
      <h1 class="font-display text-2xl font-bold text-(--color-ink-950)">🔧 Kiểm chứng module Bát Trạch (nội bộ)</h1>
      <p class="mt-2 text-sm text-(--color-ink-600)">
        Nhập nhanh các ca thực tế để đối chiếu — mỗi ca hiển thị kết quả theo CẢ HAI phương án của từng cờ cấu hình,
        đặt cạnh nhau. Ô giống nhau tô nền trung tính ("thống nhất"), ô lệch nhau tô nổi bật để biết ca nào cần thẩm
        định. Đổi công tắc cờ cấu hình để xem kết quả "chính thức" sẽ đổi thế nào — không cần sửa code, không cần
        deploy lại.
      </p>

      <div class="mt-4 flex flex-wrap gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm">
        <label class="flex items-center gap-2">
          <span class="font-semibold">MĐ-1 hợp mệnh:</span>
          <select id="kc-cfg-md1" class="rounded border border-(--color-ivory-300) px-2 py-1 text-xs">
            <option value="huong">Hướng (mặc định)</option>
            <option value="toa">Tọa</option>
          </select>
        </label>
        <label class="flex items-center gap-2">
          <span class="font-semibold">MĐ-2 sinh khắc:</span>
          <select id="kc-cfg-md2" class="rounded border border-(--color-ivory-300) px-2 py-1 text-xs">
            <option value="theoNguCanh">Cả 2 theo ngữ cảnh (mặc định)</option>
            <option value="A">Chỉ phương án A</option>
            <option value="B">Chỉ phương án B</option>
          </select>
        </label>
        <label class="flex items-center gap-2">
          <span class="font-semibold">MĐ-3 Tầng 1:</span>
          <select id="kc-cfg-md3" class="rounded border border-(--color-ivory-300) px-2 py-1 text-xs">
            <option value="duNienToaMon">Du Niên Tọa×Môn (mặc định)</option>
            <option value="theoViDuSach">Theo ví dụ sách</option>
          </select>
        </label>
      </div>

      <form id="kc-form" class="mt-4 flex flex-wrap items-end gap-3 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm">
        <div>
          <label for="kc-nam-sinh" class="text-xs font-medium text-(--color-ink-600)">Năm sinh</label>
          <input type="number" id="kc-nam-sinh" min="1900" max="2100" required class="mt-1 w-24 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm" />
        </div>
        <div>
          <label for="kc-gioi-tinh" class="text-xs font-medium text-(--color-ink-600)">Giới tính</label>
          <select id="kc-gioi-tinh" class="mt-1 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm">
            <option value="nam">Nam</option>
            <option value="nu">Nữ</option>
          </select>
        </div>
        <div>
          <label for="kc-huong-do" class="text-xs font-medium text-(--color-ink-600)">Hướng nhà (độ số)</label>
          <input type="number" id="kc-huong-do" min="0" max="360" step="0.1" required class="mt-1 w-24 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm" />
        </div>
        <div>
          <label for="kc-cua" class="text-xs font-medium text-(--color-ink-600)">Cửa (tùy chọn)</label>
          <select id="kc-cua" class="mt-1 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm"><option value="">—</option></select>
        </div>
        <div>
          <label for="kc-chu" class="text-xs font-medium text-(--color-ink-600)">Chủ (tùy chọn)</label>
          <select id="kc-chu" class="mt-1 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm"><option value="">—</option></select>
        </div>
        <div>
          <label for="kc-bep" class="text-xs font-medium text-(--color-ink-600)">Bếp (tùy chọn)</label>
          <select id="kc-bep" class="mt-1 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm"><option value="">—</option></select>
        </div>
        <div>
          <label for="kc-so-tang" class="text-xs font-medium text-(--color-ink-600)">Số tầng</label>
          <input type="number" id="kc-so-tang" min="1" max="10" class="mt-1 w-20 rounded border border-(--color-ivory-300) px-2 py-1.5 text-sm" />
        </div>
        <button type="submit" class="rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-xs font-semibold text-(--color-on-accent)">+ Thêm ca</button>
        <button type="button" id="kc-xuat" class="rounded-(--radius-pill) border border-(--color-ivory-400) px-4 py-2 text-xs font-semibold text-(--color-ink-700)">Xuất CSV</button>
        <button type="button" id="kc-xoa-het" class="rounded-(--radius-pill) border border-(--color-danger-500)/40 px-4 py-2 text-xs font-semibold text-(--color-danger-500)">Xóa hết</button>
      </form>

      <p id="kc-loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[900px] border-collapse text-xs">
          <thead>
            <tr class="border-b border-(--color-ivory-300) text-left text-(--color-ink-500)">
              <th class="p-2">Ca</th>
              <th class="p-2">Cung Phi</th>
              <th class="p-2">MĐ-1: theo Hướng | theo Tọa</th>
              <th class="p-2">MĐ-2 (Chủ): A | B</th>
              <th class="p-2">MĐ-2 (Bếp): A | B</th>
              <th class="p-2">MĐ-3: Khả năng 1 | Khả năng 2</th>
              <th class="p-2"></th>
            </tr>
          </thead>
          <tbody id="kc-tbody"></tbody>
        </table>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  interface CaKiemChung {
    id: number;
    namSinh: number;
    gioiTinh: "nam" | "nu";
    huongDo: number;
    cuaCung: string;
    chuCung: string;
    bepCung: string;
    soTang: string;
  }

  const CUA_SELECTS = ["kc-cua", "kc-chu", "kc-bep"];
  // Cửa/Chủ/Bếp lấy theo CUNG (8 cung Bát Quái), không phải "8 hướng địa lý" — 2 danh sách tên
  // trùng nhau (Bắc=Khảm...) nhưng để đúng ngữ nghĩa API (cuaCung nhận tên Cung: Càn/Khảm/Cấn...),
  // dùng luôn danh sách 8 cung cho các select này.
  const CUNG_8 = ["Càn", "Khảm", "Cấn", "Chấn", "Tốn", "Ly", "Khôn", "Đoài"];
  for (const id of CUA_SELECTS) {
    const sel = document.getElementById(id) as HTMLSelectElement;
    for (const c of CUNG_8) sel.insertAdjacentHTML("beforeend", `<option value="${c}">${c}</option>`);
  }

  const form = document.getElementById("kc-form") as HTMLFormElement;
  const tbody = document.getElementById("kc-tbody") as HTMLTableSectionElement;
  const loiEl = document.getElementById("kc-loi") as HTMLParagraphElement;
  const cfgMd1 = document.getElementById("kc-cfg-md1") as HTMLSelectElement;
  const cfgMd2 = document.getElementById("kc-cfg-md2") as HTMLSelectElement;
  const cfgMd3 = document.getElementById("kc-cfg-md3") as HTMLSelectElement;

  let cases: CaKiemChung[] = [];
  try {
    const luu = localStorage.getItem("bat-trach-kiem-chung-cases");
    if (luu) cases = JSON.parse(luu);
  } catch {
    cases = [];
  }

  function luuCases() {
    localStorage.setItem("bat-trach-kiem-chung-cases", JSON.stringify(cases));
  }

  function oSo(a: string | undefined, b: string | undefined): string {
    const giong = a === b;
    const cls = giong ? "bg-(--color-ivory-200)" : "bg-(--color-gold-400)/20 font-semibold";
    return `<span class="inline-block rounded px-1.5 py-0.5 ${cls}">${a ?? "—"} | ${b ?? "—"}</span>`;
  }

  async function tinh1Ca(ca: CaKiemChung) {
    const p = new URLSearchParams();
    p.set("namSinh", String(ca.namSinh));
    p.set("gioiTinh", ca.gioiTinh);
    p.set("huongKieu", "do");
    p.set("huongGiaTri", String(ca.huongDo));
    if (ca.cuaCung) p.set("cuaCung", ca.cuaCung);
    if (ca.chuCung) p.set("chuCung", ca.chuCung);
    if (ca.bepCung) p.set("bepCung", ca.bepCung);
    if (ca.soTang) p.set("soTang", ca.soTang);
    p.set("luanHopMenhTheo", cfgMd1.value);
    p.set("sinhKhacCungSao", cfgMd2.value);
    p.set("xuyenCungTang1", cfgMd3.value);
    const res = await fetch(`/api/bat-trach-nha?${p.toString()}`);
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? "Không tính được.");
    return data;
  }

  async function renderTat() {
    tbody.innerHTML = "";
    for (const ca of cases) {
      const tr = document.createElement("tr");
      tr.className = "border-b border-(--color-ivory-200)";
      tr.innerHTML = `<td class="p-2" colspan="7">Đang tính ca #${ca.id}...</td>`;
      tbody.appendChild(tr);
      try {
        const r = await tinh1Ca(ca);
        const md1 = oSo(r.toiThieu.hopMenh.theoHuong.tenKhi, r.toiThieu.hopMenh.theoToa.tenKhi);
        const md2Chu = r.tamYeu ? oSo(r.tamYeu.sinhKhacChu.phuongAnA, r.tamYeu.sinhKhacChu.phuongAnB) : "—";
        const md2Bep = r.tamYeu ? oSo(r.tamYeu.sinhKhacBep.phuongAnA, r.tamYeu.sinhKhacBep.phuongAnB) : "—";
        const md3 = r.xuyenCung && r.xuyenCung.khaNang2 ? oSo(r.xuyenCung.khaNang1[0]?.tenKhi, r.xuyenCung.khaNang2[0]?.tenKhi) : r.xuyenCung ? "(chưa có ví dụ đối chiếu)" : "—";
        tr.innerHTML = `
          <td class="p-2 align-top">#${ca.id}<br/><span class="text-(--color-ink-400)">${ca.namSinh} ${ca.gioiTinh} · ${ca.huongDo}°</span></td>
          <td class="p-2 align-top">${r.toiThieu.cungMenh}</td>
          <td class="p-2 align-top">${md1}</td>
          <td class="p-2 align-top">${md2Chu}</td>
          <td class="p-2 align-top">${md2Bep}</td>
          <td class="p-2 align-top">${md3}</td>
          <td class="p-2 align-top"><button data-id="${ca.id}" class="kc-xoa text-(--color-danger-500) hover:underline">Xóa</button></td>
        `;
      } catch (err) {
        tr.innerHTML = `<td class="p-2 text-(--color-danger-500)" colspan="7">Ca #${ca.id}: ${err instanceof Error ? err.message : "lỗi"}</td>`;
      }
    }
    tbody.querySelectorAll<HTMLButtonElement>(".kc-xoa").forEach((btn) => {
      btn.addEventListener("click", () => {
        cases = cases.filter((c) => c.id !== Number(btn.dataset.id));
        luuCases();
        void renderTat();
      });
    });
  }

  let dem = cases.reduce((m, c) => Math.max(m, c.id), 0);

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    const namSinh = Number((document.getElementById("kc-nam-sinh") as HTMLInputElement).value);
    const gioiTinh = (document.getElementById("kc-gioi-tinh") as HTMLSelectElement).value as "nam" | "nu";
    const huongDo = Number((document.getElementById("kc-huong-do") as HTMLInputElement).value);
    if (!namSinh || Number.isNaN(huongDo)) {
      loiEl.textContent = "Cần nhập đủ năm sinh + hướng nhà.";
      loiEl.classList.remove("hidden");
      return;
    }
    dem++;
    cases.push({
      id: dem,
      namSinh,
      gioiTinh,
      huongDo,
      cuaCung: (document.getElementById("kc-cua") as HTMLSelectElement).value,
      chuCung: (document.getElementById("kc-chu") as HTMLSelectElement).value,
      bepCung: (document.getElementById("kc-bep") as HTMLSelectElement).value,
      soTang: (document.getElementById("kc-so-tang") as HTMLInputElement).value,
    });
    luuCases();
    void renderTat();
  });

  document.getElementById("kc-xoa-het")!.addEventListener("click", () => {
    cases = [];
    luuCases();
    void renderTat();
  });

  for (const sel of [cfgMd1, cfgMd2, cfgMd3]) sel.addEventListener("change", () => void renderTat());

  document.getElementById("kc-xuat")!.addEventListener("click", () => {
    const rows = [["id", "namSinh", "gioiTinh", "huongDo", "cuaCung", "chuCung", "bepCung", "soTang"], ...cases.map((c) => [c.id, c.namSinh, c.gioiTinh, c.huongDo, c.cuaCung, c.chuCung, c.bepCung, c.soTang].map(String))];
    const csv = rows.map((r) => r.join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "bat-trach-kiem-chung.csv";
    a.click();
    URL.revokeObjectURL(a.href);
  });

  void renderTat();
</script>
