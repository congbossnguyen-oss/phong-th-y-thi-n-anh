---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";

// Render phía máy chủ để đọc phiên đăng nhập — cần để nhận diện tài khoản QUẢN TRỊ. Prerender thì
// `Astro.locals.user` luôn rỗng lúc build.
export const prerender = false;

// Đã BẬT THU PHÍ THẬT (anh Công chốt 2026-08-23): khách gửi form là chuyển thẳng sang màn thanh
// toán QR. Riêng tài khoản QUẢN TRỊ vẫn đi luồng thật ở mức 0đ để test trọn quy trình mà không mất
// tiền (xem checkout-cong-cu.ts, cờ laQuanTri) — cùng cơ chế các module VIP khác.
const laQuanTri = Astro.locals.user?.isAdmin === true;
const TEST_MODE = false;

const TOOL_SLUG = "sim-phong-thuy-khai-van";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
---

<BaseLayout
  title="Sim Phong Thủy Khai Vận Khí"
  description="Đặt dịch vụ tìm sim hợp mệnh theo Bát Tự: cân bằng Âm Dương, tương sinh Ngũ Hành, hỗ trợ năng lượng bản mệnh — chuyên gia chọn tay dãy số phù hợp mục đích, mạng và ngân sách của bạn."
  appShell
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Sim Phong Thủy Khai Vận Khí"
    description={`Chiếc sim bạn dùng mỗi ngày cũng là một trường năng lượng đồng hành cùng bạn. Gửi thông tin — chuyên gia đối chiếu Bát Tự rồi tự tay chọn dãy số hợp mệnh, đúng mục đích, đúng ngân sách. Phí tìm sim ${TOOL_PRICE_LABEL}/lượt (chưa gồm chi phí mua số).`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Sim Phong Thủy Khai Vận Khí" },
    ]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="mb-8 rounded-2xl border border-(--color-ivory-300) bg-gradient-to-b from-(--color-ivory-100) to-(--color-ivory-50) p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold leading-snug text-(--color-ink-950) sm:text-2xl">
          Chiếc sim bạn đang dùng đang hỗ trợ hay đang cản trở năng lượng của chính mình?
        </h2>

        <div class="mt-4 space-y-3 text-sm leading-relaxed text-(--color-ink-700)">
          <p>Có những người đổi xe, đổi đồng hồ, đổi văn phòng để mong sự nghiệp khởi sắc...</p>
          <p>Nhưng lại quên rằng thứ đồng hành với mình nhiều nhất mỗi ngày chính là số điện thoại.</p>
          <p class="italic text-(--color-ink-600)">
            Hàng trăm cuộc gọi. Hàng nghìn tin nhắn. Vô số lần kích hoạt trường năng lượng của dãy số.
          </p>
          <p>
            Theo nguyên lý Âm Dương – Ngũ Hành, mỗi con số đều mang một tần số năng lượng riêng. Khi được lựa chọn phù
            hợp với bản mệnh và mục tiêu cuộc sống, chiếc sim có thể trở thành một yếu tố phong thủy giúp bạn cảm thấy
            tự tin hơn, tạo sự hài hòa về năng lượng và đồng hành trên hành trình phát triển.
          </p>
        </div>

        <p class="mt-5 font-display text-base font-bold text-(--color-gold-500)">
          ✨ Sim Phong Thủy Kích Vận Khí không đơn thuần là sim đẹp hay sim đắt tiền.
        </p>
        <p class="mt-1.5 text-sm text-(--color-ink-700)">Đó là một dãy số được luận giải dựa trên:</p>
        <ul class="mt-3 space-y-2">
          {[
            "Cân bằng Âm Dương.",
            "Tương sinh Ngũ Hành.",
            "Hỗ trợ năng lượng bản mệnh.",
            "Hướng đến tài lộc, công việc và các mối quan hệ theo nguyên lý phong thủy.",
          ].map((y) => (
            <li class="flex items-start gap-2 text-sm text-(--color-ink-800)">
              <span class="mt-0.5 shrink-0 text-(--color-success-500)">✅</span>
              <span>{y}</span>
            </li>
          ))}
        </ul>

        <p class="mt-5 text-sm leading-relaxed text-(--color-ink-700)">
          Kích Vận Khí không đơn thuần là chọn một dãy số đẹp, mà là quá trình tìm ra tần số năng lượng cộng hưởng với
          bản mệnh. Một chiếc sim phù hợp giúp cân bằng Âm Dương, điều hòa Ngũ Hành và đồng hành cùng bạn trên hành
          trình phát triển sự nghiệp, tài lộc và nhân duyên. Mỗi con số mang một tầng năng lượng – khi được sắp xếp
          đúng, chúng sẽ trở thành điểm tựa cho những giá trị tích cực trong cuộc sống.
        </p>

        <p class="mt-4 text-sm leading-relaxed text-(--color-ink-700)">
          Nhiều người chỉ đổi một chiếc sim. Nhưng điều họ thực sự muốn thay đổi là tư duy, năng lượng và những cơ hội
          phía trước.
        </p>

        <p class="mt-4 rounded-(--radius-card) border-l-4 border-(--color-gold-400) bg-(--color-gold-300)/8 px-4 py-3 text-sm italic leading-relaxed text-(--color-ink-800)">
          Biết đâu... điều còn thiếu không phải là bạn chưa đủ cố gắng, mà là bạn chưa lựa chọn được một trường năng
          lượng phù hợp để đồng hành mỗi ngày.
        </p>
      </div>

      {TEST_MODE && (
        <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-gold-600)">
          🧪 ĐANG THỬ NGHIỆM — tạm bỏ bước thanh toán ({TOOL_PRICE_LABEL}/lượt khi phát hành chính thức) để test nhanh. Nộp form là ghi nhận yêu cầu ngay, không mất tiền.
        </div>
      )}
      {laQuanTri && !TEST_MODE && (
        <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-gold-600)">
          🔒 CHẾ ĐỘ QUẢN TRỊ — đơn của bạn được tạo ở mức 0đ và tự xác nhận để test trọn luồng thu phí ({TOOL_PRICE_LABEL}/lượt với khách).
        </div>
      )}

      <div class="mb-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-600)">
        <p class="font-medium text-(--color-ink-800)">Dịch vụ này khác gì với công cụ tự động?</p>
        <p class="mt-1.5">
          Đây là dịch vụ <strong>thủ công</strong> — không có "kết quả" trả về ngay. Tìm sim sẽ dựa trên <strong>số CCCD và lá số
          Bát Tự</strong> (ngày giờ sinh) của bạn. Sau khi ghi nhận yêu cầu, chuyên gia đối chiếu các dữ liệu này cùng mục đích và
          ngân sách, rồi <strong>tự tay chọn dãy số thật</strong> từ kho sim đang có, cân bằng Âm Dương – tương sinh Ngũ Hành với
          bản mệnh. Kết quả được gửi qua Zalo/số điện thoại bạn cung cấp, thường trong vòng 24 giờ.
        </p>
        <p class="mt-2 text-xs text-(--color-ink-500)">
          Muốn xem thử số hiện tại của mình trước? Dùng công cụ
          <a href="/luan-so-dien-thoai" class="font-medium text-(--color-gold-300) hover:underline">Luận Số Điện Thoại</a> (miễn phí, không cần đăng nhập).
        </p>
      </div>

      <form
        id="spt-form"
        data-test-mode={String(TEST_MODE)}
        class="flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6"
      >
        <div>
          <label for="spt-ho-ten" class="text-sm font-medium text-(--color-ink-800)">Họ và tên <span class="text-(--color-danger-500)">*</span></label>
          <input type="text" id="spt-ho-ten" required maxlength="100" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>

        <div>
          <label for="spt-sdt" class="text-sm font-medium text-(--color-ink-800)">Số điện thoại / Zalo liên lạc <span class="text-(--color-danger-500)">*</span></label>
          <input type="tel" id="spt-sdt" required maxlength="20" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>

        <div>
          <p class="text-sm font-medium text-(--color-ink-800)">Giới tính <span class="text-(--color-danger-500)">*</span></p>
          <div class="mt-1.5 flex gap-4">
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="radio" name="spt-gioi-tinh" value="nam" required /> Nam</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="radio" name="spt-gioi-tinh" value="nu" /> Nữ</label>
          </div>
        </div>

        <div>
          <DateSelect idPrefix="spt-sinh" label="Ngày, tháng, năm sinh (dương lịch)" required yearsBack={90} yearsForward={0} />
        </div>
        <div>
          <label for="spt-gio-sinh" class="text-sm font-medium text-(--color-ink-800)">Giờ sinh (không nhớ thì bỏ qua)</label>
          <select id="spt-gio-sinh" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="">Không nhớ</option>
            {Array.from({ length: 24 }, (_, h) => <option value={h}>{h}h</option>)}
          </select>
        </div>

        <div>
          <label for="spt-cccd" class="text-sm font-medium text-(--color-ink-800)">Số CCCD <span class="text-(--color-danger-500)">*</span></label>
          <input type="text" id="spt-cccd" required inputmode="numeric" maxlength="12" placeholder="9-12 chữ số" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          <p class="mt-1 text-xs text-(--color-ink-500)">Dùng để đối chiếu lá số Bát Tự chính xác — dữ liệu chỉ dùng nội bộ, không chia sẻ bên thứ ba.</p>
        </div>

        <div>
          <label for="spt-dia-chi" class="text-sm font-medium text-(--color-ink-800)">Địa chỉ nhận sim <span class="text-(--color-danger-500)">*</span></label>
          <input type="text" id="spt-dia-chi" required maxlength="300" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>

        <div>
          <label for="spt-cong-viec" class="text-sm font-medium text-(--color-ink-800)">Công việc hiện tại (đặc thù nếu có) <span class="text-(--color-danger-500)">*</span></label>
          <input type="text" id="spt-cong-viec" required maxlength="200" placeholder="vd kinh doanh, sale, thiết kế, học sinh…" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>

        <div>
          <label for="spt-mong-muon" class="text-sm font-medium text-(--color-ink-800)">Mong muốn tìm sim <span class="text-(--color-danger-500)">*</span></label>
          <select id="spt-mong-muon" required class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="">— Chọn —</option>
            <option value="suc-khoe-quy-nhan">Sức khỏe + quý nhân</option>
            <option value="quy-nhan-tai-loc-thu-tai">Quý nhân + tài lộc + thủ tài</option>
            <option value="tai-loc-nhan-duyen">Tài lộc & nhân duyên</option>
            <option value="cong-danh-su-nghiep">Công danh sự nghiệp</option>
            <option value="khau-tai">Khẩu tài, nói ra tiền (sale, spa…)</option>
            <option value="tri-tue-tai-hoa">Trí tuệ, tài hoa sinh tài lộc (thiết kế, đồ họa, xây dựng, truyền thông…)</option>
            <option value="suc-khoe-quy-nhan-tai-loc">Sức khỏe + quý nhân + tài lộc</option>
            <option value="quy-nhan-chieu-cam-bat-phuong-tai">Quý nhân chiêu cảm bát phương tài</option>
            <option value="dau-tu-sinh-tai-loc">Đầu tư sinh tài lộc</option>
            <option value="sim-hoc-sinh">Sim học sinh</option>
            <option value="sim-nguoi-gia">Sim người già</option>
            <option value="khac">Mục khác</option>
          </select>
          <input type="text" id="spt-mong-muon-khac" placeholder="Mô tả cụ thể mong muốn của bạn" class="mt-2 hidden w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>

        <div>
          <p class="text-sm font-medium text-(--color-ink-800)">Muốn đầu số mạng ra sao <span class="text-(--color-danger-500)">*</span></p>
          <div class="mt-1.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="radio" name="spt-mang" value="vina" required /> Vina</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="radio" name="spt-mang" value="mobi" /> Mobi</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="radio" name="spt-mang" value="viettel" /> Viettel</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="radio" name="spt-mang" value="vietnamobile" /> Vietnamobile</label>
          </div>
        </div>

        <div>
          <p class="text-sm font-medium text-(--color-ink-800)">Đầu số có thể dùng, ưu tiên <span class="text-(--color-danger-500)">*</span> <span class="font-normal text-(--color-ink-500)">(chọn 1 hoặc nhiều)</span></p>
          <div class="mt-1.5 flex flex-wrap gap-4">
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="checkbox" name="spt-dau-so" value="09" /> 09</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="checkbox" name="spt-dau-so" value="08" /> 08</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="checkbox" name="spt-dau-so" value="07" /> 07</label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)"><input type="checkbox" name="spt-dau-so" value="03" /> 03</label>
          </div>
        </div>

        <div>
          <label for="spt-khoang-gia" class="text-sm font-medium text-(--color-ink-800)">Khoảng giá có thể mua <span class="text-(--color-danger-500)">*</span></label>
          <select id="spt-khoang-gia" required class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="">— Chọn —</option>
            <option value="1tr-2tr">1 - 2 triệu</option>
            <option value="2tr-3tr">2 - 3 triệu</option>
            <option value="3tr-5tr">3 - 5 triệu</option>
            <option value="5tr-7tr">5 - 7 triệu</option>
            <option value="7tr-10tr">7 - 10 triệu</option>
            <option value="10tr-15tr">10 - 15 triệu</option>
            <option value="15tr-20tr">15 - 20 triệu</option>
            <option value="tren-20tr">Trên 20 triệu</option>
          </select>
          <p class="mt-1 text-xs text-(--color-ink-500)">Lưu ý: mạng Viettel giá khá đắt — chọn khung giá thấp quá sẽ khó tìm được số hài hòa và năng lượng mạnh. Số điện thoại giá cao tất nhiên sẽ có hình thức bắt mắt hơn (tứ quý, lộc phát, thần tài…) cùng năng lượng mạnh hơn.</p>
        </div>

        <div>
          <label for="spt-yeu-cau" class="text-sm font-medium text-(--color-ink-800)">Yêu cầu riêng nếu có</label>
          <textarea id="spt-yeu-cau" rows="3" maxlength="1000" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></textarea>
        </div>

        {!TEST_MODE && (
        <>
        <div class="border-t border-(--color-ivory-300) pt-4">
          <label for="spt-email" class="text-sm font-medium text-(--color-ink-800)">Email nhận biên nhận (không bắt buộc)</label>
          <input type="email" id="spt-email" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
        <MaKhuyenMai idPrefix="spt-ma" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />
        </>
        )}

        <p class="rounded-(--radius-control) bg-(--color-cinnabar-500)/8 px-3 py-2 text-xs font-medium text-(--color-cinnabar-500)">
          ⚠️ {TOOL_PRICE_LABEL} là phí <strong>tìm sim</strong>, không phải phí <strong>mua sim</strong>. Chuyên gia chỉ tìm và
          hướng dẫn — không bán sim. Chi phí mua số thật (nếu bạn đồng ý với số được đề xuất) do bạn tự thanh toán
          riêng với nhà mạng/đại lý bán sim khi nhận thông tin, hoàn toàn tách biệt với phí dịch vụ này.
        </p>
        <Button type="submit" size="lg">Thanh toán {TOOL_PRICE_LABEL} — Gửi yêu cầu tìm sim</Button>
      </form>

      <div id="spt-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
        <p class="font-medium text-(--color-ink-900)">⏳ Đang ghi nhận yêu cầu…</p>
      </div>

      <div id="spt-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <div id="spt-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
        <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="spt-so-tien">{TOOL_PRICE_LABEL}</span></p>
        <p class="text-xs font-medium text-(--color-cinnabar-500)">⚠️ Đây là phí tìm sim (dịch vụ tư vấn), không phải phí mua sim — chuyên gia không bán sim.</p>
        <img id="spt-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
        <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="spt-order-code"></strong></p>
        <p id="spt-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
      </div>

      <div id="spt-ket-qua" class="mt-6 hidden"></div>
    </div>
  </Container>
  <BottomNav />
</BaseLayout>

<script>
  import { readDateSelects } from "../../lib/date-select";

  const form = document.getElementById("spt-form") as HTMLFormElement;
  const loiEl = document.getElementById("spt-loi")!;
  const ketQuaEl = document.getElementById("spt-ket-qua")!;
  const dangChayEl = document.getElementById("spt-dang-chay")!;
  const thanhToanEl = document.getElementById("spt-thanh-toan")!;
  const qrImg = document.getElementById("spt-qr") as HTMLImageElement;
  const orderCodeEl = document.getElementById("spt-order-code")!;
  const trangThaiEl = document.getElementById("spt-trang-thai")!;
  const soTienEl = document.getElementById("spt-so-tien")!;
  const nutSubmit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  const TEST_MODE = form.dataset.testMode === "true";

  const doc = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value.trim() ?? "";
  const esc = (s: unknown) =>
    String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  // Hiện ô "mô tả cụ thể" khi chọn "Mục khác".
  const mongMuonSelect = document.getElementById("spt-mong-muon") as HTMLSelectElement;
  const mongMuonKhacInput = document.getElementById("spt-mong-muon-khac") as HTMLInputElement;
  mongMuonSelect.addEventListener("change", () => {
    mongMuonKhacInput.classList.toggle("hidden", mongMuonSelect.value !== "khac");
  });

  let pollTimer: ReturnType<typeof setInterval> | null = null;
  let dangHoi = false;
  const tatDangChay = () => {
    dangChayEl.classList.add("hidden");
    if (nutSubmit) nutSubmit.disabled = false;
  };
  const baoLoi = (msg: string) => {
    tatDangChay();
    loiEl.textContent = msg;
    loiEl.classList.remove("hidden");
  };
  const dungCho = () => {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  };

  const TEN_BAN_MENH: Record<string, string> = {
    Kim: "Kim", Mộc: "Mộc", Thủy: "Thủy", Hỏa: "Hỏa", Thổ: "Thổ",
  };

  function render(r: any, daThanhToan: boolean) {
    const banMenhText = r.banMenh
      ? `<p class="mt-1 text-sm text-(--color-ink-600)">Bản mệnh (Nạp Âm theo năm sinh): <strong class="text-(--color-gold-500)">${esc(r.banMenh.name)} — hành ${esc(TEN_BAN_MENH[r.banMenh.element] ?? r.banMenh.element)}</strong></p>`
      : "";
    ketQuaEl.innerHTML = `<div class="rounded-2xl border-2 border-(--color-gold-400)/50 bg-gradient-to-br from-white to-(--color-gold-400)/10/40 p-6 shadow-xl">
      <div class="flex items-center gap-2">
        <span class="text-2xl">📱</span>
        <p class="font-display text-lg font-extrabold text-(--color-ink-950)">${daThanhToan ? "Đã nhận yêu cầu — cảm ơn bạn!" : "Đã ghi nhận yêu cầu (chế độ thử nghiệm)"}</p>
      </div>
      ${banMenhText}
      <p class="mt-3 text-sm leading-relaxed text-(--color-ink-700)">
        Chuyên gia sẽ đối chiếu ngày giờ sinh của bạn với kho sim hiện có, chọn ra những dãy số hài hòa Ngũ Hành với bản mệnh
        và đúng mục đích bạn mong muốn, rồi liên hệ trực tiếp qua <strong>Zalo/số điện thoại ${esc(r.soDienThoaiZalo ?? "")}</strong>
        trong vòng <strong>24 giờ làm việc</strong>.
      </p>
      <p class="mt-3 rounded-(--radius-control) bg-(--color-cinnabar-500)/8 px-3 py-2 text-xs font-medium text-(--color-cinnabar-500)">
        ⚠️ Khoản đã thanh toán là phí <strong>tìm sim</strong> (tư vấn). Khi nhận được số phù hợp, bạn <strong>tự thanh toán riêng</strong>
        cho nhà mạng/đại lý nếu muốn mua số đó — chuyên gia không trực tiếp bán sim.
      </p>
      <p class="mt-2 text-xs text-(--color-ink-500)">Cần hỏi thêm? Nhắn trực tiếp qua <a class="text-(--color-gold-300) hover:underline" href="https://www.facebook.com/ZhiGong2211" target="_blank" rel="noopener">Facebook</a> hoặc mục Liên hệ trên site.</p>
    </div>`;
    ketQuaEl.classList.remove("hidden");
    ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  async function layKetQua(orderCode: string) {
    if (dangHoi) return;
    dangHoi = true;
    try {
      const res = await fetch(`/api/dai-cat-loi/sim-phong-thuy-khai-van/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!data.ok) return;
      if (data.status === "cancelled") {
        dungCho();
        trangThaiEl.textContent = "Đơn hàng đã bị hủy.";
        return;
      }
      if (data.status !== "confirmed") return;
      dungCho();
      dangChayEl.classList.add("hidden");
      thanhToanEl.classList.add("hidden");
      render(data.result, true);
    } catch {
      // Mạng chập chờn — để nhịp sau thử lại.
    } finally {
      dangHoi = false;
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const sinh = readDateSelects("spt-sinh");
    if (!sinh) return baoLoi("Vui lòng chọn đầy đủ ngày, tháng, năm sinh.");

    const gioiTinh = (form.querySelector('input[name="spt-gioi-tinh"]:checked') as HTMLInputElement | null)?.value;
    if (!gioiTinh) return baoLoi("Vui lòng chọn giới tính.");

    const mangMongMuon = (form.querySelector('input[name="spt-mang"]:checked') as HTMLInputElement | null)?.value;
    if (!mangMongMuon) return baoLoi("Vui lòng chọn nhà mạng mong muốn.");

    const dauSoUuTien = Array.from(form.querySelectorAll('input[name="spt-dau-so"]:checked')).map((el) => (el as HTMLInputElement).value);
    if (dauSoUuTien.length === 0) return baoLoi("Vui lòng chọn ít nhất một đầu số ưu tiên.");

    const mongMuonTimSim = doc("spt-mong-muon");
    if (!mongMuonTimSim) return baoLoi("Vui lòng chọn mong muốn tìm sim.");
    if (mongMuonTimSim === "khac" && !doc("spt-mong-muon-khac")) {
      return baoLoi("Vui lòng mô tả cụ thể mong muốn tìm sim (mục khác).");
    }

    const khoangGia = doc("spt-khoang-gia");
    if (!khoangGia) return baoLoi("Vui lòng chọn khoảng giá mong muốn.");

    const payload: Record<string, unknown> = {
      hoTen: doc("spt-ho-ten"),
      soDienThoaiZalo: doc("spt-sdt"),
      gioiTinh,
      ngaySinh: { year: sinh.year, month: sinh.month, day: sinh.day },
      ...(doc("spt-gio-sinh") !== "" ? { gioSinh: Number(doc("spt-gio-sinh")) } : {}),
      soCCCD: doc("spt-cccd"),
      diaChiNhanSim: doc("spt-dia-chi"),
      congViecHienTai: doc("spt-cong-viec"),
      mongMuonTimSim,
      ...(mongMuonTimSim === "khac" ? { mongMuonKhac: doc("spt-mong-muon-khac") } : {}),
      mangMongMuon,
      dauSoUuTien,
      khoangGia,
      ...(doc("spt-yeu-cau") ? { yeuCauRieng: doc("spt-yeu-cau") } : {}),
    };

    dangChayEl.classList.remove("hidden");
    if (nutSubmit) nutSubmit.disabled = true;

    try {
      if (TEST_MODE) {
        const res = await fetch("/api/dai-cat-loi/sim-phong-thuy-khai-van/test-calculate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không gửi được yêu cầu.");
        tatDangChay();
        render({ ...data.result, soDienThoaiZalo: payload.soDienThoaiZalo }, false);
        return;
      }

      const res = await fetch("/api/dai-cat-loi/sim-phong-thuy-khai-van/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...payload,
          ...(doc("spt-email") ? { customerEmail: doc("spt-email") } : {}),
          ...(doc("spt-ma-input") ? { maKhuyenMai: doc("spt-ma-input") } : {}),
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
      tatDangChay();
      orderCodeEl.textContent = data.orderCode;

      if (data.mienPhi) {
        dangChayEl.classList.remove("hidden");
        await layKetQua(data.orderCode);
        return;
      }

      soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
      qrImg.src = data.qrUrl;
      trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      thanhToanEl.classList.remove("hidden");
      thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
      pollTimer = setInterval(() => layKetQua(data.orderCode), 3000);
    } catch {
      baoLoi("Không gửi được yêu cầu. Vui lòng thử lại.");
    }
  });
</script>
