---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { siteConfig } from "../../lib/site-config";
import { dinhDangTien, GIA_CONG_CU } from "../../lib/payments/gia-cong-cu";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";

export const prerender = false;

const TOOL_SLUG = "ngay-khai-truong-cao-cap";
const TOOL_PRICE = GIA_CONG_CU["ngay-khai-truong-cao-cap"];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
const hotlineHref = `tel:${siteConfig.hotline.replace(/\s/g, "")}`;
const laQuanTri = Astro.locals.user?.isAdmin === true;
const namNay = new Date().getFullYear();
import NgayKhaiTruongCaoCap from "../../components/tools/NgayKhaiTruongCaoCap.astro";
---

<BaseLayout
  title="Chọn Ngày Khai Trương Cao Cấp (Bát Tự Mệnh Chủ)"
  description="Bản nâng cấp của Khai Trương thường: giữ nguyên điểm nền rồi chồng lớp Bát Tự mệnh chủ — Thập Thần hợp cầu tài, xét cả Tứ Trụ và Dụng Thần theo vượng suy. Dịch vụ VIP 499.000đ/lượt, thanh toán qua QR."
  appShell
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Chọn Ngày Khai Trương Cao Cấp"
    description="Chọn ngày mở cửa kinh doanh hợp cả trạch cát lẫn Bát Tự người đứng tên — Thập Thần cầu tài, không xung khắc Tứ Trụ, bổ Dụng Thần theo vượng suy."
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Khai Trương Cao Cấp" },
    ]}
  />
  <VipQuyenBanner />

  <NgayKhaiTruongCaoCap />
</BaseLayout>
