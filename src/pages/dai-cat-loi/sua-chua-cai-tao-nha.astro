---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Chọn Ngày Giờ Sửa Chữa – Cải Tạo Nhà"
  description="Xem năm nay có nên sửa nhà không, phương vị định động có phạm Thái Tuế/Tuế Phá/Tam Sát không, rồi tìm ngày giờ tốt nhất — xét tuổi chủ và mức độ sửa chữa."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Chọn Ngày Giờ Sửa Chữa – Cải Tạo Nhà"
    description="Chọn loại sửa chữa, phương vị định động, năm sinh chủ nhà và khoảng ngày — hệ thống kiểm tra Thái Tuế/Tuế Phá/Tam Sát tại phương vị đó, Kim Lâu/Hoàng Ốc/Tam Tai của chủ trong năm, rồi mới tìm ngày giờ tốt nhất."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Sửa Chữa – Cải Tạo Nhà" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <form id="form-sua-chua" class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="sc-nam-sinh" class="text-xs font-medium text-slate-600">Năm sinh chủ nhà <span class="text-(--color-cinnabar-400)">*</span></label>
            <input type="number" id="sc-nam-sinh" min="1900" max="2100" required placeholder="vd. 1990" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="sc-loai" class="text-xs font-medium text-slate-600">Loại sửa chữa</label>
            <select id="sc-loai" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
              <option value="light">Sửa nhẹ (sơn, nội thất...)</option>
              <option value="medium" selected>Sửa vừa (đập tường phụ, thay cửa...)</option>
              <option value="major">Sửa lớn (đập kết cấu, đổi bố cục)</option>
              <option value="ground_breaking">Động thổ / đào móng</option>
              <option value="kitchen">Sửa bếp</option>
              <option value="main_door">Sửa cửa chính</option>
              <option value="stair">Sửa cầu thang</option>
              <option value="roof">Sửa mái</option>
              <option value="extension">Mở rộng nhà</option>
            </select>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap gap-4">
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" id="sc-dap-pha" class="size-4 rounded border-(--color-ivory-300)" />
            Đập phá kết cấu chịu lực
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" id="sc-dao-dat" class="size-4 rounded border-(--color-ivory-300)" />
            Đào đất / động thổ
          </label>
        </div>

        <div class="mt-3">
          <p class="text-xs font-medium text-slate-600">Phương vị định động (chọn ít nhất 1)</p>
          <div class="mt-1.5 grid grid-cols-4 gap-1.5 text-xs">
            {
              [
                ["Bắc", "Khảm"],
                ["Đông Bắc", "Cấn"],
                ["Đông", "Chấn"],
                ["Đông Nam", "Tốn"],
                ["Nam", "Ly"],
                ["Tây Nam", "Khôn"],
                ["Tây", "Đoài"],
                ["Tây Bắc", "Càn"],
              ].map(([huong, cung]) => (
                <label class="flex items-center gap-1.5 rounded-lg border border-(--color-ivory-300) px-2 py-1.5">
                  <input type="checkbox" class="sc-cung size-3.5 shrink-0" value={cung} />
                  {huong}
                </label>
              ))
            }
          </div>
          <p class="mt-1.5 text-xs text-slate-400">
            "Sửa nhà ở phương Nam" nghĩa là khu vực định động nằm ở phía Nam của ngôi nhà — khác với "nhà hướng Nam" (hướng cửa chính).
          </p>
        </div>

        <div class="mt-3 grid grid-cols-2 gap-3">
          <div>
            <label for="sc-tu-ngay" class="text-xs font-medium text-slate-600">Từ ngày</label>
            <input type="date" id="sc-tu-ngay" required class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="sc-den-ngay" class="text-xs font-medium text-slate-600">Đến ngày</label>
            <input type="date" id="sc-den-ngay" required class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
        </div>
        <p class="mt-2 text-xs text-slate-400">
          Trên iPhone, ô ngày sẽ trống cho tới khi anh bấm vào để mở lịch chọn — đây là cách hiển thị mặc định của Safari, không phải lỗi.
        </p>
        <p class="mt-2 text-xs text-slate-400">Từ ngày và Đến ngày phải cùng 1 năm dương lịch (Thái Tuế/Tam Sát/Kim Lâu/Hoàng Ốc tính theo năm), tối đa 31 ngày mỗi lượt quét.</p>
        <Button type="submit" size="lg" class="mt-4 w-full">Kiểm tra & tìm ngày giờ tốt</Button>
      </form>

      <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

      <div id="an-toan" class="mt-4 hidden rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">🧭 An toàn phương vị & năm</p>
        <div id="an-toan-noi-dung" class="mt-2 space-y-2"></div>
      </div>

      <div id="ket-qua" class="mt-4 hidden space-y-2"></div>

      <div id="ket-qua-gio" class="mt-4 hidden rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">🕘 Giờ sửa chữa trong ngày</p>
        <p id="gio-tieu-de" class="mt-1 text-sm text-slate-500"></p>
        <div id="gio-danh-sach" class="mt-2 space-y-1.5"></div>
      </div>

      <p class="mt-4 text-xs text-(--color-ink-500)">
        Đây là công cụ tham khảo: Thái Tuế/Tuế Phá/Tam Sát theo phương vị (8 phương), Kim Lâu/Hoàng Ốc/Tam Tai của chủ theo năm, Trạch Cát ngày,
        Tiểu Lục Nhâm giờ, quan hệ Can/Chi/Ngũ Hành với tuổi. Hệ thống chưa có bảng Huyền Không Phi Tinh (Vận/tinh bàn/Ngũ Hoàng/Nhị Hắc) và chưa xét
        quan hệ với tọa hướng nhà cụ thể — không khẳng định chắc chắn về hiệu quả, chỉ mang tính tham khảo.
      </p>
    </div>
  </Container>
</BaseLayout>

<script>
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  const CUNG_HUONG_VIET: Record<string, string> = {
    Khảm: "Bắc",
    Cấn: "Đông Bắc",
    Chấn: "Đông",
    Tốn: "Đông Nam",
    Ly: "Nam",
    Khôn: "Tây Nam",
    Đoài: "Tây",
    Càn: "Tây Bắc",
  };

  interface DirectionRisk {
    cung: string;
    thaiTue: boolean;
    tuePha: boolean;
    tamSat: boolean;
    severity: "none" | "low" | "medium" | "high" | "critical";
  }
  interface SiteSafety { diem: number; phamNghiemTrong: boolean; directionRisks: DirectionRisk[] }
  interface OwnerYear { diem: number; hoangOcKimLauTamTai: { ketLuan: { nhan: string } } }
  interface ToHop {
    solarDate: { year: number; month: number; day: number };
    khungGio: string;
    chiGio: string;
    finalDiem: number;
    hang: string;
    nhan: string;
    dayScore: { diem: number; nhan: string };
    hourScore: { diem: number; nhan: string };
  }
  interface RangeResult { renovationLevel: string; siteSafety: SiteSafety; ownerYear: OwnerYear; xepHang: ToHop[] }
  interface MotNgayResult { xepHang: ToHop[] }

  const SEVERITY_LABEL: Record<string, string> = {
    none: "🟢 Không phạm",
    low: "🟢 Không phạm",
    medium: "🟡 Cần lưu ý",
    high: "🟠 Nên tránh",
    critical: "🔴 Đại kỵ",
  };

  const form = document.getElementById("form-sua-chua") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const anToanEl = document.getElementById("an-toan")!;
  const anToanNoiDungEl = document.getElementById("an-toan-noi-dung")!;
  const ketQuaEl = document.getElementById("ket-qua")!;
  const ketQuaGioEl = document.getElementById("ket-qua-gio")!;
  const gioTieuDeEl = document.getElementById("gio-tieu-de")!;
  const gioDanhSachEl = document.getElementById("gio-danh-sach")!;

  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  function pad2(n: number): string {
    return String(n).padStart(2, "0");
  }

  let thamSoHienTai = { renovationType: "", affectsStructure: "0", digsGround: "0", namSinh: "", cungList: [] as string[] };

  async function taiGioTrongNgay(year: number, month: number, day: number) {
    const { renovationType, affectsStructure, digsGround, namSinh, cungList } = thamSoHienTai;
    const cungQs = cungList.map((c) => `affectedCung=${encodeURIComponent(c)}`).join("&");
    const qs = `renovationType=${renovationType}&affectsStructure=${affectsStructure}&digsGround=${digsGround}&namSinh=${namSinh}&${cungQs}&year=${year}&month=${month}&day=${day}`;
    try {
      const res = await fetch(`/api/sua-chua-cai-tao-nha?${qs}`);
      const data = await res.json();
      if (!res.ok) return;
      const result = data as MotNgayResult;
      gioTieuDeEl.textContent = `Ngày ${pad2(day)}/${pad2(month)}/${year} — xếp hạng đủ 12 giờ Địa Chi`;
      gioDanhSachEl.innerHTML = result.xepHang
        .slice(0, 5)
        .map(
          (g, i) =>
            `<div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-2.5">
              <p class="text-sm font-semibold text-slate-900">${HUY_CHUONG[i] ?? `${i + 1}.`} ${g.khungGio} (giờ ${g.chiGio})</p>
              <span class="text-sm">${nhanDotHtml(g.nhan)} — ${g.finalDiem}/10</span>
            </div>`,
        )
        .join("");
      ketQuaGioEl.classList.remove("hidden");
      ketQuaGioEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch {
      // bỏ qua lỗi phụ, không chặn luồng chính
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    anToanEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    ketQuaGioEl.classList.add("hidden");

    const namSinh = (document.getElementById("sc-nam-sinh") as HTMLInputElement).value;
    const renovationType = (document.getElementById("sc-loai") as HTMLSelectElement).value;
    const affectsStructure = (document.getElementById("sc-dap-pha") as HTMLInputElement).checked ? "1" : "0";
    const digsGround = (document.getElementById("sc-dao-dat") as HTMLInputElement).checked ? "1" : "0";
    const cungList = [...document.querySelectorAll<HTMLInputElement>(".sc-cung:checked")].map((el) => el.value);
    const tuNgay = (document.getElementById("sc-tu-ngay") as HTMLInputElement).value;
    const denNgay = (document.getElementById("sc-den-ngay") as HTMLInputElement).value;

    if (!namSinh) {
      loiEl.textContent = "Vui lòng nhập năm sinh chủ nhà.";
      loiEl.classList.remove("hidden");
      return;
    }
    if (cungList.length === 0) {
      loiEl.textContent = "Vui lòng chọn ít nhất 1 phương vị định động.";
      loiEl.classList.remove("hidden");
      return;
    }
    if (!tuNgay || !denNgay) {
      loiEl.textContent = "Vui lòng chọn Từ ngày và Đến ngày.";
      loiEl.classList.remove("hidden");
      return;
    }
    const [startYear, startMonth, startDay] = tuNgay.split("-").map(Number);
    const [endYear, endMonth, endDay] = denNgay.split("-").map(Number);
    if (startYear !== endYear) {
      loiEl.textContent = "Từ ngày và Đến ngày phải cùng 1 năm dương lịch.";
      loiEl.classList.remove("hidden");
      return;
    }

    thamSoHienTai = { renovationType, affectsStructure, digsGround, namSinh, cungList };
    const cungQs = cungList.map((c) => `affectedCung=${encodeURIComponent(c)}`).join("&");
    const qs = `renovationType=${renovationType}&affectsStructure=${affectsStructure}&digsGround=${digsGround}&namSinh=${namSinh}&${cungQs}&startYear=${startYear}&startMonth=${startMonth}&startDay=${startDay}&endYear=${endYear}&endMonth=${endMonth}&endDay=${endDay}`;

    try {
      const res = await fetch(`/api/sua-chua-cai-tao-nha?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const result = data as RangeResult;

      const canhBao = result.siteSafety.phamNghiemTrong
        ? `<div class="rounded-xl border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)">
            ⚠️ Có phương vị phạm mức đại kỵ (Thái Tuế/Tuế Phá/Tam Sát kết hợp với mức độ động mạnh) — nên cân nhắc đổi phương vị, đổi mức độ sửa chữa, hoặc dời sang năm khác.
          </div>`
        : "";
      const bangPhuongVi = result.siteSafety.directionRisks
        .map(
          (r) =>
            `<div class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 p-2 text-sm">
              <span class="font-medium text-slate-800">${CUNG_HUONG_VIET[r.cung] ?? r.cung}</span>
              <span>${SEVERITY_LABEL[r.severity] ?? r.severity}${r.thaiTue ? " · Thái Tuế" : ""}${r.tuePha ? " · Tuế Phá" : ""}${r.tamSat ? " · Tam Sát" : ""}</span>
            </div>`,
        )
        .join("");
      anToanNoiDungEl.innerHTML = `${canhBao}
        <div class="grid grid-cols-2 gap-2 text-sm">
          <div class="rounded-lg bg-slate-50 p-2"><span class="text-slate-500">Điểm an toàn phương vị:</span> <span class="font-semibold">${result.siteSafety.diem}/10</span></div>
          <div class="rounded-lg bg-slate-50 p-2"><span class="text-slate-500">Chủ nhà ↔ năm nay:</span> <span class="font-semibold">${result.ownerYear.diem}/10</span> — ${result.ownerYear.hoangOcKimLauTamTai.ketLuan.nhan}</div>
        </div>
        <div class="space-y-1.5">${bangPhuongVi}</div>`;
      anToanEl.classList.remove("hidden");

      const HANG_DUNG_DUOC = new Set(["rat-tot", "tot", "kha-tot", "co-the-dung"]);
      const ngayTotNhatMap = new Map<string, ToHop>();
      for (const t of result.xepHang) {
        const key = `${t.solarDate.year}-${t.solarDate.month}-${t.solarDate.day}`;
        if (!ngayTotNhatMap.has(key)) ngayTotNhatMap.set(key, t);
      }
      const top5Ngay = [...ngayTotNhatMap.values()]
        .filter((t) => HANG_DUNG_DUOC.has(t.hang))
        .sort((a, b) => b.finalDiem - a.finalDiem)
        .slice(0, 5);

      if (top5Ngay.length === 0) {
        ketQuaEl.innerHTML = `<div class="rounded-xl border border-(--color-danger-500)/30 bg-(--color-danger-500)/5 p-4 text-sm text-slate-600">
          Không có ngày nào trong khoảng đã chọn đủ tốt để sửa chữa (mọi ngày đều rơi vào mức "Không thuận" trở xuống).
          Anh thử chọn khoảng ngày khác, đổi phương vị, hoặc giảm mức độ sửa chữa xem sao.
        </div>`;
        ketQuaEl.classList.remove("hidden");
        return;
      }

      ketQuaEl.innerHTML = top5Ngay
        .map((t, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          const ngayStr = `${pad2(t.solarDate.day)}/${pad2(t.solarDate.month)}/${t.solarDate.year}`;
          return `<button type="button" class="sc-ngay w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-left hover:bg-slate-100" data-year="${t.solarDate.year}" data-month="${t.solarDate.month}" data-day="${t.solarDate.day}">
            <div class="flex items-center justify-between">
              <p class="font-display text-base font-bold text-slate-900">${huyChuong} ${ngayStr}</p>
              <span class="text-sm font-semibold">${nhanDotHtml(t.nhan)} — ${t.finalDiem}/10</span>
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Giờ tốt nhất: ${t.khungGio} (giờ ${t.chiGio}) · Ngày: ${nhanDotHtml(t.dayScore.nhan)} (${t.dayScore.diem}/10) · Giờ: ${nhanDotHtml(t.hourScore.nhan)} (${t.hourScore.diem}/10)</p>
            <p class="mt-1 text-xs text-amber-600">Bấm để xem thêm các lựa chọn giờ khác trong ngày này</p>
          </button>`;
        })
        .join("");

      ketQuaEl.querySelectorAll(".sc-ngay").forEach((btn) => {
        btn.addEventListener("click", () => {
          const el = btn as HTMLElement;
          void taiGioTrongNgay(Number(el.dataset.year), Number(el.dataset.month), Number(el.dataset.day));
        });
      });

      ketQuaEl.classList.remove("hidden");
      const d = top5Ngay[0]!.solarDate;
      void taiGioTrongNgay(d.year, d.month, d.day);
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
