---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { paidTools } from "../../lib/dai-cat-loi-tools";

export const prerender = true;

// Ảnh bìa riêng cho từng dịch vụ VIP — đã nén WebP (resize 1000px, ~140-180KB thay vì ~2.5MB PNG).
// Giữ map ở đây để không đụng dai-cat-loi-tools.ts.
const ANH_BIA_VIP: Record<string, string> = {
  "/dai-cat-loi/dinh-huong-nghe-nghiep": "/images/vip/dinh-huong-nghe-nghiep.webp",
  "/dai-cat-loi/gio-liem-ha-huyet": "/images/vip/gio-liem-ha-huyet.webp",
  "/dai-cat-loi/xem-ngay-cao-cap": "/images/vip/xem-ngay-cao-cap.webp",
  "/dai-cat-loi/ngay-ky-hop-dong-cao-cap": "/images/vip/ngay-ky-hop-dong-cao-cap.webp",
  "/dai-cat-loi/ngay-cuoi-hoi": "/images/vip/ngay-cuoi-hoi.webp",
  "/dai-cat-loi/dat-ten-cho-con": "/images/vip/dat-ten-cho-con.webp",
  "/dai-cat-loi/nhan-chuc": "/images/vip/nhan-chuc.webp",
  "/dai-cat-loi/ngay-khai-truong-cao-cap": "/images/vip/ngay-khai-truong-cao-cap.webp",
  "/dai-cat-loi/trach-nhat-sinh-no": "/images/vip/trach-nhat-sinh-no.webp",
  "/dai-cat-loi/sim-phong-thuy-khai-van": "/images/vip/sim-phong-thuy-khai-van.webp",
  "/dai-cat-loi/trach-cat-ky-mon": "/images/vip/trach-cat-ky-mon.webp",
  "/dai-cat-loi/hop-hon": "/images/vip/hop-hon.webp",
  "/dai-cat-loi/dau-thu-chon-ngay": "/images/vip/dau-thu-chon-ngay.webp",
  "/dai-cat-loi/thuc-dinh-tai-quy": "/images/vip/thuc-dinh-tai-quy.webp",
  "/dai-cat-loi/ngu-quy-van-tai": "/images/vip/ngu-quy-van-tai.webp",
};
---

<BaseLayout
  title="Dịch vụ VIP"
  description="Các công cụ trạch cát chuyên sâu, tính toán theo yêu cầu riêng của từng khách hàng — thu phí theo lượt sử dụng."
  ogImage="/images/brand/og-dich-vu-vip.png"
>
  <PageHero
    eyebrow="Công cụ tra cứu"
    title="⭐ Dịch vụ VIP"
    description="Khác với nhóm công cụ Đại Cát Lợi miễn phí, các công cụ dưới đây xử lý bài toán chuyên sâu hơn, tính riêng cho từng trường hợp — thanh toán theo lượt qua QR chuyển khoản."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Dịch vụ VIP" }]}
  />

  <Container class="py-16">
    <div class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
      {
        paidTools.map((m) => (
          <a
            href={m.href}
            aria-label={m.title}
            class="block overflow-hidden rounded-2xl border-2 border-(--color-gold-400) shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl"
          >
            {/* Ảnh bìa đã rõ nội dung — không phủ mờ, không chữ đè lên; alt giữ cho SEO/screen-reader. */}
            <img
              src={encodeURI(ANH_BIA_VIP[m.href] ?? "/nen 2.png")}
              alt={m.title}
              class="block h-auto w-full"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>

    <p class="mx-auto mt-8 max-w-4xl text-center text-xs text-(--color-ink-500)">
      Cần một công cụ thu phí khác chưa có ở đây? <a href="/lien-he" class="text-(--color-gold-300) hover:underline">Liên hệ đặt lịch tư vấn trực tiếp</a>.
    </p>
  </Container>
</BaseLayout>
