---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { paidTools } from "../../lib/dai-cat-loi-tools";

export const prerender = true;
---

<BaseLayout
  title="Dịch vụ VIP"
  description="Các công cụ trạch cát chuyên sâu, tính toán theo yêu cầu riêng của từng khách hàng — thu phí theo lượt sử dụng."
>
  <PageHero
    eyebrow="Công cụ tra cứu"
    title="⭐ Dịch vụ VIP"
    description="Khác với nhóm công cụ Đại Cát Lợi miễn phí, các công cụ dưới đây xử lý bài toán chuyên sâu hơn, tính riêng cho từng trường hợp — thanh toán theo lượt qua QR chuyển khoản."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Dịch vụ VIP" }]}
  />

  <Container class="py-16">
    <div class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
      {
        paidTools.map((m) => (
          <a
            href={m.href}
            class="relative flex flex-col gap-2 overflow-hidden rounded-2xl border-2 border-(--color-gold-400) bg-cover bg-center p-6 text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl"
            style="background-image:url('/nen%202.png')"
          >
            <span class="absolute inset-0 bg-black/55"></span>
            {m.best && (
              <span class="absolute top-3 left-4 z-10 rounded-(--radius-pill) bg-(--color-cinnabar-400) px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-white shadow ring-2 ring-white/40">
                BEST ⭐
              </span>
            )}
            <span class="absolute top-3 right-4 z-10 rounded-(--radius-pill) bg-(--color-gold-400) px-3 py-1 text-xs font-semibold text-(--color-on-accent) shadow">
              {m.priceLabel}
            </span>
            <span class="relative text-3xl">{m.icon}</span>
            <span class="relative font-display text-lg font-bold text-white">{m.title}</span>
            <span class="relative text-sm text-white/85">{m.desc}</span>
          </a>
        ))
      }
    </div>

    <p class="mx-auto mt-8 max-w-4xl text-center text-xs text-(--color-ink-500)">
      Cần một công cụ thu phí khác chưa có ở đây? <a href="/lien-he" class="text-(--color-gold-300) hover:underline">Liên hệ đặt lịch tư vấn trực tiếp</a>.
    </p>
  </Container>
</BaseLayout>
