---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Hoàng Ốc – Kim Lâu – Tam Tai"
  description="Tính Hoàng Ốc, Kim Lâu, Tam Tai theo năm sinh và năm cần xem — tham khảo khi định xây nhà, sửa nhà, việc lớn. Có thể quét nhiều năm để tìm năm thuận nhất."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Hoàng Ốc – Kim Lâu – Tam Tai"
    description="Nhập năm sinh và năm cần xem — hệ thống tự tính tuổi mụ, Hoàng Ốc, Kim Lâu, Tam Tai và đưa ra khuyến nghị tham khảo cho việc xây/sửa nhà."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Hoàng Ốc – Kim Lâu – Tam Tai" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-xs text-(--color-ink-600)">
        Công thức Hoàng Ốc dùng theo cách tính dân gian phổ biến nhất (tuổi mụ chia 6 dư mấy ứng với cung đó) — chưa
        đối chiếu được với 1 nguồn sách cụ thể. Kim Lâu và Tam Tai dùng đúng bảng đã có trong hệ thống.
      </div>

      <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <div class="flex gap-2 border-b border-slate-200 pb-3">
          <button type="button" id="tab-mot-nam" class="rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)">
            Xem 1 năm
          </button>
          <button type="button" id="tab-quet-nam" class="rounded-(--radius-pill) border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">
            Tìm năm tốt
          </button>
        </div>

        <form id="form-mot-nam" class="mt-4 flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="mn-nam-sinh" class="text-xs font-medium text-slate-600">Năm sinh</label>
              <input type="number" id="mn-nam-sinh" min="1900" max="2100" required placeholder="1988" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="mn-nam-xem" class="text-xs font-medium text-slate-600">Năm cần xem</label>
              <input type="number" id="mn-nam-xem" min="1900" max="2100" required placeholder="2026" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <Button type="submit" size="lg">Xem</Button>
        </form>

        <form id="form-quet-nam" class="mt-4 hidden flex-col gap-3">
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="qn-nam-sinh" class="text-xs font-medium text-slate-600">Năm sinh</label>
              <input type="number" id="qn-nam-sinh" min="1900" max="2100" required placeholder="1988" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="qn-tu-nam" class="text-xs font-medium text-slate-600">Từ năm</label>
              <input type="number" id="qn-tu-nam" min="1900" max="2100" required placeholder="2026" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="qn-den-nam" class="text-xs font-medium text-slate-600">Đến năm</label>
              <input type="number" id="qn-den-nam" min="1900" max="2100" required placeholder="2040" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <p class="text-xs text-slate-400">Tối đa 30 năm mỗi lượt quét.</p>
          <Button type="submit" size="lg">Tìm năm tốt</Button>
        </form>

        <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

        <div id="ket-qua-mot-nam" class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 p-5">
          <p id="mn-tieu-de" class="text-sm text-slate-500"></p>
          <p id="mn-ket-luan" class="mt-1 font-display text-xl font-bold text-slate-900"></p>
          <div class="mt-3 grid grid-cols-3 gap-2 border-t border-slate-200 pt-3 text-center">
            <div>
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Hoàng Ốc</p>
              <p id="mn-hoang-oc" class="mt-0.5 text-sm font-semibold"></p>
            </div>
            <div>
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Kim Lâu</p>
              <p id="mn-kim-lau" class="mt-0.5 text-sm font-semibold"></p>
            </div>
            <div>
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Tam Tai</p>
              <p id="mn-tam-tai" class="mt-0.5 text-sm font-semibold"></p>
            </div>
          </div>
        </div>

        <div id="ket-qua-quet-nam" class="mt-4 hidden space-y-2"></div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  interface HoangOcResult { cung: string; ten: string; tot: boolean }
  interface KimLauResult { loai: string; ten: string; pham: boolean }
  interface TamTaiResult { pham: boolean; nhomTuoi?: string[] }
  interface KetLuan { mucDo: string; nhan: string; soYeuToXau: number }
  interface HoangOcKimLauResult {
    namSinh: number;
    namXem: number;
    tuoiMu: number;
    hoangOc: HoangOcResult;
    kimLau: KimLauResult;
    tamTai: TamTaiResult;
    ketLuan: KetLuan;
  }

  const tabMotNam = document.getElementById("tab-mot-nam") as HTMLButtonElement;
  const tabQuetNam = document.getElementById("tab-quet-nam") as HTMLButtonElement;
  const formMotNam = document.getElementById("form-mot-nam") as HTMLFormElement;
  const formQuetNam = document.getElementById("form-quet-nam") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaMotNamEl = document.getElementById("ket-qua-mot-nam")!;
  const ketQuaQuetNamEl = document.getElementById("ket-qua-quet-nam")!;

  const TAB_ACTIVE = "rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)";
  const TAB_INACTIVE = "rounded-(--radius-pill) border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50";

  function showTab(which: "mot-nam" | "quet-nam") {
    loiEl.classList.add("hidden");
    ketQuaMotNamEl.classList.add("hidden");
    ketQuaQuetNamEl.classList.add("hidden");
    if (which === "mot-nam") {
      tabMotNam.className = TAB_ACTIVE;
      tabQuetNam.className = TAB_INACTIVE;
      formMotNam.classList.remove("hidden");
      formMotNam.classList.add("flex");
      formQuetNam.classList.add("hidden");
      formQuetNam.classList.remove("flex");
    } else {
      tabQuetNam.className = TAB_ACTIVE;
      tabMotNam.className = TAB_INACTIVE;
      formQuetNam.classList.remove("hidden");
      formQuetNam.classList.add("flex");
      formMotNam.classList.add("hidden");
      formMotNam.classList.remove("flex");
    }
  }
  tabMotNam.addEventListener("click", () => showTab("mot-nam"));
  tabQuetNam.addEventListener("click", () => showTab("quet-nam"));

  function renderMotNam(r: HoangOcKimLauResult) {
    document.getElementById("mn-tieu-de")!.textContent = `Năm sinh ${r.namSinh} — Năm xem ${r.namXem} — Tuổi mụ ${r.tuoiMu}`;
    document.getElementById("mn-ket-luan")!.textContent = r.ketLuan.nhan;
    const hoangOcEl = document.getElementById("mn-hoang-oc")!;
    hoangOcEl.textContent = r.hoangOc.ten;
    hoangOcEl.className = `mt-0.5 text-sm font-semibold ${r.hoangOc.tot ? "text-emerald-600" : "text-(--color-cinnabar-500)"}`;
    const kimLauEl = document.getElementById("mn-kim-lau")!;
    kimLauEl.textContent = r.kimLau.ten;
    kimLauEl.className = `mt-0.5 text-sm font-semibold ${r.kimLau.pham ? "text-(--color-cinnabar-500)" : "text-emerald-600"}`;
    const tamTaiEl = document.getElementById("mn-tam-tai")!;
    tamTaiEl.textContent = r.tamTai.pham ? "Phạm Tam Tai" : "Không phạm";
    tamTaiEl.className = `mt-0.5 text-sm font-semibold ${r.tamTai.pham ? "text-(--color-cinnabar-500)" : "text-emerald-600"}`;
    ketQuaMotNamEl.classList.remove("hidden");
  }

  formMotNam.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaMotNamEl.classList.add("hidden");
    const namSinh = (document.getElementById("mn-nam-sinh") as HTMLInputElement).value;
    const namXem = (document.getElementById("mn-nam-xem") as HTMLInputElement).value;
    try {
      const res = await fetch(`/api/hoang-oc-kim-lau?namSinh=${namSinh}&namXem=${namXem}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      renderMotNam(data.result as HoangOcKimLauResult);
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });

  formQuetNam.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaQuetNamEl.classList.add("hidden");
    const namSinh = (document.getElementById("qn-nam-sinh") as HTMLInputElement).value;
    const tuNam = (document.getElementById("qn-tu-nam") as HTMLInputElement).value;
    const denNam = (document.getElementById("qn-den-nam") as HTMLInputElement).value;
    try {
      const res = await fetch(`/api/hoang-oc-kim-lau?namSinh=${namSinh}&tuNam=${tuNam}&denNam=${denNam}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const results = data.results as HoangOcKimLauResult[];
      const HUY_CHUONG = ["🥇", "🥈", "🥉"];
      ketQuaQuetNamEl.innerHTML = results
        .map((r, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          return `<div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3">
            <div>
              <p class="font-display text-base font-bold text-slate-900">${huyChuong} Năm ${r.namXem} <span class="text-xs font-normal text-slate-500">(tuổi mụ ${r.tuoiMu})</span></p>
              <p class="text-xs text-slate-500">${r.hoangOc.ten} · ${r.kimLau.ten} · ${r.tamTai.pham ? "Phạm Tam Tai" : "Không phạm Tam Tai"}</p>
            </div>
            <span class="text-sm font-semibold">${r.ketLuan.nhan}</span>
          </div>`;
        })
        .join("");
      ketQuaQuetNamEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
