---
// TRANG "Tam Hợp Phái" — chỉ lo khung trang (SEO/PageHero/breadcrumbs); toàn bộ form/tính toán/
// kết quả + gate thầy-only nằm ở TamHopPhai.astro.
//
// ⚠️ THẦY-ONLY, CHƯA CÔNG KHAI: không đăng ký ở phong-thuy-chinh-phai.astro / site-config.ts,
// chỉ vào được qua URL trực tiếp. Khách (không phải admin) chỉ thấy màn "đang hoàn thiện".
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import TamHopPhai from "../../components/tools/TamHopPhai.astro";

export const prerender = false;
---

<BaseLayout
  title="Tam Hợp Phái"
  description="Công cụ luận nhà theo trường phái Tam Hợp (Loan Đầu + Lý Khí) — tra bảng Long Cục, Thủy Pháp, Sa Pháp, Bát Lộ/Bát Sát từ Hướng và các yếu tố quan sát thực địa."
>
  <PageHero
    eyebrow="Đại Cát Lợi — đang thử nghiệm"
    title="Tam Hợp Phái"
    description="Nhập Hướng nhà và các yếu tố quan sát thực địa (thủy khẩu, giáng long/khí, lai/khứ thủy) để tra Long Cục, Thủy Pháp, Sa Pháp, Bát Lộ Hoàng Tuyền và Bát Sát Huỳnh Tuyền theo trường phái Tam Hợp."
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Tam Hợp Phái" },
    ]}
  />

  <TamHopPhai />
</BaseLayout>
