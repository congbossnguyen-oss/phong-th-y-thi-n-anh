---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";

// Render phía máy chủ để đọc phiên đăng nhập — cần cho việc chỉ CHO QUẢN TRỊ dùng lúc thử nghiệm.
// Prerender thì `Astro.locals.user` luôn rỗng lúc build.
export const prerender = false;

// GIAI ĐOẠN THỬ NGHIỆM (Công yêu cầu): CHỈ tài khoản quản trị mới thấy & dùng công cụ; khách vào
// ✅ Đã mở bán cho khách (thẻ đã có ở dai-cat-loi-tools.ts). laQuanTri giờ chỉ dùng cho nhãn nhắc.
// và đổi TEST_MODE thành false để thu phí thật.
const laQuanTri = Astro.locals.user?.isAdmin === true;

// Cờ thử nghiệm: true = bỏ bước thanh toán, nộp form ra kết quả ngay (không tạo đơn thật). Chỉ có ý
// nghĩa với quản trị vì khách không tới được form. Script đọc lại cờ qua data-test-mode.
// ĐÃ BẬT THU PHÍ + MỞ BÁN (chủ dự án chốt 2026-08-18): khách thấy form và thanh toán thật; admin vẫn
// được checkout-cong-cu tạo đơn 0đ tự xác nhận (cờ laQuanTri từ phiên đăng nhập) nên test miễn phí.
const TEST_MODE = false;

const TOOL_SLUG = "ngay-cuoi-hoi";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
import NgayCuoiHoi from "../../components/tools/NgayCuoiHoi.astro";
---

<BaseLayout
  title="Xem Ngày Cưới Hỏi Trọn Gói"
  description="Dịch vụ chọn ngày & giờ cưới hỏi trọn gói: ăn hỏi, đón dâu, thành hôn, đăng ký kết hôn — chấm điểm riêng cô dâu, chú rể rồi cân cặp đôi, kèm giờ vàng và lịch cả chuỗi theo trình tự thời gian."
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Xem Ngày Cưới Hỏi Trọn Gói"
    description="Chọn ngày và giờ đẹp cho cả chuỗi cưới hỏi — chấm điểm độc lập cô dâu & chú rể theo hợp tuổi, hỷ tinh (Hồng Loan/Thiên Hỷ), trạch cát; lập lịch cả 4 nghi lễ theo trình tự thời gian."
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Xem Ngày Cưới Hỏi" },
    ]}
  />
  <VipQuyenBanner />

  <NgayCuoiHoi />
</BaseLayout>
