---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Ngày Tốt Xuất Hành"
  description="Tìm ngày tốt để xuất hành, đi xa — quét 1 khoảng ngày, tổng hợp Trạch Cát và thần sát Lộc Mã. Năm sinh không bắt buộc, có thể để trống để xem ngày chung."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Ngày Tốt Xuất Hành"
    description="Chọn khoảng ngày muốn xem — có thể nhập thêm năm sinh (không bắt buộc) để cá nhân hóa theo tuổi."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Ngày Tốt Xuất Hành" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <form id="form-xuat-hanh" class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="tu-ngay" class="text-xs font-medium text-slate-600">Từ ngày</label>
              <input type="date" id="tu-ngay" required class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="den-ngay" class="text-xs font-medium text-slate-600">Đến ngày</label>
              <input type="date" id="den-ngay" required class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <p class="-mt-1.5 text-xs text-slate-400">
            Trên iPhone, ô ngày sẽ trống cho tới khi anh bấm vào để mở lịch chọn — đây là cách hiển thị mặc định của Safari, không phải lỗi.
          </p>
          <div>
            <label for="nam-sinh" class="text-xs font-medium text-slate-600">Năm sinh (không bắt buộc)</label>
            <input type="number" id="nam-sinh" min="1900" max="2100" placeholder="Để trống nếu chỉ cần ngày xuất hành chung" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            <p class="mt-1 text-xs text-slate-400">Nhập năm sinh để cá nhân hóa ngày xuất hành theo tuổi (xét xung/hợp, tam hợp/lục hợp, hình/hại/phá với Can Chi năm sinh).</p>
          </div>
          <p class="text-xs text-slate-400">Tối đa 62 ngày mỗi lượt quét.</p>
          <Button type="submit" size="lg">Tìm ngày tốt</Button>
        </form>

        <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

        <div id="ket-qua" class="mt-4 hidden space-y-2"></div>
      </div>

      <p class="mt-4 text-xs text-(--color-ink-500)">
        Đây là công cụ tham khảo theo hệ thống phong thủy đã cấu hình. Hoàng Đạo không tự động là tốt cho mọi việc —
        hệ thống luôn xét thêm Trực, thần sát và (nếu có năm sinh) quan hệ tuổi trước khi kết luận.
      </p>
    </div>
  </Container>
</BaseLayout>

<script>
  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface DayFactor { ten: string; diem: number }
  interface DayScore { diem: number; yeuTo: DayFactor[]; phamDaiKy: boolean }
  interface CanNhanResult { diem: number; can: { moTa: string }; chi: { moTa: string } }
  interface XuatHanhNgay {
    solarDate: { year: number; month: number; day: number };
    lunarDate: { year: number; month: number; day: number; isLeapMonth: boolean };
    diem: number;
    hang: string;
    nhan: string;
    base: DayScore;
    mucDich: DayScore;
    canNhan: CanNhanResult | null;
  }
  interface XuatHanhRangeResult { ngayXepHang: XuatHanhNgay[] }

  const form = document.getElementById("form-xuat-hanh") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;
  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  function pad2(n: number): string {
    return String(n).padStart(2, "0");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const tuNgay = (document.getElementById("tu-ngay") as HTMLInputElement).value;
    const denNgay = (document.getElementById("den-ngay") as HTMLInputElement).value;
    const namSinh = (document.getElementById("nam-sinh") as HTMLInputElement).value;

    if (!tuNgay || !denNgay) {
      loiEl.textContent = "Vui lòng chọn Từ ngày và Đến ngày.";
      loiEl.classList.remove("hidden");
      return;
    }
    const [startYear, startMonth, startDay] = tuNgay.split("-").map(Number);
    const [endYear, endMonth, endDay] = denNgay.split("-").map(Number);

    let qs = `startYear=${startYear}&startMonth=${startMonth}&startDay=${startDay}&endYear=${endYear}&endMonth=${endMonth}&endDay=${endDay}`;
    if (namSinh) qs += `&namSinh=${namSinh}`;

    try {
      const res = await fetch(`/api/ngay-xuat-hanh?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const result = data as XuatHanhRangeResult;
      const top5 = result.ngayXepHang.slice(0, 5);

      ketQuaEl.innerHTML = top5
        .map((d, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          const ngayStr = `${pad2(d.solarDate.day)}/${pad2(d.solarDate.month)}/${d.solarDate.year}`;
          const lyDo: string[] = [];
          for (const y of [...d.base.yeuTo, ...d.mucDich.yeuTo]) {
            if (y.diem > 0) lyDo.push(y.ten);
          }
          const lyDoText = lyDo.length > 0 ? lyDo.slice(0, 4).join("; ") : "Không có yếu tố nổi bật, mức bình thường";
          const canNhanText = d.canNhan
            ? `<p class="mt-1 text-xs text-slate-500">Tuổi người đi: Can ${d.canNhan.can.moTa}; Chi ${d.canNhan.chi.moTa}</p>`
            : "";
          return `<div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
            <div class="flex items-center justify-between">
              <p class="font-display text-base font-bold text-slate-900">${huyChuong} ${ngayStr}</p>
              <span class="text-sm font-semibold">${nhanDotHtml(d.nhan)} — ${d.diem}/10</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">Lý do: ${lyDoText}</p>
            ${canNhanText}
          </div>`;
        })
        .join("");

      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
