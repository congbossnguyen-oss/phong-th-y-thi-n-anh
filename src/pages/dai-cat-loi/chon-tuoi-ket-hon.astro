---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Chọn Tuổi Kết Hôn"
  description="So sánh mức độ hòa hợp khi kết hôn giữa 2 tuổi theo Mệnh, Thiên Can, Địa Chi, Cung Mệnh Bát Trạch và Niên Mệnh Năm Sinh. Có thể tìm tuổi hợp nhất trong 1 khoảng năm."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Chọn Tuổi Kết Hôn"
    description="Nhập giới tính + năm sinh của 2 người — hệ thống tự tính 5 tiêu chí hòa hợp và chấm điểm 0-10."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Chọn Tuổi Kết Hôn" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <div class="flex gap-2 border-b border-slate-200 pb-3">
          <button type="button" id="tab-so-sanh" class="rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)">
            So sánh 2 người
          </button>
          <button type="button" id="tab-tim-hop" class="rounded-(--radius-pill) border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">
            Tìm tuổi hợp nhất
          </button>
        </div>

        <form id="form-so-sanh" class="mt-4 flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-2 rounded-xl border border-slate-200 p-3">
              <p class="text-xs font-semibold text-slate-500">Người 1</p>
              <div class="flex gap-3 text-sm">
                <label class="flex items-center gap-1"><input type="radio" name="ss-gioitinh1" value="nam" checked /> Nam</label>
                <label class="flex items-center gap-1"><input type="radio" name="ss-gioitinh1" value="nu" /> Nữ</label>
              </div>
              <input type="number" id="ss-namsinh1" min="1900" max="2100" required placeholder="Năm sinh, vd 1996" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
            </div>
            <div class="space-y-2 rounded-xl border border-slate-200 p-3">
              <p class="text-xs font-semibold text-slate-500">Người 2</p>
              <div class="flex gap-3 text-sm">
                <label class="flex items-center gap-1"><input type="radio" name="ss-gioitinh2" value="nam" /> Nam</label>
                <label class="flex items-center gap-1"><input type="radio" name="ss-gioitinh2" value="nu" checked /> Nữ</label>
              </div>
              <input type="number" id="ss-namsinh2" min="1900" max="2100" required placeholder="Năm sinh, vd 1993" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <Button type="submit" size="lg">Xem tuổi kết hôn</Button>
        </form>

        <form id="form-tim-hop" class="mt-4 hidden flex-col gap-3">
          <div class="space-y-2 rounded-xl border border-slate-200 p-3">
            <p class="text-xs font-semibold text-slate-500">Người cố định</p>
            <div class="flex gap-3 text-sm">
              <label class="flex items-center gap-1"><input type="radio" name="th-gioitinh" value="nam" checked /> Nam</label>
              <label class="flex items-center gap-1"><input type="radio" name="th-gioitinh" value="nu" /> Nữ</label>
            </div>
            <input type="number" id="th-namsinh" min="1900" max="2100" required placeholder="Năm sinh, vd 1996" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="th-tunam" class="text-xs font-medium text-slate-600">Từ năm sinh</label>
              <input type="number" id="th-tunam" min="1900" max="2100" required placeholder="1990" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="th-dennam" class="text-xs font-medium text-slate-600">Đến năm sinh</label>
              <input type="number" id="th-dennam" min="1900" max="2100" required placeholder="2005" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <p class="text-xs text-slate-400">Tối đa 30 năm mỗi lượt tìm. Giới tính cần tìm sẽ tự lấy ngược lại với người cố định.</p>
          <Button type="submit" size="lg">Tìm tuổi hợp nhất</Button>
        </form>

        <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

        <div id="ket-qua-so-sanh" class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 p-5">
          <p id="ss-tieu-de" class="text-sm text-slate-500"></p>
          <p id="ss-diem" class="mt-1 font-display text-2xl font-bold text-slate-900"></p>
          <div class="mt-3 space-y-1.5 border-t border-slate-200 pt-3 text-sm text-slate-700">
            <p><strong class="text-slate-600">Mệnh:</strong> <span id="ss-menh"></span></p>
            <p><strong class="text-slate-600">Thiên Can:</strong> <span id="ss-can"></span></p>
            <p><strong class="text-slate-600">Địa Chi:</strong> <span id="ss-chi"></span></p>
            <p><strong class="text-slate-600">Cung Mệnh:</strong> <span id="ss-cung-menh"></span></p>
            <p><strong class="text-slate-600">Niên Mệnh:</strong> <span id="ss-nien-menh"></span></p>
          </div>
        </div>

        <div id="ket-qua-tim-hop" class="mt-4 hidden space-y-2"></div>
      </div>

      <p class="mt-4 text-xs text-(--color-ink-500)">
        Đây là đánh giá theo hệ thống phong thủy đã cấu hình (Mệnh Nạp Âm, Thiên Can, Địa Chi, Cung Mệnh Bát Trạch, Niên
        Mệnh theo Địa Chi) — không khẳng định chắc chắn về hạnh phúc hôn nhân.
      </p>
    </div>
  </Container>
</BaseLayout>

<script>
  interface TieuChi { diem: number; moTa: string }
  interface KetHonResult {
    diem: number;
    hang: string;
    nhan: string;
    menh: TieuChi;
    thienCan: TieuChi;
    diaChi: TieuChi;
    cungMenh: TieuChi;
    nienMenh: TieuChi;
  }
  interface MarriageMatchCandidate { namSinh: number; ketQua: KetHonResult }

  const tabSoSanh = document.getElementById("tab-so-sanh") as HTMLButtonElement;
  const tabTimHop = document.getElementById("tab-tim-hop") as HTMLButtonElement;
  const formSoSanh = document.getElementById("form-so-sanh") as HTMLFormElement;
  const formTimHop = document.getElementById("form-tim-hop") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaSoSanhEl = document.getElementById("ket-qua-so-sanh")!;
  const ketQuaTimHopEl = document.getElementById("ket-qua-tim-hop")!;

  const TAB_ACTIVE = "rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)";
  const TAB_INACTIVE = "rounded-(--radius-pill) border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50";

  function showTab(which: "so-sanh" | "tim-hop") {
    loiEl.classList.add("hidden");
    ketQuaSoSanhEl.classList.add("hidden");
    ketQuaTimHopEl.classList.add("hidden");
    if (which === "so-sanh") {
      tabSoSanh.className = TAB_ACTIVE;
      tabTimHop.className = TAB_INACTIVE;
      formSoSanh.classList.remove("hidden");
      formSoSanh.classList.add("flex");
      formTimHop.classList.add("hidden");
      formTimHop.classList.remove("flex");
    } else {
      tabTimHop.className = TAB_ACTIVE;
      tabSoSanh.className = TAB_INACTIVE;
      formTimHop.classList.remove("hidden");
      formTimHop.classList.add("flex");
      formSoSanh.classList.add("hidden");
      formSoSanh.classList.remove("flex");
    }
  }
  tabSoSanh.addEventListener("click", () => showTab("so-sanh"));
  tabTimHop.addEventListener("click", () => showTab("tim-hop"));

  formSoSanh.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaSoSanhEl.classList.add("hidden");

    const gioiTinh1 = (formSoSanh.querySelector('input[name="ss-gioitinh1"]:checked') as HTMLInputElement).value;
    const namSinh1 = (document.getElementById("ss-namsinh1") as HTMLInputElement).value;
    const gioiTinh2 = (formSoSanh.querySelector('input[name="ss-gioitinh2"]:checked') as HTMLInputElement).value;
    const namSinh2 = (document.getElementById("ss-namsinh2") as HTMLInputElement).value;

    try {
      const res = await fetch(
        `/api/chon-tuoi-ket-hon?namSinh1=${namSinh1}&gioiTinh1=${gioiTinh1}&namSinh2=${namSinh2}&gioiTinh2=${gioiTinh2}`,
      );
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const r = data.result as KetHonResult;
      const nhan1 = gioiTinh1 === "nam" ? "Nam" : "Nữ";
      const nhan2 = gioiTinh2 === "nam" ? "Nam" : "Nữ";
      document.getElementById("ss-tieu-de")!.textContent = `${nhan1} ${namSinh1} × ${nhan2} ${namSinh2}`;
      document.getElementById("ss-diem")!.textContent = `${r.nhan} — ${r.diem}/10`;
      document.getElementById("ss-menh")!.textContent = r.menh.moTa;
      document.getElementById("ss-can")!.textContent = r.thienCan.moTa;
      document.getElementById("ss-chi")!.textContent = r.diaChi.moTa;
      document.getElementById("ss-cung-menh")!.textContent = r.cungMenh.moTa;
      document.getElementById("ss-nien-menh")!.textContent = r.nienMenh.moTa;
      ketQuaSoSanhEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });

  formTimHop.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaTimHopEl.classList.add("hidden");

    const gioiTinh = (formTimHop.querySelector('input[name="th-gioitinh"]:checked') as HTMLInputElement).value;
    const namSinh = (document.getElementById("th-namsinh") as HTMLInputElement).value;
    const tuNam = (document.getElementById("th-tunam") as HTMLInputElement).value;
    const denNam = (document.getElementById("th-dennam") as HTMLInputElement).value;
    const timGioiTinh = gioiTinh === "nam" ? "nu" : "nam";

    try {
      const res = await fetch(
        `/api/chon-tuoi-ket-hon?mode=tim-hop&namSinh=${namSinh}&gioiTinh=${gioiTinh}&timGioiTinh=${timGioiTinh}&tuNam=${tuNam}&denNam=${denNam}`,
      );
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const results = data.results as MarriageMatchCandidate[];
      const HUY_CHUONG = ["🥇", "🥈", "🥉"];
      const nhanTim = timGioiTinh === "nam" ? "Nam" : "Nữ";
      ketQuaTimHopEl.innerHTML = results
        .slice(0, 10)
        .map((c, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          return `<div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3">
            <p class="font-display text-base font-bold text-slate-900">${huyChuong} ${nhanTim} ${c.namSinh}</p>
            <span class="text-sm font-semibold">${c.ketQua.nhan} — ${c.ketQua.diem}/10</span>
          </div>`;
        })
        .join("");
      ketQuaTimHopEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
