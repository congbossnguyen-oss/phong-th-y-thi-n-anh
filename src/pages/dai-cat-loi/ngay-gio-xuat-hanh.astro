---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNav from "../../components/quan-su/BottomNav.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";

export const prerender = true;
---

<BaseLayout
  title="Ngày Giờ Xuất Hành Cá Nhân"
  description="Tìm ngày và giờ xuất hành tốt nhất cho riêng bạn — kết hợp Trạch Cát ngày, Tiểu Lục Nhâm giờ, quan hệ ngày/giờ với tuổi, mục đích chuyến đi và hướng xuất hành nếu có."
  appShell
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Ngày Giờ Xuất Hành Cá Nhân"
    description="Chọn mục đích, năm sinh + giới tính và khoảng ngày muốn xem — hệ thống quét cả ngày lẫn 12 giờ Địa Chi, chấm điểm ngày và giờ riêng biệt rồi xếp hạng các tổ hợp tốt nhất."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Ngày Giờ Xuất Hành" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <form id="form-xuat-hanh" class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <div>
          <label for="xh-muc-dich" class="text-xs font-medium text-slate-600">Mục đích</label>
          <select id="xh-muc-dich" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="XUAT_HANH_CHUNG">Xuất hành chung</option>
            <option value="DI_CONG_VIEC">Đi công việc</option>
            <option value="GAP_KHACH_HANG">Gặp khách hàng</option>
            <option value="GAP_DOI_TAC">Gặp đối tác</option>
            <option value="KY_HOP_DONG">Ký hợp đồng</option>
            <option value="CAU_TAI">Cầu tài</option>
            <option value="DI_LAM_AN">Đi làm ăn</option>
            <option value="DI_XA">Đi xa</option>
            <option value="PHONG_VAN">Phỏng vấn</option>
            <option value="DOI_NO">Đòi nợ</option>
            <option value="GIAO_DICH">Giao dịch</option>
            <option value="GIAO_TIEP_TIEC_TUNG">Gặp gỡ / giao tế</option>
          </select>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div>
            <label for="xh-nam-sinh" class="text-xs font-medium text-slate-600">Năm sinh <span class="text-(--color-cinnabar-400)">*</span></label>
            <input type="number" id="xh-nam-sinh" min="1900" max="2100" required placeholder="vd. 1996" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="xh-gioi-tinh" class="text-xs font-medium text-slate-600">Giới tính</label>
            <select id="xh-gioi-tinh" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
              <option value="Nam">Nam</option>
              <option value="Nữ">Nữ</option>
            </select>
          </div>
        </div>
        <div class="mt-3">
          <label for="xh-huong" class="text-xs font-medium text-slate-600">Hướng xuất hành (tùy chọn)</label>
          <select id="xh-huong" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="">Không chọn</option>
            <option value="Đông">Đông</option>
            <option value="Tây">Tây</option>
            <option value="Nam">Nam</option>
            <option value="Bắc">Bắc</option>
            <option value="Đông Bắc">Đông Bắc</option>
            <option value="Đông Nam">Đông Nam</option>
            <option value="Tây Bắc">Tây Bắc</option>
            <option value="Tây Nam">Tây Nam</option>
          </select>
        </div>
        <div class="mt-3 space-y-3">
          <DateSelect idPrefix="xh-tu-ngay" label="Từ ngày" />
          <DateSelect idPrefix="xh-den-ngay" label="Đến ngày" />
        </div>
        <p class="mt-2 text-xs text-slate-400">Tối đa 31 ngày mỗi lượt quét (mỗi ngày xét đủ 12 giờ Địa Chi).</p>
        <Button type="submit" size="lg" class="mt-4 w-full">Tìm ngày giờ tốt</Button>
      </form>

      <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

      <div id="ket-qua" class="mt-4 hidden space-y-2"></div>

      <div id="ket-qua-gio" class="mt-4 hidden rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">🕘 Giờ xuất hành trong ngày</p>
        <p id="gio-tieu-de" class="mt-1 text-sm text-slate-500"></p>
        <div id="gio-danh-sach" class="mt-2 space-y-1.5"></div>
      </div>

      <p class="mt-4 text-xs text-(--color-ink-500)">
        Đây là công cụ tham khảo theo hệ thống phong thủy đã cấu hình: Trạch Cát ngày, Tiểu Lục Nhâm giờ, quan hệ
        Can/Chi/Ngũ Hành với tuổi, và mục đích chuyến đi. Hệ thống chưa có bảng phương vị Thần Tài/Hỷ Thần/Quý Thần
        theo ngày nên hướng xuất hành chỉ được xét qua Cung Mệnh Bát Trạch — không khẳng định chắc chắn về hiệu quả.
      </p>
    </div>
  </Container>
  <BottomNav />
</BaseLayout>

<script>
  import { readDateSelects } from "../../lib/date-select";

  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface YeuTo { ten: string; diem: number }
  interface QuanHe { diem: number; moTa: string }
  interface TrachCatDayBaseResult { diem: number; yeuTo: YeuTo[] }
  interface DayPersonalResult { diem: number; nguHanh: QuanHe; can: QuanHe; chi: QuanHe }
  interface DayScoreFull {
    diem: number;
    nhan: string;
    base: TrachCatDayBaseResult;
    mucDich: TrachCatDayBaseResult;
    canNhan: DayPersonalResult;
  }
  interface HourScoreFull { diem: number; nhan: string; yeuTo: YeuTo[] }
  interface ToHop {
    solarDate: { year: number; month: number; day: number };
    khungGio: string;
    chiGio: string;
    finalDiem: number;
    hang: string;
    nhan: string;
    dayScore: DayScoreFull;
    hourScore: HourScoreFull;
    catCaNhan?: { tang: string | null; nhan: string } | null;
  }
  interface RangeResult { xepHang: ToHop[] }

  const MAU_TANG: Record<string, string> = {
    "chan-loc": "bg-amber-100 text-amber-700", "chan-duong-quy": "bg-violet-100 text-violet-700",
    "chan-am-quy": "bg-indigo-100 text-indigo-700", "loc": "bg-amber-50 text-amber-600 ring-1 ring-amber-200",
    "tam-hop": "bg-emerald-100 text-emerald-700", "luc-hop": "bg-teal-100 text-teal-700",
  };
  const ICON_TANG: Record<string, string> = { "chan-loc": "💰", "chan-duong-quy": "🌤️", "chan-am-quy": "🌙", "loc": "🪙", "tam-hop": "☯", "luc-hop": "☯" };
  function badgeCat(c: { tang: string | null; nhan: string } | null | undefined): string {
    if (!c || !c.tang) return "";
    return ` <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-bold ${MAU_TANG[c.tang] ?? "bg-slate-100 text-slate-600"}">${ICON_TANG[c.tang] ?? ""} ${c.nhan}</span>`;
  }
  interface MotNgayResult { xepHang: ToHop[] }

  // Render danh sách yếu tố kiểu DELTA (base/mucDich của trachCatDayBase.ts — mỗi mục là số cộng/trừ
  // nhỏ, không phải điểm tuyệt đối 0-10) — tô màu theo DẤU (dương = có lợi, âm = bất lợi).
  function renderDeltaYeuTo(list: YeuTo[]): string {
    if (list.length === 0) return `<li class="text-slate-400">Không có yếu tố đặc biệt.</li>`;
    return list
      .map((y) => {
        const cls = y.diem > 0 ? "text-emerald-600" : y.diem < 0 ? "text-(--color-cinnabar-500)" : "text-slate-500";
        const dau = y.diem > 0 ? "+" : "";
        return `<li class="flex justify-between gap-2"><span>${y.ten}</span><span class="${cls} font-semibold">${dau}${y.diem}</span></li>`;
      })
      .join("");
  }
  // Render danh sách yếu tố kiểu ĐIỂM TUYỆT ĐỐI 0-10 (yeuTo của gioTotTrongNgay.ts, và các quan hệ
  // Ngũ Hành/Can/Chi ngày↔tuổi) — tô màu theo ngưỡng NỀN (5 = trung bình).
  function renderAbsYeuTo(list: { ten: string; diem: number }[]): string {
    if (list.length === 0) return `<li class="text-slate-400">Không có yếu tố đặc biệt.</li>`;
    return list
      .map((y) => {
        const cls = y.diem >= 5 ? "text-(--color-cinnabar-500)" : "text-slate-500";
        return `<li class="flex justify-between gap-2"><span>${y.ten}</span><span class="${cls} font-semibold">${y.diem}</span></li>`;
      })
      .join("");
  }
  function dayViSaoHtml(d: DayScoreFull): string {
    return `<p class="text-xs font-semibold text-slate-700">Nền Trạch Cát ngày:</p>
      <ul class="mt-1 space-y-0.5 text-xs text-slate-600">${renderDeltaYeuTo(d.base.yeuTo)}</ul>
      <p class="mt-2.5 text-xs font-semibold text-slate-700">Theo mục đích chuyến đi:</p>
      <ul class="mt-1 space-y-0.5 text-xs text-slate-600">${renderDeltaYeuTo(d.mucDich.yeuTo)}</ul>
      <p class="mt-2.5 text-xs font-semibold text-slate-700">Ngày ↔ tuổi:</p>
      <ul class="mt-1 space-y-0.5 text-xs text-slate-600">${renderAbsYeuTo([
        { ten: `Ngũ Hành (${d.canNhan.nguHanh.moTa})`, diem: d.canNhan.nguHanh.diem },
        { ten: `Thiên Can (${d.canNhan.can.moTa})`, diem: d.canNhan.can.diem },
        { ten: `Địa Chi (${d.canNhan.chi.moTa})`, diem: d.canNhan.chi.diem },
      ])}</ul>`;
  }
  function hourViSaoHtml(h: HourScoreFull): string {
    return `<ul class="space-y-0.5 text-xs text-slate-600">${renderAbsYeuTo(h.yeuTo)}</ul>`;
  }

  const form = document.getElementById("form-xuat-hanh") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;
  const ketQuaGioEl = document.getElementById("ket-qua-gio")!;
  const gioTieuDeEl = document.getElementById("gio-tieu-de")!;
  const gioDanhSachEl = document.getElementById("gio-danh-sach")!;

  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  function pad2(n: number): string {
    return String(n).padStart(2, "0");
  }

  let thamSoHienTai = { purpose: "", gioiTinh: "", huong: "", namSinh: "" };

  async function taiGioTrongNgay(year: number, month: number, day: number) {
    const { purpose, gioiTinh, huong, namSinh } = thamSoHienTai;
    const qs = `purpose=${purpose}&gioiTinh=${encodeURIComponent(gioiTinh)}&huong=${encodeURIComponent(huong)}&namSinh=${namSinh}&year=${year}&month=${month}&day=${day}`;
    try {
      const res = await fetch(`/api/ngay-gio-xuat-hanh?${qs}`);
      const data = await res.json();
      if (!res.ok) return;
      const result = data as MotNgayResult;
      const top5Gio = result.xepHang.slice(0, 5);
      gioTieuDeEl.textContent = `Ngày ${pad2(day)}/${pad2(month)}/${year} — xếp hạng đủ 12 giờ Địa Chi`;
      gioDanhSachEl.innerHTML = top5Gio
        .map(
          (g, i) =>
            `<div class="rounded-xl border border-slate-200 bg-slate-50">
              <button type="button" class="xh-gio-vi-sao w-full p-2.5 text-left" data-idx="${i}">
                <div class="flex items-center justify-between">
                  <p class="text-sm font-semibold text-slate-900">${HUY_CHUONG[i] ?? `${i + 1}.`} ${g.khungGio} (giờ ${g.chiGio})</p>
                  <span class="text-sm">${nhanDotHtml(g.nhan)} — ${g.finalDiem}/10</span>
                </div>
                <p class="mt-1 text-xs text-amber-600">Vì sao? (bấm để xem chi tiết)</p>
              </button>
              <div class="xh-gio-chi-tiet hidden border-t border-slate-200 px-2.5 py-2.5">${hourViSaoHtml(g.hourScore)}</div>
            </div>`,
        )
        .join("");
      gioDanhSachEl.querySelectorAll<HTMLButtonElement>(".xh-gio-vi-sao").forEach((btn) => {
        btn.addEventListener("click", () => {
          (btn.nextElementSibling as HTMLElement).classList.toggle("hidden");
        });
      });
      ketQuaGioEl.classList.remove("hidden");
      ketQuaGioEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch {
      // bỏ qua lỗi phụ, không chặn luồng chính
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    ketQuaGioEl.classList.add("hidden");

    const purpose = (document.getElementById("xh-muc-dich") as HTMLSelectElement).value;
    const namSinh = (document.getElementById("xh-nam-sinh") as HTMLInputElement).value;
    const gioiTinh = (document.getElementById("xh-gioi-tinh") as HTMLSelectElement).value;
    const huong = (document.getElementById("xh-huong") as HTMLSelectElement).value;
    const tuNgay = readDateSelects("xh-tu-ngay");
    const denNgay = readDateSelects("xh-den-ngay");

    if (!namSinh) {
      loiEl.textContent = "Vui lòng nhập năm sinh.";
      loiEl.classList.remove("hidden");
      return;
    }
    if (!tuNgay || !denNgay) {
      loiEl.textContent = "Vui lòng chọn đầy đủ Từ ngày và Đến ngày.";
      loiEl.classList.remove("hidden");
      return;
    }
    thamSoHienTai = { purpose, gioiTinh, huong, namSinh };
    const { year: startYear, month: startMonth, day: startDay } = tuNgay;
    const { year: endYear, month: endMonth, day: endDay } = denNgay;

    const qs = `purpose=${purpose}&gioiTinh=${encodeURIComponent(gioiTinh)}&huong=${encodeURIComponent(huong)}&namSinh=${namSinh}&startYear=${startYear}&startMonth=${startMonth}&startDay=${startDay}&endYear=${endYear}&endMonth=${endMonth}&endDay=${endDay}`;

    try {
      const res = await fetch(`/api/ngay-gio-xuat-hanh?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const result = data as RangeResult;

      // `xepHang` đã sắp giảm dần theo finalDiem trên TOÀN BỘ tổ hợp ngày×giờ — lấy tổ hợp đầu
      // tiên gặp của mỗi ngày (chính là giờ tốt nhất trong ngày đó), rồi xếp hạng NGÀY theo điểm
      // giờ tốt nhất này. Bấm vào 1 ngày sẽ gọi API riêng để xem đủ nhiều lựa chọn giờ (canh giờ)
      // khác trong ngày đó, không chỉ 1 giờ duy nhất.
      const ngayTotNhatMap = new Map<string, ToHop>();
      for (const t of result.xepHang) {
        const key = `${t.solarDate.year}-${t.solarDate.month}-${t.solarDate.day}`;
        if (!ngayTotNhatMap.has(key)) ngayTotNhatMap.set(key, t);
      }
      // Chỉ hiện những ngày mà GIỜ TỐT NHẤT của ngày đó đạt hạng "có thể dùng" trở lên — "Top 5"
      // không nên ép đủ 5 kết quả bằng cả những ngày "Không thuận"/"Không nên chọn" chỉ vì chúng
      // xếp hạng cao hơn phần còn lại trong khoảng ngày đã quét.
      const HANG_DUNG_DUOC = new Set(["rat-tot", "tot", "kha-tot", "co-the-dung"]);
      const top5Ngay = [...ngayTotNhatMap.values()]
        .filter((t) => HANG_DUNG_DUOC.has(t.hang))
        .sort((a, b) => b.finalDiem - a.finalDiem)
        .slice(0, 5);

      if (top5Ngay.length === 0) {
        ketQuaEl.innerHTML = `<div class="rounded-xl border border-(--color-danger-500)/30 bg-(--color-danger-500)/5 p-4 text-sm text-slate-600">
          Không có ngày nào trong khoảng đã chọn đủ tốt để xuất hành (mọi ngày đều rơi vào mức "Không thuận" trở xuống).
          Anh thử chọn khoảng ngày khác hoặc đổi mục đích xem sao.
        </div>`;
        ketQuaGioEl.classList.add("hidden");
        ketQuaEl.classList.remove("hidden");
        return;
      }

      ketQuaEl.innerHTML = top5Ngay
        .map((t, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          const ngayStr = `${pad2(t.solarDate.day)}/${pad2(t.solarDate.month)}/${t.solarDate.year}`;
          return `<div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
            <div class="flex items-center justify-between">
              <p class="font-display text-base font-bold text-slate-900">${huyChuong} ${ngayStr}${badgeCat(t.catCaNhan)}</p>
              <span class="text-sm font-semibold">${nhanDotHtml(t.nhan)} — ${t.finalDiem}/10</span>
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Giờ tốt nhất: ${t.khungGio} (giờ ${t.chiGio}) · Ngày: ${nhanDotHtml(t.dayScore.nhan)} (${t.dayScore.diem}/10) · Giờ: ${nhanDotHtml(t.hourScore.nhan)} (${t.hourScore.diem}/10)</p>
            <div class="mt-2 flex gap-2">
              <button type="button" class="xh-xem-gio rounded-lg bg-amber-500 px-2.5 py-1 text-xs font-semibold text-white" data-year="${t.solarDate.year}" data-month="${t.solarDate.month}" data-day="${t.solarDate.day}">Xem giờ khác</button>
              <button type="button" class="xh-vi-sao rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700" data-idx="${i}">Vì sao?</button>
            </div>
            <div class="xh-ngay-chi-tiet hidden mt-2.5 border-t border-slate-200 pt-2.5">${dayViSaoHtml(t.dayScore)}</div>
          </div>`;
        })
        .join("");

      ketQuaEl.querySelectorAll<HTMLButtonElement>(".xh-xem-gio").forEach((btn) => {
        btn.addEventListener("click", () => {
          void taiGioTrongNgay(Number(btn.dataset.year), Number(btn.dataset.month), Number(btn.dataset.day));
        });
      });
      ketQuaEl.querySelectorAll<HTMLButtonElement>(".xh-vi-sao").forEach((btn) => {
        btn.addEventListener("click", () => {
          const chiTiet = btn.parentElement!.nextElementSibling as HTMLElement;
          chiTiet.classList.toggle("hidden");
        });
      });

      ketQuaEl.classList.remove("hidden");
      // Tự mở sẵn danh sách giờ của ngày tốt nhất, để người dùng thấy ngay nhiều lựa chọn giờ
      // thay vì chỉ 1 giờ duy nhất trên mỗi ngày.
      const d = top5Ngay[0]!.solarDate;
      void taiGioTrongNgay(d.year, d.month, d.day);
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
