---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Đổi Dương Lịch ↔ Âm Lịch"
  description="Đổi ngày Dương lịch sang Âm lịch Việt Nam và ngược lại, có xử lý tháng nhuận, chính xác theo thuật toán thiên văn."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Đổi Dương Lịch ↔ Âm Lịch"
    description="Chuyển đổi hai chiều giữa Dương lịch và Âm lịch Việt Nam (không phải lịch Trung Quốc), có xử lý tháng nhuận."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Đổi Dương Lịch ↔ Âm Lịch" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <div class="flex gap-2 border-b border-(--color-ivory-300) pb-3">
          <button type="button" id="tab-duong-am" class="rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)">
            🌞 Dương → Âm
          </button>
          <button type="button" id="tab-am-duong" class="rounded-(--radius-pill) border border-(--color-ivory-400) px-4 py-2 text-sm font-semibold text-(--color-ink-600) hover:bg-(--color-ivory-200)">
            🌙 Âm → Dương
          </button>
        </div>

        <form id="form-duong-am" class="mt-4 flex flex-col gap-3">
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="da-ngay" class="text-xs font-medium text-(--color-ink-600)">Ngày</label>
              <input type="number" id="da-ngay" min="1" max="31" required placeholder="18" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="da-thang" class="text-xs font-medium text-(--color-ink-600)">Tháng</label>
              <input type="number" id="da-thang" min="1" max="12" required placeholder="8" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="da-nam" class="text-xs font-medium text-(--color-ink-600)">Năm</label>
              <input type="number" id="da-nam" min="1900" max="2100" required placeholder="2026" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <Button type="submit" size="lg">Đổi sang Âm lịch</Button>
        </form>

        <form id="form-am-duong" class="mt-4 hidden flex-col gap-3">
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="ad-ngay" class="text-xs font-medium text-(--color-ink-600)">Ngày âm</label>
              <input type="number" id="ad-ngay" min="1" max="30" required placeholder="6" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="ad-thang" class="text-xs font-medium text-(--color-ink-600)">Tháng âm</label>
              <input type="number" id="ad-thang" min="1" max="12" required placeholder="7" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
            <div>
              <label for="ad-nam" class="text-xs font-medium text-(--color-ink-600)">Năm âm</label>
              <input type="number" id="ad-nam" min="1900" max="2100" required placeholder="2026" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            </div>
          </div>
          <label class="flex items-center gap-1.5 text-sm text-(--color-ink-600)">
            <input type="checkbox" id="ad-nhuan" /> Tháng nhuận
          </label>
          <Button type="submit" size="lg">Đổi sang Dương lịch</Button>
        </form>

        <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

        <div id="ket-qua" class="mt-4 hidden rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-5 text-center">
          <p id="kq-tren" class="text-lg font-semibold text-(--color-ink-500)"></p>
          <p class="my-2 text-2xl">↓</p>
          <p id="kq-duoi" class="font-display text-2xl font-bold text-(--color-ink-950)"></p>
          <p id="kq-nam-am-lich" class="mt-2 text-sm text-(--color-ink-500)"></p>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  interface SolarToLunarResult {
    duong: { day: number; month: number; year: number };
    am: { day: number; month: number; year: number; isLeapMonth: boolean };
    namAmLich: { can: string; chi: string; nhan: string };
  }
  interface LunarToSolarResult {
    am: { day: number; month: number; year: number; isLeapMonth: boolean };
    duong: { day: number; month: number; year: number };
    namAmLich: { can: string; chi: string; nhan: string };
  }

  function pad2(n: number): string {
    return String(n).padStart(2, "0");
  }

  const tabDuongAm = document.getElementById("tab-duong-am") as HTMLButtonElement;
  const tabAmDuong = document.getElementById("tab-am-duong") as HTMLButtonElement;
  const formDuongAm = document.getElementById("form-duong-am") as HTMLFormElement;
  const formAmDuong = document.getElementById("form-am-duong") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;
  const kqTrenEl = document.getElementById("kq-tren")!;
  const kqDuoiEl = document.getElementById("kq-duoi")!;
  const kqNamAmLichEl = document.getElementById("kq-nam-am-lich")!;

  const TAB_ACTIVE = "rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)";
  const TAB_INACTIVE = "rounded-(--radius-pill) border border-(--color-ivory-400) px-4 py-2 text-sm font-semibold text-(--color-ink-600) hover:bg-(--color-ivory-200)";

  function showTab(which: "duong-am" | "am-duong") {
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    if (which === "duong-am") {
      tabDuongAm.className = TAB_ACTIVE;
      tabAmDuong.className = TAB_INACTIVE;
      formDuongAm.classList.remove("hidden");
      formDuongAm.classList.add("flex");
      formAmDuong.classList.add("hidden");
      formAmDuong.classList.remove("flex");
    } else {
      tabAmDuong.className = TAB_ACTIVE;
      tabDuongAm.className = TAB_INACTIVE;
      formAmDuong.classList.remove("hidden");
      formAmDuong.classList.add("flex");
      formDuongAm.classList.add("hidden");
      formDuongAm.classList.remove("flex");
    }
  }

  tabDuongAm.addEventListener("click", () => showTab("duong-am"));
  tabAmDuong.addEventListener("click", () => showTab("am-duong"));

  formDuongAm.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const day = (document.getElementById("da-ngay") as HTMLInputElement).value;
    const month = (document.getElementById("da-thang") as HTMLInputElement).value;
    const year = (document.getElementById("da-nam") as HTMLInputElement).value;

    try {
      const res = await fetch(`/api/doi-lich-am-duong?direction=duong-sang-am&day=${day}&month=${month}&year=${year}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không đổi được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const result = data as SolarToLunarResult;
      kqTrenEl.textContent = `🌞 ${pad2(result.duong.day)}/${pad2(result.duong.month)}/${result.duong.year}`;
      kqDuoiEl.textContent = `🌙 ${pad2(result.am.day)}/${pad2(result.am.month)}${result.am.isLeapMonth ? " nhuận" : ""}/${result.am.year}`;
      kqNamAmLichEl.textContent = `Năm ${result.namAmLich.nhan}`;
      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });

  formAmDuong.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const day = (document.getElementById("ad-ngay") as HTMLInputElement).value;
    const month = (document.getElementById("ad-thang") as HTMLInputElement).value;
    const year = (document.getElementById("ad-nam") as HTMLInputElement).value;
    const isLeapMonth = (document.getElementById("ad-nhuan") as HTMLInputElement).checked;

    try {
      const res = await fetch(
        `/api/doi-lich-am-duong?direction=am-sang-duong&day=${day}&month=${month}&year=${year}&isLeapMonth=${isLeapMonth}`,
      );
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không đổi được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const result = data as LunarToSolarResult;
      kqTrenEl.textContent = `🌙 ${pad2(result.am.day)}/${pad2(result.am.month)}${result.am.isLeapMonth ? " nhuận" : ""}/${result.am.year}`;
      kqDuoiEl.textContent = `🌞 ${pad2(result.duong.day)}/${pad2(result.duong.month)}/${result.duong.year}`;
      kqNamAmLichEl.textContent = `Năm ${result.namAmLich.nhan}`;
      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
