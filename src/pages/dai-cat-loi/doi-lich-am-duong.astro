---
// TRANG "Đổi Dương Lịch ↔ Âm Lịch" (bản web) — chỉ lo khung trang (SEO/PageHero/breadcrumbs); toàn
// bộ công cụ nằm ở component dùng chung `DoiLichAmDuong.astro`, cũng được bản in-app Quân Sư
// (`/quan-su/doi-lich-am-duong`) tái sử dụng.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import DoiLichAmDuong from "../../components/tools/DoiLichAmDuong.astro";

export const prerender = true;
---

<BaseLayout
  title="Đổi Dương Lịch ↔ Âm Lịch"
  description="Đổi ngày Dương lịch sang Âm lịch Việt Nam và ngược lại, có xử lý tháng nhuận, chính xác theo thuật toán thiên văn."
>
  <PageHero
    eyebrow="Đại Cát Lợi"
    title="Đổi Dương Lịch ↔ Âm Lịch"
    description="Chuyển đổi hai chiều giữa Dương lịch và Âm lịch Việt Nam (không phải lịch Trung Quốc), có xử lý tháng nhuận."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Đổi Dương Lịch ↔ Âm Lịch" }]}
  />

  <DoiLichAmDuong />
</BaseLayout>
