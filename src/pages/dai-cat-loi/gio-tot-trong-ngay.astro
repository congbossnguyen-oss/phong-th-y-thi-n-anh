    description="Nhập 1 ngày dương lịch, chọn mục đích (nếu có) — hệ thống tự phân tích và xếp hạng 12 giờ Địa Chi."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Đại Cát Lợi", href: "/dai-cat-loi" }, { label: "Giờ tốt trong ngày" }]}
  />

  <GioTotTrongNgay />
