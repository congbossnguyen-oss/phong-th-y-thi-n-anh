  /**
   * Kết quả PHASE 2 — chèn thêm vào cuối khối kết quả.
   *
   * ⚠️ TUYỆT ĐỐI KHÔNG hiện điểm số thô. Đặc tả mục 6 yêu cầu tách rõ 2 phần "cách cục nền" và
   * "quan hệ đạt", và cấm hẳn kiểu câu "Hà Đồ 140 điểm tốt hơn Đồng quái khí 120 điểm". Engine đã
   * để điểm ở trường `diemNoiBo` riêng — không được đọc trường đó ra đây.
   */
  function renderPhase2(p2: any) {
    const el = document.getElementById("glhh-ket-qua")!;

    if (p2.ketCuc === "mien-tru") {
      el.insertAdjacentHTML(
        "beforeend",
        `<div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Lọc theo tọa hướng huyệt mộ</p>
          <p class="mt-2 text-sm font-medium">Áp dụng phép quyền biến: ${escapeHtml(p2.nhanh)}</p>
          <p class="mt-1 text-sm text-slate-600">${escapeHtml(p2.giaiThich)}</p>
        </div>`,
      );
      return;
    }
    if (p2.ketCuc !== "A" && p2.ketCuc !== "B") return;

    const dsHtml = p2.phuongAn
      .map(
        (pa: any) => `
        <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-4">
          <p class="font-display font-bold text-slate-900">Phương án ${pa.thuHang} — ${escapeHtml(pa.id)}</p>
          <dl class="mt-2 space-y-1 text-sm">
            <div class="flex gap-2">
              <dt class="shrink-0 text-slate-500">Cách cục nền:</dt>
              <dd class="font-medium text-slate-900">${escapeHtml(pa.cachCuc.tenLop)}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="shrink-0 text-slate-500">Quan hệ đạt:</dt>
              <dd class="text-slate-800">${pa.quanHeDat.length ? pa.quanHeDat.map(escapeHtml).join(" · ") : "—"}</dd>
            </div>
            ${
              pa.canhBao.length
                ? `<div class="flex gap-2">
                     <dt class="shrink-0 text-slate-500">Ghi chú:</dt>
                     <dd class="text-amber-700">${pa.canhBao.map(escapeHtml).join("; ")}</dd>
                   </div>`
                : ""
            }
          </dl>
        </div>`,
      )
      .join("");

    el.insertAdjacentHTML(
      "beforeend",
      `<div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Lọc &amp; xếp hạng theo tọa hướng huyệt mộ</p>
        <p class="mt-1 text-sm text-slate-600">
          Tọa ${escapeHtml(p2.toaHuong.sonToa)} ${p2.toaHuong.doSoToa.toFixed(1)}° —
          hướng ${escapeHtml(p2.toaHuong.sonHuong)} ${p2.toaHuong.doSoHuong.toFixed(1)}°.
          ${
            p2.soPhuongAnQuaLoc > 0
              ? `Đã rà toàn bộ ngày giờ trong khung 20 ngày, loại hết các phương án có sát phương vị đáo tọa hoặc đáo hướng. Dưới đây là những phương án đạt nhất.`
              : ""
          }
        </p>
        <div class="mt-3 space-y-3">${dsHtml || `<p class="text-sm text-slate-500">Không còn phương án nào qua được lọc tọa hướng — vui lòng liên hệ tư vấn trực tiếp.</p>`}</div>
        ${p2.cauKetLuan ? `<p class="mt-3 text-sm font-medium text-slate-700">${escapeHtml(p2.cauKetLuan)}</p>` : ""}
        ${
          p2.thieuDuLieu.length
            ? `<p class="mt-3 text-xs text-amber-700">${p2.thieuDuLieu.map(escapeHtml).join(" ")}</p>`
            : ""
        }
      </div>`,
    );
  }

  const form = document.getElementById("glhh-form") as HTMLFormElement;
  const loiEl = document.getElementById("glhh-loi")!;
  const thanhToanEl = document.getElementById("glhh-thanh-toan")!;
  const ketQuaEl = document.getElementById("glhh-ket-qua")!;
  const qrImg = document.getElementById("glhh-qr") as HTMLImageElement;
  const orderCodeEl = document.getElementById("glhh-order-code")!;
  const trangThaiEl = document.getElementById("glhh-trang-thai")!;

  const khoiToaEl = document.getElementById("glhh-khoi-toa")!;
  const chuaThuPhiEl = document.getElementById("glhh-chua-thu-phi")!;
  const doLaiEl = document.getElementById("glhh-do-lai")!;
  const toaDoInput = document.getElementById("glhh-toa-do") as HTMLInputElement;

  const nhanNutEl = document.getElementById("glhh-nhan-nut");
  const huongDoInput = document.getElementById("glhh-huong-do") as HTMLInputElement;
  const quyDoiEl = document.getElementById("glhh-quy-doi")!;

  /**
   * Tọa và hướng luôn đối nhau 180°, nên gia đình đo được số nào thì nhập số đó.
   *
   * Chỉ điền ô còn lại, KHÔNG tự sửa ô người dùng đang gõ — nếu hai ô cùng ghi đè lẫn nhau thì
   * con trỏ nhảy lung tung và không sửa nổi số đã nhập. Máy chủ vẫn chỉ nhận `doSoToa`.
   */
  function doiSang180(v: string): string {
    const n = Number(v);
    if (v.trim() === "" || !Number.isFinite(n)) return "";
    return String(Math.round((((n + 180) % 360) + 360) % 360 * 10) / 10);
  }

  function moTaQuyDoi() {
    const toa = toaDoInput.value.trim();
    quyDoiEl.textContent = toa === "" ? "" : `Hệ thống sẽ tính theo tọa ${toa}° — hướng ${doiSang180(toa)}°.`;
  }

  toaDoInput.addEventListener("input", () => {
    huongDoInput.value = doiSang180(toaDoInput.value);
    moTaQuyDoi();
  });
  huongDoInput.addEventListener("input", () => {
    toaDoInput.value = doiSang180(huongDoInput.value);
    moTaQuyDoi();
  });

  /**
   * Ô tọa độ chỉ hiện khi gia đình đã có huyệt — chưa có huyệt thì nhập tọa độ là vô nghĩa.
   * Đồng thời đổi nhãn giá trên nút, để khách thấy đúng số tiền sắp trả trước khi bấm.
   */
  function capNhatKhoiToa() {
    const daCo = (form.querySelector('input[name="glhh-co-huyet"]:checked') as HTMLInputElement)?.value === "da-co";
    khoiToaEl.classList.toggle("hidden", !daCo);
    if (nhanNutEl) {
      const gia = daCo ? form.dataset.giaDayDu : form.dataset.giaCoBan;
      nhanNutEl.textContent = `Thanh toán ${gia} & Xem kết quả`;
    }
  }
  for (const radio of form.querySelectorAll('input[name="glhh-co-huyet"]')) {
    radio.addEventListener("change", capNhatKhoiToa);
  }
  capNhatKhoiToa();

  const khoiPdfEl = document.getElementById("glhh-khoi-pdf")!;
  const taiPdfBtn = document.getElementById("glhh-tai-pdf") as HTMLButtonElement;
  /** Payload của lần tính gần nhất — endpoint hồ sơ tự tính lại từ đây, không nhận kết quả sẵn. */
  let payloadGanNhat: Record<string, unknown> | null = null;

  taiPdfBtn.addEventListener("click", async () => {
    if (!payloadGanNhat) return;
    const chuGoc = taiPdfBtn.textContent;
    taiPdfBtn.disabled = true;
    taiPdfBtn.textContent = "Đang tạo hồ sơ...";
    try {
      const res = await fetch("/api/dai-cat-loi/gio-liem-ha-huyet/ho-so", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payloadGanNhat),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        loiEl.textContent = data?.error ?? "Không tạo được hồ sơ PDF.";
        loiEl.classList.remove("hidden");
        return;
      }
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "ho-so-tang-le.pdf";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch {
      loiEl.textContent = "Không tạo được hồ sơ PDF. Vui lòng thử lại.";
      loiEl.classList.remove("hidden");
    } finally {
      taiPdfBtn.disabled = false;
      taiPdfBtn.textContent = chuGoc;
    }
  });

  const goiCoBanEl = document.getElementById("glhh-goi-co-ban")!;

  // Chuyển sang gói cơ bản = bỏ tọa mộ đi rồi tính lại. Không giữ lại tọa độ để tránh cảnh khách
  // tưởng mình vẫn được lọc theo tọa hướng mà thực ra không.
  document.getElementById("glhh-chuyen-co-ban")!.addEventListener("click", () => {
    (form.querySelector('input[name="glhh-co-huyet"][value="chua"]') as HTMLInputElement).click();
    toaDoInput.value = "";
    huongDoInput.value = "";
    quyDoiEl.textContent = "";
    chuaThuPhiEl.classList.add("hidden");
    goiCoBanEl.classList.add("hidden");
    form.requestSubmit();
  });

  document.getElementById("glhh-ctp-quay-lai")!.addEventListener("click", () => {
    chuaThuPhiEl.classList.add("hidden");
    toaDoInput.focus();
    toaDoInput.select();
  });

  let pollTimer: ReturnType<typeof setInterval> | null = null;

  function stopPolling() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
  }

  async function pollResult(orderCode: string) {
    try {
      const res = await fetch(`/api/dai-cat-loi/gio-liem-ha-huyet/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!res.ok || !data.ok) return; // giữ nguyên trạng thái chờ, thử lại lần sau

      if (data.status === "confirmed") {
        stopPolling();
        trangThaiEl.textContent = "Đã thanh toán — đang hiển thị kết quả bên dưới.";
        thanhToanEl.classList.add("hidden");
        form.classList.add("hidden"); // tránh gửi lại form (tạo đơn mới, thu phí lần nữa) sau khi đã có kết quả
        renderKetQua(data.result as GioLiemHaHuyetResult);
        if (data.phase2) renderPhase2(data.phase2);
        khoiPdfEl.classList.remove("hidden");
      } else if (data.status === "cancelled") {
        stopPolling();
        trangThaiEl.textContent = "Đơn hàng đã bị hủy. Vui lòng thử lại.";
      }
    } catch {
      // lỗi mạng tạm thời — bỏ qua, chờ lần poll kế tiếp
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    thanhToanEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    chuaThuPhiEl.classList.add("hidden");
    doLaiEl.classList.add("hidden");
    khoiPdfEl.classList.add("hidden");
    stopPolling();

    const gioiTinh = (form.querySelector('input[name="gioiTinh"]:checked') as HTMLInputElement).value;
    const namSinhDuongLich = (document.getElementById("glhh-nam-sinh") as HTMLInputElement).value;
    const ngayMat = readDateSelects("glhh-ngay-mat");
    const chiGioMat = (document.getElementById("glhh-gio-mat") as HTMLSelectElement).value;
    const soNgayRaw = (document.getElementById("glhh-so-ngay") as HTMLInputElement).value;
    const diChuyenRaw = (document.getElementById("glhh-di-chuyen") as HTMLInputElement).value;
    const truongNam = (document.getElementById("glhh-truong-nam") as HTMLSelectElement).value;
    const conDauLon = (document.getElementById("glhh-con-dau-lon") as HTMLSelectElement).value;
    const chauDichTon = (document.getElementById("glhh-chau-dich-ton") as HTMLSelectElement).value;
    const anhTraiLon = (document.getElementById("glhh-anh-trai-lon") as HTMLSelectElement).value;
    // Các ô này chỉ tồn tại khi đã bật thu phí (xem TEST_MODE ở frontmatter) — dùng optional
    // chaining để lúc thử nghiệm không vỡ vì getElementById trả null.
    const doc = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";
    const customerName = doc("glhh-ten");
    const customerPhone = doc("glhh-sdt");
    const customerEmail = doc("glhh-email");
    const maKhuyenMai = doc("glhh-ma-input");

    if (!ngayMat) {
      loiEl.textContent = "Vui lòng chọn đầy đủ ngày mất.";
      loiEl.classList.remove("hidden");
      return;
    }
    if (!chiGioMat) {
      loiEl.textContent = "Vui lòng chọn giờ mất.";
      loiEl.classList.remove("hidden");
      return;
    }

    const daCoHuyet =
      (form.querySelector('input[name="glhh-co-huyet"]:checked') as HTMLInputElement)?.value === "da-co";
    const nguyenNhanMat = (document.getElementById("glhh-nguyen-nhan") as HTMLSelectElement).value;
    const doSoToaRaw = toaDoInput.value.trim();
    if (daCoHuyet && doSoToaRaw === "") {
      loiEl.textContent = "Gia đình đã có huyệt mộ — vui lòng nhập số đo tọa hoặc hướng huyệt (đo bằng la kinh).";
      loiEl.classList.remove("hidden");
      return;
    }

    // ⚠️ CỔNG KIỂM CHẠY TRƯỚC MỌI THỨ, KỂ CẢ TRƯỚC KHI TẠO ĐƠN. Phạm sát cấp năm thì không ngày
    // giờ nào cứu được, nên phải chặn ở đây — không bao giờ để thu tiền rồi mới báo không làm
    // được (đặc tả Phase 2 mục 2.1b).
    if (daCoHuyet) {
      try {
        const resKiem = await fetch("/api/dai-cat-loi/gio-liem-ha-huyet/kiem-toa-huong", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            doSoToa: Number(doSoToaRaw),
            namMat: ngayMat.year,
            thangMat: ngayMat.month,
            ngayMat: ngayMat.day,
            gioiTinh,
            namSinhDuongLich: Number(namSinhDuongLich),
            chiGioMat,
            ...(soNgayRaw ? { soNgayDuKienToiChon: Number(soNgayRaw) } : {}),
            nguyenNhanMat,
          }),
        });
        const dataKiem = await resKiem.json();
        if (!resKiem.ok || !dataKiem.ok) {
          loiEl.textContent = dataKiem.error ?? "Không kiểm được tọa hướng.";
          loiEl.classList.remove("hidden");
          return;
        }
        const kq = dataKiem.ketQua;
        if (kq.ketCuc === "can-do-lai") {
          document.getElementById("glhh-do-lai-ly-do")!.textContent = kq.thongDiep;
          doLaiEl.classList.remove("hidden");
          doLaiEl.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        // Kết cục C, hoặc lọc sạch không còn phương án nào — cả hai đều KHÔNG thu phí.
        if (kq.ketCuc === "C" || kq.ketCuc === "rong") {
          document.getElementById("glhh-ctp-ly-do")!.textContent = kq.thongDiep;
          // Phần lọc theo tọa hướng không làm được thì không thu tiền phần đó — nhưng Phase 1 vẫn
          // có kết quả, nên mời gói cơ bản. Đây là nói thật, không phải hạ giá để vớt khách.
          goiCoBanEl.classList.toggle("hidden", kq.ketCuc !== "rong" || !kq.conGoiCoBan);
          chuaThuPhiEl.classList.remove("hidden");
          chuaThuPhiEl.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
      } catch {
        loiEl.textContent = "Không kiểm được tọa hướng. Vui lòng thử lại.";
        loiEl.classList.remove("hidden");
        return;
      }
    }

    const thanQuyen: Record<string, string> = {};
    if (truongNam) thanQuyen.chiTruongNam = truongNam;
    if (conDauLon) thanQuyen.chiConDauLon = conDauLon;
    if (chauDichTon) thanQuyen.chiChauDichTon = chauDichTon;
    if (anhTraiLon) thanQuyen.chiAnhTraiLon = anhTraiLon;

    const payload = {
      gioiTinh,
      namSinhDuongLich: Number(namSinhDuongLich),
      namMat: ngayMat.year,
      thangMat: ngayMat.month,
      ngayMat: ngayMat.day,
      chiGioMat,
      ...(soNgayRaw ? { soNgayDuKienToiChon: Number(soNgayRaw) } : {}),
      ...(diChuyenRaw ? { thoiGianDiChuyenPhut: Number(diChuyenRaw) } : {}),
      ...(Object.keys(thanQuyen).length > 0 ? { thanQuyen } : {}),
      nguyenNhanMat,
      ...(daCoHuyet ? { doSoToa: Number(doSoToaRaw) } : {}),
      ...(doc("glhh-ho-ten-vong") ? { hoTenNguoiMat: doc("glhh-ho-ten-vong") } : {}),
      customerName,
      customerPhone,
      ...(customerEmail ? { customerEmail } : {}),
      ...(maKhuyenMai ? { maKhuyenMai } : {}),
    };
    // Ghi lại để nút "Tải hồ sơ PDF" gửi đúng bộ dữ liệu này — dùng chung cho cả luồng thử
    // nghiệm lẫn luồng thu phí.
    payloadGanNhat = payload;

    // ⚠️ TẠM THỜI (test nội bộ, yêu cầu Công 2026-08-14): gọi thẳng test-calculate.ts, bỏ qua
    // bước tạo đơn + QR SePay. Để bật lại thu phí: đổi endpoint về checkout.ts và khôi phục
    // đoạn xử lý QR/polling đã lưu trong lịch sử git (commit thêm module này).
    if (TEST_MODE) {
      try {
        const res = await fetch("/api/dai-cat-loi/gio-liem-ha-huyet/test-calculate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          loiEl.textContent = data.error ?? "Không tính được.";
          loiEl.classList.remove("hidden");
          return;
        }
        renderKetQua(data.result as GioLiemHaHuyetResult);
        if (data.phase2) renderPhase2(data.phase2);
        khoiPdfEl.classList.remove("hidden");
        ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch {
        loiEl.textContent = "Không tính được. Vui lòng thử lại.";
        loiEl.classList.remove("hidden");
      }
      return;
    }

    try {
      const res = await fetch("/api/dai-cat-loi/gio-liem-ha-huyet/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        // Máy chủ cũng chặn kết cục C (hàng rào thứ hai, phòng khi hàng rào phía trình duyệt bị
        // bỏ qua). Trường hợp này KHÔNG phải lỗi nhập liệu — hiện đúng màn hình "chưa thu phí".
        if (data.chuaThuPhi) {
          document.getElementById("glhh-ctp-ly-do")!.textContent = data.error;
          chuaThuPhiEl.classList.remove("hidden");
          chuaThuPhiEl.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        loiEl.textContent = data.error ?? "Không tạo được đơn hàng.";
        loiEl.classList.remove("hidden");
        return;
      }

      // Mã miễn phí 100%: server đã xác nhận đơn luôn và trả qrUrl = null. Không được gán null vào
      // thẻ ảnh (QR vỡ) rồi bảo khách "đang chờ thanh toán" — lấy kết quả về ngay.
      if (data.mienPhi) {
        orderCodeEl.textContent = data.orderCode;
        await pollResult(data.orderCode);
        return;
      }

      qrImg.src = data.qrUrl;
      orderCodeEl.textContent = data.orderCode;
      trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      thanhToanEl.classList.remove("hidden");
      thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });

      pollTimer = setInterval(() => pollResult(data.orderCode), 3000);
    } catch {
      loiEl.textContent = "Không tạo được đơn hàng. Vui lòng thử lại.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
