---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";

// Không prerender: cần đọc phiên đăng nhập lúc request để chặn khách chưa có tài khoản.
export const prerender = false;

// Dịch vụ thu phí bắt buộc đăng nhập — để mỗi lượt dùng gắn được với một khách hàng cụ thể
// (họ tên/email/SĐT), phục vụ đối soát đơn, tra lại kết quả cũ và theo dõi mã khuyến mãi.
//
// KHÔNG redirect thẳng sang trang đăng nhập: phần giới thiệu dịch vụ vẫn phải xem được (và Google
// vẫn index được) — chỉ riêng khối form bị thay bằng lời mời đăng nhập. Chốt chặn thật nằm ở API.
const user = Astro.locals.user;
const DUONG_DAN = "/dai-cat-loi/gio-liem-ha-huyet";

const CHI_LIST = ["Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ", "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"];
const TOOL_PRICE_LABEL = "499.000đ";
---

<BaseLayout
  title="Chọn Giờ Liệm – Đóng Quan – Ngày Giờ Hạ Huyệt"
  description="Xếp hạng giờ liệm/đóng quan và ngày giờ hạ huyệt theo Chưởng Pháp Trùng Tang – Nhập Mộ, có xét tuổi thân quyến. Dịch vụ thu phí 499.000đ/lượt, thanh toán qua QR, cần đăng nhập tài khoản."
>
  <PageHero
    eyebrow="⭐ Dịch vụ thu phí"
    title="Chọn Giờ Liệm – Đóng Quan – Ngày Giờ Hạ Huyệt"
    description={`Nhập thông tin người mất — hệ thống xếp hạng giờ liệm/đóng quan và ngày giờ hạ huyệt tốt nhất theo Chưởng Pháp Trùng Tang – Nhập Mộ. Phí ${TOOL_PRICE_LABEL}/lượt, thanh toán QR. Cần đăng nhập tài khoản.`}
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ thu phí", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Giờ Liệm – Hạ Huyệt" },
    ]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 rounded-(--radius-card) border-2 border-amber-400 bg-amber-50 p-4 text-sm font-medium text-amber-800">
        🧪 ĐANG THỬ NGHIỆM NỘI BỘ — tạm gỡ khỏi menu công khai, tạm bỏ bước thanh toán để test nhanh. Nộp form là ra kết quả ngay, không tạo đơn hàng thật.
      </div>
      <div class="mb-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-600)">
        Công cụ này KHÔNG chẩn đoán lại Trùng Tang (dùng công cụ <a href="/tinh-trung-tang" class="text-(--color-gold-300) hover:underline">Tính Trùng Tang miễn phí</a> nếu cần) —
        chỉ dùng Chưởng Pháp để xếp hạng giờ liệm/đóng quan và ngày giờ hạ huyệt tốt nhất. Cách tính dựa trên tư liệu dân
        gian tổng hợp, mang tính tương đối, không thay thế tư vấn phong thủy trực tiếp.
      </div>

      {!user && (
        <div class="rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-6 text-center">
          <p class="font-display text-lg font-semibold text-(--color-ink-950)">Cần đăng nhập để sử dụng</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-(--color-ink-700)">
            Đây là dịch vụ thu phí. Anh/chị vui lòng đăng nhập để hệ thống lưu đơn và kết quả vào
            đúng tài khoản của mình — sau này đăng nhập lại là xem lại được, không sợ mất.
          </p>
          <div class="mt-5 flex flex-wrap justify-center gap-3">
            <Button href={`/hoc-vien/dang-nhap?tiep=${encodeURIComponent(DUONG_DAN)}`} size="lg">Đăng nhập</Button>
            <Button href={`/hoc-vien/dang-ky?tiep=${encodeURIComponent(DUONG_DAN)}`} size="lg" variant="secondary">Tạo tài khoản</Button>
          </div>
        </div>
      )}

      {/* Form vẫn nằm trong DOM khi chưa đăng nhập (chỉ ẩn đi) để đoạn script phía dưới không vỡ.
          Đây KHÔNG phải hàng rào bảo mật — chốt chặn thật nằm ở API, xem các route dưới /api. */}
      <form
        id="glhh-form"
        class:list={[
          "flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6",
          !user && "hidden",
        ]}
      >
        <div>
          <p class="text-sm font-medium text-(--color-ink-800)">Giới tính người mất</p>
          <div class="mt-1.5 flex gap-4">
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)">
              <input type="radio" name="gioiTinh" value="nam" checked /> Nam
            </label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)">
              <input type="radio" name="gioiTinh" value="nu" /> Nữ
            </label>
          </div>
        </div>

        <div>
          <label for="glhh-nam-sinh" class="text-sm font-medium text-(--color-ink-800)">Năm sinh (dương lịch)</label>
          <input
            type="number"
            id="glhh-nam-sinh"
            placeholder="vd. 1950"
            min="1900"
            max="2100"
            required
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
          />
        </div>

        <div>
          <DateSelect idPrefix="glhh-ngay-mat" label="Ngày mất (dương lịch)" required yearsBack={80} yearsForward={0} />
        </div>

        <div>
          <label for="glhh-gio-mat" class="text-sm font-medium text-(--color-ink-800)">Giờ mất</label>
          <select
            id="glhh-gio-mat"
            required
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
          ></select>
        </div>

        <div>
          <label for="glhh-so-ngay" class="text-sm font-medium text-(--color-ink-800)">Số ngày dự kiến tới khi hạ huyệt (tùy chọn)</label>
          <input
            type="number"
            id="glhh-so-ngay"
            placeholder="Bỏ trống hoặc ≤3 nếu chôn trong vài ngày tới"
            min="1"
            max="60"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
          />
          <p class="mt-1 text-xs text-(--color-ink-500)">Nếu ≤3 ngày (hoặc bỏ trống): chỉ chọn giờ hạ huyệt, giữ nguyên ngày mất.</p>
        </div>

        <details class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
          <summary class="cursor-pointer text-sm font-medium text-(--color-ink-800)">Thêm tuổi thân quyến (tùy chọn — để xét giờ liệm kỵ)</summary>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <div>
              <label for="glhh-truong-nam" class="text-xs text-(--color-ink-600)">Tuổi (Chi) trưởng nam</label>
              <select id="glhh-truong-nam" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2 text-sm text-(--color-ink-800)">
                <option value="">Không rõ</option>
              </select>
            </div>
            <div>
              <label for="glhh-con-dau-lon" class="text-xs text-(--color-ink-600)">Tuổi (Chi) con dâu lớn</label>
              <select id="glhh-con-dau-lon" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2 text-sm text-(--color-ink-800)">
                <option value="">Không rõ</option>
              </select>
            </div>
            <div>
              <label for="glhh-chau-dich-ton" class="text-xs text-(--color-ink-600)">Tuổi (Chi) cháu đích tôn</label>
              <select id="glhh-chau-dich-ton" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2 text-sm text-(--color-ink-800)">
                <option value="">Không rõ</option>
              </select>
            </div>
            <div>
              <label for="glhh-anh-trai-lon" class="text-xs text-(--color-ink-600)">Tuổi (Chi) anh trai lớn</label>
              <select id="glhh-anh-trai-lon" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-2 text-sm text-(--color-ink-800)">
                <option value="">Không rõ</option>
              </select>
            </div>
          </div>
          <p class="mt-2 text-xs text-(--color-ink-500)">Nếu không có trưởng nam/con dâu lớn/cháu đích tôn, dùng anh trai lớn thay thế.</p>
        </details>

        <div class="border-t border-(--color-ivory-300) pt-4">
          <p class="text-sm font-medium text-(--color-ink-800)">Thông tin liên hệ (để nhận kết quả sau khi thanh toán)</p>
          {user && (
            <p class="mt-2 rounded-(--radius-control) bg-(--color-ivory-200) px-3 py-2.5 text-sm text-(--color-ink-700)">
              Tài khoản: <strong class="text-(--color-ink-900)">{user.name}</strong> · {user.email}
            </p>
          )}
          <div class="mt-2 grid gap-3">
            <input
              type="tel"
              id="glhh-sdt"
              placeholder="Số điện thoại"
              required
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
            />
          </div>
        </div>

        <Button type="submit" size="lg">Thanh toán {TOOL_PRICE_LABEL} & Xem kết quả</Button>
      </form>

      <div id="glhh-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <!-- Bước thanh toán -->
      <div id="glhh-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-amber-300 bg-white p-6 text-center text-slate-900 shadow-lg">
        <p class="font-display text-lg font-bold">Quét mã QR để thanh toán {TOOL_PRICE_LABEL}</p>
        <img id="glhh-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-slate-200" />
        <p class="text-sm text-slate-600">Mã đơn hàng: <strong id="glhh-order-code"></strong></p>
        <p id="glhh-trang-thai" class="text-sm font-medium text-amber-600">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
      </div>

      <!-- Kết quả -->
      <div id="glhh-ket-qua" class="mt-6 hidden space-y-6"></div>
    </div>
  </Container>
</BaseLayout>

<script define:vars={{ CHI_LIST }}>
  const gioMatSelect = document.getElementById("glhh-gio-mat");
  const truongNamSelect = document.getElementById("glhh-truong-nam");
  const conDauLonSelect = document.getElementById("glhh-con-dau-lon");
  const chauDichTonSelect = document.getElementById("glhh-chau-dich-ton");
  const anhTraiLonSelect = document.getElementById("glhh-anh-trai-lon");

  for (const chi of CHI_LIST) {
    gioMatSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">Giờ ${chi}</option>`);
    truongNamSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">${chi}</option>`);
    conDauLonSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">${chi}</option>`);
    chauDichTonSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">${chi}</option>`);
    anhTraiLonSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">${chi}</option>`);
  }
</script>

<script>
  import { readDateSelects } from "../../lib/date-select";

  // ⚠️ TẠM THỜI — true = bỏ qua thanh toán, gọi thẳng test-calculate.ts (test nội bộ, yêu cầu
  // Công 2026-08-14). Đổi lại `false` khi quay lại thu phí thật (và khôi phục nhánh checkout.ts
  // đã có sẵn bên dưới — không cần viết lại).
  const TEST_MODE = true;

  interface UngVienGioLiem {
    chiGio: string;
    canGio: string;
    ngayDuongLich: { nam: number; thang: number; ngay: number };
    cungGio: string;
    phanLoaiCung: "nhap-mo" | "thien-di" | "trung-tang";
    hoangDaoTen: string;
    hoangDaoLaCat: boolean;
    canGioDatBangDep: boolean;
    diem: number;
  }
  interface UngVienNgayGioHaHuyet {
    ngayDuongLich: { nam: number; thang: number; ngay: number };
    canChiNgay: { can: string; chi: string };
    chiGio: string;
    canGio: string;
    cungGio: string;
    phanLoaiCung: "nhap-mo" | "thien-di" | "trung-tang";
    hoangDaoTen: string;
    hoangDaoLaCat: boolean;
    canGioDatBangDep: boolean;
    ngayHopVoiVong: "tam-hop" | "luc-hop" | null;
    trucTot: boolean;
    chiGioThuocTuSinh: boolean;
    diem: number;
  }
  interface GioLiemHaHuyetResult {
    tuoiTa: number;
    duoi10Tuoi: boolean;
    bonCung?: { cungTuoi: string; cungThang: string; cungNgay: string; cungGio: string | null };
    gioLiemDongQuan?: UngVienGioLiem[];
    thanQuyenDaNoiLong?: boolean;
    apDungMienTru3Ngay?: boolean;
    ngayGioHaHuyet?: UngVienNgayGioHaHuyet[];
    khongTimThayNgayHaHuyet?: boolean;
  }

  const NHAN_PHAN_LOAI: Record<string, string> = { "nhap-mo": "Nhập Mộ", "thien-di": "Thiên Di", "trung-tang": "Trùng Tang" };
  const MAU_PHAN_LOAI: Record<string, string> = { "nhap-mo": "text-emerald-600", "thien-di": "text-slate-500", "trung-tang": "text-(--color-cinnabar-500)" };

  function ngayLabel(n: { nam: number; thang: number; ngay: number }): string {
    return `${String(n.ngay).padStart(2, "0")}/${String(n.thang).padStart(2, "0")}/${n.nam}`;
  }

  function yeuToLabel(y: { phanLoaiCung: string; hoangDaoTen: string; hoangDaoLaCat: boolean; canGioDatBangDep: boolean; ngayHopVoiVong?: string | null }): string {
    const parts: string[] = [NHAN_PHAN_LOAI[y.phanLoaiCung] ?? y.phanLoaiCung];
    if (y.hoangDaoLaCat) parts.push(`Hoàng đạo ${y.hoangDaoTen}`);
    if (y.canGioDatBangDep) parts.push("Can giờ đẹp");
    if (y.ngayHopVoiVong === "tam-hop") parts.push("ngày tam hợp tuổi vong");
    if (y.ngayHopVoiVong === "luc-hop") parts.push("ngày lục hợp tuổi vong");
    return parts.join(" · ");
  }

  function candidateCardHtml(params: { ngayLbl: string; gioLbl: string; nhan: string; mau: string; canhBao?: string }): string {
    return `<div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
      <div class="flex items-center justify-between">
        <p class="font-display text-lg font-bold text-slate-900">${params.ngayLbl} — giờ ${params.gioLbl}</p>
      </div>
      <p class="mt-1 text-sm font-semibold ${params.mau}">${params.nhan}</p>
      ${params.canhBao ? `<p class="mt-1.5 text-xs text-amber-600">⚠️ ${params.canhBao}</p>` : ""}
    </div>`;
  }

  const DISCLAIMER_HTML = `<p class="text-xs text-(--color-ink-500)">
    Kết quả tính theo phương pháp dân gian tổng hợp, mang tính tương đối. Không thay thế tư vấn phong thủy trực tiếp.
    Xem thêm: <a href="/tinh-trung-tang" class="text-(--color-gold-300) hover:underline">công cụ Tính Trùng Tang miễn phí</a> ·
    <a href="/lien-he" class="text-(--color-gold-300) hover:underline">đặt lịch tư vấn</a>.
  </p>`;

  function renderKetQua(result: GioLiemHaHuyetResult) {
    const el = document.getElementById("glhh-ket-qua")!;

    if (result.duoi10Tuoi) {
      el.innerHTML = `<div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-sm">Người mất dưới 10 tuổi — theo sách nguồn <strong>không tính Trùng Tang</strong> cho trường hợp này, nên không xếp hạng được giờ liệm/hạ huyệt theo phương pháp này.</p>
      </div>`;
      el.classList.remove("hidden");
      return;
    }

    const gioLiem = result.gioLiemDongQuan ?? [];
    const gioLiemHtml = gioLiem
      .map((c) =>
        candidateCardHtml({
          ngayLbl: ngayLabel(c.ngayDuongLich),
          gioLbl: c.chiGio,
          nhan: yeuToLabel(c),
          mau: MAU_PHAN_LOAI[c.phanLoaiCung] ?? "text-slate-700",
        }),
      )
      .join("");

    const haHuyet = result.ngayGioHaHuyet ?? [];
    const haHuyetHtml = haHuyet
      .map((c) =>
        candidateCardHtml({
          ngayLbl: ngayLabel(c.ngayDuongLich),
          gioLbl: c.chiGio,
          nhan: yeuToLabel(c),
          mau: MAU_PHAN_LOAI[c.phanLoaiCung] ?? "text-slate-700",
          ...(c.chiGioThuocTuSinh
            ? { canhBao: "Giờ này thuộc nhóm nên hạn chế nếu có lựa chọn khác tốt hơn — chọn vì đạt Nhập Mộ và hoàng đạo, hai yếu tố sách xếp ưu tiên cao nhất." }
            : {}),
        }),
      )
      .join("");

    el.innerHTML = `
      <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Giờ liệm / đóng quan (dùng chung công thức)</p>
        ${result.thanQuyenDaNoiLong ? `<p class="mt-1 text-xs text-amber-600">Đã bỏ ràng buộc tuổi thân quyến do không còn ứng viên hợp lệ nào phù hợp.</p>` : ""}
        <div class="mt-3 space-y-2">${gioLiemHtml || `<p class="text-sm text-slate-500">Không tìm được giờ phù hợp trong khung 12 giờ sau khi mất.</p>`}</div>
      </div>
      <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Ngày giờ hạ huyệt</p>
        ${
          result.apDungMienTru3Ngay
            ? `<p class="mt-1 text-xs text-slate-500">Áp dụng quy tắc miễn trừ (chôn trong ≤3 ngày): chỉ chọn giờ, giữ nguyên ngày mất.</p>`
            : ""
        }
        ${result.khongTimThayNgayHaHuyet ? `<p class="mt-1 text-xs text-amber-600">Không tìm được ngày phù hợp trong 20 ngày quét — vui lòng liên hệ tư vấn trực tiếp.</p>` : ""}
        <div class="mt-3 space-y-2">${haHuyetHtml || `<p class="text-sm text-slate-500">Chưa có ứng viên phù hợp.</p>`}</div>
      </div>
      ${DISCLAIMER_HTML}
    `;
    el.classList.remove("hidden");
  }

  const form = document.getElementById("glhh-form") as HTMLFormElement;
  const loiEl = document.getElementById("glhh-loi")!;
  const thanhToanEl = document.getElementById("glhh-thanh-toan")!;
  const ketQuaEl = document.getElementById("glhh-ket-qua")!;
  const qrImg = document.getElementById("glhh-qr") as HTMLImageElement;
  const orderCodeEl = document.getElementById("glhh-order-code")!;
  const trangThaiEl = document.getElementById("glhh-trang-thai")!;

  let pollTimer: ReturnType<typeof setInterval> | null = null;

  function stopPolling() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
  }

  async function pollResult(orderCode: string) {
    try {
      const res = await fetch(`/api/dai-cat-loi/gio-liem-ha-huyet/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!res.ok || !data.ok) return; // giữ nguyên trạng thái chờ, thử lại lần sau

      if (data.status === "confirmed") {
        stopPolling();
        trangThaiEl.textContent = "Đã thanh toán — đang hiển thị kết quả bên dưới.";
        thanhToanEl.classList.add("hidden");
        form.classList.add("hidden"); // tránh gửi lại form (tạo đơn mới, thu phí lần nữa) sau khi đã có kết quả
        renderKetQua(data.result as GioLiemHaHuyetResult);
      } else if (data.status === "cancelled") {
        stopPolling();
        trangThaiEl.textContent = "Đơn hàng đã bị hủy. Vui lòng thử lại.";
      }
    } catch {
      // lỗi mạng tạm thời — bỏ qua, chờ lần poll kế tiếp
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    thanhToanEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    stopPolling();

    const gioiTinh = (form.querySelector('input[name="gioiTinh"]:checked') as HTMLInputElement).value;
    const namSinhDuongLich = (document.getElementById("glhh-nam-sinh") as HTMLInputElement).value;
    const ngayMat = readDateSelects("glhh-ngay-mat");
    const chiGioMat = (document.getElementById("glhh-gio-mat") as HTMLSelectElement).value;
    const soNgayRaw = (document.getElementById("glhh-so-ngay") as HTMLInputElement).value;
    const truongNam = (document.getElementById("glhh-truong-nam") as HTMLSelectElement).value;
    const conDauLon = (document.getElementById("glhh-con-dau-lon") as HTMLSelectElement).value;
    const chauDichTon = (document.getElementById("glhh-chau-dich-ton") as HTMLSelectElement).value;
    const anhTraiLon = (document.getElementById("glhh-anh-trai-lon") as HTMLSelectElement).value;
    // Họ tên + email không gửi từ đây nữa — server lấy thẳng từ tài khoản đang đăng nhập.
    const customerPhone = (document.getElementById("glhh-sdt") as HTMLInputElement).value.trim();

    if (!ngayMat) {
      loiEl.textContent = "Vui lòng chọn đầy đủ ngày mất.";
      loiEl.classList.remove("hidden");
      return;
    }
    if (!chiGioMat) {
      loiEl.textContent = "Vui lòng chọn giờ mất.";
      loiEl.classList.remove("hidden");
      return;
    }

    const thanQuyen: Record<string, string> = {};
    if (truongNam) thanQuyen.chiTruongNam = truongNam;
    if (conDauLon) thanQuyen.chiConDauLon = conDauLon;
    if (chauDichTon) thanQuyen.chiChauDichTon = chauDichTon;
    if (anhTraiLon) thanQuyen.chiAnhTraiLon = anhTraiLon;

    const payload = {
      gioiTinh,
      namSinhDuongLich: Number(namSinhDuongLich),
      namMat: ngayMat.year,
      thangMat: ngayMat.month,
      ngayMat: ngayMat.day,
      chiGioMat,
      ...(soNgayRaw ? { soNgayDuKienToiChon: Number(soNgayRaw) } : {}),
      ...(Object.keys(thanQuyen).length > 0 ? { thanQuyen } : {}),
      customerPhone,
    };

    // ⚠️ TẠM THỜI (test nội bộ, yêu cầu Công 2026-08-14): gọi thẳng test-calculate.ts, bỏ qua
    // bước tạo đơn + QR SePay. Để bật lại thu phí: đổi endpoint về checkout.ts và khôi phục
    // đoạn xử lý QR/polling đã lưu trong lịch sử git (commit thêm module này).
    if (TEST_MODE) {
      try {
        const res = await fetch("/api/dai-cat-loi/gio-liem-ha-huyet/test-calculate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          loiEl.textContent = data.error ?? "Không tính được.";
          loiEl.classList.remove("hidden");
          return;
        }
        renderKetQua(data.result as GioLiemHaHuyetResult);
        ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch {
        loiEl.textContent = "Không tính được. Vui lòng thử lại.";
        loiEl.classList.remove("hidden");
      }
      return;
    }

    try {
      const res = await fetch("/api/dai-cat-loi/gio-liem-ha-huyet/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        loiEl.textContent = data.error ?? "Không tạo được đơn hàng.";
        loiEl.classList.remove("hidden");
        return;
      }

      qrImg.src = data.qrUrl;
      orderCodeEl.textContent = data.orderCode;
      trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      thanhToanEl.classList.remove("hidden");
      thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });

      pollTimer = setInterval(() => pollResult(data.orderCode), 3000);
    } catch {
      loiEl.textContent = "Không tạo được đơn hàng. Vui lòng thử lại.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
