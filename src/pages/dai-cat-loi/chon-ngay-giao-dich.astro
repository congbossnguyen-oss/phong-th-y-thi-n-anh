---
// TRANG "Chọn Ngày Giao Dịch / Nhận Tài Sản" (bản web) — chỉ lo khung trang (SEO/PageHero/
// breadcrumbs); toàn bộ công cụ nằm ở component dùng chung `ChonNgayGiaoDich.astro`, cũng được
// bản in-app Quân Sư (`/quan-su/chon-ngay-giao-dich`) tái sử dụng.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
