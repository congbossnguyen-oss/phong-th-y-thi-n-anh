---
// TRANG DỊCH VỤ VIP "Trạch Cát Kỳ Môn" (bản web) — chỉ lo khung trang (SEO/PageHero/breadcrumbs);
// toàn bộ logic form/thanh toán/kết quả nằm ở component dùng chung `TrachCatKyMon.astro`, cũng
// được bản in-app Quân Sư (`/quan-su/trach-cat-ky-mon`) tái sử dụng y hệt — sửa 1 chỗ, cả 2 nơi
// đều nhận thay đổi giống nhau, tránh lệch giữa web và app.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import VipQuyenBanner from "../../components/quan-su/VipQuyenBanner.astro";
import TrachCatKyMon from "../../components/tools/TrachCatKyMon.astro";

export const prerender = false;
---

<BaseLayout
  title="Trạch Cát Kỳ Môn — Chọn ngày giờ tốt theo bàn mệnh"
  description="Chọn ngày giờ tốt bằng Kỳ Môn Độn Giáp, tính riêng trên lá bàn Kỳ Môn Mệnh của chính bạn: động thổ, nhập trạch, khai trương, xuất hành, an táng và nhiều việc khác."
  appShell
>
  <PageHero
    eyebrow="⭐ Dịch vụ VIP"
    title="Trạch Cát Kỳ Môn"
    description="Chọn ngày giờ tốt theo phương pháp Kỳ Môn Mệnh Trạch Nhật — lập bàn Kỳ Môn Mệnh của chính bạn làm mẫu cục, lọc Kỳ Môn Tứ Hại, đối chiếu dụng thần riêng của từng việc, rồi mới xét 12 Kiến Tinh và 12 Trực Thần."
    breadcrumbs={[
      { label: "Trang chủ", href: "/" },
      { label: "Đại Cát Lợi", href: "/dai-cat-loi" },
      { label: "Dịch vụ VIP", href: "/dai-cat-loi/dich-vu-thu-phi" },
      { label: "Trạch Cát Kỳ Môn" },
    ]}
  />
  <VipQuyenBanner />

  <TrachCatKyMon />
</BaseLayout>
