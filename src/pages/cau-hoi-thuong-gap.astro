---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import { siteConfig } from "../lib/site-config";

export const prerender = true;

const faqs = [
  {
    q: "Phong thủy là gì?",
    a: "Phong thủy là hệ thống quan sát mối quan hệ giữa con người, không gian sống và các yếu tố tự nhiên (ánh sáng, hướng gió, địa hình) nhằm tạo ra môi trường sống hài hòa, hỗ trợ sức khỏe, tài lộc và tinh thần.",
  },
  {
    q: "Xem phong thủy nhà ở hết bao nhiêu tiền?",
    a: `Tùy quy mô và độ phức tạp, chi phí tham khảo dao động 3.000.000đ – 20.000.000đ. Mức phí cụ thể được ${siteConfig.shortName} báo trước khi khảo sát, không phát sinh sau khi đã thống nhất.`,
  },
  {
    q: "Bát Tự có chính xác không?",
    a: "Bát Tự là công cụ phân tích dựa trên ngày giờ sinh theo Can Chi, mang tính tham khảo và hỗ trợ ra quyết định — không phải công cụ tiên đoán tuyệt đối 100%.",
  },
  {
    q: "Nhà hướng xấu có bắt buộc phải chuyển nhà không?",
    a: "Không. Phần lớn trường hợp có thể hóa giải bằng cách điều chỉnh nội thất, màu sắc, vị trí bếp/giường mà không cần đổi hướng kết cấu.",
  },
  {
    q: "Tư vấn phong thủy online qua ảnh có chính xác không?",
    a: "Có thể luận sơ bộ qua ảnh/bản vẽ, nhưng để kết luận chính xác nhất cần khảo sát trực tiếp hoặc có số đo la bàn thật.",
  },
  {
    q: "Học phí các khóa Bát Tự, Tử Vi, Huyền Không là bao nhiêu?",
    a: "Học phí theo từng cấp độ (nhập môn/trung cấp/chuyên sâu), được công bố cụ thể trên trang từng khóa học hoặc tư vấn trực tiếp qua hotline.",
  },
  {
    q: "Có nên tin phong thủy không?",
    a: "Phong thủy không thay đổi số phận, mà giúp con người sống hài hòa hơn với môi trường và đưa ra lựa chọn tỉnh táo hơn — nên xem là công cụ tham khảo, không phải phép màu.",
  },
  {
    q: "Chọn ngày động thổ, nhập trạch cần chuẩn bị gì?",
    a: "Cần cung cấp ngày giờ sinh của gia chủ, địa chỉ công trình và mục đích sử dụng để chuyên gia tính ngày giờ hoàng đạo phù hợp.",
  },
  {
    q: "Sim phong thủy chọn theo tiêu chí nào?",
    a: "Chọn theo Ngũ Hành bản mệnh và nguyên lý Âm Dương của gia chủ, không chỉ dựa vào số đẹp theo quan niệm dân gian thông thường.",
  },
  {
    q: "Có thể tự học phong thủy cơ bản không?",
    a: "Có — các khóa nhập môn (Bát Tự, Bát Trạch, Huyền Không) được thiết kế cho người chưa có nền tảng, học từ nguyên lý Ngũ Hành, Âm Dương cơ bản.",
  },
  {
    q: "Kỳ Môn Độn Giáp khác gì với Bát Tự?",
    a: "Bát Tự luận về vận mệnh cá nhân theo Can Chi ngày giờ sinh; Kỳ Môn Độn Giáp thiên về chọn thời điểm và phương vị hành động cho một sự việc cụ thể.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="Câu hỏi thường gặp"
  description="Giải đáp những câu hỏi khách hàng thường gặp nhất về phong thủy, bát tự, khóa học và dịch vụ tư vấn của Phong Thủy Thiên Anh."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <PageHero
    eyebrow="Hỗ trợ"
    title="Câu hỏi thường gặp"
    description="Những thắc mắc khách hàng hỏi nhiều nhất trước khi đặt lịch tư vấn hoặc đăng ký khóa học."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Câu hỏi thường gặp" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-3xl space-y-3">
      {faqs.map((item) => (
        <details class="group rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) open:bg-(--color-ivory-50)">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-base font-semibold text-(--color-ink-950)">
            {item.q}
            <span class="shrink-0 text-(--color-gold-300) transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="px-5 pb-5 text-sm leading-relaxed text-(--color-ink-700)">{item.a}</p>
        </details>
      ))}
    </div>

    <div class="mx-auto mt-10 max-w-3xl rounded-(--radius-card) border border-(--color-gold-500)/30 bg-(--color-ivory-100) p-6 text-center">
      <p class="font-display text-lg font-semibold text-(--color-ink-950)">Chưa tìm thấy câu trả lời anh/chị cần?</p>
      <p class="mt-2 text-sm text-(--color-ink-700)">
        Gọi hotline <a href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`} class="font-medium text-(--color-gold-300) hover:underline">{siteConfig.hotline}</a>
        hoặc <a href="/lien-he" class="font-medium text-(--color-gold-300) hover:underline">để lại thông tin</a>, đội ngũ Thiên Anh sẽ liên hệ tư vấn trực tiếp.
      </p>
    </div>
  </Container>
</BaseLayout>
