---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import TodayStrip from "../components/home/TodayStrip.astro";
import StatsSection from "../components/home/StatsSection.astro";
import ToolsShowcase from "../components/home/ToolsShowcase.astro";
import BatQuaiFeature from "../components/home/BatQuaiFeature.astro";
import MasterIntro from "../components/home/MasterIntro.astro";
import FeaturedServices from "../components/home/FeaturedServices.astro";
import FeaturedPortfolio from "../components/home/FeaturedPortfolio.astro";
import FieldSurveySection from "../components/home/FieldSurveySection.astro";
import Testimonials from "../components/home/Testimonials.astro";
import FeaturedPosts from "../components/home/FeaturedPosts.astro";
import CtaBanner from "../components/home/CtaBanner.astro";
import { siteConfig } from "../lib/site-config";

export const prerender = true;

// Person cho chuyên gia Zhi Gong — url trỏ về trang bio riêng /gioi-thieu/chuyen-gia-zhi-gong
// (nơi có schema Person đầy đủ hơn), giữ bản rút gọn ở đây vì Zhi Gong cũng xuất hiện ở trang chủ.
const siteUrl = (Astro.site ?? new URL("http://localhost:4321")).toString().replace(/\/$/, "");
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Zhi Gong",
  jobTitle: "Chuyên gia phong thủy",
  worksFor: { "@type": "Organization", name: siteConfig.name },
  url: `${siteUrl}/gioi-thieu/chuyen-gia-zhi-gong`,
  sameAs: [siteConfig.social.facebook].filter((href) => href && href !== "#"),
};
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <Hero />
  <!-- Thứ tự dẫn dắt: lời hứa thương hiệu (Hero) → giá trị dùng được NGAY hôm nay (TodayStrip) → uy tín
       (Stats) → thứ khác biệt nhất, dùng miễn phí (ToolsShowcase) → con người đứng sau (MasterIntro) →
       dịch vụ trả phí. Đặt công cụ miễn phí TRƯỚC dịch vụ trả phí để người xem nhận giá trị rồi mới được
       mời mua. -->
  <TodayStrip />
  <StatsSection />
  <ToolsShowcase />
  <MasterIntro />
  <!-- Vật phẩm chủ lực đặt ngay sau phần giới thiệu chuyên gia: khách vừa biết người đứng sau là ai,
       đang ở trạng thái tin tưởng nhất, thì gặp luôn vật phẩm — trước cả danh sách dịch vụ trả phí. -->
  <BatQuaiFeature />
  <FeaturedServices />
  <!-- Yêu cầu Công: bỏ hẳn khối cửa hàng (FeaturedProducts) khỏi trang chủ. FeaturedPortfolio (công trình
       thật) trước đây chỉ hiện trên di động vì phải nhường chỗ cho cửa hàng ở màn lớn — nay bỏ cửa hàng
       thì cho công trình hiện ở MỌI kích thước, vì đây là thứ tạo uy tín chứ không phải bán hàng. -->
  <FeaturedPortfolio />
  <!-- Nhật ký khảo sát thực tế — bằng chứng nghề nghiệp mạnh nhất, đặt cạnh cảm nhận khách hàng. -->
  <FieldSurveySection />
  <Testimonials />
  <FeaturedPosts />
  <CtaBanner />
</BaseLayout>
