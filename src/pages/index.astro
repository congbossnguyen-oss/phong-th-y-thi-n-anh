---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import TodayStrip from "../components/home/TodayStrip.astro";
import StatsSection from "../components/home/StatsSection.astro";
import ToolsShowcase from "../components/home/ToolsShowcase.astro";
import BatQuaiFeature from "../components/home/BatQuaiFeature.astro";
import MasterIntro from "../components/home/MasterIntro.astro";
import FeaturedServices from "../components/home/FeaturedServices.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
import FeaturedPortfolio from "../components/home/FeaturedPortfolio.astro";
import Testimonials from "../components/home/Testimonials.astro";
import FeaturedPosts from "../components/home/FeaturedPosts.astro";
import CtaBanner from "../components/home/CtaBanner.astro";
import { siteConfig } from "../lib/site-config";

export const prerender = true;

// Person cho chuyên gia Zhi Gong — url trỏ về trang bio riêng /gioi-thieu/chuyen-gia-zhi-gong
// (nơi có schema Person đầy đủ hơn), giữ bản rút gọn ở đây vì Zhi Gong cũng xuất hiện ở trang chủ.
const siteUrl = (Astro.site ?? new URL("http://localhost:4321")).toString().replace(/\/$/, "");
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Zhi Gong",
  jobTitle: "Chuyên gia phong thủy",
  worksFor: { "@type": "Organization", name: siteConfig.name },
  url: `${siteUrl}/gioi-thieu/chuyen-gia-zhi-gong`,
  sameAs: [siteConfig.social.facebook].filter((href) => href && href !== "#"),
};
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <Hero />
  <!-- Thứ tự dẫn dắt: lời hứa thương hiệu (Hero) → giá trị dùng được NGAY hôm nay (TodayStrip) → uy tín
       (Stats) → CON NGƯỜI đứng sau (MasterIntro) → thứ khác biệt nhất, dùng miễn phí (ToolsShowcase) →
       dịch vụ trả phí.
       Yêu cầu Công: đưa phần giới thiệu nhân vật lên trên. Cũng hợp lý về mặt thuyết phục — biết người
       đứng sau là ai trước thì bộ công cụ phía sau mới có sức nặng. Vẫn giữ công cụ MIỄN PHÍ đứng trước
       dịch vụ trả phí để người xem nhận giá trị rồi mới được mời mua. -->
  <TodayStrip />
  <StatsSection />
  <MasterIntro />
  <ToolsShowcase />
  <!-- Vật phẩm chủ lực đặt ngay sau khu công cụ: khách vừa dùng công cụ miễn phí xong, đang ở trạng thái
       quan tâm nhất, thì gặp luôn vật phẩm — trước cả danh sách dịch vụ trả phí. -->
  <BatQuaiFeature />
  <FeaturedServices />
  <div class="hidden sm:block">
    <FeaturedProducts />
  </div>
  <div class="sm:hidden">
    <FeaturedPortfolio />
  </div>
  <Testimonials />
  <FeaturedPosts />
  <CtaBanner />
</BaseLayout>
