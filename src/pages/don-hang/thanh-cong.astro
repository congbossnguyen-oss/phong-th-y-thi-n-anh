---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { getOrderById } from "../../lib/db/orders";

export const prerender = false;

const orderIdParam = Astro.url.searchParams.get("orderId");
const order = orderIdParam ? await getOrderById(orderIdParam) : null;

if (!order) {
  return Astro.redirect("/vat-pham");
}

const orderId = order.orderCode;
const total = Number(order.totalAmount);
const payment = order.paymentMethod;

const formatPrice = (price: number) =>
  price.toLocaleString("vi-VN", { style: "currency", currency: "VND" });
---

<BaseLayout title="Đặt hàng thành công" description="Xác nhận đơn hàng tại Thiên Anh." noIndex>
  <Container class="flex flex-col items-center py-20 text-center">
    <span class="flex size-16 items-center justify-center rounded-full bg-(--color-success-500)/10 text-(--color-success-500)">
      <Icon name="check-circle" class="size-8" />
    </span>
    <h1 class="mt-5 font-display text-2xl font-semibold text-(--color-ink-950) sm:text-3xl">Đặt hàng thành công!</h1>
    <p class="mt-2 text-(--color-ink-600)">Mã đơn hàng <strong class="text-(--color-ink-950)">#{orderId}</strong> — tổng giá trị <strong class="text-(--color-gold-300)">{formatPrice(total)}</strong></p>

    {payment === "cod" ? (
      <p class="mt-6 max-w-md text-sm text-(--color-ink-600)">Đơn hàng của bạn sẽ được giao và thu tiền trực tiếp (COD). Thiên Anh sẽ gọi xác nhận trong thời gian sớm nhất.</p>
    ) : (
      <p class="mt-6 max-w-md text-sm text-(--color-ink-600)">Thanh toán qua chuyển khoản QR đã được xác nhận tự động. Email xác nhận đơn hàng đã được gửi tới hộp thư của bạn.</p>
    )}

    <div class="mt-8 flex gap-3">
      <Button href="/vat-pham" variant="secondary">Tiếp tục mua sắm</Button>
      <Button href="/">Về trang chủ</Button>
    </div>
  </Container>
</BaseLayout>
