---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Icon from "../../components/ui/Icon.astro";
import { services } from "../../lib/placeholder-data";

export const prerender = true;
---

<BaseLayout title="Dịch vụ tư vấn phong thủy" description="Danh sách dịch vụ tư vấn phong thủy của Phong Thủy Thiên Anh.">
  <PageHero
    eyebrow="Dịch vụ"
    title="Dịch vụ tư vấn phong thủy"
    description="Mỗi gói dịch vụ được cá nhân hóa theo nhu cầu thực tế của khách hàng, từ nhà ở đến doanh nghiệp."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Dịch vụ" }]}
  />

  <Container class="py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={`/dich-vu/${service.slug}`}
          class="group flex flex-col rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 transition-shadow hover:shadow-lg"
        >
          <span class="flex size-11 items-center justify-center rounded-full bg-(--color-cinnabar-500)/10 text-(--color-cinnabar-400)">
            <Icon name="check-circle" class="size-5" />
          </span>
          <h2 class="mt-4 font-display text-lg font-semibold text-(--color-ink-950)">{service.name}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{service.summary}</p>
          <div class="mt-4 flex items-center justify-between border-t border-(--color-ivory-300) pt-4 text-sm">
            <span class="text-(--color-ink-600)">Từ <strong class="text-(--color-cinnabar-500)">{service.priceFrom}</strong></span>
            <Icon name="arrow-right" class="size-4 text-(--color-ink-400) transition-transform group-hover:translate-x-1 group-hover:text-(--color-cinnabar-500)" />
          </div>
        </a>
      ))}
    </div>
  </Container>
</BaseLayout>
