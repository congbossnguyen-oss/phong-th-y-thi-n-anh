---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { services } from "../../lib/placeholder-data";

export const prerender = true;

export async function getStaticPaths() {
  // TODO: thay bằng danh sách slug từ Sanity khi kết nối CMS thật.
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const includes = [
  "Khảo sát/thu thập thông tin ban đầu",
  "Phân tích chuyên sâu bởi chuyên gia phụ trách",
  "Báo cáo luận giải chi tiết kèm khuyến nghị áp dụng",
  "01 buổi giải đáp trực tiếp sau khi có báo cáo",
];

const faqSchema = service.faq
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: service.faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    }
  : null;
---

<BaseLayout title={service.name} description={service.summary}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <PageHero
    eyebrow="Dịch vụ"
    title={service.name}
    description={service.summary}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Dịch vụ", href: "/dich-vu" }, { label: service.name }]}
  />

  <Container class="grid gap-12 py-16 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="aspect-video overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
        <img src={service.image} alt={service.name} class="h-full w-full object-cover" />
      </div>

      {service.intro && (
        <div class="mt-8 space-y-4">
          {service.intro.map((p) => (
            <p class="text-base leading-relaxed text-(--color-ink-700)">{p}</p>
          ))}
        </div>
      )}

      {service.suitableFor && (
        <>
          <h2 class="mt-10 font-display text-2xl font-semibold text-(--color-ink-950)">Phù hợp với ai</h2>
          <ul class="mt-5 space-y-3">
            {service.suitableFor.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-(--color-ink-700)">
                <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-(--color-gold-300)" />
                {item}
              </li>
            ))}
          </ul>
        </>
      )}

      <h2 class="mt-10 font-display text-2xl font-semibold text-(--color-ink-950)">Nội dung dịch vụ bao gồm</h2>
      <ul class="mt-5 space-y-3">
        {includes.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-(--color-ink-700)">
            <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-(--color-gold-300)" />
            {item}
          </li>
        ))}
      </ul>

      <h2 class="mt-10 font-display text-2xl font-semibold text-(--color-ink-950)">Quy trình thực hiện</h2>
      <ol class="mt-5 space-y-4">
        {["Đặt lịch tư vấn qua form hoặc hotline", "Chuyên gia thu thập thông tin, khảo sát thực tế (nếu cần)", "Phân tích và soạn báo cáo luận giải", "Bàn giao báo cáo và giải đáp trực tiếp"].map((step, i) => (
          <li class="flex gap-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-(--color-gold-300)/15 font-display text-sm font-semibold text-(--color-gold-400)">{i + 1}</span>
            <p class="pt-1 text-sm leading-relaxed text-(--color-ink-700)">{step}</p>
          </li>
        ))}
      </ol>

      {service.faq && (
        <>
          <h2 class="mt-10 font-display text-2xl font-semibold text-(--color-ink-950)">Câu hỏi thường gặp</h2>
          <div class="mt-5 space-y-3">
            {service.faq.map((item) => (
              <details class="group rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) open:bg-(--color-ivory-50)">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-sm font-semibold text-(--color-ink-950)">
                  {item.q}
                  <span class="shrink-0 text-(--color-gold-300) transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="px-4 pb-4 text-sm leading-relaxed text-(--color-ink-700)">{item.a}</p>
              </details>
            ))}
          </div>
        </>
      )}
    </div>

    <aside class="h-fit rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
      <p class="text-sm text-(--color-ink-600)">Chi phí tham khảo</p>
      <p class="mt-1 font-display text-3xl font-semibold text-(--color-gold-300)">{service.priceFrom}</p>
      <p class="mt-2 text-xs text-(--color-ink-600)">Chi phí thực tế tùy theo phạm vi công việc, sẽ được báo giá cụ thể sau khảo sát.</p>
      <Button href="/lien-he" size="lg" class="mt-5 w-full">Đặt lịch tư vấn ngay</Button>
    </aside>
  </Container>
</BaseLayout>
