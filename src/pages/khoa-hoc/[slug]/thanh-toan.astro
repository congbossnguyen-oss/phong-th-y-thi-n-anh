---
import { and, eq } from "drizzle-orm";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/ui/PageHero.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { courses } from "../../../lib/placeholder-courses";
import { db } from "../../../lib/db/client";
import { courseEnrollments } from "../../../../db/schema";

export const prerender = false;

const { slug } = Astro.params;
const course = courses.find((c) => c.slug === slug && c.format === "online");

if (!course) {
  return Astro.redirect("/khoa-hoc");
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/hoc-vien/dang-nhap?course=${encodeURIComponent(course.slug)}`);
}

const [enrollment] = await db
  .select({ id: courseEnrollments.id })
  .from(courseEnrollments)
  .where(and(eq(courseEnrollments.userId, user.id), eq(courseEnrollments.courseRef, course.slug)))
  .limit(1);

if (enrollment) {
  return Astro.redirect(`/hoc-vien/khoa-hoc/${course.slug}`);
}

const formatPrice = (price: number) =>
  price.toLocaleString("vi-VN", { style: "currency", currency: "VND" });
---

<BaseLayout title={`Đăng ký khóa học: ${course.name}`} description={course.summary} noIndex>
  <PageHero
    eyebrow="Đăng ký khóa học"
    title={course.name}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Khóa học", href: "/khoa-hoc" }, { label: course.name, href: `/khoa-hoc/${course.slug}` }, { label: "Thanh toán" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-md rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 sm:p-8">
      <div class="flex items-center justify-between border-b border-(--color-ivory-300) pb-4">
        <span class="text-sm text-(--color-ink-700)">{course.name}</span>
        <span class="font-display text-lg font-semibold text-(--color-cinnabar-500)">{formatPrice(course.price)}</span>
      </div>

      <form id="course-checkout-form" class="mt-5">
        <label for="phone" class="text-sm font-medium text-(--color-ink-800)">Số điện thoại liên hệ <span class="text-(--color-danger-500)">*</span></label>
        <input id="phone" name="phone" type="tel" required autocomplete="tel"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />

        <p id="checkout-error" class="mt-4 hidden text-sm text-(--color-danger-500)"></p>
        <Button id="checkout-submit" type="submit" size="lg" class="mt-6 w-full">Thanh toán qua QR</Button>
        <p class="mt-3 text-center text-xs text-(--color-ink-600)">Quét mã VietQR để hoàn tất thanh toán — khóa học được kích hoạt tự động ngay khi thanh toán thành công.</p>
      </form>
    </div>
  </Container>
</BaseLayout>

<script define:vars={{ courseSlug: course.slug }}>
  const form = document.getElementById("course-checkout-form");
  const errorEl = document.getElementById("checkout-error");
  const submitBtn = document.getElementById("checkout-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    submitBtn.disabled = true;

    const phone = new FormData(form).get("phone");

    try {
      const res = await fetch("/api/courses/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ courseSlug, phone }),
      });
      const data = await res.json();

      if (!data.ok) {
        errorEl.textContent = data.error || "Có lỗi xảy ra, vui lòng thử lại.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        return;
      }

      window.location.href = `/don-hang/${data.orderId}/cho-thanh-toan`;
    } catch {
      errorEl.textContent = "Không kết nối được máy chủ, vui lòng thử lại.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
    }
  });
</script>
