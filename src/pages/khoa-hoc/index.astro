---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Icon from "../../components/ui/Icon.astro";
import { getCourses, groupCoursesByCategory, COURSE_CATEGORY_SLUGS } from "../../lib/cms/queries";

export const prerender = false;

const courses = await getCourses();
const groups = groupCoursesByCategory(courses);

const formatPrice = (price: number) =>
  price > 0 ? price.toLocaleString("vi-VN", { style: "currency", currency: "VND" }) : "Liên hệ";

const categoryBanners: Record<string, string> = {
  "Bát tự": "/images/courses/categories/bat-tu.png",
  "Bát trạch": "/images/courses/categories/bat-trach.png",
  "Huyền không phi tinh": "/images/courses/categories/huyen-khong-phi-tinh.png",
  "Huyền không lục pháp": "/images/courses/categories/huyen-khong-luc-phap.png",
  "Kinh dịch": "/images/courses/categories/kinh-dich.png",
  "Kỳ môn": "/images/courses/categories/ky-mon.png",
  "Trạch nhật": "/images/courses/categories/trach-nhat.png",
  "Tử vi": "/images/courses/categories/tu-vi.png",
};
---

<BaseLayout title="Khóa học huyền học" description="Khóa học huyền học online và offline cùng chuyên gia Thiên Anh: Bát tự, Bát trạch, Huyền không phi tinh, Trạch nhật, Kỳ môn, Tử vi, Kinh dịch...">
  <PageHero
    eyebrow="Khóa học"
    title="Khóa học huyền học"
    description="Học trực tiếp cùng chuyên gia (offline/Zoom) hoặc học online mọi lúc mọi nơi, có theo dõi tiến độ."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Khóa học" }]}
  />

  <Container class="py-16">
    {groups.map((group) => (
      <div id={COURSE_CATEGORY_SLUGS[group.category]} class="mb-14 scroll-mt-24 last:mb-0">
        {categoryBanners[group.category] ? (
          <div class="relative aspect-[21/4] overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300)">
            <img src={categoryBanners[group.category]} alt={group.category} class="h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
            <h2 class="absolute bottom-3 left-4 font-display text-base font-semibold text-white sm:text-xl">{group.category}</h2>
          </div>
        ) : (
          <h2 class="font-display text-xl font-semibold text-(--color-ink-950)">{group.category}</h2>
        )}
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.courses.map((course) => (
            <a href={`/khoa-hoc/${course.slug}`} class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50)">
              <div class="aspect-video overflow-hidden bg-(--color-ivory-200)">
                {course.coverImageUrl ? (
                  <img src={course.coverImageUrl} alt={course.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="flex h-full items-center justify-center text-xs text-(--color-ink-500)">Ảnh đang cập nhật</div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-(--color-gold-300)/15 px-2.5 py-1 text-xs font-medium text-(--color-gold-400)">
                  {course.format === "online" ? "Học online" : "Offline / Zoom"}
                </span>
                <h3 class="mt-3 font-display text-lg font-semibold text-(--color-ink-950) group-hover:text-(--color-gold-300)">{course.name}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{course.summary}</p>
                <div class="mt-4 flex items-center justify-between border-t border-(--color-ivory-300) pt-4 text-sm">
                  <span class="text-(--color-ink-600)">{course.lessonsCount} bài học</span>
                  <span class="font-semibold text-(--color-gold-300)">{formatPrice(course.price)}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </Container>
</BaseLayout>
