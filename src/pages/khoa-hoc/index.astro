---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Icon from "../../components/ui/Icon.astro";
import { courses } from "../../lib/placeholder-courses";

export const prerender = true;

const formatPrice = (price: number) =>
  price.toLocaleString("vi-VN", { style: "currency", currency: "VND" });
---

<BaseLayout title="Khóa học phong thủy" description="Khóa học phong thủy online và offline cùng chuyên gia Thiên Anh.">
  <PageHero
    eyebrow="Khóa học"
    title="Khóa học phong thủy"
    description="Học trực tiếp cùng chuyên gia (offline/Zoom) hoặc học online mọi lúc mọi nơi, có theo dõi tiến độ."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Khóa học" }]}
  />

  <Container class="py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {courses.map((course) => (
        <a href={`/khoa-hoc/${course.slug}`} class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50)">
          <div class="aspect-video bg-(--color-ivory-200)">
            <!-- TODO: ảnh/video giới thiệu khóa học thật -->
          </div>
          <div class="flex flex-1 flex-col p-5">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-(--color-cinnabar-50) px-2.5 py-1 text-xs font-medium text-(--color-cinnabar-500)">
              {course.format === "online" ? "Học online" : "Offline / Zoom"}
            </span>
            <h2 class="mt-3 font-display text-lg font-semibold text-(--color-ink-950) group-hover:text-(--color-cinnabar-500)">{course.name}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{course.summary}</p>
            <div class="mt-4 flex items-center justify-between border-t border-(--color-ivory-300) pt-4 text-sm">
              <span class="text-(--color-ink-600)">{course.lessonsCount} bài học</span>
              <span class="font-semibold text-(--color-cinnabar-500)">{formatPrice(course.price)}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </Container>
</BaseLayout>
