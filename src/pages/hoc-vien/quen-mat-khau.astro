---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout title="Quên mật khẩu" description="Đặt lại mật khẩu tài khoản Thiên Anh." noIndex>
  <Container class="flex min-h-[60vh] items-center justify-center py-16">
    <form id="quen-form" class="w-full max-w-sm rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-8">
      <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">Quên mật khẩu</h1>
      <p class="mt-2 text-sm text-(--color-ink-600)">Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu.</p>
      <p id="quen-error" class="mt-3 hidden rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-3.5 py-2.5 text-sm text-(--color-danger-500)"></p>
      <p id="quen-thanh-cong" class="mt-3 hidden rounded-(--radius-control) border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-2.5 text-sm text-emerald-700"></p>
      <div class="mt-6">
        <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
      </div>
      <Button type="submit" id="submit-btn" size="lg" class="mt-6 w-full">Gửi link đặt lại mật khẩu</Button>
      <p class="mt-4 text-center text-sm text-(--color-ink-600)">
        <a href="/hoc-vien/dang-nhap" class="font-medium text-(--color-gold-300) hover:underline">← Quay lại đăng nhập</a>
      </p>
    </form>
  </Container>
</BaseLayout>

<script>
  const form = document.getElementById("quen-form") as HTMLFormElement;
  const errorEl = document.getElementById("quen-error")!;
  const thanhCongEl = document.getElementById("quen-thanh-cong")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    thanhCongEl.classList.add("hidden");
    submitBtn.disabled = true;

    const email = (document.getElementById("email") as HTMLInputElement).value.trim();

    try {
      const res = await fetch("/api/auth/quen-mat-khau", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        errorEl.textContent = data.error ?? "Có lỗi xảy ra, thử lại.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        return;
      }

      thanhCongEl.textContent = data.message;
      thanhCongEl.classList.remove("hidden");
      form.querySelector("input")?.setAttribute("disabled", "true");
    } catch {
      errorEl.textContent = "Không kết nối được máy chủ, thử lại sau.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
    }
  });
</script>
