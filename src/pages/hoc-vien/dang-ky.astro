---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout title="Đăng ký học viên" description="Đăng ký tài khoản học viên Thiên Anh." noIndex>
  <Container class="flex min-h-[60vh] items-center justify-center py-16">
    <form id="register-form" class="w-full max-w-sm rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-8">
      <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">Đăng ký học viên</h1>
      <p id="register-error" class="mt-3 hidden rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-3.5 py-2.5 text-sm text-(--color-danger-500)"></p>
      <div class="mt-6">
        <label for="name" class="text-sm font-medium text-(--color-ink-800)">Họ và tên</label>
        <input id="name" name="name" type="text" required autocomplete="name"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
      </div>
      <div class="mt-4">
        <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
      </div>
      <div class="mt-4">
        <label for="password" class="text-sm font-medium text-(--color-ink-800)">Mật khẩu</label>
        <input id="password" name="password" type="password" required autocomplete="new-password" minlength="6"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
      </div>

      <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
        <p class="text-sm font-medium text-(--color-ink-800)">Ngày sinh (dương lịch)</p>
        <p class="mt-1 text-xs text-(--color-ink-500)">Khai báo 1 lần, dùng lại cho các tính năng Quân Sư sau này (không hỏi lại).</p>
        <div class="mt-2 grid grid-cols-3 gap-2">
          <input id="birth-day" name="birthDay" type="number" min="1" max="31" placeholder="Ngày" required
            class="w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          <input id="birth-month" name="birthMonth" type="number" min="1" max="12" placeholder="Tháng" required
            class="w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          <input id="birth-year" name="birthYear" type="number" min="1900" max="2026" placeholder="Năm" required
            class="w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
        </div>
      </div>
      <div class="mt-4">
        <label for="birth-hour" class="text-sm font-medium text-(--color-ink-800)">Giờ sinh (không bắt buộc)</label>
        <input id="birth-hour" name="birthHour" type="number" min="0" max="23" placeholder="0-23"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
      </div>
      <div class="mt-4">
        <label for="gender" class="text-sm font-medium text-(--color-ink-800)">Giới tính</label>
        <select id="gender" name="gender" required
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20">
          <option value="">— Chọn —</option>
          <option value="Nam">Nam</option>
          <option value="Nữ">Nữ</option>
        </select>
      </div>

      <Button type="submit" id="submit-btn" size="lg" class="mt-6 w-full">Tạo tài khoản</Button>
      <p class="mt-4 text-center text-sm text-(--color-ink-600)">
        Đã có tài khoản? <a id="login-link" href="/hoc-vien/dang-nhap" class="font-medium text-(--color-gold-300) hover:underline">Đăng nhập</a>
      </p>
    </form>
  </Container>
</BaseLayout>

<script>
  const form = document.getElementById("register-form") as HTMLFormElement;
  const errorEl = document.getElementById("register-error")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const loginLink = document.getElementById("login-link") as HTMLAnchorElement;

  const params = new URLSearchParams(window.location.search);
  const courseSlug = params.get("course");

  // `tiep` = trang cần quay lại sau khi đăng ký xong. Chỉ nhận đường dẫn nội bộ — xem giải thích
  // ở dang-nhap.astro (chặn chuyển hướng ra site lạ).
  const tiepRaw = params.get("tiep");
  const tiep = tiepRaw && tiepRaw.startsWith("/") && !tiepRaw.startsWith("//") ? tiepRaw : null;

  if (courseSlug) {
    loginLink.href = `/hoc-vien/dang-nhap?course=${encodeURIComponent(courseSlug)}`;
  } else if (tiep) {
    loginLink.href = `/hoc-vien/dang-nhap?tiep=${encodeURIComponent(tiep)}`;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    submitBtn.disabled = true;

    const name = (document.getElementById("name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("password") as HTMLInputElement).value;
    const birthDay = (document.getElementById("birth-day") as HTMLInputElement).value;
    const birthMonth = (document.getElementById("birth-month") as HTMLInputElement).value;
    const birthYear = (document.getElementById("birth-year") as HTMLInputElement).value;
    const birthHourRaw = (document.getElementById("birth-hour") as HTMLInputElement).value;
    const gender = (document.getElementById("gender") as HTMLSelectElement).value;

    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name, email, password, gender,
          birthDay: Number(birthDay), birthMonth: Number(birthMonth), birthYear: Number(birthYear),
          birthHour: birthHourRaw ? Number(birthHourRaw) : undefined,
        }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        errorEl.textContent = data.error ?? "Có lỗi xảy ra, thử lại.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        return;
      }

      if (courseSlug) {
        window.location.href = `/khoa-hoc/${courseSlug}/thanh-toan`;
      } else if (tiep) {
        window.location.href = tiep;
      } else {
        window.location.href = "/hoc-vien";
      }
    } catch {
      errorEl.textContent = "Không kết nối được máy chủ, thử lại sau.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
    }
  });
</script>
