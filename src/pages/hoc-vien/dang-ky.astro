---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout title="Đăng ký học viên" description="Đăng ký tài khoản học viên Thiên Anh." noIndex>
  <Container class="flex min-h-[60vh] items-center justify-center py-16">
    <form id="register-form" class="w-full max-w-sm rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-8">
      <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">Đăng ký học viên</h1>
      <p id="register-error" class="mt-3 hidden rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-3.5 py-2.5 text-sm text-(--color-danger-500)"></p>
      <div class="mt-6">
        <label for="name" class="text-sm font-medium text-(--color-ink-800)">Họ và tên</label>
        <input id="name" name="name" type="text" required autocomplete="name"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <div class="mt-4">
        <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <div class="mt-4">
        <label for="password" class="text-sm font-medium text-(--color-ink-800)">Mật khẩu</label>
        <input id="password" name="password" type="password" required autocomplete="new-password" minlength="6"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <Button type="submit" id="submit-btn" size="lg" class="mt-6 w-full">Tạo tài khoản</Button>
      <p class="mt-4 text-center text-sm text-(--color-ink-600)">
        Đã có tài khoản? <a id="login-link" href="/hoc-vien/dang-nhap" class="font-medium text-(--color-cinnabar-500) hover:underline">Đăng nhập</a>
      </p>
    </form>
  </Container>
</BaseLayout>

<script>
  const form = document.getElementById("register-form") as HTMLFormElement;
  const errorEl = document.getElementById("register-error")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const loginLink = document.getElementById("login-link") as HTMLAnchorElement;

  const params = new URLSearchParams(window.location.search);
  const courseSlug = params.get("course");
  if (courseSlug) {
    loginLink.href = `/hoc-vien/dang-nhap?course=${encodeURIComponent(courseSlug)}`;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    submitBtn.disabled = true;

    const name = (document.getElementById("name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("password") as HTMLInputElement).value;

    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        errorEl.textContent = data.error ?? "Có lỗi xảy ra, thử lại.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        return;
      }

      if (courseSlug) {
        await fetch("/api/courses/enroll", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ courseRef: courseSlug }),
        });
        window.location.href = `/hoc-vien/khoa-hoc/${courseSlug}`;
      } else {
        window.location.href = "/hoc-vien";
      }
    } catch {
      errorEl.textContent = "Không kết nối được máy chủ, thử lại sau.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
    }
  });
</script>
