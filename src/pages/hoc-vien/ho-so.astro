---
// Hồ sơ ngày giờ sinh + giới tính — bổ sung cho tài khoản đã tồn tại TRƯỚC khi việc khai báo này
// trở thành bắt buộc lúc đăng ký (Thầy, 2026-08-23). Khai 1 lần ở đây, các tính năng cần vận trình
// (Quân Sư luận quẻ, Xem Thời Vận) tự lấy ra dùng — không hỏi lại mỗi lần.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/hoc-vien/dang-nhap?tiep=/hoc-vien/ho-so");
}

const hs = user.hoSoSinh;
---

<BaseLayout title="Hồ sơ của tôi" description="Ngày giờ sinh và giới tính — dùng cho các tính năng Quân Sư." noIndex>
  <Container class="flex min-h-[60vh] items-center justify-center py-16">
    <form id="ho-so-form" class="w-full max-w-sm rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-8">
      <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">Hồ sơ của tôi</h1>
      <p class="mt-2 text-sm text-(--color-ink-600)">{user.name} · {user.email}</p>
      <p id="ho-so-msg" class="mt-3 hidden rounded-(--radius-control) border px-3.5 py-2.5 text-sm"></p>

      <div class="mt-5 border-t border-(--color-ivory-300) pt-5">
        <p class="text-sm font-medium text-(--color-ink-800)">Ngày sinh (dương lịch)</p>
        <p class="mt-1 text-xs text-(--color-ink-500)">Dùng lại cho Quân Sư và Xem Thời Vận — khai 1 lần, không hỏi lại.</p>
        <div class="mt-2 grid grid-cols-3 gap-2">
          <input id="birth-day" type="number" min="1" max="31" placeholder="Ngày" required value={hs?.day ?? ""}
            class="w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          <input id="birth-month" type="number" min="1" max="12" placeholder="Tháng" required value={hs?.month ?? ""}
            class="w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          <input id="birth-year" type="number" min="1900" max="2026" placeholder="Năm" required value={hs?.year ?? ""}
            class="w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
        </div>
      </div>
      <div class="mt-4">
        <label for="birth-hour" class="text-sm font-medium text-(--color-ink-800)">Giờ sinh (không bắt buộc)</label>
        <input id="birth-hour" type="number" min="0" max="23" placeholder="0-23" value={hs?.hour ?? ""}
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
      </div>
      <div class="mt-4">
        <label for="gender" class="text-sm font-medium text-(--color-ink-800)">Giới tính</label>
        <select id="gender" required
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20">
          <option value="" selected={!hs}>— Chọn —</option>
          <option value="Nam" selected={hs?.gender === "Nam"}>Nam</option>
          <option value="Nữ" selected={hs?.gender === "Nữ"}>Nữ</option>
        </select>
      </div>

      <Button type="submit" id="submit-btn" size="lg" class="mt-6 w-full">Lưu hồ sơ</Button>
    </form>
  </Container>
</BaseLayout>

<script>
  const form = document.getElementById("ho-so-form") as HTMLFormElement;
  const msgEl = document.getElementById("ho-so-msg")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  function showMsg(text: string, ok: boolean) {
    msgEl.textContent = text;
    msgEl.classList.remove("hidden");
    msgEl.className = ok
      ? "mt-3 rounded-(--radius-control) border border-(--color-gold-300)/40 bg-(--color-gold-300)/10 px-3.5 py-2.5 text-sm text-(--color-ink-800)"
      : "mt-3 rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-3.5 py-2.5 text-sm text-(--color-danger-500)";
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;

    const birthDay = (document.getElementById("birth-day") as HTMLInputElement).value;
    const birthMonth = (document.getElementById("birth-month") as HTMLInputElement).value;
    const birthYear = (document.getElementById("birth-year") as HTMLInputElement).value;
    const birthHourRaw = (document.getElementById("birth-hour") as HTMLInputElement).value;
    const gender = (document.getElementById("gender") as HTMLSelectElement).value;

    try {
      const res = await fetch("/api/auth/ho-so", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          gender,
          birthDay: Number(birthDay), birthMonth: Number(birthMonth), birthYear: Number(birthYear),
          birthHour: birthHourRaw ? Number(birthHourRaw) : undefined,
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showMsg(data.error ?? "Có lỗi xảy ra, thử lại.", false);
        submitBtn.disabled = false;
        return;
      }
      showMsg("Đã lưu hồ sơ.", true);
    } catch {
      showMsg("Không kết nối được máy chủ, thử lại sau.", false);
    }
    submitBtn.disabled = false;
  });
</script>
