---
import { and, eq } from "drizzle-orm";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Container from "../../../../../components/ui/Container.astro";
import Button from "../../../../../components/ui/Button.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import VideoWatermark from "../../../../../components/courses/VideoWatermark.astro";
import { courses } from "../../../../../lib/placeholder-courses";
import { db } from "../../../../../lib/db/client";
import { courseEnrollments, lessonProgress } from "../../../../../../db/schema";
import { getSignedVideoUrl } from "../../../../../lib/video/r2";

export const prerender = false;

const { slug, lessonSlug } = Astro.params;
const course = courses.find((c) => c.slug === slug && c.lessons);
const lessonIndex = course?.lessons?.findIndex((l) => l.slug === lessonSlug) ?? -1;

if (!course || lessonIndex === -1) {
  return Astro.redirect("/khoa-hoc");
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/hoc-vien/dang-nhap?course=${encodeURIComponent(course.slug)}`);
}

// Kiểm tra đã ghi danh thật trong DB trước khi cho xem — không tin bất kỳ trạng thái nào từ client.
const [enrollment] = await db
  .select({ id: courseEnrollments.id })
  .from(courseEnrollments)
  .where(and(eq(courseEnrollments.userId, user.id), eq(courseEnrollments.courseRef, course.slug)))
  .limit(1);

if (!enrollment) {
  return Astro.redirect(`/khoa-hoc/${course.slug}`);
}

const lesson = course.lessons![lessonIndex];
const prevLesson = course.lessons![lessonIndex - 1] ?? null;
const nextLesson = course.lessons![lessonIndex + 1] ?? null;

const [progress] = await db
  .select({ id: lessonProgress.id })
  .from(lessonProgress)
  .where(
    and(
      eq(lessonProgress.userId, user.id),
      eq(lessonProgress.courseRef, course.slug),
      eq(lessonProgress.lessonRef, lesson.slug)
    )
  )
  .limit(1);
const isComplete = !!progress;

// Chặn trang bài học bị nhúng iframe trên website khác (chặn kiểu hotlink phổ biến nhất).
Astro.response.headers.set("X-Frame-Options", "SAMEORIGIN");
Astro.response.headers.set("Content-Security-Policy", "frame-ancestors 'self'");

const watermarkLabel = `${user.name} · ${user.email}`;

// Ưu tiên 1: video đã mã hóa HLS + AES-128 (bảo mật cao hơn nhiều, chống tải file gốc).
// Ưu tiên 2 (fallback): link MP4 thường có hạn giờ từ R2, dùng khi bài học chưa được mã hóa HLS.
const hasHls = !!lesson.hlsKeyHex && !!import.meta.env.PUBLIC_R2_HLS_BASE_URL;
const hlsUrl = hasHls
  ? `${import.meta.env.PUBLIC_R2_HLS_BASE_URL}/${course.slug}/${lesson.slug}/playlist.m3u8`
  : null;

let videoUrl: string | null = null;
if (!hasHls) {
  try {
    videoUrl = await getSignedVideoUrl(`${course.slug}/${lesson.slug}.mp4`);
  } catch (err) {
    console.error("[bai-hoc] Không tạo được link video R2:", err);
  }
}
---

<BaseLayout title={`${lesson.title} — ${course.name}`} noIndex>
  <Container class="py-10">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-xs text-(--color-ink-600)">
      <a href="/hoc-vien" class="hover:text-(--color-cinnabar-500)">Học viên</a>
      <span aria-hidden="true">/</span>
      <a href={`/hoc-vien/khoa-hoc/${course.slug}`} class="hover:text-(--color-cinnabar-500)">{course.name}</a>
      <span aria-hidden="true">/</span>
      <span class="text-(--color-ink-950)">{lesson.title}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="relative flex aspect-video items-center justify-center overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ink-950) text-(--color-ivory-300)">
          {hlsUrl ? (
            <video id="hls-video" controls controlsList="nodownload" class="size-full" preload="metadata" data-hls-src={hlsUrl} />
          ) : videoUrl ? (
            <video controls controlsList="nodownload" class="size-full" preload="metadata">
              <source src={videoUrl} type="video/mp4" />
              Trình duyệt của bạn không hỗ trợ phát video.
            </video>
          ) : (
            <div class="text-center">
              <Icon name="check-circle" class="mx-auto size-10 text-(--color-gold-400)" />
              <p class="mt-3 text-sm">Video chưa được tải lên (chưa cấu hình R2 hoặc chưa có file)</p>
              <p class="mt-1 text-xs text-(--color-ivory-400)">Thời lượng dự kiến: {lesson.durationLabel}</p>
            </div>
          )}
          <VideoWatermark label={watermarkLabel} />
        </div>

        <h1 class="mt-5 font-display text-2xl font-semibold text-(--color-ink-950)">{lesson.title}</h1>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <Button id="complete-btn" size="lg" class:list={[isComplete && "hidden"]} data-course-ref={course.slug} data-lesson-ref={lesson.slug}>
            Đánh dấu hoàn thành
          </Button>
          <span id="completed-badge" class:list={["inline-flex items-center gap-1.5 text-sm font-medium text-(--color-success-500)", !isComplete && "hidden"]}>
            <Icon name="check-circle" class="size-4.5" />
            Đã hoàn thành
          </span>
        </div>

        <div class="mt-8 flex items-center justify-between border-t border-(--color-ivory-300) pt-5">
          {prevLesson ? (
            <a href={`/hoc-vien/khoa-hoc/${course.slug}/bai-hoc/${prevLesson.slug}`} class="text-sm font-medium text-(--color-ink-700) hover:text-(--color-cinnabar-500)">← {prevLesson.title}</a>
          ) : <span />}
          {nextLesson ? (
            <a href={`/hoc-vien/khoa-hoc/${course.slug}/bai-hoc/${nextLesson.slug}`} class="text-sm font-medium text-(--color-ink-700) hover:text-(--color-cinnabar-500)">{nextLesson.title} →</a>
          ) : <span />}
        </div>
      </div>

      <aside class="h-fit rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
        <h2 class="font-display text-base font-semibold text-(--color-ink-950)">Nội dung khóa học</h2>
        <ul class="mt-3 space-y-1">
          {course.lessons?.map((l) => (
            <li>
              <a
                href={`/hoc-vien/khoa-hoc/${course.slug}/bai-hoc/${l.slug}`}
                class:list={[
                  "block rounded-(--radius-control) px-3 py-2 text-sm",
                  l.slug === lesson.slug
                    ? "bg-(--color-cinnabar-500) text-(--color-ivory-50)"
                    : "text-(--color-ink-700) hover:bg-(--color-ivory-200)",
                ]}
              >
                {l.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </Container>
</BaseLayout>

<script>
  import Hls from "hls.js";

  const hlsVideo = document.getElementById("hls-video") as HTMLVideoElement | null;
  const hlsSrc = hlsVideo?.dataset.hlsSrc;

  if (hlsVideo && hlsSrc) {
    if (Hls.isSupported()) {
      // Khóa giải mã AES-128 được hls.js tự động fetch từ URI nhúng sẵn trong playlist.m3u8
      // (chính là /api/courses/video-key) — cookie session gửi kèm tự nhiên vì cùng domain,
      // server sẽ kiểm tra đăng nhập + đã ghi danh trước khi trả khóa.
      const hls = new Hls();
      hls.loadSource(hlsSrc);
      hls.attachMedia(hlsVideo);
    } else if (hlsVideo.canPlayType("application/vnd.apple.mpegurl")) {
      // Safari hỗ trợ HLS gốc, không cần hls.js
      hlsVideo.src = hlsSrc;
    }
  }

  const completeBtn = document.getElementById("complete-btn") as HTMLButtonElement | null;
  completeBtn?.addEventListener("click", async () => {
    completeBtn.disabled = true;
    const res = await fetch("/api/courses/progress", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        courseRef: completeBtn.dataset.courseRef,
        lessonRef: completeBtn.dataset.lessonRef,
      }),
    });
    if (res.ok) {
      completeBtn.classList.add("hidden");
      document.getElementById("completed-badge")?.classList.remove("hidden");
    } else {
      completeBtn.disabled = false;
    }
  });
</script>
