---
import { and, eq } from "drizzle-orm";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Container from "../../../../../components/ui/Container.astro";
import Button from "../../../../../components/ui/Button.astro";
import Icon from "../../../../../components/ui/Icon.astro";
import VideoWatermark from "../../../../../components/courses/VideoWatermark.astro";
import { getCourseWithLessons, formatDuration } from "../../../../../lib/cms/queries";
import { db } from "../../../../../lib/db/client";
import { courseEnrollments, lessonProgress } from "../../../../../../db/schema";
import { getSignedEmbedUrl } from "../../../../../lib/video/bunnyStream";

export const prerender = false;

const { slug, lessonSlug } = Astro.params;
const course = slug ? await getCourseWithLessons(slug) : null;
const lessonIndex = course?.lessons.findIndex((l) => l.slug === lessonSlug) ?? -1;

if (!course || lessonIndex === -1) {
  return Astro.redirect("/khoa-hoc");
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/hoc-vien/dang-nhap?course=${encodeURIComponent(course.slug)}`);
}

// Kiểm tra đã ghi danh thật trong DB trước khi cho xem — không tin bất kỳ trạng thái nào từ client.
const [enrollment] = await db
  .select({ id: courseEnrollments.id })
  .from(courseEnrollments)
  .where(and(eq(courseEnrollments.userId, user.id), eq(courseEnrollments.courseRef, course.slug)))
  .limit(1);

if (!enrollment) {
  return Astro.redirect(`/khoa-hoc/${course.slug}`);
}

const lesson = course.lessons[lessonIndex];
const prevLesson = course.lessons[lessonIndex - 1] ?? null;
const nextLesson = course.lessons[lessonIndex + 1] ?? null;

const progressRows = await db
  .select({ lessonRef: lessonProgress.lessonRef })
  .from(lessonProgress)
  .where(and(eq(lessonProgress.userId, user.id), eq(lessonProgress.courseRef, course.slug)));
const completedSlugs = new Set(progressRows.map((p) => p.lessonRef));
const isComplete = completedSlugs.has(lesson.slug);
const totalLessons = course.lessons.length;
const percent = Math.round((completedSlugs.size / totalLessons) * 100);

// Chặn trang bài học bị nhúng iframe trên website khác (chặn kiểu hotlink phổ biến nhất).
Astro.response.headers.set("X-Frame-Options", "SAMEORIGIN");
Astro.response.headers.set("Content-Security-Policy", "frame-ancestors 'self'");

const watermarkLabel = `${user.name} · ${user.email}`;

// Video phát qua Bunny Stream (nhúng iframe có token bảo mật + hạn giờ). Nếu bài học chưa có
// video hoặc chưa cấu hình Bunny Stream, âm thầm rơi về placeholder — không làm sập trang.
let embedUrl: string | null = null;
if (lesson.bunnyVideoId) {
  try {
    embedUrl = getSignedEmbedUrl(lesson.bunnyVideoId);
  } catch (err) {
    console.error("[bai-hoc] Không tạo được link video Bunny Stream:", err);
  }
}
---

<BaseLayout title={`${lesson.title} — ${course.name}`} noIndex>
  <Container class="py-10">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-xs text-(--color-ink-600)">
      <a href="/hoc-vien" class="hover:text-(--color-gold-300)">Học viên</a>
      <span aria-hidden="true">/</span>
      <a href={`/hoc-vien/khoa-hoc/${course.slug}`} class="hover:text-(--color-gold-300)">{course.name}</a>
      <span aria-hidden="true">/</span>
      <span class="text-(--color-ink-950)">{lesson.title}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="relative flex aspect-video items-center justify-center overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) text-(--color-ink-600)">
          {embedUrl ? (
            <iframe
              src={embedUrl}
              loading="lazy"
              class="size-full"
              allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
              allowfullscreen
            />
          ) : (
            <div class="text-center">
              <Icon name="check-circle" class="mx-auto size-10 text-(--color-gold-400)" />
              <p class="mt-3 text-sm">Video chưa được tải lên (chưa cấu hình Bunny Stream hoặc chưa có video)</p>
              <p class="mt-1 text-xs text-(--color-ink-500)">Thời lượng dự kiến: {formatDuration(lesson.durationSeconds)}</p>
            </div>
          )}
          <VideoWatermark label={watermarkLabel} />
        </div>

        <div class="mt-5 flex flex-wrap items-start justify-between gap-4">
          <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">{lesson.title}</h1>
          <span class="shrink-0 rounded-full bg-(--color-ivory-200) px-3 py-1 text-xs font-medium text-(--color-ink-700)">
            Bài {lessonIndex + 1}/{totalLessons}
          </span>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <Button id="complete-btn" size="lg" class:list={[isComplete && "hidden"]} data-course-ref={course.slug} data-lesson-ref={lesson.slug}>
            <Icon name="check-circle" class="size-4.5" />
            Đánh dấu hoàn thành
          </Button>
          <span id="completed-badge" class:list={["inline-flex items-center gap-1.5 rounded-full bg-(--color-success-500)/10 px-3.5 py-2 text-sm font-medium text-(--color-success-500)", !isComplete && "hidden"]}>
            <Icon name="check-circle" class="size-4.5" />
            Đã hoàn thành
          </span>
        </div>

        <div class="mt-8 flex items-center justify-between gap-4 border-t border-(--color-ivory-300) pt-5">
          {prevLesson ? (
            <a href={`/hoc-vien/khoa-hoc/${course.slug}/bai-hoc/${prevLesson.slug}`} class="flex items-center gap-1.5 text-sm font-medium text-(--color-ink-700) hover:text-(--color-gold-300)">
              <Icon name="arrow-right" class="size-4 rotate-180" />
              <span class="hidden sm:inline">{prevLesson.title}</span>
              <span class="sm:hidden">Bài trước</span>
            </a>
          ) : <span />}
          {nextLesson ? (
            <a href={`/hoc-vien/khoa-hoc/${course.slug}/bai-hoc/${nextLesson.slug}`} class="flex items-center gap-1.5 text-sm font-medium text-(--color-ink-700) hover:text-(--color-gold-300)">
              <span class="hidden sm:inline">{nextLesson.title}</span>
              <span class="sm:hidden">Bài tiếp</span>
              <Icon name="arrow-right" class="size-4" />
            </a>
          ) : <span />}
        </div>
      </div>

      <aside class="h-fit rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5 lg:sticky lg:top-24">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-base font-semibold text-(--color-ink-950)">Nội dung khóa học</h2>
          <span class="text-xs font-medium text-(--color-ink-600)">{percent}%</span>
        </div>
        <div class="mt-2.5 h-1.5 overflow-hidden rounded-full bg-(--color-ivory-200)">
          <div class:list={["h-full rounded-full", percent === 100 ? "bg-(--color-success-500)" : "bg-(--color-gold-300)"]} style={`width: ${percent}%`} />
        </div>
        <ul class="mt-4 space-y-1">
          {course.lessons?.map((l, i) => {
            const isCurrent = l.slug === lesson.slug;
            const isDone = completedSlugs.has(l.slug);
            return (
              <li>
                <a
                  href={`/hoc-vien/khoa-hoc/${course.slug}/bai-hoc/${l.slug}`}
                  class:list={[
                    "flex items-center gap-3 rounded-(--radius-control) px-3 py-2 text-sm",
                    isCurrent
                      ? "bg-(--color-gold-400) text-(--color-on-accent)"
                      : "text-(--color-ink-700) hover:bg-(--color-ivory-200)",
                  ]}
                >
                  <span class:list={["flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold", isCurrent ? "bg-(--color-on-accent)/20" : isDone ? "text-(--color-success-500)" : "bg-(--color-ivory-200) text-(--color-ink-600)"]}>
                    {isDone ? <Icon name="check-circle" class="size-4" /> : i + 1}
                  </span>
                  <span class="flex-1 truncate">{l.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    </div>
  </Container>
</BaseLayout>

<script>
  const completeBtn = document.getElementById("complete-btn") as HTMLButtonElement | null;
  completeBtn?.addEventListener("click", async () => {
    completeBtn.disabled = true;
    const res = await fetch("/api/courses/progress", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        courseRef: completeBtn.dataset.courseRef,
        lessonRef: completeBtn.dataset.lessonRef,
      }),
    });
    if (res.ok) {
      completeBtn.classList.add("hidden");
      document.getElementById("completed-badge")?.classList.remove("hidden");
    } else {
      completeBtn.disabled = false;
    }
  });
</script>
