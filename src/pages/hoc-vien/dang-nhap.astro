---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout title="Đăng nhập học viên" description="Đăng nhập khu vực học viên Thiên Anh." noIndex>
  <Container class="flex min-h-[60vh] items-center justify-center py-16">
    <form id="login-form" class="w-full max-w-sm rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-8">
      <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">Đăng nhập học viên</h1>
      <p id="login-error" class="mt-3 hidden rounded-(--radius-control) border border-(--color-danger-500)/30 bg-(--color-danger-500)/10 px-3.5 py-2.5 text-sm text-(--color-danger-500)"></p>
      <div class="mt-6">
        <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <div class="mt-4">
        <label for="password" class="text-sm font-medium text-(--color-ink-800)">Mật khẩu</label>
        <input id="password" name="password" type="password" required autocomplete="current-password"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <Button type="submit" size="lg" class="mt-6 w-full">Đăng nhập</Button>
      <p class="mt-4 text-center text-sm text-(--color-ink-600)">
        Chưa có tài khoản? <a id="register-link" href="/hoc-vien/dang-ky" class="font-medium text-(--color-cinnabar-500) hover:underline">Đăng ký ngay</a>
      </p>
      <p class="mt-3 text-center text-xs text-(--color-ink-500)">Bản demo: tài khoản lưu tạm trên trình duyệt này, sẽ được kết nối Neon Postgres thật ở Giai đoạn 4.</p>
    </form>
  </Container>
</BaseLayout>

<script>
  import { login, enroll } from "../../lib/lms/lms-client";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorEl = document.getElementById("login-error")!;
  const registerLink = document.getElementById("register-link") as HTMLAnchorElement;

  const params = new URLSearchParams(window.location.search);
  const courseSlug = params.get("course");
  if (courseSlug) {
    registerLink.href = `/hoc-vien/dang-ky?course=${encodeURIComponent(courseSlug)}`;
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("password") as HTMLInputElement).value;

    const result = login(email, password);
    if (!result.ok) {
      errorEl.textContent = result.error ?? "Có lỗi xảy ra, thử lại.";
      errorEl.classList.remove("hidden");
      return;
    }

    if (courseSlug) {
      enroll(courseSlug);
      window.location.href = `/hoc-vien/khoa-hoc/${courseSlug}`;
    } else {
      window.location.href = "/hoc-vien";
    }
  });
</script>
