---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout title="Đăng nhập học viên" description="Đăng nhập khu vực học viên Thiên Anh." noIndex>
  <Container class="flex min-h-[60vh] items-center justify-center py-16">
    <form class="w-full max-w-sm rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-8">
      <h1 class="font-display text-2xl font-semibold text-(--color-ink-950)">Đăng nhập học viên</h1>
      <div class="mt-6">
        <label for="email" class="text-sm font-medium text-(--color-ink-800)">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <div class="mt-4">
        <label for="password" class="text-sm font-medium text-(--color-ink-800)">Mật khẩu</label>
        <input id="password" name="password" type="password" required autocomplete="current-password"
          class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-cinnabar-500) focus:outline-none focus:ring-2 focus:ring-(--color-cinnabar-500)/20" />
      </div>
      <Button type="submit" size="lg" class="mt-6 w-full">Đăng nhập</Button>
      <p class="mt-4 text-center text-sm text-(--color-ink-600)">
        Chưa có tài khoản? <a href="/hoc-vien/dang-ky" class="font-medium text-(--color-cinnabar-500) hover:underline">Đăng ký ngay</a>
      </p>
      <p class="mt-3 text-center text-xs text-(--color-ink-500)">Hệ thống đăng nhập sẽ được kết nối cơ sở dữ liệu ở Giai đoạn 4.</p>
    </form>
  </Container>
</BaseLayout>
