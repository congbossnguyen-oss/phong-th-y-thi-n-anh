---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";

export const prerender = true;
---

<BaseLayout title="Chính sách bảo mật" description="Chính sách bảo mật thông tin khách hàng của Thiên Anh.">
  <PageHero title="Chính sách bảo mật" breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Chính sách bảo mật" }]} />
  <Container class="py-16">
    <div class="max-w-2xl text-sm leading-relaxed text-(--color-ink-700)">
      <p>Nội dung chính sách bảo mật đầy đủ sẽ được cập nhật cùng nội dung pháp lý chính thức từ khách hàng.</p>
    </div>
  </Container>
</BaseLayout>
