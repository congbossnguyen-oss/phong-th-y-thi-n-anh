---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Icon from "../../components/ui/Icon.astro";
import { siteConfig } from "../../lib/site-config";

export const prerender = true;

const exchangeCases = [
  {
    title: "Sản phẩm bị lỗi do nhà sản xuất",
    desc: `Trong trường hợp nhận hàng và phát hiện sản phẩm bị lỗi, khách hàng có thể hoàn trả lại và ${siteConfig.shortName} sẽ có trách nhiệm đổi một sản phẩm khác thay thế.`,
  },
  {
    title: "Sản phẩm giao không đúng theo đơn hàng",
    desc: "Nếu nhận phải sản phẩm không đúng như đơn hàng, khách hàng vui lòng hoàn lại để được đổi trả sản phẩm đúng như trên đơn.",
  },
  {
    title: "Không ưng ý với sản phẩm đã mua",
    desc: `Nếu đơn giản không hài lòng và ưng ý với sản phẩm đã đặt mua, khách hàng hoàn toàn có thể hoàn trả lại hàng. ${siteConfig.shortName} sẽ đổi một sản phẩm khác có giá thành tương tự cho khách hàng.`,
  },
];

const exchangeConditions = [
  `Sản phẩm vẫn còn nguyên hộp và giấy bảo hành của ${siteConfig.shortName}`,
  "Sản phẩm chưa qua sử dụng (bị bẩn hay sứt mẻ,…)",
  "Sản phẩm đổi mới phải có giá trị tương ứng hoặc cao hơn so với sản phẩm ban đầu",
];

const exchangeSteps = [
  `Kiểm tra kỹ lưỡng hàng ngay sau khi nhận hàng, nếu phát hiện ra vấn đề gì hãy báo với nhân viên giao hàng hoặc gọi đến hotline của ${siteConfig.shortName} để được hỗ trợ ngay`,
  `Xác nhận lại yêu cầu và điều kiện đổi trả theo Chính sách đổi trả của ${siteConfig.shortName} và phối hợp với điều phối viên để được thực hiện đổi hàng nhanh nhất`,
];
---

<BaseLayout title="Chính sách đổi trả" description="Chính sách đổi trả vật phẩm phong thủy của Thiên Anh.">
  <PageHero title="Chính sách đổi trả" breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Chính sách đổi trả" }]} />
  <Container class="py-16">
    <div class="max-w-2xl">
      <p class="text-base leading-relaxed text-(--color-ink-700)">
        Mọi khách hàng được đổi sản phẩm trong các trường hợp sau:
      </p>

      <div class="mt-6 space-y-5">
        {exchangeCases.map((c) => (
          <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
            <h2 class="font-display text-base font-semibold text-(--color-ink-950)">{c.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-(--color-ink-700)">{c.desc}</p>
          </div>
        ))}
      </div>

      <h2 class="mt-10 font-display text-xl font-semibold text-(--color-ink-950)">Điều kiện đổi trả hàng</h2>
      <p class="mt-3 text-sm leading-relaxed text-(--color-ink-700)">
        Khách hàng có thể đổi sang sản phẩm khác 1 lần duy nhất và có hiệu lực trong vòng 07 ngày kể từ thời
        điểm nhận hàng. Trong đó các sản phẩm cần đổi phải đáp ứng những điều kiện sau:
      </p>
      <ul class="mt-4 space-y-3">
        {exchangeConditions.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-(--color-ink-700)">
            <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-(--color-gold-300)" />
            {item}
          </li>
        ))}
      </ul>

      <h2 class="mt-10 font-display text-xl font-semibold text-(--color-ink-950)">Cách thức đổi trả hàng</h2>
      <ol class="mt-4 space-y-4">
        {exchangeSteps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-(--color-gold-300)/15 font-display text-sm font-semibold text-(--color-gold-400)">{i + 1}</span>
            <p class="pt-1 text-sm leading-relaxed text-(--color-ink-700)">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</BaseLayout>
