---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Xem ngày tốt xấu"
  description="Tra cứu Tứ Trụ, Âm lịch, Tiết Khí, Trực, Nhị Thập Bát Tú, Hoàng Đạo/Hắc Đạo và Tiểu Lục Nhâm theo từng giờ cho một ngày dương lịch bất kỳ — đầy đủ màu sắc Âm Dương Ngũ Hành."
>
  <PageHero
    eyebrow="Công cụ tra cứu"
    title="Xem ngày tốt xấu"
    description="Chọn một ngày dương lịch để xem đầy đủ thông tin Trạch Nhật: Tứ Trụ, Âm lịch, Tiết Khí, Trực, Nhị Thập Bát Tú, Hoàng Đạo/Hắc Đạo theo ngày và theo từng giờ."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Xem ngày tốt xấu" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-3xl">
      <div class="rounded-2xl border-2 border-amber-300 bg-white p-4 text-slate-900 shadow-lg sm:p-6">
        <div class="flex items-center justify-between">
          <button
            type="button"
            id="cal-prev"
            aria-label="Tháng trước"
            class="flex size-9 shrink-0 items-center justify-center rounded-full text-lg font-bold hover:bg-slate-100"
          >‹</button>
          <p id="cal-title" class="font-display text-lg font-bold text-slate-900"></p>
          <button
            type="button"
            id="cal-next"
            aria-label="Tháng sau"
            class="flex size-9 shrink-0 items-center justify-center rounded-full text-lg font-bold hover:bg-slate-100"
          >›</button>
        </div>
        <div class="mt-3 grid grid-cols-7 gap-1 text-center text-[11px] font-semibold uppercase tracking-wide text-slate-400">
          <span class="text-red-500">CN</span><span>Hai</span><span>Ba</span><span>Tư</span><span>Năm</span><span>Sáu</span><span>Bảy</span>
        </div>
        <div id="cal-grid" class="mt-1 grid grid-cols-7 gap-1"></div>
        <p class="mt-2 text-[11px] text-slate-400">✂️ = ngày đẹp cắt tóc, cạo đầu</p>
      </div>

      <form id="xem-ngay-form" class="mt-4 flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6 sm:flex-row sm:items-end">
        <div class="flex-1">
          <p class="text-sm font-medium text-(--color-ink-800)">Hoặc chọn nhanh ngày (dương lịch)</p>
          <div class="mt-1.5 grid grid-cols-3 gap-2">
            <select
              id="ngay-xem-ngay"
              aria-label="Ngày"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
            ></select>
            <select
              id="ngay-xem-thang"
              aria-label="Tháng"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
            ></select>
            <select
              id="ngay-xem-nam"
              aria-label="Năm"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
            ></select>
          </div>
        </div>
        <Button type="submit" size="lg" class="shrink-0">Xem ngày này</Button>
      </form>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-(--color-ink-500)">
        <span>
          Sao/thần sát:
          <span class="ml-1 rounded-(--radius-pill) bg-(--color-cinnabar-500) px-2 py-0.5 text-xs font-bold text-(--color-gold-100)">cát</span>
          <span class="ml-1 rounded-(--radius-pill) bg-black px-2 py-0.5 text-xs font-bold text-(--color-ink-950)">hung</span>
        </span>
        <span class="hidden sm:inline text-(--color-ink-500)">·</span>
        <span class="inline-flex flex-wrap items-center gap-2">
          Ngũ Hành:
          <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-[#16a34a]"></span>Mộc</span>
          <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-[#dc2626]"></span>Hỏa</span>
          <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-[#8b5a2b]"></span>Thổ</span>
          <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-[#64748b]"></span>Kim</span>
          <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-[#2563eb]"></span>Thủy</span>
        </span>
      </div>

      <div id="loi" class="mt-6 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <div id="ket-qua" class="mt-8 hidden">
        <div class="rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Thông tin ngày</p>
          <h2 id="kq-ngay-duong" class="mt-1 font-display text-2xl font-bold text-slate-900"></h2>
          <p id="kq-ngay-am" class="mt-1 text-sm text-slate-600"></p>

          <div class="mt-5 grid grid-cols-2 gap-3 border-t border-slate-200 pt-5 sm:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-500">Năm</p>
              <p id="kq-tru-nam" class="mt-1 font-display text-xl font-bold"></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-500">Tháng</p>
              <p id="kq-tru-thang" class="mt-1 font-display text-xl font-bold"></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-500">Ngày</p>
              <p id="kq-tru-ngay" class="mt-1 font-display text-xl font-bold"></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-500">Tiết khí</p>
              <p id="kq-tiet-khi" class="mt-1 font-display text-xl font-bold text-slate-900"></p>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-5 text-sm">
            <span class="text-slate-500">Trực:</span>
            <span id="kq-truc" class="font-bold text-slate-900"></span>
            <span class="mx-2 text-slate-300">·</span>
            <span class="text-slate-500">Nhị Thập Bát Tú:</span>
            <span id="kq-tu-badge"></span>
            <span class="mx-2 text-slate-300">·</span>
            <span class="text-slate-500">Hoàng/Hắc Đạo ngày:</span>
            <span id="kq-hoang-hac-ngay" class="font-bold text-slate-900"></span>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Thần sát trong ngày</p>
            <div id="kq-than-sat" class="mt-2 flex flex-wrap gap-2"></div>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Tuổi xung ngày này</p>
            <p id="kq-tuoi-xung" class="mt-1 text-sm font-semibold text-slate-800"></p>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Ngày kỵ đặc biệt</p>
            <div id="kq-ngay-ky" class="mt-2 flex flex-wrap gap-2"></div>
          </div>

          <div id="kq-kim-than-that-sat-wrap" class="mt-5 hidden border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Kim Thần Thất Sát — đại kỵ với tuổi</p>
            <p id="kq-kim-than-that-sat" class="mt-1 text-sm font-semibold text-slate-800"></p>
            <div class="mt-2 space-y-1 text-xs text-slate-500">
              <p><strong class="text-slate-600">Xây dựng, sửa nhà:</strong> Tránh động thổ, cất nóc, đổ mái hay nhập trạch.</p>
              <p><strong class="text-slate-600">Cưới hỏi:</strong> Tránh tổ chức đám cưới, ăn hỏi vì sợ đổ vỡ, bất hòa.</p>
              <p><strong class="text-slate-600">Kinh doanh, xuất hành:</strong> Tránh khai trương, ký kết hợp đồng lớn hoặc đi xa.</p>
              <p><strong class="text-slate-600">An táng:</strong> Tránh chôn cất, mai táng.</p>
            </div>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Kim Thần Thất Sát theo năm — đại kỵ ngày</p>
            <p id="kq-kim-than-nam" class="mt-1 text-sm font-semibold text-slate-800"></p>
          </div>

          <div id="kq-tam-tai-wrap" class="mt-5 hidden border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Năm nay phạm hạn Tam Tai — tuổi thuộc nhóm</p>
            <p id="kq-tam-tai" class="mt-1 text-sm font-semibold text-slate-800"></p>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Phạm Thái Tuế năm nay — tuổi thuộc nhóm</p>
            <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-5">
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-center">
                <p class="text-[11px] uppercase tracking-wide text-slate-500">Trực (Tọa)</p>
                <p id="kq-thai-tue-truc" class="mt-0.5 font-display text-lg font-bold text-slate-900"></p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-center">
                <p class="text-[11px] uppercase tracking-wide text-slate-500">Xung</p>
                <p id="kq-thai-tue-xung" class="mt-0.5 font-display text-lg font-bold text-slate-900"></p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-center">
                <p class="text-[11px] uppercase tracking-wide text-slate-500">Hình</p>
                <p id="kq-thai-tue-hinh" class="mt-0.5 font-display text-lg font-bold text-slate-900"></p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-center">
                <p class="text-[11px] uppercase tracking-wide text-slate-500">Hại</p>
                <p id="kq-thai-tue-hai" class="mt-0.5 font-display text-lg font-bold text-slate-900"></p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-center">
                <p class="text-[11px] uppercase tracking-wide text-slate-500">Phá</p>
                <p id="kq-thai-tue-pha" class="mt-0.5 font-display text-lg font-bold text-slate-900"></p>
              </div>
            </div>
            <p class="mt-2 text-xs text-slate-500">5 loại phạm Thái Tuế kinh điển theo tuổi (Chi năm sinh).</p>
          </div>

          <div id="kq-bach-ky-wrap" class="mt-5 hidden border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Ngày Bách Kỵ</p>
            <p id="kq-bach-ky" class="mt-1 text-sm font-semibold text-slate-800"></p>
            <p class="mt-1 text-xs text-slate-400">Theo Can/Chi của ngày (Hiệp Kỷ Biện Phương Thư)</p>
          </div>

          <div id="kq-cat-toc-wrap" class="mt-5 hidden border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Ngày cắt tóc</p>
            <p class="mt-1 text-sm font-semibold text-(--color-cinnabar-500)">✂️ Hôm nay là ngày đẹp để cắt tóc, cạo đầu.</p>
          </div>

          <div id="kq-than-sat-them-wrap" class="mt-5 hidden border-t border-slate-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Sao cát khác trong ngày</p>
            <div id="kq-than-sat-them" class="mt-2 flex flex-wrap gap-2"></div>
          </div>
        </div>

        <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Giờ xuất hành (Tiểu Lục Nhâm)</p>
          <div id="kq-luc-nham" class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
        </div>

        <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Tra cứu Nghi/Kỵ theo việc (tham khảo)</p>
          <p class="mt-1 text-xs text-slate-500">
            Trích từ sách "Hiệp Kỷ Biện Phương Thư" (Mai Cốc Thành) — có thể thiếu hoặc chưa chính xác 100%. Chỉ mang tính
            tham khảo sơ bộ, không phụ thuộc vào ngày đang xem ở trên.
          </p>
          <select
            id="dung-su-select"
            class="mt-3 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
          ></select>
          <div id="dung-su-ket-qua" class="mt-4 space-y-2 text-sm"></div>
        </div>

        <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Ngày giao tế · tiệc tùng</p>
          <p class="mt-1 text-xs text-slate-500">
            Tự động chấm điểm mức độ phù hợp để ăn uống, tiệc tùng, gặp gỡ, tiếp khách trong tháng đang xem trên lịch, dựa
            trên toàn bộ dữ liệu ngày ở trên. Bấm vào 1 ngày để xem các yếu tố đã cộng/trừ điểm.
          </p>
          <div id="giao-te-list" class="mt-3 max-h-[420px] space-y-1.5 overflow-y-auto"></div>
        </div>

        <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Ngày động phòng</p>
          <p class="mt-1 text-xs text-slate-500">
            Tự động chấm điểm riêng cho việc vợ chồng động phòng sau hôn lễ trong tháng đang xem trên lịch — khác thang
            điểm với ngày giao tế/tiệc tùng ở trên. Chọn tuổi (con giáp) hai vợ chồng nếu muốn xét thêm xung hợp, để
            trống nếu chưa biết.
          </p>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <select
              id="dong-phong-chi-chong"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
            >
              <option value="">Tuổi chồng (bỏ trống)</option>
            </select>
            <select
              id="dong-phong-chi-vo"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
            >
              <option value="">Tuổi vợ (bỏ trống)</option>
            </select>
          </div>
          <div id="dong-phong-list" class="mt-3 max-h-[420px] space-y-1.5 overflow-y-auto"></div>
        </div>

        <div class="mt-6 rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Tuổi hợp làm ăn</p>
          <p class="mt-1 text-xs text-slate-500">
            Nhập năm sinh dương lịch của 2 người để xem mức độ hợp nhau khi hợp tác làm ăn, kinh doanh, đầu tư — hệ
            thống tự tính Thiên Can, Địa Chi, Ngũ Hành bản mệnh và Nạp Âm, không cần biết trước phong thủy hay giới tính.
          </p>
          <form id="tuoi-hop-lam-an-form" class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-end">
            <div class="flex-1">
              <label for="tuoi-hop-nam-1" class="text-xs font-medium text-slate-600">Năm sinh người 1</label>
              <input
                type="number"
                id="tuoi-hop-nam-1"
                placeholder="vd. 1988"
                min="1900"
                max="2100"
                required
                class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
              />
            </div>
            <div class="flex-1">
              <label for="tuoi-hop-nam-2" class="text-xs font-medium text-slate-600">Năm sinh người 2</label>
              <input
                type="number"
                id="tuoi-hop-nam-2"
                placeholder="vd. 1992"
                min="1900"
                max="2100"
                required
                class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800) focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"
              />
            </div>
            <Button type="submit" size="lg" class="shrink-0">Xem tuổi hợp làm ăn</Button>
          </form>
          <div id="tuoi-hop-loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>
          <div id="tuoi-hop-ket-qua" class="mt-4 hidden">
            <button
              type="button"
              id="tuoi-hop-toggle"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 p-4 text-left hover:bg-slate-100"
            >
              <p id="tuoi-hop-nhan" class="font-display text-lg font-bold text-slate-900"></p>
              <p id="tuoi-hop-diem" class="mt-0.5 text-sm text-slate-600"></p>
            </button>
            <div id="tuoi-hop-chi-tiet" class="mt-2 hidden space-y-1.5 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-700">
              <p><strong class="text-slate-600">Can:</strong> <span id="tuoi-hop-can"></span></p>
              <p><strong class="text-slate-600">Chi:</strong> <span id="tuoi-hop-chi"></span></p>
              <p><strong class="text-slate-600">Mệnh:</strong> <span id="tuoi-hop-menh"></span></p>
              <p><strong class="text-slate-600">Nạp âm:</strong> <span id="tuoi-hop-nap-am"></span></p>
              <p><strong class="text-slate-600">Tổng hợp:</strong> <span id="tuoi-hop-tong-hop"></span></p>
              <p class="pt-1 text-xs text-slate-400">Kết luận: <span id="tuoi-hop-ket-luan"></span></p>
            </div>
          </div>
        </div>

        <div class="mt-6 overflow-x-auto rounded-2xl border-2 border-amber-300 bg-white p-6 text-slate-900 shadow-lg">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-600">Bảng 12 giờ trong ngày</p>
          <table class="mt-3 w-full min-w-[520px] border-collapse text-center text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
                <th class="py-2 px-2">Thời gian</th>
                <th class="py-2 px-2">Can Chi giờ</th>
                <th class="py-2 px-2">Tiểu Lục Nhâm</th>
                <th class="py-2 px-2">Hoàng-Hắc giờ</th>
              </tr>
            </thead>
            <tbody id="kq-gio-12"></tbody>
          </table>
        </div>

        <p class="mt-4 text-xs text-(--color-ink-500)">
          Dữ liệu tính theo Ngọc Hạp Thông Thư và quy tắc Trạch Nhật cổ điển — đây là dữ kiện thuần túy, không phải luận giải cho trường hợp cụ thể. Muốn luận giải chính xác cho việc cần làm, hãy đặt lịch tư vấn trực tiếp.
        </p>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  interface CatHungValue {
    name: string;
    catHung: "cát" | "hung";
  }

  interface GioTrongNgay {
    chiGio: string;
    canChiGio: { can: string; chi: string };
    hoangDaoHacDaoGio: CatHungValue;
    tieuLucNhamGio: CatHungValue;
  }

  interface TrachNhatOutput {
    solarDate: { year: number; month: number; day: number };
    lunarDate: { year: number; month: number; day: number; isLeapMonth: boolean };
    tietKhi: { name: string } | null;
    tuTru: {
      nam: { can: string; chi: string };
      thang: { can: string; chi: string };
      ngay: { can: string; chi: string };
    };
    truc: { index: number; name: string };
    nhiThapBatTu: { index: number; name: string; catHung: "cát" | "hung" };
    hoangDaoHacDaoNgay: "hoàng đạo" | "hắc đạo" | "không xác định";
    thanSat: CatHungValue[];
    tuoiXungNgay: string[];
    nguyetKy: boolean;
    tamNuong: boolean;
    duongCongKyNhat: boolean;
    satChu: boolean;
    nhomTuoiPhamTamTai: string[][];
    canNamSinhKyKimThanThatSat: string[];
    chiNgayKyKimThanThatSatTheoNam: string[];
    bachKyNgay: { nhan: string; viec: string }[];
    catTocDep: boolean;
    thienDucHop: boolean;
    thienXa: boolean;
    phamThaiTue: {
      namChi: string;
      tuoiPhamThaiTue: string;
      tuoiXungThaiTue: string;
      tuoiHinhThaiTue: string[];
      namTuHinh: boolean;
      tuoiHaiThaiTue: string;
      tuoiPhaThaiTue: string;
    };
    gio12: GioTrongNgay[];
  }

  interface MonthGridDay {
    solarDate: { year: number; month: number; day: number };
    lunarDay: number;
    lunarMonth: number;
    isLeapMonth: boolean;
    isCurrentMonth: boolean;
    weekday: number;
    catTocDep: boolean;
  }

  interface MonthGridResult {
    year: number;
    month: number;
    days: MonthGridDay[];
  }

  interface GiaoTeTiecTungYeuTo {
    ten: string;
    diem: number;
  }

  interface GiaoTeTiecTungNgay {
    solarDate: { year: number; month: number; day: number };
    lunarDay: number;
    weekday: number;
    diem: number;
    hang: "rat-tot" | "tot" | "co-the-dung" | "khong-nen";
    nhan: string;
    goiY: string;
    yeuTo: GiaoTeTiecTungYeuTo[];
    phamDaiKy: boolean;
  }

  interface GiaoTeTiecTungRangeResult {
    ngayXepHang: GiaoTeTiecTungNgay[];
  }

  interface DongPhongXungHopMotNguoi {
    chi: string;
    xung: boolean;
    hinh: boolean;
    hai: boolean;
    tamHop: boolean;
    moTa: string;
  }

  interface DongPhongNgay {
    solarDate: { year: number; month: number; day: number };
    lunarDay: number;
    weekday: number;
    diem: number;
    hang: "rat-tot" | "tot" | "co-the-dung" | "khong-nen";
    nhan: string;
    goiY: string;
    yeuTo: GiaoTeTiecTungYeuTo[];
    phamDaiKy: boolean;
    xungHopChong: DongPhongXungHopMotNguoi | null;
    xungHopVo: DongPhongXungHopMotNguoi | null;
  }

  interface DongPhongRangeResult {
    ngayXepHang: DongPhongNgay[];
  }

  interface EngineErrorLike {
    code: string;
    message: string;
    field?: string;
  }

  interface EngineResultLike {
    ok: boolean;
    data?: TrachNhatOutput;
    errors?: EngineErrorLike[];
  }

  interface DungSuNghiKyEntry {
    ten: string;
    nghiRaw: string | null;
    kyRaw: string | null;
    ghiChu?: string;
    dongOcr: string;
  }

  // Ngũ Hành + Âm Dương của Thiên Can/Địa Chi — kiến thức nền tảng cố định (không có dị bản),
  // đúng bộ màu đã dùng cho lá số Bát Tự (src/pages/lap-la-so-bat-tu.astro) để nhất quán trên site.
  const CAN_ORDER = ["Giáp", "Ất", "Bính", "Đinh", "Mậu", "Kỷ", "Canh", "Tân", "Nhâm", "Quý"];
  const CHI_ORDER = ["Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ", "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"];
  // Mỗi Chi giờ phủ đúng 2 tiếng, khởi từ 23h (giờ Tý) — kiến thức nền tảng cố định.
  const CHI_KHUNG_GIO = [
    "23h~1h",
    "1h~3h",
    "3h~5h",
    "5h~7h",
    "7h~9h",
    "9h~11h",
    "11h~13h",
    "13h~15h",
    "15h~17h",
    "17h~19h",
    "19h~21h",
    "21h~23h",
  ];
  const CAN_NGU_HANH = ["Mộc", "Mộc", "Hỏa", "Hỏa", "Thổ", "Thổ", "Kim", "Kim", "Thủy", "Thủy"];
  const CHI_NGU_HANH = ["Thủy", "Thổ", "Mộc", "Mộc", "Thổ", "Hỏa", "Hỏa", "Thổ", "Kim", "Kim", "Thổ", "Thủy"];
  const NGU_HANH_COLOR: Record<string, string> = {
    Mộc: "#16a34a",
    Hỏa: "#dc2626",
    Thổ: "#8b5a2b",
    Kim: "#64748b",
    Thủy: "#2563eb",
  };

  function canHtml(can: string): string {
    const i = CAN_ORDER.indexOf(can);
    if (i === -1) return can;
    const nguHanh = CAN_NGU_HANH[i]!;
    return `<span style="color:${NGU_HANH_COLOR[nguHanh]}" title="${nguHanh} · ${i % 2 === 0 ? "Dương" : "Âm"}">${can}</span>`;
  }

  function chiHtml(chi: string): string {
    const i = CHI_ORDER.indexOf(chi);
    if (i === -1) return chi;
    const nguHanh = CHI_NGU_HANH[i]!;
    return `<span style="color:${NGU_HANH_COLOR[nguHanh]}" title="${nguHanh} · ${i % 2 === 0 ? "Dương" : "Âm"}">${chi}</span>`;
  }

  function canChiHtml(can: string, chi: string): string {
    return `${canHtml(can)} ${chiHtml(chi)}`;
  }

  const form = document.getElementById("xem-ngay-form") as HTMLFormElement;
  const ngaySelect = document.getElementById("ngay-xem-ngay") as HTMLSelectElement;
  const thangSelect = document.getElementById("ngay-xem-thang") as HTMLSelectElement;
  const namSelect = document.getElementById("ngay-xem-nam") as HTMLSelectElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;
  const gio12Body = document.getElementById("kq-gio-12")!;
  const thanSatEl = document.getElementById("kq-than-sat")!;
  const tuBadgeEl = document.getElementById("kq-tu-badge")!;

  function catHungBadge(name: string, catHung: "cát" | "hung"): string {
    const cls = catHung === "cát" ? "bg-(--color-cinnabar-500) text-(--color-gold-100)" : "bg-black text-white";
    return `<span class="rounded-(--radius-pill) px-2.5 py-1 text-xs font-bold ${cls}">${name}</span>`;
  }

  // --- Giờ xuất hành (Tiểu Lục Nhâm) — nhóm 12 giờ theo 6 tên, mỗi tên đúng 2 khung giờ/ngày.
  // Thứ tự lưới 2 hàng x 3 cột + màu từng ô theo đúng bố cục mẫu: hàng 1 Lưu Niên/Tốc Hỷ/Xích
  // Khẩu, hàng 2 Đại An/Không Vong/Tiểu Cát.
  const LUC_NHAM_ORDER = ["Lưu Niên", "Tốc Hỷ", "Xích Khẩu", "Đại An", "Không Vong", "Tiểu Cát"];
  const LUC_NHAM_COLOR: Record<string, string> = {
    "Lưu Niên": "bg-slate-500 text-white",
    "Tốc Hỷ": "bg-[#16a34a] text-white",
    "Xích Khẩu": "bg-slate-500 text-white",
    "Đại An": "bg-(--color-cinnabar-500) text-white",
    "Không Vong": "bg-slate-500 text-white",
    "Tiểu Cát": "bg-(--color-gold-500) text-white",
  };

  function renderLucNham(gio12: GioTrongNgay[]): string {
    const grouped = new Map<string, { catHung: "cát" | "hung"; chiList: string[] }>();
    for (const g of gio12) {
      const name = g.tieuLucNhamGio.name;
      if (!grouped.has(name)) grouped.set(name, { catHung: g.tieuLucNhamGio.catHung, chiList: [] });
      grouped.get(name)!.chiList.push(g.chiGio);
    }
    return LUC_NHAM_ORDER.map((name) => {
      const info = grouped.get(name);
      if (!info) return "";
      const colorCls = LUC_NHAM_COLOR[name] ?? "bg-slate-500 text-white";
      const chiLines = info.chiList
        .map((chi) => {
          const idx = CHI_ORDER.indexOf(chi);
          const khung = idx === -1 ? "" : CHI_KHUNG_GIO[idx].replace("~", "-");
          return `<p class="text-sm font-semibold text-slate-800">${chi}(${khung})</p>`;
        })
        .join("");
      const nhanXet = info.catHung === "cát" ? "Giờ tốt" : "Giờ xấu";
      const nhanXetCls = info.catHung === "cát" ? "text-(--color-cinnabar-500)" : "text-slate-500";
      return `
        <div class="overflow-hidden rounded-xl border border-slate-200 text-center">
          <div class="${colorCls} py-2 text-sm font-bold uppercase tracking-wide">${name}</div>
          <div class="space-y-0.5 p-3">
            ${chiLines}
            <p class="pt-1 text-xs font-semibold ${nhanXetCls}">(${nhanXet})</p>
          </div>
        </div>`;
    }).join("");
  }

  // --- Lịch dạng lưới cả tháng: bấm vào 1 ô để xem chi tiết ngày đó bên dưới.
  const calTitleEl = document.getElementById("cal-title")!;
  const calGridEl = document.getElementById("cal-grid")!;
  const calPrevBtn = document.getElementById("cal-prev") as HTMLButtonElement;
  const calNextBtn = document.getElementById("cal-next") as HTMLButtonElement;
  const THANG_LABEL = ["", "Một", "Hai", "Ba", "Tư", "Năm", "Sáu", "Bảy", "Tám", "Chín", "Mười", "Mười Một", "Mười Hai"];

  let calYear: number;
  let calMonth: number;
  let selectedYear: number;
  let selectedMonth: number;
  let selectedDay: number;

  async function loadCalendarGrid(year: number, month: number) {
    calYear = year;
    calMonth = month;
    calTitleEl.textContent = `Tháng ${THANG_LABEL[month]} - ${year}`;

    let grid: MonthGridResult;
    try {
      const res = await fetch(`/api/trach-nhat-thang?year=${year}&month=${month}&timeZone=Asia/Ho_Chi_Minh`);
      grid = await res.json();
    } catch {
      calGridEl.innerHTML = '<p class="col-span-7 py-4 text-center text-sm text-slate-500">Không tải được lịch tháng.</p>';
      return;
    }

    calGridEl.innerHTML = grid.days
      .map((d: MonthGridDay) => {
        const isSelected =
          d.solarDate.year === selectedYear && d.solarDate.month === selectedMonth && d.solarDate.day === selectedDay;
        const dimCls = d.isCurrentMonth ? "text-slate-900" : "text-slate-300";
        const selectedCls = isSelected
          ? "bg-(--color-cinnabar-500) text-white"
          : "hover:bg-amber-50";
        const catTocMark = d.catTocDep
          ? `<span class="absolute top-0 right-0.5 text-sm leading-none" title="Ngày đẹp cắt tóc">✂️</span>`
          : "";
        const laMungMotHoacRam = d.lunarDay === 1 || d.lunarDay === 15;
        const soNgayCls = laMungMotHoacRam
          ? "flex size-6 items-center justify-center rounded-full bg-amber-300/60 text-sm font-bold"
          : "text-sm font-bold";
        return `
          <button
            type="button"
            class="cal-cell relative flex flex-col items-center rounded-lg py-1.5 ${dimCls} ${selectedCls}"
            data-y="${d.solarDate.year}" data-m="${d.solarDate.month}" data-d="${d.solarDate.day}"
          >
            ${catTocMark}
            <span class="${soNgayCls}" title="${laMungMotHoacRam ? (d.lunarDay === 1 ? "Mùng 1" : "Rằm") : ""}">${d.solarDate.day}</span>
            <span class="text-[10px] ${isSelected ? "text-white/80" : "text-slate-400"}">${d.lunarDay}</span>
          </button>`;
      })
      .join("");

    calGridEl.querySelectorAll<HTMLButtonElement>(".cal-cell").forEach((btn) => {
      btn.addEventListener("click", () => {
        const y = Number(btn.dataset.y);
        const m = Number(btn.dataset.m);
        const d = Number(btn.dataset.d);
        ngaySelect.value = String(d);
        thangSelect.value = String(m);
        namSelect.value = String(y);
        xemNgay(y, m, d);
        if (m !== calMonth || y !== calYear) loadCalendarGrid(y, m);
        else highlightSelectedCell();
      });
    });

    loadGiaoTeTiecTung(year, month);
    loadDongPhong(year, month);
  }

  function highlightSelectedCell() {
    calGridEl.querySelectorAll<HTMLButtonElement>(".cal-cell").forEach((btn) => {
      const isSelected =
        Number(btn.dataset.y) === selectedYear && Number(btn.dataset.m) === selectedMonth && Number(btn.dataset.d) === selectedDay;
      btn.classList.toggle("bg-(--color-cinnabar-500)", isSelected);
      btn.classList.toggle("text-white", isSelected);
      btn.classList.toggle("hover:bg-amber-50", !isSelected);
      const lunarSpan = btn.querySelector("span:last-child")!;
      lunarSpan.classList.toggle("text-white/80", isSelected);
      lunarSpan.classList.toggle("text-slate-400", !isSelected);
    });
  }

  // --- Ngày giao tế · tiệc tùng: chấm điểm tự động cả tháng đang xem trên lịch, xếp hạng.
  const HANG_ICON: Record<string, string> = {
    "rat-tot": "⭐",
    "tot": "🟢",
    "co-the-dung": "🟡",
    "khong-nen": "🔴",
  };
  const giaoTeListEl = document.getElementById("giao-te-list")!;

  async function loadGiaoTeTiecTung(year: number, month: number) {
    giaoTeListEl.innerHTML = '<p class="py-2 text-center text-sm text-slate-500">Đang tính điểm...</p>';

    let result: GiaoTeTiecTungRangeResult;
    try {
      const res = await fetch(`/api/giao-te-tiec-tung?year=${year}&month=${month}&timeZone=Asia/Ho_Chi_Minh`);
      result = await res.json();
    } catch {
      giaoTeListEl.innerHTML = '<p class="py-2 text-center text-sm text-slate-500">Không tải được dữ liệu.</p>';
      return;
    }

    giaoTeListEl.innerHTML = result.ngayXepHang
      .map((n, i) => {
        const ngayStr = `${String(n.solarDate.day).padStart(2, "0")}/${String(n.solarDate.month).padStart(2, "0")}/${n.solarDate.year}`;
        const goiYHtml = n.goiY ? `<p class="text-xs text-slate-500">${n.goiY}</p>` : "";
        const yeuToHtml = n.yeuTo
          .map((y) => {
            const dauCls = y.diem >= 0 ? "text-(--color-cinnabar-500)" : "text-slate-500";
            const dauStr = y.diem >= 0 ? `+${y.diem}` : `${y.diem}`;
            return `<li class="flex justify-between gap-2"><span>${y.ten}</span><span class="${dauCls} font-semibold">${dauStr}</span></li>`;
          })
          .join("");
        return `
          <div class="rounded-lg border border-slate-100">
            <button type="button" class="giao-te-row w-full px-3 py-2 text-left" data-idx="${i}">
              <p class="text-sm font-bold text-slate-900">${ngayStr}</p>
              <p class="text-sm">${HANG_ICON[n.hang]} ${n.nhan.replace(/^\S+\s/, "")} · ${n.diem}/10</p>
              ${goiYHtml}
            </button>
            <div class="giao-te-detail hidden border-t border-slate-100 px-3 py-2">
              <ul class="space-y-0.5 text-xs text-slate-600">${yeuToHtml}</ul>
            </div>
          </div>`;
      })
      .join("");

    giaoTeListEl.querySelectorAll<HTMLButtonElement>(".giao-te-row").forEach((btn) => {
      btn.addEventListener("click", () => {
        const detail = btn.nextElementSibling as HTMLElement;
        detail.classList.toggle("hidden");
      });
    });
  }

  // --- Ngày động phòng: chấm điểm riêng (khác Giao Tế Tiệc Tùng), có xét tuổi vợ chồng.
  const dongPhongListEl = document.getElementById("dong-phong-list")!;
  const dongPhongChiChongSelect = document.getElementById("dong-phong-chi-chong") as HTMLSelectElement;
  const dongPhongChiVoSelect = document.getElementById("dong-phong-chi-vo") as HTMLSelectElement;
  for (const chi of CHI_ORDER) {
    dongPhongChiChongSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">${chi}</option>`);
    dongPhongChiVoSelect.insertAdjacentHTML("beforeend", `<option value="${chi}">${chi}</option>`);
  }
  dongPhongChiChongSelect.addEventListener("change", () => loadDongPhong(calYear, calMonth));
  dongPhongChiVoSelect.addEventListener("change", () => loadDongPhong(calYear, calMonth));

  async function loadDongPhong(year: number, month: number) {
    dongPhongListEl.innerHTML = '<p class="py-2 text-center text-sm text-slate-500">Đang tính điểm...</p>';

    const chiChong = dongPhongChiChongSelect.value;
    const chiVo = dongPhongChiVoSelect.value;
    let qs = `year=${year}&month=${month}&timeZone=Asia/Ho_Chi_Minh`;
    if (chiChong) qs += `&chiChong=${encodeURIComponent(chiChong)}`;
    if (chiVo) qs += `&chiVo=${encodeURIComponent(chiVo)}`;

    let result: DongPhongRangeResult;
    try {
      const res = await fetch(`/api/dong-phong?${qs}`);
      result = await res.json();
    } catch {
      dongPhongListEl.innerHTML = '<p class="py-2 text-center text-sm text-slate-500">Không tải được dữ liệu.</p>';
      return;
    }

    dongPhongListEl.innerHTML = result.ngayXepHang
      .map((n, i) => {
        const ngayStr = `${String(n.solarDate.day).padStart(2, "0")}/${String(n.solarDate.month).padStart(2, "0")}/${n.solarDate.year}`;
        const totYeuTo = n.yeuTo.filter((y) => y.diem > 0);
        const xauYeuTo = n.yeuTo.filter((y) => y.diem < 0);
        const dsHtml = (list: GiaoTeTiecTungYeuTo[]) =>
          list.length > 0
            ? `<ul class="space-y-0.5">${list.map((y) => `<li>${y.ten} (${y.diem >= 0 ? "+" : ""}${y.diem})</li>`).join("")}</ul>`
            : '<p class="text-slate-400">Không có.</p>';
        const xungHopHtml =
          n.xungHopChong || n.xungHopVo
            ? `<div>
                <p class="font-semibold text-slate-700">Xung hợp:</p>
                ${n.xungHopChong ? `<p>Chồng (${n.xungHopChong.chi}): ${n.xungHopChong.moTa}</p>` : ""}
                ${n.xungHopVo ? `<p>Vợ (${n.xungHopVo.chi}): ${n.xungHopVo.moTa}</p>` : ""}
              </div>`
            : "";
        return `
          <div class="rounded-lg border border-slate-100">
            <button type="button" class="dong-phong-row w-full px-3 py-2 text-left" data-idx="${i}">
              <p class="text-sm font-bold text-slate-900">${ngayStr}</p>
              <p class="text-sm">${HANG_ICON[n.hang]} ${n.nhan.replace(/^\S+\s/, "")} · ${n.diem}/10</p>
            </button>
            <div class="dong-phong-detail hidden space-y-2 border-t border-slate-100 px-3 py-2 text-xs text-slate-600">
              <div>
                <p class="font-semibold text-slate-700">Tốt:</p>
                ${dsHtml(totYeuTo)}
              </div>
              <div>
                <p class="font-semibold text-slate-700">Bất lợi:</p>
                ${dsHtml(xauYeuTo)}
              </div>
              ${xungHopHtml}
              <p class="italic text-slate-500">Kết luận: ${n.nhan.replace(/^\S+\s/, "")} cho mục đích động phòng.</p>
            </div>
          </div>`;
      })
      .join("");

    dongPhongListEl.querySelectorAll<HTMLButtonElement>(".dong-phong-row").forEach((btn) => {
      btn.addEventListener("click", () => {
        const detail = btn.nextElementSibling as HTMLElement;
        detail.classList.toggle("hidden");
      });
    });
  }

  // --- Tuổi hợp làm ăn: nhập 2 năm sinh, tính 1 lần khi bấm nút — không phụ thuộc tháng đang xem trên lịch.
  interface TuoiHopTieuChi {
    diem: number;
    moTa: string;
  }
  interface TuoiHopLamAnResult {
    diem: number;
    hang: string;
    nhan: string;
    can: TuoiHopTieuChi;
    chi: TuoiHopTieuChi;
    menh: TuoiHopTieuChi;
    napAm: TuoiHopTieuChi;
    tongHop: TuoiHopTieuChi;
    ketLuan: string;
  }

  const tuoiHopForm = document.getElementById("tuoi-hop-lam-an-form") as HTMLFormElement;
  const tuoiHopNam1Input = document.getElementById("tuoi-hop-nam-1") as HTMLInputElement;
  const tuoiHopNam2Input = document.getElementById("tuoi-hop-nam-2") as HTMLInputElement;
  const tuoiHopLoiEl = document.getElementById("tuoi-hop-loi")!;
  const tuoiHopKetQuaEl = document.getElementById("tuoi-hop-ket-qua")!;
  const tuoiHopNhanEl = document.getElementById("tuoi-hop-nhan")!;
  const tuoiHopDiemEl = document.getElementById("tuoi-hop-diem")!;
  const tuoiHopChiTietEl = document.getElementById("tuoi-hop-chi-tiet")!;
  const tuoiHopToggleBtn = document.getElementById("tuoi-hop-toggle") as HTMLButtonElement;

  tuoiHopToggleBtn.addEventListener("click", () => {
    tuoiHopChiTietEl.classList.toggle("hidden");
  });

  tuoiHopForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    tuoiHopLoiEl.classList.add("hidden");
    tuoiHopKetQuaEl.classList.add("hidden");

    const namSinh1 = Number(tuoiHopNam1Input.value);
    const namSinh2 = Number(tuoiHopNam2Input.value);

    let result: TuoiHopLamAnResult;
    try {
      const res = await fetch(`/api/tuoi-hop-lam-an?namSinh1=${namSinh1}&namSinh2=${namSinh2}`);
      const data = await res.json();
      if (!res.ok) {
        tuoiHopLoiEl.textContent = data.error ?? "Không tính được.";
        tuoiHopLoiEl.classList.remove("hidden");
        return;
      }
      result = data;
    } catch {
      tuoiHopLoiEl.textContent = "Không tải được dữ liệu.";
      tuoiHopLoiEl.classList.remove("hidden");
      return;
    }

    tuoiHopNhanEl.textContent = `${namSinh1} × ${namSinh2} — ${result.nhan}`;
    tuoiHopDiemEl.textContent = `${result.diem}/10 điểm`;
    document.getElementById("tuoi-hop-can")!.textContent = result.can.moTa;
    document.getElementById("tuoi-hop-chi")!.textContent = result.chi.moTa;
    document.getElementById("tuoi-hop-menh")!.textContent = result.menh.moTa;
    document.getElementById("tuoi-hop-nap-am")!.textContent = result.napAm.moTa;
    document.getElementById("tuoi-hop-tong-hop")!.textContent = result.tongHop.moTa;
    document.getElementById("tuoi-hop-ket-luan")!.textContent = result.ketLuan;
    tuoiHopChiTietEl.classList.add("hidden");
    tuoiHopKetQuaEl.classList.remove("hidden");
  });

  calPrevBtn.addEventListener("click", () => {
    const m = calMonth === 1 ? 12 : calMonth - 1;
    const y = calMonth === 1 ? calYear - 1 : calYear;
    loadCalendarGrid(y, m);
  });
  calNextBtn.addEventListener("click", () => {
    const m = calMonth === 12 ? 1 : calMonth + 1;
    const y = calMonth === 12 ? calYear + 1 : calYear;
    loadCalendarGrid(y, m);
  });

  async function xemNgay(year: number, month: number, day: number) {
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    selectedYear = year;
    selectedMonth = month;
    selectedDay = day;
    highlightSelectedCell();

    let result: EngineResultLike;
    try {
      const res = await fetch(
        `/api/trach-nhat?year=${year}&month=${month}&day=${day}&timeZone=Asia/Ho_Chi_Minh`,
      );
      result = await res.json();
    } catch {
      loiEl.textContent = "Không thể kết nối tới máy chủ, thử lại sau.";
      loiEl.classList.remove("hidden");
      return;
    }

    if (!result.ok || !result.data) {
      const message = result.errors?.map((e) => e.message).join(" ") ?? "Ngày không hợp lệ.";
      loiEl.textContent = message;
      loiEl.classList.remove("hidden");
      return;
    }

    const data = result.data;

    document.getElementById("kq-ngay-duong")!.textContent =
      `${String(data.solarDate.day).padStart(2, "0")}/${String(data.solarDate.month).padStart(2, "0")}/${data.solarDate.year}`;
    document.getElementById("kq-ngay-am")!.textContent =
      `Âm lịch: ${data.lunarDate.day}/${data.lunarDate.month}${data.lunarDate.isLeapMonth ? " (nhuận)" : ""}/${data.lunarDate.year}`;

    document.getElementById("kq-tru-nam")!.innerHTML = canChiHtml(data.tuTru.nam.can, data.tuTru.nam.chi);
    document.getElementById("kq-tru-thang")!.innerHTML = canChiHtml(data.tuTru.thang.can, data.tuTru.thang.chi);
    document.getElementById("kq-tru-ngay")!.innerHTML = canChiHtml(data.tuTru.ngay.can, data.tuTru.ngay.chi);
    document.getElementById("kq-tiet-khi")!.textContent = data.tietKhi?.name ?? "—";

    document.getElementById("kq-truc")!.textContent = data.truc.name;
    tuBadgeEl.innerHTML = catHungBadge(data.nhiThapBatTu.name, data.nhiThapBatTu.catHung);
    document.getElementById("kq-hoang-hac-ngay")!.textContent = data.hoangDaoHacDaoNgay;

    thanSatEl.innerHTML =
      data.thanSat.length > 0
        ? data.thanSat.map((t) => catHungBadge(t.name, t.catHung)).join("")
        : '<span class="text-sm text-slate-500">Không có thần sát nào được ghi nhận trong dữ liệu hiện có cho ngày này.</span>';

    document.getElementById("kq-tuoi-xung")!.textContent =
      data.tuoiXungNgay.length > 0 ? `Tuổi ${data.tuoiXungNgay.join(", ")}` : "—";

    const ngayKyBadges: string[] = [];
    if (data.nguyetKy) ngayKyBadges.push(catHungBadge("Nguyệt Kỵ (Ngũ Quỷ)", "hung"));
    if (data.tamNuong) ngayKyBadges.push(catHungBadge("Tam Nương Sát", "hung"));
    if (data.duongCongKyNhat) ngayKyBadges.push(catHungBadge("Dương Công Kỵ Nhật", "hung"));
    if (data.satChu) ngayKyBadges.push(catHungBadge("Sát Chủ", "hung"));
    document.getElementById("kq-ngay-ky")!.innerHTML =
      ngayKyBadges.length > 0
        ? ngayKyBadges.join("")
        : '<span class="text-sm text-slate-500">Ngày này không phạm ngày kỵ đặc biệt nào trong dữ liệu hiện có.</span>';

    const kimThanWrap = document.getElementById("kq-kim-than-that-sat-wrap")!;
    if (data.canNamSinhKyKimThanThatSat.length > 0) {
      document.getElementById("kq-kim-than-that-sat")!.textContent =
        `Tuổi có Can ${data.canNamSinhKyKimThanThatSat.join(", ")}`;
      kimThanWrap.classList.remove("hidden");
    } else {
      kimThanWrap.classList.add("hidden");
    }

    document.getElementById("kq-kim-than-nam")!.textContent =
      data.chiNgayKyKimThanThatSatTheoNam.length > 0
        ? `Ngày Chi ${data.chiNgayKyKimThanThatSatTheoNam.join(", ")}`
        : "—";

    const tamTaiWrap = document.getElementById("kq-tam-tai-wrap")!;
    if (data.nhomTuoiPhamTamTai.length > 0) {
      document.getElementById("kq-tam-tai")!.textContent = data.nhomTuoiPhamTamTai
        .map((nhom) => `${nhom.join("-")}`)
        .join(" · ");
      tamTaiWrap.classList.remove("hidden");
    } else {
      tamTaiWrap.classList.add("hidden");
    }

    const bachKyWrap = document.getElementById("kq-bach-ky-wrap")!;
    if (data.bachKyNgay.length > 0) {
      document.getElementById("kq-bach-ky")!.textContent = data.bachKyNgay
        .map((b) => `Ngày ${b.nhan} ${b.viec}`)
        .join(" · ");
      bachKyWrap.classList.remove("hidden");
    } else {
      bachKyWrap.classList.add("hidden");
    }

    document.getElementById("kq-thai-tue-truc")!.textContent = data.phamThaiTue.tuoiPhamThaiTue;
    document.getElementById("kq-thai-tue-xung")!.textContent = data.phamThaiTue.tuoiXungThaiTue;
    document.getElementById("kq-thai-tue-hinh")!.textContent =
      data.phamThaiTue.tuoiHinhThaiTue.length > 0
        ? data.phamThaiTue.tuoiHinhThaiTue.join(", ")
        : data.phamThaiTue.namTuHinh
          ? `${data.phamThaiTue.namChi} (tự hình)`
          : "—";
    document.getElementById("kq-thai-tue-hai")!.textContent = data.phamThaiTue.tuoiHaiThaiTue;
    document.getElementById("kq-thai-tue-pha")!.textContent = data.phamThaiTue.tuoiPhaThaiTue;

    document.getElementById("kq-cat-toc-wrap")!.classList.toggle("hidden", !data.catTocDep);

    const thanSatThemBadges: string[] = [];
    if (data.thienDucHop) thanSatThemBadges.push(catHungBadge("Thiên Đức Hợp", "cát"));
    if (data.thienXa) thanSatThemBadges.push(catHungBadge("Thiên Xá", "cát"));
    document.getElementById("kq-than-sat-them-wrap")!.classList.toggle("hidden", thanSatThemBadges.length === 0);
    document.getElementById("kq-than-sat-them")!.innerHTML = thanSatThemBadges.join("");

    document.getElementById("kq-luc-nham")!.innerHTML = renderLucNham(data.gio12);

    gio12Body.innerHTML = data.gio12
      .map((g: GioTrongNgay) => {
        const chiIndex = CHI_ORDER.indexOf(g.chiGio);
        const khungGio = chiIndex === -1 ? "—" : CHI_KHUNG_GIO[chiIndex];
        return `
        <tr class="border-b border-slate-100">
          <td class="py-2 px-2 font-bold text-slate-900">${khungGio}</td>
          <td class="py-2 px-2 font-semibold">${canChiHtml(g.canChiGio.can, g.canChiGio.chi)}</td>
          <td class="py-2 px-2">${catHungBadge(g.tieuLucNhamGio.name, g.tieuLucNhamGio.catHung)}</td>
          <td class="py-2 px-2">${catHungBadge(g.hoangDaoHacDaoGio.name, g.hoangDaoHacDaoGio.catHung)}</td>
        </tr>`;
      })
      .join("");

    ketQuaEl.classList.remove("hidden");
    ketQuaEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  // 3 ô chọn Ngày/Tháng/Năm riêng biệt thay vì <input type="date"> — tránh input type="date"
  // hiển thị định dạng MM/DD (kiểu Mỹ) theo ngôn ngữ trình duyệt/hệ điều hành của người dùng,
  // gây nhầm ngày/tháng khi họ tưởng đang nhập theo DD/MM quen thuộc.
  function populateSelect(el: HTMLSelectElement, options: [number, string][]) {
    el.innerHTML = options.map(([v, l]) => `<option value="${v}">${l}</option>`).join("");
  }
  const DAY_OPTIONS: [number, string][] = Array.from({ length: 31 }, (_, i) => [i + 1, String(i + 1).padStart(2, "0")]);
  const MONTH_OPTIONS: [number, string][] = Array.from({ length: 12 }, (_, i) => [i + 1, `Tháng ${i + 1}`]);
  const nowYear = new Date().getFullYear();
  const YEAR_OPTIONS: [number, string][] = Array.from({ length: 11 }, (_, i) => nowYear - 5 + i).map((y) => [y, String(y)]);
  populateSelect(ngaySelect, DAY_OPTIONS);
  populateSelect(thangSelect, MONTH_OPTIONS);
  populateSelect(namSelect, YEAR_OPTIONS);

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const day = parseInt(ngaySelect.value, 10);
    const month = parseInt(thangSelect.value, 10);
    const year = parseInt(namSelect.value, 10);
    if (!year || !month || !day) return;
    xemNgay(year, month, day);
    if (month !== calMonth || year !== calYear) loadCalendarGrid(year, month);
  });

  // Mặc định hiển thị sẵn kết quả của hôm nay khi vào trang, người dùng vẫn đổi được ngày.
  const homNay = new Date();
  ngaySelect.value = String(homNay.getDate());
  thangSelect.value = String(homNay.getMonth() + 1);
  namSelect.value = String(homNay.getFullYear());
  selectedYear = homNay.getFullYear();
  selectedMonth = homNay.getMonth() + 1;
  selectedDay = homNay.getDate();
  loadCalendarGrid(selectedYear, selectedMonth);
  xemNgay(selectedYear, selectedMonth, selectedDay);

  // --- Tra cứu Nghi/Kỵ theo việc (tham khảo, độc lập với ngày đang xem — xem cảnh báo độ
  // tin cậy trong src/lib/dung-su-nghi-ky.ts).
  const dungSuSelect = document.getElementById("dung-su-select") as HTMLSelectElement;
  const dungSuKetQuaEl = document.getElementById("dung-su-ket-qua")!;

  function renderDungSu(entry: DungSuNghiKyEntry) {
    const nghiHtml = entry.nghiRaw
      ? `<p><span class="font-bold text-(--color-cinnabar-500)">Nghi:</span> ${entry.nghiRaw}</p>`
      : "";
    const kyHtml = entry.kyRaw
      ? `<p class="mt-1"><span class="font-bold text-slate-700">Kỵ:</span> ${entry.kyRaw}</p>`
      : "";
    const ghiChuHtml = entry.ghiChu
      ? `<p class="mt-2 text-xs italic text-slate-500">${entry.ghiChu}</p>`
      : "";
    dungSuKetQuaEl.innerHTML = `
      ${nghiHtml}
      ${kyHtml}
      ${ghiChuHtml}
      <p class="mt-2 text-xs text-slate-400">Nguồn: "Hiệp Kỷ Biện Phương Thư"</p>
    `;
  }

  fetch("/api/dung-su-nghi-ky")
    .then((res) => res.json())
    .then((list: DungSuNghiKyEntry[]) => {
      dungSuSelect.innerHTML = list.map((e, i) => `<option value="${i}">${e.ten}</option>`).join("");
      dungSuSelect.addEventListener("change", () => {
        const entry = list[Number(dungSuSelect.value)];
        if (entry) renderDungSu(entry);
      });
      if (list.length > 0) renderDungSu(list[0]!);
    })
    .catch(() => {
      dungSuKetQuaEl.innerHTML = '<p class="text-sm text-slate-500">Không tải được dữ liệu Nghi/Kỵ theo việc.</p>';
    });
</script>
