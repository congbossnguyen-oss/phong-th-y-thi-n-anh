---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;
import XemNgayTotXau from "../components/tools/XemNgayTotXau.astro";
import GoiYNangCap from "../components/ui/GoiYNangCap.astro";
---

<BaseLayout
  title="Xem ngày tốt xấu"
  description="Tra cứu Tứ Trụ, Âm lịch, Tiết Khí, Trực, Nhị Thập Bát Tú, Hoàng Đạo/Hắc Đạo và Tiểu Lục Nhâm theo từng giờ cho một ngày dương lịch bất kỳ — đầy đủ màu sắc Âm Dương Ngũ Hành."
>
  <PageHero
    eyebrow="Công cụ tra cứu"
    title="Xem ngày tốt xấu"
    description="Chọn một ngày dương lịch để xem đầy đủ thông tin Trạch Nhật: Tứ Trụ, Âm lịch, Tiết Khí, Trực, Nhị Thập Bát Tú, Hoàng Đạo/Hắc Đạo theo ngày và theo từng giờ."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Xem ngày tốt xấu" }]}
  />

  <XemNgayTotXau />

  <Container class="pb-12">
    <div class="mx-auto max-w-4xl">
      <GoiYNangCap slug="xem-ngay-cao-cap" lyDo="Công cụ trên chấm ngày theo lịch tiết khí và thần sát chung. Nếu là việc trọng đại (động thổ, nhập trạch), bản Cao Cấp soi thêm theo TỌA HƯỚNG NHÀ và MỆNH CHỦ — hai yếu tố khiến ngày đẹp với nhà này lại không đẹp với nhà khác." nhanNut="Xem Ngày Cao Cấp" tieuDe="Việc trọng đại nên xét kỹ hơn" />
    </div>
  </Container>
</BaseLayout>
