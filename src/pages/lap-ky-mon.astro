---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Lập Kỳ Môn Độn Giáp"
  description="Lập lá bàn Kỳ Môn Độn Giáp 9 cung theo giờ hiện tại, giờ sinh (Mệnh) hoặc nhập tay hoa giáp (1080) — kèm Tam Thắng và lịch tháng Kỳ Môn."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập Kỳ Môn Độn Giáp"
    description="Chọn chế độ Giờ (thời điểm hiện tại), Mệnh (giờ sinh) hoặc 1080 (nhập tay cục + hoa giáp) để lập lá bàn 9 cung."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập Kỳ Môn Độn Giáp" }]}
  />

  <Container class="py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Chọn chế độ -->
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Chế độ lập bàn">
        <button type="button" data-mode="gio" class="km-mode-btn" aria-selected="true">Giờ</button>
        <button type="button" data-mode="menh" class="km-mode-btn" aria-selected="false">Mệnh</button>
        <button type="button" data-mode="1080" class="km-mode-btn" aria-selected="false">1080</button>
      </div>
      <p id="km-mode-note" class="mt-2 text-xs text-(--color-ink-500)"></p>

      <!-- Form nhập theo lịch (Giờ / Mệnh) -->
      <form id="km-form-lich" class="mt-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
        <p id="km-form-lich-label" class="text-sm font-medium text-(--color-ink-800)">Thời điểm</p>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-5">
          <select id="km-ngay" aria-label="Ngày" class="km-select"></select>
          <select id="km-thang" aria-label="Tháng" class="km-select"></select>
          <select id="km-nam" aria-label="Năm" class="km-select"></select>
          <select id="km-gio" aria-label="Giờ" class="km-select"></select>
          <select id="km-phut" aria-label="Phút" class="km-select"></select>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-1.5">
          <span class="mr-1 text-xs text-(--color-ink-500)">Chỉnh nhanh:</span>
          <button type="button" data-adjust="H:-1" class="km-adjust-btn">−H</button>
          <button type="button" data-adjust="D:-1" class="km-adjust-btn">−D</button>
          <button type="button" data-adjust="M:-1" class="km-adjust-btn">−M</button>
          <button type="button" data-adjust="Y:-1" class="km-adjust-btn">−Y</button>
          <button type="button" data-adjust="Y:1" class="km-adjust-btn">+Y</button>
          <button type="button" data-adjust="M:1" class="km-adjust-btn">+M</button>
          <button type="button" data-adjust="D:1" class="km-adjust-btn">+D</button>
          <button type="button" data-adjust="H:1" class="km-adjust-btn">+H</button>
          <Button type="submit" size="md" class="ml-auto">Lập bàn</Button>
        </div>
      </form>

      <!-- Form nhập tay (1080) -->
      <form id="km-form-1080" class="mt-4 hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
        <p class="text-sm font-medium text-(--color-ink-800)">Nhập tay Cục · Âm Dương · Hoa Giáp</p>
        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-3">
          <select id="km-so-cuc" aria-label="Số Cục" class="km-select"></select>
          <select id="km-am-duong" aria-label="Âm/Dương" class="km-select">
            <option value="-">Âm Độn</option>
            <option value="+">Dương Độn</option>
          </select>
          <select id="km-hoa-giap" aria-label="Hoa Giáp" class="km-select"></select>
        </div>
        <Button type="submit" size="md" class="mt-3">Lập bàn</Button>
      </form>

      <div id="km-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <!-- Kết quả -->
      <div id="km-ket-qua" class="mt-8 hidden">
        <!-- Tứ trụ -->
        <div id="km-tu-tru-wrap">
          <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-300)">Tứ trụ</p>
          <div class="mt-2 grid grid-cols-4 gap-2 text-center">
            <div class="km-tru-cell"><p class="km-tru-label">Giờ</p><p id="km-tt-gio" class="km-tru-canchi"></p></div>
            <div class="km-tru-cell"><p class="km-tru-label">Ngày</p><p id="km-tt-ngay" class="km-tru-canchi"></p></div>
            <div class="km-tru-cell"><p class="km-tru-label">Tháng</p><p id="km-tt-thang" class="km-tru-canchi"></p></div>
            <div class="km-tru-cell"><p class="km-tru-label">Năm</p><p id="km-tt-nam" class="km-tru-canchi"></p></div>
          </div>
        </div>
        <p id="km-hoa-giap-line" class="hidden font-display text-lg font-semibold text-(--color-ink-950)"></p>

        <!-- Cục / Phù đầu tóm tắt -->
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-(--color-ink-700)">
          <span>Cục: <strong id="km-cuc" class="text-(--color-ink-950)"></strong></span>
          <span>Phù đầu: <strong id="km-phu-dau" class="text-(--color-ink-950)"></strong></span>
          <span>Trực Sử: <strong id="km-truc-su" class="text-(--color-ink-950)"></strong></span>
          <span>Trực Phù: <strong id="km-truc-phu" class="text-(--color-ink-950)"></strong></span>
        </div>

        <!-- Toggle Bảng Kỳ Môn / Bảng Cách Cục -->
        <div class="mt-5 flex gap-2">
          <button type="button" data-view="ban" class="km-view-btn" aria-selected="true">Bảng Kỳ Môn</button>
          <button type="button" data-view="cach-cuc" class="km-view-btn" aria-selected="false">Bảng Cách Cục</button>
        </div>

        <!-- Lưới 9 cung -->
        <div id="km-luoi-9-cung" class="km-grid-9 mt-4"></div>

        <!-- Bảng Cách Cục -->
        <div id="km-bang-cach-cuc" class="mt-4 hidden">
          <p class="mb-2 text-sm font-semibold text-(--color-cinnabar-400)">＋ Bảng Chi Tiết</p>
          <div class="km-table-frame overflow-x-auto">
            <table class="km-app-table">
              <thead>
                <tr><th>Loại</th><th>Mô Tả</th></tr>
              </thead>
              <tbody id="km-cach-cuc-body"></tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-(--color-ink-500)">
            Luận cách cục chi tiết (theo phương pháp/9 sao) — chưa làm, để bổ sung ở giai đoạn sau.
          </p>

          <!-- Lưu Ý (chú giải ký hiệu) — y như app -->
          <p class="mt-5 mb-2 text-sm font-semibold text-(--color-cinnabar-400)">＋ Lưu Ý</p>
          <div class="km-luuy">
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-key km-key-kv">KV</span>: Không Vong</span>
              <span class="km-luuy-item">🐴 : Mã</span>
              <span class="km-luuy-item">✝ : Mộ</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item">↗ : Môn bách</span>
              <span class="km-luuy-item">↙ : Cung bức</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item">↩ : Cung sinh môn</span>
              <span class="km-luuy-item">↪ : Môn sinh cung</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-key km-key-red">H</span>: Giờ</span>
              <span class="km-luuy-item"><span class="km-key km-key-red">D</span>: Ngày</span>
              <span class="km-luuy-item"><span class="km-key km-key-red">M</span>: Tháng</span>
              <span class="km-luuy-item"><span class="km-key km-key-red">Y</span>: Năm</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-red">V: Đế Vượng</span>
              <span class="km-luuy-red">T: Tướng</span>
            </div>
            <div class="km-luuy-row">
              <span>H: Hưu</span><span>T: Tù</span><span>P: Phế</span>
            </div>
          </div>
          <p class="mt-3 text-xs text-(--color-ink-500)">
            Các ký hiệu Mộ · mũi tên (Môn bách/Cung bức/Cung sinh môn/Môn sinh cung) · H/D/M/Y ·
            Vượng suy (V/T · H/T/P) trên từng cung <strong>chưa vẽ</strong> — đang chờ Công xác nhận
            quy tắc để tính đúng, không đoán.
          </p>
        </div>

        <!-- Sub-tab Mệnh / Tam Thắng / Lịch — chỉ hiện ở chế độ Mệnh -->
        <div id="km-subtabs-wrap" class="mt-8 hidden">
          <div class="flex flex-wrap gap-2 border-b border-(--color-ivory-300)">
            <button type="button" data-subtab="menh" class="km-subtab-btn" aria-selected="true">Mệnh</button>
            <button type="button" data-subtab="tam-thang" class="km-subtab-btn" aria-selected="false">Tam Thắng</button>
            <button type="button" data-subtab="lich" class="km-subtab-btn" aria-selected="false">Lịch</button>
          </div>

          <div id="km-subtab-menh" class="km-subtab-panel mt-4">
            <p class="text-sm text-(--color-ink-600)">
              Nhãn 12 cung Mệnh (Tài Bạch, Quan Lộc, Mệnh Cung...) và vòng tuổi đại vận (15→120) — chưa làm,
              đang chờ xác nhận quy luật khởi cung/chiều đi (xem README engine). Tạm để trống.
            </p>
          </div>

          <div id="km-subtab-tam-thang" class="km-subtab-panel mt-4 hidden">
            <p class="mb-2 flex items-center gap-1.5 text-base font-semibold text-(--color-cinnabar-400)">☯ Tam Thắng</p>
            <div class="km-table-frame overflow-x-auto">
              <table class="km-app-table">
                <thead>
                  <tr><th>Loại</th><th>Tên</th><th>Cung</th></tr>
                </thead>
                <tbody id="km-tam-thang-body"></tbody>
              </table>
            </div>
          </div>

          <div id="km-subtab-lich" class="km-subtab-panel mt-4 hidden">
            <div class="space-y-2">
              <p class="rounded-(--radius-control) border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 px-3 py-2 text-xs text-(--color-ink-700)">
                ⚠️ Mốc neo 28 Tú hiện là <strong>giá trị tạm</strong> (chưa đối chiếu app Kỳ Môn Pro) — có thể lệch.
              </p>
              <p class="rounded-(--radius-control) border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 px-3 py-2 text-xs text-(--color-ink-700)">
                ⚠️ Nhãn thắng cách (v1v2/v3) mỗi ngày dùng chế độ Ngày — công thức lập cục Nhật gia Kỳ Môn cho
                chế độ Ngày <strong>đang tạm ngưng</strong> (chưa đủ dữ liệu xác nhận), nên nhãn này cũng chưa chắc chắn.
              </p>
            </div>
            <div class="mt-4 flex items-center justify-between">
              <button type="button" id="km-lich-prev" aria-label="Tháng trước" class="km-adjust-btn">‹ Tháng trước</button>
              <p id="km-lich-title" class="font-display text-lg font-semibold text-(--color-ink-950)"></p>
              <button type="button" id="km-lich-next" aria-label="Tháng sau" class="km-adjust-btn">Tháng sau ›</button>
            </div>
            <div class="mt-3 overflow-x-auto">
              <div class="km-table-frame" style="min-width:560px">
                <table class="km-cal">
                  <thead>
                    <tr>
                      <th class="cn">C.Nhật</th><th>Thứ 2</th><th>Thứ 3</th><th>Thứ 4</th><th>Thứ 5</th><th>Thứ 6</th><th>Thứ 7</th>
                    </tr>
                  </thead>
                  <tbody id="km-lich-body"></tbody>
                </table>
              </div>
            </div>
            <p class="mt-2 text-xs text-(--color-ink-500)">Ô có khung đỏ = ngày có thắng cách (v1v2/v3). Mỗi ô: can-chi ngày · Kiến Trừ / Nhị Thập Bát Tú.</p>
          </div>
        </div>
      </div>

      <p class="mt-8 text-xs text-(--color-ink-500)">
        Ngày/Tháng/Năm tạm ngưng — 3 hệ lập cục riêng (Nhật gia/Nguyệt gia/Niên gia Kỳ Môn) chưa đủ dữ liệu mẫu
        để xác định công thức, tránh đoán bừa. Dữ liệu tham khảo, không thay thế tư vấn trực tiếp.
      </p>
    </div>
  </Container>
</BaseLayout>

<style is:global>
  /* is:global bắt buộc: lưới 9 cung / Tam Thắng / bảng Cách Cục / bảng Lịch đều được
     script phía dưới tạo bằng innerHTML lúc chạy — các phần tử đó không có thuộc tính
     data-astro-cid-* nên CSS "scoped" mặc định của Astro sẽ KHÔNG áp dụng, khiến toàn bộ
     khung/màu/viền các ô đó biến mất (chỉ còn chữ trần). */
  .km-mode-btn,
  .km-view-btn,
  .km-subtab-btn {
    border-radius: var(--radius-control);
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-700);
    background: var(--color-ivory-100);
    border: 1px solid var(--color-ivory-300);
    transition: all 0.15s ease;
  }
  .km-mode-btn[aria-selected="true"],
  .km-view-btn[aria-selected="true"] {
    background: var(--color-gold-400);
    color: var(--color-on-accent);
    border-color: var(--color-gold-400);
  }
  .km-subtab-btn {
    border-radius: var(--radius-control) var(--radius-control) 0 0;
    border-bottom: none;
    background: transparent;
  }
  .km-subtab-btn[aria-selected="true"] {
    background: var(--color-ivory-100);
    color: var(--color-gold-300);
    border-color: var(--color-ivory-300);
  }

  .km-select {
    width: 100%;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-50);
    color: var(--color-ink-800);
    padding: 0.55rem 0.6rem;
    font-size: 0.85rem;
  }
  .km-select:focus {
    outline: 2px solid color-mix(in srgb, var(--color-gold-400) 40%, transparent);
    border-color: var(--color-gold-400);
  }

  .km-adjust-btn {
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-50);
    color: var(--color-ink-700);
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .km-adjust-btn:hover {
    border-color: var(--color-gold-400);
    color: var(--color-gold-300);
  }

  .km-tru-cell {
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-100);
    padding: 0.5rem 0.25rem;
  }
  .km-tru-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
  }
  .km-tru-canchi {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink-950);
    line-height: 1.2;
  }

  /* ---- Lưới 9 cung theo phong cách app Kỳ Môn Pro: mỗi cung tô nền NGŨ HÀNH, nhãn hướng
        ở dải trên, nội dung trên nền trắng. Bảng dùng màu cố định (không theo theme site) —
        giống cách xem-ngay-tot-xau.astro render card kết quả nền trắng trên nền tối. ---- */
  .km-grid-9 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    background: #d9c9a4;
    padding: 3px;
    border-radius: 10px;
    overflow: hidden;
  }
  .km-cung {
    --nh: #9b9b9b;
    position: relative;
    background: var(--nh);
    display: flex;
    flex-direction: column;
    min-height: 132px;
  }
  .km-cung-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    padding: 0.2rem 0.4rem;
    color: #fff;
  }
  .km-cung-huong {
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .km-cung-so {
    flex: none;
    font-size: 0.62rem;
    font-weight: 700;
    opacity: 0.85;
  }
  /* Thân cung: bố cục 3 cột như app — hàng trên [thiên can | sao | thần], giữa [số địa bàn],
     hàng dưới [địa can | môn]. Nhãn KV/Mã/Trực Phù/Trực Sử nằm cạnh trái ô số. */
  .km-cung-inner {
    flex: 1;
    margin: 0 3px 3px;
    background: #fffdf8;
    border-radius: 3px;
    padding: 0.28rem 0.32rem 0.26rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    color: #2a1512;
  }
  .km-cung-r1,
  .km-cung-r2 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    column-gap: 2px;
  }
  .cc-can { font-size: 0.7rem; font-weight: 600; color: #3a2620; text-align: left; }
  .cc-sao {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: #1f120e;
    text-align: center;
    line-height: 1;
  }
  .cc-than { font-size: 0.62rem; color: #b8322a; text-align: right; line-height: 1.05; }
  .km-cung-mid { position: relative; display: flex; align-items: center; justify-content: center; }
  .cc-so { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: #1f120e; }
  .km-cung-marks {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .km-cung-r2 { align-items: end; }
  .cc-diacan { font-size: 0.7rem; font-weight: 600; color: #3a2620; text-align: left; }
  .cc-mon {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    color: #b8322a;
    text-align: center;
  }
  .km-cung-trung-note {
    grid-column: 1 / -1;
    font-size: 0.56rem;
    font-style: italic;
    color: #9a8a78;
    text-align: center;
    line-height: 1.1;
  }
  .km-badge {
    border-radius: var(--radius-pill);
    padding: 0.04rem 0.34rem;
    font-size: 0.56rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .km-badge-kv { background: #6b5b4b; color: #fff; }
  .km-badge-ma { background: #e0a422; color: #3a2600; }
  .km-badge-tp { background: #c0261e; color: #fff; }
  .km-badge-ts { background: #e07b34; color: #fff; }

  /* Mục Lưu Ý (chú giải ký hiệu) — dưới Bảng Chi Tiết, phong cách app. */
  .km-luuy { font-size: 0.84rem; color: #3a2620; }
  .km-luuy-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.1rem; margin-bottom: 0.55rem; }
  .km-luuy-item { display: inline-flex; align-items: center; gap: 0.3rem; }
  .km-key {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 1.3rem; height: 1.3rem; padding: 0 0.25rem;
    border-radius: 5px; font-size: 0.72rem; font-weight: 800; line-height: 1;
  }
  .km-key-kv { border-radius: 999px; background: #6b5b4b; color: #fff; }
  .km-key-red { background: #f28b82; color: #fff; }
  .km-luuy-red { color: #c0261e; font-weight: 700; }

  /* ---- Bảng dạng app (Tam Thắng, Cách Cục, Lịch): header đỏ, thân nền hồng nhạt ---- */
  .km-app-table {
    width: 100%;
    border-collapse: collapse;
    background: #fffdf8;
    color: #2a1512;
    font-size: 0.86rem;
  }
  .km-app-table thead th {
    background: #c0261e;
    color: #fff;
    font-weight: 700;
    padding: 0.6rem 0.5rem;
    text-align: center;
    border: 1px solid #d97b74;
  }
  .km-app-table tbody td,
  .km-app-table tbody th {
    padding: 0.55rem 0.5rem;
    text-align: center;
    border: 1px solid #f0d3d0;
  }
  .km-app-table tbody tr:nth-child(even) { background: #fdeeed; }
  .km-app-table .km-tt-loai {
    font-weight: 800;
    color: #b8322a;
    text-decoration: underline;
  }
  .km-app-table .km-cc-key {
    font-weight: 700;
    color: #4a2a25;
  }
  .km-table-frame {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e6cfcc;
  }

  /* ---- Lịch tháng dạng lưới 7 cột (C.Nhật … Thứ 7) ---- */
  .km-cal {
    width: 100%;
    border-collapse: collapse;
    background: #fffdf8;
    color: #2a1512;
    table-layout: fixed;
  }
  .km-cal thead th {
    background: #c0261e;
    color: #fff;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.5rem 0.2rem;
    border: 1px solid #d97b74;
  }
  .km-cal thead th.cn { color: #ffe08a; }
  .km-cal td {
    border: 1px solid #f0d3d0;
    vertical-align: top;
    height: 74px;
    padding: 0.2rem 0.15rem;
    font-size: 0.64rem;
    line-height: 1.25;
  }
  .km-cal td.trong { background: #faf5ee; }
  .km-cal .cal-ngay { font-weight: 800; font-size: 0.82rem; color: #1f120e; }
  .km-cal .cal-cn .cal-ngay { color: #c0261e; }
  .km-cal .cal-canchi { font-weight: 600; color: #3a2620; }
  .km-cal .cal-kien { color: #b8322a; font-weight: 700; }
  .km-cal .cal-tu { color: #6b5a4a; }
  .km-cal .cal-thang-cach {
    display: inline-block;
    margin-top: 0.12rem;
    border: 1px solid #c0261e;
    border-radius: 3px;
    padding: 0 0.25rem;
    color: #b8322a;
    font-weight: 700;
    font-size: 0.6rem;
  }
</style>

<script>
  interface CungInfo {
    soCung: number;
    huong: string;
    saoThienBan: string;
    mon: string;
    than: string;
    thienBanCan: string;
    diaBanCan: string;
    diaChi: string[];
    KV: boolean;
    Ma: boolean;
  }

  interface CanChiPillar {
    can: string;
    chi: string;
  }

  interface LapLaBanResult {
    cheDo: string;
    tuTru: { gio?: CanChiPillar; ngay?: CanChiPillar; thang?: CanChiPillar; nam?: CanChiPillar };
    cuc: number;
    amDuong: "+" | "-";
    phuDau: string;
    trucPhu: string;
    trucPhuCung: number;
    trucSu: string;
    trucSuCung: number;
    cungList: CungInfo[];
  }

  interface HangTamThang {
    loai: string;
    ten: string;
    huong: string;
    soCung: number;
  }

  interface LapLaBanApiResponse {
    laBan?: LapLaBanResult;
    tamThang?: HangTamThang[];
    error?: string;
  }

  interface NgayLichKyMon {
    ngayDuong: number;
    can: string;
    chi: string;
    thangCan: string;
    thangChi: string;
    kienTru: string;
    tu: string;
    nhanThangCach?: string;
  }

  // Tên môn/sao/thần ĐẦY ĐỦ (dữ liệu km_core_tables.json dùng viết tắt như "T.Tâm", "C.Thiên" —
  // đổi sang tên đầy đủ cho dễ đọc trên giao diện).
  const TEN_MON: Record<string, string> = {
    HƯU: "Hưu", TỬ: "Tử", THƯƠNG: "Thương", ĐỖ: "Đỗ", CẢNH: "Cảnh", SINH: "Sinh", KINH: "Kinh", KHAI: "Khai",
  };
  const TEN_SAO: Record<string, string> = {
    "T.Bồng": "Thiên Bồng", "T.Nhuế": "Thiên Nhuế", "T.Xung": "Thiên Xung", "T.Phò": "Thiên Phụ",
    "T.Tâm": "Thiên Tâm", "T.Trụ": "Thiên Trụ", "T.Nhậm": "Thiên Nhậm", "T.Anh": "Thiên Anh",
  };
  const TEN_THAN: Record<string, string> = {
    "T.Phù": "Trực Phù", "Đ.Xà": "Đằng Xà", "T.Âm": "Thái Âm", "L.Hợp": "Lục Hợp",
    "C.Trận": "Câu Trận", "C.Tước": "Chu Tước", "B.Hổ": "Bạch Hổ", "H.Vũ": "Huyền Vũ",
    "C.Địa": "Cửu Địa", "C.Thiên": "Cửu Thiên",
  };
  // Tên sao viết TẮT (bỏ chữ "Thiên") cho ô cung nhỏ — giống app hiển thị "Tâm", "Bồng"...
  const SAO_NGAN: Record<string, string> = {
    "T.Bồng": "Bồng", "T.Nhuế": "Nhuế", "T.Xung": "Xung", "T.Phò": "Phụ",
    "T.Tâm": "Tâm", "T.Trụ": "Trụ", "T.Nhậm": "Nhậm", "T.Anh": "Anh",
  };
  // Số ĐỊA BÀN mỗi cung = Lường Thiên Xích: khởi số CỤC ở Trung cung (Lạc Thư 5) rồi phi THUẬN
  // qua các cung (5→6→7→8→9→1→2→3→4), tăng dần 1. Đã đối chiếu khớp 9/9 ô với ảnh app (cục 1:
  // Trung=1, Càn=2, Đoài=3, Cấn=4, Ly=5, Khảm=6, Khôn=7, Chấn=8, Tốn=9).
  function soDiaBan(soCung: number, cuc: number): number {
    const flyIndex = (soCung + 4) % 9; // vị trí trên đường phi thuận, Trung(5)=0
    return ((cuc - 1 + flyIndex) % 9) + 1;
  }
  // Ngũ hành theo cung Lạc Thư — tô nền dải hướng mỗi cung (bộ màu theo app Kỳ Môn Pro:
  // Mộc xanh lá, Hỏa đỏ, Thổ vàng, Kim xám, Thủy xanh dương).
  const NGU_HANH_CUNG: Record<number, string> = {
    1: "#2b7fc3", 2: "#e0a41f", 3: "#17974a", 4: "#17974a", 5: "#e0a41f",
    6: "#9b9b9b", 7: "#9b9b9b", 8: "#e0a41f", 9: "#e0362a",
  };
  // Thứ tự hiển thị lưới 3x3: Tốn-Ly-Khôn / Chấn-Trung-Đoài / Cấn-Khảm-Càn (đúng bố cục app).
  const LUOI_THU_TU = [4, 9, 2, 3, 5, 7, 8, 1, 6];

  function tenDayDu(map: Record<string, string>, key: string): string {
    return map[key] ?? key;
  }

  // ---------- Chọn chế độ ----------
  const modeBtns = document.querySelectorAll<HTMLButtonElement>(".km-mode-btn");
  const formLich = document.getElementById("km-form-lich") as HTMLFormElement;
  const formLabelEl = document.getElementById("km-form-lich-label")!;
  const form1080 = document.getElementById("km-form-1080") as HTMLFormElement;
  const modeNoteEl = document.getElementById("km-mode-note")!;
  let cheDoHienTai: "gio" | "menh" | "1080" = "gio";

  const MODE_NOTE: Record<string, string> = {
    gio: "Lập bàn theo thời điểm nhập (mặc định giờ hiện tại).",
    menh: "Lập bàn theo giờ SINH — bàn 9 cung tính y hệt chế độ Giờ, chỉ khác ý nghĩa thời điểm nhập.",
    "1080": "Nhập tay số Cục, Âm/Dương và 1 trong 60 Hoa Giáp — bỏ qua tra lịch, dùng cho bốc thẻ hoa giáp.",
  };

  function chonCheDo(cheDo: "gio" | "menh" | "1080") {
    cheDoHienTai = cheDo;
    modeBtns.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.mode === cheDo)));
    formLich.classList.toggle("hidden", cheDo === "1080");
    form1080.classList.toggle("hidden", cheDo !== "1080");
    formLabelEl.textContent = cheDo === "menh" ? "Ngày giờ SINH" : "Thời điểm hiện tại";
    modeNoteEl.textContent = MODE_NOTE[cheDo];
    document.getElementById("km-subtabs-wrap")!.classList.toggle("hidden", cheDo !== "menh");
  }

  modeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      chonCheDo(btn.dataset.mode as "gio" | "menh" | "1080");
      if (cheDoHienTai === "1080") layBan1080();
      else layBanLich();
    });
  });

  // ---------- Điền các ô chọn ngày giờ ----------
  function populateSelect(el: HTMLSelectElement, options: [number | string, string][]) {
    el.innerHTML = options.map(([v, l]) => `<option value="${v}">${l}</option>`).join("");
  }
  const ngaySel = document.getElementById("km-ngay") as HTMLSelectElement;
  const thangSel = document.getElementById("km-thang") as HTMLSelectElement;
  const namSel = document.getElementById("km-nam") as HTMLSelectElement;
  const gioSel = document.getElementById("km-gio") as HTMLSelectElement;
  const phutSel = document.getElementById("km-phut") as HTMLSelectElement;

  populateSelect(ngaySel, Array.from({ length: 31 }, (_, i) => [i + 1, String(i + 1).padStart(2, "0")]));
  populateSelect(thangSel, Array.from({ length: 12 }, (_, i) => [i + 1, `Tháng ${i + 1}`]));
  const nowYear = new Date().getFullYear();
  populateSelect(namSel, Array.from({ length: 21 }, (_, i) => nowYear - 10 + i).map((y) => [y, String(y)]));
  populateSelect(gioSel, Array.from({ length: 24 }, (_, i) => [i, `${String(i).padStart(2, "0")}h`]));
  populateSelect(phutSel, Array.from({ length: 60 }, (_, i) => [i, String(i).padStart(2, "0")]));

  function datVaoForm(d: Date) {
    ngaySel.value = String(d.getDate());
    thangSel.value = String(d.getMonth() + 1);
    namSel.value = String(d.getFullYear());
    gioSel.value = String(d.getHours());
    phutSel.value = String(d.getMinutes());
  }
  function docTuForm(): Date {
    return new Date(
      Number(namSel.value),
      Number(thangSel.value) - 1,
      Number(ngaySel.value),
      Number(gioSel.value),
      Number(phutSel.value),
    );
  }

  document.querySelectorAll<HTMLButtonElement>("[data-adjust]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const [don, soRaw] = (btn.dataset.adjust ?? "").split(":");
      const so = Number(soRaw);
      const d = docTuForm();
      if (don === "H") d.setHours(d.getHours() + so);
      if (don === "D") d.setDate(d.getDate() + so);
      if (don === "M") d.setMonth(d.getMonth() + so);
      if (don === "Y") d.setFullYear(d.getFullYear() + so);
      datVaoForm(d);
      layBanLich();
    });
  });

  // ---------- Chọn cục / hoa giáp (1080) ----------
  const soCucSel = document.getElementById("km-so-cuc") as HTMLSelectElement;
  populateSelect(soCucSel, Array.from({ length: 9 }, (_, i) => [i + 1, `Cục ${i + 1}`]));
  const amDuongSel = document.getElementById("km-am-duong") as HTMLSelectElement;
  const hoaGiapSel = document.getElementById("km-hoa-giap") as HTMLSelectElement;
  const CAN_60 = ["Giáp", "Ất", "Bính", "Đinh", "Mậu", "Kỷ", "Canh", "Tân", "Nhâm", "Quý"];
  const CHI_60 = ["Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ", "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"];
  const HOA_GIAP_60: string[] = Array.from({ length: 60 }, (_, i) => `${CAN_60[i % 10]} ${CHI_60[i % 12]}`);
  populateSelect(hoaGiapSel, HOA_GIAP_60.map((t) => [t, t]));

  // ---------- Gọi API + render ----------
  const loiEl = document.getElementById("km-loi")!;
  const ketQuaEl = document.getElementById("km-ket-qua")!;

  async function layBanLich() {
    const d = docTuForm();
    const qs = `cheDo=${cheDoHienTai}&nam=${d.getFullYear()}&thang=${d.getMonth() + 1}&ngay=${d.getDate()}&gio=${d.getHours()}&phut=${d.getMinutes()}`;
    await goiVaVe(qs, false);
  }
  async function layBan1080() {
    const qs = `cheDo=1080&soCuc=${soCucSel.value}&amDuong=${encodeURIComponent(amDuongSel.value)}&hoaGiap=${encodeURIComponent(hoaGiapSel.value)}`;
    await goiVaVe(qs, true);
  }

  // Chống race condition: đổi chế độ/chỉnh nhanh liên tiếp có thể bắn nhiều request cùng lúc,
  // phản hồi có thể về KHÔNG theo đúng thứ tự gửi đi (đặc biệt khi đổi chế độ rồi sửa input
  // ngay lập tức). Chỉ áp dụng kết quả của request MỚI NHẤT đã gửi, bỏ qua phản hồi cũ về muộn.
  let yeuCauMoiNhat = 0;

  async function goiVaVe(qs: string, la1080: boolean) {
    const idYeuCau = ++yeuCauMoiNhat;
    loiEl.classList.add("hidden");
    let res: LapLaBanApiResponse;
    try {
      const r = await fetch(`/api/kymon-lap-la-ban?${qs}`);
      res = await r.json();
    } catch {
      if (idYeuCau !== yeuCauMoiNhat) return;
      loiEl.textContent = "Không thể kết nối tới máy chủ, thử lại sau.";
      loiEl.classList.remove("hidden");
      ketQuaEl.classList.add("hidden");
      return;
    }
    if (idYeuCau !== yeuCauMoiNhat) return; // có request mới hơn đã gửi đi, bỏ qua kết quả cũ này
    if (res.error || !res.laBan) {
      loiEl.textContent = res.error ?? "Không lập được lá bàn.";
      loiEl.classList.remove("hidden");
      ketQuaEl.classList.add("hidden");
      return;
    }
    renderLaBan(res.laBan, res.tamThang ?? [], la1080);
    ketQuaEl.classList.remove("hidden");
  }

  function canChiText(p?: CanChiPillar): string {
    return p ? `${p.can}\n${p.chi}` : "—";
  }

  function renderLaBan(laBan: LapLaBanResult, tamThang: HangTamThang[], la1080: boolean) {
    document.getElementById("km-tu-tru-wrap")!.classList.toggle("hidden", la1080);
    const hoaGiapLine = document.getElementById("km-hoa-giap-line")!;
    if (la1080) {
      hoaGiapLine.textContent = `Hoa giáp: ${hoaGiapSel.value} · Cục ${laBan.cuc} ${laBan.amDuong === "-" ? "Âm" : "Dương"}`;
      hoaGiapLine.classList.remove("hidden");
    } else {
      hoaGiapLine.classList.add("hidden");
      document.getElementById("km-tt-gio")!.innerHTML = canChiText(laBan.tuTru.gio).replace("\n", "<br>");
      document.getElementById("km-tt-ngay")!.innerHTML = canChiText(laBan.tuTru.ngay).replace("\n", "<br>");
      document.getElementById("km-tt-thang")!.innerHTML = canChiText(laBan.tuTru.thang).replace("\n", "<br>");
      document.getElementById("km-tt-nam")!.innerHTML = canChiText(laBan.tuTru.nam).replace("\n", "<br>");
    }

    document.getElementById("km-cuc")!.textContent = `${laBan.amDuong === "-" ? "Âm" : "Dương"} ${laBan.cuc}`;
    document.getElementById("km-phu-dau")!.textContent = laBan.phuDau;
    document.getElementById("km-truc-su")!.textContent = `${tenDayDu(TEN_MON, laBan.trucSu)} môn`;
    document.getElementById("km-truc-phu")!.textContent = tenDayDu(TEN_SAO, laBan.trucPhu);

    // Lưới 9 cung
    const cungMap = new Map(laBan.cungList.map((c) => [c.soCung, c]));
    const luoiEl = document.getElementById("km-luoi-9-cung")!;
    luoiEl.innerHTML = LUOI_THU_TU.map((soCung) => {
      const c = cungMap.get(soCung);
      if (!c) return "";
      const badges: string[] = [];
      if (c.KV) badges.push('<span class="km-badge km-badge-kv">KV</span>');
      if (c.Ma) badges.push('<span class="km-badge km-badge-ma">Mã</span>');
      if (soCung === laBan.trucPhuCung) badges.push('<span class="km-badge km-badge-tp">Trực Phù</span>');
      if (soCung === laBan.trucSuCung) badges.push('<span class="km-badge km-badge-ts">Trực Sử</span>');
      const trungNote =
        soCung === 5
          ? '<p class="km-cung-trung-note">Trung cung — nhãn đặc biệt (Phản Ngâm...) chưa tính</p>'
          : "";
      const marks = `<div class="km-cung-marks">${badges.join("")}</div>`;
      return `
        <div class="km-cung" style="--nh:${NGU_HANH_CUNG[soCung]}">
          <div class="km-cung-head">
            <span class="km-cung-huong">${c.huong}</span>
          </div>
          <div class="km-cung-inner">
            <div class="km-cung-r1">
              <span class="cc-can">${c.thienBanCan}</span>
              <span class="cc-sao">${tenDayDu(SAO_NGAN, c.saoThienBan)}</span>
              <span class="cc-than">${tenDayDu(TEN_THAN, c.than)}</span>
            </div>
            <div class="km-cung-mid">
              ${marks}
              <span class="cc-so">${soDiaBan(soCung, laBan.cuc)}</span>
            </div>
            <div class="km-cung-r2">
              <span class="cc-diacan">${c.diaBanCan}</span>
              <span class="cc-mon">${tenDayDu(TEN_MON, c.mon)}</span>
              <span></span>
            </div>
            ${trungNote}
          </div>
        </div>`;
    }).join("");

    // Bảng Chi Tiết — đúng các dòng như app. "Phương Pháp: Trí Nhuận" và "Cửu Tinh: Chuyển Bàn"
    // là hằng số của phương pháp engine đang dùng (định cục theo lịch tra sẵn + bày sao xoay bàn).
    const rows: [string, string][] = [
      ["Bảng cách cục", `${laBan.amDuong === "-" ? "Âm" : "Dương"} ${laBan.cuc}`],
      ["Phù Đầu", laBan.phuDau],
      ["Trực Sử", tenDayDu(TEN_MON, laBan.trucSu)],
      ["Trực Phù", tenDayDu(SAO_NGAN, laBan.trucPhu)],
      ["Phương Pháp", "Trí Nhuận"],
      ["Cửu Tinh", "Chuyển Bàn"],
    ];
    document.getElementById("km-cach-cuc-body")!.innerHTML = rows
      .map(([k, v]) => `<tr><td class="km-cc-key">${k}</td><td>${v}</td></tr>`)
      .join("");

    // Tam Thắng — bảng header đỏ (Loại / Tên / Cung) như app.
    document.getElementById("km-tam-thang-body")!.innerHTML = tamThang.length
      ? tamThang
          .map(
            (h) =>
              `<tr><td class="km-tt-loai">${h.loai}</td><td>${h.ten}</td><td>${h.huong}</td></tr>`,
          )
          .join("")
      : '<tr><td colspan="3" style="padding:0.75rem;color:#7a6a5a">Không có thắng cách nào trên lá bàn này.</td></tr>';
  }

  // ---------- Toggle Bảng Kỳ Môn / Bảng Cách Cục ----------
  document.querySelectorAll<HTMLButtonElement>(".km-view-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>(".km-view-btn").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      document.getElementById("km-luoi-9-cung")!.classList.toggle("hidden", btn.dataset.view !== "ban");
      document.getElementById("km-bang-cach-cuc")!.classList.toggle("hidden", btn.dataset.view !== "cach-cuc");
    });
  });

  // ---------- Sub-tabs (Mệnh) ----------
  document.querySelectorAll<HTMLButtonElement>(".km-subtab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>(".km-subtab-btn").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      document.querySelectorAll<HTMLElement>(".km-subtab-panel").forEach((p) => p.classList.add("hidden"));
      document.getElementById(`km-subtab-${btn.dataset.subtab}`)!.classList.remove("hidden");
      if (btn.dataset.subtab === "lich") taiLichThang(lichNam, lichThang);
    });
  });

  // ---------- Tab Lịch ----------
  const THANG_LABEL = ["", "Một", "Hai", "Ba", "Tư", "Năm", "Sáu", "Bảy", "Tám", "Chín", "Mười", "Mười Một", "Mười Hai"];
  let lichNam = new Date().getFullYear();
  let lichThang = new Date().getMonth() + 1;

  async function taiLichThang(nam: number, thang: number) {
    lichNam = nam;
    lichThang = thang;
    document.getElementById("km-lich-title")!.textContent = `Tháng ${String(thang).padStart(2, "0")} năm ${nam}`;
    const body = document.getElementById("km-lich-body")!;
    body.innerHTML = '<tr><td colspan="7" style="padding:1rem;text-align:center;color:#7a6a5a">Đang tải...</td></tr>';
    try {
      const r = await fetch(`/api/kymon-lich?nam=${nam}&thang=${thang}`);
      const data: { ngayList?: NgayLichKyMon[]; error?: string } = await r.json();
      if (data.error || !data.ngayList) {
        body.innerHTML = `<tr><td colspan="7" style="padding:1rem;text-align:center;color:#c0261e">${data.error ?? "Lỗi tải lịch."}</td></tr>`;
        return;
      }
      // Lưới 7 cột: cột 0 = Chủ Nhật. Chèn ô trống trước ngày 1 cho khớp thứ trong tuần.
      const byNgay = new Map(data.ngayList.map((n) => [n.ngayDuong, n]));
      const soNgay = data.ngayList.length;
      const thu1 = new Date(nam, thang - 1, 1).getDay(); // 0=CN..6=T7
      const oCell = (n: NgayLichKyMon | null): string => {
        if (!n) return '<td class="trong"></td>';
        const cn = new Date(nam, thang - 1, n.ngayDuong).getDay() === 0 ? "cal-cn" : "";
        const nhan = n.nhanThangCach
          ? `<div><span class="cal-thang-cach">${n.nhanThangCach}</span></div>`
          : "";
        return `<td class="${cn}">
          <div class="cal-ngay">${String(n.ngayDuong).padStart(2, "0")}</div>
          <div class="cal-canchi">${n.can}${n.chi}</div>
          <div><span class="cal-kien">${n.kienTru}</span><span class="cal-tu">/${n.tu}</span></div>
          ${nhan}
        </td>`;
      };
      let html = "";
      let day = 1;
      for (let week = 0; day <= soNgay || week === 0; week++) {
        let row = "<tr>";
        for (let col = 0; col < 7; col++) {
          if (week === 0 && col < thu1) row += oCell(null);
          else if (day > soNgay) row += oCell(null);
          else row += oCell(byNgay.get(day++) ?? null);
        }
        row += "</tr>";
        html += row;
        if (day > soNgay) break;
      }
      body.innerHTML = html;
    } catch {
      body.innerHTML = '<tr><td colspan="7" style="padding:1rem;text-align:center;color:#c0261e">Không tải được lịch tháng.</td></tr>';
    }
  }

  document.getElementById("km-lich-prev")!.addEventListener("click", () => {
    const m = lichThang === 1 ? 12 : lichThang - 1;
    const y = lichThang === 1 ? lichNam - 1 : lichNam;
    taiLichThang(y, m);
  });
  document.getElementById("km-lich-next")!.addEventListener("click", () => {
    const m = lichThang === 12 ? 1 : lichThang + 1;
    const y = lichThang === 12 ? lichNam + 1 : lichNam;
    taiLichThang(y, m);
  });

  // ---------- Submit form ----------
  formLich.addEventListener("submit", (e) => {
    e.preventDefault();
    layBanLich();
  });
  form1080.addEventListener("submit", (e) => {
    e.preventDefault();
    layBan1080();
  });

  // ---------- Khởi động: mặc định giờ hiện tại, chế độ Giờ ----------
  datVaoForm(new Date());
  chonCheDo("gio");
  layBanLich();
</script>
