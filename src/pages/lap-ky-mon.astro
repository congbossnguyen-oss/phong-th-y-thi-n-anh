---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Lập Kỳ Môn Độn Giáp"
  description="Lập lá bàn Kỳ Môn Độn Giáp 9 cung theo giờ hiện tại, giờ sinh (Mệnh) hoặc nhập tay hoa giáp (1080) — kèm Tam Thắng và lịch tháng Kỳ Môn."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập Kỳ Môn Độn Giáp"
    description="Chọn chế độ Giờ (thời điểm hiện tại), Mệnh (giờ sinh) hoặc 1080 (nhập tay cục + hoa giáp) để lập lá bàn 9 cung."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập Kỳ Môn Độn Giáp" }]}
  />

  <Container class="py-12">
    <div class="mx-auto max-w-4xl">
      <!-- Chọn chế độ -->
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Chế độ lập bàn">
        <button type="button" data-mode="gio" class="km-mode-btn" aria-selected="true">Giờ</button>
        <button type="button" data-mode="menh" class="km-mode-btn" aria-selected="false">Mệnh</button>
        <button type="button" data-mode="1080" class="km-mode-btn" aria-selected="false">1080</button>
      </div>
      <p id="km-mode-note" class="mt-2 text-xs text-(--color-ink-500)"></p>

      <!-- Form nhập theo lịch (Giờ / Mệnh) -->
      <form id="km-form-lich" class="mt-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
        <p id="km-form-lich-label" class="text-sm font-medium text-(--color-ink-800)">Thời điểm</p>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-5">
          <select id="km-ngay" aria-label="Ngày" class="km-select"></select>
          <select id="km-thang" aria-label="Tháng" class="km-select"></select>
          <select id="km-nam" aria-label="Năm" class="km-select"></select>
          <select id="km-gio" aria-label="Giờ" class="km-select"></select>
          <select id="km-phut" aria-label="Phút" class="km-select"></select>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-1.5">
          <span class="mr-1 text-xs text-(--color-ink-500)">Chỉnh nhanh:</span>
          <button type="button" data-adjust="H:-1" class="km-adjust-btn">−H</button>
          <button type="button" data-adjust="D:-1" class="km-adjust-btn">−D</button>
          <button type="button" data-adjust="M:-1" class="km-adjust-btn">−M</button>
          <button type="button" data-adjust="Y:-1" class="km-adjust-btn">−Y</button>
          <button type="button" data-adjust="Y:1" class="km-adjust-btn">+Y</button>
          <button type="button" data-adjust="M:1" class="km-adjust-btn">+M</button>
          <button type="button" data-adjust="D:1" class="km-adjust-btn">+D</button>
          <button type="button" data-adjust="H:1" class="km-adjust-btn">+H</button>
          <Button type="submit" size="md" class="ml-auto">Lập bàn</Button>
        </div>
      </form>

      <!-- Form nhập tay (1080) -->
      <form id="km-form-1080" class="mt-4 hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
        <p class="text-sm font-medium text-(--color-ink-800)">Nhập tay Cục · Âm Dương · Hoa Giáp</p>
        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-3">
          <select id="km-so-cuc" aria-label="Số Cục" class="km-select"></select>
          <select id="km-am-duong" aria-label="Âm/Dương" class="km-select">
            <option value="-">Âm Độn</option>
            <option value="+">Dương Độn</option>
          </select>
          <select id="km-hoa-giap" aria-label="Hoa Giáp" class="km-select"></select>
        </div>
        <Button type="submit" size="md" class="mt-3">Lập bàn</Button>
      </form>

      <div id="km-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

      <!-- Kết quả -->
      <div id="km-ket-qua" class="mt-8 hidden">
        <!-- Tứ trụ -->
        <div id="km-tu-tru-wrap">
          <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-300)">Tứ trụ</p>
          <div class="mt-2 grid grid-cols-4 gap-2 text-center">
            <div class="km-tru-cell"><p class="km-tru-label">Giờ</p><p id="km-tt-gio" class="km-tru-canchi"></p></div>
            <div class="km-tru-cell"><p class="km-tru-label">Ngày</p><p id="km-tt-ngay" class="km-tru-canchi"></p></div>
            <div class="km-tru-cell"><p class="km-tru-label">Tháng</p><p id="km-tt-thang" class="km-tru-canchi"></p></div>
            <div class="km-tru-cell"><p class="km-tru-label">Năm</p><p id="km-tt-nam" class="km-tru-canchi"></p></div>
          </div>
        </div>
        <p id="km-hoa-giap-line" class="hidden font-display text-lg font-semibold text-(--color-ink-950)"></p>

        <!-- Cục / Phù đầu tóm tắt -->
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-(--color-ink-700)">
          <span>Cục: <strong id="km-cuc" class="text-(--color-ink-950)"></strong></span>
          <span>Phù đầu: <strong id="km-phu-dau" class="text-(--color-ink-950)"></strong></span>
          <span>Trực Sử: <strong id="km-truc-su" class="text-(--color-ink-950)"></strong></span>
          <span>Trực Phù: <strong id="km-truc-phu" class="text-(--color-ink-950)"></strong></span>
        </div>

        <!-- Toggle Bảng Kỳ Môn / Bảng Cách Cục -->
        <div class="mt-5 flex gap-2">
          <button type="button" data-view="ban" class="km-view-btn" aria-selected="true">Bảng Kỳ Môn</button>
          <button type="button" data-view="cach-cuc" class="km-view-btn" aria-selected="false">Bảng Cách Cục</button>
        </div>

        <!-- Lưới 9 cung -->
        <div class="mt-4 overflow-x-auto">
          <div id="km-luoi-9-cung" class="km-grid-9"></div>
        </div>

        <!-- Bảng Cách Cục -->
        <div id="km-bang-cach-cuc" class="mt-4 hidden">
          <p class="mb-2 text-sm font-semibold text-(--color-cinnabar-400)">＋ Bảng Chi Tiết</p>
          <div class="km-table-frame overflow-x-auto">
            <table class="km-app-table">
              <thead>
                <tr><th>Loại</th><th>Mô Tả</th></tr>
              </thead>
              <tbody id="km-cach-cuc-body"></tbody>
            </table>
          </div>
          <!-- Lưu Ý (chú giải ký hiệu) — y như app -->
          <p class="mt-5 mb-2 text-base font-semibold text-(--color-cinnabar-400)">＋ Lưu Ý</p>
          <div class="km-luuy">
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-key km-key-kv">KV</span> Không Vong</span>
              <span class="km-luuy-item"><span class="km-sym">🐴</span> Mã</span>
              <span class="km-luuy-item"><span class="km-sym km-sym-mo">✝</span> Mộ</span>
              <span class="km-luuy-item"><span class="km-key km-key-hinh">Hình</span> Kích Hình</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-arr">↗</span> Môn bách</span>
              <span class="km-luuy-item"><span class="km-arr">↙</span> Cung bức</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-arr">↶</span> Cung sinh môn</span>
              <span class="km-luuy-item"><span class="km-arr">↷</span> Môn sinh cung</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-key km-key-red">H</span> Giờ</span>
              <span class="km-luuy-item"><span class="km-key km-key-red">D</span> Ngày</span>
              <span class="km-luuy-item"><span class="km-key km-key-red">M</span> Tháng</span>
              <span class="km-luuy-item"><span class="km-key km-key-red">Y</span> Năm</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-red"><strong>V</strong>: Đế Vượng</span>
              <span class="km-luuy-red"><strong>T</strong>: Tướng</span>
            </div>
            <div class="km-luuy-row">
              <span><strong>H</strong>: Hưu</span><span><strong>T</strong>: Tù</span><span><strong>P</strong>: Phế</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-sym">🗡️</span> Dương nhẫn</span>
              <span class="km-luuy-item"><span class="km-sym">📕</span> Kiến Thức</span>
              <span class="km-luuy-item"><span class="km-sym">👥</span> Học Đường</span>
            </div>
            <div class="km-luuy-row">
              <span class="km-luuy-item"><span class="km-sym">👨‍💼</span> Dương Quý Nhân</span>
              <span class="km-luuy-item"><span class="km-sym">👩</span> Âm Quý Nhân</span>
            </div>
          </div>
        </div>

        <!-- Sub-tab Mệnh / Tam Thắng / Lịch — chỉ hiện ở chế độ Mệnh -->
        <div id="km-subtabs-wrap" class="mt-8 hidden">
          <div class="flex flex-wrap gap-2">
            <button type="button" data-subtab="menh" class="km-subtab-btn" aria-selected="true">Mệnh</button>
            <button type="button" data-subtab="tam-thang" class="km-subtab-btn" aria-selected="false">Tam Thắng</button>
            <button type="button" data-subtab="lich" class="km-subtab-btn" aria-selected="false">Lịch</button>
          </div>

          <div id="km-subtab-menh" class="km-subtab-panel mt-4">
            <p class="mb-2 flex items-center gap-1.5 text-base font-semibold text-(--color-cinnabar-400)">☯ Mệnh Cung</p>
            <div class="km-table-frame overflow-x-auto">
              <table class="km-app-table">
                <thead>
                  <tr><th>Mệnh cung</th><th>Thần</th><th>Cửu Tinh</th><th>Môn</th></tr>
                </thead>
                <tbody id="km-menh-cung-body"></tbody>
              </table>
            </div>

            <p class="mt-5 mb-2 text-base font-semibold text-(--color-cinnabar-400)">Nhãn 12 cung (theo dụng thần)</p>
            <div class="km-table-frame overflow-x-auto">
              <table class="km-app-table">
                <thead>
                  <tr><th>Cung</th><th>Nhãn</th></tr>
                </thead>
                <tbody id="km-dung-than-body"></tbody>
              </table>
            </div>
          </div>

          <div id="km-subtab-tam-thang" class="km-subtab-panel mt-4 hidden">
            <p class="mb-2 flex items-center gap-1.5 text-base font-semibold text-(--color-cinnabar-400)">☯ Tam Thắng</p>
            <div class="km-table-frame overflow-x-auto">
              <table class="km-app-table">
                <thead>
                  <tr><th>Loại</th><th>Tên</th><th>Cung</th></tr>
                </thead>
                <tbody id="km-tam-thang-body"></tbody>
              </table>
            </div>
          </div>

          <div id="km-subtab-lich" class="km-subtab-panel mt-4 hidden">
            <div class="flex items-center justify-between">
              <button type="button" id="km-lich-prev" aria-label="Tháng trước" class="km-adjust-btn">‹ Tháng trước</button>
              <p id="km-lich-title" class="font-display text-lg font-semibold text-(--color-ink-950)"></p>
              <button type="button" id="km-lich-next" aria-label="Tháng sau" class="km-adjust-btn">Tháng sau ›</button>
            </div>
            <div class="mt-3 overflow-x-auto">
              <div class="km-table-frame" style="min-width:560px">
                <table class="km-cal">
                  <thead>
                    <tr>
                      <th class="cn">C.Nhật</th><th>Thứ 2</th><th>Thứ 3</th><th>Thứ 4</th><th>Thứ 5</th><th>Thứ 6</th><th>Thứ 7</th>
                    </tr>
                  </thead>
                  <tbody id="km-lich-body"></tbody>
                </table>
              </div>
            </div>
            <p class="mt-2 text-xs text-(--color-ink-500)">Mỗi ô: can-chi ngày · Kiến Trừ / Nhị Thập Bát Tú.</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<style is:global>
  /* is:global bắt buộc: lưới 9 cung / Tam Thắng / bảng Cách Cục / bảng Lịch đều được
     script phía dưới tạo bằng innerHTML lúc chạy — các phần tử đó không có thuộc tính
     data-astro-cid-* nên CSS "scoped" mặc định của Astro sẽ KHÔNG áp dụng, khiến toàn bộ
     khung/màu/viền các ô đó biến mất (chỉ còn chữ trần). */
  /* Vùng kết quả (lá số) = "tờ giấy sáng" như app: định nghĩa lại token màu cục bộ để mọi
     phần bên trong (tứ trụ, meta, nút, chú giải) đổi sang tông sáng, bất kể site đang theme tối. */
  #km-ket-qua {
    --color-ink-950: #1f120e;
    --color-ink-900: #2a1c14;
    --color-ink-800: #33241a;
    --color-ink-700: #4a3728;
    --color-ink-600: #6b5544;
    --color-ink-500: #8a7663;
    --color-ink-400: #a6907a;
    --color-ivory-50: #ffffff;
    --color-ivory-100: #fbf5ea;
    --color-ivory-200: #f4ead8;
    --color-ivory-300: #e6d9c2;
    background: #fbf6ee;
    border: 1px solid #e6d9c2;
    border-radius: 12px;
    padding: 1rem 0.9rem 1.2rem;
    color: #2a1512;
  }

  .km-mode-btn,
  .km-view-btn,
  .km-subtab-btn {
    border-radius: var(--radius-control);
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  /* Nút chọn chế độ (ngoài vùng kết quả) — giữ tông site. */
  .km-mode-btn {
    color: var(--color-ink-700);
    background: var(--color-ivory-100);
    border: 1px solid var(--color-ivory-300);
  }
  .km-mode-btn[aria-selected="true"] {
    background: var(--color-gold-400);
    color: var(--color-on-accent);
    border-color: var(--color-gold-400);
  }
  /* Nút Bảng Kỳ Môn / Bảng Cách Cục — kiểu đỏ như app. */
  .km-view-btn {
    color: #c0261e;
    background: #fff;
    border: 1px solid #c0261e;
  }
  .km-view-btn[aria-selected="true"] {
    background: #c0261e;
    color: #fff;
  }
  /* Sub-tab Mệnh / Tam Thắng / Lịch — kiểu đỏ như app. */
  .km-subtab-btn {
    color: #c0261e;
    background: #fff;
    border: 1px solid #c0261e;
  }
  .km-subtab-btn[aria-selected="true"] {
    background: #c0261e;
    color: #fff;
  }

  .km-select {
    width: 100%;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-50);
    color: var(--color-ink-800);
    padding: 0.55rem 0.6rem;
    font-size: 0.85rem;
  }
  .km-select:focus {
    outline: 2px solid color-mix(in srgb, var(--color-gold-400) 40%, transparent);
    border-color: var(--color-gold-400);
  }

  .km-adjust-btn {
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-50);
    color: var(--color-ink-700);
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .km-adjust-btn:hover {
    border-color: var(--color-gold-400);
    color: var(--color-gold-300);
  }

  .km-tru-cell {
    border-radius: var(--radius-control);
    border: 1px solid var(--color-ivory-300);
    background: var(--color-ivory-100);
    padding: 0.5rem 0.25rem;
  }
  .km-tru-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
  }
  .km-tru-canchi {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink-950);
    line-height: 1.2;
  }

  /* ---- Lưới 9 cung theo phong cách app Kỳ Môn Pro: mỗi cung tô nền NGŨ HÀNH, nhãn hướng
        ở dải trên, nội dung trên nền trắng. Bảng dùng màu cố định (không theo theme site) —
        giống cách xem-ngay-tot-xau.astro render card kết quả nền trắng trên nền tối. ---- */
  .km-grid-9 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px; /* 4 đường kẻ mảnh ngăn 9 ô */
    background: #b6a480;
    border-radius: 8px;
    overflow: hidden;
    min-width: 460px; /* giữ ô đủ rộng cho viền dày; màn hẹp thì cuộn ngang */
  }
  /* Mỗi cung chỉ tô màu ngũ hành ở cạnh HƯỚNG RA NGOÀI lưới (padding dày ở cạnh ngoài, mảnh ở
     cạnh giáp cung khác) → màu chỉ tạo thành VÒNG NGOÀI, không có dải màu dày giữa các cung. */
  .km-cung {
    --nh: #9b9b9b;
    position: relative;
    background: var(--nh);
    box-sizing: border-box;
    min-height: 200px;
    display: flex;
  }
  .km-cung-inner-wrap { flex: 1; position: relative; }
  /* Nhãn hướng + địa chi trên dải màu ngoài. */
  .km-lbl {
    position: absolute;
    color: #fff;
    font-size: 0.58rem;
    font-weight: 700;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    z-index: 1;
  }
  .km-lbl-t { top: 0; left: 4px; right: 4px; height: 38px; line-height: 38px; text-align: center; }
  .km-lbl-b { bottom: 0; left: 4px; right: 4px; height: 38px; line-height: 38px; text-align: center; }
  .km-lbl-l { left: 0; top: 4px; bottom: 4px; width: 38px; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; }
  .km-lbl-r { right: 0; top: 4px; bottom: 4px; width: 38px; writing-mode: vertical-rl; text-align: center; }
  .km-cung > .km-badge-kv {
    position: absolute;
    top: 1px;
    left: 2px;
    z-index: 2;
  }
  .km-cung-so {
    flex: none;
    font-size: 0.62rem;
    font-weight: 700;
    opacity: 0.85;
  }
  /* Thân cung: bố cục 3 cột như app — hàng trên [thiên can | sao | thần], giữa [số địa bàn],
     hàng dưới [địa can | môn]. Nhãn KV/Mã/Trực Phù/Trực Sử nằm cạnh trái ô số. */
  .km-cung-inner {
    position: absolute;
    inset: 0;
    background: #fffdf8;
    padding: 0.26rem 0.3rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    color: #2a1512;
  }
  .km-cung-r1,
  .km-cung-r2 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    column-gap: 2px;
  }
  .cc-can { font-size: 0.7rem; font-weight: 600; color: #3a2620; text-align: left; }
  .cc-sao {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: #1f120e;
    text-align: center;
    line-height: 1;
  }
  .cc-than { font-size: 0.62rem; color: #b8322a; text-align: right; line-height: 1.05; }
  /* Băng giữa: nhãn Mã/TP/TS/HDMY ở góc trên-trái; MŨI TÊN + SỐ CUNG ở góc dưới-phải
     (số nằm dưới-phải, mũi tên ngay trên môn — như app). */
  .km-cung-mid { position: relative; }
  .km-cung-marks {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .km-cung-botright {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }
  .km-mt { font-size: 1.05rem; color: #4a4a4a; line-height: 1; }
  .cc-so { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; color: #1f120e; line-height: 0.9; }
  .km-cung-r2 { grid-template-columns: 1fr 1fr; align-items: end; }
  .cc-diacan { font-size: 0.7rem; font-weight: 600; color: #3a2620; text-align: left; }
  .cc-mon {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: #b8322a;
    text-align: center;
  }
  .km-cung-trung-note {
    grid-column: 1 / -1;
    font-size: 0.56rem;
