  .cc-can { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.72rem; font-weight: 700; color: #3a2620; text-align: left; }
  /* Cửu Tinh (sao): chữ đậm rõ — dùng font sans thay vì serif để đọc "đậm" hơn ở cỡ nhỏ. */
  .cc-sao {
    font-family: var(--font-sans);
