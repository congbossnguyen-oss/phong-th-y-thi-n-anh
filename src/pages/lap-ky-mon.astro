---
// TRANG "Lập Kỳ Môn Độn Giáp" (bản web) — chỉ lo khung trang (SEO/PageHero/breadcrumbs); toàn bộ
// công cụ (lập lá bàn, Tam Thắng, lịch tháng, luận giải Mệnh, Hỏi Đáp Kỳ Môn) nằm ở component
// dùng chung `LapKyMon.astro`, cũng được bản in-app Quân Sư (`/quan-su/lap-ky-mon`) tái sử dụng.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import LapKyMon from "../components/tools/LapKyMon.astro";

// Giữ prerender = true như bản gốc: công cụ chạy hoàn toàn phía client (gọi API), trang tĩnh nên
// tải nhanh hơn. (Bản in-app Quân Sư phải để false vì khung app đọc phiên đăng nhập.)
export const prerender = true;
---

<BaseLayout
  title="Lập Kỳ Môn Độn Giáp"
  description="Lập lá bàn Kỳ Môn Độn Giáp 9 cung theo giờ hiện tại hoặc giờ sinh (Mệnh) — kèm Tam Thắng và lịch tháng Kỳ Môn."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập Kỳ Môn Độn Giáp"
    description="Chọn chế độ Thời Gian (thời điểm hiện tại) hoặc Mệnh (giờ sinh) để lập lá bàn 9 cung."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập Kỳ Môn Độn Giáp" }]}
  />

  <LapKyMon hrefMenhChiTiet="/dai-cat-loi/ky-mon-menh-chi-tiet" hrefTrachCat="/dai-cat-loi/trach-cat-ky-mon" />
</BaseLayout>
