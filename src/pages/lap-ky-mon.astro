  // KÍCH HÌNH: can đóng tại cung → loại hình (nguồn gốc Công cung cấp, 6 dòng).
  const KICH_HINH: Record<string, string> = {
    "Kỷ|2": "Mùi-Tuất", "Mậu|3": "Tý-Mão", "Nhâm|4": "Thìn tự hình",
    "Quý|8": "Dần tự hình", "Canh|8": "Dần-Thân", "Tân|9": "Ngọ tự hình",
  };
  const kichHinh = (can: string, soCung: number): string | undefined => KICH_HINH[`${can}|${soCung}`];

  // Ngũ hành của 8 Môn và 9 Cung — dùng suy mũi tên quan hệ Môn↔Cung (kiến thức nền cố định).
  const MON_NGU_HANH: Record<string, string> = {
    HƯU: "Thủy", SINH: "Thổ", THƯƠNG: "Mộc", ĐỖ: "Mộc", CẢNH: "Hỏa", TỬ: "Thổ", KINH: "Kim", KHAI: "Kim",
  };
  const CUNG_NGU_HANH: Record<number, string> = {
    1: "Thủy", 2: "Thổ", 3: "Mộc", 4: "Mộc", 5: "Thổ", 6: "Kim", 7: "Kim", 8: "Thổ", 9: "Hỏa",
  };
  const SINH_NEXT: Record<string, string> = { Mộc: "Hỏa", Hỏa: "Thổ", Thổ: "Kim", Kim: "Thủy", Thủy: "Mộc" };
  const KHAC_NEXT: Record<string, string> = { Mộc: "Thổ", Thổ: "Thủy", Thủy: "Hỏa", Hỏa: "Kim", Kim: "Mộc" };
  // Mũi tên quan hệ Môn↔Cung (đã đối chiếu khớp 8/8 cung với ảnh app):
  //  Môn sinh cung ↷ · Cung sinh môn ↶ · Môn bách cung ↗ (môn khắc cung) · Cung bức môn ↙ (cung khắc môn).
  function muiTenMonCung(mon: string, soCung: number): string {
    const m = MON_NGU_HANH[mon];
    const c = CUNG_NGU_HANH[soCung];
    if (!m || !c || m === c || soCung === 5) return "";
    if (SINH_NEXT[m] === c) return '<span class="km-mt" title="Môn sinh cung">↷</span>';
    if (SINH_NEXT[c] === m) return '<span class="km-mt" title="Cung sinh môn">↶</span>';
    if (KHAC_NEXT[m] === c) return '<span class="km-mt" title="Môn bách cung">↗</span>';
    if (KHAC_NEXT[c] === m) return '<span class="km-mt" title="Cung bức môn">↙</span>';
    return "";
  }
  // Ngũ hành theo cung Lạc Thư — tô nền dải hướng mỗi cung (bộ màu theo app Kỳ Môn Pro:
  // Mộc xanh lá, Hỏa đỏ, Thổ vàng, Kim xám, Thủy xanh dương).
  const NGU_HANH_CUNG: Record<number, string> = {
    1: "#2b7fc3", 2: "#e0a41f", 3: "#17974a", 4: "#17974a", 5: "#e0a41f",
    6: "#9b9b9b", 7: "#9b9b9b", 8: "#e0a41f", 9: "#e0362a",
  };
  // Thứ tự hiển thị lưới 3x3: Tốn-Ly-Khôn / Chấn-Trung-Đoài / Cấn-Khảm-Càn (đúng bố cục app).
  const LUOI_THU_TU = [4, 9, 2, 3, 5, 7, 8, 1, 6];

  function tenDayDu(map: Record<string, string>, key: string): string {
    return map[key] ?? key;
  }

  // ---------- Chọn chế độ ----------
  const modeBtns = document.querySelectorAll<HTMLButtonElement>(".km-mode-btn");
  const formLich = document.getElementById("km-form-lich") as HTMLFormElement;
  const formLabelEl = document.getElementById("km-form-lich-label")!;
  const form1080 = document.getElementById("km-form-1080") as HTMLFormElement;
  const modeNoteEl = document.getElementById("km-mode-note")!;
  let cheDoHienTai: "gio" | "menh" | "1080" = "gio";

  const MODE_NOTE: Record<string, string> = {
    gio: "Lập bàn theo thời điểm nhập (mặc định giờ hiện tại).",
    menh: "Lập bàn theo giờ SINH — bàn 9 cung tính y hệt chế độ Thời Gian, chỉ khác ý nghĩa thời điểm nhập.",
    "1080": "Nhập tay số Cục, Âm/Dương và 1 trong 60 Hoa Giáp — bỏ qua tra lịch, dùng cho bốc thẻ hoa giáp.",
  };

  function chonCheDo(cheDo: "gio" | "menh" | "1080") {
    cheDoHienTai = cheDo;
    modeBtns.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.mode === cheDo)));
    formLich.classList.toggle("hidden", cheDo === "1080");
    form1080.classList.toggle("hidden", cheDo !== "1080");
    formLabelEl.textContent = cheDo === "menh" ? "Ngày giờ SINH" : "Thời điểm hiện tại";
    modeNoteEl.textContent = MODE_NOTE[cheDo];
    document.getElementById("km-subtabs-wrap")!.classList.toggle("hidden", cheDo !== "menh");
  }

  modeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      chonCheDo(btn.dataset.mode as "gio" | "menh" | "1080");
      if (cheDoHienTai === "1080") layBan1080();
      else layBanLich();
    });
  });

  // ---------- Điền các ô chọn ngày giờ ----------
  function populateSelect(el: HTMLSelectElement, options: [number | string, string][]) {
    el.innerHTML = options.map(([v, l]) => `<option value="${v}">${l}</option>`).join("");
  }
  const ngaySel = document.getElementById("km-ngay") as HTMLSelectElement;
  const thangSel = document.getElementById("km-thang") as HTMLSelectElement;
  const namSel = document.getElementById("km-nam") as HTMLSelectElement;
  const gioSel = document.getElementById("km-gio") as HTMLSelectElement;
  const phutSel = document.getElementById("km-phut") as HTMLSelectElement;

  populateSelect(ngaySel, Array.from({ length: 31 }, (_, i) => [i + 1, String(i + 1).padStart(2, "0")]));
  populateSelect(thangSel, Array.from({ length: 12 }, (_, i) => [i + 1, `Tháng ${i + 1}`]));
  // Năm: 1930 → năm hiện tại (tự tính lại mỗi lần tải trang, không chốt cứng mốc tương lai) —
  // đủ rộng cho chế độ Mệnh (nhập năm SINH của khách, có thể sinh từ lâu), không chỉ quanh "hiện
  // tại" như trước (trước đây chỉ có ±10 năm, quá hẹp cho năm sinh).
  const nowYear = new Date().getFullYear();
  const NAM_SINH_TOI_THIEU = 1930;
  populateSelect(
    namSel,
    Array.from({ length: nowYear - NAM_SINH_TOI_THIEU + 1 }, (_, i) => NAM_SINH_TOI_THIEU + i).map((y) => [y, String(y)]),
  );
  populateSelect(gioSel, Array.from({ length: 24 }, (_, i) => [i, `${String(i).padStart(2, "0")}h`]));
  populateSelect(phutSel, Array.from({ length: 60 }, (_, i) => [i, String(i).padStart(2, "0")]));

  function datVaoForm(d: Date) {
    ngaySel.value = String(d.getDate());
    thangSel.value = String(d.getMonth() + 1);
    namSel.value = String(d.getFullYear());
    gioSel.value = String(d.getHours());
    phutSel.value = String(d.getMinutes());
  }
  function docTuForm(): Date {
    return new Date(
      Number(namSel.value),
      Number(thangSel.value) - 1,
      Number(ngaySel.value),
      Number(gioSel.value),
      Number(phutSel.value),
    );
  }

  document.querySelectorAll<HTMLButtonElement>("[data-adjust]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const [don, soRaw] = (btn.dataset.adjust ?? "").split(":");
      const so = Number(soRaw);
      const d = docTuForm();
      if (don === "H") d.setHours(d.getHours() + so);
      if (don === "D") d.setDate(d.getDate() + so);
      if (don === "M") d.setMonth(d.getMonth() + so);
      if (don === "Y") d.setFullYear(d.getFullYear() + so);
      datVaoForm(d);
      layBanLich();
    });
  });

  // ---------- Chọn cục / hoa giáp (1080) ----------
  const soCucSel = document.getElementById("km-so-cuc") as HTMLSelectElement;
  populateSelect(soCucSel, Array.from({ length: 9 }, (_, i) => [i + 1, `Cục ${i + 1}`]));
  const amDuongSel = document.getElementById("km-am-duong") as HTMLSelectElement;
  const hoaGiapSel = document.getElementById("km-hoa-giap") as HTMLSelectElement;
  const CAN_60 = ["Giáp", "Ất", "Bính", "Đinh", "Mậu", "Kỷ", "Canh", "Tân", "Nhâm", "Quý"];
  const CHI_60 = ["Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ", "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"];
  const HOA_GIAP_60: string[] = Array.from({ length: 60 }, (_, i) => `${CAN_60[i % 10]} ${CHI_60[i % 12]}`);
  populateSelect(hoaGiapSel, HOA_GIAP_60.map((t) => [t, t]));

  // ---------- Gọi API + render ----------
  const loiEl = document.getElementById("km-loi")!;
  const ketQuaEl = document.getElementById("km-ket-qua")!;

  // Lá bàn để "Hỏi 1 việc cụ thể" dùng — chỉ set khi chế độ Thời Gian/Bốc Độn (không phải Mệnh).
  let laBanHoiDap: LaBanChoHoi | null = null;

  async function layBanLich() {
    const d = docTuForm();
    const qs = `cheDo=${cheDoHienTai}&nam=${d.getFullYear()}&thang=${d.getMonth() + 1}&ngay=${d.getDate()}&gio=${d.getHours()}&phut=${d.getMinutes()}`;
    laBanHoiDap =
      cheDoHienTai === "gio"
        ? { cheDo: "gio", nam: d.getFullYear(), thang: d.getMonth() + 1, ngay: d.getDate(), gio: d.getHours(), phut: d.getMinutes() }
        : null;
    await goiVaVe(qs, false);
  }
  async function layBan1080() {
    const qs = `cheDo=1080&soCuc=${soCucSel.value}&amDuong=${encodeURIComponent(amDuongSel.value)}&hoaGiap=${encodeURIComponent(hoaGiapSel.value)}`;
    laBanHoiDap = { cheDo: "1080", soCuc: Number(soCucSel.value), amDuong: amDuongSel.value as "+" | "-", hoaGiap: hoaGiapSel.value };
    await goiVaVe(qs, true);
  }

  // Chống race condition: đổi chế độ/chỉnh nhanh liên tiếp có thể bắn nhiều request cùng lúc,
  // phản hồi có thể về KHÔNG theo đúng thứ tự gửi đi (đặc biệt khi đổi chế độ rồi sửa input
  // ngay lập tức). Chỉ áp dụng kết quả của request MỚI NHẤT đã gửi, bỏ qua phản hồi cũ về muộn.
  let yeuCauMoiNhat = 0;

  async function goiVaVe(qs: string, la1080: boolean) {
    const idYeuCau = ++yeuCauMoiNhat;
    loiEl.classList.add("hidden");
    let res: LapLaBanApiResponse;
    try {
      const r = await fetch(`/api/kymon-lap-la-ban?${qs}`);
      res = await r.json();
    } catch {
      if (idYeuCau !== yeuCauMoiNhat) return;
      loiEl.textContent = "Không thể kết nối tới máy chủ, thử lại sau.";
      loiEl.classList.remove("hidden");
      ketQuaEl.classList.add("hidden");
      return;
    }
    if (idYeuCau !== yeuCauMoiNhat) return; // có request mới hơn đã gửi đi, bỏ qua kết quả cũ này
    if (res.error || !res.laBan) {
      loiEl.textContent = res.error ?? "Không lập được lá bàn.";
      loiEl.classList.remove("hidden");
      ketQuaEl.classList.add("hidden");
      return;
    }
    renderLaBan(res.laBan, res.tamThang ?? [], la1080, res.luanGiai ?? null);
    ketQuaEl.classList.remove("hidden");
  }

  function renderLaBan(laBan: LapLaBanResult, tamThang: HangTamThang[], la1080: boolean, luanGiai: KetQuaLuanGiaiMenh | null = null) {
    document.getElementById("km-tu-tru-wrap")!.classList.toggle("hidden", la1080);
    // "Hỏi 1 việc cụ thể" chỉ áp dụng chế độ Thời Gian/Bốc Độn — lá bàn vừa đổi thì reset luôn
    // widget hỏi đáp (đơn hàng cũ gắn với lá bàn cũ, không còn hợp lệ cho lá bàn mới).
    document.getElementById("km-hoidap-wrap")!.classList.toggle("hidden", laBan.cheDo === "menh");
    if (laBan.cheDo !== "menh") resetHoiDapWidget();
    const hoaGiapLine = document.getElementById("km-hoa-giap-line")!;
    if (la1080) {
      hoaGiapLine.textContent = `Hoa giáp: ${hoaGiapSel.value} · Cục ${laBan.cuc} ${laBan.amDuong === "-" ? "Âm" : "Dương"}`;
      hoaGiapLine.classList.remove("hidden");
    } else {
      hoaGiapLine.classList.add("hidden");
      // Header bảng tứ trụ: echo đúng thời điểm đã chọn (giống app: "Giờ 22:43 · Ngày 20 · ...").
      document.getElementById("km-tt-h-echo")!.textContent = `${gioSel.value}:${phutSel.value.padStart(2, "0")}`;
      document.getElementById("km-tt-d-echo")!.textContent = ngaySel.value;
      document.getElementById("km-tt-m-echo")!.textContent = thangSel.value.padStart(2, "0");
      document.getElementById("km-tt-y-echo")!.textContent = namSel.value;
      const fill = (pillar: string, p?: CanChiPillar) => {
        document.getElementById(`km-tt-${pillar}-can`)!.textContent = p?.can ?? "—";
        document.getElementById(`km-tt-${pillar}-chi`)!.textContent = p?.chi ?? "—";
      };
      fill("gio", laBan.tuTru.gio);
      fill("ngay", laBan.tuTru.ngay);
      fill("thang", laBan.tuTru.thang);
      fill("nam", laBan.tuTru.nam);
    }

    document.getElementById("km-cuc")!.textContent = `${laBan.amDuong === "-" ? "Âm" : "Dương"} ${laBan.cuc}`;
    document.getElementById("km-phu-dau")!.textContent = laBan.phuDau;
    document.getElementById("km-truc-su")!.textContent = `${tenDayDu(TEN_MON, laBan.trucSu)} môn`;
    document.getElementById("km-truc-phu")!.textContent = tenDayDu(TEN_SAO, laBan.trucPhu);

    // Lưới 9 cung
    const cungMap = new Map(laBan.cungList.map((c) => [c.soCung, c]));
    const luoiEl = document.getElementById("km-luoi-9-cung")!;
    // H/D/M/Y = cung có THIÊN BÀN CAN trùng can của trụ Giờ/Ngày/Tháng/Năm (đã đối chiếu khớp
    // 4/4 với ảnh app). Chế độ 1080 không có tứ trụ nên bỏ qua.
    const truLetters: [string, string | undefined][] = [
      ["H", laBan.tuTru.gio?.can],
      ["D", laBan.tuTru.ngay?.can],
      ["M", laBan.tuTru.thang?.can],
      ["Y", laBan.tuTru.nam?.can],
    ];
    luoiEl.innerHTML = LUOI_THU_TU.map((soCung) => {
      const c = cungMap.get(soCung);
      if (!c) return "";
      const trungCung = soCung === 5;
      // KV đưa lên đầu cung (cạnh hướng) như app.
      const kvHead = c.KV ? '<span class="km-badge km-badge-kv">KV</span>' : "";
      // Nhãn giữa (cạnh số): Trực Phù / Trực Sử / Mộ / Hình. Mã chuyển ra viền ngoài (xem dưới).
      // Nhập Mộ, Kích Hình xét theo THIÊN BÀN CAN (can "đóng" tại cung — cùng quy ước với cách
      // mô tả Trực Phù "đóng ở cung"). Giáp không bao giờ xuất hiện làm thienBanCan (luôn ẩn dưới
      // Phù Đầu — xem engine.ts) nên nhánh "Giáp" của bảng Nhập Mộ sẽ không khớp trực tiếp, đúng
      // theo quy ước hiện có của engine.
      const marksList: string[] = [];
      if (soCung === laBan.trucPhuCung) marksList.push('<span class="km-badge km-badge-tp">Trực Phù</span>');
      if (soCung === laBan.trucSuCung) marksList.push('<span class="km-badge km-badge-ts">Trực Sử</span>');
      if (nhapMo(c.thienBanCan, soCung)) marksList.push('<span class="km-badge km-badge-mo" title="Nhập Mộ">✝</span>');
      const hinh = kichHinh(c.thienBanCan, soCung);
      if (hinh) marksList.push(`<span class="km-badge km-badge-hinh" title="Kích Hình: ${hinh}">Hình</span>`);
      if (duongNhan(c.thienBanCan, c.diaChi ?? [])) marksList.push('<span class="km-badge km-badge-dn" title="Dương Nhận">Nhận</span>');
      const marks = `<div class="km-cung-marks">${marksList.join("")}</div>`;
      // H/D/M/Y: cột riêng, canh GIỮA theo chiều dọc, ghim sát cạnh trái ô trắng.
      const hdmyList: string[] = [];
      for (const [letter, can] of truLetters) {
        if (can && can === c.thienBanCan) hdmyList.push(`<span class="km-hdmy" title="${letter}">${letter}</span>`);
      }
      const hdmyCol = hdmyList.length ? `<div class="km-cung-hdmy-col">${hdmyList.join("")}</div>` : "";
      // Khung màu chỉ cạnh ngoài + nhãn hướng/địa chi trên dải màu ngoài.
      const f = FRAME[soCung];
      const padStyle = `padding:${f.pad[0]}px ${f.pad[1]}px ${f.pad[2]}px ${f.pad[3]}px`;
      const chiStr = (c.diaChi ?? []).join(" ");
      // Mã (🐴): đặt trên VIỀN NGOÀI (dải màu), gắn liền cạnh nhãn địa chi — không còn trong ô trắng.
      const maIcon = c.Ma ? '<span class="km-lbl-ma" title="Mã">🐴</span>' : "";
      let labels = "";
      if (f.dir) {
        if (f.dir === f.chi) {
          labels = `<span class="km-lbl km-lbl-${f.dir}">${DIR_LABEL[soCung]}${chiStr ? " " + chiStr : ""}${maIcon}</span>`;
        } else {
          labels = `<span class="km-lbl km-lbl-${f.dir}">${DIR_LABEL[soCung]}</span>`;
          if (chiStr && f.chi) labels += `<span class="km-lbl km-lbl-${f.chi}">${chiStr}${maIcon}</span>`;
          else if (maIcon) labels += `<span class="km-lbl km-lbl-${f.dir}" style="top:auto;bottom:0">${maIcon}</span>`;
        }
      } else if (maIcon) {
        // Trung cung không có viền màu — badge Mã tạm giữ trong ô trắng.
        marksList.push('<span class="km-badge km-badge-ma" title="Mã">🐴</span>');
      }
      // Trung cung mượn Trực Phù/Trực Sử của Khôn để TÍNH TOÁN (xem engine.ts), nhưng KHÔNG có
      // sao/thần/môn/thiên-bàn-can riêng để HIỂN THỊ — quy ước app: ô Trung chỉ hiện can của
      // chính nó (thiên = địa, không "mượn" hiển thị Khôn) và bỏ trống sao/thần/môn.
      const hienThiCan = trungCung ? c.diaBanCan : c.thienBanCan;
      const r1 = trungCung
        ? `<div class="km-cung-r1"><span class="cc-can">${hienThiCan}</span></div>`
        : `<div class="km-cung-r1">
             <span class="cc-can">${c.thienBanCan}</span>
             <span class="cc-sao">${tenDayDu(SAO_NGAN, c.saoThienBan)}</span>
             <span class="cc-than">${tenDayDu(TEN_THAN, c.than)}</span>
           </div>`;
      const botright = trungCung
        ? `<div class="km-cung-botright"><span class="cc-so">${soDiaBan(soCung, laBan.cuc)}</span></div>`
        : `<div class="km-cung-botright">${muiTenMonCung(c.mon, soCung)}<span class="cc-so">${soDiaBan(soCung, laBan.cuc)}</span></div>`;
      const r2 = trungCung
        ? `<div class="km-cung-r2"><span class="cc-diacan">${c.diaBanCan}</span></div>`
        : `<div class="km-cung-r2">
             <span class="cc-diacan">${c.diaBanCan}</span>
             <span class="cc-mon">${tenDayDu(TEN_MON, c.mon)}</span>
           </div>`;
      return `
        <div class="km-cung" style="--nh:${NGU_HANH_CUNG[soCung]}; ${padStyle}">
          ${kvHead}
          ${labels}
          <div class="km-cung-inner-wrap">
            <div class="km-cung-inner">
              ${r1}
              <div class="km-cung-mid">
                ${marks}
                ${hdmyCol}
                ${botright}
              </div>
              ${r2}
            </div>
          </div>
        </div>`;
    }).join("");

    // Bảng Chi Tiết — đúng các dòng như app. "Phương Pháp: Trí Nhuận" và "Cửu Tinh: Chuyển Bàn"
    // là hằng số của phương pháp engine đang dùng (định cục theo lịch tra sẵn + bày sao xoay bàn).
    const rows: [string, string][] = [
      ["Bảng cách cục", `${laBan.amDuong === "-" ? "Âm" : "Dương"} ${laBan.cuc}`],
      ["Phù Đầu", laBan.phuDau],
      ["Trực Sử", tenDayDu(TEN_MON, laBan.trucSu)],
      ["Trực Phù", tenDayDu(SAO_NGAN, laBan.trucPhu)],
      ["Phương Pháp", "Trí Nhuận"],
      ["Cửu Tinh", "Chuyển Bàn"],
    ];
    document.getElementById("km-cach-cuc-body")!.innerHTML = rows
      .map(([k, v]) => `<tr><td class="km-cc-key">${k}</td><td>${v}</td></tr>`)
      .join("");

    // Luận Cách Cục — tra (Thiên Bàn Can/Địa Bàn Can) từng cung ngoài trong bảng 81 tổ hợp.
    // Bỏ qua Trung cung: không có tổ hợp riêng, chỉ mượn Trực Phù/Trực Sử của Khôn để tính.
    document.getElementById("km-luan-cach-cuc-body")!.innerHTML = laBan.cungList
      .filter((c) => c.soCung !== 5)
      .map((c) => {
        const cc = CACH_CUC.get(`${c.thienBanCan}/${c.diaBanCan}`);
        if (!cc) return `<tr><td>${c.huong}</td><td>${c.thienBanCan}/${c.diaBanCan}</td><td colspan="2" style="color:#7a6a5a">—</td></tr>`;
        return `<tr><td>${c.huong}</td><td>${c.thienBanCan}/${c.diaBanCan}</td><td class="km-tt-loai">${cc.ten}</td><td style="text-align:left">${cc.yNghia}</td></tr>`;
      })
      .join("");

    // Tam Thắng — bảng header đỏ (Loại / Tên / Cung) như app.
    document.getElementById("km-tam-thang-body")!.innerHTML = tamThang.length
      ? tamThang
          .map(
            (h) =>
              `<tr><td class="km-tt-loai">${h.loai}</td><td>${h.ten}</td><td>${h.huong}</td></tr>`,
          )
          .join("")
      : '<tr><td colspan="3" style="padding:0.75rem;color:#7a6a5a">Không có thắng cách nào trên lá bàn này.</td></tr>';

    // Bảng Mệnh Cung (chỉ chế độ Mệnh) — dùng bảng dụng thần Công đã cung cấp trong TEST.
    if (laBan.cheDo === "menh") renderMenh(laBan, luanGiai);
  }

  // Nhãn 12 cung Mệnh theo Môn / Sao (bảng dụng thần NHÁNH PHỤ 2 — Công cung cấp, khớp ảnh app).
  const NHAN_THEO_MON: Record<string, string> = {
    SINH: "Tài Bạch", KHAI: "Quan Lộc", HƯU: "Gia Đình", THƯƠNG: "Phong Hiểm (Rủi Ro)",
    TỬ: "Điền Trạch", CẢNH: "Địa Vị", ĐỖ: "Kiến Thức", KINH: "Sức Khoẻ",
  };
  const NHAN_THEO_SAO: Record<string, string> = { "T.Phò": "Học Hành", "T.Nhuế": "Tật Ách" };
  // Vợ/Chồng — cung có THIÊN BÀN CAN = Ất (Vợ) / Canh (Chồng). Nguồn: km-menh.md (skill Luận Kỳ
  // Môn Độn Giáp, nhánh phụ 2 "Ứng Dụng Mệnh Kỳ Môn") — bảng người thân theo vị trí trên bàn.
  const NHAN_THEO_CAN: Record<string, string> = { "Ất": "Vợ", "Canh": "Chồng" };
  // Dương Nhận (Dương Nhẫn): cung mà can đóng tại đó trùng với ĐỊA CHI Dương Nhận của chính can
  // ấy. Nguồn: đối chiếu ví dụ thực chiến trong tài liệu skill (ky-mon-khai-ngo-luu-van-nguyen.md:
  // "Canh Dương Nhận tại Dậu", "Bính Dương Nhận tại Ngọ") — khớp đúng bảng Dương Nhận cổ truyền.
  const DUONG_NHAN_CHI: Record<string, string> = {
    "Giáp": "Mão", "Ất": "Thìn", "Bính": "Ngọ", "Mậu": "Ngọ", "Đinh": "Mùi", "Kỷ": "Mùi",
    "Canh": "Dậu", "Tân": "Tuất", "Nhâm": "Tý", "Quý": "Sửu",
  };
  const duongNhan = (can: string, diaChi: string[]): boolean => diaChi.includes(DUONG_NHAN_CHI[can] ?? "");

  /**
   * Tìm cung mà 1 CAN đang "đóng" trên thiên bàn (dùng để định vị Mệnh Cung). Xử lý đủ 2 trường
   * hợp can không khớp trực tiếp bất kỳ thienBanCan nào (suy trực tiếp từ cơ chế engine):
   *  1. Can = Giáp — luôn ẩn dưới Phù Đầu (xem engine.ts mục X65) → mượn vị trí Phù Đầu.
   *  2. Can = địa bàn can RIÊNG của Trung cung — vì 8 sao chỉ "bay" tới 8 cung ngoài (home mỗi
   *     sao không bao giờ trỏ vào cung 5), nên can gốc của Trung cung không bao giờ được chọn
   *     làm thienBanCan cho cung nào khác → coi như can đó "đóng" tại chính Trung cung.
   * (Giống hệt hàm timCungTheoCan trong src/lib/kymon/luanGiaiMenh.ts — copy riêng vì file này
   * chạy độc lập ở client, không import module server-side.)
   */
  function timCungTheoCan(laBan: LapLaBanResult, can: string): CungInfo | undefined {
    if (can === "Giáp") return laBan.cungList.find((c) => c.thienBanCan === laBan.phuDau);
    const khopTrucTiep = laBan.cungList.find((c) => c.thienBanCan === can);
    if (khopTrucTiep) return khopTrucTiep;
    const trungCung = laBan.cungList.find((c) => c.soCung === 5);
    return trungCung && trungCung.diaBanCan === can ? trungCung : undefined;
  }

  function renderMenh(laBan: LapLaBanResult, luanGiai: KetQuaLuanGiaiMenh | null) {
    const modauEl = document.getElementById("km-luan-giai-modau")!;
    const theEl = document.getElementById("km-luan-giai-the")!;
    if (luanGiai?.hopLe) {
      modauEl.textContent = luanGiai.moDau;
      theEl.innerHTML = luanGiai.theLinhVuc
        .map(
          (t) => `
        <details class="km-luan-giai-the-item">
          <summary>${t.tieuDe}</summary>
          <p class="km-luan-giai-noidung">${t.noiDung}</p>
          <p class="km-luan-giai-chitiet">Chi tiết kỹ thuật: ${t.chiTiet}</p>
        </details>`,
        )
        .join("");
    } else {
      modauEl.textContent = "Không xác định được Mệnh Cung để luận giải lá bàn này.";
      theEl.innerHTML = "";
    }

    // Nút "Xem chi tiết" mang theo đúng ngày giờ sinh đang xem — trang kia không hỏi lại.
    const chiTietLink = document.getElementById("km-luan-giai-chi-tiet-link") as HTMLAnchorElement | null;
    if (chiTietLink) {
      if (luanGiai?.hopLe) {
        const qs = new URLSearchParams({
          nam: namSel.value, thang: thangSel.value, ngay: ngaySel.value, gio: gioSel.value, phut: phutSel.value,
        });
        chiTietLink.href = `/dai-cat-loi/ky-mon-menh-chi-tiet?${qs.toString()}`;
        chiTietLink.classList.remove("hidden");
      } else {
        chiTietLink.classList.add("hidden");
      }
    }

    const canNgaySinh = laBan.tuTru.ngay?.can ?? "";
    const menhCung = timCungTheoCan(laBan, canNgaySinh);
    const mcBody = document.getElementById("km-menh-cung-body")!;
    if (menhCung) {
      mcBody.innerHTML = `<tr>
        <td>${menhCung.huong}</td>
        <td>${tenDayDu(TEN_THAN, menhCung.than)}</td>
        <td>${tenDayDu(SAO_NGAN, menhCung.saoThienBan)}</td>
        <td>${tenDayDu(TEN_MON, menhCung.mon)}</td>
      </tr>`;
    } else {
      mcBody.innerHTML = '<tr><td colspan="4" style="padding:.6rem;color:#7a6a5a">Không xác định được mệnh cung.</td></tr>';
    }

    const dungThanBody = document.getElementById("km-dung-than-body")!;
    dungThanBody.innerHTML = laBan.cungList
      .filter((c) => c.soCung !== 5)
      .map((c) => {
        const nhan: string[] = [];
        if (c === menhCung) nhan.push("Mệnh Cung");
        if (NHAN_THEO_MON[c.mon]) nhan.push(NHAN_THEO_MON[c.mon]!);
        if (NHAN_THEO_SAO[c.saoThienBan]) nhan.push(NHAN_THEO_SAO[c.saoThienBan]!);
        if (NHAN_THEO_CAN[c.thienBanCan]) nhan.push(NHAN_THEO_CAN[c.thienBanCan]!);
        if (duongNhan(c.thienBanCan, c.diaChi ?? [])) nhan.push("Dương Nhận");
        return `<tr><td>${c.huong}</td><td style="text-align:left">${nhan.join(" · ") || "—"}</td></tr>`;
      })
      .join("");
  }

  // ---------- Toggle Bảng Kỳ Môn / Bảng Cách Cục ----------
  document.querySelectorAll<HTMLButtonElement>(".km-view-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>(".km-view-btn").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      document.getElementById("km-luoi-9-cung")!.classList.toggle("hidden", btn.dataset.view !== "ban");
      document.getElementById("km-bang-cach-cuc")!.classList.toggle("hidden", btn.dataset.view !== "cach-cuc");
    });
  });

  // ---------- Sub-tabs (Mệnh) ----------
  document.querySelectorAll<HTMLButtonElement>(".km-subtab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>(".km-subtab-btn").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      document.querySelectorAll<HTMLElement>(".km-subtab-panel").forEach((p) => p.classList.add("hidden"));
      document.getElementById(`km-subtab-${btn.dataset.subtab}`)!.classList.remove("hidden");
      if (btn.dataset.subtab === "lich") taiLichThang(lichNam, lichThang);
    });
  });

  // ---------- Tab Lịch ----------
  const THANG_LABEL = ["", "Một", "Hai", "Ba", "Tư", "Năm", "Sáu", "Bảy", "Tám", "Chín", "Mười", "Mười Một", "Mười Hai"];
  let lichNam = new Date().getFullYear();
  let lichThang = new Date().getMonth() + 1;

  async function taiLichThang(nam: number, thang: number) {
    lichNam = nam;
    lichThang = thang;
    document.getElementById("km-lich-title")!.textContent = `Tháng ${String(thang).padStart(2, "0")} năm ${nam}`;
    const body = document.getElementById("km-lich-body")!;
    body.innerHTML = '<tr><td colspan="7" style="padding:1rem;text-align:center;color:#7a6a5a">Đang tải...</td></tr>';
    try {
      const r = await fetch(`/api/kymon-lich?nam=${nam}&thang=${thang}`);
      const data: { ngayList?: NgayLichKyMon[]; error?: string } = await r.json();
      if (data.error || !data.ngayList) {
        body.innerHTML = `<tr><td colspan="7" style="padding:1rem;text-align:center;color:#c0261e">${data.error ?? "Lỗi tải lịch."}</td></tr>`;
        return;
      }
      // Lưới 7 cột: cột 0 = Chủ Nhật. Chèn ô trống trước ngày 1 cho khớp thứ trong tuần.
      const byNgay = new Map(data.ngayList.map((n) => [n.ngayDuong, n]));
      const soNgay = data.ngayList.length;
      const thu1 = new Date(nam, thang - 1, 1).getDay(); // 0=CN..6=T7
      const oCell = (n: NgayLichKyMon | null): string => {
        if (!n) return '<td class="trong"></td>';
        const cn = new Date(nam, thang - 1, n.ngayDuong).getDay() === 0 ? "cal-cn" : "";
        return `<td class="${cn}">
          <div class="cal-ngay">${String(n.ngayDuong).padStart(2, "0")}</div>
          <div class="cal-canchi">${n.can}${n.chi}</div>
          <div><span class="cal-kien">${n.kienTru}</span><span class="cal-tu">/${n.tu}</span></div>
        </td>`;
      };
      let html = "";
      let day = 1;
      for (let week = 0; day <= soNgay || week === 0; week++) {
        let row = "<tr>";
        for (let col = 0; col < 7; col++) {
          if (week === 0 && col < thu1) row += oCell(null);
          else if (day > soNgay) row += oCell(null);
          else row += oCell(byNgay.get(day++) ?? null);
        }
        row += "</tr>";
        html += row;
        if (day > soNgay) break;
      }
      body.innerHTML = html;
    } catch {
      body.innerHTML = '<tr><td colspan="7" style="padding:1rem;text-align:center;color:#c0261e">Không tải được lịch tháng.</td></tr>';
    }
  }

  document.getElementById("km-lich-prev")!.addEventListener("click", () => {
    const m = lichThang === 1 ? 12 : lichThang - 1;
    const y = lichThang === 1 ? lichNam - 1 : lichNam;
    taiLichThang(y, m);
  });
  document.getElementById("km-lich-next")!.addEventListener("click", () => {
    const m = lichThang === 12 ? 1 : lichThang + 1;
    const y = lichThang === 12 ? lichNam + 1 : lichNam;
    taiLichThang(y, m);
  });

  // ---------- Hỏi 1 việc cụ thể (Hỏi Đáp Kỳ Môn — chế độ Thời Gian/Bốc Độn, 199.000đ/lượt) ----------
  // Luồng thanh toán chạy INLINE ngay trên trang này (không có trang riêng): chọn chủ đề/câu hỏi
  // → xem giá → thanh toán QR → câu trả lời hiện ngay bên dưới sau khi xác nhận. PHẦN TỰ SINH CÂU
  // TRẢ LỜI theo chủ đề CHƯA CÓ (xem SPEC_danh_muc_cau_hoi_ky_mon.md) — result.ts trả về thông báo
  // "đang cập nhật" thay vì nội dung luận giải thật, làm sau theo từng chủ đề.
  const hdChuDeSel = document.getElementById("km-hd-chude") as HTMLSelectElement;
  const hdTinhHuongSel = document.getElementById("km-hd-tinhhuong") as HTMLSelectElement;
  const hdQuanHeSel = document.getElementById("km-hd-quanhe") as HTMLSelectElement;
  const hdCauHoiEl = document.getElementById("km-hd-cauhoi") as HTMLTextAreaElement;
  const hdBoSungEl = document.getElementById("km-hd-bosung") as HTMLTextAreaElement;
  const hdXemGiaBtn = document.getElementById("km-hd-xemgia-btn") as HTMLButtonElement;
  const hdFormWrap = document.getElementById("km-hd-thanhtoan-form-wrap")!;
  const hdTenEl = document.getElementById("km-hd-ten") as HTMLInputElement;
  const hdSdtEl = document.getElementById("km-hd-sdt") as HTMLInputElement;
  const hdEmailEl = document.getElementById("km-hd-email") as HTMLInputElement;
  const hdThanhToanBtn = document.getElementById("km-hd-thanhtoan-btn") as HTMLButtonElement;
  const hdDangChayEl = document.getElementById("km-hd-dangchay")!;
  const hdLoiEl = document.getElementById("km-hd-loi")!;
  const hdQrWrap = document.getElementById("km-hd-qr-wrap")!;
  const hdQrImg = document.getElementById("km-hd-qr") as HTMLImageElement;
  const hdOrderCodeEl = document.getElementById("km-hd-ordercode")!;
  const hdTrangThaiEl = document.getElementById("km-hd-trangthai")!;
  const hdSoTienEl = document.getElementById("km-hd-sotien")!;
  const hdKetQuaEl = document.getElementById("km-hd-ketqua")!;

  populateSelect(hdChuDeSel, DANH_MUC_CAU_HOI.map((c) => [c.id, c.nhan]));
  populateSelect(hdQuanHeSel, (Object.keys(QUAN_HE_LABELS) as QuanHeCauHoi[]).map((k) => [k, QUAN_HE_LABELS[k]]));

  function hdCapNhatGoiY() {
    const chuDe = DANH_MUC_CAU_HOI.find((c) => c.id === hdChuDeSel.value);
    const tinhHuong = chuDe?.tinhHuong.find((t) => t.id === hdTinhHuongSel.value);
    hdCauHoiEl.placeholder = tinhHuong?.cauHoiMau ?? "";
    hdBoSungEl.placeholder = tinhHuong?.inputThem ?? "Vd: giới tính, năm sinh người liên quan...";
  }
  function hdCapNhatTinhHuong() {
    const chuDe = DANH_MUC_CAU_HOI.find((c) => c.id === hdChuDeSel.value);
    populateSelect(hdTinhHuongSel, (chuDe?.tinhHuong ?? []).map((t) => [t.id, t.nhan]));
    hdCapNhatGoiY();
  }
  hdChuDeSel.addEventListener("change", hdCapNhatTinhHuong);
  hdTinhHuongSel.addEventListener("change", hdCapNhatGoiY);
  hdCapNhatTinhHuong();

  let hdPollTimer: ReturnType<typeof setInterval> | null = null;
  function hdDungCho() {
    if (hdPollTimer) {
      clearInterval(hdPollTimer);
      hdPollTimer = null;
    }
  }

  // Gọi lại mỗi khi lập bàn mới (renderLaBan) — đơn/QR cũ (nếu có) gắn với lá bàn cũ, không còn hợp lệ.
  function resetHoiDapWidget() {
    hdDungCho();
    hdFormWrap.classList.add("hidden");
    hdDangChayEl.classList.add("hidden");
    hdLoiEl.classList.add("hidden");
    hdQrWrap.classList.add("hidden");
    hdKetQuaEl.classList.add("hidden");
    hdKetQuaEl.innerHTML = "";
    hdThanhToanBtn.disabled = false;
    hdXemGiaBtn.classList.remove("hidden");
  }

  hdXemGiaBtn.addEventListener("click", () => {
    hdLoiEl.classList.add("hidden");
    if (!hdCauHoiEl.value.trim()) {
      hdLoiEl.textContent = "Vui lòng nhập câu hỏi của bạn.";
      hdLoiEl.classList.remove("hidden");
      hdCauHoiEl.focus();
      return;
    }
    hdFormWrap.classList.remove("hidden");
    hdFormWrap.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  async function hdKiemTra(orderCode: string) {
    try {
      const res = await fetch(`/api/dai-cat-loi/ky-mon-hoi-dap/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!data.ok) return;
      if (data.status === "cancelled") {
        hdDungCho();
        hdTrangThaiEl.textContent = "Đơn hàng đã bị hủy.";
        return;
      }
      if (data.status !== "confirmed") return;
      hdDungCho();
      hdQrWrap.classList.add("hidden");
      hdKetQuaEl.classList.remove("hidden");
      const echo = data.echo as { chuDe: string; tinhHuong: string; quanHe: string; cauHoi: string } | null;
      const echoHtml = echo
        ? `<p class="mt-2"><strong>Chủ đề:</strong> ${echo.chuDe} — ${echo.tinhHuong}</p>
           <p><strong>Bạn hỏi cho:</strong> ${echo.quanHe}</p>
           <p><strong>Câu hỏi:</strong> ${echo.cauHoi}</p>`
        : "";

      const ketQuaLuan = data.ketQuaLuan as { xuHuong: string; vanBan: string; chiTiet: string } | undefined;
      if (ketQuaLuan) {
        const XU_HUONG_NHAN: Record<string, string> = {
          thuan_loi: "🟢 Thuận lợi",
          can_luu_y: "🟡 Cần lưu ý",
          khong_thuan: "🔴 Không thuận",
        };
        hdKetQuaEl.innerHTML = `
          <p class="font-semibold text-(--color-cinnabar-400)">✅ Đã thanh toán — Câu trả lời</p>
          ${echoHtml}
          <p class="mt-3 font-semibold">${XU_HUONG_NHAN[ketQuaLuan.xuHuong] ?? ""}</p>
          <p class="mt-1">${ketQuaLuan.vanBan}</p>
          <details class="mt-2">
            <summary class="cursor-pointer text-xs text-(--color-ink-500)">Chi tiết kỹ thuật</summary>
            <p class="mt-1 text-xs text-(--color-ink-500)">${ketQuaLuan.chiTiet}</p>
          </details>
        `;
        return;
      }

      hdKetQuaEl.innerHTML = `
        <p class="font-semibold text-(--color-cinnabar-400)">✅ Đã thanh toán</p>
        ${echoHtml}
        <p class="mt-3">Đội ngũ Thiên Anh đang hoàn thiện phần luận giải tự động cho chủ đề này — câu trả lời chi tiết sẽ được gửi tới liên hệ bạn đã cung cấp sớm nhất.</p>
      `;
    } catch {
      // mạng chập chờn — nhịp sau thử lại
    }
  }

  hdThanhToanBtn.addEventListener("click", async () => {
    hdLoiEl.classList.add("hidden");
    if (!laBanHoiDap) {
      hdLoiEl.textContent = "Vui lòng lập lá bàn trước.";
      hdLoiEl.classList.remove("hidden");
      return;
    }
    if (!hdTenEl.value.trim() || !hdSdtEl.value.trim() || !hdEmailEl.value.trim()) {
      hdLoiEl.textContent = "Vui lòng nhập đầy đủ họ tên, số điện thoại và email.";
      hdLoiEl.classList.remove("hidden");
      return;
    }

    const payload: Record<string, unknown> = {
      ...laBanHoiDap,
      chuDeId: hdChuDeSel.value,
      tinhHuongId: hdTinhHuongSel.value,
      quanHe: hdQuanHeSel.value,
      cauHoi: hdCauHoiEl.value.trim(),
      thongTinBoSung: hdBoSungEl.value.trim(),
      customerName: hdTenEl.value.trim(),
      customerPhone: hdSdtEl.value.trim(),
      customerEmail: hdEmailEl.value.trim(),
    };

    hdDangChayEl.classList.remove("hidden");
    hdThanhToanBtn.disabled = true;
    try {
      const res = await fetch("/api/dai-cat-loi/ky-mon-hoi-dap/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      hdDangChayEl.classList.add("hidden");
      hdThanhToanBtn.disabled = false;
      if (!res.ok || !data.ok) {
        hdLoiEl.textContent = data.error ?? "Không tạo được đơn hàng.";
        hdLoiEl.classList.remove("hidden");
        return;
      }
      hdOrderCodeEl.textContent = data.orderCode;

      if (data.mienPhi) {
        hdDangChayEl.classList.remove("hidden");
        await hdKiemTra(data.orderCode);
        hdDangChayEl.classList.add("hidden");
        return;
      }

      hdSoTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
      hdQrImg.src = data.qrUrl;
      hdTrangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      hdFormWrap.classList.add("hidden");
      hdXemGiaBtn.classList.add("hidden");
      hdQrWrap.classList.remove("hidden");
      hdQrWrap.scrollIntoView({ behavior: "smooth", block: "start" });
      hdPollTimer = setInterval(() => hdKiemTra(data.orderCode), 3000);
    } catch {
      hdDangChayEl.classList.add("hidden");
      hdThanhToanBtn.disabled = false;
      hdLoiEl.textContent = "Có lỗi xảy ra. Vui lòng thử lại.";
      hdLoiEl.classList.remove("hidden");
    }
  });

  // ---------- Submit form ----------
  formLich.addEventListener("submit", (e) => {
    e.preventDefault();
    layBanLich();
  });
  form1080.addEventListener("submit", (e) => {
    e.preventDefault();
    layBan1080();
  });

  // ---------- Khởi động: mặc định giờ hiện tại, chế độ Giờ ----------
  datVaoForm(new Date());
  chonCheDo("gio");
  layBanLich();
</script>
