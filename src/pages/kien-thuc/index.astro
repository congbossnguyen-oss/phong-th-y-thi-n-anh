---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { posts } from "../../lib/placeholder-data";

export const prerender = true;
---

<BaseLayout title="Kiến thức phong thủy" description="Chia sẻ kiến thức phong thủy ứng dụng từ Thiên Anh.">
  <PageHero
    eyebrow="Kiến thức"
    title="Kiến thức phong thủy"
    description="Bài viết chuyên sâu, dễ hiểu, giúp bạn ứng dụng phong thủy vào cuộc sống hằng ngày."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Kiến thức" }]}
  />

  <Container class="py-16">
    <div class="mb-10 grid gap-4 sm:grid-cols-2">
      <a
        href="/kien-thuc/thuat-ngu-phong-thuy"
        class="flex items-center justify-between gap-4 rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-ivory-100) p-5 transition-colors hover:border-(--color-gold-400)"
      >
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-(--color-gold-500)">Tra cứu nhanh</p>
          <h2 class="mt-1 font-display text-lg font-semibold text-(--color-ink-950)">Thuật ngữ phong thủy</h2>
          <p class="mt-1 text-sm text-(--color-ink-600)">Ngũ Hành, Bát Trạch, Huyền Không, Bát Tự, Trạch Nhật...</p>
        </div>
        <span class="shrink-0 text-sm font-medium text-(--color-gold-300)">Xem ngay →</span>
      </a>
      <a
        href="/tra-cuu-menh"
        class="flex items-center justify-between gap-4 rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-ivory-100) p-5 transition-colors hover:border-(--color-gold-400)"
      >
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-(--color-gold-500)">Công cụ</p>
          <h2 class="mt-1 font-display text-lg font-semibold text-(--color-ink-950)">Tra cứu mệnh theo năm sinh</h2>
          <p class="mt-1 text-sm text-(--color-ink-600)">Can Chi, con giáp và mệnh Ngũ Hành Nạp Âm.</p>
        </div>
        <span class="shrink-0 text-sm font-medium text-(--color-gold-300)">Tra ngay →</span>
      </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/kien-thuc/${post.categorySlug}/${post.slug}`} class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50)">
          <div class="aspect-video overflow-hidden bg-(--color-ivory-200)">
            {post.image ? (
              <img src={post.image} alt={post.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="flex h-full items-center justify-center text-xs text-(--color-ink-500)">Ảnh đang cập nhật</div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs font-medium uppercase tracking-wide text-(--color-gold-500)">{post.category}</p>
            <h2 class="mt-2 font-display text-base font-semibold text-(--color-ink-950) group-hover:text-(--color-gold-300)">{post.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </Container>
</BaseLayout>
