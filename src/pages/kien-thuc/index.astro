---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import { posts } from "../../lib/placeholder-data";

export const prerender = true;
---

<BaseLayout title="Kiến thức phong thủy" description="Chia sẻ kiến thức phong thủy ứng dụng từ Thiên Anh.">
  <PageHero
    eyebrow="Kiến thức"
    title="Kiến thức phong thủy"
    description="Bài viết chuyên sâu, dễ hiểu, giúp bạn ứng dụng phong thủy vào cuộc sống hằng ngày."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Kiến thức" }]}
  />

  <Container class="py-16">
    <div class="grid gap-6 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/kien-thuc/${post.categorySlug}/${post.slug}`} class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50)">
          <div class="aspect-video bg-(--color-ivory-200)">
            <!-- TODO: ảnh bài viết thật từ Sanity -->
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs font-medium uppercase tracking-wide text-(--color-gold-500)">{post.category}</p>
            <h2 class="mt-2 font-display text-base font-semibold text-(--color-ink-950) group-hover:text-(--color-gold-300)">{post.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </Container>
</BaseLayout>
