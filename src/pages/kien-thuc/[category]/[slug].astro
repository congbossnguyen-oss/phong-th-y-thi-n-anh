---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/ui/PageHero.astro";
import Container from "../../../components/ui/Container.astro";
import { posts } from "../../../lib/placeholder-data";

export const prerender = true;

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { category: post.categorySlug, slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const siteUrl = (Astro.site ?? new URL("http://localhost:4321")).toString().replace(/\/$/, "");
const articleUrl = `${siteUrl}/kien-thuc/${post.categorySlug}/${post.slug}`;
const articleSchema = post.publishedAt
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: post.title,
      description: post.excerpt,
      image: post.image ? `${siteUrl}${post.image}` : undefined,
      datePublished: post.publishedAt,
      author: {
        "@type": "Person",
        name: "Zhi Gong",
        url: `${siteUrl}/gioi-thieu/chuyen-gia-zhi-gong`,
      },
      publisher: { "@type": "Organization", name: "Phong Thủy Thiên Anh" },
      mainEntityOfPage: articleUrl,
    }
  : null;
---

<BaseLayout title={post.title} description={post.excerpt}>
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  <PageHero
    eyebrow={post.category}
    title={post.title}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Kiến thức", href: "/kien-thuc" }, { label: post.title }]}
  />

  <Container class="py-16">
    <article class="mx-auto max-w-3xl">
      {post.image && (
        <div class="mb-8 aspect-video overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
          <img src={post.image} alt={post.title} class="h-full w-full object-cover" />
        </div>
      )}

      {post.content ? (
        post.content.map((block) => {
          if (typeof block === "string") {
            return <p class="mt-4 text-base leading-relaxed text-(--color-ink-700) first:mt-0">{block}</p>;
          }
          if ("heading" in block) {
            return <h2 class="mt-8 font-display text-xl font-semibold text-(--color-ink-950)">{block.heading}</h2>;
          }
          return (
            <ul class="mt-4 space-y-2">
              {block.list.map((item) => (
                <li class="flex items-start gap-2 text-base leading-relaxed text-(--color-ink-700)">
                  <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-(--color-gold-300)"></span>
                  {item}
                </li>
              ))}
            </ul>
          );
        })
      ) : (
        <>
          <p class="text-base leading-relaxed text-(--color-ink-700)">{post.excerpt}</p>
          <p class="mt-4 text-sm leading-relaxed text-(--color-ink-600)">
            Nội dung đầy đủ của bài viết sẽ được biên tập và đăng tải qua Sanity CMS (định dạng Portable Text)
            khi kết nối CMS thật ở Giai đoạn 2.
          </p>
        </>
      )}

      {post.relatedLinks && (
        <div class="mt-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-(--color-gold-500)">Khám phá thêm</p>
          <ul class="mt-3 space-y-2">
            {post.relatedLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm font-medium text-(--color-gold-300) hover:underline">
                  {link.label} →
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <a
        href="/gioi-thieu/chuyen-gia-zhi-gong"
        class="mt-10 flex items-center gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5 transition-colors hover:border-(--color-gold-400)/50"
      >
        <img src="/images/team/zhi-gong.jpg" alt="Zhi Gong" class="size-14 shrink-0 rounded-full object-cover" />
        <div>
          <p class="text-xs uppercase tracking-wide text-(--color-ink-600)">Tác giả</p>
          <p class="font-display text-base font-semibold text-(--color-ink-950)">Zhi Gong</p>
          <p class="mt-0.5 text-sm text-(--color-ink-600)">Chuyên gia phong thủy · Xem hồ sơ →</p>
        </div>
      </a>
    </article>
  </Container>
</BaseLayout>
