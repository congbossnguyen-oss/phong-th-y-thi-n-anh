---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/ui/PageHero.astro";
import Container from "../../../components/ui/Container.astro";
import { posts as placeholderPosts } from "../../../lib/placeholder-data";
import { getBlogPostBySlug } from "../../../lib/cms/queries";
import { portableTextToHtml } from "../../../lib/cms/portable-text";

// SSR: bài đăng/duyệt trong Sanity hiện lên web ngay, không cần build lại.
export const prerender = false;

const { category, slug } = Astro.params;

// Ưu tiên bài từ Sanity; chưa có thì fallback về bài mẫu tĩnh (giữ nội dung cũ).
const cmsPost = await getBlogPostBySlug(slug!);
let post: any = null;
let bodyHtml: string | null = null;

if (cmsPost) {
  // Chuẩn hóa URL: nếu danh mục trên URL không khớp danh mục thật -> 301 để tránh trùng lặp SEO.
  if (cmsPost.categorySlug && category !== cmsPost.categorySlug) {
    return Astro.redirect(`/kien-thuc/${cmsPost.categorySlug}/${slug}`, 301);
  }
  bodyHtml = portableTextToHtml(cmsPost.body as any);
  post = {
    title: cmsPost.title,
    seoTitle: cmsPost.seoTitle,
    excerpt: cmsPost.excerpt,
    category: cmsPost.category,
    categorySlug: cmsPost.categorySlug,
    image: cmsPost.image,
    imageAlt: cmsPost.imageAlt,
    publishedAt: cmsPost.publishedAt,
    content: null,
    relatedLinks: cmsPost.relatedLinks,
    faq: cmsPost.faq,
  };
} else {
  const found = placeholderPosts.find((p: any) => p.categorySlug === category && p.slug === slug);
  if (found) post = found;
}

if (!post) return new Response(null, { status: 404 });

const siteUrl = (Astro.site ?? new URL("http://localhost:4321")).toString().replace(/\/$/, "");
const articleUrl = `${siteUrl}/kien-thuc/${post.categorySlug}/${slug}`;
// Ảnh bìa SVG (tự tạo) hiển thị tốt trên trang, nhưng nhiều mạng xã hội không quét SVG cho thẻ chia sẻ —
// với ảnh SVG để OG rơi về ảnh thương hiệu mặc định; ảnh raster (jpg/png) vẫn dùng làm OG bình thường.
const isSvgCover = post.image ? String(post.image).toLowerCase().endsWith(".svg") : false;
const ogShareImage = post.image && !isSvgCover ? post.image : undefined;
const ogImageAbs = ogShareImage ? (String(ogShareImage).startsWith("http") ? ogShareImage : `${siteUrl}${ogShareImage}`) : undefined;

const articleSchema = post.publishedAt
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: post.title,
      description: post.excerpt,
      image: ogImageAbs,
      datePublished: post.publishedAt,
      author: { "@type": "Person", name: "Zhi Gong", url: `${siteUrl}/gioi-thieu/chuyen-gia-zhi-gong` },
      publisher: { "@type": "Organization", name: "Phong Thủy Thiên Anh" },
      mainEntityOfPage: articleUrl,
    }
  : null;

// Breadcrumb JSON-LD do component PageHero tự phát (từ prop breadcrumbs) — không khai báo lại ở đây.

const faqSchema =
  post.faq && post.faq.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: post.faq.map((f: any) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      }
    : null;
---

<BaseLayout title={post.seoTitle || post.title} description={post.excerpt} ogImage={ogShareImage}>
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <PageHero
    eyebrow={post.category}
    title={post.title}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Kiến thức", href: "/kien-thuc" }, { label: post.title }]}
  />

  <Container class="py-16">
    <article class="mx-auto max-w-3xl">
      {post.image && (
        <div class="mb-8 aspect-video overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
          <img src={post.image} alt={post.imageAlt || post.title} class="h-full w-full object-cover" />
        </div>
      )}

      {bodyHtml ? (
        <div set:html={bodyHtml} />
      ) : post.content ? (
        post.content.map((block: any) => {
          if (typeof block === "string") {
            return <p class="mt-4 text-base leading-relaxed text-(--color-ink-700) first:mt-0">{block}</p>;
          }
          if ("heading" in block) {
            return <h2 class="mt-8 font-display text-xl font-semibold text-(--color-ink-950)">{block.heading}</h2>;
          }
          return (
            <ul class="mt-4 space-y-2">
              {block.list.map((item: string) => (
                <li class="flex items-start gap-2 text-base leading-relaxed text-(--color-ink-700)">
                  <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-(--color-gold-300)"></span>
                  {item}
                </li>
              ))}
            </ul>
          );
        })
      ) : (
        <p class="text-base leading-relaxed text-(--color-ink-700)">{post.excerpt}</p>
      )}

      {post.relatedLinks && post.relatedLinks.length > 0 && (
        <div class="mt-10 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-(--color-gold-500)">Khám phá thêm</p>
          <ul class="mt-3 space-y-2">
            {post.relatedLinks.map((link: any) => (
              <li>
                <a href={link.href} class="text-sm font-medium text-(--color-gold-300) hover:underline">
                  {link.label} →
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <a
        href="/gioi-thieu/chuyen-gia-zhi-gong"
        class="mt-10 flex items-center gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5 transition-colors hover:border-(--color-gold-400)/50"
      >
        <img src="/images/team/zhi-gong.jpg" alt="Zhi Gong" class="size-14 shrink-0 rounded-full object-cover" />
        <div>
          <p class="text-xs uppercase tracking-wide text-(--color-ink-600)">Tác giả</p>
          <p class="font-display text-base font-semibold text-(--color-ink-950)">Zhi Gong</p>
          <p class="mt-0.5 text-sm text-(--color-ink-600)">Chuyên gia phong thủy · Xem hồ sơ →</p>
        </div>
      </a>
    </article>
  </Container>
</BaseLayout>
