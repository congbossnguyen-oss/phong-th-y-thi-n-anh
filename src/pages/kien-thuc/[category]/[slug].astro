---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/ui/PageHero.astro";
import Container from "../../../components/ui/Container.astro";
import { posts } from "../../../lib/placeholder-data";

export const prerender = true;

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { category: post.categorySlug, slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt}>
  <PageHero
    eyebrow={post.category}
    title={post.title}
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Kiến thức", href: "/kien-thuc" }, { label: post.title }]}
  />

  <Container class="py-16">
    <article class="mx-auto max-w-3xl">
      <p class="text-base leading-relaxed text-(--color-ink-700)">{post.excerpt}</p>
      <p class="mt-4 text-sm leading-relaxed text-(--color-ink-600)">
        Nội dung đầy đủ của bài viết sẽ được biên tập và đăng tải qua Sanity CMS (định dạng Portable Text)
        khi kết nối CMS thật ở Giai đoạn 2.
      </p>
    </article>
  </Container>
</BaseLayout>
