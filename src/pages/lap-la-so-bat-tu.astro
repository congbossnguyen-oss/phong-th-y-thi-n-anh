---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

export const prerender = true;
---

<BaseLayout
  title="Lập lá số Bát Tự (Tứ Trụ) đầy đủ"
  description="Nhập ngày giờ sinh để lập lá số Bát Tự: 4 trụ Can Chi, Đại Vận, Lưu Niên, Mệnh Cung, Thai Nguyên, Thần Sát — tải ảnh hoặc PDF về lưu."
>
  <PageHero
    eyebrow="Công cụ"
    title="Lập lá số Bát Tự (Tứ Trụ)"
    description="Nhập ngày giờ sinh (dương lịch, giờ Việt Nam) và giới tính để lập lá số đầy đủ, tải ảnh hoặc PDF về lưu."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Lập lá số Bát Tự" }]}
  />

  <Container class="py-16">
    <div class="mx-auto max-w-5xl">
      <form id="battu-form" class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="sm:col-span-1">
            <label for="bt-name" class="text-sm font-medium text-(--color-ink-800)">Họ tên (không bắt buộc)</label>
            <input id="bt-name" type="text" placeholder="Vô danh khách"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          </div>
          <div>
            <label for="bt-gender" class="text-sm font-medium text-(--color-ink-800)">Giới tính</label>
            <select id="bt-gender"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20">
              <option value="Nam">Nam</option>
              <option value="Nữ">Nữ</option>
            </select>
          </div>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-5">
          <div>
            <label for="bt-day" class="text-sm font-medium text-(--color-ink-800)">Ngày</label>
            <input id="bt-day" type="number" min="1" max="31" value="15" required
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          </div>
          <div>
            <label for="bt-month" class="text-sm font-medium text-(--color-ink-800)">Tháng</label>
            <input id="bt-month" type="number" min="1" max="12" value="6" required
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          </div>
          <div>
            <label for="bt-year" class="text-sm font-medium text-(--color-ink-800)">Năm</label>
            <input id="bt-year" type="number" min="1900" max="2100" value="1990" required
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          </div>
          <div>
            <label for="bt-hour" class="text-sm font-medium text-(--color-ink-800)">Giờ (0-23)</label>
            <input id="bt-hour" type="number" min="0" max="23" value="10" required
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          </div>
          <div>
            <label for="bt-minute" class="text-sm font-medium text-(--color-ink-800)">Phút</label>
            <input id="bt-minute" type="number" min="0" max="59" value="0" required
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) px-3.5 py-2.5 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20" />
          </div>
        </div>
        <p class="mt-3 text-xs text-(--color-ink-500)">
          Giờ sinh nhập theo giờ Việt Nam (UTC+7), 24 giờ. Ngày dương lịch. Sinh từ 23h trở đi được tự động tính
          sang trụ Ngày của ngày hôm sau theo quy ước "giờ Tý muộn".
        </p>
        <Button id="battu-submit" type="submit" size="lg" class="mt-5">Lập lá số</Button>
      </form>

      <div id="battu-result" class="mt-8 hidden">
        <!-- #battu-card nằm trong khung cao 0px + overflow hidden để không hiển thị trùng lặp "2 lá số"
             (chỉ dùng làm khuôn dựng ảnh) — không dùng display:none vì html-to-image cần phần tử có
             layout thật để chụp được. -->
        <div class="pointer-events-none h-0 overflow-hidden">
          <div id="battu-card" class="rounded-2xl border-2 border-amber-300 bg-white p-8 text-slate-900">
            <div class="flex flex-wrap items-start justify-between gap-4 border-b-2 border-amber-200 pb-4">
              <div class="flex items-center gap-3">
                <img src="/images/brand/zhi-gong-logo.png" alt="Phong Thủy Thiên Anh" class="size-12 rounded-full object-cover" />
                <div>
                  <p class="font-serif text-xl font-bold text-blue-900 whitespace-nowrap">TỨ TRỤ MỆNH BÀN</p>
                  <p class="text-xs font-semibold tracking-wide text-slate-600">PHONG THỦY THIÊN ANH</p>
                </div>
              </div>
              <div class="text-right text-sm font-medium text-slate-800">
                <p>Họ tên: <strong id="card-name" class="text-slate-900"></strong></p>
                <p>Giới tính: <strong id="card-gender" class="text-slate-900"></strong></p>
                <p>Dương lịch (GMT+7): <strong id="card-solar" class="text-slate-900"></strong></p>
                <p>Âm Dương hợp lịch: <strong id="card-lunar" class="text-slate-900"></strong></p>
              </div>
            </div>

            <div class="mt-4 overflow-x-auto">
              <table class="w-full min-w-[560px] border-collapse text-center text-sm">
                <tbody id="battu-main-table"></tbody>
              </table>
            </div>

            <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-600">Đại Vận</p>
                <p id="battu-daivan-note" class="text-xs font-medium text-slate-600"></p>
              </div>
              <div class="mt-2 overflow-x-auto">
                <table class="w-full min-w-[720px] border-collapse text-center text-sm">
                  <tbody id="battu-daivan-body"></tbody>
                </table>
              </div>
            </div>

            <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-xs font-bold uppercase tracking-wide text-slate-600">Lưu Niên (vận đang chọn)</p>
              <div class="mt-2 overflow-x-auto">
                <table class="w-full min-w-[720px] border-collapse text-center text-sm">
                  <tbody id="battu-luunien-body"></tbody>
                </table>
              </div>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-4">
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-600">Mệnh Cung / Thai Nguyên</p>
                <p id="battu-menh-cung" class="mt-2 text-sm font-medium text-slate-800"></p>
                <p class="mt-3 text-xs font-bold uppercase tracking-wide text-slate-600">Niên Không / Nhật Không</p>
                <p id="battu-khong-vong" class="mt-2 text-sm font-medium text-slate-800"></p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-600">Bảng Thần Sát Nguyên Cục</p>
                <div id="battu-thansat" class="mt-2 grid grid-cols-2 gap-2 text-xs font-medium text-slate-800"></div>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3 text-[11px] font-medium text-slate-600">
              <span class="inline-flex items-center gap-1"><span class="size-2.5 rounded-full bg-[#16a34a]"></span>Mộc</span>
              <span class="inline-flex items-center gap-1"><span class="size-2.5 rounded-full bg-[#dc2626]"></span>Hỏa</span>
              <span class="inline-flex items-center gap-1"><span class="size-2.5 rounded-full bg-[#8b5a2b]"></span>Thổ</span>
              <span class="inline-flex items-center gap-1"><span class="size-2.5 rounded-full bg-[#64748b]"></span>Kim</span>
              <span class="inline-flex items-center gap-1"><span class="size-2.5 rounded-full bg-[#2563eb]"></span>Thủy</span>
            </div>
          </div>
        </div>

        <div id="battu-preview-wrap" class="hidden">
          <img id="battu-preview-img" alt="Lá số Bát Tự" class="w-full rounded-2xl border-2 border-amber-300" />
          <p class="mt-2 text-xs text-(--color-ink-500)">Chuột phải (máy tính) / nhấn giữ (điện thoại) vào ảnh để lưu trực tiếp.</p>
        </div>

        <div class="mt-4 flex flex-wrap items-end gap-3">
          <div>
            <label for="battu-vanchon" class="text-xs font-medium text-(--color-ink-700)">Xem Lưu Niên của vận</label>
            <select id="battu-vanchon"
              class="mt-1 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm focus:border-(--color-gold-300) focus:outline-none focus:ring-2 focus:ring-(--color-gold-300)/20"></select>
          </div>
          <Button id="battu-save-image" type="button" variant="secondary">Lưu ảnh</Button>
          <Button id="battu-save-pdf" type="button" variant="secondary">Lưu PDF</Button>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-(--color-ink-600)">
          <strong>Lưu ý:</strong> Đây là công cụ lập lá số tự động, không thay thế luận giải chuyên sâu. Ngày/tháng
          khởi Đại Vận là ước tính (độ chính xác trung bình); tuổi và Can Chi từng vận đã được đối chiếu chính xác.
          Kết quả cần chuyên gia đối chiếu thêm về Dụng Thần, vượng suy, cách cục trước khi kết luận cát hung.
        </p>
        <a href="/dich-vu/bat-tu" class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline">
          Đặt lịch luận giải Bát Tự chuyên sâu →
        </a>
      </div>
    </div>

    <div class="mx-auto mt-10 max-w-5xl rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
      <h2 class="font-display text-lg font-semibold text-(--color-ink-950)">Tìm hiểu thêm</h2>
      <ul class="mt-3 space-y-2">
        <li>
          <a href="/kien-thuc/kien-thuc-ung-dung/bat-tu-la-gi" class="text-sm font-medium text-(--color-gold-300) hover:underline">
            Bát Tự là gì? Hướng dẫn tổng quan cho người mới bắt đầu →
          </a>
        </li>
        <li>
          <a href="/kien-thuc/thuat-ngu-phong-thuy" class="text-sm font-medium text-(--color-gold-300) hover:underline">
            Tra cứu thuật ngữ: Nhật Chủ, Tàng Can, Trường Sinh, Thập Thần... →
          </a>
        </li>
      </ul>
    </div>
  </Container>
</BaseLayout>

<script>
  import {
    tinhBatTu,
    tinhLuuNien,
    THAP_THAN_ABBR,
    CAN_NGU_HANH,
    CHI_NGU_HANH,
    CAN_AM_DUONG,
    type PillarInfo,
    type BatTuChart,
    type Gender,
  } from "../lib/bat-tu";
  import { solarToLunar } from "../lib/lunar-calendar";
  import type { NguHanh } from "../lib/menh-nap-am";

  const form = document.getElementById("battu-form") as HTMLFormElement;
  const resultEl = document.getElementById("battu-result")!;
  const cardEl = document.getElementById("battu-card")!;
  const mainTable = document.getElementById("battu-main-table")!;
  const cardNameEl = document.getElementById("card-name")!;
  const cardGenderEl = document.getElementById("card-gender")!;
  const cardSolarEl = document.getElementById("card-solar")!;
  const cardLunarEl = document.getElementById("card-lunar")!;
  const menhCungEl = document.getElementById("battu-menh-cung")!;
  const khongVongEl = document.getElementById("battu-khong-vong")!;
  const thanSatEl = document.getElementById("battu-thansat")!;
  const daiVanNoteEl = document.getElementById("battu-daivan-note")!;
  const daiVanBody = document.getElementById("battu-daivan-body")!;
  const luuNienBody = document.getElementById("battu-luunien-body")!;
  const previewWrap = document.getElementById("battu-preview-wrap")!;
  const previewImg = document.getElementById("battu-preview-img") as HTMLImageElement;
  const vanChonSelect = document.getElementById("battu-vanchon") as HTMLSelectElement;

  let currentChart: BatTuChart | null = null;
  let birthYear = 0;
  let previewDataUrl: string | null = null;

  // Chụp #battu-card thành PNG ở chế độ "xuất ảnh": tắt scroll ngang của các bảng rồi ĐO LẠI chiều rộng
  // thật sự cần thiết (thay vì áp 1 số cố định) — bảng Đại Vận/Lưu Niên có 10 cột, min-width 720px, nếu ép
  // khung hẹp hơn mức đó chữ cột cuối (vd "Quý Tỵ") sẽ bị cắt mất ở lề phải. Đo động đảm bảo không bao giờ
  // cắt chữ dù nội dung thay đổi sau này, đồng thời vẫn cho ảnh rộng rãi (tối thiểu 900px, ~1800px @2x).
  async function captureCardAsPng(): Promise<string> {
    const { toPng } = await import("html-to-image");
    const originalWidth = cardEl.style.width;
    const originalMaxWidth = cardEl.style.maxWidth;
    const scrollers = Array.from(cardEl.querySelectorAll<HTMLElement>(".overflow-x-auto"));
    const originalOverflow = scrollers.map((el) => el.style.overflow);
    try {
      cardEl.style.width = "max-content";
      cardEl.style.maxWidth = "none";
      scrollers.forEach((el) => (el.style.overflow = "visible"));
      const exportWidth = Math.max(cardEl.scrollWidth, 900);
      cardEl.style.width = `${exportWidth}px`;
      return await toPng(cardEl, { backgroundColor: "#ffffff", pixelRatio: 2, skipFonts: true, width: exportWidth });
    } finally {
      cardEl.style.width = originalWidth;
      cardEl.style.maxWidth = originalMaxWidth;
      scrollers.forEach((el, i) => (el.style.overflow = originalOverflow[i]));
    }
  }

  async function refreshPreviewImage() {
    try {
      previewDataUrl = await captureCardAsPng();
      previewImg.src = previewDataUrl;
      previewWrap.classList.remove("hidden");
    } catch (err) {
      console.error("Không tạo được ảnh xem trước:", err);
    }
  }

  // Màu tường minh (hex), không dùng tên màu Tailwind — đảm bảo html-to-image xuất ảnh ra đúng màu
  // (bảng màu mặc định Tailwind v4 định nghĩa bằng oklch(), html-to-image không parse được oklch()).
  const NGU_HANH_CLASS: Record<NguHanh, string> = {
    Mộc: "text-[#16a34a]", // xanh lá — Giáp Ất / Dần Mão
    Hỏa: "text-[#dc2626]", // đỏ — Bính Đinh / Tị Ngọ
    Thổ: "text-[#8b5a2b]", // nâu — Mậu Kỷ / Thìn Tuất Sửu Mùi
    Kim: "text-[#64748b]", // ghi (xám) — Canh Tân / Thân Dậu
    Thủy: "text-[#2563eb]", // xanh nước biển — Nhâm Quý / Tý Hợi
  };

  function canClass(canIndex: number): string {
    return NGU_HANH_CLASS[CAN_NGU_HANH[canIndex]];
  }

  function chiClass(chiIndex: number): string {
    return NGU_HANH_CLASS[CHI_NGU_HANH[chiIndex]];
  }

  function thapThanLabel(p: PillarInfo, isDay: boolean): string {
    if (isDay) return "NHẬT CHỦ";
    return THAP_THAN_ABBR[p.thapThan] ?? p.thapThan;
  }

  function renderMainTable(chart: BatTuChart, day: number, month: number, year: number, hour: number, minute: number) {
    const pillars: { p: PillarInfo; isDay: boolean }[] = [
      { p: chart.year, isDay: false },
      { p: chart.month, isDay: false },
      { p: chart.day, isDay: true },
      { p: chart.hour, isDay: false },
    ];

    const rowStyle = "border-b border-slate-200";
    const labelCell = (text: string) =>
      `<td class="p-2.5 text-left text-xs font-bold uppercase tracking-wide text-slate-600">${text}</td>`;

    const duongLichRow = `
      <tr class="${rowStyle} bg-slate-50">
        ${labelCell("Dương lịch")}
        <td class="p-2.5 font-semibold text-slate-800">${year}</td>
        <td class="p-2.5 font-semibold text-slate-800">${month}</td>
        <td class="p-2.5 font-semibold text-slate-800">${day}</td>
        <td class="p-2.5 font-semibold text-slate-800">${hour}:${String(minute).padStart(2, "0")}</td>
      </tr>
    `;

    const chuTinhRow = `
      <tr class="${rowStyle}">
        ${labelCell("Chủ tinh")}
        ${pillars
          .map(
            ({ p, isDay }) =>
              `<td class="p-2.5 text-sm ${isDay ? "font-bold text-blue-900" : "font-semibold text-slate-800"}">${thapThanLabel(p, isDay)}</td>`,
          )
          .join("")}
      </tr>
    `;

    const batTuRow = `
      <tr class="${rowStyle}">
        ${labelCell("Bát tự")}
        ${pillars
          .map(
            ({ p }) =>
              `<td class="p-2.5 font-serif text-3xl font-bold"><span class="${canClass(p.canIndex)}">${p.can}</span><br/><span class="${chiClass(p.chiIndex)}">${p.chi}</span></td>`,
          )
          .join("")}
      </tr>
    `;

    const tangCanRow = `
      <tr class="${rowStyle}">
        ${labelCell("Tàng ẩn")}
        ${pillars
          .map(
            ({ p }) =>
              `<td class="p-2.5"><div class="flex flex-wrap items-center justify-center gap-1.5">${p.tangCan
                .map((t) => `<span class="font-semibold ${canClass(t.canIndex)}">${t.can}</span>`)
                .join("")}</div></td>`,
          )
          .join("")}
      </tr>
    `;

    const phoTinhRow = `
      <tr class="${rowStyle}">
        ${labelCell("Phó tinh")}
        ${pillars
          .map(
            ({ p }) =>
              `<td class="p-2.5"><div class="flex flex-wrap items-center justify-center gap-1.5 text-xs font-semibold text-slate-600">${p.tangCan
                .map((t) => `<span>${THAP_THAN_ABBR[t.thapThan] ?? t.thapThan}</span>`)
                .join("")}</div></td>`,
          )
          .join("")}
      </tr>
    `;

    const truongSinhRow = `
      <tr class="${rowStyle}">
        ${labelCell("Trường sinh")}
        ${pillars.map(({ p }) => `<td class="p-2.5 text-sm font-semibold text-slate-800">${p.truongSinh}</td>`).join("")}
      </tr>
    `;

    const napAmRow = `
      <tr>
        ${labelCell("Nạp âm")}
        ${pillars.map(({ p }) => `<td class="p-2.5 text-sm font-semibold text-slate-800">${p.napAm}</td>`).join("")}
      </tr>
    `;

    mainTable.innerHTML = duongLichRow + chuTinhRow + batTuRow + tangCanRow + phoTinhRow + truongSinhRow + napAmRow;
  }

  function renderThanSat(chart: BatTuChart) {
    const labels: { key: keyof BatTuChart["thanSat"]; label: string }[] = [
      { key: "year", label: "Trụ Năm" },
      { key: "month", label: "Trụ Tháng" },
      { key: "day", label: "Trụ Ngày" },
      { key: "hour", label: "Trụ Giờ" },
    ];
    thanSatEl.innerHTML = labels
      .map(({ key, label }) => {
        const items = chart.thanSat[key];
        return `
          <div class="rounded-lg border border-slate-200 bg-white p-2">
            <p class="font-semibold text-slate-600">${label}</p>
            <p class="mt-0.5 font-semibold text-slate-800">${items.length ? items.join(", ") : "—"}</p>
          </div>
        `;
      })
      .join("");
  }

  // Vận thực tế (theo năm hiện tại thật) — đánh dấu độc lập với vận đang được bấm chọn để xem Lưu Niên.
  function findCurrentDaiVanIndex(chart: BatTuChart): number {
    const nowYear = new Date().getFullYear();
    let idx = -1;
    chart.daiVan.forEach((d, i) => {
      if (nowYear >= d.startDate.y && nowYear < d.startDate.y + 10) idx = i;
    });
    return idx;
  }

  function renderLuuNien(startYear: number) {
    const years = tinhLuuNien(startYear, birthYear, 10);
    const nowYear = new Date().getFullYear();
    luuNienBody.innerHTML = `
      <tr class="border-b border-slate-200">
        ${years
          .map(
            (y) =>
              `<td class="p-2 font-serif font-bold ${y.year === nowYear ? "rounded-md bg-amber-100" : ""}"><span class="${canClass(y.canIndex)}">${y.can}</span> <span class="${chiClass(y.chiIndex)}">${y.chi}</span></td>`,
          )
          .join("")}
      </tr>
      <tr>
        ${years
          .map(
            (y) =>
              `<td class="p-2 text-xs font-semibold text-slate-600 ${y.year === nowYear ? "rounded-md bg-amber-100 text-slate-800" : ""}">${y.year} — ${y.tuoi}t</td>`,
          )
          .join("")}
      </tr>
    `;
  }

  function renderDaiVan(chart: BatTuChart) {
    const currentIdx = findCurrentDaiVanIndex(chart);
    daiVanNoteEl.textContent = `Chiều: ${chart.daiVanForward ? "Thuận" : "Nghịch"}`;

    const rowCanChi = chart.daiVan
      .map(
        (d, i) =>
          `<td data-idx="${i}" class="rounded-md p-2 font-serif font-bold ${i === currentIdx ? "outline outline-2 outline-dashed outline-red-400" : ""}"><span class="${canClass(d.canIndex)}">${d.can}</span> <span class="${chiClass(d.chiIndex)}">${d.chi}</span></td>`,
      )
      .join("");
    const rowMeta = chart.daiVan
      .map(
        (d, i) =>
          `<td data-idx="${i}" class="rounded-md p-2 text-xs font-semibold text-slate-600 ${i === currentIdx ? "text-red-500" : ""}">${d.startAge}-${d.endAge}t<br/>~${d.startDate.d}/${d.startDate.m}/${d.startDate.y}</td>`,
      )
      .join("");
    daiVanBody.innerHTML = `
      <tr class="border-b border-slate-200">${rowCanChi}</tr>
      <tr>${rowMeta}</tr>
    `;

    vanChonSelect.innerHTML = chart.daiVan
      .map(
        (d, i) =>
          `<option value="${i}">${d.can} ${d.chi} (${d.startAge}-${d.endAge}t, ${d.startDate.y})${i === currentIdx ? " — hiện tại" : ""}</option>`,
      )
      .join("");

    selectDaiVan(currentIdx >= 0 ? currentIdx : 0);
  }

  function selectDaiVan(idx: number) {
    if (!currentChart) return;
    vanChonSelect.value = String(idx);
    daiVanBody.querySelectorAll<HTMLElement>("td[data-idx]").forEach((cell) => {
      const cellIdx = parseInt(cell.dataset.idx || "-1", 10);
      cell.classList.toggle("bg-amber-100", cellIdx === idx);
    });
    const period = currentChart.daiVan[idx];
    renderLuuNien(period.startDate.y);
    refreshPreviewImage();
  }

  function fileNameSlug(name: string, year: number, month: number, day: number): string {
    const base = name.trim() ? name.trim().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/gi, "d").replace(/[^a-zA-Z0-9]+/g, "-") : "la-so-bat-tu";
    return `${base}-${day}-${month}-${year}`.replace(/-+/g, "-").toLowerCase();
  }

  let lastFileBase = "la-so-bat-tu";

  vanChonSelect.addEventListener("change", () => {
    selectDaiVan(parseInt(vanChonSelect.value, 10));
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (document.getElementById("bt-name") as HTMLInputElement).value;
    const day = parseInt((document.getElementById("bt-day") as HTMLInputElement).value, 10);
    const month = parseInt((document.getElementById("bt-month") as HTMLInputElement).value, 10);
    const year = parseInt((document.getElementById("bt-year") as HTMLInputElement).value, 10);
    const hour = parseInt((document.getElementById("bt-hour") as HTMLInputElement).value, 10);
    const minute = parseInt((document.getElementById("bt-minute") as HTMLInputElement).value, 10) || 0;
    const gender = (document.getElementById("bt-gender") as HTMLSelectElement).value as Gender;

    if (!day || !month || !year || Number.isNaN(hour)) return;

    try {
      const chart = tinhBatTu({ day, month, year, hour, minute, gender });
      currentChart = chart;
      birthYear = year;
      lastFileBase = fileNameSlug(name, year, month, day);

      cardNameEl.textContent = name.trim() || "Vô danh khách";
      cardGenderEl.textContent = `${CAN_AM_DUONG[chart.year.canIndex]} ${gender}`;
      cardSolarEl.textContent = `${hour}:${String(minute).padStart(2, "0")} - ${day}/${month}/${year}`;
      const lunar = solarToLunar(day, month, year);
      cardLunarEl.textContent = `${hour}:${String(minute).padStart(2, "0")} - ${lunar.day}/${lunar.month}${lunar.isLeapMonth ? " (nhuận)" : ""}/${lunar.year}`;

      renderMainTable(chart, day, month, year, hour, minute);
      menhCungEl.innerHTML = `Mệnh Cung: <strong>${chart.menhCung.can} ${chart.menhCung.chi}</strong><br/>Thai Nguyên: <strong>${chart.thaiNguyen.can} ${chart.thaiNguyen.chi}</strong>`;
      khongVongEl.innerHTML = `Niên Không: <strong>${chart.nienKhong}</strong><br/>Nhật Không: <strong>${chart.nhatKhong}</strong>`;
      renderThanSat(chart);
      renderDaiVan(chart);

      resultEl.classList.remove("hidden");
      resultEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch (err) {
      alert("Không tính được lá số cho ngày giờ này, vui lòng kiểm tra lại thông tin nhập vào.");
    }
  });

  // Dùng html-to-image (render qua SVG foreignObject + engine trình duyệt thật) thay vì html2canvas,
  // vì html2canvas tự parse CSS và KHÔNG hỗ trợ oklch() — màu mặc định của Tailwind v4 — sẽ báo lỗi vỡ chức năng.
  document.getElementById("battu-save-image")?.addEventListener("click", async () => {
    if (!currentChart) return;
    try {
      const dataUrl = previewDataUrl ?? (await captureCardAsPng());
      const link = document.createElement("a");
      link.download = `${lastFileBase}.png`;
      link.href = dataUrl;
      link.click();
    } catch (err) {
      console.error("Không tạo được ảnh:", err);
      alert("Không tạo được ảnh, vui lòng thử lại.");
    }
  });

  document.getElementById("battu-save-pdf")?.addEventListener("click", async () => {
    if (!currentChart) return;
    try {
      const { jsPDF } = await import("jspdf");
      const dataUrl = previewDataUrl ?? (await captureCardAsPng());
      const img = new Image();
      img.src = dataUrl;
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = reject;
      });
      const pdf = new jsPDF({
        orientation: img.width > img.height ? "landscape" : "portrait",
        unit: "px",
        format: [img.width, img.height],
      });
      pdf.addImage(dataUrl, "PNG", 0, 0, img.width, img.height);
      pdf.save(`${lastFileBase}.pdf`);
    } catch (err) {
      console.error("Không tạo được file PDF:", err);
      alert("Không tạo được file PDF, vui lòng thử lại.");
    }
  });
</script>
