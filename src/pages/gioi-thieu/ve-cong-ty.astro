---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Icon from "../../components/ui/Icon.astro";
import { siteConfig } from "../../lib/site-config";

export const prerender = true;

const values = [
  { title: "Chính đạo", desc: "Luận giải trung thực, không phóng đại, đặt lợi ích khách hàng lên hàng đầu." },
  { title: "Chuyên sâu", desc: "Đội ngũ chuyên gia được đào tạo bài bản, cập nhật kiến thức liên tục." },
  { title: "Đồng hành", desc: "Tư vấn dài hạn, hỗ trợ sau tư vấn chứ không dừng lại ở một buổi gặp." },
];
---

<BaseLayout title="Phong Thủy Thiên Anh" description="Câu chuyện thương hiệu và giá trị cốt lõi của Phong Thủy Thiên Anh.">
  <PageHero
    eyebrow="Giới thiệu"
    title="Về Phong Thủy Thiên Anh"
    description="Hơn một đơn vị tư vấn phong thủy, Thiên Anh là người bạn đồng hành trên hành trình kiến tạo cuộc sống an lành."
    breadcrumbs={[{ label: "Trang chủ", href: "/" }, { label: "Phong Thủy Thiên Anh" }]}
  />

  <section class="border-b border-(--color-ivory-300) py-16">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-display text-xl leading-relaxed text-(--color-ink-950) sm:text-2xl">
          Mỗi ngôi nhà đều có linh hồn. Mỗi con người đều có một hành trình.
        </p>
        <p class="mt-5 text-base leading-relaxed text-(--color-ink-600) sm:text-lg">
          Phong Thủy Thiên Anh đồng hành bằng cái <strong class="text-(--color-gold-300)">Tâm</strong> của người
          nghiên cứu, cái <strong class="text-(--color-gold-300)">Đức</strong> của người hành nghề và sự{" "}
          <strong class="text-(--color-gold-300)">chân thành</strong> của người phụng sự, để mỗi lời tư vấn
          không chỉ giải quyết một vấn đề, mà còn gieo thêm bình an, niềm tin và giá trị lâu dài cho cuộc sống.
        </p>
      </div>
    </Container>
  </section>

  <Container class="grid gap-12 py-16 lg:grid-cols-2 lg:items-center">
    <div>
      <h2 class="font-display text-2xl font-semibold text-(--color-ink-950)">Câu chuyện của chúng tôi</h2>
      <p class="mt-4 text-base leading-relaxed text-(--color-ink-600)">
        {siteConfig.name} được thành lập bởi đội ngũ chuyên gia phong thủy nhiều năm kinh nghiệm, với mong muốn
        đưa kiến thức phong thủy cổ truyền đến gần hơn với đời sống hiện đại. Chúng tôi tin rằng phong thủy không
        phải điều huyền bí, mà là khoa học ứng dụng giúp con người sống hài hòa với không gian xung quanh.
      </p>
      <p class="mt-4 text-base leading-relaxed text-(--color-ink-600)">
        Từ tư vấn nhà ở, văn phòng đến các quyết định quan trọng trong đời sống và kinh doanh, Thiên Anh luôn
        đặt sự chính xác, trung thực và đồng hành lâu dài lên hàng đầu.
      </p>
      <a
        href="/gioi-thieu/chuyen-gia-zhi-gong"
        class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300) hover:underline"
      >
        Tìm hiểu về chuyên gia Zhi Gong →
      </a>
    </div>
    <div class="aspect-4/3 overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200)">
      <img src="/images/team/zhi-gong-office.jpg" alt={siteConfig.name} class="h-full w-full object-cover" />
    </div>
  </Container>

  <section class="border-t border-(--color-ivory-300) py-16">
    <Container class="grid gap-8 lg:grid-cols-2 lg:items-center">
      <div class="aspect-4/3 overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-200) lg:order-2">
        <img
          src="/images/team/toa-dam-thiet-ke-noi-that-chung-cu.jpg"
          alt="Phong Thủy Thiên Anh tham gia tọa đàm Xu hướng thiết kế nội thất căn hộ chung cư cao tầng trong kỷ nguyên 4.0"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="lg:order-1">
        <h2 class="font-display text-2xl font-semibold text-(--color-ink-950)">Hoạt động chuyên môn</h2>
        <p class="mt-4 text-base leading-relaxed text-(--color-ink-600)">
          Phong thủy Thiên Anh vinh dự tham gia tọa đàm chuyên đề "Xu hướng thiết kế nội thất căn hộ chung cư cao
          tầng trong kỷ nguyên 4.0" do Chi hội Kiến trúc Nội thất – Hội Kiến trúc sư Hà Nội tổ chức. Tại chương
          trình, chuyên gia Zhi Gong chia sẻ các góc nhìn về sự kết hợp giữa kiến trúc hiện đại, công nghệ thông
          minh và phong thủy ứng dụng, giúp tối ưu không gian sống, nâng cao giá trị công trình và mang lại môi
          trường sống hài hòa, bền vững cho gia chủ.
        </p>
      </div>
    </Container>
  </section>

  <section class="bg-(--color-ivory-100) py-16">
    <Container>
      <h2 class="font-display text-2xl font-semibold text-(--color-ink-950)">Giá trị cốt lõi</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {values.map((v) => (
          <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
            <Icon name="check-circle" class="size-6 text-(--color-gold-300)" />
            <h3 class="mt-3 font-display text-lg font-semibold text-(--color-ink-950)">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-(--color-ink-600)">{v.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
