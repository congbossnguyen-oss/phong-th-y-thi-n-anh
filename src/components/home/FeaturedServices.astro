---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import { services } from "../../lib/placeholder-data";
---

<section class="py-16 sm:py-20">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Dịch vụ"
        title="Dịch vụ tư vấn phong thủy"
        description="Các gói tư vấn được thiết kế riêng theo nhu cầu nhà ở, kinh doanh và các cột mốc quan trọng."
      />
      <a href="/dich-vu" class="text-sm font-medium text-(--color-cinnabar-500) hover:underline">Xem tất cả dịch vụ →</a>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <a
          href={`/dich-vu/${service.slug}`}
          class="group flex flex-col rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6 transition-shadow hover:shadow-lg"
        >
          <span class="flex size-11 items-center justify-center rounded-full bg-(--color-cinnabar-500)/10 text-(--color-cinnabar-400)">
            <Icon name="check-circle" class="size-5" />
          </span>
          <h3 class="mt-4 font-display text-lg font-semibold text-(--color-ink-950)">{service.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{service.summary}</p>
          <div class="mt-4 flex items-center justify-between border-t border-(--color-ivory-300) pt-4 text-sm">
            <span class="text-(--color-ink-600)">Chi phí: <strong class="text-(--color-cinnabar-500)">{service.priceFrom}</strong></span>
            <Icon name="arrow-right" class="size-4 text-(--color-ink-400) transition-transform group-hover:translate-x-1 group-hover:text-(--color-cinnabar-500)" />
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
