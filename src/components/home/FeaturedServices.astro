---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import { services } from "../../lib/placeholder-data";
---

<section class="py-16 sm:py-20">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Dịch vụ"
        title="Dịch vụ tư vấn phong thủy"
        description="Các gói tư vấn được thiết kế riêng theo nhu cầu nhà ở, kinh doanh và các cột mốc quan trọng."
      />
      <a href="/dich-vu" class="text-sm font-medium text-(--color-gold-300) hover:underline">Xem tất cả dịch vụ →</a>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <a
          href={`/dich-vu/${service.slug}`}
          class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) transition-colors hover:border-(--color-gold-400)/50"
        >
          <div class="aspect-4/3 overflow-hidden bg-(--color-ivory-200)">
            <img
              src={service.image}
              alt={service.name}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="font-display text-lg font-semibold text-(--color-ink-950)">{service.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{service.summary}</p>
            <div class="mt-4 flex items-center justify-between border-t border-(--color-ivory-300) pt-4 text-sm">
              <span class="text-(--color-ink-600)">Chi phí: <strong class="text-(--color-gold-300)">{service.priceFrom}</strong></span>
              <Icon name="arrow-right" class="size-4 text-(--color-ink-400) transition-transform group-hover:translate-x-1 group-hover:text-(--color-gold-300)" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
