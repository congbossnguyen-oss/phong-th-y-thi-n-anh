---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { portfolio } from "../../lib/placeholder-data";

const items = portfolio.slice(0, 6);
---

<section class="bg-(--color-ivory-100) py-16 sm:py-20">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Công trình"
        title="Công trình Thiên Anh đã thực hiện"
        description="Một số dự án tiêu biểu đã được đội ngũ Thiên Anh tư vấn và đồng hành."
      />
      <a href="/cong-trinh" class="text-sm font-medium text-(--color-gold-300) hover:underline">Xem công trình →</a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4">
      {items.map((item) => (
        <a href={`/cong-trinh/${item.slug}`} class="group overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50)">
          <div class="aspect-4/3 overflow-hidden bg-(--color-ivory-200)">
            {item.image ? (
              <img src={item.image} alt={item.title} class="h-full w-full object-cover" loading="lazy" />
            ) : (
              <div class="flex h-full items-center justify-center text-xs text-(--color-ink-500)">Ảnh đang cập nhật</div>
            )}
          </div>
          <div class="p-3">
            <h3 class="font-display text-sm font-semibold text-(--color-ink-950) group-hover:text-(--color-gold-300)">{item.title}</h3>
            {item.location && <p class="mt-0.5 text-xs text-(--color-ink-600)">{item.location}</p>}
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
