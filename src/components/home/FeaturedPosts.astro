---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import { posts } from "../../lib/placeholder-data";
---

<section class="bg-(--color-ivory-100) py-16 sm:py-20">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Kiến thức"
        title="Bài viết mới nhất"
        description="Chia sẻ kiến thức phong thủy ứng dụng cho cuộc sống hiện đại."
      />
      <a href="/kien-thuc" class="text-sm font-medium text-(--color-gold-300) hover:underline">Xem tất cả bài viết →</a>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/kien-thuc/${post.categorySlug}/${post.slug}`}
          class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) transition-colors hover:border-(--color-gold-400)/50"
        >
          <div class="aspect-video bg-(--color-ivory-200)">
            <!-- TODO: ảnh bài viết thật từ Sanity -->
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs font-medium uppercase tracking-wide text-(--color-gold-500)">{post.category}</p>
            <h3 class="mt-2 font-display text-base font-semibold text-(--color-ink-950) group-hover:text-(--color-gold-300)">
              {post.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-ink-600)">{post.excerpt}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-(--color-gold-300)">
              Đọc tiếp <Icon name="arrow-right" class="size-3.5" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
