---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { siteConfig } from "../../lib/site-config";
---

<section class="bg-(--color-cinnabar-500) py-14">
  <Container class="flex flex-col items-center gap-5 text-center">
    <h2 class="font-display text-2xl font-semibold text-(--color-gold-100) sm:text-3xl">
      Sẵn sàng đón vượng khí cho tổ ấm và sự nghiệp của bạn?
    </h2>
    <p class="max-w-xl text-sm text-(--color-gold-100)/80 sm:text-base">
      Đặt lịch tư vấn cùng chuyên gia Thiên Anh ngay hôm nay — hoàn toàn miễn phí bước tư vấn đầu tiên.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/lien-he" size="lg" class="bg-(--color-gold-100)! text-(--color-cinnabar-700)! hover:bg-(--color-gold-300)!">
        Đặt lịch ngay
      </Button>
      <Button href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`} variant="secondary" size="lg" class="border-(--color-gold-100) text-(--color-gold-100) hover:bg-(--color-gold-100)/10">
        Gọi {siteConfig.hotline}
      </Button>
    </div>
  </Container>
</section>
