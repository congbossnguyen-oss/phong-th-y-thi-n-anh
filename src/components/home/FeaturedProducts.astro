---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { products } from "../../lib/placeholder-data";

const formatPrice = (price: number) =>
  price.toLocaleString("vi-VN", { style: "currency", currency: "VND" });
---

<section class="bg-(--color-ivory-100) py-16 sm:py-20">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Cửa hàng"
        title="Vật phẩm phong thủy nổi bật"
        description="Vật phẩm được lựa chọn kỹ lưỡng, hợp mệnh, hỗ trợ chiêu tài và hóa giải vận hạn."
      />
      <a href="/vat-pham" class="text-sm font-medium text-(--color-cinnabar-500) hover:underline">Xem cửa hàng →</a>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((product) => (
        <div class="flex flex-col overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50)">
          <a href={`/vat-pham/${product.slug}`} class="aspect-square bg-(--color-ivory-200)">
            <!-- TODO: ảnh sản phẩm thật từ Sanity -->
          </a>
          <div class="flex flex-1 flex-col p-4">
            <p class="text-xs uppercase tracking-wide text-(--color-gold-500)">{product.category}</p>
            <a href={`/vat-pham/${product.slug}`} class="mt-1 font-display text-base font-semibold text-(--color-ink-950) hover:text-(--color-cinnabar-500)">
              {product.name}
            </a>
            <p class="mt-2 text-base font-semibold text-(--color-cinnabar-500)">{formatPrice(product.price)}</p>
            <Button
              size="md"
              class="js-add-to-cart mt-3 w-full"
              data-slug={product.slug}
              data-name={product.name}
              data-price={String(product.price)}
            >
              Thêm vào giỏ
            </Button>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
