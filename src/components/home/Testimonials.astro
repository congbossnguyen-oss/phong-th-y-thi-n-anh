---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import { testimonials } from "../../lib/placeholder-data";
---

<section class="py-16 sm:py-20">
  <Container>
    <SectionHeading
      eyebrow="Đánh giá"
      title="Khách hàng nói gì về Thiên Anh"
      align="center"
    />

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {testimonials.map((item) => (
        <figure class="flex flex-col rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-6">
          <div class="flex gap-0.5 text-(--color-gold-400)" aria-hidden="true">
            {Array.from({ length: item.rating }).map(() => (
              <Icon name="star" class="size-4" />
            ))}
          </div>
          <span class="sr-only">{item.rating} trên 5 sao</span>
          <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-(--color-ink-800)">
            “{item.quote}”
          </blockquote>
          <figcaption class="mt-4 border-t border-(--color-ivory-300) pt-4">
            <p class="text-sm font-semibold text-(--color-ink-950)">{item.name}</p>
            <p class="text-xs text-(--color-ink-600)">{item.role}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </Container>
</section>
