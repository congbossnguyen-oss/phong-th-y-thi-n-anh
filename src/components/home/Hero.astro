---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { siteConfig } from "../../lib/site-config";
---

<section class="relative overflow-hidden bg-(--color-ink-950)">
  <!-- Hoạ tiết vân mây Á Đông trang trí, không mang nội dung -->
  <svg
    class="pointer-events-none absolute -right-24 -top-24 size-[36rem] text-(--color-gold-500)/10"
    viewBox="0 0 200 200"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="100" cy="100" r="99" stroke="currentColor" stroke-width="1" />
    <circle cx="100" cy="100" r="72" stroke="currentColor" stroke-width="1" />
  </svg>

  <Container class="relative grid gap-12 py-20 lg:grid-cols-2 lg:items-center lg:py-28">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-(--color-gold-500)/40 px-3.5 py-1.5 text-xs font-medium uppercase tracking-wide text-(--color-gold-300)">
        Tư vấn phong thủy chuyên sâu
      </p>
      <h1 class="font-display text-4xl font-semibold leading-tight text-(--color-ivory-50) sm:text-5xl lg:text-[3.25rem]">
        {siteConfig.tagline}
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-(--color-ivory-300) sm:text-lg">
        {siteConfig.name} đồng hành cùng bạn trong mọi quyết định quan trọng — từ chọn hướng nhà,
        bài trí không gian sống, đến chọn ngày lành cho những cột mốc lớn của cuộc đời.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/lien-he" size="lg">
          Đặt lịch tư vấn
          <Icon name="arrow-right" class="size-4" />
        </Button>
        <Button href="/dich-vu" variant="secondary" size="lg" class="border-(--color-ivory-300) text-(--color-ivory-50) hover:bg-(--color-ivory-50)/10">
          Xem dịch vụ
        </Button>
      </div>
    </div>

    <div class="relative">
      <div class="aspect-4/5 w-full max-w-md justify-self-end overflow-hidden rounded-(--radius-card) border border-(--color-gold-500)/30 bg-gradient-to-br from-(--color-ink-800) to-(--color-ink-950)">
        <!-- TODO: thay bằng ảnh chuyên gia/không gian tư vấn thật -->
        <div class="flex h-full items-center justify-center text-(--color-ivory-400)">
          <span class="text-sm">Ảnh đại diện chuyên gia Thiên Anh</span>
        </div>
      </div>
    </div>
  </Container>
</section>
