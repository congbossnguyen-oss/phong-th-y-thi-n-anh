---
// Khu "PHÒNG CÔNG CỤ" — trưng bày bộ công cụ tra cứu tự động của Thiên Anh.
//
// Lý do thêm (yêu cầu Công "muốn thật đặc sắc"): đây là tài sản mạnh nhất và khác biệt nhất của site —
// hơn 20 công cụ tính toán CHẠY THẬT (Tử Vi Đẩu Số, Bát Tự, Lục Hào Kinh Dịch, trạch nhật...) mà trang chủ
// cũ không hề nhắc tới một dòng nào. Đối thủ tham chiếu (phongthuyminhtuan.com) chỉ có đúng 1 công cụ (la
// bàn xem hướng nhà) nhưng dựng hẳn 1 banner lớn giữa trang chủ cho nó — cho thấy đây là thứ đáng khoe.
//
// Số lượng công cụ được TÍNH ĐỘNG từ chính danh sách nguồn (dai-cat-loi-tools.ts + CORE_TOOLS) để con số
// không bao giờ bị lệch khi thêm/bớt công cụ về sau.
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import { TOTAL_TOOL_COUNT } from "../../lib/dai-cat-loi-tools";

type IconName = "star" | "book-open" | "moon" | "clock" | "award" | "map-pin" | "phone";

// 7 công cụ đầu tàu đưa lên trang chủ. Các công cụ còn lại gom trong "Đại Cát Lợi" + trang tra cứu riêng.
// Mỗi thẻ dùng 1 ảnh banner do Công cung cấp (đặt sẵn trong public/, đã đổi tên bỏ khoảng trắng) làm NỀN
// TOÀN THẺ kiểu poster — ảnh tự thân đã có tên công cụ trong thiết kế nên thẻ chỉ còn icon + nút "Dùng
// thử ngay" đè lên qua lớp gradient tối dần từ dưới lên (xem markup bên dưới), không lặp lại chữ tiêu
// đề/mô tả. `title` vẫn giữ để làm alt ảnh + aria-label cho khả năng tiếp cận (screen reader).
// Lưu ý: các ảnh này không cùng 1 bộ nhận diện (nhiều phong cách/logo khác nhau) — đã xác nhận với Công
// dùng nguyên như vậy, không chờ làm lại đồng bộ.
// Ảnh dùng WebP thay cho PNG gốc — giảm ~65-92% dung lượng mà mắt thường không phân biệt được, tải
// nhanh hơn nhiều trên 3G/4G. File PNG gốc vẫn giữ trong public/ để cần thì xuất lại.
//
// Công 22/8/2026: đổi 3 thẻ (Lập lá số Tử Vi → Xem ngày cao cấp, Lập lá số Bát Tự → Luận số điện
// thoại, Lập quẻ Kinh Dịch → Dịch vụ VIP) + thêm thẻ Định Hướng Nghề Nghiệp.
const CORE_TOOLS: { href: string; icon: IconName; image: string; title: string }[] = [
  {
    href: "/dai-cat-loi/xem-ngay-cao-cap",
    icon: "clock",
    image: "/lap-la-so-tu-vi.webp",
    title: "Xem Ngày Cao Cấp",
  },
  {
    href: "/luan-so-dien-thoai",
    icon: "phone",
    image: "/lap-la-so-bat-tu.webp",
    title: "Luận Số Điện Thoại",
  },
  {
    href: "/dai-cat-loi/dich-vu-thu-phi",
    icon: "star",
    image: "/dich-vu-vip.webp",
    title: "Dịch Vụ VIP",
  },
  {
    href: "/xem-ngay-tot-xau",
    icon: "clock",
    image: "/xem-ngay-tot-xau-v2.webp",
    title: "Xem ngày tốt xấu",
  },
  {
    href: "/dai-cat-loi",
    icon: "award",
    image: "/dai-cat-loi-v2.webp",
    title: "Đại Cát Lợi",
  },
  {
    href: "/dai-cat-loi/ngay-gio-xuat-hanh",
    icon: "map-pin",
    image: "/ngay-gio-xuat-hanh-ca-nhan.webp",
    title: "Ngày Giờ Xuất Hành Cá Nhân",
  },
  {
    href: "/dai-cat-loi/dinh-huong-nghe-nghiep",
    icon: "book-open",
    image: "/dinh-huong-nghe-nghiep.webp",
    title: "Định Hướng Nghề Nghiệp",
  },
];

// Dùng chung TOTAL_TOOL_COUNT với khối số liệu (StatsSection) để 2 chỗ không bao giờ hiện 2 con số khác
// nhau. Thẻ "Đại Cát Lợi" trong CORE_TOOLS chỉ là cửa vào của nhóm, không tính thành 1 công cụ riêng.
const totalTools = TOTAL_TOOL_COUNT;
---

<section class="relative overflow-hidden bg-(--color-ivory-50) py-16 sm:py-20">
  {/* Vầng sáng vàng mờ phía sau, thuần trang trí */}
  <div
    class="pointer-events-none absolute left-1/2 top-0 size-[36rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-(--color-gold-500)/10 blur-3xl"
  >
  </div>

  <Container class="relative">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-(--color-gold-300)">Miễn phí — không cần đăng ký</p>
      <h2 class="mt-2 font-display text-3xl font-semibold text-(--color-ink-950) sm:text-4xl">
        <span class="text-(--color-gold-300)">{totalTools} công cụ</span> tra cứu tự động
      </h2>
      <p class="mt-4 text-base leading-relaxed text-(--color-ink-700)">
        Không chỉ là nơi để đọc — Thiên Anh xây dựng bộ công cụ tính toán theo đúng cổ pháp, để bạn tự lập
        lá số, gieo quẻ và chọn ngày ngay trên trình duyệt.
      </p>
    </div>

    {/* Công 22/8/2026: trả lại lưới 1→2→3 cột theo breakpoint (bản gốc trước khi bị co về 2 cột cố
    định) — trên mobile mỗi thẻ chiếm trọn hàng ngang, cao theo tỉ lệ 16:9 nên to hẳn cả 2 chiều so
    với bản 2-cột-cố-định trước đó. Icon/chữ CTA cũng trả về cỡ gốc cho khớp thẻ to hơn. */}
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        CORE_TOOLS.map((tool) => (
          <a
            href={tool.href}
            aria-label={tool.title}
            class="group relative flex aspect-video flex-col justify-end overflow-hidden rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ink-950) p-4 transition hover:-translate-y-0.5 hover:border-(--color-gold-400)/60"
          >
            {/* Ảnh minh hoạ riêng của từng công cụ (Công cung cấp) làm nền toàn thẻ kiểu poster — tự thân
            đã có tên công cụ trong thiết kế, nên bỏ chữ tiêu đề/mô tả lặp lại của site, chỉ giữ CTA. */}
            <img
              src={tool.image}
              alt={tool.title}
              loading="lazy"
              class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
            />
            {/* Lớp phủ tối dần từ dưới lên để chữ luôn đọc được, bất kể nội dung ảnh phía dưới là gì. */}
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/10" />

            <span class="relative z-10 flex size-11 items-center justify-center self-start rounded-full border border-(--color-gold-500)/40 bg-(--color-ink-950)/40 text-(--color-gold-300) backdrop-blur-sm transition group-hover:border-(--color-gold-400)">
              <Icon name={tool.icon} class="size-5" />
            </span>
            <span class="relative z-10 mt-auto inline-flex items-center gap-1.5 text-sm font-medium text-(--color-gold-300)">
              Dùng thử ngay
              <Icon name="arrow-right" class="size-3.5 transition group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
