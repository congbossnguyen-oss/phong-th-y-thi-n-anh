---
/**
 * LÁ SỐ TỬ VI 12 CUNG cho module "Luận Giải Tử Vi" — cùng kiểu lưới 4×4 đã dùng ở
 * trach-nhat-sinh-no/LaSoTuVi.astro (anh Công duyệt kiểu trình bày này), nhưng nhận thẳng
 * `DuLieuLaSoTuVi` (từ tu-vi/luan-giai/adapter.ts) thay vì một view-model riêng — module này
 * không có sẵn tuTru/khungGio theo đúng shape của trach-nhat-sinh-no nên tách component riêng
 * thay vì ép dùng chung, tránh phải bịa field.
 *
 * Cát/hung của phụ tinh tra theo TRUNG_TINH_CAT/TRUNG_TINH_HUNG (chamDiem.ts) — đúng bảng đã có
 * nguồn, không tự suy thêm sao nào là cát/hung.
 */
import type { DuLieuLaSoTuVi, CungDuLieu } from "../../lib/tu-vi/luan-giai/adapter";
import { GIO_RANGE_THEO_CHI } from "../../lib/tu-vi/luan-giai/adapter";
import { TRUNG_TINH_CAT, TRUNG_TINH_HUNG } from "../../lib/tu-vi/luan-giai/chamDiem";

interface Props {
  duLieu: DuLieuLaSoTuVi;
}
const { duLieu } = Astro.props;

const VI_TRI: Record<number, string> = {
  5: "grid-area:1/1", 6: "grid-area:1/2", 7: "grid-area:1/3", 8: "grid-area:1/4",
  4: "grid-area:2/1", 9: "grid-area:2/4",
  3: "grid-area:3/1", 10: "grid-area:3/4",
  2: "grid-area:4/1", 1: "grid-area:4/2", 0: "grid-area:4/3", 11: "grid-area:4/4",
};

type DanhGia = "cat" | "binh" | "hung";
const NEN: Record<DanhGia, string> = { cat: "#F0FDF4", binh: "#FFFFFF", hung: "#FEF2F2" };
const VIEN: Record<DanhGia, string> = { cat: "#86EFAC", binh: "#E2E8F0", hung: "#FCA5A5" };
const NHAN_DG: Record<DanhGia, { chu: string; mau: string }> = {
  cat: { chu: "Tốt", mau: "#166534" }, binh: { chu: "Bình", mau: "#64748B" }, hung: { chu: "Cần lưu ý", mau: "#B91C1C" },
};
const MAU_TRANG_THAI: Record<string, string> = {
  "Miếu": "#166534", "Vượng": "#15803D", "Đắc": "#0369A1", "Bình": "#64748B", "Hãm": "#B91C1C",
};
function danhGiaCua(diem: number): DanhGia {
  if (diem >= 4) return "cat";
  if (diem === 3) return "binh";
  return "hung";
}
function phuTinhCat(c: CungDuLieu): string[] {
  return c.phuTinh.filter((s) => TRUNG_TINH_CAT.has(s.ten)).map((s) => s.ten);
}
function phuTinhHung(c: CungDuLieu): string[] {
  return c.phuTinh.filter((s) => TRUNG_TINH_HUNG.has(s.ten)).map((s) => s.ten);
}
function tuHoaCua(c: CungDuLieu): { ten: string; loai: string }[] {
  const ds: { ten: string; loai: string }[] = [];
  for (const s of c.chinhTinh) if (s.tuHoa) ds.push({ ten: s.ten, loai: s.tuHoa });
  for (const s of c.phuTinh) if (s.tuHoa) ds.push({ ten: s.ten, loai: s.tuHoa });
  return ds;
}
const khungGio = GIO_RANGE_THEO_CHI[duLieu.gioChiName] ?? "";
---

<div class="overflow-x-auto">
  <div class="mx-auto grid min-w-[560px] max-w-[720px] gap-1.5" style="grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(4,minmax(112px,auto))">
    {duLieu.cung.map((c) => {
      const dg = danhGiaCua(c.diem);
      const catTinh = phuTinhCat(c);
      const satTinh = phuTinhHung(c);
      const tuHoa = tuHoaCua(c);
      return (
        <div
          class="relative overflow-hidden rounded-lg border-2 p-1.5"
          style={`${VI_TRI[c.chiIndex]};background:${NEN[dg]};border-color:${c.isMenh ? "#B8860B" : VIEN[dg]};${c.isMenh ? "box-shadow:0 0 0 2px #B8860B55" : ""}`}
        >
          <div class="flex items-start justify-between gap-1">
            <span class="text-[9px] font-bold text-slate-500">{c.canThienBan} {c.chi}</span>
            <span class="text-[9px] font-bold text-slate-500">{c.daiVanTuoi[0]}–{c.daiVanTuoi[1]}</span>
          </div>
          <p class="text-center text-[10px] font-black uppercase tracking-wide" style={`color:${c.isMenh ? "#B8860B" : "#334155"}`}>
            {c.ten}{c.isThan ? " · THÂN" : ""}
          </p>

          <div class="mt-0.5 text-center">
            {c.chinhTinh.length === 0 ? (
              <p class="text-[11px] font-bold italic text-slate-400">Vô Chính Diệu</p>
            ) : (
              c.chinhTinh.map((s) => (
                <p class="text-[12px] font-black leading-tight" style={`color:${MAU_TRANG_THAI[s.trangThai] ?? "#334155"}`}>
                  {s.ten} <span class="text-[9px] font-bold">({s.trangThai})</span>
                </p>
              ))
            )}
          </div>

          <div class="mt-1 flex flex-wrap justify-center gap-0.5">
            {tuHoa.map((h) => (
              <span class="rounded px-1 text-[8px] font-extrabold text-white" style={`background:${h.loai === "Kỵ" ? "#B91C1C" : "#B8860B"}`}>Hóa {h.loai}</span>
            ))}
            {catTinh.map((s) => (<span class="rounded bg-emerald-100 px-1 text-[8px] font-bold text-emerald-800">{s}</span>))}
            {satTinh.map((s) => (<span class="rounded bg-red-100 px-1 text-[8px] font-bold text-red-800">{s}</span>))}
          </div>

          <div class="absolute inset-x-1.5 bottom-1 flex items-center justify-between">
            <span class="text-[8px] font-extrabold text-amber-700">
              {c.tuan && c.triet ? "TUẦN·TRIỆT" : c.tuan ? "TUẦN" : c.triet ? "TRIỆT" : ""}
            </span>
            <span class="text-[8px] font-extrabold" style={`color:${NHAN_DG[dg].mau}`}>{NHAN_DG[dg].chu}</span>
          </div>
        </div>
      );
    })}

    <div class="flex flex-col items-center justify-center rounded-lg border-2 border-(--color-gold-400)/50 bg-gradient-to-br from-[#241a10] to-[#3a2c17] p-3 text-center" style="grid-area:2/2/4/4">
      <p class="font-display text-sm font-black uppercase tracking-wide text-(--color-gold-300)">Lá số Tử Vi</p>
      <p class="mt-1 text-[11px] font-bold text-white/90">{duLieu.ngaySinhDuong} · giờ {duLieu.gioSinh}h ({duLieu.gioChiName}{khungGio ? `, ${khungGio}` : ""})</p>
      <p class="mt-2 text-[10px] font-semibold text-white/75">Tứ trụ</p>
      <p class="text-[11px] font-bold text-white">{duLieu.tuTru}</p>
      <p class="mt-2 text-[11px] font-bold text-(--color-gold-300)">{duLieu.cucName} — {duLieu.banMenhNapAm}</p>
      <p class="text-[10px] font-semibold text-white/75">Khởi đại hạn: {duLieu.tuoiKhoiHan} tuổi</p>
    </div>
  </div>
</div>

<div class="mt-2 flex flex-wrap justify-center gap-2 text-[10px] font-semibold text-slate-600">
  <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm border-2" style="background:#F0FDF4;border-color:#86EFAC"></span>Cung tốt</span>
  <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm border-2" style="background:#FFFFFF;border-color:#E2E8F0"></span>Bình</span>
  <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm border-2" style="background:#FEF2F2;border-color:#FCA5A5"></span>Cần lưu ý</span>
  <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm border-2" style="border-color:#B8860B"></span>Cung Mệnh</span>
</div>
