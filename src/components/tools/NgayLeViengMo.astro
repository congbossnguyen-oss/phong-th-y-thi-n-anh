---
// Thân công cụ "Ngày Tốt Đi Lễ – Viếng Mộ" tách dùng chung cho web + in-app Quân Sư — cùng mẫu các
// module khác trong "Đại Cát Lợi - Cơ Bản". Trang gọi component này chỉ lo khung
// (BaseLayout/PageHero/breadcrumbs), gọi chung API /api/ngay-le-vieng-mo.
//
// CTA cuối trang mời nâng cấp KHÁC NHAU giữa web/app (anh Công 29/8/2026: 2 nhánh tính tiền khác
// nhau — web bán lẻ từng công cụ, app bán thuê bao) — `laApp` chọn đúng component.
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import GoiYNangCap from "../../components/ui/GoiYNangCap.astro";
import GoiYNangCapApp from "../../components/quan-su/GoiYNangCapApp.astro";

interface Props {
  /** true = hiện app Quân Sư (mời nâng cấp gói Cao Cấp) thay vì mời mua lẻ như bản web. */
  laApp?: boolean;
}
const { laApp = false } = Astro.props;
---

<Container class="py-16">
  <div class="mx-auto max-w-2xl">
    <div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
      <div class="flex gap-2 border-b border-(--color-ivory-300) pb-3">
        <button type="button" id="tab-worship" class="rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)">
          🙏 Đi lễ
        </button>
        <button type="button" id="tab-grave" class="rounded-(--radius-pill) border border-(--color-ivory-400) px-4 py-2 text-sm font-semibold text-(--color-ink-600) hover:bg-(--color-ivory-200)">
          🪦 Viếng mộ
        </button>
      </div>

      <form id="form-le" class="mt-4 flex flex-col gap-3">
        <input type="hidden" id="purpose" value="WORSHIP" />
        <div class="space-y-3">
          <DateSelect idPrefix="tu-ngay" label="Từ ngày" />
          <DateSelect idPrefix="den-ngay" label="Đến ngày" />
        </div>
        <div>
          <label for="nam-sinh" class="text-xs font-medium text-(--color-ink-600)">Năm sinh (không bắt buộc)</label>
          <input type="number" id="nam-sinh" min="1900" max="2100" placeholder="Để trống nếu chỉ cần ngày chung" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          <p class="mt-1 text-xs text-(--color-ink-400)">Nhập năm sinh để xét thêm xung/hợp tuổi người đi.</p>
        </div>
        <p class="text-xs text-(--color-ink-400)">Tối đa 62 ngày mỗi lượt quét.</p>
        <Button type="submit" size="lg">Tìm ngày tốt</Button>
      </form>

      <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

      <div id="ket-qua" class="mt-4 hidden space-y-2"></div>
    </div>

    <p class="mt-4 text-xs text-(--color-ink-500)">
      Đây là công cụ tham khảo theo hệ thống phong thủy đã cấu hình. Hoàng Đạo không tự động là tốt cho mọi việc và
      Hắc Đạo không tự động là xấu tuyệt đối — hệ thống luôn xét thêm nhiều tầng dữ liệu khác theo đúng mục đích đã
      chọn.
    </p>
  </div>
  {laApp ? (
    <GoiYNangCapApp lyDo="Nếu gia đình đang lo việc an táng chứ không chỉ lễ viếng, dịch vụ Cao Cấp giúp chọn giờ liệm, đóng quan và hạ huyệt đầy đủ." tieuDe="Gia đình đang lo việc an táng?" />
  ) : (
    <GoiYNangCap slug="gio-liem-ha-huyet" lyDo="Nếu gia đình đang lo việc an táng chứ không chỉ lễ viếng, đây là công cụ chọn giờ liệm, đóng quan và hạ huyệt đầy đủ." nhanNut="Chọn giờ liệm – hạ huyệt" tieuDe="Gia đình đang lo việc an táng?" />
  )}
</Container>

<script>
  import { readDateSelects } from "../../lib/date-select";

  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface DayFactor { ten: string; diem: number }
  interface DayScore { diem: number; yeuTo: DayFactor[]; phamDaiKy: boolean }
  interface BachKyEntry { nhan: string; viec: string }
  interface BachKyCheck { lienQuan: boolean; chiTiet: BachKyEntry[] }
  interface CanNhanResult { diem: number; can: { moTa: string }; chi: { moTa: string } }
  interface LeViengMoNgay {
    solarDate: { year: number; month: number; day: number };
    lunarDate: { year: number; month: number; day: number; isLeapMonth: boolean };
    thuocTietThanhMinh: boolean;
    diem: number;
    hang: string;
    nhan: string;
    purpose: string;
    base: DayScore;
    mucDich: DayScore;
    bachKy: BachKyCheck;
    canNhan: CanNhanResult | null;
  }
  interface LeViengMoRangeResult { purpose: string; ngayXepHang: LeViengMoNgay[] }

  const tabWorship = document.getElementById("tab-worship") as HTMLButtonElement;
  const tabGrave = document.getElementById("tab-grave") as HTMLButtonElement;
  const purposeInput = document.getElementById("purpose") as HTMLInputElement;
  const form = document.getElementById("form-le") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;

  const TAB_ACTIVE = "rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 text-sm font-semibold text-(--color-on-accent)";
  const TAB_INACTIVE = "rounded-(--radius-pill) border border-(--color-ivory-400) px-4 py-2 text-sm font-semibold text-(--color-ink-600) hover:bg-(--color-ivory-200)";
  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  function pad2(n: number): string {
    return String(n).padStart(2, "0");
  }

  function showTab(which: "WORSHIP" | "GRAVE_VISIT") {
    purposeInput.value = which;
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");
    if (which === "WORSHIP") {
      tabWorship.className = TAB_ACTIVE;
      tabGrave.className = TAB_INACTIVE;
    } else {
      tabGrave.className = TAB_ACTIVE;
      tabWorship.className = TAB_INACTIVE;
    }
  }
  tabWorship.addEventListener("click", () => showTab("WORSHIP"));
  tabGrave.addEventListener("click", () => showTab("GRAVE_VISIT"));

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const purpose = purposeInput.value;
    const tuNgay = readDateSelects("tu-ngay");
    const denNgay = readDateSelects("den-ngay");
    const namSinh = (document.getElementById("nam-sinh") as HTMLInputElement).value;

    if (!tuNgay || !denNgay) {
      loiEl.textContent = "Vui lòng chọn đầy đủ Từ ngày và Đến ngày.";
      loiEl.classList.remove("hidden");
      return;
    }
    const { year: startYear, month: startMonth, day: startDay } = tuNgay;
    const { year: endYear, month: endMonth, day: endDay } = denNgay;

    let qs = `purpose=${purpose}&startYear=${startYear}&startMonth=${startMonth}&startDay=${startDay}&endYear=${endYear}&endMonth=${endMonth}&endDay=${endDay}`;
    if (namSinh) qs += `&namSinh=${namSinh}`;

    try {
      const res = await fetch(`/api/ngay-le-vieng-mo?${qs}`);
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const result = data as LeViengMoRangeResult;
      const top5 = result.ngayXepHang.slice(0, 5);

      ketQuaEl.innerHTML = top5
        .map((d, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          const ngayStr = `${pad2(d.solarDate.day)}/${pad2(d.solarDate.month)}/${d.solarDate.year}`;
          const lyDo: string[] = [];
          for (const y of [...d.base.yeuTo, ...d.mucDich.yeuTo]) {
            if (y.diem > 0) lyDo.push(y.ten);
          }
          const lyDoText = lyDo.length > 0 ? lyDo.slice(0, 4).join("; ") : "Không có yếu tố nổi bật, mức bình thường";
          const thanhMinhBadge = d.thuocTietThanhMinh
            ? `<p class="mt-1 text-xs font-semibold text-(--color-cinnabar-500)">🌸 Ngày thuộc tiết Thanh Minh</p>`
            : "";
          const bachKyBadge = d.bachKy.lienQuan
            ? `<p class="mt-1 text-xs text-(--color-cinnabar-500)">⚠️ Bách Kỵ: ${d.bachKy.chiTiet.map((c) => `${c.nhan} — ${c.viec}`).join("; ")}</p>`
            : "";
          const canNhanText = d.canNhan
            ? `<p class="mt-1 text-xs text-(--color-ink-500)">Tuổi người đi: Can ${d.canNhan.can.moTa}; Chi ${d.canNhan.chi.moTa}</p>`
            : "";
          return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-3">
            <div class="flex items-center justify-between">
              <p class="font-display text-base font-bold text-(--color-ink-950)">${huyChuong} ${ngayStr}</p>
              <span class="text-sm font-semibold">${nhanDotHtml(d.nhan)} — ${d.diem}/10</span>
            </div>
            <p class="mt-1 text-xs text-(--color-ink-500)">Lý do: ${lyDoText}</p>
            ${thanhMinhBadge}
            ${bachKyBadge}
            ${canNhanText}
          </div>`;
        })
        .join("");

      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
