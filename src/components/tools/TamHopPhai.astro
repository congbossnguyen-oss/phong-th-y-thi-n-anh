---
// Công cụ "Tam Hợp Phái" — THẦY-ONLY (chỉ tài khoản quản trị dùng được; khách thấy "đang hoàn
// thiện"). Tính toán thuần tra bảng chạy SERVER-SIDE trong frontmatter (engine chỉ import ở đây,
// KHÔNG ở <script> client) → khách không nhận bất kỳ dữ liệu/JSON engine nào, chỉ HTML placeholder.
//
// Form method="GET": admin nhập Hướng + các sơn quan sát thực địa → kết quả hiện ngay dưới.
// KHÔNG dùng AI: phần luận cát/hung do Thầy trực tiếp thực hiện từ số liệu tra bảng (gỡ lớp AI
// 10/9/2026 — anh Công: "không cần AI vì đây là công cụ anh kiểm tra cho khách").
//
// NGUYÊN TẮC "KHÔNG ĐOÁN": thiếu input nào, engine in cảnh báo rõ — trang hiển thị đủ, không bớt.
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import {
  phanTich,
  SON_24,
  CHI_12,
  QUAI_DISPLAY,
  QUAI_ORDER,
  QUAN_HE_CAT_HUNG,
  sonDisplay,
  type KetQuaTamHop,
} from "../../lib/tam-hop-phai/engine";

export const prerender = false;

const laQuanTri = Astro.locals.user?.isAdmin === true;

const q = Astro.url.searchParams;
const huongRaw = q.get("huong");
const huongNum = huongRaw !== null && huongRaw.trim() !== "" ? Number(huongRaw) : null;
const daGuiForm = huongNum !== null && Number.isFinite(huongNum);

// value của select = key SON_24 (ASCII); "" hoặc lạ → null (bỏ qua).
const laySon = (ten: string): string | null => {
  const v = q.get(ten);
  return v && (SON_24 as readonly string[]).includes(v) ? v : null;
};
const thuyKhau = laySon("thuyKhau");
const giangLong = laySon("giangLong");
const giangKhi = laySon("giangKhi");
const laiThuy = laySon("laiThuy");
const khuThuy = laySon("khuThuy");

let loi: string | null = null;
let kq: KetQuaTamHop | null = null;
if (laQuanTri && daGuiForm) {
  if (huongNum! < 0 || huongNum! > 360) {
    loi = "Độ Hướng nhà phải trong khoảng 0–360°.";
  } else {
    kq = phanTich(huongNum!, { thuyKhau, giangLong, giangKhi, laiThuy, khuThuy });
  }
}

const SON_OPTIONS = SON_24.map((k) => ({ value: k, label: sonDisplay(k) }));
const CHI_OPTIONS = CHI_12.map((k) => ({ value: k, label: sonDisplay(k) }));

// Mô tả field lấy theo bảng trong data/README-engine-goc.md (không tự viết thêm).
const FIELDS: Array<[string, string, string, Array<{ value: string; label: string }>, string | null]> = [
  ["thuyKhau", "Thủy khẩu", "Sơn nơi nước ra (thủy khẩu) — để biết Long Cục. Quan sát thực địa.", SON_OPTIONS, thuyKhau],
  ["giangLong", "Giáng Long", "Sơn hướng mạch núi/nhà cao đến. Quan sát thực địa.", SON_OPTIONS, giangLong],
  ["giangKhi", "Giáng Khí", "Chi hướng đường/thủy khẩu tác động vào Tọa (chỉ nhận 12 Địa Chi). Quan sát thực địa.", CHI_OPTIONS, giangKhi],
  ["laiThuy", "Lai thủy", "Sơn nơi nước đến. Quan sát thực địa.", SON_OPTIONS, laiThuy],
  ["khuThuy", "Khứ thủy", "Sơn nơi nước đi. Quan sát thực địa.", SON_OPTIONS, khuThuy],
];

const AM_DUONG_DISPLAY: Record<string, string> = { Am: "Âm", Duong: "Dương" };
---

{!laQuanTri ? (
  <Container class="py-16">
    <div class="mx-auto max-w-xl rounded-(--radius-card) border border-(--color-gold-400)/30 bg-(--color-ivory-100) p-8 text-center shadow-lg">
      <p class="inline-block rounded-full border border-(--color-gold-400) bg-(--color-gold-400)/15 px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-(--color-gold-600)">Đang hoàn thiện</p>
      <h2 class="mt-3 font-display text-2xl font-bold text-(--color-ink-950)">Tam Hợp Phái</h2>
      <p class="mx-auto mt-2 max-w-md text-sm font-medium leading-relaxed text-(--color-ink-700)">
        Công cụ luận nhà theo trường phái Tam Hợp (Loan Đầu + Lý Khí) đang được Thầy hoàn thiện. Phần này cần khảo sát thực địa (thủy khẩu, long, sa, lai/khứ thủy) nên sẽ do chuyên gia trực tiếp thực hiện.
      </p>
      <div class="mt-5">
        <Button href="/lien-he" size="lg">Liên hệ tư vấn trực tiếp</Button>
      </div>
    </div>
  </Container>
) : (
  <Container class="py-10">
    <div class="mx-auto max-w-4xl">
      <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-gold-600)">
        🔒 CHẾ ĐỘ QUẢN TRỊ — công cụ nội bộ Tam Hợp Phái. Khách chỉ thấy màn "đang hoàn thiện".
      </div>

      <form method="GET" class="flex flex-col gap-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <div>
          <p class="text-sm font-semibold text-(--color-ink-900)">Nhóm bắt buộc</p>
          <label for="thp-huong" class="mt-2 block text-sm font-medium text-(--color-ink-800)">Hướng nhà (độ, 0–360°) <span class="text-(--color-cinnabar-400)">*</span></label>
          <p class="mt-0.5 text-xs text-(--color-ink-500)">Tọa suy ra tự động = đối cung của Hướng. Đo bằng la bàn/la kinh tại thực địa.</p>
          <input
            type="number" id="thp-huong" name="huong" min="0" max="360" step="0.5" required
            value={huongNum ?? undefined}
            class="mt-1 w-full max-w-[10rem] rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm"
          />
        </div>

        <div class="border-t border-(--color-ivory-300) pt-5">
          <p class="text-sm font-semibold text-(--color-ink-900)">Nhóm quan sát thực địa (tùy chọn)</p>
          <p class="mt-0.5 text-xs text-(--color-ink-500)">Thiếu field nào thì engine bỏ qua phần liên quan và in cảnh báo rõ — KHÔNG tự đoán.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {FIELDS.map(([name, nhan, hint, options, val]) => (
            <div>
              <label for={`thp-${name}`} class="block text-xs font-semibold text-(--color-ink-800)">{nhan}</label>
              <p class="mt-0.5 text-[11px] leading-snug text-(--color-ink-500)">{hint}</p>
              <select id={`thp-${name}`} name={name} class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm">
                <option value="">— Không rõ / bỏ qua —</option>
                {options.map((o) => <option value={o.value} selected={val === o.value}>{o.label}</option>)}
              </select>
            </div>
          ))}
        </div>

        <Button type="submit" size="lg">Tra bảng Tam Hợp</Button>
      </form>

      {loi && (
        <div class="mt-4 rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)">{loi}</div>
      )}

      {kq && (
        <div class="mt-8 space-y-8">
          {/* Tọa / Hướng */}
          <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-base font-semibold text-(--color-ink-900)">
            <p>HƯỚNG: <strong>{kq.huong.son}</strong> (quái {kq.huong.quai}, {AM_DUONG_DISPLAY[kq.huong.am_duong] ?? kq.huong.am_duong})</p>
            <p class="mt-1">TỌA: <strong>{kq.toa.son}</strong> (quái {kq.toa.quai}, {AM_DUONG_DISPLAY[kq.toa.am_duong] ?? kq.toa.am_duong})</p>
          </section>

          {/* Long Cục + Bát Lộ Hoàng Tuyền */}
          {kq.long_cuc && (
            <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4">
              <h2 class="font-display text-xl font-bold text-(--color-ink-950)">Long Cục: {kq.long_cuc}</h2>
              {kq.bat_lo_hoang_tuyen && (
                <p class="mt-2 text-sm font-medium text-(--color-ink-800)">
                  Bát Lộ Hoàng Tuyền ({kq.bat_lo_hoang_tuyen.ten_cuc}): cấm mở cửa/cổng/hồ nước tại <strong>{kq.bat_lo_hoang_tuyen.huong_cam_mo_cua_cong_ho_nuoc.join(" / ")}</strong> (cung tử nếu phạm: {kq.bat_lo_hoang_tuyen.cung_tu_neu_pham})
                </p>
              )}
            </section>
          )}

          {/* Thủy Pháp 8 phương */}
          <section>
            <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Thủy Pháp <span class="text-base font-semibold text-(--color-ink-600)">(Phụ Tinh Phiên Quái theo Hướng)</span></h2>
            <div class="mt-3 space-y-1.5">
              {QUAI_ORDER.map((qk) => {
                const info = kq!.thuy_phap_8_phuong[qk];
                return (
                  <div class:list={["flex items-center justify-between rounded-(--radius-control) border px-4 py-2 text-sm font-medium", info.loai === "cat" ? "border-emerald-500/40 bg-emerald-500/5 text-emerald-700" : "border-(--color-danger-500)/30 bg-(--color-danger-500)/5 text-(--color-danger-600)"]}>
                    <span class="font-bold text-(--color-ink-900)">{QUAI_DISPLAY[qk]}</span>
                    <span>{info.sao} <strong>[{info.loai === "cat" ? "CÁT" : "HUNG"}]</strong></span>
                  </div>
                );
              })}
            </div>
            {kq.lai_thuy_ket_luan && <p class="mt-3 text-sm font-semibold text-(--color-ink-800)">▸ {kq.lai_thuy_ket_luan}</p>}
            {kq.khu_thuy_ket_luan && <p class="mt-1 text-sm font-semibold text-(--color-ink-800)">▸ {kq.khu_thuy_ket_luan}</p>}
            {kq.lai_thuy_truong_sinh && <p class="mt-1 text-sm font-medium text-(--color-ink-700)">▸ Trường Sinh (lai thủy): {kq.lai_thuy_truong_sinh}</p>}
            {kq.khu_thuy_truong_sinh && <p class="mt-1 text-sm font-medium text-(--color-ink-700)">▸ Trường Sinh (khứ thủy): {kq.khu_thuy_truong_sinh}</p>}
          </section>

          {/* Sa Pháp 8 phương + Lại Công Ngũ Hành */}
          <section>
            <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Sa Pháp <span class="text-base font-semibold text-(--color-ink-600)">(Địa Mẫu Cửu Tinh theo Tọa)</span></h2>
            <div class="mt-3 space-y-1.5">
              {QUAI_ORDER.map((qk) => {
                const info = kq!.sa_phap_8_phuong[qk];
                return (
                  <div class:list={["flex items-center justify-between rounded-(--radius-control) border px-4 py-2 text-sm font-medium", info.loai === "cat" ? "border-emerald-500/40 bg-emerald-500/5 text-emerald-700" : "border-(--color-danger-500)/30 bg-(--color-danger-500)/5 text-(--color-danger-600)"]}>
                    <span class="font-bold text-(--color-ink-900)">{QUAI_DISPLAY[qk]}</span>
                    <span>{info.sao} <strong>[{info.loai === "cat" ? "CÁT" : "HUNG"}]</strong></span>
                  </div>
                );
              })}
            </div>
            <div class="mt-3 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4 text-sm">
              <p class="font-semibold text-(--color-ink-900)">Ngũ hành Tọa: {kq.toa_ngu_hanh}</p>
              <p class="mt-1 font-medium text-(--color-ink-700)">Ngũ hành Sa cần có theo quan hệ (Lại Công Ngũ Hành):</p>
              <ul class="mt-1 space-y-0.5">
                {Object.entries(kq.sa_ngu_hanh_can_theo_quan_he).map(([qh, nh]) => (
                  <li class="text-(--color-ink-800)">{qh} → Sa nên hành <strong>{nh}</strong> [{QUAN_HE_CAT_HUNG[qh]}]</li>
                ))}
              </ul>
            </div>
          </section>

          {/* Bát Sát Huỳnh Tuyền */}
          <section>
            <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Bát Sát Huỳnh Tuyền</h2>
            <div class="mt-3 space-y-2">
              {kq.bat_sat_huynh_tuyen.da_kiem_tra && kq.bat_sat_huynh_tuyen.ket_qua ? (
                kq.bat_sat_huynh_tuyen.ket_qua.map((line) => (
                  <p class:list={["rounded-(--radius-control) border px-4 py-2 text-sm font-medium", line.includes("PHẠM") ? "border-(--color-danger-500)/40 bg-(--color-danger-500)/10 text-(--color-danger-600)" : "border-(--color-ivory-300) bg-(--color-ivory-50) text-(--color-ink-800)"]}>{line}</p>
                ))
              ) : (
                <p class="text-sm font-medium text-(--color-ink-600)">(chưa kiểm tra — thiếu input Giáng Long/Giáng Khí)</p>
              )}
            </div>
          </section>

          {/* Cảnh báo — KHÔNG bớt dòng nào */}
          {kq.canh_bao.length > 0 && (
            <section class="rounded-(--radius-card) border-2 border-(--color-gold-500)/50 bg-(--color-gold-400)/10 p-4">
              <h2 class="font-display text-lg font-bold text-(--color-gold-700)">Cảnh báo / cần Công tự xác nhận</h2>
              <ul class="mt-2 space-y-1.5">
                {kq.canh_bao.map((c) => <li class="text-sm font-medium text-(--color-ink-800)">⚠ {c}</li>)}
              </ul>
            </section>
          )}

          {/* KHÔNG dùng AI — phần luận do Thầy trực tiếp thực hiện từ số liệu tra bảng ở trên. */}
          <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4 text-sm font-medium leading-relaxed text-(--color-ink-700)">
            Số liệu tra bảng phía trên (Long Cục, Thủy/Sa Pháp, Bát Sát Huỳnh Tuyền, cảnh báo) là phần khách quan để Thầy kiểm tra. Phần luận cát/hung cuối cùng do Thầy trực tiếp đối chiếu loan đầu thực địa và viết cho khách — công cụ không tự kết luận.
          </section>
        </div>
      )}
    </div>
  </Container>
)}

{/* Đã gỡ lớp AI (modal + script gọi /api/.../luan-giai) — Tam Hợp chỉ còn engine tra bảng, luận do Thầy. */}
