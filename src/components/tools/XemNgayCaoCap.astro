---
// Than dich vu VIP tach dung chung cho web + in-app Quan Su (giu nguyen logic/giao dien).
import BottomNav from "../../components/quan-su/BottomNav.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../lib/payments/gia-cong-cu";

// ⚠️ KHÔNG bắt đăng nhập (chủ dự án chốt 2026-08-16) — đồng bộ với 2 module thu phí còn lại.
// Nhờ vậy trang quay lại được dạng tĩnh (prerender), tải nhanh hơn và Google index thoải mái.
// Kết quả sau khi thanh toán truy cập bằng orderCode làm "vé".
export const prerender = true;

const SON_24 = [
  "Tý", "Quý", "Sửu", "Cấn", "Dần", "Giáp", "Mão", "Ất", "Thìn", "Tốn", "Tỵ", "Bính",
  "Ngọ", "Đinh", "Mùi", "Khôn", "Thân", "Canh", "Dậu", "Tân", "Tuất", "Càn", "Hợi", "Nhâm",
];
// Cờ thử nghiệm: true = bỏ bước thanh toán, nộp form ra kết quả ngay (không tạo đơn thật).
// Khai báo ở frontmatter để MARKUP cũng dùng được — các ô chỉ có nghĩa khi thu phí (số điện
// thoại, mã khuyến mãi) phải ẩn đi lúc đang thử nghiệm, nếu không khách nhập mã, thấy báo giảm
// giá thành công, rồi form lại nộp sang test-calculate: mã không đi đâu cả mà khách tưởng đã
// dùng mất mã tặng. Script đọc lại cờ này qua data-test-mode trên thẻ form (1 nguồn sự thật).
// ĐÃ BẬT THU PHÍ (chủ dự án chốt 2026-08-18): khách thanh toán thật; admin vẫn được checkout-cong-cu
// tạo đơn 0đ tự xác nhận (cờ laQuanTri từ phiên đăng nhập ở checkout.ts) nên test trọn luồng miễn phí.
const TEST_MODE = false;

const TOOL_SLUG = "xem-ngay-cao-cap";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
---

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-500)/50 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
        <p class="font-semibold text-(--color-ink-900)">⚠️ Cần chuẩn bị trước: độ số la bàn của tọa nhà</p>
        <p class="mt-1.5">
          Công cụ luận theo vòng <strong>64 quẻ</strong> (mỗi quẻ 5.625°), nên <strong>bắt buộc phải có độ số đo
          thực tế</strong> — chỉ biết tên sơn (Càn, Ất, Mùi…) là <strong>không đủ</strong>, vì mỗi sơn rộng 15° và
          chứa tới 2–3 quẻ khác nhau. Chưa có độ số thì hệ thống vẫn chạy, nhưng bỏ trống phần luận cách cục
          (báo thiếu dữ liệu) chứ không đoán.
        </p>
        <details class="mt-2.5">
          <summary class="cursor-pointer font-medium text-(--color-gold-300)">Chưa biết đo? Bấm xem hướng dẫn</summary>
          <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-(--color-ink-600)">
            <li><strong>Tọa là lưng nhà</strong>, không phải mặt tiền. Đứng giữa nhà quay mặt ra cửa chính — đó là <em>hướng</em>; lưng anh quay về đâu thì đó là <em>tọa</em>.</li>
            <li>Dùng la bàn phong thủy, hoặc ứng dụng la bàn trên điện thoại. Đo tại <strong>giữa nhà</strong>, tránh xa tủ sắt, cột bê tông, thiết bị điện, điện thoại của người khác.</li>
            <li>Nếu ứng dụng chỉ cho anh số của <strong>hướng</strong> (mặt nhà) thì <strong>tọa = hướng + 180°</strong>. Ví dụ hướng đo được 138° → tọa = 318°.</li>
            <li>Đo 2–3 lần ở vị trí khác nhau rồi lấy số ổn định nhất. Lệch vài độ có thể ra quẻ khác, nên số càng chuẩn kết quả càng đúng.</li>
          </ol>
          <p class="mt-2 text-(--color-ink-600)">
            Không tự đo được?
            <a href="/lien-he" class="font-medium text-(--color-gold-300) hover:underline">Liên hệ để được khảo sát và đo trực tiếp</a>.
          </p>
        </details>
      </div>

      <div class="mb-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-600)">
        <p class="font-medium text-(--color-ink-800)">Phạm vi công cụ</p>
        <p class="mt-1">
          Chỉ dùng cho <strong>động thổ</strong> và <strong>nhập trạch</strong>. Các việc khác (khai trương, cưới hỏi,
          ký hợp đồng…) sẽ có công cụ riêng — hoặc
          <a href="/dich-vu/xem-ngay-cao-cap" class="text-(--color-gold-300) hover:underline">đặt lịch xem ngày cùng chuyên gia</a>.
        </p>
        <p class="mt-2">
          Luận thuần <strong>Huyền Không Đại Quái</strong> (Bước 2→6): khung tháng theo tọa (2 phương pháp: theo mùa
          và Bổ Long Tam Cục) · phương vị sát (Ngũ Hoàng/Tam Sát/Bát Sát/Thái Tuế/Tuế Phá/Mậu Kỷ Đô Thiên/Âm Phủ
          Thái Tuế/Mộ Long Biến Vận) · quy Tứ Trụ về HKNH–Quái Vận · cách cục Tam Tài · chọn giờ.
          <strong>Không</strong> bao gồm lớp thần sát dân gian ở Bước 1 (Tam Nương, Nguyệt Kỵ, Sát Chủ, 28 sao…)
          theo đúng phạm vi đã chốt.
        </p>
        <p class="mt-2">Dữ liệu Ngũ Hoàng tra bảng thật từ Vạn Niên Lịch Tam Nguyên, phủ liền mạch 1968–2068.</p>
      </div>

      <form
        id="xncc-form"
        data-test-mode={String(TEST_MODE)}
        class="flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6"
      >
        <div>
          <p class="text-sm font-medium text-(--color-ink-800)">Loại việc</p>
          <div class="mt-1.5 flex gap-4">
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)">
              <input type="radio" name="loaiViec" value="nhap_trach" checked /> Nhập trạch
            </label>
            <label class="flex items-center gap-1.5 text-sm text-(--color-ink-700)">
              <input type="radio" name="loaiViec" value="dong_tho" /> Động thổ
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="xncc-toa" class="text-sm font-medium text-(--color-ink-800)">Tọa nhà (24 sơn)</label>
            <select id="xncc-toa" required class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
              {SON_24.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
          <div>
            <label for="xncc-huong" class="text-sm font-medium text-(--color-ink-800)">Hướng nhà (nên có)</label>
            <select id="xncc-huong" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
              <option value="">Không rõ</option>
              {SON_24.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
        </div>

        <div class="rounded-(--radius-control) border border-(--color-gold-500)/40 bg-(--color-gold-400)/5 p-3">
          <label for="xncc-do-so" class="text-sm font-medium text-(--color-ink-800)">
            Độ số la bàn của tọa (0–359.99) <span class="text-(--color-cinnabar-400)">*</span>
          </label>
          <input
            type="number"
            id="xncc-do-so"
            step="0.01"
            min="0"
            max="359.99"
            placeholder="vd. 318"
            class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
          />
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <span class="text-xs text-(--color-ink-600)">Chỉ đo được số của <strong>hướng</strong> (mặt nhà)?</span>
            <input
              type="number"
              id="xncc-do-huong"
              step="0.01"
              min="0"
              max="359.99"
              placeholder="Nhập độ hướng"
              class="w-36 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-2 py-1.5 text-sm text-(--color-ink-800)"
            />
            <button
              type="button"
              id="xncc-doi-huong-sang-toa"
              class="rounded-(--radius-pill) bg-(--color-gold-400) px-3 py-1.5 text-xs font-semibold text-(--color-on-accent) hover:bg-(--color-gold-300)"
            >
              Đổi sang tọa (+180°)
            </button>
          </div>
          <p id="xncc-que-preview" class="mt-2 hidden rounded-(--radius-control) bg-(--color-gold-400)/15 px-3 py-2 text-sm font-medium text-(--color-ink-800)"></p>
          <p class="mt-2 text-xs text-(--color-ink-600)">
            Hệ thống tự tra ra <strong>quẻ Tọa</strong> từ độ số này (vòng 64 quẻ, mỗi quẻ 5.625°) — anh không cần nhập
            HKNH/Quái Vận nữa. Bắt buộc có độ số thì Bước 5 mới luận được cách cục: mỗi sơn rộng 15° nhưng chứa tới 2–3
            quẻ khác nhau, nên <strong>tên sơn không đủ</strong> (cùng tọa Ất, 99° ra quẻ Tổn 6/9 còn 104° ra quẻ Tiết 7/8).
            Bỏ trống → hệ thống báo thiếu dữ liệu chứ không đoán.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="xncc-nam-sinh" class="text-sm font-medium text-(--color-ink-800)">Năm sinh gia chủ (dương lịch)</label>
            <input type="number" id="xncc-nam-sinh" min="1900" max="2100" required placeholder="vd. 1980" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="xncc-nam-sinh-phu" class="text-sm font-medium text-(--color-ink-800)">Năm sinh vợ/chồng (tùy chọn)</label>
            <input type="number" id="xncc-nam-sinh-phu" min="1900" max="2100" placeholder="vd. 1983" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
        </div>

        <div class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
          <p class="text-sm font-medium text-(--color-ink-800)">Bạn muốn làm gì?</p>
          <div class="mt-2 flex flex-col gap-2">
            <label class="flex items-start gap-2 text-sm text-(--color-ink-700)">
              <input type="radio" name="cheDo" value="tim_thang" class="mt-1" checked />
              <span><strong>Tìm tháng trong năm</strong> — "năm nay tháng nào làm được?"</span>
            </label>
            <label class="flex items-start gap-2 text-sm text-(--color-ink-700)">
              <input type="radio" name="cheDo" value="tim_ngay" class="mt-1" />
              <span><strong>Tìm ngày trong khoảng</strong> — "tháng này ngày nào làm được?"</span>
            </label>
            <label class="flex items-start gap-2 text-sm text-(--color-ink-700)">
              <input type="radio" name="cheDo" value="giam_dinh" class="mt-1" />
              <span><strong>Giám định 1 ngày</strong> — đã có ngày dự kiến, xem có dùng được không</span>
            </label>
          </div>
        </div>

        <div id="xncc-o-nam" class="hidden">
          <label for="xncc-nam-tim" class="text-sm font-medium text-(--color-ink-800)">Năm cần tìm (dương lịch)</label>
          <select id="xncc-nam-tim" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"></select>
        </div>

        <div id="xncc-o-khoang" class="hidden grid gap-3">
          <DateSelect idPrefix="xncc-tu" label="Từ ngày" required={false} yearsBack={1} yearsForward={5} />
          <DateSelect idPrefix="xncc-den" label="Đến ngày" required={false} yearsBack={1} yearsForward={5} />
          <p class="text-xs text-(--color-ink-500)">Quét tối đa 400 ngày mỗi lần. Để trống ngày nào thì báo lỗi.</p>
        </div>

        <div id="xncc-o-mot-ngay" class="hidden">
          <DateSelect idPrefix="xncc-ngay" label="Ngày cần giám định (dương lịch)" required={false} yearsBack={15} yearsForward={5} />
        </div>

        {/* Chỉ hiện khi đã bật thu phí. Đang TEST_MODE mà vẫn hiện ô mã thì khách nhập mã, thấy
            báo giảm giá thành công, nhưng form lại nộp sang test-calculate — mã không đi đâu cả
            và khách tưởng đã dùng mất mã tặng. */}
        {!TEST_MODE && (
        <>
        <div class="border-t border-(--color-ivory-300) pt-4">
          <p class="text-sm font-medium text-(--color-ink-800)">Thông tin liên hệ (để nhận kết quả sau khi thanh toán)</p>
          <div class="mt-2 grid gap-3">
            <input
              type="text"
              id="xncc-ten"
              placeholder="Họ tên"
              required
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
            />
            <input
              type="tel"
              id="xncc-sdt"
              placeholder="Số điện thoại"
              required
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
            />
            <input
              type="email"
              id="xncc-email"
              placeholder="Email (tùy chọn)"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)"
            />
          </div>
        </div>

        <MaKhuyenMai idPrefix="xncc-ma" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />
        </>
        )}

        <Button type="submit" size="lg"><span id="xncc-nhan-nut">Tìm tháng phù hợp</span></Button>
      </form>

      <div id="xncc-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>
      <div id="xncc-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
        <p class="font-medium text-(--color-ink-900)">⏳ Đang tính, vui lòng đợi…</p>
        <p id="xncc-dang-chay-chi-tiet" class="mt-1 text-xs text-(--color-ink-600)"></p>
      </div>

      <div id="xncc-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
        <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="xncc-so-tien">{TOOL_PRICE_LABEL}</span></p>
        <img id="xncc-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
        <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="xncc-order-code"></strong></p>
        <p id="xncc-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
      </div>

      <div id="xncc-ket-qua" class="mt-6 hidden space-y-6"></div>
    </div>
  </Container>
  <BottomNav />

<script>
  import { readDateSelects } from "../../lib/date-select";

  interface TruQue { can: string; chi: string; que: string; hknh: number; quaiVan: number }
  interface MenhChuQue { canChiNamSinh: string; que: string; hknh: number; quaiVan: number }
  interface BuocKetQua { buoc: 2 | 3 | 4 | 5; ten: string; trangThai: "dat" | "khong_dat" | "thieu_du_lieu"; lyDo: string }
  interface XemNgayCaoCapResult {
    ngayDuongLich: { nam: number; thang: number; ngay: number };
    amLich: { ngay: number; thang: number; nam: number; nhuan: boolean };
    tuTru: { nam: TruQue; thang: TruQue; ngay: TruQue };
    toaNha: { ten: string; cung: string; phuong: string | null; hknh: number | null; quaiVan: number | null };
    huongNha?: { ten: string; cung: string };
    menhChuChinh: MenhChuQue;
    menhChuPhu?: MenhChuQue;
    ketLuan: "dung_duoc" | "khong_dung" | "dung_duoc_co_dieu_kien";
    chieuTungBuoc: BuocKetQua[];
    diemManh: string[];
    diemLuuY: string[];
    gioDeXuat: {
      chiGio: string;
      khungGio: string;
      laHoangDao: boolean;
      tenSao: string;
      hopCucVoiToa: "tam-hop" | "luc-hop" | null;
      xungChiNgay: boolean;
      phamTamSatGio: boolean;
      diem: number;
    }[];
  }

  const NHAN_KET_LUAN: Record<string, { text: string; cls: string }> = {
    dung_duoc: { text: "✅ DÙNG ĐƯỢC", cls: "text-(--color-success-500)" },
    dung_duoc_co_dieu_kien: { text: "⚠️ DÙNG ĐƯỢC CÓ ĐIỀU KIỆN", cls: "text-(--color-gold-400)" },
    khong_dung: { text: "❌ KHÔNG DÙNG", cls: "text-(--color-cinnabar-500)" },
  };
  const NHAN_TRANG_THAI: Record<string, { text: string; cls: string }> = {
    dat: { text: "Đạt", cls: "text-(--color-success-500)" },
    khong_dat: { text: "Không đạt", cls: "text-(--color-cinnabar-500)" },
    thieu_du_lieu: { text: "Thiếu dữ liệu", cls: "text-(--color-gold-400)" },
  };

  function esc(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  }

  function truCell(t: TruQue): string {
    return `<td class="border border-(--color-ivory-300) px-2 py-1.5 text-center">
      <div class="font-semibold text-(--color-ink-950)">${esc(t.can)} ${esc(t.chi)}</div>
      <div class="text-xs text-(--color-ink-500)">${esc(t.que)}</div>
      <div class="text-sm font-bold text-(--color-gold-400)">${t.hknh}/${t.quaiVan}</div>
    </td>`;
  }

  function render(r: XemNgayCaoCapResult) {
    const el = document.getElementById("xncc-ket-qua")!;
    const kl = NHAN_KET_LUAN[r.ketLuan]!;
    const d = r.ngayDuongLich;
    const ngayLbl = `${String(d.ngay).padStart(2, "0")}/${String(d.thang).padStart(2, "0")}/${d.nam}`;

    const buocHtml = r.chieuTungBuoc
      .map((b) => {
        const tt = NHAN_TRANG_THAI[b.trangThai]!;
        return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-3">
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-sm font-semibold text-(--color-ink-950)">Bước ${b.buoc} — ${esc(b.ten)}</p>
            <span class="shrink-0 text-sm font-bold ${tt.cls}">${tt.text}</span>
          </div>
          <p class="mt-1 text-xs leading-relaxed text-(--color-ink-600)">${esc(b.lyDo)}</p>
        </div>`;
      })
      .join("");

    const dsHtml = (items: string[]) =>
      items.length > 0 ? items.map((s) => `<li>${esc(s)}</li>`).join("") : `<li class="text-(--color-ink-400)">(không có)</li>`;

    // Chỉ hiện 6 giờ đầu (đã xếp hạng) để tránh rối; giờ xấu rõ ràng vẫn hiện nhãn cảnh báo.
    const gioHtml = r.gioDeXuat
      .slice(0, 6)
      .map((g, i) => {
        const nhan: string[] = [];
        if (g.laHoangDao) nhan.push(`Hoàng đạo ${esc(g.tenSao)}`);
        else nhan.push(`Hắc đạo ${esc(g.tenSao)}`);
        if (g.hopCucVoiToa === "tam-hop") nhan.push("tam hợp với tọa");
        if (g.hopCucVoiToa === "luc-hop") nhan.push("lục hợp với tọa");
        const canhBao: string[] = [];
        if (g.xungChiNgay) canhBao.push("xung Chi ngày");
        if (g.phamTamSatGio) canhBao.push("phạm Tam Sát");
        const mau = g.laHoangDao && canhBao.length === 0 ? "text-(--color-success-500)" : canhBao.length > 0 ? "text-(--color-cinnabar-500)" : "text-(--color-ink-500)";
        return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-3">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display text-base font-bold text-(--color-ink-950)">${i === 0 ? "⭐ " : ""}Giờ ${esc(g.chiGio)} <span class="text-sm font-normal text-(--color-ink-500)">(${esc(g.khungGio)})</span></p>
          </div>
          <p class="mt-0.5 text-sm font-semibold ${mau}">${nhan.join(" · ")}</p>
          ${canhBao.length > 0 ? `<p class="mt-1 text-xs text-(--color-gold-400)">⚠️ ${canhBao.join(" · ")}</p>` : ""}
        </div>`;
      })
      .join("");

    el.innerHTML = `
      <div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Kết luận</p>
        <p class="mt-1 font-display text-2xl font-bold ${kl.cls}">${kl.text}</p>
        <p class="mt-1 text-sm text-(--color-ink-600)">
          Ngày ${ngayLbl} (ÂL ${r.amLich.ngay}/${r.amLich.thang}${r.amLich.nhuan ? " nhuận" : ""}/${r.amLich.nam})
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Bảng Tứ Trụ (HKNH / Quái Vận)</p>
        <table class="mt-3 w-full min-w-[26rem] border-collapse text-sm">
          <thead>
            <tr>
              <th class="border border-(--color-ivory-300) bg-(--color-ivory-200) px-2 py-1.5 text-xs">Trụ Năm</th>
              <th class="border border-(--color-ivory-300) bg-(--color-ivory-200) px-2 py-1.5 text-xs">Trụ Tháng</th>
              <th class="border border-(--color-ivory-300) bg-(--color-ivory-200) px-2 py-1.5 text-xs">Trụ Ngày</th>
            </tr>
          </thead>
          <tbody><tr>${truCell(r.tuTru.nam)}${truCell(r.tuTru.thang)}${truCell(r.tuTru.ngay)}</tr></tbody>
        </table>
        <div class="mt-3 space-y-1 text-sm text-(--color-ink-700)">
          <p><strong>Tọa nhà:</strong> ${esc(r.toaNha.ten)} — cung ${esc(r.toaNha.cung)}${r.toaNha.phuong ? ` (phương ${esc(r.toaNha.phuong)})` : " (chưa rõ phương — cần độ số)"} — ${r.toaNha.hknh !== null ? `quẻ <strong class="text-(--color-gold-400)">${r.toaNha.hknh}/${r.toaNha.quaiVan}</strong>` : `<span class="text-(--color-gold-400)">chưa nhập quẻ tọa</span>`}</p>
          ${r.huongNha ? `<p><strong>Hướng nhà:</strong> ${esc(r.huongNha.ten)} — cung ${esc(r.huongNha.cung)}</p>` : ""}
          <p><strong>Mệnh Chủ chính:</strong> ${esc(r.menhChuChinh.canChiNamSinh)} — ${esc(r.menhChuChinh.que)} <strong class="text-(--color-gold-400)">${r.menhChuChinh.hknh}/${r.menhChuChinh.quaiVan}</strong></p>
          ${r.menhChuPhu ? `<p><strong>Mệnh Chủ phụ:</strong> ${esc(r.menhChuPhu.canChiNamSinh)} — ${esc(r.menhChuPhu.que)} <strong class="text-(--color-gold-400)">${r.menhChuPhu.hknh}/${r.menhChuPhu.quaiVan}</strong></p>` : ""}
        </div>
      </div>

      <div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Chiếu từng bước</p>
        <div class="mt-3 space-y-2">${buocHtml}</div>
      </div>

      <div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Bước 6 — Giờ đề xuất trong ngày</p>
        <p class="mt-1 text-xs text-(--color-ink-500)">Xếp hạng 12 giờ Địa Chi. Nguyên tắc nguồn: không hy sinh chất lượng Ngày để lấy Giờ đẹp.</p>
        <div class="mt-3 space-y-2">${gioHtml}</div>
      </div>

      <div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Điểm mạnh của cách cục</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-(--color-ink-700)">${dsHtml(r.diemManh)}</ul>
        <p class="mt-4 text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Điểm cần lưu ý</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-(--color-ink-700)">${dsHtml(r.diemLuuY)}</ul>
      </div>

      <p class="text-xs text-(--color-ink-500)">
        Kết quả tính theo phương pháp Huyền Không Đại Quái từ tư liệu chuyên môn, mang tính tham khảo.
        Không thay thế tư vấn phong thủy trực tiếp. <a href="/lien-he" class="text-(--color-gold-300) hover:underline">Đặt lịch tư vấn</a>.
      </p>
    `;
    el.classList.remove("hidden");
  }

  const form = document.getElementById("xncc-form") as HTMLFormElement;
  const loiEl = document.getElementById("xncc-loi")!;
  const ketQuaEl = document.getElementById("xncc-ket-qua")!;

  // Cờ thử nghiệm đọc từ frontmatter qua data-test-mode (1 nguồn sự thật).
  const TEST_MODE = form.dataset.testMode === "true";

  const thanhToanEl = document.getElementById("xncc-thanh-toan")!;
  const qrImg = document.getElementById("xncc-qr") as HTMLImageElement;
  const orderCodeEl = document.getElementById("xncc-order-code")!;
  const trangThaiEl = document.getElementById("xncc-trang-thai")!;
  const soTienEl = document.getElementById("xncc-so-tien")!;

  // Khối "đang chạy" khai báo ở phạm vi module vì cả lúc nộp form lẫn lúc chờ thanh toán đều dùng.
  const dangChayEl = document.getElementById("xncc-dang-chay")!;
  const dangChayChiTiet = document.getElementById("xncc-dang-chay-chi-tiet")!;
  const nutSubmit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const tatDangChay = () => {
    dangChayEl.classList.add("hidden");
    if (nutSubmit) nutSubmit.disabled = false;
  };

  let pollTimer: ReturnType<typeof setInterval> | null = null;
  // Chặn 2 lượt hỏi kết quả chồng nhau. Chế độ tìm tháng quét ~365 ngày mất 20-30 giây, mà nhịp
  // hỏi là 3 giây — không có cờ này thì mỗi nhịp lại châm thêm một lượt quét cả năm, chồng cả chục
  // lượt và làm nghẽn máy chủ.
  let dangHoi = false;

  function dungCho() {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  // Xem trước quẻ Tọa ngay khi gõ độ số — để người dùng đối chiếu với la kinh trước khi bấm tính.
  // Chỉ là hiển thị phụ trợ; nguồn sự thật vẫn là engine phía server (cùng 1 bảng dữ liệu).
  const doSoInput = document.getElementById("xncc-do-so") as HTMLInputElement;
  const quePreviewEl = document.getElementById("xncc-que-preview")!;
  const VONG_64_QUE = [
    "Phục", "Di", "Truân", "Ích", "Chấn", "Phệ Hạp", "Tùy", "Vô Vọng",
    "Minh Di", "Bí", "Ký Tế", "Gia Nhân", "Phong", "Ly", "Cách", "Đồng Nhân",
    "Lâm", "Tổn", "Tiết", "Trung Phu", "Quy Muội", "Khuê", "Đoài", "Lý",
    "Thái", "Đại Súc", "Nhu", "Tiểu Súc", "Đại Tráng", "Đại Hữu", "Quải", "Càn",
    "Cấu", "Đại Quá", "Đỉnh", "Hằng", "Tốn", "Tỉnh", "Cổ", "Thăng",
    "Tụng", "Khốn", "Vị Tế", "Giải", "Hoán", "Khảm", "Mông", "Sư",
    "Độn", "Hàm", "Lữ", "Tiểu Quá", "Tiệm", "Kiển", "Cấn", "Khiêm",
    "Bĩ", "Tụy", "Tấn", "Dự", "Quan", "Tỷ", "Bác", "Khôn",
  ];
  function capNhatXemTruocQue() {
    const raw = doSoInput.value;
    if (raw === "") {
      quePreviewEl.classList.add("hidden");
      return;
    }
    const d = Number(raw);
    if (!Number.isFinite(d) || d < 0 || d >= 360) {
      quePreviewEl.classList.add("hidden");
      return;
    }
    const idx = Math.floor(d / 5.625);
    const bd = (idx * 5.625).toFixed(3);
    const kt = ((idx + 1) * 5.625).toFixed(3);
    quePreviewEl.textContent = `→ Quẻ Tọa: ${VONG_64_QUE[idx]} (quẻ số ${idx + 1}, khoảng ${bd}°–${kt}°)`;
    quePreviewEl.classList.remove("hidden");
  }
  doSoInput.addEventListener("input", capNhatXemTruocQue);
  capNhatXemTruocQue();

  // Tiện ích: nhiều người chỉ đo được HƯỚNG (mặt nhà) bằng app la bàn điện thoại. Tọa = hướng + 180°.
  const doHuongInput = document.getElementById("xncc-do-huong") as HTMLInputElement;
  document.getElementById("xncc-doi-huong-sang-toa")!.addEventListener("click", () => {
    const h = Number(doHuongInput.value);
    if (doHuongInput.value === "" || !Number.isFinite(h) || h < 0 || h >= 360) {
      loiEl.textContent = "Nhập độ số của hướng (0–359.99) trước khi đổi sang tọa.";
      loiEl.classList.remove("hidden");
      return;
    }
    loiEl.classList.add("hidden");
    doSoInput.value = String(Math.round(((h + 180) % 360) * 100) / 100);
    capNhatXemTruocQue();
  });

  // --- Chuyển ô nhập theo chế độ đang chọn ---
  const oNam = document.getElementById("xncc-o-nam")!;
  const oKhoang = document.getElementById("xncc-o-khoang")!;
  const oMotNgay = document.getElementById("xncc-o-mot-ngay")!;
  const nhanNut = document.getElementById("xncc-nhan-nut")!;
  const namTimSelect = document.getElementById("xncc-nam-tim") as HTMLSelectElement;
  const namNay = new Date().getFullYear();
  for (let y = namNay; y <= Math.min(namNay + 5, 2068); y++) {
    namTimSelect.insertAdjacentHTML("beforeend", `<option value="${y}">${y}</option>`);
  }

  function cheDoDangChon(): string {
    return (form.querySelector('input[name="cheDo"]:checked') as HTMLInputElement).value;
  }
  function capNhatOTheoCheDo() {
    const cd = cheDoDangChon();
    oNam.classList.toggle("hidden", cd !== "tim_thang");
    oKhoang.classList.toggle("hidden", cd !== "tim_ngay");
    oKhoang.classList.toggle("grid", cd === "tim_ngay");
    oMotNgay.classList.toggle("hidden", cd !== "giam_dinh");
    nhanNut.textContent =
      cd === "tim_thang" ? "Tìm tháng phù hợp" : cd === "tim_ngay" ? "Tìm ngày phù hợp" : "Giám định ngày";
  }
  form.querySelectorAll('input[name="cheDo"]').forEach((r) => r.addEventListener("change", capNhatOTheoCheDo));
  capNhatOTheoCheDo();

  const TEN_MUC: Record<string, string> = {
    ly_tuong: "Lý tưởng",
    tot: "Tốt",
    duoc: "Được",
    khong_dung: "Không dùng",
  };
  const MAU_MUC: Record<string, string> = {
    ly_tuong: "bg-(--color-success-500)/20 text-(--color-success-500) border-(--color-success-500)/50",
    tot: "bg-(--color-success-500)/10 text-(--color-success-500) border-(--color-success-500)/30",
    duoc: "bg-(--color-gold-400)/15 text-(--color-gold-600) border-(--color-gold-300)",
  };

  interface YeuToDatUI { ten: string; diem: number }
  interface NgayXH {
    ngayDuongLich: { nam: number; thang: number; ngay: number };
    amLich: { ngay: number; thang: number; nam: number; nhuan: boolean };
    canChiNgay: string;
    diem: number;
    muc: string;
    yeuToDat: YeuToDatUI[];
    gioTot: { chiGio: string; khungGio: string; tenSao: string }[];
  }

  function theNgay(n: NgayXH): string {
    const d = n.ngayDuongLich;
    const gio = n.gioTot.length
      ? n.gioTot.map((g) => `${g.chiGio} (${g.khungGio})`).join(" · ")
      : "Không có giờ Hoàng Đạo sạch trong ngày";
    return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="font-display text-lg font-bold text-(--color-ink-950)">
          ${String(d.ngay).padStart(2, "0")}/${String(d.thang).padStart(2, "0")}/${d.nam}
          <span class="ml-1 text-sm font-normal text-(--color-ink-500)">(ÂL ${n.amLich.ngay}/${n.amLich.thang}${n.amLich.nhuan ? " nhuận" : ""} · ${n.canChiNgay})</span>
        </p>
        <span class="rounded-(--radius-pill) border px-2.5 py-0.5 text-xs font-semibold ${MAU_MUC[n.muc] ?? ""}">${TEN_MUC[n.muc] ?? n.muc} · ${n.diem} điểm</span>
      </div>
      <p class="mt-2 text-sm text-(--color-ink-700)"><strong>Giờ tốt:</strong> ${gio}</p>
      <details class="mt-2">
        <summary class="cursor-pointer text-xs font-medium text-(--color-gold-300)">Vì sao ngày này được ${n.diem} điểm?</summary>
        <ul class="mt-1.5 space-y-0.5 text-xs text-(--color-ink-600)">
          ${n.yeuToDat.map((y) => `<li>${y.diem >= 0 ? "+" : ""}${y.diem} — ${y.ten}</li>`).join("")}
        </ul>
      </details>
    </div>`;
  }

  function renderTimNgay(data: any) {
    if (data.soNgayDung === 0) {
      const lyDo = (data.lyDoLoaiPhoBien ?? [])
        .map((l: any) => `<li><strong>${l.soNgay} ngày</strong> — ${l.lyDo}</li>`)
        .join("");
      ketQuaEl.innerHTML = `<div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="font-display text-lg font-bold">Không có ngày nào dùng được trong khoảng đã quét</p>
        <p class="mt-1 text-sm text-(--color-ink-600)">Đã quét ${data.tongSoNgayQuet} ngày. Lý do bị loại nhiều nhất:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-(--color-ink-700)">${lyDo}</ul>
        <p class="mt-3 text-sm text-(--color-ink-700)">Thường gặp khi tọa nhà phạm sát theo NĂM — khi đó cả năm đều vướng, nên cân nhắc <strong>đổi sang năm khác</strong>, hoặc <a href="/lien-he" class="text-(--color-gold-300) hover:underline">hỏi chuyên gia về phương án mượn tuổi</a>.</p>
      </div>`;
    } else {
      ketQuaEl.innerHTML = `<div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
        <p class="font-display text-lg font-bold">Tìm được ${data.soNgayDung} ngày dùng được / ${data.tongSoNgayQuet} ngày đã quét</p>
        <p class="mt-1 text-sm text-(--color-ink-600)">Xếp theo tổng số yếu tố tốt đạt được — càng nhiều yếu tố, điểm càng cao.</p>
        <div class="mt-3 space-y-2">${data.ketQua.map(theNgay).join("")}</div>
      </div>`;
    }
    ketQuaEl.classList.remove("hidden");
    ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function renderTimThang(data: any) {
    const co = data.thang.filter((t: any) => t.soNgayDung > 0);
    const khong = data.thang.filter((t: any) => t.soNgayDung === 0).map((t: any) => t.thangDuongLich);
    const khoi = co.length
      ? co
          .sort((a: any, b: any) => b.diemCaoNhat - a.diemCaoNhat)
          .map(
            (t: any) => `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-100) p-4">
              <p class="font-display text-base font-bold text-(--color-ink-950)">Tháng ${t.thangDuongLich}/${t.namDuongLich} — ${t.soNgayDung} ngày dùng được</p>
              <p class="mt-1 text-xs text-(--color-ink-500)">Ngày tốt nhất trong tháng:</p>
              <div class="mt-1.5">${theNgay(t.ngayTotNhat)}</div>
            </div>`,
          )
          .join("")
      : "";
    ketQuaEl.innerHTML = `<div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
      <p class="font-display text-lg font-bold">Năm ${data.namDuongLich}: ${co.length}/12 tháng có ngày dùng được</p>
      ${khong.length ? `<p class="mt-1 text-sm text-(--color-ink-600)">Không có ngày nào dùng được trong tháng: <strong>${khong.join(", ")}</strong>.</p>` : ""}
      ${co.length ? `<div class="mt-3 space-y-3">${khoi}</div>` : `<p class="mt-3 text-sm text-(--color-ink-700)">Cả năm ${data.namDuongLich} đều không có ngày phù hợp với tọa nhà này — thường do phạm sát theo NĂM. Nên thử năm khác, hoặc <a href="/lien-he" class="text-(--color-gold-300) hover:underline">hỏi chuyên gia về phương án mượn tuổi</a>.</p>`}
    </div>`;
    ketQuaEl.classList.remove("hidden");
    ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  /** Gọi đúng hàm hiển thị theo chế độ. Dùng chung cho cả nhánh thử nghiệm lẫn nhánh thu phí. */
  function hienKetQua(data: any) {
    if (data.cheDo === "tim_thang") return renderTimThang(data);
    if (data.cheDo === "tim_ngay") return renderTimNgay(data);
    render(data.result as XemNgayCaoCapResult);
    ketQuaEl.classList.remove("hidden");
    ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  /**
   * Hỏi máy chủ xem đơn đã thanh toán chưa; xong thì hiển thị kết quả.
   *
   * Cờ `dangHoi` bắt buộc phải có: chế độ tìm tháng quét ~365 ngày mất 20-30 giây, trong khi nhịp
   * hỏi là 3 giây — thiếu cờ này thì các lượt hỏi chồng lên nhau và máy chủ phải quét lại cả năm
   * hàng chục lần cho cùng một đơn.
   */
  async function layKetQua(orderCode: string) {
    if (dangHoi) return;
    dangHoi = true;
    try {
      const res = await fetch(`/api/dai-cat-loi/xem-ngay-cao-cap/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!data.ok) return;

      if (data.status === "cancelled") {
        dungCho();
        trangThaiEl.textContent = "Đơn hàng đã bị hủy.";
        return;
      }
      if (data.status !== "confirmed") return;

      dungCho();
      dangChayEl.classList.add("hidden");
      thanhToanEl.classList.add("hidden");
      hienKetQua(data);
    } catch {
      // Mạng chập chờn — cứ để nhịp hỏi sau thử lại, không báo lỗi làm khách hoảng.
    } finally {
      dangHoi = false;
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const cheDo = cheDoDangChon();
    const loaiViec = (form.querySelector('input[name="loaiViec"]:checked') as HTMLInputElement).value;
    const toaNha = (document.getElementById("xncc-toa") as HTMLSelectElement).value;
    const huongNha = (document.getElementById("xncc-huong") as HTMLSelectElement).value;
    const toaDoSo = (document.getElementById("xncc-do-so") as HTMLInputElement).value;
    const namSinhGiaChuChinh = (document.getElementById("xncc-nam-sinh") as HTMLInputElement).value;
    const namSinhVoChong = (document.getElementById("xncc-nam-sinh-phu") as HTMLInputElement).value;

    const chung = {
      loaiViec,
      toaNha,
      ...(huongNha ? { huongNha } : {}),
      ...(toaDoSo ? { toaDoSo: Number(toaDoSo) } : {}),
      namSinhGiaChuChinh: Number(namSinhGiaChuChinh),
      ...(namSinhVoChong ? { namSinhVoChong: Number(namSinhVoChong) } : {}),
    };

    const baoLoi = (msg: string) => {
      tatDangChay();
      loiEl.textContent = msg;
      loiEl.classList.remove("hidden");
    };

    // Quét cả năm phải chạy ~365 lượt tính đầy đủ nên mất hàng chục giây — bắt buộc báo cho người
    // dùng biết, nếu không họ tưởng web hỏng và bấm lại nhiều lần.
    dangChayChiTiet.textContent =
      cheDo === "tim_thang"
        ? "Đang quét cả 12 tháng (khoảng 365 ngày) — mất khoảng 20-30 giây."
        : cheDo === "tim_ngay"
          ? "Đang quét từng ngày trong khoảng đã chọn — vài giây tới nửa phút tùy độ dài."
          : "Đang giám định ngày…";
    dangChayEl.classList.remove("hidden");
    if (nutSubmit) nutSubmit.disabled = true;

    // Dữ liệu riêng của từng chế độ — gom lại để cả 2 nhánh (thử nghiệm / thu phí) dùng chung.
    let rieng: Record<string, unknown>;
    if (cheDo === "giam_dinh") {
      const ngay = readDateSelects("xncc-ngay");
      if (!ngay) return baoLoi("Vui lòng chọn đầy đủ ngày cần giám định.");
      rieng = { ngayGiamDinh: { nam: ngay.year, thang: ngay.month, ngay: ngay.day } };
    } else if (cheDo === "tim_thang") {
      rieng = { namDuongLich: Number(namTimSelect.value) };
    } else {
      const tu = readDateSelects("xncc-tu");
      const den = readDateSelects("xncc-den");
      if (!tu || !den) return baoLoi("Vui lòng chọn đầy đủ ngày bắt đầu và ngày kết thúc.");
      rieng = {
        tuNgay: { nam: tu.year, thang: tu.month, ngay: tu.day },
        denNgay: { nam: den.year, thang: den.month, ngay: den.day },
      };
    }

    try {
      // ── Nhánh THỬ NGHIỆM: gọi thẳng endpoint tính, không tạo đơn, không thu tiền ──
      if (TEST_MODE) {
        const url =
          cheDo === "giam_dinh"
            ? "/api/dai-cat-loi/xem-ngay-cao-cap/test-calculate"
            : "/api/dai-cat-loi/xem-ngay-cao-cap/tim-ngay";
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...chung, ...rieng, cheDo }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tính được.");
        tatDangChay();
        hienKetQua({ ...data, cheDo });
        return;
      }

      // ── Nhánh THU PHÍ: tạo đơn, chờ thanh toán, rồi mới trả kết quả ──
      const res = await fetch("/api/dai-cat-loi/xem-ngay-cao-cap/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...chung,
          ...rieng,
          cheDo,
          customerName: (document.getElementById("xncc-ten") as HTMLInputElement | null)?.value.trim() ?? "",
          customerPhone: (document.getElementById("xncc-sdt") as HTMLInputElement | null)?.value.trim() ?? "",
          customerEmail: (document.getElementById("xncc-email") as HTMLInputElement | null)?.value.trim() ?? "",
          maKhuyenMai: (document.getElementById("xncc-ma-input") as HTMLInputElement | null)?.value.trim() ?? "",
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
      tatDangChay();
      orderCodeEl.textContent = data.orderCode;

      // Mã miễn phí 100%: server đã xác nhận đơn luôn và trả qrUrl = null. Không gán null vào thẻ
      // ảnh (QR vỡ) rồi bảo khách "đang chờ thanh toán" — lấy kết quả về ngay.
      if (data.mienPhi) {
        dangChayChiTiet.textContent = "Đã áp mã miễn phí — đang lấy kết quả…";
        dangChayEl.classList.remove("hidden");
        await layKetQua(data.orderCode);
        return;
      }

      soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
      qrImg.src = data.qrUrl;
      trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      thanhToanEl.classList.remove("hidden");
      thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
      pollTimer = setInterval(() => layKetQua(data.orderCode), 3000);
    } catch {
      baoLoi("Không tính được. Vui lòng thử lại.");
    }
  });
</script>
