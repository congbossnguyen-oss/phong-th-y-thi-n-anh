                          {cung.cung} — {cung.bo_ba}
                          {cung.la_cung_toa && <span class="ml-2 text-sm font-bold text-(--color-cinnabar-500)">◄ TỌA</span>}
                          {cung.la_cung_huong && <span class="ml-2 text-sm font-bold text-(--color-cinnabar-500)">◄ HƯỚNG</span>}
                        </p>
                        <div class="mt-2 space-y-2">
                          {cung.goi_y.map((g) => (
                            <div class="rounded border-l-4 border-(--color-cinnabar-500)/50 bg-(--color-ivory-100) px-3 py-2">
                              <p class="text-sm font-bold text-(--color-ink-900)">
                                <span class="mr-1.5 rounded bg-(--color-ink-900)/10 px-1.5 py-0.5 text-xs font-semibold text-(--color-ink-700)">{NHAN_LOAI_HOA_GIAI[g.loai]}</span>
                                {g.tieu_de}
                              </p>
                              <p class="mt-1 text-sm text-(--color-ink-800)">{g.chi_tiet}</p>
                              {g.bang.length > 0 && (
                                <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 rounded bg-(--color-ivory-50) p-2 text-sm">
                                  {g.bang.map(([nhan, giaTri]) => (
                                    <>
                                      <dt class="font-semibold text-(--color-ink-700)">{nhan}</dt>
                                      <dd class="text-(--color-ink-900)">{giaTri}</dd>
                                    </>
                                  ))}
                                </dl>
                              )}
                              <p class="mt-1.5 text-xs text-(--color-ink-500)">
                                Đọc thêm:{" "}
                                {g.nguon_md.map((file, i) => (
                                  <>
                                    {i > 0 && ", "}
                                    <a
                                      href={`#${idThuVien(file)}`}
                                      class="italic text-(--color-cinnabar-500) underline decoration-dotted hover:decoration-solid"
                                    >{NHAN_NGAN_THEO_FILE[file] ?? file}</a>
                                  </>
                                ))}
                                {" "}(bấm để bung ngay bên dưới)
                              </p>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  )}
                </div>

                <p class="mt-4 rounded-(--radius-control) border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 p-3 text-xs font-medium text-(--color-gold-700)">
                  ⚠️ Vật phẩm hóa giải chỉ là <strong>gợi ý tham khảo</strong>, hiệu quả phụ thuộc loan đầu thực tế và phải do chuyên gia đối chiếu tại chỗ. Engine KHÔNG tự kết luận đắc/thất cách hay cát/hung cuối cùng.
                </p>

                {THU_VIEN_HOA_GIAI.length > 0 && (
                  <div class="mt-5">
                    <h3 class="font-display text-lg font-bold text-(--color-ink-950)">Thư viện hóa giải chi tiết (nguồn đầy đủ)</h3>
                    <p class="mt-1 text-xs text-(--color-ink-600)">Bấm để bung nội dung đầy đủ từ tài liệu gốc — dùng khi cần tra sâu ngoài gợi ý ngắn ở trên. Link "Tra chi tiết" ở mỗi gợi ý phía trên sẽ tự nhảy xuống và bung đúng mục tương ứng ở đây.</p>
                    <div class="mt-2 space-y-2">
                      {THU_VIEN_HOA_GIAI.map((f) => (
                        <details id={idThuVien(f.file)} class="scroll-mt-24 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50)">
                          <summary class="cursor-pointer px-4 py-2.5 text-sm font-semibold text-(--color-ink-900)">{f.tieu_de}</summary>
                          <pre class="max-h-[28rem] overflow-y-auto whitespace-pre-wrap border-t border-(--color-ivory-300) px-4 py-3 text-xs leading-relaxed text-(--color-ink-800)">{f.noi_dung}</pre>
                        </details>
                      ))}
                    </div>
                  </div>
                )}

                <script is:inline>
                  // Bấm link "Tra chi tiết: <tên>" ở trên → tự MỞ đúng <details> tương ứng trong thư
                  // viện + cuộn tới đó, thay vì chỉ nhảy neo suông (một số webview trong app Zalo/
                  // Facebook không tự mở <details> khi nhảy neo, nên tự mở bằng JS cho chắc — anh Công
                  // phản hồi 9/9/2026 không biết tra hóa giải ở đâu).
                  //
                  // is:inline BẮT BUỘC ở đây: trang này SSR theo yêu cầu (prerender=false, phụ thuộc
                  // Astro.locals.user lúc chạy) nên lúc build tĩnh Astro không "thấy" khối admin này
                  // để đóng gói script riêng — đã tự kiểm bằng build thật: KHÔNG dùng is:inline thì
                  // Astro tạo entry cho script trong manifest server nhưng KHÔNG sinh ra file .js
                  // tương ứng trong dist/client/_astro/ → script 404, im lặng không chạy trên web
                  // thật. is:inline nhúng thẳng script vào HTML, không qua bước đóng gói nên không
                  // dính lỗi này. Vì is:inline KHÔNG được biên dịch, cố tình viết JS thuần (bỏ kiểu
                  // TypeScript, tránh cú pháp quá mới) để chạy được cả trên webview cũ trong app.
                  function moHoaGiaiTheoHash(hash) {
                    if (!hash || hash.indexOf("#hg-lib-") !== 0) return;
                    var el = document.querySelector(hash);
                    if (!el || el.tagName !== "DETAILS") return;
                    el.open = true;
                    el.scrollIntoView({ behavior: "smooth", block: "start" });
                  }
                  document.addEventListener("click", function (e) {
                    var a = e.target && e.target.closest ? e.target.closest('a[href^="#hg-lib-"]') : null;
                    if (!a) return;
                    e.preventDefault();
                    var hash = a.getAttribute("href") || "";
                    if (window.history && window.history.pushState) window.history.pushState(null, "", hash);
                    moHoaGiaiTheoHash(hash);
                  });
                  if (window.location.hash) moHoaGiaiTheoHash(window.location.hash);
                </script>
              </section>
            )}

            <section class="rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-6 text-center">
              <p class="font-display text-xl font-bold text-(--color-ink-950)">Cần luận chi tiết theo đúng hoàn cảnh nhà mình?</p>
              <p class="mx-auto mt-2 max-w-2xl text-base font-medium text-(--color-ink-800)">
                Phần trên là lớp TÍNH TOÁN khách quan (tinh bàn, cách cục, vượng/suy, Thành Môn, bố trí thủy). Để luận sâu từng cung theo loan đầu thực tế, xét đắc/thất cách và đưa phương án hóa giải phù hợp riêng cho nhà bạn, chuyên gia Phong Thủy Thiên Anh sẽ trực tiếp đối chiếu và tư vấn.
              </p>
              <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
                <Button href="/lien-he" size="lg">Liên hệ chuyên gia luận chi tiết</Button>
                <a href="/dich-vu" class="text-sm font-semibold text-(--color-cinnabar-500) underline">Xem dịch vụ tư vấn phong thủy nhà ở</a>
              </div>
            </section>

            <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4 text-sm font-medium text-(--color-ink-800)">
              <p class="text-base font-bold text-(--color-ink-950)">Phạm vi & độ tin cậy</p>
              <p class="mt-1">
                Công cụ chỉ tính phần KHÁCH QUAN (từ tọa độ, vận, công thức Huyền Không Phi Tinh). Kết luận cát hung cuối cùng cần đối chiếu loan đầu thực tế
                và KHÔNG được suy ra tự động — kể cả khi bạn đã điền đủ Nhóm B ở trên.
              </p>
              {kq.van_nha !== 9 && (
                <p class="mt-1">
                  ⚠️ Nhà thuộc Vận {kq.van_nha}: cách lập tinh bàn giống Vận 9, nhưng phần đối chiếu sẵn có mới đầy đủ cho nhà Vận 9 — với nhà vận khác nên nhờ chuyên gia rà lại cho chắc. Vượng/suy đã xét theo Vận {kq.van_hien_tai} hiện tại.
                </p>
              )}
              {(kq.tinh_ban.phan_loai_huong.muc === "xau" || kq.tinh_ban.phan_loai_huong.muc === "nguy_hiem" ||
                kq.tinh_ban.phan_loai_toa.muc === "xau" || kq.tinh_ban.phan_loai_toa.muc === "nguy_hiem") && (
                <p class="mt-1">
                  ⚠️ Nhà phạm Không Vong — việc cần làm trước tiên là chỉnh lại hướng, không phải hóa giải từng cung.
                </p>
              )}
            </section>
          </div>
        )}
    </>
  </div>
</Container>

