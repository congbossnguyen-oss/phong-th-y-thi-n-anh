---
// Công cụ "Xem phong thủy nhà theo Huyền Không Phi Tinh" — bản TÍNH TOÁN (Free, 0đ, KHÔNG AI),
// CÔNG KHAI, đăng ký ở site-config.ts mục Công cụ.
//
// KHÔNG dùng AI (anh Công 30/8/2026: "huyền không phi tinh không sử dụng AI được không? luận như
// bình thường được rồi, xong CTV với chuyên gia"). Lớp engine.ts tính toán khách quan (tinh bàn,
// cách cục, vượng/suy, Thành Môn, Chính-Linh Thần, Thu Sơn Xuất Sát); phần LUẬN CHI TIẾT theo hoàn
// cảnh cụ thể do CTV/chuyên gia trực tiếp làm — cuối trang có CTA mời liên hệ chuyên gia (/lien-he)
// thay cho nút AI cũ. Toàn bộ code AI (route + lib luan-ai.ts + tri-thuc-ai.ts) đã gỡ, vì model
// DeepSeek thinking gây lỗi + anh Công quyết chuyển sang chuyên gia người thật.
//
// NGUYÊN TẮC "KHÔNG ĐOÁN MÒ": trang CHỈ hiển thị lại dữ liệu Nhóm B (loan đầu) do khách khai cạnh
// tinh bàn — KHÔNG tự phán đắc/thất cách hay cát/hung từ tổ hợp đó (xem KHONG_TINH trong engine.ts).
// Việc đối chiếu đắc/thất cách + kết luận cát hung là của chuyên gia.
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import {
  CUNG_INFO,
  TEN_SAO,
  tinhToanHuyenKhong,
  trangThaiSao,
  vanTuNam,
  type KetQuaHuyenKhong,
} from "../../lib/huyen-khong-phi-tinh/engine";

export const prerender = false;

// 🔒 Admin-gate cho khối HÓA GIẢI bổ sung (anh Công 9/9/2026 chốt: "chỉ admin xem"). Phần TÍNH TOÁN
// hiện có (tinh bàn, cách cục, Thành Môn, Chính-Linh Thần, Thu Sơn Xuất Sát, chi tiết cung) GIỮ NGUYÊN
// công khai cho khách; chỉ khối "Gợi ý hóa giải" mới + thư viện .md là chỉ hiện cho admin. Vì component
// SSR (prerender=false), khối này chỉ render bên trong {laQuanTri && ...} nên KHÔNG lọt vào HTML gửi cho
// khách chưa đăng nhập admin — cùng cơ chế trang /kiem-chung Bát Trạch.
const laQuanTri = Astro.locals.user?.isAdmin === true;

// 8 hướng bát quái theo thứ tự la bàn, dùng cho mọi select/checkbox Nhóm B (cung Lạc Thư, bỏ Trung Cung).
const HUONG_8 = [1, 8, 3, 4, 9, 2, 7, 6];

const q = Astro.url.searchParams;
const soTuQuery = (ten: string): number | null => {
  const raw = q.get(ten);
  if (raw === null || raw.trim() === "") return null;
  const n = Number(raw);
  return Number.isFinite(n) ? n : null;
};

const loaiDo = q.get("loaiDo") === "toa" ? "toa" : "huong";
const doNhap = soTuQuery("do");
const namNhapTrach = soTuQuery("nam");
const daGuiForm = doNhap !== null && namNhapTrach !== null;

const cungTuQuery = (ten: string): number[] =>
  q
    .getAll(ten)
    .map(Number)
    .filter((n) => HUONG_8.includes(n));
const cungDonTuQuery = (ten: string): number | null => {
  const n = Number(q.get(ten));
  return HUONG_8.includes(n) ? n : null;
};

const nhomB = {
  nui: cungTuQuery("nui"),
  nuoc: cungTuQuery("nuoc"),
  cuaChinh: cungDonTuQuery("cuaChinh"),
  bep: cungDonTuQuery("bep"),
  giuongNgu: cungDonTuQuery("giuongNgu"),
  banLamViec: cungDonTuQuery("banLamViec"),
  cauThang: cungDonTuQuery("cauThang"),
  wc: cungTuQuery("wc"),
  gieng: cungDonTuQuery("gieng"),
  soTang: soTuQuery("soTang"),
};
const nhomBTrong =
  nhomB.nui.length === 0 &&
  nhomB.nuoc.length === 0 &&
  nhomB.cuaChinh === null &&
  nhomB.bep === null &&
  nhomB.giuongNgu === null &&
  nhomB.banLamViec === null &&
  nhomB.cauThang === null &&
  nhomB.wc.length === 0 &&
  nhomB.gieng === null;

// van = VẬN NHÀ (từ năm nhập trạch), dùng lập tinh bàn. vanHienTai = vận đương lệnh (từ năm nay),
// dùng xét vượng/suy. Nhà cũ (vd nhập trạch 2003 = Vận 7) xem trong Vận 9 thì 2 vận khác nhau —
// tinh bàn giữ Vận 7 nhưng vượng/suy xét theo Vận 9 (nhà đã thoái vận).
let van: number | null = null;
let vanHienTai: number | null = null;
let doHuong: number | null = null;
let loi: string | null = null;
let kq: KetQuaHuyenKhong | null = null;

if (daGuiForm) {
  if (doNhap! < 0 || doNhap! > 360) {
    loi = "Độ la bàn phải trong khoảng 0–360°.";
  } else if (namNhapTrach! < 1900 || namNhapTrach! > new Date().getFullYear() + 1) {
    loi = "Năm nhập trạch không hợp lệ.";
  } else {
    van = vanTuNam(namNhapTrach!);
    vanHienTai = vanTuNam(new Date().getFullYear());
    doHuong = loaiDo === "toa" ? (doNhap! + 180) % 360 : doNhap!;
    kq = tinhToanHuyenKhong(doHuong, van, { vanHienTai });
  }
}

// Ghi chú loan đầu theo từng cung (cho phần hiển thị cạnh tinh bàn) — CHỈ liệt kê lại, không phán.
function ghiChuLoanDau(cung: number): string[] {
  const gc: string[] = [];
  if (nhomB.nui.includes(cung)) gc.push("🏔️ núi/nhà cao/cây lớn");
  if (nhomB.nuoc.includes(cung)) gc.push("💧 sông hồ/đường lớn/đất trống");
  if (nhomB.cuaChinh === cung) gc.push("🚪 cửa chính");
  if (nhomB.bep === cung) gc.push("🍳 bếp");
  if (nhomB.giuongNgu === cung) gc.push("🛏️ giường ngủ");
  if (nhomB.banLamViec === cung) gc.push("💼 bàn làm việc");
  if (nhomB.cauThang === cung) gc.push("🪜 cầu thang");
  if (nhomB.wc.includes(cung)) gc.push("🚽 WC");
  if (nhomB.gieng === cung) gc.push("☀️ giếng trời");
  return gc;
}

const LUOI_3X3 = [
  [4, 9, 2],
  [3, 5, 7],
  [8, 1, 6],
];

const MAU_MUC: Record<string, string> = {
  tot: "border-emerald-500/50 bg-emerald-500/10 text-emerald-700",
  canh_bao: "border-(--color-gold-400)/50 bg-(--color-gold-400)/10 text-(--color-gold-600)",
  xau: "border-(--color-danger-500)/40 bg-(--color-danger-500)/10 text-(--color-danger-500)",
  nguy_hiem: "border-(--color-danger-500)/60 bg-(--color-danger-500)/20 text-(--color-danger-500)",
};

const MAU_TRANG_THAI: Record<string, string> = {
  "VƯỢNG": "text-emerald-700",
  "SINH": "text-(--color-gold-700)",
  "SUY": "text-(--color-ink-700)",
  "TỬ": "text-(--color-danger-600)",
  "TỬ/XA": "text-(--color-ink-600)",
};

// Thư viện hóa giải chi tiết (chỉ nạp cho khối admin). Bundle .md lúc build qua import.meta.glob(?raw)
// — cùng cách content-loader.ts của Bát Tự/Tử Vi, chạy được cả Node lẫn Cloudflare (không đọc fs lúc
// chạy). Nguồn giữ 1 bản duy nhất ở docs/huyen-khong-phi-tinh/references/, KHÔNG hardcode vào TS.
const refModules = import.meta.glob("../../../docs/huyen-khong-phi-tinh/references/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const docRef = (ten: string): string => {
  const key = Object.keys(refModules).find((k) => k.endsWith(`/${ten}`));
  return key ? refModules[key] : "";
};
const THU_VIEN_HOA_GIAI = laQuanTri
  ? [
      { file: "l-bo-hoa-giai-tong-hop.md", tieu_de: "Bộ hóa giải tổng hợp (11 phần — đọc phần 1 trước)" },
      { file: "c-hoa-giai-sat-khi.md", tieu_de: "Hóa giải sát khí (xếp theo đồng thuận nhiều thầy)" },
      { file: "h-81-cap-sao-va-hoa-giai.md", tieu_de: "81 cặp sao & cách hóa từng cặp" },
      { file: "i-thu-son-xuat-sat-cua-chinh-duong-khi.md", tieu_de: "Hóa bằng bố cục (Thu Sơn Xuất Sát)" },
    ].map((x) => ({ ...x, noi_dung: docRef(x.file) }))
  : [];

// Neo (id) cho từng file trong "Thư viện hóa giải chi tiết" bên dưới — dùng để biến dòng
// "Tra chi tiết: <tên file>" ở mỗi gợi ý hóa giải thành LINK bấm nhảy thẳng + tự bung đúng mục,
// thay vì hiện tên file trần khiến admin không biết tra ở đâu (anh Công phản hồi 9/9/2026).
const idThuVien = (file: string): string =>
  `hg-lib-${file.replace(/\.md$/i, "").replace(/[^a-zA-Z0-9_-]/g, "-")}`;
const NHAN_NGAN_THEO_FILE: Record<string, string> = {
  "l-bo-hoa-giai-tong-hop.md": "Bộ hóa giải tổng hợp",
  "c-hoa-giai-sat-khi.md": "Hóa giải sát khí",
  "h-81-cap-sao-va-hoa-giai.md": "81 cặp sao & hóa giải",
  "i-thu-son-xuat-sat-cua-chinh-duong-khi.md": "Thu Sơn Xuất Sát",
};

// Nhãn ngắn cho từng loại gợi ý hóa giải (khối admin).
const NHAN_LOAI_HOA_GIAI: Record<string, string> = {
  ngu_hoang: "Ngũ Hoàng",
  nhi_hac: "Nhị Hắc",
  sao_xau: "Sao xấu thất vận",
  thong_quan: "Thông quan",
  danh_cuc: "Danh cục hung",
};
---

<Container class="py-10">
  <div class="mx-auto max-w-4xl">
    <>
        <form method="GET" class="flex flex-col gap-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
          <div>
            <p class="text-sm font-semibold text-(--color-ink-900)">Nhóm A — bắt buộc</p>
            <p class="mt-0.5 text-xs text-(--color-ink-500)">Độ la bàn đo bằng la bàn thật (la kinh) hoặc ứng dụng la bàn điện thoại, đặt vuông góc với mặt tiền/mặt sau nhà.</p>
          </div>

          <div>
            <p class="text-sm font-medium text-(--color-ink-800)">Bạn đang nhập độ gì?</p>
            <div class="mt-2 flex gap-4 text-sm">
              <label class="flex items-center gap-1.5">
                <input type="radio" name="loaiDo" value="huong" checked={loaiDo === "huong"} /> Độ HƯỚNG (mặt tiền nhà nhìn ra)
              </label>
              <label class="flex items-center gap-1.5">
                <input type="radio" name="loaiDo" value="toa" checked={loaiDo === "toa"} /> Độ TỌA (lưng nhà tựa vào)
              </label>
            </div>
          </div>

          <div>
            <label for="hkpt-do" class="text-sm font-medium text-(--color-ink-800)">Số độ (0–360°)</label>
            <input
              type="number" id="hkpt-do" name="do" min="0" max="360" step="0.5" required
              value={doNhap ?? undefined}
              class="mt-1 w-full max-w-[10rem] rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm"
            />
          </div>

          <div>
            <label for="hkpt-nam" class="text-sm font-medium text-(--color-ink-800)">Năm nhập trạch (dọn vào ở)</label>
            <p class="mt-0.5 text-xs text-(--color-ink-500)">Nhà cũ dùng đúng năm bắt đầu ở, KHÔNG dùng năm hiện tại — Vận suy ra từ năm này quyết định toàn bộ tinh bàn.</p>
            <input
              type="number" id="hkpt-nam" name="nam" min="1900" max={new Date().getFullYear() + 1} required
              value={namNhapTrach ?? undefined}
              class="mt-1 w-full max-w-[10rem] rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm"
            />
          </div>

          <div class="border-t border-(--color-ivory-300) pt-5">
            <p class="text-sm font-semibold text-(--color-ink-900)">Nhóm B — loan đầu (không bắt buộc)</p>
            <p class="mt-0.5 text-xs text-(--color-ink-500)">
              Bỏ trống vẫn xem được tinh bàn, nhưng kết quả khi đó mới là khung lý khí — chưa đối chiếu thực địa. Điền càng đủ, phần hiển thị cạnh tinh bàn càng có ích.
            </p>
          </div>

          <div>
            <p class="text-sm font-medium text-(--color-ink-800)">Phía nào có núi / nhà cao / cây lớn? (chọn nhiều)</p>
            <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 sm:grid-cols-4">
              {HUONG_8.map((c) => (
                <label class="flex items-center gap-1.5 text-sm">
                  <input type="checkbox" name="nui" value={c} checked={nhomB.nui.includes(c)} /> {CUNG_INFO[c].ten}
                </label>
              ))}
            </div>
          </div>

          <div>
            <p class="text-sm font-medium text-(--color-ink-800)">Phía nào có sông hồ / đường lớn / khoảng đất trống? (chọn nhiều)</p>
            <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 sm:grid-cols-4">
              {HUONG_8.map((c) => (
                <label class="flex items-center gap-1.5 text-sm">
                  <input type="checkbox" name="nuoc" value={c} checked={nhomB.nuoc.includes(c)} /> {CUNG_INFO[c].ten}
                </label>
              ))}
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {([
              ["cuaChinh", "Cửa chính ở phía nào?", nhomB.cuaChinh],
              ["bep", "Bếp ở phía nào?", nhomB.bep],
              ["giuongNgu", "Giường ngủ chính ở phía nào?", nhomB.giuongNgu],
              ["banLamViec", "Bàn làm việc ở phía nào?", nhomB.banLamViec],
              ["cauThang", "Cầu thang ở phía nào? (nếu có)", nhomB.cauThang],
              ["gieng", "Giếng trời ở phía nào? (nếu có)", nhomB.gieng],
            ] as Array<[string, string, number | null]>).map(([name, nhan, val]) => (
              <div>
                <label for={`hkpt-${name}`} class="block text-xs font-medium text-(--color-ink-700)">{nhan}</label>
                <select id={`hkpt-${name}`} name={name} class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm">
                  <option value="">— Không rõ / bỏ qua —</option>
                  {HUONG_8.map((c) => <option value={c} selected={val === c}>{CUNG_INFO[c].ten}</option>)}
                </select>
              </div>
            ))}
          </div>

          <div>
            <p class="text-sm font-medium text-(--color-ink-800)">WC ở phía nào? (chọn nhiều, nếu nhà có nhiều WC)</p>
            <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 sm:grid-cols-4">
              {HUONG_8.map((c) => (
                <label class="flex items-center gap-1.5 text-sm">
                  <input type="checkbox" name="wc" value={c} checked={nhomB.wc.includes(c)} /> {CUNG_INFO[c].ten}
                </label>
              ))}
            </div>
          </div>

          <div>
            <label for="hkpt-soTang" class="text-sm font-medium text-(--color-ink-800)">Nhà mấy tầng?</label>
            <input
              type="number" id="hkpt-soTang" name="soTang" min="1" max="50"
              value={nhomB.soTang ?? undefined}
              class="mt-1 w-full max-w-[8rem] rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm"
            />
          </div>

          <Button type="submit" size="lg">Xem tinh bàn (miễn phí)</Button>
        </form>

        {loi && (
          <div class="mt-4 rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)">
            {loi}
          </div>
        )}

        {kq && van !== null && doHuong !== null && (
          <div class="mt-8 space-y-8">
            <section class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-base font-semibold text-(--color-ink-900)">
              <p>
                Tọa <strong>{kq.tinh_ban.son_toa}</strong> ({kq.tinh_ban.do_toa}°) — Hướng <strong>{kq.tinh_ban.son_huong}</strong> ({kq.tinh_ban.do_huong}°)
              </p>
              <p class="mt-1 text-sm font-medium text-(--color-ink-800)">
                Tinh bàn lập theo <strong>Vận {kq.van_nha}</strong> (năm nhập trạch {namNhapTrach}) · Xét vượng/suy theo <strong>Vận {kq.van_hien_tai}</strong> (đương lệnh, {new Date().getFullYear()})
              </p>
            </section>

            {kq.da_thoai_van && (
              <div class="rounded-(--radius-card) border-2 border-(--color-danger-500)/50 bg-(--color-danger-500)/10 p-4 text-base font-semibold text-(--color-danger-600)">
                ⚠️ Nhà đã sang vận mới (Vận {kq.van_nha} → Vận {kq.van_hien_tai}) — gọi là "THOÁI VẬN". Tinh bàn và các cách cục (Vượng Sơn Vượng Hướng…) vẫn giữ theo Vận {kq.van_nha} là kết cấu gốc của nhà, NHƯNG các sao vượng của Vận {kq.van_nha} nay đã thoái khí. Cột "vượng/suy" và phần Thu Sơn Xuất Sát bên dưới đã xét theo Vận {kq.van_hien_tai} hiện tại — đây mới là tình trạng THỰC của nhà lúc này.
              </div>
            )}

            {(["phan_loai_huong", "phan_loai_toa"] as const).map((key) => {
              const pl = kq!.tinh_ban[key];
              const nhan = key === "phan_loai_huong" ? "HƯỚNG" : "TỌA";
              return pl.muc !== "tot" ? (
                <div class:list={["rounded-(--radius-card) border-2 p-4 text-base font-semibold", MAU_MUC[pl.muc]]}>
                  <p class="font-extrabold">{nhan}: lệch {pl.lech > 0 ? "+" : ""}{pl.lech}° khỏi tâm sơn {pl.son} → {pl.loai}</p>
                  <p class="mt-1">{pl.mo_ta}</p>
                </div>
              ) : (
                <p class="text-base font-semibold text-emerald-700">✓ {nhan}: lệch {pl.lech > 0 ? "+" : ""}{pl.lech}° khỏi tâm sơn {pl.son} → {pl.loai} — {pl.mo_ta}</p>
              );
            })}

            <section>
              <h2 class="font-display text-2xl font-bold text-(--color-ink-950)">Tinh bàn</h2>
              <p class="mt-1 text-sm font-medium text-(--color-ink-700)">Mỗi ô: <strong>Sơn tinh — Vận tinh — Hướng tinh</strong>. Các dòng có 🏔️💧🚪... là loan đầu bạn đã khai ở Nhóm B.</p>
              <div class="mt-3 grid grid-cols-3 gap-1.5 overflow-hidden rounded-(--radius-card) border-2 border-(--color-ink-900)/20 bg-(--color-ink-900)/20">
                {LUOI_3X3.flat().map((c) => {
                  const s = kq!.tinh_ban.son_ban[c];
                  const v = kq!.tinh_ban.van_ban[c];
                  const h = kq!.tinh_ban.huong_ban[c];
                  const laToa = c === kq!.tinh_ban.cung_toa;
                  const laHuong = c === kq!.tinh_ban.cung_huong;
                  const gc = ghiChuLoanDau(c);
                  return (
                    <div class="min-h-[150px] bg-(--color-ivory-50) p-3">
                      <p class="text-base font-extrabold text-(--color-cinnabar-500)">
                        {CUNG_INFO[c].vt}
                        {laToa && <span class="ml-1.5 rounded-full bg-(--color-ink-900) px-2 py-0.5 text-xs font-bold text-white">TỌA</span>}
                        {laHuong && <span class="ml-1.5 rounded-full bg-(--color-gold-600) px-2 py-0.5 text-xs font-bold text-white">HƯỚNG</span>}
                      </p>
                      {c !== 5 ? (
                        <p class="mt-1.5 font-mono text-2xl font-extrabold tracking-tight text-(--color-ink-950)">{s} <span class="text-(--color-ink-600)">{v}</span> {h}</p>
