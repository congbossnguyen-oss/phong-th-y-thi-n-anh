---
// Than dich vu VIP tach dung chung cho web + in-app Quan Su (giu nguyen logic/giao dien).
import BottomNav from "../../components/quan-su/BottomNav.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import DateSelect from "../../components/ui/DateSelect.astro";
import MaKhuyenMai from "../../components/ui/MaKhuyenMai.astro";
import { siteConfig } from "../../lib/site-config";
import { dinhDangTien, GIA_CONG_CU } from "../../lib/payments/gia-cong-cu";

export const prerender = false;

const TOOL_SLUG = "ngay-khai-truong-cao-cap";
const TOOL_PRICE = GIA_CONG_CU["ngay-khai-truong-cao-cap"];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
const hotlineHref = `tel:${siteConfig.hotline.replace(/\s/g, "")}`;
const laQuanTri = Astro.locals.user?.isAdmin === true;
const namNay = new Date().getFullYear();
---

  <Container class="py-12">
    <div class="mx-auto max-w-3xl">
      {laQuanTri && (
        <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-gold-600)">
          🔧 Tài khoản quản trị — đơn 0đ tự xác nhận, đi trọn luồng thật để kiểm thử.
        </div>
      )}

      <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-ink-800)">
        ⭐ Dịch vụ VIP — phí <strong>{TOOL_PRICE_LABEL}/lượt</strong>. Nhập ngày sinh chủ để bật lớp
        <strong> Bát Tự mệnh chủ</strong> (Thập Thần cầu tài, không xung Tứ Trụ). Có <strong>giờ sinh</strong>
        thì tính thêm <strong>Dụng Thần theo vượng suy</strong>. Thanh toán qua QR, không cần tạo tài khoản.
      </div>

      <p class="mb-4 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3 text-xs text-(--color-ink-600)">
        ⚖️ <strong>Nhãn trung thực:</strong> phần nền chọn ngày khai trương là <em>phương pháp mở rộng</em>
        (khai trương không nằm trong danh mục mục đích nguyên văn của nguồn cổ). Phần <em>Bát Tự mệnh chủ</em>
        (Thê Tài cho cầu tài) có cơ sở nguyên văn — đây là giá trị cốt lõi của bản cao cấp.
      </p>

      <form id="ktcc-form" class="grid gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <p class="text-sm font-semibold text-(--color-ink-900)">Từ ngày <span class="text-(--color-danger-500)">*</span></p>
            <DateSelect idPrefix="ktcc-tu-ngay" />
          </div>
          <div>
            <p class="text-sm font-semibold text-(--color-ink-900)">Đến ngày <span class="text-(--color-danger-500)">*</span></p>
            <DateSelect idPrefix="ktcc-den-ngay" />
          </div>
        </div>
        <p class="text-xs text-(--color-ink-600)">Khoảng tìm tối đa 62 ngày/lượt.</p>

        <div class="border-t border-(--color-ivory-300) pt-4">
          <p class="text-sm font-semibold text-(--color-ink-900)">Ngày sinh dương lịch của chủ (đứng tên kinh doanh)</p>
          <p class="mt-0.5 text-xs text-(--color-ink-600)">Bỏ trống → chạy như bản thường. Nhập → bật lớp Bát Tự mệnh chủ.</p>
          <div class="mt-1.5 grid grid-cols-3 gap-3">
            <input id="ktcc-sinh-ngay" type="number" min="1" max="31" placeholder="Ngày"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600)" />
            <input id="ktcc-sinh-thang" type="number" min="1" max="12" placeholder="Tháng"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600)" />
            <input id="ktcc-sinh-nam" type="number" min="1900" max={namNay} placeholder="Năm"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600)" />
          </div>
          <div class="mt-3">
            <label for="ktcc-sinh-gio" class="text-sm font-medium text-(--color-ink-800)">Giờ sinh (0–23) — có thì tính thêm Dụng Thần</label>
            <input id="ktcc-sinh-gio" type="number" min="0" max="23" placeholder="Ví dụ: 10"
              class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600) sm:w-40" />
          </div>
        </div>

        <div class="border-t border-(--color-ivory-300) pt-4">
          <p class="text-sm font-medium text-(--color-ink-800)">Thông tin liên hệ (để nhận kết quả sau khi thanh toán)</p>
          <div class="mt-2 grid gap-3">
            <input id="ktcc-ten" type="text" placeholder="Họ tên" required
              class="w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600)" />
            <input id="ktcc-sdt" type="tel" placeholder="Số điện thoại" required
              class="w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600)" />
            <input id="ktcc-email" type="email" placeholder="Email (tùy chọn)"
              class="w-full rounded-(--radius-control) border border-(--color-ivory-400) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-900) placeholder:text-(--color-ink-600)" />
          </div>
        </div>

        <MaKhuyenMai idPrefix="ktcc-ma" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />

        <Button type="submit" size="lg"><span id="ktcc-nut">Thanh toán {TOOL_PRICE_LABEL} & Xem ngày</span></Button>
      </form>

      <div id="ktcc-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm font-semibold text-(--color-danger-500)"></div>

      <div id="ktcc-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-400) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
        <p class="font-display text-lg font-bold">Quét mã QR để thanh toán {TOOL_PRICE_LABEL}</p>
        <img id="ktcc-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
        <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="ktcc-order-code"></strong></p>
        <p id="ktcc-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
      </div>

      <div id="ktcc-ket-qua" class="mt-8 hidden"></div>

      <div class="mt-10 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-6 text-center">
        <p class="font-display text-lg font-bold text-(--color-ink-900)">Muốn chuyên gia luận kỹ và chốt ngày giờ?</p>
        <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={hotlineHref} class="flex w-full items-center justify-center gap-2 rounded-(--radius-pill) bg-(--color-gold-400) px-6 py-3 text-sm font-bold text-(--color-on-accent) hover:bg-(--color-gold-300) sm:w-auto">📞 Gọi hotline {siteConfig.hotline}</a>
          <a href="https://zalo.me/0836768768" class="flex w-full items-center justify-center gap-2 rounded-(--radius-pill) border border-(--color-gold-400) px-6 py-3 text-sm font-bold text-(--color-gold-300) hover:bg-(--color-ivory-200) sm:w-auto">💬 Chat Zalo với Thiên Anh</a>
        </div>
      </div>
    </div>
  </Container>
  <BottomNav />

<script>
  import { readDateSelects } from "../../lib/date-select";

  const form = document.getElementById("ktcc-form") as HTMLFormElement;
  const oLoi = document.getElementById("ktcc-loi")!;
  const oKetQua = document.getElementById("ktcc-ket-qua")!;
  const oThanhToan = document.getElementById("ktcc-thanh-toan")!;
  const qrImg = document.getElementById("ktcc-qr") as HTMLImageElement;
  const orderCodeEl = document.getElementById("ktcc-order-code")!;
  const trangThaiEl = document.getElementById("ktcc-trang-thai")!;

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const doc = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";

  function veKetQua(r: any): string {
    const dsNgay = r.ngayXepHang.length
      ? r.ngayXepHang.map((n: any, i: number) => {
          const top3 = i < 3;
          const d = `${String(n.solarDate.day).padStart(2, "0")}/${String(n.solarDate.month).padStart(2, "0")}/${n.solarDate.year}`;
          return `
        <li class="rounded-(--radius-control) p-3.5 ${top3 ? "border-2 border-(--color-gold-400) bg-(--color-gold-400)/12 shadow-md" : "border border-(--color-ivory-300)"}">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-display text-lg font-bold text-(--color-ink-900)">${top3 ? `#${i + 1} · ` : ""}${d} <span class="text-sm font-normal text-(--color-ink-600)">${esc(n.canChiNgay)}</span></span>
            <span class="font-display text-xl font-black text-(--color-gold-500)">${esc(n.diemTong)}<span class="text-sm text-(--color-ink-400)">/10</span></span>
          </div>
          <p class="mt-0.5 text-xs text-(--color-ink-600)">Nền ${esc(n.diemNen)}đ${n.thapThan ? ` · Bát Tự ${esc(n.diemBatTu)}đ (${esc(n.thapThan)})` : ""}</p>
          ${n.yeuTo?.length ? `<details class="mt-1.5"><summary class="cursor-pointer text-xs font-semibold text-(--color-gold-500)">Vì sao ngày này? ▾</summary><ul class="mt-1 list-disc pl-5 text-xs text-(--color-ink-700)">${n.yeuTo.map((y: string) => `<li>${esc(y)}</li>`).join("")}</ul></details>` : ""}
        </li>`;
        }).join("")
      : `<li class="rounded-(--radius-control) border border-(--color-ivory-300) p-4 text-sm text-(--color-ink-700)">Không có ngày phù hợp trong khoảng đã chọn — thử nới rộng khoảng ngày.</li>`;

    const nhatChu = r.nhatChu
      ? `<p class="mt-1 text-sm text-(--color-ink-700)">Mệnh chủ (Nhật Chủ): <strong class="text-(--color-gold-500)">${esc(r.nhatChu)}</strong>${r.vuongSuy ? ` — thân <strong>${esc(r.vuongSuy)}</strong> (đã áp Dụng Thần)` : " — chưa nhập giờ sinh nên chưa xét Dụng Thần"}.</p>`
      : `<p class="mt-1 text-sm italic text-(--color-ink-500)">Chế độ bản thường (chưa nhập ngày sinh chủ) — chưa có lớp Bát Tự mệnh chủ.</p>`;

    const thieu = r.thieuDuLieu?.length
      ? `<div class="mt-4 rounded-(--radius-card) border border-(--color-gold-400)/50 bg-(--color-gold-400)/10 p-3 text-xs text-(--color-gold-600)"><strong>Lưu ý (minh bạch):</strong><ul class="mt-1 list-disc pl-5">${r.thieuDuLieu.map((c: string) => `<li>${esc(c)}</li>`).join("")}</ul></div>`
      : "";

    return `
      <section class="rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-5">
        <h2 class="font-display text-lg font-bold text-(--color-ink-900)">Kết quả — ${r.cheDo === "cao-cap" ? "bản cao cấp (nền + Bát Tự mệnh chủ)" : "bản thường"}</h2>
        ${nhatChu}
      </section>
      <section class="mt-5 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-5">
        <p class="text-sm text-(--color-ink-600)">Xếp theo điểm tổng (nền 65% + hợp mệnh 35%). 3 ngày đầu là tốt nhất.</p>
        <ul class="mt-4 space-y-2.5">${dsNgay}</ul>
        ${thieu}
      </section>`;
  }

  let pollTimer: ReturnType<typeof setInterval> | null = null;
  function stopPolling() { if (pollTimer) clearInterval(pollTimer); pollTimer = null; }

  async function pollResult(orderCode: string) {
    try {
      const res = await fetch(`/api/dai-cat-loi/ngay-khai-truong-cao-cap/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!res.ok || !data.ok) return;
      if (data.status === "confirmed") {
        stopPolling();
        trangThaiEl.textContent = "Đã thanh toán — kết quả hiển thị bên dưới.";
        oThanhToan.classList.add("hidden");
        form.classList.add("hidden");
        oKetQua.innerHTML = veKetQua(data.result);
        oKetQua.classList.remove("hidden");
        oKetQua.scrollIntoView({ behavior: "smooth", block: "start" });
      } else if (data.status === "cancelled") {
        stopPolling();
        trangThaiEl.textContent = "Đơn hàng đã bị hủy. Vui lòng thử lại.";
      }
    } catch { /* chờ nhịp sau */ }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    oLoi.classList.add("hidden");
    oThanhToan.classList.add("hidden");
    oKetQua.classList.add("hidden");
    stopPolling();

    const tu = readDateSelects("ktcc-tu-ngay");
    const den = readDateSelects("ktcc-den-ngay");
    if (!tu || !den) { oLoi.textContent = "Vui lòng chọn đầy đủ Từ ngày và Đến ngày."; oLoi.classList.remove("hidden"); return; }

    const sn = doc("ktcc-sinh-ngay"), st = doc("ktcc-sinh-thang"), sy = doc("ktcc-sinh-nam");
    const chuNgaySinh = sn && st && sy ? { year: Number(sy), month: Number(st), day: Number(sn) } : undefined;
    const gio = doc("ktcc-sinh-gio");
    const maKhuyenMai = (document.getElementById("ktcc-ma-input") as HTMLInputElement | null)?.value.trim() ?? "";

    const payload = {
      tuNgay: { year: tu.year, month: tu.month, day: tu.day },
      denNgay: { year: den.year, month: den.month, day: den.day },
      ...(chuNgaySinh ? { chuNgaySinh } : {}),
      ...(chuNgaySinh && gio ? { chuGioSinh: Number(gio) } : {}),
      customerName: doc("ktcc-ten"),
      customerPhone: doc("ktcc-sdt"),
      customerEmail: doc("ktcc-email"),
      ...(maKhuyenMai ? { maKhuyenMai } : {}),
    };

    try {
      const res = await fetch("/api/dai-cat-loi/ngay-khai-truong-cao-cap/checkout", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) { oLoi.textContent = data.error || "Không tạo được đơn hàng."; oLoi.classList.remove("hidden"); return; }

      if (data.mienPhi) { orderCodeEl.textContent = data.orderCode; await pollResult(data.orderCode); return; }
      qrImg.src = data.qrUrl;
      orderCodeEl.textContent = data.orderCode;
      trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      oThanhToan.classList.remove("hidden");
      oThanhToan.scrollIntoView({ behavior: "smooth", block: "start" });
      pollTimer = setInterval(() => pollResult(data.orderCode), 3000);
    } catch {
      oLoi.textContent = "Không kết nối được máy chủ. Vui lòng thử lại."; oLoi.classList.remove("hidden");
    }
  });
</script>
