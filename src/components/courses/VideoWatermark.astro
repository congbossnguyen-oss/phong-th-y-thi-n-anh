---
// Watermark chống quay màn hình chia sẻ: hiện tên + email học viên đang xem.
// Cứ mỗi 10 phút, watermark "chạy" (đổi vị trí liên tục) trong vòng 1 phút rồi đứng yên
// đến chu kỳ 10 phút tiếp theo — không di chuyển liên tục suốt buổi học để tránh gây rối mắt.
// Đặt component này bên trong container video có `position: relative; overflow: hidden`.
---

<div
  id="video-watermark"
  class="pointer-events-none absolute z-10 whitespace-nowrap text-xs font-medium tracking-wide text-white/35 transition-[left,top] duration-700 ease-in-out"
  aria-hidden="true"
>
</div>

<script>
  import { getCurrentUser } from "../../lib/lms/lms-client";

  const CYCLE_INTERVAL_MS = 10 * 60 * 1000; // cứ 10 phút bắt đầu 1 chu kỳ chuyển động
  const MOVE_PHASE_DURATION_MS = 60 * 1000; // chuyển động trong vòng 1 phút mỗi chu kỳ
  const MOVE_STEP_MS = 4000; // trong 1 phút đó, cứ 4 giây đổi vị trí 1 lần

  function initWatermark() {
    const el = document.getElementById("video-watermark");
    const container = el?.parentElement;
    if (!el || !container) return;

    // TODO: khi chuyển sang session thật (Astro.locals.user), truyền name/email qua data-attribute
    // từ server thay vì đọc lại từ lms-client demo ở đây.
    const user = getCurrentUser();
    if (!user) return;

    el.textContent = `${user.name} · ${user.email}`;

    function reposition() {
      const containerRect = container!.getBoundingClientRect();
      const elRect = el!.getBoundingClientRect();
      const maxX = Math.max(containerRect.width - elRect.width - 12, 12);
      const maxY = Math.max(containerRect.height - elRect.height - 12, 12);
      const x = Math.round(Math.random() * maxX);
      const y = Math.round(Math.random() * maxY);
      el!.style.left = `${x}px`;
      el!.style.top = `${y}px`;
    }

    function runMovementPhase() {
      reposition();
      const stepTimer = window.setInterval(reposition, MOVE_STEP_MS);
      window.setTimeout(() => window.clearInterval(stepTimer), MOVE_PHASE_DURATION_MS);
    }

    runMovementPhase(); // chạy ngay 1 chu kỳ khi vào bài học
    setInterval(runMovementPhase, CYCLE_INTERVAL_MS);
  }

  document.addEventListener("DOMContentLoaded", initWatermark);
</script>
