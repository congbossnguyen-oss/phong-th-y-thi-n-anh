---
/**
 * TAB TỬ VI — trình bày theo `quy-trinh-chon-gio-sinh-mo-tu-vi.md` (8 bước), nay có ĐỒ HÌNH đầy đủ
 * (anh Công 22/8/2026: "thiếu đồ hình, biểu đồ sóng… nhìn cảm giác rẻ tiền"):
 *   1. Lá số 12 cung trực quan (LaSoTuVi)
 *   2. Luận từng cung quan trọng: Mệnh, Tài, Quan, Di, Tật Ách, Phụ Mẫu, Phúc Đức, Phu Thê, Tử Tức
 *   3. Biểu đồ sóng vận trình Đại Hạn
 *   4. KẾT LUẬN tổng
 */
import type { BirthCandidate } from "../../lib/trach-nhat-sinh-no/types";
import LaSoTuVi from "./LaSoTuVi.astro";
import BieuDoSongVan from "./BieuDoSongVan.astro";
import { tomTatDaiHanTuVi, tomTatLaSoTuVi } from "../../lib/trach-nhat-sinh-no/tom-tat";

interface Props { candidate: BirthCandidate | null | undefined; ngayDuongLich: string; khungGio: string; tuTru: string }
const { candidate, ngayDuongLich, khungGio, tuTru } = Astro.props;
const tv = candidate?.tuViAnalysis ?? null;

const CUONG_NHAN: Record<string, string> = { cuong: "Cường", trung_binh: "Trung bình", nhuoc: "Nhược" };
const CUONG_MAU: Record<string, string> = { cuong: "#166534", trung_binh: "#B8860B", nhuoc: "#CF2A22" };
const THAN_CU_DANH_GIA: Record<string, { nhan: string; mau: string }> = {
  "Mệnh": { nhan: "✅ Tự chủ", mau: "#166534" },
  "Quan Lộc": { nhan: "✅ Sự nghiệp rõ", mau: "#166534" },
  "Phúc Đức": { nhan: "✅ Hưởng phúc ấm", mau: "#166534" },
  "Tài Bạch": { nhan: "⚠️ Đời gắn với tiền", mau: "#B8860B" },
  "Thiên Di": { nhan: "⚠️ Xa nhà, do ngoại cảnh", mau: "#D97706" },
  "Phu Thê": { nhan: "⚠️ Lệ thuộc hôn nhân", mau: "#CF2A22" },
};
const DG_STYLE: Record<string, { nen: string; vien: string; chu: string; nhan: string }> = {
  cat: { nen: "#F0FDF4", vien: "#86EFAC", chu: "#166534", nhan: "Cát" },
  binh: { nen: "#F8FAFC", vien: "#E2E8F0", chu: "#475569", nhan: "Bình" },
  hung: { nen: "#FEF2F2", vien: "#FCA5A5", chu: "#B91C1C", nhan: "Cần lưu ý" },
};

const diemsDaiHan = (tv?.daiHan ?? []).map((h) => ({
  tuTuoi: h.tuTuoi, denTuoi: h.denTuoi, diem: h.diem,
  nhan: h.cungName,
  ghiChu: h.bietTuanTriet ? "Tuần/Triệt" : h.soSatTinhTuTap > 0 ? `${h.soSatTinhTuTap} sát tinh` : undefined,
}));
---

{!tv ? (
  <p class="rounded-xl bg-slate-100 p-4 text-center text-sm font-semibold text-slate-600">Chưa có dữ liệu Tử Vi cho phương án này.</p>
) : (
  <div class="space-y-5">
    {/* 1. LÁ SỐ 12 CUNG */}
    <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
      <div class="bg-gradient-to-r from-[#1D5FB0] to-[#173F73] px-5 py-3">
        <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-white">⭐ Lá số Tử Vi 12 cung — vai trò: chọn GIỜ trong ngày</h3>
      </div>
      <div class="p-4 sm:p-5">
        <p class="mb-3 text-[11px] font-semibold italic text-slate-500">{tomTatLaSoTuVi(tv)}</p>
        <LaSoTuVi cungs={tv.cungs} luanCacCung={tv.luanCacCung} cuc={tv.cuc} tuoiKhoiHan={tv.tuoiKhoiHan} ngayDuongLich={ngayDuongLich} khungGio={khungGio} tuTru={tuTru} />

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="rounded-full px-3 py-1 text-xs font-extrabold text-white" style={`background:${THAN_CU_DANH_GIA[tv.than_cu]?.mau ?? "#6B7280"}`}>
            Thân cư {tv.than_cu} · {THAN_CU_DANH_GIA[tv.than_cu]?.nhan ?? ""}
          </span>
          <span class="rounded-full px-3 py-1 text-xs font-extrabold text-white" style={`background:${CUONG_MAU[tv.cuongNhuocMenh]}`}>Mệnh {CUONG_NHAN[tv.cuongNhuocMenh]}</span>
          <span class="rounded-full px-3 py-1 text-xs font-extrabold text-white" style={`background:${CUONG_MAU[tv.cuongNhuocThan]}`}>Thân {CUONG_NHAN[tv.cuongNhuocThan]}</span>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">Tam Phương Tứ Chính: {tv.tamPhuongTuChinh.soCatTinh} cát / {tv.tamPhuongTuChinh.soSatTinh} sát</span>
        </div>
        {tv.cuongNhuocMenh === "cuong" && tv.cuongNhuocThan === "cuong" && (
          <p class="mt-2 rounded-lg bg-emerald-50 px-3 py-2 text-[11px] font-extrabold text-emerald-800">✦ Mệnh cường Thân cường — tổ hợp tốt nhất ("xứng ý toại lòng, cuộc đời cát lợi").</p>
        )}
        {tv.veto.menhVoChinhDieu && tv.veto.menhBiTuanTriet && (
          <p class="mt-2 rounded-lg bg-sky-50 px-3 py-2 text-[11px] font-semibold text-sky-900">
            ℹ️ Mệnh Vô Chính Diệu <strong>có</strong> Tuần/Triệt — theo quy trình Tử Vi 8 bước đây KHÔNG phải lỗi: Tuần/Triệt tại đó lại cần để giữ cách VCD thuần.
          </p>
        )}
      </div>
    </div>

    {/* 2. LUẬN TỪNG CUNG */}
    <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
      <div class="bg-gradient-to-r from-[#1D5FB0] to-[#173F73] px-5 py-3">
        <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-white">Luận từng cung</h3>
      </div>
      <div class="grid gap-2.5 p-4 sm:grid-cols-2 sm:p-5">
        {tv.luanCacCung.map((l) => {
          const st = DG_STYLE[l.danhGia]!;
          return (
            <div class="rounded-xl border-2 p-3" style={`background:${st.nen};border-color:${st.vien}`}>
              <div class="flex items-center justify-between gap-2">
                <p class="font-display text-sm font-black text-slate-900">{l.cungName} <span class="text-[11px] font-bold text-slate-500">({l.chiName})</span></p>
                <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-extrabold" style={`background:${st.vien};color:${st.chu}`}>{st.nhan}</span>
              </div>
              <p class="mt-0.5 text-[11px] font-bold" style={`color:${st.chu}`}>{l.chinhTinh}</p>
              <p class="mt-1 text-[11px] font-semibold leading-relaxed text-slate-700">{l.nhanXet}</p>
            </div>
          );
        })}
      </div>
    </div>

    {/* 3. BIỂU ĐỒ SÓNG VẬN TRÌNH */}
    {diemsDaiHan.length > 0 && (
      <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
        <div class="bg-gradient-to-r from-[#1D5FB0] to-[#173F73] px-5 py-3">
          <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-white">Vận trình Đại Hạn Tử Vi</h3>
        </div>
        <div class="p-4 sm:p-5">
          <BieuDoSongVan tieuDe="Mức thuận nghịch theo từng Đại Hạn" tomTat={tomTatDaiHanTuVi(tv.daiHan)} diems={diemsDaiHan} mau="#1D5FB0" />
          <div class="mt-3 space-y-1.5">
            {tv.daiHan.map((h, i) => (
              <p class={`rounded-lg px-3 py-2 text-[11px] font-semibold ${i < 2 ? "bg-amber-50 text-amber-900" : "bg-slate-50 text-slate-700"}`}>
                <strong>{h.tuTuoi}–{h.denTuoi} tuổi{i < 2 ? " ★" : ""}:</strong> {h.nhanXet}
              </p>
            ))}
          </div>
          <p class="mt-2 text-[10px] font-semibold text-slate-500">★ = 2 Đại Hạn đầu đời (~0–30 tuổi) — trọng số cao nhất khi chọn giờ, vì bé đi qua giai đoạn này trước khi tự chủ.</p>
        </div>
      </div>
    )}

    {/* 4. KẾT LUẬN */}
    {tv.ketLuan.length > 0 && (
      <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/60 bg-gradient-to-br from-[#241a10] to-[#3a2c17] shadow-xl">
        <div class="px-5 py-3">
          <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-gold-300)">Kết luận phần Tử Vi</h3>
        </div>
        <div class="space-y-2 px-5 pb-5">
          {tv.ketLuan.map((k) => (<p class="text-sm font-semibold leading-relaxed text-white/90">• {k}</p>))}
        </div>
      </div>
    )}
  </div>
)}
