---
/**
 * TAB TỔNG QUAN — hàng thẻ số liệu + đồng hồ mức phù hợp + phễu lọc, dựng theo 3 mẫu dashboard anh
 * Công gửi 22/8/2026. Mục đích: khách vừa mở kết quả là nắm ngay "xét bao nhiêu ca, loại bao nhiêu,
 * còn mấy phương án, điểm bao nhiêu" mà không phải đọc hết trang.
 *
 * Màu cố định (không dùng token đổi theo theme) — thẻ nền trắng, đúng bài học chữ mờ ở module Nghề Nghiệp.
 */
import type { FinalBirthRecommendation } from "../../lib/trach-nhat-sinh-no/types";

interface Props { r: FinalBirthRecommendation }
const { r } = Astro.props;

const diem = r.primary?.diem ?? null;
const tong = diem?.tong ?? 0;

// --- Đồng hồ nửa vòng: tâm (130,128), bán kính 110, giá trị 0-100 trải trên 180° -------------------
const CX = 130, CY = 128, R = 110;
const toaDo = (v: number) => {
  const goc = ((180 - v * 1.8) * Math.PI) / 180;
  return { x: CX + R * Math.cos(goc), y: CY - R * Math.sin(goc) };
};
const cungTron = (tu: number, den: number) => {
  const a = toaDo(tu), b = toaDo(den);
  return `M${a.x.toFixed(1)},${a.y.toFixed(1)} A${R},${R} 0 0 1 ${b.x.toFixed(1)},${b.y.toFixed(1)}`;
};
const VUNG = [
  { tu: 0, den: 39, mau: "#CF2A22", nhan: "Nên cân nhắc thêm" },
  { tu: 41, den: 59, mau: "#E0A100", nhan: "Tạm được" },
  { tu: 61, den: 79, mau: "#3FA96A", nhan: "Tốt" },
  { tu: 81, den: 100, mau: "#166534", nhan: "Rất tốt" },
];
const gocKim = tong * 1.8 - 90;

// --- Phễu lọc -------------------------------------------------------------------------------------
const phezu = r.phezuLoc ?? [];
const phezuMax = Math.max(1, ...phezu.map((b) => b.conLai));
const buocRungNhieuNhat = phezu.length > 0 ? [...phezu].sort((a, b) => b.loai - a.loai)[0]! : null;
const tomTatPhezu = buocRungNhieuNhat && buocRungNhieuNhat.loai > 0
  ? `Nhiều ca rụng nhất ở bước "${buocRungNhieuNhat.ten}" — loại ${buocRungNhieuNhat.loai} ca.`
  : "Không ca nào bị loại trong khung dự sinh này.";

const tyLeLoai = r.soUngVienSinhRa > 0
  ? Math.round(((r.soUngVienSinhRa - r.soUngVienConLaiSauLoc) / r.soUngVienSinhRa) * 1000) / 10
  : 0;
const soDuPhong = r.alternatives.length;
const chenhVoiKe = r.primary && r.alternatives[0]
  ? Math.round(r.primary.diem.tong - r.alternatives[0].diem.tong)
  : null;

const TRANG_THAI_NHAN: Record<string, { chu: string; mau: string }> = {
  strong_recommendation: { chu: "Có phương án nổi trội rõ", mau: "#166534" },
  recommendation: { chu: "Có phương án phù hợp", mau: "#1E8A45" },
  limited_options: { chu: "Lựa chọn hạn chế", mau: "#B45309" },
  no_good_option: { chu: "Không có phương án nổi trội", mau: "#B91C1C" },
};
const tt = TRANG_THAI_NHAN[r.selectionStatus] ?? { chu: "Có phương án phù hợp", mau: "#1E8A45" };
---

<div class="space-y-4">

  {/* 1. HÀNG THẺ SỐ LIỆU */}
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="rounded-xl border border-t-[3px] border-slate-200 border-t-[#B8860B] bg-white p-4 shadow-sm">
      <p class="text-[10px] font-extrabold uppercase tracking-wide text-slate-400">Ứng viên đã xét</p>
      <p class="mt-1 font-display text-3xl font-black leading-none text-slate-900">{r.soUngVienSinhRa}</p>
      <p class="mt-1 text-[11px] font-bold text-slate-500">mỗi ngày × 12 khung giờ</p>
    </div>
    <div class="rounded-xl border border-t-[3px] border-slate-200 border-t-[#B8860B] bg-white p-4 shadow-sm">
      <p class="text-[10px] font-extrabold uppercase tracking-wide text-slate-400">Bị loại</p>
      <p class="mt-1 font-display text-3xl font-black leading-none text-slate-900">{r.soUngVienSinhRa - r.soUngVienConLaiSauLoc}</p>
      <p class="mt-1 text-[11px] font-bold text-[#B91C1C]">▼ {tyLeLoai}% không đạt tiêu chí</p>
    </div>
    <div class="rounded-xl border border-t-[3px] border-slate-200 border-t-[#B8860B] bg-white p-4 shadow-sm">
      <p class="text-[10px] font-extrabold uppercase tracking-wide text-slate-400">Vào chung kết</p>
      <p class="mt-1 font-display text-3xl font-black leading-none text-slate-900">{r.soUngVienConLaiSauLoc}</p>
      <p class="mt-1 text-[11px] font-bold text-[#166534]">▲ trình bày {soDuPhong + 1} phương án tốt nhất</p>
    </div>
    <div class="rounded-xl border border-t-[3px] border-slate-200 border-t-[#B8860B] bg-white p-4 shadow-sm">
      <p class="text-[10px] font-extrabold uppercase tracking-wide text-slate-400">Điểm phương án chính</p>
      <p class="mt-1 font-display text-3xl font-black leading-none text-slate-900">{tong}<span class="text-base font-bold text-slate-400">/100</span></p>
      <p class="mt-1 text-[11px] font-bold" style={`color:${chenhVoiKe !== null && chenhVoiKe > 0 ? "#166534" : "#64748B"}`}>
        {chenhVoiKe !== null && chenhVoiKe > 0 ? `▲ hơn phương án kế ${chenhVoiKe} điểm` : "chưa có phương án khác để so"}
      </p>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">

    {/* 2. ĐỒNG HỒ MỨC PHÙ HỢP */}
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="font-display text-sm font-black text-slate-900">Mức phù hợp tổng thể</p>
      <p class="mt-0.5 text-[11px] font-semibold italic text-slate-500">
        {diem
          ? `Đạt ${tong}/100 — mức "${diem.mucNhan}" (Bát Tự ${diem.batTu}/50 · Tử Vi ${diem.tuVi}/50).`
          : "Chưa có phương án nào để chấm điểm."}
      </p>
      <svg viewBox="0 0 260 152" class="mx-auto mt-1 block w-full max-w-[290px]" role="img" aria-label={`Đồng hồ đo mức phù hợp ${tong} trên 100`}>
        {VUNG.map((v) => (
          <path d={cungTron(v.tu, v.den)} fill="none" stroke={v.mau} stroke-width="18" stroke-linecap="round" />
        ))}
        <g transform={`rotate(${gocKim.toFixed(1)} ${CX} ${CY})`}>
          <path d={`M${CX} ${CY} L${CX - 3} ${CY - 84} L${CX + 3} ${CY - 84} Z`} fill="#0F172A" />
        </g>
        <circle cx={CX} cy={CY} r="9" fill="#0F172A" /><circle cx={CX} cy={CY} r="4" fill="#fff" />
        <text x={CX} y={CY - 16} text-anchor="middle" font-size="34" font-weight="900" fill="#0F172A">{tong}</text>
        <text x="14" y="148" font-size="9.5" font-weight="800" fill="#94A3B8">0</text>
        <text x="242" y="148" font-size="9.5" font-weight="800" fill="#94A3B8">100</text>
      </svg>
      <div class="mt-1 flex flex-wrap justify-center gap-x-3 gap-y-1 text-[10px] font-bold text-slate-600">
        {VUNG.map((v) => (
          <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm" style={`background:${v.mau}`}></span>{v.nhan}</span>
        ))}
      </div>
      <p class="mt-2 rounded-lg bg-slate-50 px-3 py-2 text-[10px] font-semibold leading-relaxed text-slate-500">
        Điểm này chỉ để <strong>dễ so sánh bằng mắt</strong>. Việc xếp hạng thật vẫn chạy trên hai hệ riêng biệt — Bát Tự xếp hạng NGÀY, Tử Vi chọn GIỜ — không cộng điểm chéo.
      </p>
    </div>

    {/* 3. PHỄU LỌC */}
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="font-display text-sm font-black text-slate-900">{r.soUngVienSinhRa} ứng viên lọc còn {r.soUngVienConLaiSauLoc} như thế nào</p>
      <p class="mt-0.5 text-[11px] font-semibold italic text-slate-500">{tomTatPhezu}</p>
      <div class="mt-3 space-y-2">
        {phezu.map((b, i) => (
          <div>
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-[11px] font-extrabold text-slate-700">{i + 1}. {b.ten}</p>
              <p class="shrink-0 text-[10px] font-bold" style={`color:${b.loai > 0 ? "#B91C1C" : "#94A3B8"}`}>
                {b.loai > 0 ? `− ${b.loai} ca` : "không loại ca nào"}
              </p>
            </div>
            <div class="mt-1 h-5 overflow-hidden rounded bg-slate-100">
              <div
                class="flex h-full items-center rounded pl-2"
                style={`width:${Math.max(6, Math.round((b.conLai / phezuMax) * 100))}%;background:${i === phezu.length - 1 ? "#166534" : i === 0 ? "#B8860B" : "#C79A2E"}`}
              >
                <span class="text-[10px] font-black text-white">{b.conLai}</span>
              </div>
            </div>
            <p class="mt-0.5 text-[10px] font-semibold text-slate-500">{b.giaiThich}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* 4. LÝ DO LOẠI HÀNG ĐẦU */}
  {r.lyDoLoaiHangDau.length > 0 && (
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="font-display text-sm font-black text-slate-900">Các ca bị loại vì lý do gì</p>
      <p class="mt-0.5 text-[11px] font-semibold italic text-slate-500">
        Lý do phổ biến nhất: {r.lyDoLoaiHangDau[0]!.nhan.toLowerCase()} ({r.lyDoLoaiHangDau[0]!.so} lượt).
      </p>
      <div class="mt-3 space-y-1.5">
        {r.lyDoLoaiHangDau.map((l) => (
          <div class="flex items-center gap-2">
            <p class="w-[46%] shrink-0 text-[11px] font-bold text-slate-700">{l.nhan}</p>
            <div class="h-4 flex-1 overflow-hidden rounded bg-slate-100">
              <div class="h-full rounded bg-[#CF2A22]/70" style={`width:${Math.round((l.so / r.lyDoLoaiHangDau[0]!.so) * 100)}%`}></div>
            </div>
            <p class="w-9 shrink-0 text-right text-[11px] font-black text-slate-900">{l.so}</p>
          </div>
        ))}
      </div>
      <p class="mt-2 text-[10px] font-semibold text-slate-500">Một ca có thể chạm nhiều lý do cùng lúc, nên tổng số lượt lớn hơn số ca bị loại.</p>
    </div>
  )}

  {/* 5. TRẠNG THÁI KẾT LUẬN */}
  <div class="rounded-xl border-2 p-4" style={`border-color:${tt.mau}55;background:${tt.mau}0D`}>
    <p class="text-sm font-black" style={`color:${tt.mau}`}>Kết luận: {tt.chu}</p>
    <p class="mt-1 text-[12px] font-semibold text-slate-700">{r.medicalConstraintSummary}</p>
  </div>

</div>
