---
/**
 * 4 mặt của lá số — Sức khỏe · Gia đạo · Tài vận · Nhân duyên, mỗi mặt chấm RIÊNG.
 *
 * Vì sao không gộp thành 1 điểm: `luan-giai-bat-tu-manh-phai/SKILL.md` (Bước 6 & 10) nêu rõ kết luận
 * phú quý CHỈ nói về tiền bạc/sự nghiệp, không được suy ra sức khỏe hay gia đình — nên 4 mặt phải
 * đứng riêng, và một lá mạnh mặt này hoàn toàn có thể yếu mặt kia.
 */
import type { DiemLinhVuc } from "../../lib/trach-nhat-sinh-no/types";

interface Props {
  danhSach: DiemLinhVuc[];
  /** Nhãn ưu tiên gia đình đã chọn, để nói rõ thứ tự xếp hạng dựa trên gì. */
  nhanUuTien?: string;
}
const { danhSach, nhanUuTien } = Astro.props;

const ICON: Record<string, string> = {
  suc_khoe: "💪", gia_dao: "🏠", tai_van: "💰", nhan_duyen: "💞",
};
/** Quy -10..10 về 0-100% để vẽ thanh. */
const phanTram = (d: number) => Math.round(((Math.max(-10, Math.min(10, d)) + 10) / 20) * 100);
const mauTheo = (dg: string) =>
  dg === "tot" ? "#16803d" : dg === "kha" ? "#5a9367" : dg === "trung_binh" ? "#a08a5b" : "#b91c1c";
const nhanTheo = (dg: string) =>
  dg === "tot" ? "Thuận rõ" : dg === "kha" ? "Khá thuận" : dg === "trung_binh" ? "Trung bình" : "Cần lưu ý";
---

{danhSach.length > 0 && (
  <div class="mt-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-5">
    <h4 class="font-display text-lg font-bold text-(--color-ink-950)">Bốn mặt của lá số</h4>
    <p class="mt-1 text-xs text-(--color-ink-600)">
      Mỗi mặt được chấm <strong>riêng biệt</strong> từ chính lá số này, không suy ra từ một điểm tổng —
      vì một lá số mạnh về tiền bạc hoàn toàn có thể yếu về gia đạo hay sức khỏe.
      {nhanUuTien && <> Danh sách xếp theo mặt mạnh nhất trước; thứ hạng phương án đã tính theo ưu tiên <strong>{nhanUuTien}</strong> mà gia đình chọn.</>}
    </p>

    <div class="mt-4 space-y-4">
      {danhSach.map((lv) => (
        <div class="rounded-(--radius-control) border border-(--color-ivory-300) bg-white p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-bold text-(--color-ink-900)">{ICON[lv.linhVuc] ?? "•"} {lv.nhan}</p>
            <span class="rounded-full px-3 py-1 text-xs font-bold text-white" style={`background-color:${mauTheo(lv.danhGia)}`}>
              {nhanTheo(lv.danhGia)}
            </span>
          </div>

          <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-(--color-ivory-200)">
            <div class="h-full rounded-full" style={`width:${phanTram(lv.diem)}%;background-color:${mauTheo(lv.danhGia)}`}></div>
          </div>
          <p class="mt-1 text-[11px] text-(--color-ink-500)">
            Bát Tự {lv.diemBatTu > 0 ? "+" : ""}{lv.diemBatTu} · Tử Vi {lv.diemTuVi > 0 ? "+" : ""}{lv.diemTuVi}
            <span class="ml-1 italic">(hai hệ xét độc lập — nếu lệch nhau thì nên tham khảo thêm chuyên gia)</span>
          </p>

          <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">{lv.nhanXet}</p>

          {lv.canCu.length > 0 && (
            <details class="mt-2">
              <summary class="cursor-pointer text-xs font-semibold text-(--color-gold-700)">Xem căn cứ ({lv.canCu.length})</summary>
              <ul class="mt-2 space-y-1.5">
                {lv.canCu.map((c) => (
                  <li class="text-xs leading-relaxed text-(--color-ink-700)">
                    <span class={c.thuanLoi ? "font-bold text-(--color-success-500)" : "font-bold text-(--color-danger-500)"}>
                      {c.thuanLoi ? "✓" : "✗"}
                    </span>{" "}
                    {c.noiDung}
                    <span class="ml-1 text-(--color-ink-400)">— {c.nguon}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      ))}
    </div>

    <p class="mt-4 text-[11px] leading-relaxed text-(--color-ink-500)">
      Thang điểm dùng để <strong>so sánh các phương án với nhau</strong>, không phải lời tiên đoán chắc chắn.
      Nhãn được đặt theo mức tương đối: “Thuận rõ” là nhóm khoảng 20% tốt nhất, “Cần lưu ý” là khoảng 20%
      kém nhất — trong số những lá số <em>đã vượt qua vòng lọc</em>, nên “Cần lưu ý” không có nghĩa là lá xấu.
      Mốc trung bình đã được chuẩn hoá trên hơn một nghìn phương án để không bị lệch về phía chê hay khen.
      Lưu ý: đây là chuẩn hoá <strong>thang đo</strong>; mức độ nặng nhẹ giữa các quy tắc vẫn là quy ước của
      công cụ, vì tài liệu Bát Tự/Tử Vi phân loại tốt–xấu theo định tính chứ không cho thang điểm số.
    </p>
  </div>
)}
