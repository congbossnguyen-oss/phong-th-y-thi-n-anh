---
// Thanh điều hướng 5 tab cố định dưới cùng — khung "app Quân Sư" (Thầy chốt phương án B, 2026-08-23:
// dựng khung app đầy đủ theo 4 ảnh tham khảo, không chỉ chỉnh giao diện từng trang riêng lẻ).
//
// "Quân Sư" là tab giữa, nổi cao hơn 4 tab còn lại (icon Âm Dương, hình tròn nền vàng) — đúng bố cục
// ảnh mẫu. Bấm "Trạch Cát" / "Cá nhân" thì RỜI khỏi khung app, sang trang thường của site (site đó
// không có thanh này) — phạm vi B lần này chỉ dựng khung cho các trang Quân Sư, không sửa lại toàn
// bộ Đại Cát Lợi/khu học viên vốn đã hoạt động tốt.
const path = Astro.url.pathname;
// Tab giữa (mỏ neo #hoi) luôn nổi bật riêng bằng CSS, không cần trạng thái active theo đường dẫn.
const isActive = (p: string) => !p.includes("#") && (path === p || (p !== "/quan-su" && path.startsWith(p)));

const TABS = [
  { href: "/quan-su", label: "Trang chủ", icon: "home" },
  { href: "/dai-cat-loi", label: "Trạch Cát", icon: "calendar" },
  { href: "/quan-su#hoi", label: "Quân Sư", icon: "yin-yang", center: true },
  { href: "/quan-su/xem-thoi-van", label: "Thời vận", icon: "trend" },
  { href: "/hoc-vien", label: "Cá nhân", icon: "user" },
] as const;
---

<nav class="qsn-bar" aria-label="Điều hướng Quân Sư">
  {TABS.map((t) => (
    <a href={t.href} class={`qsn-tab ${t.center ? "qsn-center" : ""} ${isActive(t.href) ? "active" : ""}`}>
      <span class="qsn-ic">
        {t.icon === "home" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11.5 12 4l9 7.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10v9a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
        )}
        {t.icon === "calendar" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4" stroke-linecap="round"/></svg>
        )}
        {t.icon === "yin-yang" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 3a4.5 4.5 0 0 1 0 9 4.5 4.5 0 0 0 0 9 9 9 0 0 0 0-18Z" fill="currentColor" stroke="none"/><circle cx="12" cy="7.5" r="1.3" fill="#14110b" stroke="none"/><circle cx="12" cy="16.5" r="1.3" fill="currentColor" stroke="none"/></svg>
        )}
        {t.icon === "trend" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 17 9.5 11l4 4L20 6" stroke-linecap="round" stroke-linejoin="round"/><path d="M14.5 6H20v5.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        )}
        {t.icon === "user" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c1.2-3.8 4.3-6 7.5-6s6.3 2.2 7.5 6" stroke-linecap="round"/></svg>
        )}
      </span>
      <span class="qsn-label">{t.label}</span>
    </a>
  ))}
</nav>

<style>
  .qsn-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: flex; align-items: flex-end; justify-content: space-around;
    padding: 0.5rem 0.4rem calc(0.5rem + env(safe-area-inset-bottom));
    background: rgba(7, 6, 5, 0.94); backdrop-filter: blur(10px);
    border-top: 1px solid rgba(241, 200, 90, 0.16);
  }
  .qsn-tab {
    display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
    color: #a9a184; text-decoration: none; font-size: 0.66rem;
    flex: 1; min-width: 0; padding-top: 0.3rem;
  }
  .qsn-tab .qsn-ic { width: 22px; height: 22px; }
  .qsn-tab .qsn-ic svg { width: 100%; height: 100%; }
  .qsn-tab.active { color: #f1c85a; }
  .qsn-tab.qsn-center {
    margin-top: -1.6rem;
  }
  .qsn-tab.qsn-center .qsn-ic {
    width: 50px; height: 50px; padding: 11px;
    border-radius: 999px; background: linear-gradient(160deg, #f6d878, #d9a53a);
    color: #1a1206; box-shadow: 0 6px 16px rgba(241, 200, 90, 0.35), 0 0 0 4px rgba(7,6,5,0.94);
  }
  .qsn-tab.qsn-center .qsn-label { color: #f1c85a; font-weight: 700; }
</style>
