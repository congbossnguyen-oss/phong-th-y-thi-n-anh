---
// Bản ĐỘC LẬP cho app Quân Sư của "Xem Ngày Cưới Hỏi Trọn Gói" (anh Công chốt 1/9/2026: Quân Sư
// không đấu nối code với web nữa). CỐ Ý gần như y hệt `src/components/tools/NgayCuoiHoi.astro` —
// chấp nhận trùng lặp UI/routing thay vì import chéo sang component web. Vẫn dùng CHUNG engine
// tính toán (`@thien-anh/trachnhat-engine`). Gọi API riêng ở `/api/quan-su/vip/ngay-cuoi-hoi-qs/*`
// (toolSlug `ngay-cuoi-hoi-qs`).
import BottomNav from "../../quan-su/BottomNav.astro";
import Container from "../../ui/Container.astro";
import Button from "../../ui/Button.astro";
import MaKhuyenMai from "../../ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../../lib/payments/gia-cong-cu";

// Render phía máy chủ để đọc phiên đăng nhập — cần cho việc chỉ CHO QUẢN TRỊ dùng lúc thử nghiệm.
// Prerender thì `Astro.locals.user` luôn rỗng lúc build.
export const prerender = false;

const laQuanTri = Astro.locals.user?.isAdmin === true;

// Cờ thử nghiệm: true = bỏ bước thanh toán, nộp form ra kết quả ngay (không tạo đơn thật). Chỉ có ý
// nghĩa với quản trị vì khách không tới được form. Script đọc lại cờ qua data-test-mode.
const TEST_MODE = false;

const TOOL_SLUG = "ngay-cuoi-hoi-qs";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);
---

  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      {laQuanTri && (
      <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-gold-600)">
        🔒 CHẾ ĐỘ QUẢN TRỊ — đơn của bạn được tạo ở mức 0đ và tự xác nhận để test trọn luồng thu phí ({TOOL_PRICE_LABEL}/lượt với khách).
      </div>
      )}

      {true && (
      <>

      <div class="mb-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-600)">
        <p class="font-medium text-(--color-ink-800)">Dịch vụ gồm những gì</p>
        <ul class="mt-1.5 list-disc space-y-1 pl-5">
          <li><strong>Lập lịch trọn gói</strong> — chọn ngày + giờ đẹp cho cả 4 nghi lễ (ăn hỏi → đón dâu → thành hôn → đăng ký) theo đúng trình tự thời gian.</li>
          <li><strong>Chọn theo từng nghi lễ</strong> — xếp hạng nhiều ngày đẹp cho một nghi lễ cụ thể, mỗi ngày kèm sẵn giờ vàng.</li>
        </ul>
        <p class="mt-2">Chấm điểm độc lập cô dâu và chú rể rồi cân cặp đôi (ngày chỉ tốt cho một người sẽ không xếp cao). Loại thẳng ngày đại kỵ; nghi lễ thành hôn xét thêm Chu Đường / Hoà Thượng Sát / Khí Vãng Vong.</p>
      </div>

      <form
        id="ch-form"
        data-test-mode={String(TEST_MODE)}
        class="flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6"
      >
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1.5 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
            <p class="text-xs font-semibold text-(--color-cinnabar-400)">👰 Cô dâu</p>
            <label for="ch-nam-co-dau" class="text-xs text-(--color-ink-600)">Năm sinh (dương lịch)</label>
            <input type="number" id="ch-nam-co-dau" min="1940" max="2010" required placeholder="vd 1998" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
          </div>
          <div class="space-y-1.5 rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
            <p class="text-xs font-semibold text-(--color-gold-300)">🤵 Chú rể</p>
            <label for="ch-nam-chu-re" class="text-xs text-(--color-ink-600)">Năm sinh (dương lịch)</label>
            <input type="number" id="ch-nam-chu-re" min="1940" max="2010" required placeholder="vd 1996" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2 text-sm text-(--color-ink-800)" />
          </div>
        </div>

        <div class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
          <p class="text-sm font-medium text-(--color-ink-800)">Bạn muốn gì?</p>
          <div class="mt-2 flex flex-col gap-2">
            <label class="flex items-start gap-2 text-sm text-(--color-ink-700)">
              <input type="radio" name="cheDo" value="tron-goi" class="mt-1" checked />
              <span><strong>Lập lịch trọn gói</strong> — ngày + giờ cho cả 4 nghi lễ trong một lần.</span>
            </label>
            <label class="flex items-start gap-2 text-sm text-(--color-ink-700)">
              <input type="radio" name="cheDo" value="tung-nghi-le" class="mt-1" />
              <span><strong>Chọn theo từng nghi lễ</strong> — xếp hạng nhiều ngày đẹp cho một nghi lễ cụ thể.</span>
            </label>
          </div>
          <div id="ch-o-nghi-le" class="mt-3 hidden">
            <label for="ch-nghi-le" class="text-sm font-medium text-(--color-ink-800)">Nghi lễ</label>
            <select id="ch-nghi-le" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
              <option value="thanh-hon">Thành hôn (cưới)</option>
              <option value="an-hoi">Ăn hỏi</option>
              <option value="don-dau">Đón dâu</option>
              <option value="dang-ky-ket-hon">Đăng ký kết hôn</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="ch-tu-ngay" class="text-xs font-medium text-(--color-ink-700)">Từ ngày</label>
            <input type="date" id="ch-tu-ngay" required class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
          <div>
            <label for="ch-den-ngay" class="text-xs font-medium text-(--color-ink-700)">Đến ngày</label>
            <input type="date" id="ch-den-ngay" required class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
        </div>
        <p class="-mt-2 text-xs text-(--color-ink-500)">Nên để khoảng đủ rộng (2–4 tháng) để ăn hỏi có ngày đẹp trước ngày cưới.</p>

        <div>
          <label for="ch-uu-tien" class="text-sm font-medium text-(--color-ink-800)">Ưu tiên</label>
          <select id="ch-uu-tien" class="mt-1.5 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)">
            <option value="can-bang">Cân bằng hai người</option>
            <option value="uu-tien-co-dau">Ưu tiên cô dâu</option>
            <option value="uu-tien-chu-re">Ưu tiên chú rể</option>
          </select>
        </div>

        {!TEST_MODE && (
        <>
        <div class="border-t border-(--color-ivory-300) pt-4">
          <p class="text-sm font-medium text-(--color-ink-800)">Thông tin liên hệ (để nhận kết quả sau khi thanh toán)</p>
          <div class="mt-2 grid gap-3">
            <input type="text" id="ch-ten" placeholder="Họ tên" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            <input type="tel" id="ch-sdt" placeholder="Số điện thoại" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
            <input type="email" id="ch-email" placeholder="Email (tùy chọn)" class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
          </div>
        </div>
        <MaKhuyenMai idPrefix="ch-ma" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />
        </>
        )}

        <Button type="submit" size="lg"><span id="ch-nhan-nut">Lập lịch trọn gói</span></Button>
      </form>

      <div id="ch-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>
      <div id="ch-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
        <p class="font-medium text-(--color-ink-900)">⏳ Đang tính, vui lòng đợi…</p>
      </div>

      <div id="ch-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
        <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="ch-so-tien">{TOOL_PRICE_LABEL}</span></p>
        <img id="ch-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
        <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="ch-order-code"></strong></p>
        <p id="ch-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
      </div>

      <div id="ch-ket-qua" class="mt-6 hidden"></div>

      <p class="mt-4 text-xs text-(--color-ink-500)">
        Kết quả tính theo hệ thống phong thủy đã cấu hình (hợp tuổi ngày/giờ, hỷ tinh Hồng Loan/Thiên Hỷ,
        trạch cát, hoàng đạo, Tiểu Lục Nhâm). Mang tính tham khảo, không thay thế tư vấn trực tiếp.
      </p>
      </>
      )}
    </div>
  </Container>
  <BottomNav />

<script>
  function esc(s: unknown): string {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  const MAU_HANG: Record<string, string> = {
    "dai-cat": "text-(--color-success-500)",
    "rat-tot": "text-(--color-success-500)",
    tot: "text-(--color-gold-400)",
    "co-the-dung": "text-(--color-ink-600)",
    "khong-thuan": "text-(--color-cinnabar-500)",
    "khong-nen-chon": "text-(--color-cinnabar-500)",
  };
  const ICON_LE: Record<string, string> = { "an-hoi": "💐", "don-dau": "🚗", "thanh-hon": "💒", "dang-ky-ket-hon": "📝" };

  // Khách không phải quản trị: form không được render → không chạy gì (toàn bộ logic nằm trong if).
  const form = document.getElementById("ch-form") as HTMLFormElement | null;
  if (form) {
  const loiEl = document.getElementById("ch-loi")!;
  const ketQuaEl = document.getElementById("ch-ket-qua")!;
  const dangChayEl = document.getElementById("ch-dang-chay")!;
  const thanhToanEl = document.getElementById("ch-thanh-toan")!;
  const qrImg = document.getElementById("ch-qr") as HTMLImageElement;
  const orderCodeEl = document.getElementById("ch-order-code")!;
  const trangThaiEl = document.getElementById("ch-trang-thai")!;
  const soTienEl = document.getElementById("ch-so-tien")!;
  const nutSubmit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const nhanNut = document.getElementById("ch-nhan-nut")!;
  const oNghiLe = document.getElementById("ch-o-nghi-le")!;

  const TEST_MODE = form.dataset.testMode === "true";

  function cheDoDangChon(): string {
    return (form.querySelector('input[name="cheDo"]:checked') as HTMLInputElement).value;
  }
  function capNhatTheoCheDo() {
    const cd = cheDoDangChon();
    oNghiLe.classList.toggle("hidden", cd !== "tung-nghi-le");
    nhanNut.textContent = cd === "tron-goi" ? "Lập lịch trọn gói" : "Tìm ngày cho nghi lễ";
  }
  form.querySelectorAll('input[name="cheDo"]').forEach((r) => r.addEventListener("change", capNhatTheoCheDo));
  capNhatTheoCheDo();

  function parseNgay(v: string): { year: number; month: number; day: number } | null {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v);
    if (!m) return null;
    return { year: Number(m[1]), month: Number(m[2]), day: Number(m[3]) };
  }

  // ── Render ──
  function theGio(gioTot: any[]): string {
    return gioTot
      .map((g) => `<span class="inline-block rounded-md bg-(--color-gold-400)/10 px-2 py-0.5 text-xs text-(--color-gold-500)">Giờ ${esc(g.chiGio)} (${esc(g.khungGio)}) · ${g.diem}/10</span>`)
      .join(" ");
  }

  function renderTronGoi(lich: any) {
    const mucHtml = (lich.muc as any[])
      .map((m) => {
        if (!m.solarDate) {
          return `<div class="relative pl-8 pb-6"><span class="absolute left-0 top-0.5 text-lg">${ICON_LE[m.nghiLe] ?? "•"}</span>
            <p class="font-display font-bold text-(--color-ink-950)">${esc(m.tenNghiLe)}</p>
            <p class="text-sm text-(--color-cinnabar-500)">Không tìm được ngày phù hợp trong khoảng — thử mở rộng khoảng ngày.</p></div>`;
        }
        const canhBao = m.canhBao.length ? `<p class="mt-1 text-xs text-(--color-cinnabar-500)">⚠ ${m.canhBao.map(esc).join("; ")}</p>` : "";
        return `<div class="relative border-l-2 border-(--color-gold-300) pl-6 pb-6 last:border-transparent last:pb-0">
          <span class="absolute -left-[13px] top-0 grid h-6 w-6 place-items-center rounded-full bg-(--color-gold-400)/15 text-sm">${ICON_LE[m.nghiLe] ?? "•"}</span>
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display font-bold text-(--color-ink-950)">${esc(m.tenNghiLe)}</p>
            <p class="font-display text-sm font-bold ${MAU_HANG[m.hang] ?? "text-(--color-ink-700)"}">${m.diemNgay}/10 · ${esc(m.tenHang)}</p>
          </div>
          <p class="text-sm text-(--color-ink-700)">${m.solarDate.day}/${m.solarDate.month}/${m.solarDate.year}
            <span class="text-xs text-(--color-ink-500)">(ÂL ${m.lunarDate.day}/${m.lunarDate.month}${m.lunarDate.isLeapMonth ? " nhuận" : ""} · ngày ${esc(m.chiNgay)})</span></p>
          <div class="mt-1.5 flex flex-wrap gap-1">${theGio(m.gioTot)}</div>
          ${canhBao}
        </div>`;
      })
      .join("");
    const ghiChu = (lich.ghiChu as string[]).map((g) => `<li>${esc(g)}</li>`).join("");
    ketQuaEl.innerHTML = `<div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 shadow-lg">
      <p class="mb-4 text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Lịch cưới hỏi đề xuất</p>
      <div>${mucHtml}</div>
      <ul class="mt-4 list-disc space-y-1 border-t border-(--color-ivory-200) pt-3 pl-4 text-[11px] text-(--color-ink-400)">${ghiChu}</ul>
    </div>`;
    ketQuaEl.classList.remove("hidden");
  }

  function renderTungNghiLe(r: any) {
    const dsHtml = (r.ngayXepHang as any[])
      .map((n, i) => {
        const huy = ["🥇", "🥈", "🥉"][i] ?? `${i + 1}.`;
        const catTinh = n.catTinhMoTa.length ? `<p class="mt-1 text-xs text-(--color-success-500)">✨ ${n.catTinhMoTa.map(esc).join(" · ")}</p>` : "";
        const canhBao = n.canhBao.length ? `<p class="mt-1 text-xs text-(--color-cinnabar-500)">⚠ ${n.canhBao.map(esc).join("; ")}</p>` : "";
        return `<div class="rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 shadow-sm">
          <div class="flex items-baseline justify-between">
            <p class="font-display font-bold text-(--color-ink-950)">${huy} ${n.solarDate.day}/${n.solarDate.month}/${n.solarDate.year}
              <span class="ml-1 text-xs font-normal text-(--color-ink-500)">(ÂL ${n.lunarDate.day}/${n.lunarDate.month}${n.lunarDate.isLeapMonth ? " nhuận" : ""} · ngày ${esc(n.chiNgay)})</span></p>
            <p class="font-display text-lg font-bold ${MAU_HANG[n.hang] ?? "text-(--color-ink-700)"}">${n.diemCapDoi}/10</p>
          </div>
          <p class="text-xs font-semibold ${MAU_HANG[n.hang] ?? "text-(--color-ink-600)"}">${esc(n.tenHang)}</p>
          <p class="mt-1 text-sm text-(--color-ink-600)">👰 Cô dâu ${n.diemCoDau}/10 · 🤵 Chú rể ${n.diemChuRe}/10</p>
          ${catTinh}${canhBao}
          <div class="mt-2 flex flex-wrap gap-1">${theGio(n.gioTot)}</div>
        </div>`;
      })
      .join("");
    ketQuaEl.innerHTML = `<div class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 shadow-lg">
      <p class="text-xs font-bold uppercase tracking-wide text-(--color-gold-400)">Ngày đẹp cho ${esc(r.tenNghiLe)}</p>
      ${r.soNgayBiLoai > 0 ? `<p class="mt-1 text-xs text-(--color-ink-500)">Đã loại ${r.soNgayBiLoai} ngày phạm đại kỵ.</p>` : ""}
      <div class="mt-3 space-y-2">${dsHtml || `<p class="text-sm text-(--color-ink-500)">Không có ngày nào đạt trong khoảng đã chọn — thử mở rộng khoảng ngày.</p>`}</div>
    </div>`;
    ketQuaEl.classList.remove("hidden");
  }

  function hienKetQua(result: any) {
    if (result.cheDo === "tron-goi") renderTronGoi(result.lich);
    else renderTungNghiLe(result);
    ketQuaEl.classList.remove("hidden");
    ketQuaEl.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // ── Thanh toán ──
  let pollTimer: ReturnType<typeof setInterval> | null = null;
  let dangHoi = false;
  function dungCho() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  }
  async function layKetQua(orderCode: string) {
    if (dangHoi) return;
    dangHoi = true;
    try {
      const res = await fetch(`/api/quan-su/vip/ngay-cuoi-hoi-qs/result?orderCode=${encodeURIComponent(orderCode)}`);
      const data = await res.json();
      if (!data.ok) return;
      if (data.status === "cancelled") { dungCho(); trangThaiEl.textContent = "Đơn hàng đã bị hủy."; return; }
      if (data.status !== "confirmed") return;
      dungCho();
      dangChayEl.classList.add("hidden");
      thanhToanEl.classList.add("hidden");
      hienKetQua(data.result);
    } catch {
      // mạng chập chờn — nhịp sau thử lại
    } finally {
      dangHoi = false;
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const namSinhCoDau = (document.getElementById("ch-nam-co-dau") as HTMLInputElement).value;
    const namSinhChuRe = (document.getElementById("ch-nam-chu-re") as HTMLInputElement).value;
    const tuNgay = parseNgay((document.getElementById("ch-tu-ngay") as HTMLInputElement).value);
    const denNgay = parseNgay((document.getElementById("ch-den-ngay") as HTMLInputElement).value);
    const uuTien = (document.getElementById("ch-uu-tien") as HTMLSelectElement).value;
    const cheDo = cheDoDangChon();
    const nghiLe = (document.getElementById("ch-nghi-le") as HTMLSelectElement).value;

    const baoLoi = (msg: string) => {
      dangChayEl.classList.add("hidden");
      if (nutSubmit) nutSubmit.disabled = false;
      loiEl.textContent = msg;
      loiEl.classList.remove("hidden");
    };

    if (!namSinhCoDau || !namSinhChuRe || !tuNgay || !denNgay) {
      return baoLoi("Vui lòng nhập đủ năm sinh hai người và khoảng ngày.");
    }

    const chung = {
      namSinhCoDau: Number(namSinhCoDau),
      namSinhChuRe: Number(namSinhChuRe),
      tuNgay,
      denNgay,
      uuTien,
      cheDo,
      ...(cheDo === "tung-nghi-le" ? { nghiLe } : {}),
    };

    dangChayEl.classList.remove("hidden");
    if (nutSubmit) nutSubmit.disabled = true;

    try {
      if (TEST_MODE) {
        const res = await fetch("/api/quan-su/vip/ngay-cuoi-hoi-qs/test-calculate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(chung),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tính được.");
        dangChayEl.classList.add("hidden");
        if (nutSubmit) nutSubmit.disabled = false;
        hienKetQua(data.result);
        return;
      }

      const res = await fetch("/api/quan-su/vip/ngay-cuoi-hoi-qs/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...chung,
          customerName: (document.getElementById("ch-ten") as HTMLInputElement | null)?.value.trim() ?? "",
          customerPhone: (document.getElementById("ch-sdt") as HTMLInputElement | null)?.value.trim() ?? "",
          customerEmail: (document.getElementById("ch-email") as HTMLInputElement | null)?.value.trim() ?? "",
          maKhuyenMai: (document.getElementById("ch-ma-input") as HTMLInputElement | null)?.value.trim() ?? "",
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
      dangChayEl.classList.add("hidden");
      if (nutSubmit) nutSubmit.disabled = false;
      orderCodeEl.textContent = data.orderCode;

      if (data.mienPhi) {
        dangChayEl.classList.remove("hidden");
        await layKetQua(data.orderCode);
        return;
      }

      soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
      qrImg.src = data.qrUrl;
      trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
      thanhToanEl.classList.remove("hidden");
      thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
      pollTimer = setInterval(() => layKetQua(data.orderCode), 3000);
    } catch {
      baoLoi("Không tính được. Vui lòng thử lại.");
    }
  });
  }
</script>
