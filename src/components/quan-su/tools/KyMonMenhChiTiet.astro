---
// Bản ĐỘC LẬP cho app Quân Sư của "Luận Giải Kỳ Môn Mệnh chi tiết" (anh Công chốt 1/9/2026: Quân
// Sư không đấu nối code với web nữa). CỐ Ý gần như y hệt `src/components/tools/KyMonMenhChiTiet.astro`
// — chấp nhận trùng lặp UI/routing thay vì import chéo sang component web. Vẫn dùng CHUNG engine
// tính toán (`lapLaBan`, `luanGiaiMenh`, `luanGiaiMenhChiTiet`) và hạ tầng đơn hàng (`getOrderByCode`)
// — đó là logic/nghiệp vụ thuần, không phải "web". Gọi API riêng ở
// `/api/quan-su/vip/ky-mon-menh-chi-tiet-qs/*` (toolSlug `ky-mon-menh-chi-tiet-qs`).
//
//  - Chưa có ?orderCode → hiện FORM (ngày giờ sinh đã mang theo từ trang Lập Kỳ Môn qua query) +
//    thông tin liên hệ + thanh toán QR (poll trạng thái).
//  - Có ?orderCode đã confirmed → server tính lại kết quả (thuần công thức, không AI) từ
//    toolInputSnapshot và hiện bảng luận giải đầy đủ.
import Container from "../../ui/Container.astro";
import Button from "../../ui/Button.astro";
import MaKhuyenMai from "../../ui/MaKhuyenMai.astro";
import { GIA_CONG_CU, dinhDangTien } from "../../../lib/payments/gia-cong-cu";
import { getOrderByCode } from "../../../lib/db/orders";
import { lapLaBan, luanGiaiMenh, luanGiaiMenhChiTiet } from "../../../lib/kymon";

export const prerender = false;

interface Props {
  /**
   * Đường dẫn trang "Lập Kỳ Môn" tương ứng — dùng cho lời nhắc khi khách vào thẳng đây mà thiếu
   * ngày giờ sinh. Trỏ `/quan-su/lap-ky-mon` (app) — KHÔNG hard-code để khách trong app không bị
   * đá văng ra ngoài web.
   */
  hrefLapKyMon?: string;
  /**
   * true = KHÔNG hiện giá tiền từng lượt (app Quân Sư: anh Công 27/8/2026 — app sẽ tính giá trọn
   * gói cho cả app, không niêm yết giá lẻ từng mục).
   *
   * Ẩn giá ở đây TRUNG THỰC vì slug này đã nằm trong VIP_SLUG_THEO_GOI (miễn phí cho khách có gói
   * Cao Cấp / đang dùng thử) — chốt 27/8/2026. Nếu sau này tách nhóm Kỳ Môn ra hạng riêng ("Siêu
   * Cấp") thì phải xem lại chỗ này, đừng để ẩn giá mà vẫn thu tiền.
   */
  anGia?: boolean;
}
const { hrefLapKyMon = "/quan-su/lap-ky-mon", anGia = false } = Astro.props;

const laQuanTri = Astro.locals.user?.isAdmin === true;
const TOOL_SLUG = "ky-mon-menh-chi-tiet-qs";
const TOOL_PRICE = GIA_CONG_CU[TOOL_SLUG];
const TOOL_PRICE_LABEL = dinhDangTien(TOOL_PRICE);

// Ngày giờ sinh mang theo từ trang Lập Kỳ Môn (đã lập lá bàn Mệnh miễn phí ở đó) — không hỏi lại.
const q = Astro.url.searchParams;
const namQ = Number(q.get("nam"));
const thangQ = Number(q.get("thang"));
const ngayQ = Number(q.get("ngay"));
const gioQ = Number(q.get("gio"));
const phutQ = Number(q.get("phut"));
const coDuLieuNgaySinh = [namQ, thangQ, ngayQ, gioQ, phutQ].every(Number.isInteger);

const orderCode = q.get("orderCode");
let free: ReturnType<typeof luanGiaiMenh> | null = null;
let chiTiet: ReturnType<typeof luanGiaiMenhChiTiet> | null = null;
let order: Awaited<ReturnType<typeof getOrderByCode>> | null = null;
if (orderCode) {
  order = await getOrderByCode(orderCode);
  if (order && order.orderType === "tool" && order.toolSlug === TOOL_SLUG && order.status === "confirmed" && order.toolInputSnapshot) {
    try {
      const input = JSON.parse(order.toolInputSnapshot) as { nam: number; thang: number; ngay: number; gio: number; phut: number };
      // ⚠️ Nhánh Cloudflare: lapLaBan() là ASYNC (đọc km_data qua import động) — phải await,
      // khác bản Node ở nhánh main vốn gọi đồng bộ. Thiếu await thì laBan là Promise → luận sai.
      const laBan = await lapLaBan({ cheDo: "menh", ...input });
      free = luanGiaiMenh(laBan);
      chiTiet = luanGiaiMenhChiTiet(laBan);
    } catch {
      free = null;
      chiTiet = null;
    }
  }
}
---

<Container class="py-10">
  <div class="mx-auto max-w-2xl">
    {order?.status === "confirmed" && free && chiTiet ? (
      <div class="space-y-8">
        <div class="rounded-(--radius-card) border border-(--color-gold-400)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
          ✅ Đã thanh toán — mã đơn <strong>{order.orderCode}</strong>. Bảng luận giải đầy đủ (kèm PDF) đã được gửi tới email {order.customerEmail}.
        </div>

        <section>
          <h2 class="font-display text-xl font-bold text-(--color-ink-950)">Tổng quan</h2>
          <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">{free.moDau}</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-bold text-(--color-ink-950)">Từng lĩnh vực</h2>
          <div class="mt-3 space-y-3">
            {free.theLinhVuc.map((the) => (
              <details class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
                <summary class="cursor-pointer font-semibold text-(--color-cinnabar-400)">{the.tieuDe}</summary>
                <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">{the.noiDung}</p>
              </details>
            ))}
          </div>
        </section>

        {chiTiet.nguoiThan.length > 0 && (
          <section>
            <h2 class="font-display text-xl font-bold text-(--color-ink-950)">Người thân xung quanh</h2>
            <div class="mt-3 space-y-3">
              {chiTiet.nguoiThan.map((nt) => (
                <details class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
                  <summary class="cursor-pointer font-semibold text-(--color-cinnabar-400)">{nt.vaiTro}</summary>
                  <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">{nt.noiDung}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {chiTiet.giaiDoanCuocDoi.length > 0 && (
          <section>
            <h2 class="font-display text-xl font-bold text-(--color-ink-950)">4 giai đoạn cuộc đời</h2>
            <div class="mt-3 space-y-3">
              {chiTiet.giaiDoanCuocDoi.map((gd) => (
                <details class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-3">
                  <summary class="cursor-pointer font-semibold text-(--color-cinnabar-400)">{gd.giaiDoan}</summary>
                  <p class="mt-2 text-sm leading-relaxed text-(--color-ink-800)">{gd.noiDung}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {chiTiet.cachCucNoiBat.length > 0 && (
          <section>
            <h2 class="font-display text-xl font-bold text-(--color-ink-950)">Cách cục nổi bật (chuyên sâu)</h2>
            <div class="mt-3 space-y-3">
              {chiTiet.cachCucNoiBat.map((cc) => (
                <div class="rounded-(--radius-control) border border-(--color-cinnabar-400)/30 bg-(--color-ivory-50) p-3">
                  <p class="font-semibold text-(--color-cinnabar-400)">{cc.viTri} — {cc.ten}</p>
                  <p class="mt-1 text-sm leading-relaxed text-(--color-ink-800)">{cc.yNghia}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    ) : orderCode ? (
      <div class="rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6 text-center">
        <p class="font-medium text-(--color-ink-800)">Đơn hàng chưa xác nhận hoặc không tồn tại.</p>
        <p class="mt-1 text-sm text-(--color-ink-500)">Nếu bạn vừa chuyển khoản, vui lòng đợi vài giây rồi tải lại trang.</p>
      </div>
    ) : (
      <>
        {laQuanTri && (
          <div class="mb-4 rounded-(--radius-card) border-2 border-(--color-gold-400) bg-(--color-gold-400)/10 p-4 text-sm font-medium text-(--color-gold-600)">
            🔒 CHẾ ĐỘ QUẢN TRỊ — đơn của bạn được tạo ở mức 0đ và tự xác nhận để test trọn luồng (khách thật trả {TOOL_PRICE_LABEL}/lượt).
          </div>
        )}

        {!coDuLieuNgaySinh ? (
          <div class="rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)">
            Thiếu ngày giờ sinh — vui lòng vào lại từ trang <a href={hrefLapKyMon} class="underline">Lập Kỳ Môn Độn Giáp</a>, chọn chế độ Mệnh, lập lá bàn rồi bấm nút "Xem luận giải chi tiết".
          </div>
        ) : (
          <>
            <div class="mb-6 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-4 text-sm text-(--color-ink-600)">
              <p class="font-medium text-(--color-ink-800)">Ngày giờ sinh dùng để luận giải</p>
              <p class="mt-1">{String(ngayQ).padStart(2, "0")}/{String(thangQ).padStart(2, "0")}/{namQ} — {String(gioQ).padStart(2, "0")}:{String(phutQ).padStart(2, "0")}</p>
              <p class="mt-2 text-xs text-(--color-ink-500)">Đúng lá bàn đã xem ở bản miễn phí — không hỏi lại.</p>
            </div>

            <form id="kmm-form" class="flex flex-col gap-4 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) p-6">
              <input type="hidden" id="kmm-nam" value={namQ} />
              <input type="hidden" id="kmm-thang" value={thangQ} />
              <input type="hidden" id="kmm-ngay" value={ngayQ} />
              <input type="hidden" id="kmm-gio" value={gioQ} />
              <input type="hidden" id="kmm-phut" value={phutQ} />

              <div>
                <p class="text-sm font-medium text-(--color-ink-800)">Thông tin liên hệ (để nhận kết quả & PDF sau khi thanh toán)</p>
                <div class="mt-2 grid gap-3">
                  <input type="text" id="kmm-ten" placeholder="Họ tên" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                  <input type="tel" id="kmm-sdt" placeholder="Số điện thoại" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                  <input type="email" id="kmm-email" placeholder="Email (bắt buộc — để nhận PDF)" required class="w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
                </div>
              </div>

              {!anGia && <MaKhuyenMai idPrefix="kmm-ma" toolSlug={TOOL_SLUG} giaGoc={TOOL_PRICE} />}

              <Button type="submit" size="lg">{anGia ? "Xem luận giải chi tiết" : `Xem luận giải chi tiết — ${TOOL_PRICE_LABEL}`}</Button>
            </form>

            <div id="kmm-dang-chay" class="mt-4 hidden rounded-(--radius-card) border border-(--color-gold-500)/40 bg-(--color-gold-400)/10 p-4 text-sm text-(--color-ink-700)">
              <p class="font-medium text-(--color-ink-900)">⏳ Đang tạo đơn hàng…</p>
            </div>
            <div id="kmm-loi" class="mt-4 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-4 text-sm text-(--color-danger-500)"></div>

            <div id="kmm-thanh-toan" class="mt-6 hidden space-y-4 rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-center text-(--color-ink-950) shadow-lg">
              <p class="font-display text-lg font-bold">Quét mã QR để thanh toán <span id="kmm-so-tien"></span></p>
              <img id="kmm-qr" src="" alt="Mã QR thanh toán" class="mx-auto h-64 w-64 rounded-xl border border-(--color-ivory-300)" />
              <p class="text-sm text-(--color-ink-600)">Mã đơn hàng: <strong id="kmm-order-code"></strong></p>
              <p id="kmm-trang-thai" class="text-sm font-medium text-(--color-gold-400)">Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)</p>
            </div>
          </>
        )}
      </>
    )}
  </div>
</Container>

<script>
  const form = document.getElementById("kmm-form") as HTMLFormElement | null;
  if (form) {
    const loiEl = document.getElementById("kmm-loi")!;
    const dangChayEl = document.getElementById("kmm-dang-chay")!;
    const thanhToanEl = document.getElementById("kmm-thanh-toan")!;
    const qrImg = document.getElementById("kmm-qr") as HTMLImageElement;
    const orderCodeEl = document.getElementById("kmm-order-code")!;
    const trangThaiEl = document.getElementById("kmm-trang-thai")!;
    const soTienEl = document.getElementById("kmm-so-tien")!;
    const nutSubmit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    let pollTimer: ReturnType<typeof setInterval> | null = null;
    let dangHoi = false;
    const doc = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? "";

    const tatDangChay = () => {
      dangChayEl.classList.add("hidden");
      if (nutSubmit) nutSubmit.disabled = false;
    };
    const baoLoi = (msg: string) => {
      tatDangChay();
      loiEl.textContent = msg;
      loiEl.classList.remove("hidden");
    };
    const dungCho = () => {
      if (pollTimer) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    };

    async function kiemTra(orderCode: string) {
      if (dangHoi) return;
      dangHoi = true;
      try {
        const res = await fetch(`/api/quan-su/vip/ky-mon-menh-chi-tiet-qs/result?orderCode=${encodeURIComponent(orderCode)}`);
        const data = await res.json();
        if (!data.ok) return;
        if (data.status === "cancelled") {
          dungCho();
          trangThaiEl.textContent = "Đơn hàng đã bị hủy.";
          return;
        }
        if (data.status !== "confirmed") return;
        dungCho();
        const url = new URL(window.location.href);
        url.searchParams.set("orderCode", orderCode);
        window.location.href = url.toString();
      } catch {
        // mạng chập chờn — nhịp sau thử lại
      } finally {
        dangHoi = false;
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      loiEl.classList.add("hidden");

      if (!doc("kmm-ten") || !doc("kmm-sdt") || !doc("kmm-email")) {
        return baoLoi("Vui lòng nhập đầy đủ họ tên, số điện thoại và email.");
      }

      const payload: Record<string, unknown> = {
        nam: Number(doc("kmm-nam")),
        thang: Number(doc("kmm-thang")),
        ngay: Number(doc("kmm-ngay")),
        gio: Number(doc("kmm-gio")),
        phut: Number(doc("kmm-phut")),
        customerName: doc("kmm-ten"),
        customerPhone: doc("kmm-sdt"),
        customerEmail: doc("kmm-email"),
        ...(doc("kmm-ma-input") ? { maKhuyenMai: doc("kmm-ma-input") } : {}),
      };

      dangChayEl.classList.remove("hidden");
      if (nutSubmit) nutSubmit.disabled = true;
      try {
        const res = await fetch("/api/quan-su/vip/ky-mon-menh-chi-tiet-qs/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return baoLoi(data.error ?? "Không tạo được đơn hàng.");
        tatDangChay();
        orderCodeEl.textContent = data.orderCode;

        if (data.mienPhi) {
          dangChayEl.classList.remove("hidden");
          await kiemTra(data.orderCode);
          return;
        }

        soTienEl.textContent = `${Number(data.totalAmount).toLocaleString("vi-VN")}đ`;
        qrImg.src = data.qrUrl;
        trangThaiEl.textContent = "Đang chờ thanh toán... (tự động kiểm tra mỗi 3 giây)";
        thanhToanEl.classList.remove("hidden");
        thanhToanEl.scrollIntoView({ behavior: "smooth", block: "start" });
        pollTimer = setInterval(() => kiemTra(data.orderCode), 3000);
      } catch {
        baoLoi("Có lỗi xảy ra. Vui lòng thử lại.");
      }
    });
  }
</script>
