---
// Bản ĐỘC LẬP cho app Quân Sư của "Chọn Năm Sinh Con" (anh Công chốt 1/9/2026: Quân Sư không đấu
// nối code với web nữa — áp dụng cả module miễn phí, không chỉ VIP). Trước đây component này CỐ Ý
// dùng chung với web (quyết định 29/8/2026), nay tách hẳn theo chủ trương mới hơn. CỐ Ý gần như y
// hệt `src/components/tools/ChonNamSinhCon.astro` — chấp nhận trùng lặp UI/routing. Vẫn dùng CHUNG
// engine tính toán (`@thien-anh/trachnhat-engine`). Gọi API riêng ở `/api/quan-su/chon-nam-sinh-con`.
// Module miễn phí, không có toolSlug/thanh toán.
//
// CTA cuối trang mời nâng cấp KHÁC NHAU giữa web/app (anh Công 29/8/2026: 2 nhánh tính tiền khác
// nhau — web bán lẻ từng công cụ, app bán thuê bao) — `laApp` chọn đúng component.
import Container from "../../ui/Container.astro";
import Button from "../../ui/Button.astro";
import GoiYNangCap from "../../ui/GoiYNangCap.astro";
import GoiYNangCapApp from "../../quan-su/GoiYNangCapApp.astro";

interface Props {
  /** true = hiện app Quân Sư (mời nâng cấp gói Cao Cấp) thay vì mời mua lẻ như bản web. */
  laApp?: boolean;
}
const { laApp = false } = Astro.props;
---

<Container class="py-16">
  <div class="mx-auto max-w-2xl">
    <form id="form-chon-con" class="rounded-2xl border-2 border-(--color-gold-300) bg-(--color-ivory-100) p-6 text-(--color-ink-950) shadow-lg">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="ccc-nam-cha" class="text-xs font-medium text-(--color-ink-600)">Năm sinh chồng</label>
          <input type="number" id="ccc-nam-cha" min="1900" max="2100" required placeholder="1984" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
        <div>
          <label for="ccc-nam-me" class="text-xs font-medium text-(--color-ink-600)">Năm sinh vợ</label>
          <input type="number" id="ccc-nam-me" min="1900" max="2100" required placeholder="1988" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
      </div>
      <div class="mt-3">
        <p class="text-xs font-medium text-(--color-ink-600)">Giới tính con</p>
        <div class="mt-1.5 flex gap-4 text-sm">
          <label class="flex items-center gap-1.5"><input type="radio" name="ccc-gioitinh-con" value="nam" checked /> 👦 Con trai</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="ccc-gioitinh-con" value="nu" /> 👧 Con gái</label>
        </div>
      </div>
      <div class="mt-3 grid grid-cols-2 gap-3">
        <div>
          <label for="ccc-tu-nam" class="text-xs font-medium text-(--color-ink-600)">Từ năm</label>
          <input type="number" id="ccc-tu-nam" min="1900" max="2100" required placeholder="2026" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
        <div>
          <label for="ccc-den-nam" class="text-xs font-medium text-(--color-ink-600)">Đến năm</label>
          <input type="number" id="ccc-den-nam" min="1900" max="2100" required placeholder="2035" class="mt-1 w-full rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) px-3 py-2.5 text-sm text-(--color-ink-800)" />
        </div>
      </div>
      <p class="mt-2 text-xs text-(--color-ink-400)">Tối đa 30 năm mỗi lượt tìm.</p>
      <Button type="submit" size="lg" class="mt-4 w-full">Tìm năm sinh con</Button>
    </form>

    <div id="loi" class="mt-3 hidden rounded-(--radius-card) border border-(--color-danger-500)/40 bg-(--color-danger-500)/10 p-3 text-sm text-(--color-danger-500)"></div>

    <div id="ket-qua" class="mt-4 hidden space-y-2"></div>

    <p class="mt-4 text-xs text-(--color-ink-500)">
      Đây là đánh giá theo hệ thống phong thủy đã cấu hình (Mệnh Nạp Âm, Thiên Can, Địa Chi, Cung Mệnh Bát Trạch,
      Niên Mệnh theo Địa Chi) giữa cha-con và mẹ-con — không kết luận tuyệt đối về sức khỏe, giới tính hay tương lai
      của trẻ, và không phải dự đoán khả năng sinh con trai/gái.
    </p>

    {laApp ? (
      <GoiYNangCapApp lyDo="Chọn được năm hợp rồi, việc quyết định tiếp theo là NGÀY và GIỜ chào đời — dịch vụ chuyên sâu chấm riêng 4 mặt Sức khỏe, Gia đạo, Tài vận, Nhân duyên cho từng khung giờ, kèm cả Tử Vi lẫn Bát Tự." tieuDe="Đã chọn được năm sinh?" />
    ) : (
      <GoiYNangCap slug="trach-nhat-sinh-no" lyDo="Chọn được năm hợp rồi, việc quyết định tiếp theo là NGÀY và GIỜ chào đời — công cụ chuyên sâu chấm riêng 4 mặt Sức khỏe, Gia đạo, Tài vận, Nhân duyên cho từng khung giờ, kèm cả Tử Vi lẫn Bát Tự." nhanNut="Chọn ngày giờ sinh cho bé" tieuDe="Đã chọn được năm sinh?" />
    )}
  </div>
</Container>

<script>
  // Chấm màu CSS tự vẽ thay cho emoji tròn màu (🟢🟡🟠🔴) trong nhãn "nhan" — emoji phụ thuộc font
  // từng máy, có thể khiến vàng/cam trông gần giống nhau ở cỡ nhỏ. Dùng hex cố định để tương phản rõ.
  const EMOJI_DOT_COLOR: Record<string, string> = { "⭐": "#7c3aed", "🟢": "#16a34a", "🟡": "#eab308", "🟠": "#c2410c", "🔴": "#dc2626" };
  function nhanDotHtml(nhan: string): string {
    const m = nhan.match(/^(\S+)\s*([\s\S]*)$/);
    const color = m ? EMOJI_DOT_COLOR[m[1]] : undefined;
    if (!color || !m) return nhan;
    return `<span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 shrink-0 rounded-full" style="background:${color};"></span>${m[2]}</span>`;
  }

  interface TieuChi { diem: number; moTa: string }
  interface ParentChildScore {
    diem: number;
    menh: TieuChi;
    thienCan: TieuChi;
    diaChi: TieuChi;
    cungMenh: TieuChi;
    nienMenh: TieuChi;
  }
  interface ChildYearResult {
    namSinhCon: number;
    gioiTinhCon: string;
    cha: ParentChildScore;
    me: ParentChildScore;
    diem: number;
    hang: string;
    nhan: string;
  }

  const form = document.getElementById("form-chon-con") as HTMLFormElement;
  const loiEl = document.getElementById("loi")!;
  const ketQuaEl = document.getElementById("ket-qua")!;

  const HUY_CHUONG = ["🥇", "🥈", "🥉"];

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loiEl.classList.add("hidden");
    ketQuaEl.classList.add("hidden");

    const namSinhCha = (document.getElementById("ccc-nam-cha") as HTMLInputElement).value;
    const namSinhMe = (document.getElementById("ccc-nam-me") as HTMLInputElement).value;
    const gioiTinhCon = (form.querySelector('input[name="ccc-gioitinh-con"]:checked') as HTMLInputElement).value;
    const tuNam = (document.getElementById("ccc-tu-nam") as HTMLInputElement).value;
    const denNam = (document.getElementById("ccc-den-nam") as HTMLInputElement).value;

    try {
      const res = await fetch(
        `/api/quan-su/chon-nam-sinh-con?namSinhCha=${namSinhCha}&namSinhMe=${namSinhMe}&gioiTinhCon=${gioiTinhCon}&tuNam=${tuNam}&denNam=${denNam}`,
      );
      const data = await res.json();
      if (!res.ok) {
        loiEl.textContent = data.error ?? "Không tính được.";
        loiEl.classList.remove("hidden");
        return;
      }
      const results = data.results as ChildYearResult[];
      ketQuaEl.innerHTML = results
        .slice(0, 10)
        .map((r, i) => {
          const huyChuong = HUY_CHUONG[i] ?? `${i + 1}.`;
          return `<button type="button" class="ccc-item w-full rounded-xl border border-(--color-ivory-300) bg-(--color-ivory-200) p-3 text-left hover:bg-(--color-ivory-200)" data-idx="${i}">
            <div class="flex items-center justify-between">
              <p class="font-display text-base font-bold text-(--color-ink-950)">${huyChuong} Năm ${r.namSinhCon}</p>
              <span class="text-sm font-semibold">${nhanDotHtml(r.nhan)} — ${r.diem}/10</span>
            </div>
            <div class="ccc-chi-tiet mt-2 hidden space-y-1 text-xs text-(--color-ink-500)">
              <p><strong>Cha → Con (${r.cha.diem}/10):</strong> Mệnh ${r.cha.menh.moTa}; Can ${r.cha.thienCan.moTa}; Chi ${r.cha.diaChi.moTa}; Cung ${r.cha.cungMenh.moTa}; Niên mệnh ${r.cha.nienMenh.moTa}</p>
              <p><strong>Mẹ → Con (${r.me.diem}/10):</strong> Mệnh ${r.me.menh.moTa}; Can ${r.me.thienCan.moTa}; Chi ${r.me.diaChi.moTa}; Cung ${r.me.cungMenh.moTa}; Niên mệnh ${r.me.nienMenh.moTa}</p>
            </div>
          </button>`;
        })
        .join("");
      ketQuaEl.querySelectorAll(".ccc-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          btn.querySelector(".ccc-chi-tiet")?.classList.toggle("hidden");
        });
      });
      ketQuaEl.classList.remove("hidden");
    } catch {
      loiEl.textContent = "Không tải được dữ liệu.";
      loiEl.classList.remove("hidden");
    }
  });
</script>
