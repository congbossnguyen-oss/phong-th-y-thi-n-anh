---
// Banner quyền dịch vụ VIP — client-side gọi /api/quan-su/quyen-vip để báo khách:
//   - Có gói Cao Cấp → "miễn phí theo gói", cứ điền form và bấm (checkout tự 0đ).
//   - Đăng nhập nhưng chưa có gói → mời nâng gói.
//   - Chưa đăng nhập → mời đăng nhập.
// Đặt ngay dưới PageHero của mỗi trang dịch vụ VIP. Giữ trang tĩnh (chỉ thêm 1 fetch nhỏ).
// KHÔNG còn nhánh "dùng thử" — anh Công bỏ hẳn (29/8/2026, các công cụ miễn phí sẵn có đã đủ làm phễu).
---

<div id="vip-quyen-banner" class="mx-auto mt-6 max-w-2xl px-4 empty:hidden"></div>

<script>
  (async () => {
    const el = document.getElementById("vip-quyen-banner");
    if (!el) return;

    let d: { dangNhap: boolean; coQuyenCaoCap: boolean };
    try {
      const res = await fetch("/api/quan-su/quyen-vip", { headers: { Accept: "application/json" } });
      if (!res.ok) return;
      d = await res.json();
    } catch {
      return;
    }

    const wrap = (inner: string, tone: "good" | "gold" | "muted") => {
      const border =
        tone === "good"
          ? "border-emerald-400/50 bg-emerald-50"
          : tone === "gold"
            ? "border-(--color-gold-400)/50 bg-(--color-gold-400)/10"
            : "border-(--color-ivory-300) bg-(--color-ivory-100)";
      return `<div class="rounded-(--radius-card) border-2 ${border} p-4 text-sm text-(--color-ink-800)">${inner}</div>`;
    };

    if (d.coQuyenCaoCap) {
      el.innerHTML = wrap(
        '✅ <b>Bạn đang có gói Cao Cấp</b> — dịch vụ này <b>miễn phí</b>. Cứ điền thông tin và bấm, hệ thống trả kết quả ngay, không cần thanh toán.',
        "good",
      );
    } else if (d.dangNhap) {
      el.innerHTML = wrap(
        '🔒 Dịch vụ VIP đi kèm <b>gói Cao Cấp</b> — nâng gói để dùng miễn phí không giới hạn. ' +
          '<a href="/quan-su/goi-thue-bao" class="font-semibold text-(--color-gold-300) hover:underline">Xem gói →</a>',
        "gold",
      );
    } else {
      el.innerHTML = wrap(
        '🔒 <a href="/hoc-vien/dang-nhap" class="font-semibold text-(--color-gold-300) hover:underline">Đăng nhập</a> để dùng dịch vụ VIP miễn phí theo gói Cao Cấp. ' +
          'Khách vãng lai vẫn có thể thanh toán theo lượt bên dưới.',
        "muted",
      );
    }
  })();
</script>
