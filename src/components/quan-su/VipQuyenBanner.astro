---
// Banner quyền dịch vụ VIP — client-side gọi /api/quan-su/quyen-vip để báo khách:
//   - Có gói Cao Cấp (hoặc đang dùng thử) → "miễn phí theo gói", cứ điền form và bấm (checkout tự 0đ).
//   - Đủ điều kiện dùng thử → nút "Dùng thử 7 ngày".
//   - Đăng nhập nhưng chưa có gói → mời nâng gói.
//   - Chưa đăng nhập → mời đăng nhập.
// Đặt ngay dưới PageHero của mỗi trang dịch vụ VIP. Giữ trang tĩnh (chỉ thêm 1 fetch nhỏ).
---

<div id="vip-quyen-banner" class="mx-auto mt-6 max-w-2xl px-4 empty:hidden"></div>

<script>
  (async () => {
    const el = document.getElementById("vip-quyen-banner");
    if (!el) return;

    let d: { dangNhap: boolean; coQuyenCaoCap: boolean; daTungDungThu: boolean; coTheDungThu: boolean };
    try {
      const res = await fetch("/api/quan-su/quyen-vip", { headers: { Accept: "application/json" } });
      if (!res.ok) return;
      d = await res.json();
    } catch {
      return;
    }

    const wrap = (inner: string, tone: "good" | "gold" | "muted") => {
      const border =
        tone === "good"
          ? "border-emerald-400/50 bg-emerald-50"
          : tone === "gold"
            ? "border-(--color-gold-400)/50 bg-(--color-gold-400)/10"
            : "border-(--color-ivory-300) bg-(--color-ivory-100)";
      return `<div class="rounded-(--radius-card) border-2 ${border} p-4 text-sm text-(--color-ink-800)">${inner}</div>`;
    };

    if (d.coQuyenCaoCap) {
      el.innerHTML = wrap(
        '✅ <b>Bạn đang có gói Cao Cấp</b> — dịch vụ này <b>miễn phí</b>. Cứ điền thông tin và bấm, hệ thống trả kết quả ngay, không cần thanh toán.',
        "good",
      );
    } else if (d.coTheDungThu) {
      el.innerHTML = wrap(
        '🎁 <b>Dùng thử 7 ngày miễn phí</b> để mở khóa toàn bộ dịch vụ VIP (hưởng hạng Cao Cấp). ' +
          '<button id="vip-trial-btn" class="mt-2 inline-flex items-center justify-center rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-2 font-semibold text-(--color-on-accent) hover:bg-(--color-gold-300)">Dùng thử ngay</button>' +
          '<span id="vip-trial-msg" class="ml-2"></span>',
        "gold",
      );
      const btn = document.getElementById("vip-trial-btn") as HTMLButtonElement | null;
      const msg = document.getElementById("vip-trial-msg");
      btn?.addEventListener("click", async () => {
        btn.disabled = true;
        btn.textContent = "Đang kích hoạt…";
        try {
          const r = await fetch("/api/quan-su/goi-thue-bao/dung-thu", { method: "POST" });
          const j = await r.json();
          if (r.ok && j.ok) {
            if (msg) msg.textContent = "✅ Đã kích hoạt! Đang tải lại…";
            location.reload();
          } else {
            if (msg) msg.textContent = j.error ?? "Không kích hoạt được.";
            btn.disabled = false;
            btn.textContent = "Dùng thử ngay";
          }
        } catch {
          if (msg) msg.textContent = "Lỗi mạng, thử lại sau.";
          btn.disabled = false;
          btn.textContent = "Dùng thử ngay";
        }
      });
    } else if (d.dangNhap) {
      el.innerHTML = wrap(
        '🔒 Dịch vụ VIP đi kèm <b>gói Cao Cấp</b> — nâng gói để dùng miễn phí không giới hạn. ' +
          '<a href="/quan-su/goi-thue-bao" class="font-semibold text-(--color-gold-300) hover:underline">Xem gói →</a>',
        "gold",
      );
    } else {
      el.innerHTML = wrap(
        '🔒 <a href="/hoc-vien/dang-nhap" class="font-semibold text-(--color-gold-300) hover:underline">Đăng nhập</a> để dùng dịch vụ VIP miễn phí theo gói Cao Cấp. ' +
          'Khách vãng lai vẫn có thể thanh toán theo lượt bên dưới.',
        "muted",
      );
    }
  })();
</script>
