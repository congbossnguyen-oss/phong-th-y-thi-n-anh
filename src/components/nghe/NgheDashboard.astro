---
import type { DashboardVM } from "../../lib/nghe-nghiep/view-model";
import { NH } from "../../lib/nghe-nghiep/view-model";

interface Props { vm: DashboardVM }
const { vm } = Astro.props;

// Radar
const TRUC_ORDER = ["specialist", "authority", "management", "business", "investment"] as const;
const TRUC_LABEL: Record<string, string> = { specialist: "Chuyên môn", authority: "Quan lộc", management: "Quản lý", business: "Kinh doanh", investment: "Đầu tư" };
const RADAR_MAX = 2, CX = 170, CY = 125, R = 70, LABEL_R = R + 35;
const polar = (i: number, rad: number): [number, number] => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return [CX + rad * Math.cos(a), CY + rad * Math.sin(a)];
};
const ring = (rad: number) => TRUC_ORDER.map((_, i) => polar(i, rad).join(",")).join(" ");
const dataPoly = vm.vector ? TRUC_ORDER.map((t, i) => polar(i, Math.max(0, Math.min(1, (vm.vector![t] ?? 0) / RADAR_MAX)) * R).join(",")).join(" ") : "";
const dataDots = vm.vector ? TRUC_ORDER.map((t, i) => polar(i, Math.max(0, Math.min(1, (vm.vector![t] ?? 0) / RADAR_MAX)) * R)) : [];

const gaugePct = vm.axis === null ? 50 : ((vm.axis + 100) / 200) * 100;

const BUCKET = {
  priority: { title: "★ ƯU TIÊN", head: "#B8860B", tint: "#FBF1CF", vien: "#E7C766", items: vm.priority },
  suitable: { title: "✓ PHÙ HỢP", head: "#1E8A45", tint: "#DCF3E3", vien: "#7BC99A", items: vm.suitable },
  possible: { title: "○ CÓ THỂ XEM XÉT", head: "#4B5563", tint: "#EEF0F3", vien: "#B6BEC8", items: vm.possible },
} as const;
---

<!-- 1. Dải tóm tắt -->
<div class="mb-5 overflow-hidden rounded-2xl border border-(--color-gold-500)/40 bg-gradient-to-br from-[#241a10] to-[#3a2c17] p-5 shadow-xl sm:p-6">
  <div class="mb-4 flex items-center justify-between">
    <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-gold-300)">Tóm tắt lá số</h3>
    <span class="rounded border border-white/25 px-2 py-0.5 text-[10px] font-bold text-white/80">SOURCE</span>
  </div>
  <div class="flex flex-wrap gap-2.5">
    {vm.chips.map((c) => (
      c.solid && c.mau ? (
        <span class="inline-flex items-center rounded-full px-3.5 py-2 text-sm font-extrabold text-white shadow-md" style={`background:${c.mau}`}>{c.label}: {c.value}</span>
      ) : (
        <span class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-sm font-bold text-(--color-ink-900) shadow-md">
          {c.mau && <span class="inline-block h-3 w-3 rounded-full" style={`background:${c.mau}`}></span>}
          {c.label}: <span style={c.mau ? `color:${c.mau}` : "color:#1a1a1a"}>{c.value}</span>
        </span>
      )
    ))}
  </div>
</div>

<!-- 2. Radar + Gauge -->
<div class="mb-5 grid gap-5 sm:grid-cols-2">
  <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
    <div class="flex items-center justify-between bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-4 py-2.5">
      <h3 class="font-display text-sm font-extrabold uppercase tracking-wide text-(--color-on-accent)">Hồ sơ 5 trục nghề</h3>
      <span class="rounded bg-white/25 px-2 py-0.5 text-[10px] font-bold text-white">THIEN_ANH_MODEL</span>
    </div>
    <div class="p-4">
      {vm.vectorInsufficient ? (
        <p class="py-8 text-center text-sm font-semibold text-(--color-ink-700)">Chưa đủ dữ liệu để vẽ 5 trục — cần AI luận (archetype/cơ chế).</p>
      ) : (
        <svg viewBox="0 0 340 250" class="mx-auto w-full max-w-[320px]">
          <polygon points={ring(R)} fill="none" stroke="#E5E7EB" stroke-width="1.2" />
          <polygon points={ring(R * 0.66)} fill="none" stroke="#EFE6CF" stroke-width="1" />
          <polygon points={ring(R * 0.33)} fill="none" stroke="#EFE6CF" stroke-width="1" />
          {TRUC_ORDER.map((_, i) => { const [ex, ey] = polar(i, R); return <line x1={CX} y1={CY} x2={ex} y2={ey} stroke="#EFE6CF" stroke-width="1" />; })}
          <polygon points={dataPoly} fill="rgba(184,134,11,.32)" stroke="#B8860B" stroke-width="2.5" />
          {dataDots.map(([dx, dy]) => <circle cx={dx} cy={dy} r="3.5" fill="#B8860B" />)}
          {TRUC_ORDER.map((t, i) => { const [lx, ly] = polar(i, LABEL_R); const anchor = i === 0 ? "middle" : i === 1 || i === 2 ? "start" : "end"; return <text x={lx} y={ly + 4} text-anchor={anchor} font-size="13" font-weight="700" fill="#241A10">{TRUC_LABEL[t]}</text>; })}
        </svg>
      )}
      <p class="mt-1 text-center text-xs font-semibold text-(--color-ink-700)">{vm.vectorDetail}</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
    <div class="bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-4 py-2.5">
      <h3 class="font-display text-sm font-extrabold uppercase tracking-wide text-(--color-on-accent)">Thiên hướng Quan Lộc ↔ Kinh Doanh</h3>
    </div>
    <div class="p-5">
      {vm.axisInsufficient ? (
        <p class="py-6 text-center text-sm font-semibold text-(--color-ink-700)">Chưa đủ dữ liệu để xác định thiên hướng.</p>
      ) : (
        <>
          <div class="relative mt-4 h-4 rounded-full shadow-inner" style="background:linear-gradient(90deg,#1D5FB0,#8FA9C9 42%,#D9C79A 58%,#B8860B)">
            <div class="absolute -top-2.5 h-9 w-2 rounded bg-(--color-ink-950) shadow" style={`left:calc(${gaugePct}% - 4px)`}></div>
          </div>
          <div class="mt-2.5 flex justify-between text-xs font-bold text-(--color-ink-800)">
            <span>◀ Quan Lộc / tổ chức</span><span>Kinh doanh / tự chủ ▶</span>
          </div>
          <div class="mt-5 rounded-xl border-l-4 border-(--color-gold-400) bg-(--color-gold-400)/10 p-3.5">
            <p class="text-[11px] font-extrabold uppercase tracking-wide text-(--color-gold-600)">Gợi ý tham khảo</p>
            <p class="mt-1 text-base font-extrabold text-(--color-ink-950)">{vm.axisKetLuan}</p>
          </div>
        </>
      )}
      <p class="mt-3 text-xs font-semibold text-(--color-ink-700)">{vm.axisDetail} <span class="rounded border border-(--color-ivory-300) px-1.5 py-0.5 text-[10px] font-bold">THIEN_ANH_MODEL</span></p>
    </div>
  </div>
</div>

<!-- 3. Ngành 3+3+3 -->
<div class="mb-5 overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
  <div class="bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-5 py-3">
    <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-on-accent)">Nhóm ngành phù hợp</h3>
  </div>
  <div class="p-5">
    {vm.domainInsufficient ? (
      <p class="text-sm font-semibold text-(--color-ink-700)">Chưa đủ dữ liệu để gợi ý ngành.</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-3">
        {(["priority", "suitable", "possible"] as const).map((k) => {
          const b = BUCKET[k];
          return (
            <div class="overflow-hidden rounded-xl border-2" style={`border-color:${b.vien}`}>
              <p class="px-3 py-2 text-xs font-extrabold uppercase tracking-wide text-white" style={`background:${b.head}`}>{b.title}</p>
              <div class="space-y-2 p-2.5" style={`background:${b.tint}`}>
                {b.items.length === 0 && <p class="text-xs font-semibold italic text-(--color-ink-600)">(không đủ tín hiệu)</p>}
                {b.items.map((item, idx) => (
                  <div class="rounded-lg border border-white bg-white p-2.5 shadow-sm">
                    <p class="flex items-center gap-1.5 text-sm font-extrabold text-(--color-ink-950)">
                      <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white" style={`background:${b.head}`}>{idx + 1}</span>
                      {item.label}
                    </p>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                      {item.majors.slice(0, 4).map((m) => (<span class="rounded-full px-2 py-0.5 text-[11px] font-bold" style={`background:${b.tint};color:${b.head}`}>{m.name}</span>))}
                      {item.majors.length > 4 && <span class="text-[11px] font-semibold text-(--color-ink-600)">+{item.majors.length - 4} khác</span>}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )}
    <p class="mt-3 text-xs font-semibold text-(--color-ink-700)">{vm.domainDetail} Không ép đủ 3 khi thiếu tín hiệu.</p>
  </div>
</div>

<!-- 4. Timeline -->
<div class="mb-5 overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
  <div class="flex items-center justify-between bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-5 py-3">
    <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-on-accent)">{vm.timelineTitle}</h3>
    <span class="rounded bg-white/25 px-2 py-0.5 text-[10px] font-bold text-white">SOURCE</span>
  </div>
  <div class="p-4">
    <div class="flex gap-1 overflow-x-auto">
      {vm.timeline.map((s) => (
        <div class="relative min-w-[74px] flex-1 overflow-hidden rounded-lg pt-2 pb-2.5 text-center" style={`background:${s.mau}`}>
          <span class="absolute right-1 top-1 rounded px-1 py-0.5 text-[9px] font-extrabold text-white" style={`background:${s.badge.bg}`}>{s.badge.label}</span>
          <p class="text-[11px] font-extrabold text-white">{s.tuTuoi}–{s.denTuoi}</p>
          <p class="mt-0.5 text-[10px] font-bold text-white">{s.chuDe}</p>
          <p class="mt-1 text-[9px] font-bold uppercase tracking-wide text-white/85">{s.top}</p>
        </div>
      ))}
    </div>
    <div class="mt-3 flex flex-wrap gap-3 text-[11px] font-bold text-(--color-ink-800)">
      <span class="text-(--color-ink-600)">Ngũ Hành:</span>
      {(["kim", "moc", "thuy", "hoa", "tho"] as const).map((k) => (<span><span class="mr-1 inline-block h-3 w-3 rounded-sm align-middle" style={`background:${NH[k].mau}`}></span>{NH[k].label}</span>))}
    </div>
    <p class="mt-2 text-xs font-semibold text-(--color-ink-700)">{vm.timelineNote}</p>
  </div>
</div>

<!-- 5. Career Path -->
<div class="mb-5 overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
  <div class="bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-5 py-3">
    <h3 class="font-display text-base font-extrabold uppercase tracking-wide text-(--color-on-accent)">Gợi ý các chặng (định hướng theo mô hình)</h3>
  </div>
  <div class="p-5">
    <div class="flex flex-wrap items-center gap-2">
      {vm.path.map((p, i) => (
        <>
          <div class="min-w-[96px] flex-1 rounded-xl border-2 border-(--color-gold-400)/40 bg-(--color-gold-400)/10 px-2.5 py-2.5 text-center shadow-sm">
            <p class="text-sm font-extrabold text-(--color-ink-950)">{p.label}</p>
            <p class="text-[11px] font-bold text-(--color-ink-700)">{p.tuTuoi}–{p.denTuoi} tuổi</p>
          </div>
          {i < vm.path.length - 1 && <span class="text-lg font-extrabold text-(--color-gold-500)">→</span>}
        </>
      ))}
    </div>
  </div>
</div>

<!-- 6. Vì sao -->
<details class="mb-2 overflow-hidden rounded-2xl border-2 border-(--color-gold-400)/50 bg-white shadow-lg">
  <summary class="cursor-pointer bg-gradient-to-r from-(--color-gold-400) to-(--color-gold-500) px-5 py-3 font-display text-base font-extrabold uppercase tracking-wide text-(--color-on-accent)">Vì sao lại gợi ý như vậy? — bấm để xem</summary>
  <div class="space-y-2.5 p-5 text-sm font-semibold text-(--color-ink-900)">
    {vm.why.map((w) => (<p><strong class="text-(--color-gold-600)">{w.label}:</strong> {w.value}</p>))}
    <p class="mt-3 text-[11px] font-medium text-(--color-ink-700)">
      <span class="rounded border border-(--color-ivory-300) px-1.5 py-0.5 font-bold">SOURCE</span> = luận trực tiếp từ tài liệu ·
      <span class="ml-1 rounded border border-(--color-ivory-300) px-1.5 py-0.5 font-bold">THIEN_ANH_MODEL</span> = mô hình quy đổi ·
      <span class="ml-1 rounded border border-(--color-ivory-300) px-1.5 py-0.5 font-bold">SUPPORTING_INFERENCE</span> = suy luận bổ trợ
    </p>
  </div>
</details>
