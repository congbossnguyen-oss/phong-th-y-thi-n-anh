---
// Nút liên hệ nhanh nổi góc dưới màn hình — thay href Zalo/Messenger thật khi có.
import Icon from "../ui/Icon.astro";
import { siteConfig } from "../../lib/site-config";
---

<div class="fixed bottom-5 right-5 z-30 flex flex-col items-end gap-3">
  <a
    href={siteConfig.social.zalo}
    aria-label="Chat Zalo với Thiên Anh"
    class="flex size-13 items-center justify-center rounded-full bg-(--color-cinnabar-500) text-(--color-gold-100) shadow-lg transition-transform hover:scale-105"
  >
    <Icon name="zalo" class="size-6" />
  </a>
  <a
    href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`}
    aria-label={`Gọi hotline ${siteConfig.hotline}`}
    class="flex size-13 items-center justify-center rounded-full bg-(--color-gold-500) text-(--color-ivory-50) shadow-lg transition-transform hover:scale-105"
  >
    <Icon name="phone" class="size-5.5" />
  </a>
</div>
