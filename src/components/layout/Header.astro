---
import Icon from "../ui/Icon.astro";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import SearchOverlay from "./SearchOverlay.astro";
import { siteConfig, mainNav } from "../../lib/site-config";
import { services, products } from "../../lib/placeholder-data";
import { COURSE_CATEGORY_ORDER, COURSE_CATEGORY_SLUGS } from "../../lib/cms/queries";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// Bổ sung mục con thật (dịch vụ, vật phẩm, nhóm khóa học) cho menu — giữ site-config.ts làm khung
// điều hướng gốc, tránh trùng lặp dữ liệu bằng cách lấy trực tiếp từ nguồn dữ liệu thật.
const navWithChildren = mainNav.map((item) => {
  if (item.label === "Dịch vụ") {
    return { ...item, children: services.map((s) => ({ label: s.name, href: `/dich-vu/${s.slug}` })) };
  }
  if (item.label === "Vật phẩm") {
    return { ...item, children: products.map((p) => ({ label: p.name, href: `/vat-pham/${p.slug}` })) };
  }
  if (item.label === "Khóa học") {
    return {
      ...item,
      children: COURSE_CATEGORY_ORDER.map((cat) => ({ label: cat, href: `/khoa-hoc#${COURSE_CATEGORY_SLUGS[cat]}` })),
    };
  }
  return item;
});
---

<header class="sticky top-0 z-40 border-b border-(--color-ivory-300) bg-(--color-ivory-50)/95">
  <!-- Thanh liên hệ nhanh -->
  <div class="hidden bg-(--color-ivory-100) text-(--color-ink-700) sm:block">
    <Container class="flex h-9 items-center justify-between text-xs">
      <div class="flex items-center gap-5">
        <a href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`} class="flex items-center gap-1.5 hover:text-(--color-gold-300)">
          <Icon name="phone" class="size-3.5" />
          {siteConfig.hotline}
        </a>
        <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-1.5 hover:text-(--color-gold-300)">
          <Icon name="mail" class="size-3.5" />
          {siteConfig.email}
        </a>
      </div>
      <div class="flex items-center gap-3">
        <a href={siteConfig.social.facebook} aria-label="Facebook Thiên Anh" class="hover:text-(--color-gold-300)">
          <Icon name="facebook" class="size-3.5" />
        </a>
        <a href={siteConfig.social.youtube} aria-label="YouTube Thiên Anh" class="hover:text-(--color-gold-300)">
          <Icon name="youtube" class="size-3.5" />
        </a>
        <a href={siteConfig.social.tiktok} aria-label="TikTok Thiên Anh" class="hover:text-(--color-gold-300)">
          <Icon name="tiktok" class="size-3.5" />
        </a>
      </div>
    </Container>
  </div>

  <!-- Header chính -->
  <Container class="flex h-18 items-center justify-between gap-1 py-2.5 sm:gap-4">
    <!-- Menu mobile: đặt đầu tiên để hiện bên trái trên di động (lg:hidden nên không ảnh hưởng desktop) -->
    <details class="group relative lg:hidden">
      <summary
        aria-label="Mở menu"
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-(--color-ink-800) hover:bg-(--color-ivory-200) [&::-webkit-details-marker]:hidden"
      >
        <Icon name="menu" class="size-5.5" />
      </summary>
      <nav
        aria-label="Điều hướng di động"
        class="hidden fixed inset-0 z-40 w-full flex-col gap-1 overflow-y-auto bg-(--color-ivory-50) p-5 group-open:flex"
      >
        <div class="mb-4 flex items-center justify-between">
          <span class="font-display text-lg font-semibold">{siteConfig.name}</span>
          <button
            type="button"
            aria-label="Đóng menu"
            class="js-mobile-nav-close flex size-11 items-center justify-center rounded-full text-(--color-ink-800) hover:bg-(--color-ivory-200)"
          >
            <Icon name="close" class="size-5" />
          </button>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--color-gold-500)">Danh mục chính</p>
        <div class="mb-3 grid grid-cols-2 gap-2.5">
          <a href="/dich-vu" class="flex flex-col items-center gap-1.5 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) py-4 text-center hover:border-(--color-gold-400)/50">
            <Icon name="check-circle" class="size-5 text-(--color-gold-400)" />
            <span class="text-sm font-medium text-(--color-ink-800)">Dịch vụ</span>
          </a>
          <a href="/vat-pham" class="flex flex-col items-center gap-1.5 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) py-4 text-center hover:border-(--color-gold-400)/50">
            <Icon name="cart" class="size-5 text-(--color-gold-400)" />
            <span class="text-sm font-medium text-(--color-ink-800)">Vật phẩm</span>
          </a>
          <a href="/khoa-hoc" class="flex flex-col items-center gap-1.5 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) py-4 text-center hover:border-(--color-gold-400)/50">
            <Icon name="book-open" class="size-5 text-(--color-gold-400)" />
            <span class="text-sm font-medium text-(--color-ink-800)">Khóa học</span>
          </a>
          <a href="/cong-trinh" class="flex flex-col items-center gap-1.5 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100) py-4 text-center hover:border-(--color-gold-400)/50">
            <Icon name="map-pin" class="size-5 text-(--color-gold-400)" />
            <span class="text-sm font-medium text-(--color-ink-800)">Công trình</span>
          </a>
        </div>

        <details class="group/tools mb-5 rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-100)">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-1.5 px-4 py-3.5 [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              <Icon name="star" class="size-5 text-(--color-gold-400)" />
              <span class="text-sm font-medium text-(--color-ink-800)">Công cụ</span>
            </span>
            <Icon name="chevron-down" class="size-4 text-(--color-ink-500) transition-transform group-open/tools:rotate-180" />
          </summary>
          <div class="flex flex-col gap-0.5 border-t border-(--color-ivory-300) p-2">
            <a href="/dai-cat-loi" class="rounded-(--radius-control) px-3 py-2.5 text-sm text-(--color-ink-700) hover:bg-(--color-ivory-200)">Đại Cát Lợi</a>
            <a href="/lap-la-so-bat-tu" class="rounded-(--radius-control) px-3 py-2.5 text-sm text-(--color-ink-700) hover:bg-(--color-ivory-200)">Lập lá số Bát Tự</a>
            <a href="/gieo-que-kinh-dich" class="rounded-(--radius-control) px-3 py-2.5 text-sm text-(--color-ink-700) hover:bg-(--color-ivory-200)">Lập quẻ Kinh Dịch</a>
            <a href="/lap-la-so-tu-vi" class="rounded-(--radius-control) px-3 py-2.5 text-sm text-(--color-ink-700) hover:bg-(--color-ivory-200)">Lập lá số Tử Vi</a>
            <a href="/xem-ngay-tot-xau" class="rounded-(--radius-control) px-3 py-2.5 text-sm text-(--color-ink-700) hover:bg-(--color-ivory-200)">Xem ngày tốt xấu</a>
          </div>
        </details>

        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--color-gold-500)">Tất cả danh mục</p>
        {navWithChildren.map((item) => (
          <div>
            <a href={item.href} class="block rounded-(--radius-control) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) hover:bg-(--color-ivory-200)">
              {item.label}
            </a>
            {item.children && (
              <div class="ml-3 flex flex-col border-l border-(--color-ivory-300) pl-3">
                {item.children.map((child) => (
                  <a href={child.href} class="rounded-(--radius-control) px-3 py-2 text-sm text-(--color-ink-600) hover:bg-(--color-ivory-200)">
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
        <a href="/hoc-vien" class="mt-2 rounded-(--radius-control) px-3 py-2.5 text-sm font-medium text-(--color-ink-800) hover:bg-(--color-ivory-200)">
          Khu vực học viên
        </a>
        <a
          href={`tel:${siteConfig.hotline.replace(/\s/g, "")}`}
          class="mt-3 flex items-center justify-center gap-2 rounded-(--radius-pill) bg-(--color-gold-400) px-4 py-3 text-sm font-semibold text-(--color-on-accent) hover:bg-(--color-gold-300)"
        >
          <Icon name="phone" class="size-4" />
          Gọi tư vấn: {siteConfig.hotline}
        </a>
      </nav>
    </details>

    <a href="/" class="flex shrink-0 items-center gap-2 sm:gap-2.5">
      <span class="flex size-11 items-center justify-center overflow-hidden rounded-full border-2 border-(--color-gold-400)">
        <img src="/images/brand/zhi-gong-logo.png" alt={siteConfig.name} class="h-full w-full object-cover" />
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base font-semibold text-(--color-ink-950) sm:text-lg">{siteConfig.name}</span>
        <span class="hidden text-[11px] uppercase tracking-wide text-(--color-gold-500) sm:block">{siteConfig.tagline}</span>
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Điều hướng chính">
      {navWithChildren.map((item) =>
        item.children ? (
          <div class="group relative">
            <a
              href={item.href}
              class:list={[
                "flex cursor-pointer items-center gap-1 rounded-(--radius-control) px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors hover:bg-(--color-ivory-200)",
                isActive(item.href) ? "text-(--color-gold-300)" : "text-(--color-ink-800)",
              ]}
            >
              {item.label}
              <Icon name="chevron-down" class="size-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" />
            </a>
            <div class="absolute left-0 top-full z-10 hidden pt-1 group-hover:block group-focus-within:block">
              <ul class="max-h-[70vh] min-w-56 overflow-y-auto rounded-(--radius-card) border border-(--color-ivory-300) bg-(--color-ivory-50) p-1.5 shadow-lg">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block rounded-(--radius-control) px-3 py-2 text-sm text-(--color-ink-800) hover:bg-(--color-ivory-200) hover:text-(--color-gold-300)"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              "rounded-(--radius-control) border-b-2 px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors hover:bg-(--color-ivory-200)",
              isActive(item.href)
                ? "border-(--color-gold-300) text-(--color-gold-300)"
                : "border-transparent text-(--color-ink-800)",
            ]}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        id="member-nav-link"
        href="/hoc-vien"
        class="hidden items-center gap-1.5 rounded-(--radius-control) px-3 py-2 text-sm font-medium text-(--color-ink-800) hover:bg-(--color-ivory-200) md:flex"
      >
        <Icon name="user" class="size-4.5" />
        <span id="member-nav-label">Học viên</span>
      </a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Đổi giao diện sáng/tối"
        class="flex size-11 items-center justify-center rounded-full text-(--color-ink-800) hover:bg-(--color-ivory-200)"
      >
        <Icon name="sun" class="theme-icon-sun size-5" />
        <Icon name="moon" class="theme-icon-moon size-5" />
      </button>
      <button
        type="button"
        aria-label="Tìm kiếm"
        class="js-search-open flex size-11 items-center justify-center rounded-full text-(--color-ink-800) hover:bg-(--color-ivory-200)"
      >
        <Icon name="search" class="size-5" />
      </button>
      <a
        href="/gio-hang"
        aria-label="Giỏ hàng"
        class="relative flex size-11 items-center justify-center rounded-full text-(--color-ink-800) hover:bg-(--color-ivory-200)"
      >
        <Icon name="cart" class="size-5" />
        <span
          id="cart-count-badge"
          class="hidden absolute right-1 top-1 flex size-4.5 items-center justify-center rounded-full bg-(--color-cinnabar-500) text-[10px] font-semibold text-(--color-gold-100)"
        >0</span>
      </a>

      <div class="hidden lg:block">
        <Button href="/lien-he" class="shrink-0 whitespace-nowrap">Đặt lịch tư vấn</Button>
      </div>
    </div>
  </Container>
</header>

<SearchOverlay />

<script>
  document.querySelectorAll(".js-mobile-nav-close").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.closest("details")?.removeAttribute("open");
    });
  });

  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isLight = document.documentElement.getAttribute("data-theme") === "light";
    if (isLight) {
      document.documentElement.removeAttribute("data-theme");
      localStorage.setItem("theme", "dark");
    } else {
      document.documentElement.setAttribute("data-theme", "light");
      localStorage.setItem("theme", "light");
    }
  });
</script>
