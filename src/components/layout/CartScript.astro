---
// Script toàn cục: xử lý nút "Thêm vào giỏ" (event delegation), cập nhật badge số lượng giỏ hàng,
// và cập nhật nhãn "Học viên"/tên trong header theo trạng thái đăng nhập demo.
// Chỉ 1 bản duy nhất được nhúng trong BaseLayout, chạy trên mọi trang.
---

<script>
  import { addItem, getCartCount, CART_EVENT_NAME } from "../../lib/cart/cart-client";
  import { getCurrentUser } from "../../lib/lms/lms-client";

  function updateBadge() {
    const badge = document.getElementById("cart-count-badge");
    if (!badge) return;
    const count = getCartCount();
    badge.textContent = String(count);
    badge.classList.toggle("hidden", count === 0);
  }

  function updateMemberNav() {
    const label = document.getElementById("member-nav-label");
    if (!label) return;
    const user = getCurrentUser();
    label.textContent = user ? user.name.split(" ")[0] : "Học viên";
  }

  document.addEventListener("click", (event) => {
    const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>(".js-add-to-cart");
    if (!btn) return;

    const { slug, name, price, qty } = btn.dataset;
    if (!slug || !name || !price) return;

    addItem({ slug, name, price: Number(price) }, qty ? Number(qty) : 1);

    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = "Đã thêm vào giỏ";
    window.setTimeout(() => {
      btn.disabled = false;
      btn.textContent = originalText;
    }, 1200);
  });

  window.addEventListener(CART_EVENT_NAME, updateBadge);
  window.addEventListener("storage", updateBadge);
  window.addEventListener("storage", updateMemberNav);
  document.addEventListener("DOMContentLoaded", () => {
    updateBadge();
    updateMemberNav();
  });
  updateBadge();
  updateMemberNav();
</script>
