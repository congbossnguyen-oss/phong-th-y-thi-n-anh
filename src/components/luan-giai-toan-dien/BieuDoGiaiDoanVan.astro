---
// Đồ hình chấm điểm 4 khía cạnh (sức khỏe/công việc/tài lộc/lục thân) theo từng giai đoạn Đại Vận
// hoặc từng năm Lưu Niên — dạng bảng nhiệt (heatmap), "nhìn vào là hiểu ngay" thay vì đọc văn xuôi dài.
import type { DiemGiaiDoanVan } from "../../lib/luan-giai-toan-dien/types";

interface Props {
  tieuDe: string;
  moTa?: string;
  danhSach: DiemGiaiDoanVan[];
}
const { tieuDe, moTa, danhSach } = Astro.props;

const KHIA_CANH: { khoa: keyof Pick<DiemGiaiDoanVan, "sucKhoe" | "congViec" | "taiLoc" | "lucThan">; nhan: string; icon: string }[] = [
  { khoa: "sucKhoe", nhan: "Sức khỏe", icon: "💪" },
  { khoa: "congViec", nhan: "Công việc", icon: "💼" },
  { khoa: "taiLoc", nhan: "Tài lộc", icon: "💰" },
  { khoa: "lucThan", nhan: "Lục thân", icon: "👨‍👩‍👧" },
];

function mauTheoDiem(diem: number): string {
  if (diem <= -2) return "#b91c1c";
  if (diem === -1) return "#f0a898";
  if (diem === 0) return "#d8cdb4";
  if (diem === 1) return "#a8d5b0";
  return "#16803d";
}
---

{danhSach.length > 0 && (
  <div class="rounded-(--radius-control) border border-(--color-ivory-300) bg-(--color-ivory-50) p-4">
    <p class="font-display text-base font-bold text-(--color-ink-950)">{tieuDe}</p>
    {moTa && <p class="mt-0.5 text-xs text-(--color-ink-500)">{moTa}</p>}

    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[560px] border-collapse text-xs">
        <thead>
          <tr>
            <th class="w-24 pb-1 text-left font-medium text-(--color-ink-600)"></th>
            {danhSach.map((d) => (
              <th class="px-0.5 pb-1 text-center font-bold text-(--color-ink-800)">{d.nhan}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {KHIA_CANH.map((kc) => (
            <tr>
              <td class="py-0.5 pr-2 font-medium text-(--color-ink-700)">{kc.icon} {kc.nhan}</td>
              {danhSach.map((d) => (
                <td class="p-0.5">
                  <div class="h-6 rounded" style={`background:${mauTheoDiem(d[kc.khoa])}`} title={`${kc.nhan} ${d.nhan}: ${d[kc.khoa] > 0 ? "+" : ""}${d[kc.khoa]}`}></div>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-3 flex items-center gap-3 text-[10px] text-(--color-ink-500)">
      <span class="flex items-center gap-1"><span class="inline-block size-2.5 rounded" style="background:#b91c1c"></span>Rất bất lợi</span>
      <span class="flex items-center gap-1"><span class="inline-block size-2.5 rounded" style="background:#d8cdb4"></span>Trung tính</span>
      <span class="flex items-center gap-1"><span class="inline-block size-2.5 rounded" style="background:#16803d"></span>Rất thuận lợi</span>
    </div>

    <div class="mt-3 space-y-2.5 border-t border-(--color-ivory-300) pt-3">
      {danhSach.map((d) => (
        <div>
          <p class="text-[11px] leading-relaxed text-(--color-ink-700)">
            <span class="font-bold text-(--color-ink-900)">{d.nhan} ({d.canChi}):</span> {d.tomTat}
            {d.dungThanVan && (
              <span class="ml-1 text-(--color-ink-500)">
                · Dụng Thần {d.dungThanVan}{d.dungThanDoi && <span class="font-bold text-(--color-gold-700)"> (đổi so với nguyên cục)</span>}
              </span>
            )}
          </p>
          {d.chiTiet && (
            <p class="mt-0.5 whitespace-pre-line pl-2 text-xs leading-relaxed text-(--color-ink-800)">{d.chiTiet}</p>
          )}
        </div>
      ))}
    </div>
  </div>
)}
