---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && (
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-(--color-cinnabar-500)">{eyebrow}</p>
  )}
  <h2 class="font-display text-3xl font-semibold text-(--color-ink-950) sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-relaxed text-(--color-ink-600)">{description}</p>}
</div>
