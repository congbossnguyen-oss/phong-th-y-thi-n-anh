---
import Container from "./Container.astro";
import SacredMotif from "./SacredMotif.astro";

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
}
const { eyebrow, title, description, breadcrumbs = [] } = Astro.props;
---

<section class="relative overflow-hidden border-b border-(--color-ivory-300) bg-(--color-ivory-100) py-14">
  <SacredMotif
    variant="bagua"
    class="pointer-events-none absolute -right-40 top-1/2 size-[30rem] -translate-y-1/2 text-(--color-gold-500)/10"
  />
  <Container class="relative">
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-(--color-ink-600)">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-(--color-ink-950)">{crumb.label}</a>
            ) : (
              <span class="text-(--color-ink-800)" aria-current="page">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>
    )}
    {eyebrow && (
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-(--color-gold-300)">{eyebrow}</p>
    )}
    <h1 class="font-display text-3xl font-semibold text-(--color-ink-950) sm:text-4xl">{title}</h1>
    {description && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-(--color-ink-700) sm:text-base">{description}</p>}
  </Container>
</section>
