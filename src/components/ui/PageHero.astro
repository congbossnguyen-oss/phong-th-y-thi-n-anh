---
import Container from "./Container.astro";

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
}
const { eyebrow, title, description, breadcrumbs = [] } = Astro.props;
---

<section class="border-b border-(--color-ivory-300) bg-(--color-ink-950) py-14">
  <Container>
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-(--color-ivory-400)">
        {breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-(--color-ivory-50)">{crumb.label}</a>
            ) : (
              <span class="text-(--color-ivory-200)" aria-current="page">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>
    )}
    {eyebrow && (
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-(--color-gold-300)">{eyebrow}</p>
    )}
    <h1 class="font-display text-3xl font-semibold text-(--color-ivory-50) sm:text-4xl">{title}</h1>
    {description && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-(--color-ivory-300) sm:text-base">{description}</p>}
  </Container>
</section>
