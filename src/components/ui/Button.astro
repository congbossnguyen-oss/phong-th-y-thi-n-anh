---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit";
  target?: "_blank" | "_self";
  [key: `data-${string}`]: string | undefined;
}
const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-(--radius-control) font-medium transition-colors duration-200 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-cinnabar-500) disabled:opacity-50 disabled:pointer-events-none";

const variants = {
  primary:
    "bg-(--color-cinnabar-500) text-(--color-gold-100) hover:bg-(--color-cinnabar-600) active:bg-(--color-cinnabar-700)",
  secondary:
    "bg-transparent text-(--color-cinnabar-400) border border-(--color-cinnabar-400) hover:bg-(--color-cinnabar-500) hover:text-(--color-gold-100) hover:border-(--color-cinnabar-500)",
  ghost:
    "bg-transparent text-(--color-ink-800) hover:bg-(--color-ivory-200)",
};

const sizes = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-3.5 text-base",
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
