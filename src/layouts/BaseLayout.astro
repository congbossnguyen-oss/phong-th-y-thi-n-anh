---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import QuickContact from "../components/layout/QuickContact.astro";
import TopBar from "../components/quan-su/TopBar.astro";
import CartScript from "../components/layout/CartScript.astro";
import { siteConfig } from "../lib/site-config";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  // true = trang "app Quân Sư" (khung riêng: top bar tối giản + thanh điều hướng dưới cùng, không
  // phải header/footer marketing của site chính). Mặc định false — KHÔNG đổi hành vi mọi trang khác.
  appShell?: boolean;
}

// Ảnh thumbnail khi chia sẻ link (Facebook/Zalo/Messenger). Mặc định cũ trỏ "/og-default.png" nhưng tệp
// đó đã bị xoá khỏi kho — mọi link chia sẻ đều không hiện được ảnh. Nay dùng ảnh banner thương hiệu, đã
// nén còn ~214KB và đưa về 1200×632 (tỉ lệ 1.90, khớp chuẩn 1.91) để bộ quét mạng xã hội tải nhanh.
const OG_IMAGE_DEFAULT = "/images/brand/og-thumbnail.jpg";
const OG_IMAGE_WIDTH = "1200";
const OG_IMAGE_HEIGHT = "632";

const {
  title,
  description = siteConfig.description,
  ogImage = OG_IMAGE_DEFAULT,
  noIndex = false,
  appShell = false,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321");
const absoluteOgImage = new URL(ogImage, Astro.site ?? "http://localhost:4321");
const siteUrl = (Astro.site ?? new URL("http://localhost:4321")).toString().replace(/\/$/, "");
const telephoneE164 = "+84" + siteConfig.hotline.replace(/\D/g, "").replace(/^0/, "");

// Organization + WebSite: đặt ở layout gốc để có mặt trên mọi trang, dữ liệu lấy từ site-config
// (nguồn duy nhất) nên không lệch với thông tin hiển thị thật trên site.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: siteConfig.name,
  url: siteUrl,
  telephone: telephoneE164,
  email: siteConfig.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address,
    addressLocality: "Hà Nội",
    addressCountry: "VN",
  },
  sameAs: [siteConfig.social.facebook].filter((href) => href && href !== "#"),
  areaServed: "VN",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteUrl,
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) — Google Analytics 4 (Phong Thủy Thiên Anh) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NT8N9LPW74"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NT8N9LPW74');
    </script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <script is:inline>
      // Đặt data-theme TRƯỚC khi CSS/nội dung render để tránh nháy màu (FOUC) khi tải trang.
      // Mặc định vẫn là theme tối hiện có của site — chỉ đổi sáng nếu người dùng đã chọn trước đó.
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light") document.documentElement.setAttribute("data-theme", "light");
        } catch (e) {}
      })();
    </script>
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    {/* Khai báo sẵn kích thước: mạng xã hội dựng được khung ảnh ngay từ lần quét đầu thay vì phải tải ảnh
        về đo — đây là lý do phổ biến khiến link chia sẻ lần đầu bị mất ảnh. */}
    <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
    <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
    <meta property="og:image:alt" content={siteConfig.name} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      crossorigin="anonymous"
    />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-(--radius-pill) focus:bg-(--color-gold-400) focus:px-4 focus:py-2 focus:text-(--color-on-accent)"
    >
      Bỏ qua đến nội dung chính
    </a>
    {appShell ? <TopBar /> : <Header />}
    <main id="main-content" class:list={["flex-1", { "pb-20": appShell }]}>
      <slot />
    </main>
    {!appShell && <Footer />}
    {!appShell && <QuickContact />}
    <CartScript />
  </body>
</html>
